		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "What an "
			code id="the-img-element:the-img-element-11" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element represents depends on the "
			code id="the-img-element:attr-img-src-4" {
				a href="#attr-img-src" {
