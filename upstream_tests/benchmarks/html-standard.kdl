					}
				}
				- " by 16.\n    Add a numeric version of the "
				a href="#current-input-character" id="hexadecimal-character-reference-state:current-input-character-2" {
					- "current input character"
				}
				- " as a hexadecimal digit\n    (subtract 0x0037 from the character's code point) to the "
				var id="hexadecimal-character-reference-state:character-reference-code-4" {
					a href="#character-reference-code" {
