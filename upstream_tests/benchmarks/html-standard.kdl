						- "associated element"
					}
					- " whose first five characters are\n   the string \""
					code {
						- "data-"
					}
					- "\" and whose remaining characters (if any) do not include\n   any "
					a href="https://infra.spec.whatwg.org/#ascii-upper-alpha" id="embedding-custom-non-visible-data-with-the-data-*-attributes:uppercase-ascii-letters-2" data-x-internal="uppercase-ascii-letters" {
						- "ASCII upper alphas"
					}
					- ", in the order that those\n   attributes are listed in the element's "
					a id="embedding-custom-non-visible-data-with-the-data-*-attributes:attribute-list" href="https://dom.spec.whatwg.org/#concept-element-attribute" data-x-internal="attribute-list" {
						- "attribute list"
					}
					- ", add a name-value pair to\n   "
					var {
						- "list"
					}
					- " whose name is the attribute's name with the first five characters removed and\n   whose value is the attribute's value."
				}
			}
			li {
				p {
					- "For each name in "
					var {
						- "list"
					}
					- ", for each U+002D HYPHEN-MINUS character (-) in the name\n   that is followed by an "
					a id="embedding-custom-non-visible-data-with-the-data-*-attributes:lowercase-ascii-letters" href="https://infra.spec.whatwg.org/#ascii-lower-alpha" data-x-internal="lowercase-ascii-letters" {
						- "ASCII lower alpha"
					}
					- ", remove the U+002D HYPHEN-MINUS character\n   (-) and replace the character that followed it by the same character "
					a id="embedding-custom-non-visible-data-with-the-data-*-attributes:converted-to-ascii-uppercase" href="https://infra.spec.whatwg.org/#ascii-uppercase" data-x-internal="converted-to-ascii-uppercase" {
						- "converted to ASCII\n   uppercase"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "list"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			a id="embedding-custom-non-visible-data-with-the-data-*-attributes:supported-property-names" href="https://webidl.spec.whatwg.org/#dfn-supported-property-names" data-x-internal="supported-property-names" {
				- "supported property names"
			}
			- " on a "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap-6" {
				a href="#domstringmap" {
					- "DOMStringMap"
