			}
			- " object can be entangled with another (a symmetric relationship).\n  Each "
			code id="message-ports:messageport-5" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " object also has a "
			a href="#task-source" id="message-ports:task-source" {
				- "task source"
			}
			- " called the "
			dfn id="port-message-queue" {
				- "port\n  message queue"
			}
			- ", initially empty. A "
			a href="#port-message-queue" id="message-ports:port-message-queue" {
				- "port message queue"
			}
			- " can be enabled or\n  disabled, and is initially disabled. Once enabled, a port can never be disabled again (though\n  messages in the queue can get moved to another queue or removed altogether, which has much the\n  same effect). A "
			code id="message-ports:messageport-6" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " also has a "
			dfn id="has-been-shipped" {
				- "has been shipped"
			}
			- " flag, which must\n  initially be false."
		}
		- "\n\n  "
		p {
			- "When a port's "
			a href="#port-message-queue" id="message-ports:port-message-queue-2" {
				- "port message queue"
			}
			- " is enabled, the "
			a href="#event-loop" id="message-ports:event-loop" {
				- "event loop"
			}
			- " must use\n  it as one of its "
			a href="#task-source" id="message-ports:task-source-2" {
				- "task sources"
			}
			- ". When a port's "
			a href="#concept-relevant-global" id="message-ports:concept-relevant-global" {
				- "relevant\n  global object"
			}
			- " is a "
			code id="message-ports:window" {
				a href="#window" {
					- "Window"
				}
			}
			- ", all "
			a href="#concept-task" id="message-ports:concept-task" {
				- "tasks"
			}
			- " "
			a href="#queue-a-task" id="message-ports:queue-a-task" {
				- "queued"
			}
			- " on its "
			a href="#port-message-queue" id="message-ports:port-message-queue-3" {
				- "port message queue"
			}
			- " must be associated with\n  the port's "
			a href="#concept-relevant-global" id="message-ports:concept-relevant-global-2" {
				- "relevant global object"
			}
			- "'s "
			a href="#concept-document-window" id="message-ports:concept-document-window" {
				- "associated\n  "
				code {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "If the document is "
			a href="#fully-active" id="message-ports:fully-active" {
				- "fully active"
			}
			- ", but the event listeners were all\n  created in the context of documents that are "
			em {
				- "not"
			}
			- " "
			a href="#fully-active" id="message-ports:fully-active-2" {
				- "fully active"
			}
			- ", then the\n  messages will not be received unless and until the documents become "
			a href="#fully-active" id="message-ports:fully-active-3" {
				- "fully active"
			}
			- "\n  again."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#event-loop" id="message-ports:event-loop-2" {
				- "event loop"
			}
			- " has a "
			a href="#task-source" id="message-ports:task-source-3" {
				- "task source"
			}
			- " called the "
			dfn id="unshipped-port-message-queue" {
				- "unshipped port\n  message queue"
			}
			- ". This is a virtual "
			a href="#task-source" id="message-ports:task-source-4" {
				- "task source"
			}
			- ": it must act as if it contained\n  the "
			a href="#concept-task" id="message-ports:concept-task-2" {
				- "tasks"
			}
			- " of each "
			a href="#port-message-queue" id="message-ports:port-message-queue-4" {
				- "port message queue"
			}
			- " of each\n  "
			code id="message-ports:messageport-7" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " whose "
			a href="#has-been-shipped" id="message-ports:has-been-shipped" {
				- "has been shipped"
			}
			- " flag is false, whose "
			a href="#port-message-queue" id="message-ports:port-message-queue-5" {
				- "port\n  message queue"
			}
			- " is enabled, and whose "
			a href="#relevant-agent" id="message-ports:relevant-agent" {
				- "relevant agent"
			}
			- "'s "
			a href="#concept-agent-event-loop" id="message-ports:concept-agent-event-loop" {
				- "event loop"
			}
			- " is that "
			a href="#event-loop" id="message-ports:event-loop-3" {
				- "event loop"
			}
			- ", in the order\n  in which they were added to their respective "
			a href="#task-source" id="message-ports:task-source-5" {
				- "task source"
			}
			- ". When a "
			a href="#concept-task" id="message-ports:concept-task-3" {
				- "task"
			}
			- " would be removed from the "
			a href="#unshipped-port-message-queue" id="message-ports:unshipped-port-message-queue" {
				- "unshipped port message\n  queue"
			}
			- ", it must instead be removed from its "
			a href="#port-message-queue" id="message-ports:port-message-queue-6" {
				- "port message queue"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When a "
			code id="message-ports:messageport-8" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- "'s "
			a href="#has-been-shipped" id="message-ports:has-been-shipped-2" {
				- "has been shipped"
			}
			- " flag is false, its "
			a href="#port-message-queue" id="message-ports:port-message-queue-7" {
				- "port\n  message queue"
			}
			- " must be ignored for the purposes of the "
			a href="#event-loop" id="message-ports:event-loop-4" {
				- "event loop"
			}
			- ". (The\n  "
			a href="#unshipped-port-message-queue" id="message-ports:unshipped-port-message-queue-2" {
				- "unshipped port message queue"
			}
			- " is used instead.)"
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#has-been-shipped" id="message-ports:has-been-shipped-3" {
				- "has been shipped"
			}
			- " flag is set to true when a port, its twin, or\n  the object it was cloned from, is or has been transferred. When a "
			code id="message-ports:messageport-9" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- "'s\n  "
			a href="#has-been-shipped" id="message-ports:has-been-shipped-4" {
				- "has been shipped"
			}
			- " flag is true, its "
			a href="#port-message-queue" id="message-ports:port-message-queue-8" {
				- "port message queue"
			}
			- " acts as a\n  first-class "
			a href="#task-source" id="message-ports:task-source-6" {
				- "task source"
			}
			- ", unaffected to any "
			a href="#unshipped-port-message-queue" id="message-ports:unshipped-port-message-queue-3" {
				- "unshipped port message\n  queue"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When the user agent is to "
			dfn id="entangle" {
				- "entangle"
			}
			- " two "
			code id="message-ports:messageport-10" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " objects, it must run\n  the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If one of the ports is already entangled, then disentangle it and the port that it was\n    entangled with."
				}
				- "\n\n    "
				p class="note" {
					- "If those two previously entangled ports were the two ports of a\n    "
					code id="message-ports:messagechannel" {
						a href="#messagechannel" {
							- "MessageChannel"
						}
					}
					- " object, then that "
					code id="message-ports:messagechannel-2" {
						a href="#messagechannel" {
							- "MessageChannel"
						}
					}
					- " object no longer\n    represents an actual channel: the two ports in that object are no longer entangled."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Associate the two ports to be entangled, so that they form the two parts of a new channel.\n    (There is no "
					code id="message-ports:messagechannel-3" {
						a href="#messagechannel" {
							- "MessageChannel"
						}
					}
					- " object that represents this channel.)"
				}
				- "\n\n    "
				p {
					- "Two ports "
					var {
						- "A"
					}
					- " and "
					var {
						- "B"
					}
					- " that have gone through this step\n    are now said to be entangled; one is entangled to the other, and vice versa."
				}
				- "\n\n    "
				p class="note" {
					- "While this specification describes this process as instantaneous,\n    implementations are more likely to implement it via message passing. As with all algorithms, the\n    key is \"merely\" that the end result be indistinguishable, in a black-box sense, from the\n    specification."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="disentangle" {
				- "disentangle"
			}
			- " steps, given a "
			code id="message-ports:messageport-11" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " "
			var {
				- "initiatorPort"
			}
			- "\n  which initiates disentangling, are as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "otherPort"
					}
					- " be the "
					code id="message-ports:messageport-12" {
						a href="#messageport" {
							- "MessagePort"
						}
					}
					- " which "
					var {
						- "initiatorPort"
					}
					- "\n   was entangled with."
				}
			}
			li {
				p {
					a id="message-ports:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					var {
						- "otherPort"
					}
					- " exists."
				}
			}
			li {
				p {
					- "Disentangle "
					var {
						- "initiatorPort"
					}
					- " and "
					var {
						- "otherPort"
					}
					- ", so that they are no longer\n   entangled or associated with each other."
				}
			}
			li {
				p {
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="message-ports:concept-event-fire" data-x-internal="concept-event-fire" {
						- "Fire an event"
					}
					- " named "
					code id="message-ports:event-close" {
						a href="#event-close" {
							- "close"
						}
					}
					- " at "
					var {
						- "otherPort"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "The "
				code id="message-ports:event-close-2" {
					a href="#event-close" {
						- "close"
					}
				}
				- " event will be fired even if the port is not\n   explicitly closed. The cases where this event is dispatched are:"
			}
			- "\n\n   "
			ul {
				li {
					- "the "
					code id="message-ports:dom-messageport-close-2" {
						a href="#dom-messageport-close" {
							- "close()"
						}
					}
					- " method was called;"
				}
				li {
					- "the "
					code id="message-ports:document" {
						a href="#document" {
							- "Document"
						}
					}
					- " was "
					a href="#destroy-a-document" id="message-ports:destroy-a-document" {
						- "destroyed"
					}
					- "; or"
				}
				li {
					- "the "
					code id="message-ports:messageport-13" {
						a href="#messageport" {
							- "MessagePort"
						}
					}
					- " was "
					a href="#ports-and-garbage-collection" {
						- "garbage\n    collected"
					}
					- "."
				}
			}
			- "\n\n   "
			p {
				- "We only dispatch the event on "
				var {
					- "otherPort"
				}
				- " because "
				var {
					- "initiatorPort"
				}
				- " explicitly\n   triggered the close, its "
				code id="message-ports:document-2" {
					a href="#document" {
						- "Document"
					}
				}
				- " no longer exists, or it was already garbage\n   collected, as described above."
			}
			- "\n  "
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p id="transferMessagePort" {
			code id="message-ports:messageport-14" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " objects are "
			a href="#transferable-objects" id="message-ports:transferable-objects" {
				- "transferable\n  objects"
			}
			- ". Their "
			a href="#transfer-steps" id="message-ports:transfer-steps" {
				- "transfer steps"
			}
			- ", given "
			var {
				- "value"
			}
			- " and\n  "
			var {
				- "dataHolder"
			}
			- ", are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set "
					var {
						- "value"
					}
					- "'s "
					a href="#has-been-shipped" id="message-ports:has-been-shipped-5" {
						- "has been shipped"
					}
					- " flag to true."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "dataHolder"
					}
					- ".[[PortMessageQueue]] to "
					var {
						- "value"
					}
					- "'s "
					a href="#port-message-queue" id="message-ports:port-message-queue-9" {
						- "port message\n   queue"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "value"
					}
					- " is entangled with another port "
					var {
						- "remotePort"
					}
					- ", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "remotePort"
							}
							- "'s "
							a href="#has-been-shipped" id="message-ports:has-been-shipped-6" {
								- "has been shipped"
							}
							- " flag to true."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "dataHolder"
							}
							- ".[[RemotePort]] to "
							var {
								- "remotePort"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Otherwise, set "
					var {
						- "dataHolder"
					}
					- ".[[RemotePort]] to null."
				}
			}
		}
		- "\n\n  "
		p {
			- "Their "
			a href="#transfer-receiving-steps" id="message-ports:transfer-receiving-steps" {
				- "transfer-receiving steps"
			}
			- ", given "
			var {
				- "dataHolder"
			}
			- " and "
			var {
				- "value"
			}
			- ",\n  are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set "
					var {
						- "value"
					}
					- "'s "
					a href="#has-been-shipped" id="message-ports:has-been-shipped-7" {
						- "has been shipped"
					}
					- " flag to true."
				}
			}
			li {
				p {
					- "Move all the "
					a href="#concept-task" id="message-ports:concept-task-4" {
						- "tasks"
					}
					- " that are to fire "
					code id="message-ports:event-message-2" {
						a href="#event-message" {
							- "message"
						}
					}
					- " events in "
					var {
						- "dataHolder"
					}
					- ".[[PortMessageQueue]] to the\n   "
					a href="#port-message-queue" id="message-ports:port-message-queue-10" {
						- "port message queue"
					}
					- " of "
					var {
						- "value"
					}
					- ", if any, leaving "
					var {
						- "value"
					}
					- "'s\n   "
					a href="#port-message-queue" id="message-ports:port-message-queue-11" {
						- "port message queue"
					}
					- " in its initial disabled state, and, if "
					var {
						- "value"
					}
					- "'s\n   "
					a href="#concept-relevant-global" id="message-ports:concept-relevant-global-3" {
						- "relevant global object"
					}
					- " is a "
					code id="message-ports:window-2" {
						a href="#window" {
							- "Window"
						}
					}
					- ", associating the moved "
					a href="#concept-task" id="message-ports:concept-task-5" {
						- "tasks"
					}
					- " with "
					var {
						- "value"
					}
					- "'s "
					a href="#concept-relevant-global" id="message-ports:concept-relevant-global-4" {
						- "relevant global object"
					}
					- "'s\n   "
					a href="#concept-document-window" id="message-ports:concept-document-window-2" {
						- "associated "
						code {
							- "Document"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "dataHolder"
					}
					- ".[[RemotePort]] is not null, then "
					a href="#entangle" id="message-ports:entangle" {
						- "entangle"
					}
					- "\n   "
					var {
						- "dataHolder"
					}
					- ".[[RemotePort]] and "
					var {
						- "value"
					}
					- ". (This will disentangle\n   "
					var {
						- "dataHolder"
					}
					- ".[[RemotePort]] from the original port that was transferred.)"
				}
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn id="message-port-post-message-steps" {
				- "message port post message steps"
			}
			- ", given "
			var {
				- "sourcePort"
			}
			- ",\n  "
			var {
				- "targetPort"
			}
			- ", "
			var {
				- "message"
			}
			- " and "
			var {
				- "options"
			}
			- " are as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "transfer"
					}
					- " be "
					var {
						- "options"
					}
					- "[\""
					code id="message-ports:dom-structuredserializeoptions-transfer" {
						a href="#dom-structuredserializeoptions-transfer" {
							- "transfer"
						}
					}
					- "\"]."
				}
			}
			li {
				p {
					- "If "
					var {
						- "transfer"
					}
					- " "
					a href="https://infra.spec.whatwg.org/#list-contain" id="message-ports:list-contains" data-x-internal="list-contains" {
						- "contains"
					}
					- "\n   "
					var {
						- "sourcePort"
					}
					- ", then throw a "
					a id="message-ports:datacloneerror-2" href="https://webidl.spec.whatwg.org/#datacloneerror" data-x-internal="datacloneerror" {
						- "\""
						code {
							- "DataCloneError"
						}
						- "\""
					}
					- "\n   "
					code id="message-ports:domexception-2" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "doomed"
					}
					- " be false."
				}
			}
			li {
				p {
					- "If "
					var {
						- "targetPort"
					}
					- " is not null and "
					var {
						- "transfer"
					}
					- " "
					a href="https://infra.spec.whatwg.org/#list-contain" id="message-ports:list-contains-2" data-x-internal="list-contains" {
						- "contains"
					}
					- " "
					var {
						- "targetPort"
					}
					- ", then set "
					var {
						- "doomed"
					}
					- " to true and\n   optionally report to a developer console that the target port was posted to itself, causing the\n   communication channel to be lost."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "serializeWithTransferResult"
					}
					- " be\n   "
					a href="#structuredserializewithtransfer" id="message-ports:structuredserializewithtransfer" {
						- "StructuredSerializeWithTransfer"
					}
					- "("
					var {
						- "message"
					}
					- ", "
					var {
						- "transfer"
					}
					- "). Rethrow\n   any exceptions."
				}
			}
			li {
				p {
					- "If "
