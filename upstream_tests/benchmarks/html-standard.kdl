				}
				- ":"
			}
			dd {
				a href="https://w3c.github.io/html-aria/#el-legend" {
					- "For authors"
				}
				- "."
			}
			dd {
				a href="https://w3c.github.io/html-aam/#el-legend" {
					- "For implementers"
				}
				- "."
			}
			dt {
				a href="#concept-element-dom" id="the-legend-element:concept-element-dom" {
					- "DOM interface"
				}
				- ":"
			}
			dd {
				- "\n    "
				pre {
					code class="idl" {
						- "["
						c- g="" {
							- "Exposed"
						}
						- "="
						c- n="" {
							- "Window"
						}
						- "]\n"
						c- b="" {
							- "interface"
						}
						- " "
						dfn id="htmllegendelement" data-dfn-type="interface" {
							c- g="" {
								- "HTMLLegendElement"
							}
						}
						- " : "
						a href="#htmlelement" id="the-legend-element:htmlelement" {
							c- n="" {
								- "HTMLElement"
							}
						}
						- " {\n  ["
						a href="#htmlconstructor" id="the-legend-element:htmlconstructor" {
							c- g="" {
								- "HTMLConstructor"
							}
						}
						- "] "
						c- g="" {
							- "constructor"
						}
						- "();\n\n  "
						c- b="" {
							- "readonly"
						}
						- " "
						c- b="" {
							- "attribute"
						}
						- " "
						a href="#htmlformelement" id="the-legend-element:htmlformelement" {
							c- n="" {
								- "HTMLFormElement"
							}
						}
						- "? "
						a href="#dom-legend-form" id="the-legend-element:dom-legend-form" {
							c- g="" {
								- "form"
							}
						}
						- ";\n\n  // "
						a href="#HTMLLegendElement-partial" {
							- "also has obsolete members"
						}
						- "\n};"
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-legend-element:the-legend-element" {
				a href="#the-legend-element" {
					- "legend"
				}
			}
			- " element "
			a href="#represents" id="the-legend-element:represents" {
				- "represents"
			}
			- " a caption for the rest of the contents\n  of the "
			code id="the-legend-element:the-legend-element-2" {
				a href="#the-legend-element" {
					- "legend"
				}
			}
			- " element's parent "
			code id="the-legend-element:the-fieldset-element-2" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- " element, if\n  any."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "legend"
					}
					- "."
					a href="#dom-legend-form" id="dom-legend-form-dev" {
						- "form"
					}
				}
			}
			dd {
				p {
					- "Returns the element's "
					code id="the-legend-element:the-form-element" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, if any, or null otherwise."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLLegendElement" id="dom-legend-form" data-dfn-type="attribute" {
				code {
					- "form"
				}
			}
			- " IDL\n  attribute's behavior depends on whether the "
			code id="the-legend-element:the-legend-element-3" {
				a href="#the-legend-element" {
					- "legend"
				}
			}
			- " element is in a\n  "
			code id="the-legend-element:the-fieldset-element-3" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- " element or not. If the "
			code id="the-legend-element:the-legend-element-4" {
				a href="#the-legend-element" {
					- "legend"
				}
			}
			- " has a "
			code id="the-legend-element:the-fieldset-element-4" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- "\n  element as its parent, then the "
			code id="the-legend-element:dom-legend-form-2" {
				a href="#dom-legend-form" {
					- "form"
				}
			}
			- " IDL attribute must\n  return the same value as the "
			code id="the-legend-element:dom-fae-form" {
				a href="#dom-fae-form" {
					- "form"
				}
			}
			- " IDL attribute on that\n  "
			code id="the-legend-element:the-fieldset-element-5" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- " element. Otherwise, it must return null."
		}
		- "\n\n  \n\n\n\n  "
		h4 id="form-control-infrastructure" {
			span class="secno" {
				- "4.10.17"
			}
			- " Form control infrastructure"
			a href="#form-control-infrastructure" class="self-link"
		}
		- "\n\n  "
		h5 id="a-form-control's-value" {
			span class="secno" {
				- "4.10.17.1"
			}
			- " A form control's value"
			a href="#a-form-control's-value" class="self-link"
		}
		- "\n\n  "
		p {
			- "Most form controls have a "
			dfn id="concept-fe-value" {
				- "value"
			}
			- " and a "
			dfn id="concept-fe-checked" {
				- "checkedness"
			}
			- ". (The latter is only used by "
			code id="a-form-control's-value:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- "\n  elements.) These are used to describe how the user interacts with the control."
		}
		- "\n\n  "
		p {
			- "A control's "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value" {
				- "value"
			}
			- " is its internal state. As such, it\n  might not match the user's current input."
		}
		- "\n\n  "
		p class="example" {
			- "For instance, if a user enters the word \""
			kbd {
				- "three"
			}
			- "\" into "
			a href="#number-state-(type=number)" id="a-form-control's-value:number-state-(type=number)" {
				- "a numeric field"
			}
			- " that expects digits, the user's input would\n  be the string \"three\" but the control's "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-2" {
				- "value"
			}
			- " would remain\n  unchanged. Or, if a user enters the email address \""
			kbd {
				- "  awesome@example.com"
			}
			- "\"\n  (with leading whitespace) into "
			a href="#email-state-(type=email)" id="a-form-control's-value:email-state-(type=email)" {
				- "an email field"
			}
			- ", the\n  user's input would be the string \"  awesome@example.com\" but the browser's UI for\n  email fields might translate that into a "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-3" {
				- "value"
			}
			- " of \""
			code {
				- "awesome@example.com"
			}
			- "\" (without the leading whitespace)."
		}
		- "\n\n  "
		p id="concept-input-value-dirty-flag" {
			span id="concept-textarea-dirty"
			code id="a-form-control's-value:the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- "\n  and "
			code id="a-form-control's-value:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements have a "
			dfn id="concept-fe-dirty" {
				- "dirty value flag"
			}
			- ".\n  This is used to track the interaction between the "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-4" {
				- "value"
			}
			- " and\n  default value. If it is false, "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-5" {
				- "value"
			}
			- " mirrors the default\n  value. If it is true, the default value is ignored."
		}
		- "\n\n  "
		p {
			code id="a-form-control's-value:the-input-element-3" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- ", "
			code id="a-form-control's-value:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- ", and "
			code id="a-form-control's-value:the-select-element" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " elements have a\n  "
			dfn id="user-validity" {
				- "user validity"
			}
			- " boolean. It is initially set to false."
		}
		- "\n\n  "
		p {
			- "To define the behavior of constraint validation in the face of the "
			code id="a-form-control's-value:the-input-element-4" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- "\n  element's "
			code id="a-form-control's-value:attr-input-multiple" {
				a href="#attr-input-multiple" {
					- "multiple"
				}
			}
			- " attribute, "
			code id="a-form-control's-value:the-input-element-5" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " elements\n  can also have separately defined "
			dfn id="concept-fe-values" {
				- "value"
				em {
					- "s"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To define the behavior of the "
			code id="a-form-control's-value:attr-fe-maxlength" {
				a href="#attr-fe-maxlength" {
					- "maxlength"
				}
			}
			- " and "
			code id="a-form-control's-value:attr-fe-minlength" {
				a href="#attr-fe-minlength" {
					- "minlength"
				}
			}
			- " attributes, as well as other APIs specific to the\n  "
			code id="a-form-control's-value:the-textarea-element-3" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element, all form control with a "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-6" {
				- "value"
			}
			- " also have an algorithm for obtaining an "
			span id="concept-textarea-api-value"
			dfn id="concept-fe-api-value" {
				- "API value"
			}
			- ". By\n  default this algorithm is to simply return the control's "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-7" {
				- "value"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="a-form-control's-value:the-select-element-2" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element does not have a "
			a href="#concept-fe-value" id="a-form-control's-value:concept-fe-value-8" {
				- "value"
			}
			- ";\n  the "
			a href="#concept-option-selectedness" id="a-form-control's-value:concept-option-selectedness" {
				- "selectedness"
			}
			- " of its "
			code id="a-form-control's-value:the-option-element" {
				a href="#the-option-element" {
					- "option"
				}
			}
			- "\n  elements is what is used instead."
		}
		- "\n\n\n  "
		h5 id="mutability" {
			span class="secno" {
				- "4.10.17.2"
			}
			- " Mutability"
			a href="#mutability" class="self-link"
		}
		- "\n\n  "
		p {
			- "A form control can be designated as "
			dfn id="concept-fe-mutable" {
				i {
					- "mutable"
				}
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "This determines (by means of definitions and requirements in this specification\n  that rely on whether an element is so designated) whether or not the user can modify the "
			a href="#concept-fe-value" id="mutability:concept-fe-value" {
				- "value"
			}
			- " or "
			a href="#concept-fe-checked" id="mutability:concept-fe-checked" {
				- "checkedness"
			}
			- " of a\n  form control, or whether or not a control can be automatically prefilled."
		}
		- "\n  \n\n\n  "
		h5 id="association-of-controls-and-forms" {
			span class="secno" {
				- "4.10.17.3"
			}
			- " Association of controls and forms"
			a href="#association-of-controls-and-forms" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#form-associated-element" id="association-of-controls-and-forms:form-associated-element" {
				- "form-associated element"
			}
			- " can have a relationship with a "
			code id="association-of-controls-and-forms:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- "\n  element, which is called the element's "
			dfn data-dfn-for="button,fieldset,input,object,output,select,textarea,img,form-associated custom element" id="form-owner" data-export="" {
				- "form\n  owner"
			}
			- ". If a "
			a href="#form-associated-element" id="association-of-controls-and-forms:form-associated-element-2" {
				- "form-associated element"
			}
			- " is not associated with a "
			code id="association-of-controls-and-forms:the-form-element-2" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- "\n  element, its "
			a href="#form-owner" id="association-of-controls-and-forms:form-owner" {
				- "form owner"
			}
			- " is said to be null."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#form-associated-element" id="association-of-controls-and-forms:form-associated-element-3" {
				- "form-associated element"
			}
			- " has an associated "
			dfn id="parser-inserted-flag" {
				- "parser inserted flag"
			}
			- "."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#form" title="The <input> HTML element is used to create interactive controls for web-based forms in order to accept data from the user; a wide variety of types of input data and control widgets are available, depending on the device and user agent. The <input> element is one of the most powerful and complex in all of HTML due to the sheer number of combinations of input types and attributes." {
						- "Element/input#form"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "5.5+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
