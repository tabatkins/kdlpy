		- "\n\n  "
		p {
			- "A "
			dfn id="concept-time" {
				- "time"
			}
			- " consists of a specific time with no time-zone\n  information, consisting of an hour, a minute, a second, and a fraction of a second."
		}
		- "\n\n  "
		p {
			- "A string is a "
			dfn id="valid-time-string" {
				- "valid time string"
			}
			- " representing an hour "
			var {
				- "hour"
			}
			- ", a\n  minute "
			var {
				- "minute"
			}
			- ", and a second "
			var {
				- "second"
			}
			- " if it consists of the\n  following components in the given order:"
		}
		- "\n\n  "
