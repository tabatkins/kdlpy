					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/hidden" title="The hidden global attribute is an enumerated attribute indicating that the browser should not render the contents of the element. For example, it can be used to hide elements of the page that can't be used until the login process has been completed." {
						- "Global_attributes/hidden"
					}
				}
				p class="less-than-two-engines-text" {
					- "Support in one engine only."
				}
				div class="support" {
