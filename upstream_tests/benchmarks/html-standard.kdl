			dd {
				- "\n    "
				p {
					- "Returns the deepest element in the document through which or to which key events are being\n    routed. This is, roughly speaking, the focused element in the document."
				}
				- "\n\n    "
				p {
					- "For the purposes of this API, when a "
					a href="#child-navigable" id="focus-management-apis:child-navigable" {
