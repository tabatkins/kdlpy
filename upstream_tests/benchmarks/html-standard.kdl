				}
				- ", "
				a href="#category-label" id="custom-elements-core-concepts:category-label" {
					- "labelable"
				}
				- ", "
				a href="#category-submit" id="custom-elements-core-concepts:category-submit" {
					- "submittable"
				}
				- ", and "
				a href="#category-reset" id="custom-elements-core-concepts:category-reset" {
					- "resettable"
				}
				- " "
				a href="#form-associated-element" id="custom-elements-core-concepts:form-associated-element" {
					- "form-associated element"
				}
				- "."
			}
			dt {
				a href="#concept-element-contexts" id="custom-elements-core-concepts:concept-element-contexts" {
					- "Contexts in which this element can be used"
				}
				- ":"
			}
			dd {
				- "Where "
				a href="#phrasing-content-2" id="custom-elements-core-concepts:phrasing-content-2-2" {
					- "phrasing content"
				}
				- " is expected."
			}
			dt {
				a href="#concept-element-content-model" id="custom-elements-core-concepts:concept-element-content-model" {
					- "Content model"
				}
				- ":"
			}
			dd {
				a href="#transparent" id="custom-elements-core-concepts:transparent" {
					- "Transparent"
				}
				- "."
			}
			dt {
				a href="#concept-element-attributes" id="custom-elements-core-concepts:concept-element-attributes" {
					- "Content attributes"
				}
				- ":"
			}
			dd {
				a href="#global-attributes" id="custom-elements-core-concepts:global-attributes" {
					- "Global attributes"
				}
				- ", except the "
				code id="custom-elements-core-concepts:attr-is-2" {
					a href="#attr-is" {
						- "is"
					}
				}
				- " attribute"
			}
			dd {
				code id="custom-elements-core-concepts:attr-fae-form" {
					a href="#attr-fae-form" {
						- "form"
					}
				}
				- ", for "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-2" {
					- "form-associated custom elements"
				}
				- " —  Associates the element with a "
				code id="custom-elements-core-concepts:the-form-element" {
					a href="#the-form-element" {
						- "form"
					}
				}
				- " element\n     "
			}
			dd {
				code id="custom-elements-core-concepts:attr-fe-disabled" {
					a href="#attr-fe-disabled" {
						- "disabled"
					}
				}
				- ", for "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-3" {
					- "form-associated custom elements"
				}
				- " —  Whether the form control is disabled\n     "
			}
			dd {
				code id="custom-elements-core-concepts:attr-face-readonly" {
					a href="#attr-face-readonly" {
						- "readonly"
					}
				}
				- ", for "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-4" {
					- "form-associated custom elements"
				}
				- " —  Affects "
				code id="custom-elements-core-concepts:dom-elementinternals-willvalidate" {
					a href="#dom-elementinternals-willvalidate" {
						- "willValidate"
					}
				}
				- ", plus any behavior added by the custom element author\n     "
			}
			dd {
				code id="custom-elements-core-concepts:attr-fe-name" {
					a href="#attr-fe-name" {
						- "name"
					}
				}
				- ", for "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-5" {
					- "form-associated custom elements"
				}
				- " —  Name of the element to use for "
				a href="#form-submission-2" id="custom-elements-core-concepts:form-submission-2" {
					- "form submission"
				}
				- " and in the "
				code id="custom-elements-core-concepts:dom-form-elements" {
					a href="#dom-form-elements" {
						- "form.elements"
					}
				}
				- " API \n     "
			}
			dd {
				- "Any other attribute that has no namespace (see prose)."
			}
			dt {
				a href="#concept-element-accessibility-considerations" id="custom-elements-core-concepts:concept-element-accessibility-considerations" {
					- "Accessibility considerations"
				}
				- ":"
			}
			dd {
				- "For "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-6" {
					- "form-associated custom elements"
				}
				- ": "
				a href="https://w3c.github.io/html-aria/#el-form-associated-custom-element" {
					- "for authors"
				}
				- "; "
				a href="https://w3c.github.io/html-aam/#el-form-associated-custom-element" {
					- "for implementers"
				}
				- "."
			}
			dd {
				- "Otherwise: "
				a href="https://w3c.github.io/html-aria/#el-autonomous-custom-element" {
					- "for authors"
				}
				- "; "
				a href="https://w3c.github.io/html-aam/#el-autonomous-custom-element" {
					- "for implementers"
				}
				- "."
			}
			dt {
				a href="#concept-element-dom" id="custom-elements-core-concepts:concept-element-dom" {
					- "DOM interface"
				}
				- ":"
			}
			dd {
				- "Supplied by the element's author (inherits from "
				code id="custom-elements-core-concepts:htmlelement" {
					a href="#htmlelement" {
						- "HTMLElement"
					}
				}
				- ")"
			}
		}
		- "\n\n\n  "
		p {
			- "An "
			a href="#autonomous-custom-element" id="custom-elements-core-concepts:autonomous-custom-element-2" {
				- "autonomous custom element"
			}
			- " does not have any special meaning: it\n  "
			a href="#represents" id="custom-elements-core-concepts:represents" {
				- "represents"
			}
			- " its children. A "
			a href="#customized-built-in-element" id="custom-elements-core-concepts:customized-built-in-element" {
				- "customized built-in element"
			}
			- " inherits the\n  semantics of the element that it extends."
		}
		- "\n\n  "
		p {
			- "Any namespace-less attribute that is relevant to the element's functioning, as determined by\n  the element's author, may be specified on an "
			a href="#autonomous-custom-element" id="custom-elements-core-concepts:autonomous-custom-element-3" {
				- "autonomous custom element"
			}
			- ", so long as\n  the attribute name is "
			a href="#xml-compatible" id="custom-elements-core-concepts:xml-compatible" {
				- "XML-compatible"
			}
			- " and contains no "
			a href="https://infra.spec.whatwg.org/#ascii-upper-alpha" id="custom-elements-core-concepts:uppercase-ascii-letters" data-x-internal="uppercase-ascii-letters" {
				- "ASCII upper alphas"
			}
			- ". The exception is the "
			code id="custom-elements-core-concepts:attr-is-3" {
				a href="#attr-is" {
					- "is"
				}
			}
			- " attribute,\n  which must not be specified on an "
			a href="#autonomous-custom-element" id="custom-elements-core-concepts:autonomous-custom-element-4" {
				- "autonomous custom element"
			}
			- " (and which will have no\n  effect if it is)."
		}
		- "\n\n  "
		p {
			a href="#customized-built-in-element" id="custom-elements-core-concepts:customized-built-in-element-2" {
				- "Customized built-in elements"
			}
			- " follow the\n  normal requirements for attributes, based on the elements they extend. To add custom\n  attribute-based behavior, use "
			code id="custom-elements-core-concepts:attr-data-*" {
				a href="#attr-data-*" {
					- "data-*"
				}
			}
			- " attributes."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "An "
			a href="#autonomous-custom-element" id="custom-elements-core-concepts:autonomous-custom-element-5" {
				- "autonomous custom element"
			}
			- " is called a "
			dfn id="form-associated-custom-element" data-export="" {
				- "form-associated custom\n  element"
			}
			- " if the element is associated with a "
			a href="#custom-element-definition" id="custom-elements-core-concepts:custom-element-definition" {
				- "custom element definition"
			}
			- " whose\n  "
			a href="#concept-custom-element-definition-form-associated" id="custom-elements-core-concepts:concept-custom-element-definition-form-associated" {
				- "form-associated"
			}
			- " field is\n  set to true."
		}
		- "\n\n  "
		p {
			- "The "
			code id="custom-elements-core-concepts:attr-fe-name-2" {
				a href="#attr-fe-name" {
					- "name"
				}
			}
			- " attribute represents the "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-7" {
				- "form-associated\n  custom element"
			}
			- "'s name. The "
			code id="custom-elements-core-concepts:attr-fe-disabled-2" {
				a href="#attr-fe-disabled" {
					- "disabled"
				}
			}
			- " attribute is\n  used to make the "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-8" {
				- "form-associated custom element"
			}
			- " non-interactive and to prevent its\n  "
			a href="#face-submission-value" id="custom-elements-core-concepts:face-submission-value" {
				- "submission value"
			}
			- " from being submitted. The "
			code id="custom-elements-core-concepts:attr-fae-form-2" {
				a href="#attr-fae-form" {
					- "form"
				}
			}
			- " attribute is used to explicitly associate the\n  "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-9" {
				- "form-associated custom element"
			}
			- " with its "
			a href="#form-owner" id="custom-elements-core-concepts:form-owner" {
				- "form owner"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="form-associated custom elements" id="attr-face-readonly" data-dfn-type="element-attr" {
				code {
					- "readonly"
				}
			}
			- " attribute of "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-10" {
				- "form-associated custom elements"
			}
			- " specifies that the element is "
			a href="#barred-from-constraint-validation" id="custom-elements-core-concepts:barred-from-constraint-validation" {
				- "barred\n  from constraint validation"
			}
			- ". User agents don't provide any other behavior for the attribute,\n  but custom element authors should, where possible, use its presence to make their control\n  non-editable in some appropriate fashion, similar to the behavior for the "
			a href="#attr-input-readonly" id="custom-elements-core-concepts:attr-input-readonly" {
				- "readonly"
			}
			- " attribute on built-in form controls."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": If the "
			code id="custom-elements-core-concepts:attr-face-readonly-2" {
				a href="#attr-face-readonly" {
					- "readonly"
				}
			}
			- " attribute is specified on a "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-11" {
				- "form-associated\n  custom element"
			}
			- ", the element is "
			a href="#barred-from-constraint-validation" id="custom-elements-core-concepts:barred-from-constraint-validation-2" {
				- "barred from constraint validation"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-form-reset-control" id="custom-elements-core-concepts:concept-form-reset-control" {
				- "reset algorithm"
			}
			- " for "
			a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-12" {
				- "form-associated custom elements"
			}
			- " is to "
			a href="#enqueue-a-custom-element-callback-reaction" id="custom-elements-core-concepts:enqueue-a-custom-element-callback-reaction" {
				- "enqueue\n  a custom element callback reaction"
			}
			- " with the element, callback name \""
			code {
				- "formResetCallback"
			}
			- "\", and « »."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="valid-custom-element-name" data-export="" {
				- "valid custom element name"
			}
			- " is a sequence of characters "
			var {
				- "name"
			}
			- " that\n  meets all of the following requirements:"
		}
		- "\n\n  "
		ul {
			li {
				- "\n    "
				p {
					var {
						- "name"
					}
					- " must match the "
					code id="custom-elements-core-concepts:prod-potentialcustomelementname" {
						a href="#prod-potentialcustomelementname" {
							- "PotentialCustomElementName"
						}
					}
					- " production:"
				}
				- "\n\n    "
				dl {
					dt {
						code {
							dfn id="prod-potentialcustomelementname" {
								- "PotentialCustomElementName"
							}
							- " ::="
						}
					}
					dd {
						code {
							- "[a-z] ("
							a href="#prod-pcenchar" id="custom-elements-core-concepts:prod-pcenchar" {
								- "PCENChar"
							}
							- ")* '-'\n     ("
							a href="#prod-pcenchar" id="custom-elements-core-concepts:prod-pcenchar-2" {
								- "PCENChar"
							}
							- ")*"
						}
					}
					dt {
						code {
							dfn id="prod-pcenchar" {
								- "PCENChar"
							}
							- " ::="
						}
					}
					dd {
						code {
							- "\"-\" | \".\" | [0-9] | \"_\" | [a-z] | #xB7 | [#xC0-#xD6] | [#xD8-#xF6] |\n     [#xF8-#x37D] | [#x37F-#x1FFF] | [#x200C-#x200D] | [#x203F-#x2040] | [#x2070-#x218F] |\n     [#x2C00-#x2FEF] | [#x3001-#xD7FF] | [#xF900-#xFDCF] | [#xFDF0-#xFFFD] |\n     [#x10000-#xEFFFF]"
						}
					}
				}
				- "\n\n    "
				p {
					- "This uses the "
					a href="https://www.w3.org/TR/xml/#sec-notation" {
						- "EBNF notation"
					}
					- " from the\n    "
					cite {
						- "XML"
					}
					- " specification. "
					a href="#refsXML" {
						- "[XML]"
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					var {
						- "name"
					}
					- " must not be any of the following:"
				}
				- "\n\n    "
				ul class="brief" {
					li {
						code {
							- "annotation-xml"
						}
					}
					li {
						code {
							- "color-profile"
						}
					}
					li {
						code {
							- "font-face"
						}
					}
					li {
						code {
							- "font-face-src"
						}
					}
					li {
						code {
							- "font-face-uri"
						}
					}
					li {
						code {
							- "font-face-format"
						}
					}
					li {
						code {
							- "font-face-name"
						}
					}
					li {
						code {
							- "missing-glyph"
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "The list of names above is the summary of all hyphen-containing element names\n    from the "
					a href="#other-applicable-specifications" id="custom-elements-core-concepts:other-applicable-specifications" {
						- "applicable specifications"
					}
					- ", namely\n    "
					cite {
						- "SVG 2"
					}
					- " and "
					cite {
						- "MathML"
					}
					- ". "
					a href="#refsSVG" {
						- "[SVG]"
					}
					- " "
					a href="#refsMATHML" {
						- "[MATHML]"
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "These requirements ensure a number of goals for "
				a href="#valid-custom-element-name" id="custom-elements-core-concepts:valid-custom-element-name-2" {
					- "valid\n   custom element names"
				}
				- ":"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "They start with an "
						a id="custom-elements-core-concepts:lowercase-ascii-letters" href="https://infra.spec.whatwg.org/#ascii-lower-alpha" data-x-internal="lowercase-ascii-letters" {
							- "ASCII lower alpha"
						}
						- ", ensuring that the HTML parser will\n    treat them as tags instead of as text."
					}
				}
				li {
					p {
						- "They do not contain any "
						a href="https://infra.spec.whatwg.org/#ascii-upper-alpha" id="custom-elements-core-concepts:uppercase-ascii-letters-2" data-x-internal="uppercase-ascii-letters" {
							- "ASCII upper alphas"
						}
						- ",\n    ensuring that the user agent can always treat HTML elements ASCII-case-insensitively."
					}
				}
				li {
					p {
						- "They contain a hyphen, used for namespacing and to ensure forward compatibility (since no\n    elements will be added to HTML, SVG, or MathML with hyphen-containing local names in the\n    future)."
					}
				}
				li {
					p {
						- "They can always be created with "
						code id="custom-elements-core-concepts:dom-document-createelement" {
							a data-x-internal="dom-document-createelement" href="https://dom.spec.whatwg.org/#dom-document-createelement" {
								- "createElement()"
							}
						}
						- " and "
						code id="custom-elements-core-concepts:dom-document-createelementns" {
							a data-x-internal="dom-document-createelementns" href="https://dom.spec.whatwg.org/#dom-document-createelementns" {
								- "createElementNS()"
							}
						}
						- ", which have restrictions that go\n    beyond the parser's."
					}
				}
			}
			- "\n\n   "
			p {
				- "Apart from these restrictions, a large variety of names is allowed, to give maximum\n   flexibility for use cases like "
				code {
					- "<math-α>"
				}
				- " or "
				code {
					- "<emotion-😍>"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		p {
			- "A "
			dfn id="custom-element-definition" {
				- "custom element definition"
			}
			- " describes a "
			a href="#custom-element" id="custom-elements-core-concepts:custom-element-3" {
				- "custom element"
			}
			- " and consists\n  of:"
		}
		- "\n\n  "
		dl {
			dt {
				- "A "
				dfn data-dfn-for="custom element definition" id="concept-custom-element-definition-name" data-export="" {
					- "name"
				}
			}
			dd {
				- "A "
				a href="#valid-custom-element-name" id="custom-elements-core-concepts:valid-custom-element-name-3" {
					- "valid custom element name"
				}
			}
			dt {
				- "A "
				dfn data-dfn-for="custom element definition" id="concept-custom-element-definition-local-name" data-export="" {
					- "local name"
				}
			}
			dd {
				- "A local name"
			}
			dt {
				- "A "
				dfn data-dfn-for="custom element definition" id="concept-custom-element-definition-constructor" data-export="" {
					- "constructor"
				}
			}
			dd {
				- "A Web IDL "
				code id="custom-elements-core-concepts:customelementconstructor" {
					a href="#customelementconstructor" {
						- "CustomElementConstructor"
					}
				}
				- " callback function type value wrapping\n   the "
				a href="#custom-element-constructor" id="custom-elements-core-concepts:custom-element-constructor" {
					- "custom element constructor"
				}
			}
			dt {
				- "A list of "
				dfn id="concept-custom-element-definition-observed-attributes" {
					- "observed\n   attributes"
				}
			}
			dd {
				- "A "
				code {
					- "sequence<DOMString>"
				}
			}
			dt {
				- "A collection of "
				dfn id="concept-custom-element-definition-lifecycle-callbacks" {
					- "lifecycle callbacks"
				}
			}
			dd {
				- "A map, whose keys are the strings \""
				code {
					- "connectedCallback"
				}
				- "\",\n   \""
				code {
					- "disconnectedCallback"
				}
				- "\", \""
				code {
					- "adoptedCallback"
				}
				- "\",\n   \""
				code {
					- "attributeChangedCallback"
				}
				- "\",\n   \""
				code {
					- "formAssociatedCallback"
				}
				- "\",\n   \""
				code {
					- "formDisabledCallback"
				}
				- "\",\n   \""
				code {
					- "formResetCallback"
				}
				- "\", and \""
				code {
					- "formStateRestoreCallback"
				}
				- "\".\n   The corresponding values are either a Web IDL "
				code id="custom-elements-core-concepts:idl-function" {
					a data-x-internal="idl-function" href="https://webidl.spec.whatwg.org/#common-Function" {
						- "Function"
					}
				}
				- "\n   callback function type value, or null. By default the value of each entry is null."
			}
			dt {
				- "A "
				dfn id="concept-custom-element-definition-construction-stack" {
					- "construction\n   stack"
				}
			}
			dd {
				- "A list, initially empty, that is manipulated by the "
				a href="#concept-upgrade-an-element" id="custom-elements-core-concepts:concept-upgrade-an-element" {
					- "upgrade an element"
				}
				- " algorithm and the "
				a href="#html-element-constructors" {
					- "HTML element constructors"
				}
				- ". Each entry in the list will be\n   either an element or an "
				dfn id="concept-already-constructed-marker" {
					i {
						- "already\n   constructed"
					}
					- " marker"
				}
				- "."
			}
			dt {
				- "A "
				dfn id="concept-custom-element-definition-form-associated" {
					- "form-associated"
				}
				- "\n   boolean"
			}
			dd {
				- "If this is true, user agent treats elements associated to this\n   "
				a href="#custom-element-definition" id="custom-elements-core-concepts:custom-element-definition-2" {
					- "custom element definition"
				}
				- " as "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element-13" {
					- "form-associated custom elements"
				}
				- "."
			}
			dt {
				- "A "
				dfn id="concept-custom-element-definition-disable-internals" {
					- "disable\n   internals"
				}
				- " boolean"
			}
			dd {
				- "Controls "
				code id="custom-elements-core-concepts:dom-attachinternals" {
					a href="#dom-attachinternals" {
						- "attachInternals()"
					}
				}
				- ".\n\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="custom element definition" id="concept-custom-element-definition-disable-shadow" data-export="" {
					- "disable shadow"
				}
				- " boolean"
			}
			dd {
				- "Controls "
				code id="custom-elements-core-concepts:dom-element-attachshadow" {
					a data-x-internal="dom-element-attachshadow" href="https://dom.spec.whatwg.org/#dom-element-attachshadow" {
						- "attachShadow()"
					}
				}
				- ".\n  "
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="look-up-a-custom-element-definition" data-export="" {
				- "look up a custom element definition"
			}
			- ", given a "
			var {
				- "document"
			}
			- ",\n  "
			var {
				- "namespace"
			}
			- ", "
			var {
				- "localName"
			}
			- ", and "
			var {
				- "is"
			}
			- ", perform the following steps. They\n  will return either a "
			a href="#custom-element-definition" id="custom-elements-core-concepts:custom-element-definition-3" {
				- "custom element definition"
			}
			- " or null:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "namespace"
					}
					- " is not the "
					a id="custom-elements-core-concepts:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
						- "HTML namespace"
					}
					- ", then return null."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- "'s "
					a href="#concept-document-bc" id="custom-elements-core-concepts:concept-document-bc" {
						- "browsing context"
					}
					- " is\n   null, then return null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "registry"
					}
					- " be "
					var {
						- "document"
					}
					- "'s "
					a href="#concept-relevant-global" id="custom-elements-core-concepts:concept-relevant-global" {
						- "relevant global object"
					}
					- "'s\n   "
					a href="#global-custom-element-registry" id="custom-elements-core-concepts:global-custom-element-registry" {
						- "custom element registry"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "registry"
