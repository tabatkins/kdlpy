						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "For example, consider the following markup:"
							}
							- "\n\n       "
							pre {
								code class="html" {
									c- p="" {
										- "<"
									}
									c- f="" {
										- "div"
									}
									- " "
									c- e="" {
										- "foo"
									}
									c- o="" {
										- "="
									}
									c- s="" {
										- "b'ar'"
									}
									c- p="" {
