						- "blockquote"
					}
				}
				- " elements:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "He began his list of \"lessons\" with the following:"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "blockquote"
					}
					c- p="" {
						- ">"
					}
					- "One should never assume that his side of\nthe issue will be recognized, let alone that it will\nbe conceded to have merits."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "blockquote"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "He continued with a number of similar points, ending with:"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "blockquote"
					}
					c- p="" {
						- ">"
					}
