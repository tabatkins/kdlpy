							- " to true."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "userPromptHandler"
					}
					- " is \""
					code {
						- "accept"
					}
					- "\", then set\n   "
					var {
						- "accepted"
					}
					- " to true."
				}
			}
			li {
				p {
					- "Invoke "
					a id="simple-dialogs:webdriver-bidi-user-prompt-closed-2" href="https://w3c.github.io/webdriver-bidi/#webdriver-bidi-user-prompt-closed" data-x-internal="webdriver-bidi-user-prompt-closed" {
						- "WebDriver BiDi user prompt closed"
					}
					- " with "
					a id="simple-dialogs:this-6" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- ",\n   \""
					code {
						- "confirm"
					}
					- "\", and "
					var {
						- "accepted"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "accepted"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="Window" id="dom-prompt" data-dfn-type="method" {
				code {
					- "prompt("
					var {
						- "message"
					}
