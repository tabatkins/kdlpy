							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
