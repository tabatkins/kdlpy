		- "\n\n  "
		p {
			- "An "
			code id="the-select-element-2:the-optgroup-element-2" {
				a href="#the-optgroup-element" {
					- "optgroup"
				}
			}
			- " element is expected to be rendered by displaying the element's "
			code id="the-select-element-2:attr-optgroup-label" {
