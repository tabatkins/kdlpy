			dd {
				- "\n    "
				p {
					a href="#insert-a-character" id="parsing-main-inhead:insert-a-character" {
						- "Insert the character"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A comment token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-comment" id="parsing-main-inhead:insert-a-comment" {
						- "Insert a comment"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A DOCTYPE token"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inhead:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"html\""
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-inhead:using-the-rules-for" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inbody" id="parsing-main-inhead:parsing-main-inbody" {
						- "in body"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"base\", \"basefont\",\n   \"bgsound\", \"link\""
			}
			dd {
				- "\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inhead:insert-an-html-element" {
						- "Insert an HTML element"
					}
					- " for the token. Immediately pop the "
					a href="#current-node" id="parsing-main-inhead:current-node" {
						- "current\n    node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-inhead:stack-of-open-elements" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#acknowledge-self-closing-flag" id="parsing-main-inhead:acknowledge-self-closing-flag" {
						- "Acknowledge the token's "
						i {
							- "self-closing\n    flag"
						}
					}
					- ", if it is set."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"meta\""
			}
			dd {
				- "\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inhead:insert-an-html-element-2" {
						- "Insert an HTML element"
					}
					- " for the token. Immediately pop the "
					a href="#current-node" id="parsing-main-inhead:current-node-2" {
						- "current\n    node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-inhead:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#acknowledge-self-closing-flag" id="parsing-main-inhead:acknowledge-self-closing-flag-2" {
						- "Acknowledge the token's "
						i {
							- "self-closing\n    flag"
						}
					}
					- ", if it is set."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#active-speculative-html-parser" id="parsing-main-inhead:active-speculative-html-parser" {
						- "active speculative HTML parser"
					}
					- " is null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p id="meta-charset-during-parse" {
							- "If the element has a "
							code id="parsing-main-inhead:attr-meta-charset" {
								a href="#attr-meta-charset" {
									- "charset"
								}
							}
							- " attribute, and "
							a id="parsing-main-inhead:getting-an-encoding" href="https://encoding.spec.whatwg.org/#concept-encoding-get" data-x-internal="getting-an-encoding" {
								- "getting an encoding"
							}
							- " from\n     its value results in an "
							a id="parsing-main-inhead:encoding" href="https://encoding.spec.whatwg.org/#encoding" data-x-internal="encoding" {
								- "encoding"
							}
							- ", and the\n     "
							a href="#concept-encoding-confidence" id="parsing-main-inhead:concept-encoding-confidence" {
								- "confidence"
							}
							- " is currently "
							i {
								- "tentative"
							}
							- ",\n     then "
							a href="#change-the-encoding" id="parsing-main-inhead:change-the-encoding" {
								- "change the encoding"
							}
							- " to the resulting encoding."
						}
					}
					li {
						p {
							- "Otherwise, if the element has an "
							code id="parsing-main-inhead:attr-meta-http-equiv" {
								a href="#attr-meta-http-equiv" {
									- "http-equiv"
								}
							}
							- "\n     attribute whose value is an "
							a id="parsing-main-inhead:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
								- "ASCII case-insensitive"
							}
							- " match for the string \""
							code {
								- "Content-Type"
							}
							- "\", and the element has a "
							code id="parsing-main-inhead:attr-meta-content" {
								a href="#attr-meta-content" {
									- "content"
								}
							}
							- " attribute, and applying the "
							a href="#algorithm-for-extracting-a-character-encoding-from-a-meta-element" id="parsing-main-inhead:algorithm-for-extracting-a-character-encoding-from-a-meta-element" {
								- "algorithm for\n     extracting a character encoding from a "
								code {
									- "meta"
								}
								- " element"
							}
							- " to that attribute's\n     value returns an "
							a id="parsing-main-inhead:encoding-2" href="https://encoding.spec.whatwg.org/#encoding" data-x-internal="encoding" {
								- "encoding"
							}
							- ", and the\n     "
							a href="#concept-encoding-confidence" id="parsing-main-inhead:concept-encoding-confidence-2" {
								- "confidence"
							}
							- " is currently "
							i {
								- "tentative"
							}
							- ",\n     then "
							a href="#change-the-encoding" id="parsing-main-inhead:change-the-encoding-2" {
								- "change the encoding"
							}
							- " to the extracted encoding."
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "The "
					a href="#speculative-html-parser" id="parsing-main-inhead:speculative-html-parser" {
						- "speculative HTML parser"
					}
					- " doesn't speculatively apply character\n    encoding declarations in order to reduce implementation complexity."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"title\""
			}
			dd {
				- "\n    "
				p {
					- "Follow the "
					a href="#generic-rcdata-element-parsing-algorithm" id="parsing-main-inhead:generic-rcdata-element-parsing-algorithm" {
						- "generic RCDATA element parsing algorithm"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"noscript\", if the "
				a href="#scripting-flag" id="parsing-main-inhead:scripting-flag" {
					- "scripting flag"
				}
				- " is enabled"
			}
			dt {
				- "A start tag whose tag name is one of: \"noframes\", \"style\""
			}
			dd {
				- "\n    "
				p {
					- "Follow the "
					a href="#generic-raw-text-element-parsing-algorithm" id="parsing-main-inhead:generic-raw-text-element-parsing-algorithm" {
						- "generic raw text element parsing algorithm"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"noscript\", if the "
				a href="#scripting-flag" id="parsing-main-inhead:scripting-flag-2" {
					- "scripting flag"
				}
				- " is disabled"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inhead:insert-an-html-element-3" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-3" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inheadnoscript" id="parsing-main-inhead:parsing-main-inheadnoscript" {
						- "in\n    head noscript"
					}
					- "\"."
				}
				- "\n   "
			}
			dt id="scriptTag" {
				- "A start tag whose tag name is \"script\""
			}
			dd {
				- "\n    "
				p {
					- "Run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let the "
							var {
								- "adjusted insertion location"
							}
							- " be the "
							a href="#appropriate-place-for-inserting-a-node" id="parsing-main-inhead:appropriate-place-for-inserting-a-node" {
								- "appropriate place\n     for inserting a node"
							}
							- "."
						}
					}
					li {
						p {
							a href="#create-an-element-for-the-token" id="parsing-main-inhead:create-an-element-for-the-token" {
								- "Create an element for the token"
							}
							- " in the "
							a id="parsing-main-inhead:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
								- "HTML namespace"
							}
							- ", with\n     the intended parent being the element in which the "
							var {
								- "adjusted insertion\n     location"
							}
							- " finds itself."
						}
					}
					li {
						- "\n      "
						p {
							- "Set the element's "
							a href="#parser-document" id="parsing-main-inhead:parser-document" {
								- "parser document"
							}
							- " to the "
							code id="parsing-main-inhead:document" {
								a href="#document" {
									- "Document"
								}
							}
							- ", and set the\n      element's "
							a href="#script-force-async" id="parsing-main-inhead:script-force-async" {
								- "force async"
							}
							- " to false."
						}
						- "\n\n      "
						p class="note" {
							- "This ensures that, if the script is external, any "
							code id="parsing-main-inhead:dom-document-write" {
								a href="#dom-document-write" {
									- "document.write()"
								}
							}
							- " calls in the script will execute in-line,\n      instead of blowing the document away, as would happen in most other cases. It also prevents\n      the script from executing until the end tag is seen."
						}
						- "\n     "
					}
					li {
						p {
							- "If the parser was created as part of the "
							a href="#html-fragment-parsing-algorithm" id="parsing-main-inhead:html-fragment-parsing-algorithm" {
								- "HTML fragment parsing algorithm"
							}
							- ",\n     then set the "
							code id="parsing-main-inhead:the-script-element" {
								a href="#the-script-element" {
									- "script"
								}
							}
							- " element's "
							a href="#already-started" id="parsing-main-inhead:already-started" {
								- "already started"
							}
							- " to true.\n     ("
							a href="#fragment-case" id="parsing-main-inhead:fragment-case" {
								- "fragment case"
							}
							- ")"
						}
					}
					li id="document-written-scripts-intervention" {
						p {
							- "If the parser was invoked via the "
							code id="parsing-main-inhead:dom-document-write-2" {
								a href="#dom-document-write" {
									- "document.write()"
								}
							}
							- " or "
							code id="parsing-main-inhead:dom-document-writeln" {
								a href="#dom-document-writeln" {
									- "document.writeln()"
								}
							}
							- " methods, then optionally set the\n     "
							code id="parsing-main-inhead:the-script-element-2" {
								a href="#the-script-element" {
									- "script"
								}
							}
							- " element's "
							a href="#already-started" id="parsing-main-inhead:already-started-2" {
								- "already started"
							}
							- " to true. (For example, the user\n     agent might use this clause to prevent execution of "
							a href="#concept-origin" id="parsing-main-inhead:concept-origin" {
								- "cross-origin"
							}
							- "\n     scripts inserted via "
							code id="parsing-main-inhead:dom-document-write-3" {
								a href="#dom-document-write" {
									- "document.write()"
								}
							}
							- " under slow\n     network conditions, or when the page has already taken a long time to load.)"
						}
					}
					li {
						p {
							- "Insert the newly created element at the "
							var {
								- "adjusted insertion\n     location"
							}
							- "."
						}
					}
					li {
						p {
							- "Push the element onto the "
							a href="#stack-of-open-elements" id="parsing-main-inhead:stack-of-open-elements-3" {
								- "stack of open elements"
							}
							- " so that it is the new\n     "
							a href="#current-node" id="parsing-main-inhead:current-node-3" {
								- "current node"
							}
							- "."
						}
					}
					li {
						p {
							- "Switch the tokenizer to the "
							a href="#script-data-state" id="parsing-main-inhead:script-data-state" {
								- "script data state"
							}
							- "."
						}
					}
					li {
						p {
							- "Let the "
							a href="#original-insertion-mode" id="parsing-main-inhead:original-insertion-mode" {
								- "original insertion mode"
							}
							- " be the current "
							a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-4" {
								- "insertion\n     mode"
							}
							- "."
						}
						- "\n\n     "
					}
					li {
						p {
							- "Switch the "
							a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-5" {
								- "insertion mode"
							}
							- " to \""
							a href="#parsing-main-incdata" id="parsing-main-inhead:parsing-main-incdata" {
								- "text"
							}
							- "\"."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"head\""
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-inhead:current-node-4" {
						- "current node"
					}
					- " (which will be the "
					code id="parsing-main-inhead:the-head-element" {
						a href="#the-head-element" {
							- "head"
						}
					}
					- " element) off the\n    "
					a href="#stack-of-open-elements" id="parsing-main-inhead:stack-of-open-elements-4" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-6" {
						- "insertion mode"
					}
					- " to \""
					a href="#the-after-head-insertion-mode" id="parsing-main-inhead:the-after-head-insertion-mode" {
						- "after\n    head"
					}
					- "\"."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"body\", \"html\", \"br\""
			}
			dd {
				- "\n    "
				p {
					- "Act as described in the \"anything else\" entry below."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"template\""
			}
			dd {
				- "\n    "
				p {
					- "Let "
					var {
						- "template start tag"
					}
					- " be the start tag."
				}
				- "\n\n    "
				p {
					- "Insert a "
					a href="#concept-parser-marker" id="parsing-main-inhead:concept-parser-marker" {
						- "marker"
					}
					- " at the end of the "
					a href="#list-of-active-formatting-elements" id="parsing-main-inhead:list-of-active-formatting-elements" {
						- "list of\n    active formatting elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Set the "
					a href="#frameset-ok-flag" id="parsing-main-inhead:frameset-ok-flag" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-inhead:insertion-mode-7" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intemplate" id="parsing-main-inhead:parsing-main-intemplate" {
						- "in\n    template"
					}
					- "\"."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-intemplate" id="parsing-main-inhead:parsing-main-intemplate-2" {
						- "in template"
					}
					- "\" onto the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-inhead:stack-of-template-insertion-modes" {
						- "stack of\n    template insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-inhead:current-template-insertion-mode" {
						- "current template insertion\n    mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Let the "
					var {
						- "adjusted insertion location"
					}
					- " be the "
					a href="#appropriate-place-for-inserting-a-node" id="parsing-main-inhead:appropriate-place-for-inserting-a-node-2" {
						- "appropriate place for inserting\n    a node"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Let "
					var {
						- "intended parent"
					}
					- " be the element in which the "
					var {
						- "adjusted insertion\n    location"
					}
					- " finds itself."
				}
				- "\n\n    "
				p {
					- "Let "
					var {
						- "document"
					}
					- " be "
					var {
						- "intended parent"
					}
					- "'s "
					a id="parsing-main-inhead:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If any of the following are false:"
				}
				- "\n\n    "
				ul {
					li {
						var {
							- "template start tag"
						}
						- "'s\n     "
						code id="parsing-main-inhead:attr-template-shadowrootmode" {
							a href="#attr-template-shadowrootmode" {
								- "shadowrootmode"
							}
						}
						- " is not in\n     the "
						a href="#attr-shadowrootmode-none-state" id="parsing-main-inhead:attr-shadowrootmode-none-state" {
							- "none"
						}
						- " state;"
					}
					li {
						var {
							- "document"
						}
						- "'s "
						a href="https://dom.spec.whatwg.org/#concept-document-allow-declarative-shadow-roots" id="parsing-main-inhead:concept-document-allow-declarative-shadow-roots" data-x-internal="concept-document-allow-declarative-shadow-roots" {
							- "allow\n     declarative shadow roots"
						}
						- " is true; or"
					}
					li {
						- "the "
						a href="#adjusted-current-node" id="parsing-main-inhead:adjusted-current-node" {
							- "adjusted current node"
						}
						- " is not the topmost element in the "
						a href="#stack-of-open-elements" id="parsing-main-inhead:stack-of-open-elements-5" {
							- "stack of\n     open elements"
						}
						- ","
					}
				}
				- "\n\n    "
				p {
					- "then "
					a href="#insert-an-html-element" id="parsing-main-inhead:insert-an-html-element-4" {
						- "insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "declarative shadow host element"
							}
							- " be "
							a href="#adjusted-current-node" id="parsing-main-inhead:adjusted-current-node-2" {
								- "adjusted current\n     node"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "template"
							}
							- " be the result of "
							a href="#insert-a-foreign-element" id="parsing-main-inhead:insert-a-foreign-element" {
								- "insert a foreign element"
							}
							- "\n     for "
							var {
								- "template start tag"
							}
							- ", with "
							a id="parsing-main-inhead:html-namespace-2-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
								- "HTML namespace"
							}
							- " and true."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "mode"
							}
							- " be "
							var {
								- "template start tag"
							}
							- "'s "
							code id="parsing-main-inhead:attr-template-shadowrootmode-2" {
								a href="#attr-template-shadowrootmode" {
									- "shadowrootmode"
								}
							}
							- " attribute's value."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "clonable"
							}
							- " be true if "
							var {
								- "template start tag"
							}
							- " has a "
							code id="parsing-main-inhead:attr-template-shadowrootclonable" {
								a href="#attr-template-shadowrootclonable" {
									- "shadowrootclonable"
								}
							}
							- " attribute; otherwise\n     false."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "serializable"
							}
							- " be true if "
							var {
								- "template start tag"
							}
							- " has a "
							code id="parsing-main-inhead:attr-template-shadowrootserializable" {
								a href="#attr-template-shadowrootserializable" {
									- "shadowrootserializable"
								}
							}
							- " attribute;\n     otherwise false."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "delegatesFocus"
							}
							- " be true if "
							var {
								- "template start tag"
							}
							- " has a "
							code id="parsing-main-inhead:attr-template-shadowrootdelegatesfocus" {
								a href="#attr-template-shadowrootdelegatesfocus" {
									- "shadowrootdelegatesfocus"
								}
							}
							- " attribute;\n     otherwise false."
						}
					}
					li {
