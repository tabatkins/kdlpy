				}
			}
			li {
				p {
					a href="#honor-user-preferences-for-automatic-text-track-selection" id="sourcing-out-of-band-text-tracks:honor-user-preferences-for-automatic-text-track-selection" {
						- "Honor user preferences for automatic text track selection"
					}
					- " for this\n   element."
				}
