		- "\n\n\n  "
		h5 id="rel-icon" {
			span class="secno" {
				- "4.6.7.9"
			}
			- " Link type \""
			dfn data-dfn-for="link/rel" data-dfn-type="attr-value" {
				code {
					- "icon"
