		- "\n\n  "
		p class="note" {
			- "This means that there is only one "
			a href="#similar-origin-window-agent" id="integration-with-the-javascript-agent-cluster-formalism:similar-origin-window-agent-3" {
				- "similar-origin window agent"
			}
			- " per\n  browsing context agent cluster. (However, "
			a href="#dedicated-worker-agent" id="integration-with-the-javascript-agent-cluster-formalism:dedicated-worker-agent" {
				- "dedicated\n  worker"
			}
			- " and "
			a href="#worklet-agent" id="integration-with-the-javascript-agent-cluster-formalism:worklet-agent" {
				- "worklet agents"
			}
			- " might be in the same\n  cluster.)"
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
