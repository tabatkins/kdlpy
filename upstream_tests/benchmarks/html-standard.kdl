									}
									- "."
								}
								- "\n       "
							}
							li {
								- "\n        "
								p {
									- "Update the "
									a href="#timeline-offset" id="loading-the-media-resource:timeline-offset-2" {
										- "timeline offset"
									}
									- " to the date and time that corresponds to the zero\n        time in the "
									a href="#media-timeline" id="loading-the-media-resource:media-timeline" {
										- "media timeline"
									}
									- " established in the previous step, if any. If no\n        explicit time and date is given by the "
									a href="#media-resource" id="loading-the-media-resource:media-resource-13" {
										- "media resource"
									}
									- ", the "
									a href="#timeline-offset" id="loading-the-media-resource:timeline-offset-3" {
										- "timeline\n        offset"
									}
									- " must be set to Not-a-Number (NaN)."
