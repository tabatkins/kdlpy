		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/month" title="<input> elements of type month create input fields that let the user enter a month and year allowing a month and year to be easily entered. The value is a string whose value is in the format \"YYYY-MM\", where YYYY is the four-digit year and MM is the month number." {
						- "Element/input/month"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
