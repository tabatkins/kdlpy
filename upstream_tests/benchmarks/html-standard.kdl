		- "\n\n\n\n  "
		h6 id="color-state-(type=color)" {
			span class="secno" {
				- "4.10.5.1.14"
			}
			- " "
			dfn data-dfn-for="input" data-dfn-type="element-state" {
				- "Color"
			}
			- " state ("
			code {
				- "type=color"
			}
			- ")"
			a href="#color-state-(type=color)" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/color" title="<input> elements of type color provide a user interface element that lets a user specify a color, either by using a visual color picker interface or by entering the color into a text field in #rrggbb hexadecimal format." {
						- "Element/input/color"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "29+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "12.1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "20+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "14+"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android yes" {
						span {
							- "Firefox Android"
						}
						span title="Partial implementation." {
							- "🔰 27+"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12+"
						}
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="color-state-(type=color):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="color-state-(type=color):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#color-state-(type=color)" id="color-state-(type=color):color-state-(type=color)" {
				- "Color"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="color-state-(type=color):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="color-state-(type=color):represents" {
				- "represents"
			}
			- " a color well control, for setting the\n  element's "
			a href="#concept-fe-value" id="color-state-(type=color):concept-fe-value" {
				- "value"
			}
			- " to a string representing the serialization\n  of a CSS color."
		}
		- "\n\n  "
		p class="note" {
			- "In this state, there is always a CSS color picked, and there is no way for the end\n  user to set the value to the empty string."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="input" id="attr-input-alpha" data-dfn-type="element-attr" {
				code {
					- "alpha"
				}
			}
			- " attribute\n  is a "
			a href="#boolean-attribute" id="color-state-(type=color):boolean-attribute" {
				- "boolean attribute"
			}
			- ". If present, it indicates the CSS color's alpha component can\n  be manipulated by the end user and does not have to be fully opaque."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="input" id="attr-input-colorspace" data-dfn-type="element-attr" {
				code {
					- "colorspace"
				}
			}
			- "\n  attribute indicates the color space of the serialized CSS color. It also hints at the desired user\n  interface for selecting a CSS color. It is an "
			a href="#enumerated-attribute" id="color-state-(type=color):enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following\n  keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- " Keyword\n     "
					}
					th {
						- " State\n     "
					}
					th {
						- " Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="input/colorspace" id="attr-input-colorspace-limited-srgb" data-dfn-type="attr-value" {
							code {
								- "limited-srgb"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-input-colorspace-limited-srgb-state" {
							- "Limited sRGB"
						}
						- "\n     "
					}
					td {
						- "The CSS color is converted to the "
						a id="color-state-(type=color):'srgb'" href="https://drafts.csswg.org/css-color/#valdef-color-srgb" data-x-internal="'srgb'" {
							- "'srgb'"
						}
						- " color space and limited to 8-bits per\n     component, e.g., \""
						code {
							- "#123456"
						}
						- "\" or \""
						code {
							- "color(srgb 0 1 0 / 0.5)"
						}
						- "\".\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="input/colorspace" id="attr-input-colorspace-display-p3" data-dfn-type="attr-value" {
							code {
								- "display-p3"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-input-colorspace-display-p3-state" {
							- "Display P3"
						}
						- "\n     "
					}
					td {
						- "The CSS color is converted to the "
						a id="color-state-(type=color):'display-p3'" href="https://drafts.csswg.org/css-color/#valdef-color-display-p3" data-x-internal="'display-p3'" {
							- "'display-p3'"
						}
						- " color space, e.g., \""
						code {
							- "color(display-p3 1.84 -0.19 0.72 / 0.6)"
						}
						- "\".\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="color-state-(type=color):missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="color-state-(type=color):invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both the "
			a href="#attr-input-colorspace-limited-srgb-state" id="color-state-(type=color):attr-input-colorspace-limited-srgb-state" {
				- "Limited sRGB"
			}
			- " state."
		}
		- "\n\n  \n\n  "
		p {
			- "Whenever the element's "
			code id="color-state-(type=color):attr-input-alpha" {
				a href="#attr-input-alpha" {
					- "alpha"
				}
			}
			- " or "
			code id="color-state-(type=color):attr-input-colorspace" {
				a href="#attr-input-colorspace" {
					- "colorspace"
				}
			}
			- " attributes are changed, the user agent must run\n  "
			a href="#update-a-color-well-control-color" id="color-state-(type=color):update-a-color-well-control-color" {
				- "update a color well control color"
			}
			- " given the element."
		}
		- "\n  \n\n  "
		p {
			- "If the element is "
			i id="color-state-(type=color):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the color represented by its "
			a href="#concept-fe-value" id="color-state-(type=color):concept-fe-value-2" {
				- "value"
			}
			- ", as\n  obtained from "
			a href="https://drafts.csswg.org/css-color/#parse-a-css-color-value" id="color-state-(type=color):parsed-as-a-css-color-value" data-x-internal="parsed-as-a-css-color-value" {
				- "parsing"
			}
			- " it. User agents must not\n  allow the user to set the "
			a href="#concept-fe-value" id="color-state-(type=color):concept-fe-value-3" {
				- "value"
			}
			- " to a string that running\n  "
			a href="#update-a-color-well-control-color" id="color-state-(type=color):update-a-color-well-control-color-2" {
				- "update a color well control color"
			}
			- " for the element would not set it to. If the user\n  agent provides a user interface for selecting a CSS color, then the "
			a href="#concept-fe-value" id="color-state-(type=color):concept-fe-value-4" {
				- "value"
			}
			- " must be set to the result of "
			a href="#serialize-a-color-well-control-color" id="color-state-(type=color):serialize-a-color-well-control-color" {
				- "serializing a color well control color"
			}
			- " given the element and the\n  end user's selection."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#input-activation-behavior" id="color-state-(type=color):input-activation-behavior" {
				- "input activation behavior"
			}
			- " for such an element "
			var {
				- "element"
			}
			- " is to\n  "
			a href="#show-the-picker,-if-applicable" id="color-state-(type=color):show-the-picker,-if-applicable" {
				- "show the picker, if applicable"
			}
			- ", for "
			var {
				- "element"
			}
			- "."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the element's "
			a href="#concept-fe-value" id="color-state-(type=color):concept-fe-value-5" {
				- "value"
			}
			- " is not the empty string and "
			a href="https://drafts.csswg.org/css-color/#parse-a-css-color-value" id="color-state-(type=color):parsed-as-a-css-color-value-2" data-x-internal="parsed-as-a-css-color-value" {
				- "parsing"
			}
			- " it returns failure, the control is "
			a href="#suffering-from-bad-input" id="color-state-(type=color):suffering-from-bad-input" {
				- "suffering from bad\n  input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="color-state-(type=color):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not the empty\n  string, must have a value that is a CSS color."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="color-state-(type=color):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": Run "
			a href="#update-a-color-well-control-color" id="color-state-(type=color):update-a-color-well-control-color-3" {
				- "update\n  a color well control color"
			}
			- " for the element."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="update-a-color-well-control-color" {
				- "update a color well control color"
			}
			- ", given an element "
			var {
				- "element"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a id="color-state-(type=color):assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
