		- "\n\n  \n\n  \n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLTableCellElement" id="dom-tdth-colspan" data-dfn-type="attribute" {
				code {
					- "colSpan"
				}
			}
			- " IDL attribute must "
			a href="#reflect" id="attributes-common-to-td-and-th-elements:reflect" {
				- "reflect"
