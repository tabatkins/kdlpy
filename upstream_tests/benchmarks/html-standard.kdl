			- ", run the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "list"
					}
					- " be an empty list of name-value pairs."
				}
			}
			li {
				p {
					- "For each content attribute on the "
					code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap-5" {
						a href="#domstringmap" {
							- "DOMStringMap"
						}
					}
					- "'s "
