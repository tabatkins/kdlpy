					- "TextTrack"
				}
			}
			- " object represents is not the "
			a href="#text-track-disabled" id="text-track-api:text-track-disabled-4" {
				- "text track disabled"
			}
			- " mode, then\n  the "
			dfn data-dfn-for="TextTrack" id="dom-texttrack-cues" data-dfn-type="attribute" {
				code {
					- "cues"
				}
			}
			- " attribute\n  must return a "
