			li {
				- "\n    "
				p {
					- "Optionally, update other aspects of "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-document" id="persisted-user-state-restoration:she-document-3" {
						- "document"
					}
					- " and its rendering, for instance values of form fields,\n    that the user agent had previously recorded in "
					var {
