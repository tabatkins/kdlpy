					var {
						- "filename"
					}
					- " to add a known-safe "
					a href="#concept-extension" id="downloading-resources:concept-extension-6" {
						- "extension"
					}
					- "\n    (e.g. \""
					code {
						- ".txt"
					}
					- "\")."
