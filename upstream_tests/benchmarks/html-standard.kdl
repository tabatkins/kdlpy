					}
					- "\n"
					c- p="" {
						- "><"
					}
					c- f="" {
						- "span"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "fn"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "span"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
