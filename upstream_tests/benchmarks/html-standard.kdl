						a href="#concept-frag-parse-context" {
							- "context"
						}
					}
					- " element passed to that algorithm."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "node"
					}
					- " is a "
					code id="the-insertion-mode:the-select-element" {
						a href="#the-select-element" {
							- "select"
						}
					}
					- " element, run these substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "last"
							}
							- " is true, jump to the step below labeled\n     "
							i {
								- "done"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "ancestor"
							}
							- " be "
							var {
								- "node"
							}
							- "."
						}
					}
					li {
						p {
							i {
								- "Loop"
							}
