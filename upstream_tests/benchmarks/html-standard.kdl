					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- k="" {
						- "while"
					}
					- " "
					c- p="" {
						- "("
					}
					c- kc="" {
						- "true"
					}
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- " "
					c- d="" {
