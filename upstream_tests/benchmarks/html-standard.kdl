						a href="#realm-execution-context" id="script-settings-for-workers:realm-execution-context" {
							- "realm execution context"
						}
					}
					dd {
						- "\n      "
						p {
							- "Return "
							var {
								- "execution context"
							}
							- ".\n     "
						}
					}
					dt {
						- "The "
						a href="#concept-settings-object-module-map" id="script-settings-for-workers:concept-settings-object-module-map" {
							- "module map"
						}
					}
					dd {
						- "\n      "
						p {
							- "Return "
							var {
