		- "\n\n  \n\n  "
		p {
			- "To "
			dfn id="creating-a-mediaerror" data-export="" {
				- "create a "
				code {
					- "MediaError"
				}
			}
			- ", given an\n  error code which is one of the above values, return a new "
			code id="error-codes:mediaerror-4" {
				a href="#mediaerror" {
					- "MediaError"
				}
			}
			- " object whose\n  "
			a href="#concept-mediaerror-code" id="error-codes:concept-mediaerror-code" {
				- "code"
			}
			- " is the given error code and whose "
			a href="#concept-mediaerror-message" id="error-codes:concept-mediaerror-message" {
				- "message"
			}
			- " is a string containing any details the user\n  agent is able to supply about the cause of the error condition, or the empty string if the user\n  agent is unable to supply such details. This message string must not contain only the information\n  already available via the supplied error code; for example, it must not simply be a translation of\n  the code into a string format. If no additional information is available beyond that provided by\n  the error code, the "
			a href="#concept-mediaerror-message" id="error-codes:concept-mediaerror-message-2" {
				- "message"
			}
			- " must be set to the\n  empty string."
		}
		- "\n\n  "
