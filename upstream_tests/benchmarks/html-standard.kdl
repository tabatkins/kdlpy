		- "\n\n  "
		p {
			- "If the next few characters are:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "Two U+002D HYPHEN-MINUS characters (-)"
			}
			dd {
				- "Consume those two characters, create a comment token whose data is the empty string, and\n   switch to the "
				a href="#comment-start-state" id="markup-declaration-open-state:comment-start-state" {
					- "comment start state"
				}
				- "."
			}
			dt {
				a id="markup-declaration-open-state:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
					- "ASCII case-insensitive"
				}
				- " match for the word \"DOCTYPE\""
			}
