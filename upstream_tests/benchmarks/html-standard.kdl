						a id="populating-a-session-history-entry:xml-mime-type" href="https://mimesniff.spec.whatwg.org/#xml-mime-type" data-x-internal="xml-mime-type" {
							- "XML MIME type"
						}
						- " that is not an "
						a href="#explicitly-supported-xml-mime-type" id="populating-a-session-history-entry:explicitly-supported-xml-mime-type" {
							- "explicitly supported XML MIME\n     type"
						}
					}
					dd {
						- "Return the result of "
						a href="#read-xml" id="populating-a-session-history-entry:read-xml" {
							- "loading an XML document"
						}
						- " given\n     "
						var {
							- "navigationParams"
						}
						- " and "
						var {
							- "type"
						}
						- "."
					}
					dt {
						- "a "
						a id="populating-a-session-history-entry:javascript-mime-type" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" data-x-internal="javascript-mime-type" {
							- "JavaScript MIME type"
						}
					}
					dt {
						- "a "
						a id="populating-a-session-history-entry:json-mime-type" href="https://mimesniff.spec.whatwg.org/#json-mime-type" data-x-internal="json-mime-type" {
							- "JSON MIME type"
						}
						- " that is not an "
						a href="#explicitly-supported-json-mime-type" id="populating-a-session-history-entry:explicitly-supported-json-mime-type" {
							- "explicitly supported JSON MIME\n     type"
						}
					}
					dt {
						- "\""
						code id="populating-a-session-history-entry:text/css" {
							a href="#text/css" {
								- "text/css"
							}
						}
						- "\""
					}
					dt {
						- "\""
						code id="populating-a-session-history-entry:text/plain" {
							a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
								- "text/plain"
							}
						}
						- "\""
					}
					dt {
						- "\""
						code id="populating-a-session-history-entry:text/vtt" {
							a href="#text/vtt" {
								- "text/vtt"
							}
						}
						- "\""
					}
					dd {
						- "Return the result of "
						a href="#navigate-text" id="populating-a-session-history-entry:navigate-text" {
							- "loading a text document"
						}
						- " given\n     "
						var {
							- "navigationParams"
						}
						- " and "
						var {
							- "type"
						}
						- "."
					}
					dt {
						- "\""
						code id="populating-a-session-history-entry:multipart/x-mixed-replace" {
							a href="#multipart/x-mixed-replace" {
								- "multipart/x-mixed-replace"
							}
						}
						- "\""
					}
					dd {
						- "Return the result of "
						a href="#navigate-multipart-x-mixed-replace" id="populating-a-session-history-entry:navigate-multipart-x-mixed-replace" {
							- "loading a\n     "
							code {
								- "multipart/x-mixed-replace"
							}
							- " document"
						}
						- ", given "
						var {
							- "navigationParams"
						}
						- ",\n     "
						var {
							- "sourceSnapshotParams"
						}
						- ", and "
						var {
							- "initiatorOrigin"
						}
						- "."
					}
					dt {
						- "A supported image, video, or audio type"
					}
					dd {
						- "Return the result of "
						a href="#navigate-media" id="populating-a-session-history-entry:navigate-media" {
							- "loading a media document"
						}
						- " given\n     "
						var {
							- "navigationParams"
						}
						- " and "
						var {
							- "type"
						}
						- "."
					}
					dt {
						- "\""
						code {
							- "application/pdf"
						}
						- "\""
					}
					dt {
						- "\""
						code {
							- "text/pdf"
						}
						- "\""
					}
					dd {
						- "If the user agent's "
						a href="#pdf-viewer-supported" id="populating-a-session-history-entry:pdf-viewer-supported" {
							- "PDF viewer supported"
						}
						- " is true, return the result of "
						a href="#read-ua-inline" id="populating-a-session-history-entry:read-ua-inline-3" {
							- "creating a document for inline content that doesn't have a\n     DOM"
						}
						- " given "
						var {
							- "navigationParams"
						}
						- "'s "
						a href="#navigation-params-navigable" id="populating-a-session-history-entry:navigation-params-navigable-3" {
							- "navigable"
						}
						- ", "
						var {
							- "navigationParams"
						}
						- "'s "
						a href="#navigation-params-id" id="populating-a-session-history-entry:navigation-params-id-3" {
							- "id"
						}
						- ", "
						var {
							- "navigationParams"
						}
						- "'s "
						a href="#navigation-params-nav-timing-type" id="populating-a-session-history-entry:navigation-params-nav-timing-type-3" {
							- "navigation timing type"
						}
						- ", and\n     "
						var {
							- "navigationParams"
						}
						- "'s "
						a href="#navigation-params-user-involvement" id="populating-a-session-history-entry:navigation-params-user-involvement-3" {
							- "user\n     involvement"
						}
						- "."
					}
				}
				- "\n\n    "
				p {
					- "Otherwise, proceed onward."
				}
				- "\n\n    "
				p {
					- "An "
					dfn id="explicitly-supported-xml-mime-type" {
						- "explicitly supported XML MIME type"
					}
					- " is an "
					a id="populating-a-session-history-entry:xml-mime-type-2" href="https://mimesniff.spec.whatwg.org/#xml-mime-type" data-x-internal="xml-mime-type" {
						- "XML MIME type"
					}
					- " for which\n    the user agent is configured to use an external application to render the content, or for which\n    the user agent has dedicated processing rules. For example, a web browser with a built-in Atom\n    feed viewer would be said to explicitly support the "
					code id="populating-a-session-history-entry:application/atom+xml" {
						a href="#application/atom+xml" {
							- "application/atom+xml"
						}
					}
					- " MIME\n    type."
				}
				- "\n\n    "
				p {
					- "An "
					dfn id="explicitly-supported-json-mime-type" {
						- "explicitly supported JSON MIME type"
					}
					- " is a "
					a id="populating-a-session-history-entry:json-mime-type-2" href="https://mimesniff.spec.whatwg.org/#json-mime-type" data-x-internal="json-mime-type" {
						- "JSON MIME type"
					}
					- " for which\n    the user agent is configured to use an external application to render the content, or for which\n    the user agent has dedicated processing rules."
				}
				- "\n\n    "
				p class="note" {
					- "In both cases, the external application or user agent will either "
					a href="#read-ua-inline" id="populating-a-session-history-entry:read-ua-inline-4" {
						- "display the content inline"
					}
					- " directly in\n    "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="populating-a-session-history-entry:navigation-params-navigable-4" {
						- "navigable"
					}
					- ", or\n    "
					a href="#hand-off-to-external-software" id="populating-a-session-history-entry:hand-off-to-external-software-3" {
						- "hand it off to external software"
					}
					- ". Both\n    happen in the steps below."
				}
				- "\n   "
			}
			li id="navigate-non-Document" {
				p {
					- "If, given "
					var {
						- "type"
					}
					- ", the new resource is to be handled\n   by displaying some sort of inline content, e.g., a native rendering of the content or an error\n   message because the specified type is not supported, then return the result of "
					a href="#read-ua-inline" id="populating-a-session-history-entry:read-ua-inline-5" {
						- "creating a document for inline content that doesn't have a\n   DOM"
					}
					- " given "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="populating-a-session-history-entry:navigation-params-navigable-5" {
						- "navigable"
					}
					- ", "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-id" id="populating-a-session-history-entry:navigation-params-id-4" {
						- "id"
					}
					- ", "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-nav-timing-type" id="populating-a-session-history-entry:navigation-params-nav-timing-type-4" {
						- "navigation timing type"
					}
					- ", and\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-user-involvement" id="populating-a-session-history-entry:navigation-params-user-involvement-4" {
						- "user\n   involvement"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, the document's "
					var {
						- "type"
					}
					- " is such that the resource will not affect\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="populating-a-session-history-entry:navigation-params-navigable-6" {
						- "navigable"
					}
					- ", e.g.,\n   because the resource is to be handed to an external application or because it is an unknown type\n   that will be processed "
					a href="#as-a-download" id="populating-a-session-history-entry:as-a-download-2" {
						- "as a download"
					}
					- ". "
					a href="#hand-off-to-external-software" id="populating-a-session-history-entry:hand-off-to-external-software-4" {
						- "Hand-off to external software"
					}
					- "\n   given "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-response" id="populating-a-session-history-entry:navigation-params-response-13" {
						- "response"
					}
					- ",\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="populating-a-session-history-entry:navigation-params-navigable-7" {
						- "navigable"
					}
					- ",\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-sandboxing" id="populating-a-session-history-entry:navigation-params-sandboxing-4" {
						- "final sandboxing flag\n   set"
					}
					- ", "
					var {
						- "sourceSnapshotParams"
					}
					- "'s "
					a href="#source-snapshot-params-activation" id="populating-a-session-history-entry:source-snapshot-params-activation-4" {
						- "has transient activation"
					}
					- ", and\n   "
					var {
						- "initiatorOrigin"
					}
					- "."
				}
			}
			li {
				p {
					- "Return null."
				}
			}
		}
		- "\n\n\n  "
		h4 id="applying-the-history-step" {
			span class="secno" {
				- "7.4.6"
			}
			- " Applying the history step"
			a href="#applying-the-history-step" class="self-link"
		}
		- "\n\n  "
		p {
			- "For both navigation and traversal, once we have an idea of where we want to head to in the\n  session history, much of the work comes about in applying that notion to the "
			a href="#traversable-navigable" id="applying-the-history-step:traversable-navigable" {
				- "traversable\n  navigable"
			}
			- " and the relevant "
			code id="applying-the-history-step:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ". For navigations, this work generally\n  occurs toward the end of the process; for traversals, it is the beginning."
		}
		- "\n\n  "
		h5 id="updating-the-traversable" {
			span class="secno" {
				- "7.4.6.1"
			}
			- " Updating the traversable"
			a href="#updating-the-traversable" class="self-link"
		}
		- "\n\n  "
		p {
			- "Ensuring a "
			a href="#traversable-navigable" id="updating-the-traversable:traversable-navigable" {
				- "traversable"
			}
			- " ends up at the right\n  session history step is particularly complex, as it can involve coordinating across multiple\n  "
			a href="#navigable" id="updating-the-traversable:navigable" {
				- "navigable"
			}
			- " descendants of the traversable, "
			a href="#populating-a-session-history-entry" {
				- "populating"
			}
			- " them in parallel, and then\n  synchronizing back up to ensure everyone has the same view of the result. This is further\n  complicated by the existence of synchronous same-document navigations being mixed together with\n  cross-document navigations, and how web pages have come to have certain relative timing\n  expectations."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="changing-navigable-continuation-state" {
				- "changing navigable continuation state"
			}
			- " is used to store information during the\n  "
			a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step" {
				- "apply the history step"
			}
			- " algorithm, allowing parts of the algorithm to continue only\n  after other parts have finished. It is a "
			a id="updating-the-traversable:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="changing-nav-continuation-displayed-document" {
					- "displayed document"
				}
			}
			dd {
				- "A "
				code id="updating-the-traversable:document" {
					a href="#document" {
						- "Document"
					}
				}
			}
			dt {
				dfn id="changing-nav-continuation-target-entry" {
					- "target entry"
				}
			}
			dd {
				- "A "
				a href="#session-history-entry" id="updating-the-traversable:session-history-entry" {
					- "session history entry"
				}
			}
			dt {
				dfn id="changing-nav-continuation-navigable" {
					- "navigable"
				}
			}
			dd {
				- "A "
				a href="#navigable" id="updating-the-traversable:navigable-2" {
					- "navigable"
				}
			}
			dt {
				dfn id="changing-nav-continuation-update-only" {
					- "update only"
				}
			}
			dd {
				- "A boolean"
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Although all updates to the "
			a href="#traversable-navigable" id="updating-the-traversable:traversable-navigable-2" {
				- "traversable navigable"
			}
			- " end up in the same "
			a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-2" {
				- "apply\n  the history step"
			}
			- " algorithm, each possible entry point comes along with some minor\n  customizations:"
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="update-for-navigable-creation/destruction" {
				- "update for navigable creation/destruction"
			}
			- " given a "
			a href="#traversable-navigable" id="updating-the-traversable:traversable-navigable-3" {
				- "traversable\n  navigable"
			}
			- " "
			var {
				- "traversable"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "step"
					}
					- " be "
					var {
						- "traversable"
					}
					- "'s "
					a href="#tn-current-session-history-step" id="updating-the-traversable:tn-current-session-history-step" {
						- "current session history step"
					}
					- "."
				}
			}
			li {
				p {
					- "Return the result of "
					a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-3" {
						- "applying the history\n   step"
					}
					- " "
					var {
						- "step"
					}
					- " to "
					var {
						- "traversable"
					}
					- " given false, null, null, \""
					code id="updating-the-traversable:uni-none" {
						a href="#uni-none" {
							- "none"
						}
					}
					- "\", and null."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="apply-the-push/replace-history-step" {
				- "apply the push/replace history step"
			}
			- " given a non-negative integer "
			var {
				- "step"
			}
			- "\n  to a "
			a href="#traversable-navigable" id="updating-the-traversable:traversable-navigable-4" {
				- "traversable navigable"
			}
			- " "
			var {
				- "traversable"
			}
			- ", given a "
			a href="#history-handling-behavior" id="updating-the-traversable:history-handling-behavior" {
				- "history handling\n  behavior"
			}
			- " "
			var {
				- "historyHandling"
			}
			- " and a "
			a href="#user-navigation-involvement" id="updating-the-traversable:user-navigation-involvement" {
				- "user navigation involvement"
			}
			- "\n  "
			var {
				- "userInvolvement"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Return the result of "
					a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-4" {
						- "applying the history\n   step"
					}
					- " "
					var {
						- "step"
					}
					- " to "
					var {
						- "traversable"
					}
					- " given false, null, null,\n   "
					var {
						- "userInvolvement"
					}
					- ", and "
					var {
						- "historyHandling"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			a href="#apply-the-push/replace-history-step" id="updating-the-traversable:apply-the-push/replace-history-step" {
				- "Apply the push/replace history step"
			}
			- " never passes "
			a href="#source-snapshot-params" id="updating-the-traversable:source-snapshot-params" {
				- "source\n  snapshot params"
			}
			- " or an initiator "
			a href="#navigable" id="updating-the-traversable:navigable-3" {
				- "navigable"
			}
			- " to "
			a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-5" {
				- "apply the history\n  step"
			}
			- ". This is because those checks are done earlier in the "
			a href="#navigate" id="updating-the-traversable:navigate" {
				- "navigation"
			}
			- " algorithm."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="apply-the-reload-history-step" {
				- "apply the reload history step"
			}
			- " to a "
			a href="#traversable-navigable" id="updating-the-traversable:traversable-navigable-5" {
				- "traversable navigable"
			}
			- "\n  "
			var {
				- "traversable"
			}
			- " given "
			a href="#user-navigation-involvement" id="updating-the-traversable:user-navigation-involvement-2" {
				- "user navigation involvement"
			}
			- "\n  "
			var {
				- "userInvolvement"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "step"
					}
					- " be "
					var {
						- "traversable"
					}
					- "'s "
					a href="#tn-current-session-history-step" id="updating-the-traversable:tn-current-session-history-step-2" {
						- "current session history step"
					}
					- "."
				}
			}
			li {
				p {
					- "Return the result of "
					a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-6" {
						- "applying the history\n   step"
					}
					- " "
					var {
						- "step"
					}
					- " to "
					var {
						- "traversable"
					}
					- " given true, null, null,\n   "
					var {
						- "userInvolvement"
					}
					- ", and \""
					code id="updating-the-traversable:dom-navigationtype-reload" {
						a href="#dom-navigationtype-reload" {
							- "reload"
						}
					}
					- "\"."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			a href="#apply-the-reload-history-step" id="updating-the-traversable:apply-the-reload-history-step" {
				- "Apply the reload history step"
			}
			- " never passes "
			a href="#source-snapshot-params" id="updating-the-traversable:source-snapshot-params-2" {
				- "source snapshot\n  params"
			}
			- " or an initiator "
			a href="#navigable" id="updating-the-traversable:navigable-4" {
				- "navigable"
			}
			- " to "
			a href="#apply-the-history-step" id="updating-the-traversable:apply-the-history-step-7" {
				- "apply the history step"
			}
