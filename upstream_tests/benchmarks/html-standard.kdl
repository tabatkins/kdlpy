				- "Anything else"
			}
			dd {
				- "\n    \n\n    "
				p {
					a href="#parse-errors" id="parsing-main-inheadnoscript:parse-errors-3" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    \n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-inheadnoscript:current-node-3" {
						- "current node"
					}
					- " (which will be a "
					code id="parsing-main-inheadnoscript:the-noscript-element-2" {
						a href="#the-noscript-element" {
							- "noscript"
						}
					}
					- " element) from the\n    "
					a href="#stack-of-open-elements" id="parsing-main-inheadnoscript:stack-of-open-elements-2" {
