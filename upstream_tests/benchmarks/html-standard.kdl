						- "\n\n      "
						p {
							- "Otherwise, let "
							var {
								- "focus event target"
							}
							- " be null."
						}
						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "entry"
							}
							- " is the last entry in "
							var {
								- "new chain"
							}
							- ", and\n     "
							var {
								- "entry"
							}
							- " is an "
							code id="focus-processing-model:element-3" {
								a data-x-internal="element" href="https://dom.spec.whatwg.org/#interface-element" {
									- "Element"
								}
							}
							- ", and the last entry in "
							var {
								- "old\n     chain"
							}
							- " is also an "
							code id="focus-processing-model:element-4" {
								a data-x-internal="element" href="https://dom.spec.whatwg.org/#interface-element" {
									- "Element"
								}
							}
							- ", then let "
							var {
								- "related focus target"
							}
							- "\n     be the last entry in "
							var {
								- "old chain"
							}
							- ". Otherwise, let "
							var {
								- "related\n     focus target"
							}
							- " be null."
						}
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "focus event target"
							}
							- " is not null, "
							a href="#fire-a-focus-event" id="focus-processing-model:fire-a-focus-event-2" {
								- "fire a focus event"
							}
							- "\n      named "
							code id="focus-processing-model:event-focus" {
								a href="#event-focus" {
									- "focus"
								}
							}
							- " at "
							var {
								- "focus event target"
							}
							- ", with\n      "
							var {
								- "related focus target"
							}
							- " as the related target."
						}
						- "\n\n      "
						p class="note" {
							- "In some cases, e.g. if "
							var {
								- "entry"
							}
							- " is an "
							code id="focus-processing-model:the-area-element-5" {
								a href="#the-area-element" {
									- "area"
								}
							}
							- "\n      element's shape, a scrollable region, or a "
							a id="focus-processing-model:viewport-5" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
								- "viewport"
							}
