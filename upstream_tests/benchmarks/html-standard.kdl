				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-inheadnoscript:insertion-mode-5" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inhead" id="parsing-main-inheadnoscript:parsing-main-inhead-3" {
						- "in\n    head"
					}
					- "\"."
				}
				- "\n    \n\n    "
				p {
					- "Reprocess the token."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="the-after-head-insertion-mode" {
