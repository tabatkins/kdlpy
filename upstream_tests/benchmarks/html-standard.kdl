							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="HTMLElement" id="dom-attachinternals" data-dfn-type="method" {
				code {
					- "attachInternals()"
				}
			}
			- " method steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a id="element-internals:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-element-is-value" id="element-internals:concept-element-is-value" data-x-internal="concept-element-is-value" {
						code {
							- "is"
						}
						- "\n   value"
					}
					- " is not null, then throw a "
					a id="element-internals:notsupportederror" href="https://webidl.spec.whatwg.org/#notsupportederror" data-x-internal="notsupportederror" {
						- "\""
						code {
							- "NotSupportedError"
						}
						- "\""
					}
					- "\n   "
					code id="element-internals:domexception" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "definition"
					}
					- " be the result of "
					a href="#look-up-a-custom-element-definition" id="element-internals:look-up-a-custom-element-definition" {
						- "looking up a custom element definition"
					}
					- " given "
					a id="element-internals:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a id="element-internals:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n   document"
					}
					- ", its namespace, its local name, and null as the "
					a href="https://dom.spec.whatwg.org/#concept-element-is-value" id="element-internals:concept-element-is-value-2" data-x-internal="concept-element-is-value" {
						code {
							- "is"
						}
						- " value"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
