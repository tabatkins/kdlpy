		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the "
				code id="the-img-element:attr-img-src-5" {
					a href="#attr-img-src" {
						- "src"
					}
				}
				- " attribute is set and the "
				code id="the-img-element:attr-img-alt-5" {
