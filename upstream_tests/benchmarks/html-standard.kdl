			}
			- " must be set to that\n  character encoding."
		}
		- "\n\n  "
		p {
			- "Before any script execution occurs, the user agent must wait for "
			a href="#scripts-may-run-for-the-newly-created-document" id="read-xml:scripts-may-run-for-the-newly-created-document" {
