				}
			}
			- " objects\n  below, have an "
			dfn id="concept-canvas-origin-clean" {
				- "origin-clean"
			}
			- " flag, which can be\n  set to true or false. Initially, when the "
			code id="the-canvas-element:the-canvas-element-25" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element or "
