					}
					dt {
						- "The "
						a href="#concept-settings-object-module-map" id="script-settings-for-worklets:concept-settings-object-module-map" {
							- "module map"
						}
					}
					dd {
						- "\n      "
						p {
							- "Return "
							var {
								- "workletGlobalScope"
							}
							- "'s "
							a href="#concept-workletglobalscope-module-map" id="script-settings-for-worklets:concept-workletglobalscope-module-map" {
								- "module map"
							}
							- "."
						}
						- "\n     "
					}
					dt {
						- "The "
						a href="#api-base-url" id="script-settings-for-worklets:api-base-url-2" {
							- "API base URL"
						}
					}
					dd {
						- "\n      "
						p {
							- "Return "
							var {
								- "inheritedAPIBaseURL"
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "Unlike workers or other globals derived from a single resource, worklets have\n      no primary resource; instead, multiple scripts, each with their own URL, are loaded into the\n      global scope via "
							code id="script-settings-for-worklets:dom-worklet-addmodule" {
								a href="#dom-worklet-addmodule" {
									- "worklet.addModule()"
								}
							}
							- ". So this "
							a href="#api-base-url" id="script-settings-for-worklets:api-base-url-3" {
								- "API base URL"
							}
							- "\n      is rather unlike that of other globals. However, so far this doesn't matter, as no APIs\n      available to worklet code make use of the "
							a href="#api-base-url" id="script-settings-for-worklets:api-base-url-4" {
								- "API base URL"
							}
