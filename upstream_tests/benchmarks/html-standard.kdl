			- " of the "
			a href="#text-track-cue" id="text-track-api:text-track-cue-20" {
				- "text track cue"
			}
			- " that\n  the "
			code id="text-track-api:texttrackcue-11" {
				a href="#texttrackcue" {
					- "TextTrackCue"
				}
			}
			- " object represents is set; or false otherwise.  On setting, the\n  "
			a href="#text-track-cue-pause-on-exit-flag" id="text-track-api:text-track-cue-pause-on-exit-flag-3" {
				- "text track cue pause-on-exit flag"
			}
			- " must be set if the new value is true, and must be\n  unset otherwise."
		}
		- "\n\n\n  "
