				a href="#palpable-content-2" id="custom-elements-core-concepts:palpable-content-2" {
					- "Palpable content"
				}
				- "."
			}
			dd {
				- "For "
				a href="#form-associated-custom-element" id="custom-elements-core-concepts:form-associated-custom-element" {
					- "form-associated custom elements"
				}
