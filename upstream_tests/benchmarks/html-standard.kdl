				- "inline size"
			}
			- " of the\n  "
			a id="the-select-element-2:intrinsic-size-4" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " depends on the shown text. The shown text is typically the label of\n  an "
			code id="the-select-element-2:the-option-element" {
				a href="#the-option-element" {
					- "option"
				}
			}
			- " of which "
