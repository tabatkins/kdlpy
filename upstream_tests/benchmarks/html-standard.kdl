				- "devolvable widget"
			}
			- "\n  expected to render as an "
			a id="the-select-element-2:'inline-block'" href="https://drafts.csswg.org/css2/#value-def-inline-block" data-x-internal="'inline-block'" {
				- "'inline-block'"
			}
			- " box. The "
			a id="the-select-element-2:inline-size" href="https://drafts.csswg.org/css-writing-modes/#inline-size" data-x-internal="inline-size" {
				- "inline size"
			}
			- " of its\n  "
			a id="the-select-element-2:intrinsic-size" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " is the "
			a href="#width-of-the-select's-labels" id="the-select-element-2:width-of-the-select's-labels" {
				- "width of the "
				code {
					- "select"
				}
				- "'s labels"
			}
			- " plus\n  the width of a scrollbar. The "
			a id="the-select-element-2:block-size" href="https://drafts.csswg.org/css-writing-modes/#block-size" data-x-internal="block-size" {
				- "block size"
			}
			- " of its "
			a id="the-select-element-2:intrinsic-size-2" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " is\n  determined by the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the "
					a id="the-select-element-2:'field-sizing'-2" href="https://drafts.csswg.org/css-ui/#field-sizing" data-x-internal="'field-sizing'" {
						- "'field-sizing'"
					}
					- " property on the element has a "
					a id="the-select-element-2:computed-value" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
						- "computed value"
					}
					- "\n    of "
					a href="https://drafts.csswg.org/css-ui/#valdef-field-sizing-content" id="the-select-element-2:field-sizing-content" data-x-internal="field-sizing-content" {
						- "'content'"
					}
					- ", return the height necessary to contain\n    all rows for items."
