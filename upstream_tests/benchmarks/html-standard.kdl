			}
			li {
				p {
					- "Set "
					var {
						- "document"
					}
					- "'s "
					a href="#completely-loaded-time" id="loading-documents:completely-loaded-time-2" {
						- "completely loaded time"
					}
					- " to the current\n   time."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "container"
					}
					- " be "
					var {
						- "document"
					}
					- "'s "
					a href="#node-navigable" id="loading-documents:node-navigable" {
						- "node navigable"
					}
					- "'s "
					a href="#nav-container" id="loading-documents:nav-container" {
						- "container"
