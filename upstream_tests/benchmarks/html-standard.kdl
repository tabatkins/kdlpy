		p {
			- "The "
			dfn data-dfn-for="PromiseRejectionEvent" id="dom-promiserejectionevent-reason" data-dfn-type="attribute" {
				code {
					- "reason"
				}
			}
			- " attribute must return the value it\n  was initialized to. It represents the rejection reason for the promise."
		}
		- "\n\n\n  "
		h5 id="import-map-parse-results" {
			span class="secno" {
				- "8.1.4.8"
			}
			- " Import map parse results"
			a href="#import-map-parse-results" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="import-map-parse-result" {
				- "import map parse result"
			}
			- " is a "
			a id="import-map-parse-results:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " that is similar to a "
			a href="#concept-script" id="import-map-parse-results:concept-script" {
				- "script"
			}
			- ", and also can be stored in a "
			code id="import-map-parse-results:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element's\n  "
			a href="#concept-script-result" id="import-map-parse-results:concept-script-result" {
				- "result"
			}
			- ", but is not counted as a "
			a href="#concept-script" id="import-map-parse-results:concept-script-2" {
				- "script"
			}
			- " for other purposes. It has the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="import-map-parse-results:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		dl {
			dt {
				- "An "
				dfn id="impr-import-map" {
					- "import map"
				}
			}
			dd {
				- "An "
				a href="#import-map" id="import-map-parse-results:import-map" {
					- "import map"
				}
				- " or null."
			}
			dt {
				- "An "
				dfn id="impr-error-to-rethrow" {
					- "error to rethrow"
				}
			}
			dd {
				- "A JavaScript value representing an error that will prevent using this import map, when\n   non-null."
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="create-an-import-map-parse-result" {
				- "create an import map parse result"
			}
			- " given a "
			a id="import-map-parse-results:string" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
			}
			- " "
			var {
				- "input"
			}
			- "\n  and a "
			a id="import-map-parse-results:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " "
			var {
				- "baseURL"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be an "
					a href="#import-map-parse-result" id="import-map-parse-results:import-map-parse-result" {
						- "import map parse result"
					}
					- " whose "
					a href="#impr-import-map" id="import-map-parse-results:impr-import-map" {
						- "import map"
					}
					- " is null and whose "
					a href="#impr-error-to-rethrow" id="import-map-parse-results:impr-error-to-rethrow" {
						- "error to rethrow"
					}
					- " is null."
				}
			}
			li {
				p {
					a href="#parse-an-import-map-string" id="import-map-parse-results:parse-an-import-map-string" {
						- "Parse an import map string"
					}
					- " given "
					var {
						- "input"
					}
					- " and "
					var {
						- "baseURL"
					}
					- ",\n   catching any exceptions. If this threw an exception, then set "
					var {
						- "result"
					}
					- "'s "
					a href="#impr-error-to-rethrow" id="import-map-parse-results:impr-error-to-rethrow-2" {
						- "error to rethrow"
					}
					- " to that exception. Otherwise, set\n   "
					var {
						- "result"
					}
					- "'s "
					a href="#impr-import-map" id="import-map-parse-results:impr-import-map-2" {
						- "import map"
					}
					- " to the return\n   value."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "result"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="register-an-import-map" {
				- "register an import map"
			}
			- " given a "
			code id="import-map-parse-results:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " "
			var {
				- "global"
			}
			- " and an\n  "
			a href="#import-map-parse-result" id="import-map-parse-results:import-map-parse-result-2" {
				- "import map parse result"
			}
			- " "
			var {
				- "result"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "result"
					}
					- "'s "
					a href="#impr-error-to-rethrow" id="import-map-parse-results:impr-error-to-rethrow-3" {
						- "error to rethrow"
					}
					- " is\n   not null, then "
					a href="#report-an-exception" id="import-map-parse-results:report-an-exception" {
						- "report an exception"
					}
					- " given by "
					var {
						- "result"
					}
					- "'s "
					a href="#impr-error-to-rethrow" id="import-map-parse-results:impr-error-to-rethrow-4" {
						- "error to rethrow"
					}
					- " for "
					var {
						- "global"
					}
					- " and\n   return."
				}
			}
			li {
				p {
					a href="#merge-existing-and-new-import-maps" id="import-map-parse-results:merge-existing-and-new-import-maps" {
						- "Merge existing and new import\n   maps"
					}
					- ", given "
					var {
						- "global"
					}
					- " and "
					var {
						- "result"
					}
					- "'s "
					a href="#impr-import-map" id="import-map-parse-results:impr-import-map-3" {
						- "import map"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h4 id="module-specifier-resolution" {
			span class="secno" {
				- "8.1.5"
			}
			- " Module specifier resolution"
			a href="#module-specifier-resolution" class="self-link"
		}
		- "\n\n  "
		h5 id="the-resolution-algorithm" {
			span class="secno" {
				- "8.1.5.1"
			}
			- " The resolution algorithm"
			a href="#the-resolution-algorithm" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			a href="#resolve-a-module-specifier" id="the-resolution-algorithm:resolve-a-module-specifier" {
				- "resolve a module specifier"
			}
			- " algorithm is the primary entry point for\n  converting module specifier strings into "
			a href="https://url.spec.whatwg.org/#concept-url" id="the-resolution-algorithm:url" data-x-internal="url" {
				- "URLs"
			}
			- ". When no "
			a href="#import-map" id="the-resolution-algorithm:import-map" {
				- "import maps"
			}
			- " are involved, it is relatively straightforward, and\n  reduces to "
			a href="#resolving-a-url-like-module-specifier" id="the-resolution-algorithm:resolving-a-url-like-module-specifier" {
				- "resolving a URL-like module specifier"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When there is a non-empty "
			a href="#import-map" id="the-resolution-algorithm:import-map-2" {
				- "import map"
			}
			- " present, the behavior is more complex. It\n  checks candidate entries from all applicable "
			a href="#module-specifier-map" id="the-resolution-algorithm:module-specifier-map" {
				- "module specifier\n  maps"
			}
			- ", from most-specific to least-specific "
			a href="#concept-import-map-scopes" id="the-resolution-algorithm:concept-import-map-scopes" {
				- "scopes"
			}
			- " (falling back to the top-level unscoped "
			a href="#concept-import-map-imports" id="the-resolution-algorithm:concept-import-map-imports" {
				- "imports"
			}
			- "), and from most-specific to least-specific\n  prefixes. For each candidate, the "
			a href="#resolving-an-imports-match" id="the-resolution-algorithm:resolving-an-imports-match" {
				- "resolve\n  an imports match"
			}
			- " algorithm will give on the following results:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "Successful resolution of the specifier to a "
					a id="the-resolution-algorithm:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- ". Then the\n  "
					a href="#resolve-a-module-specifier" id="the-resolution-algorithm:resolve-a-module-specifier-2" {
						- "resolve a module specifier"
					}
					- " algorithm will return that URL."
				}
			}
			li {
				p {
					- "Throwing an exception. Then the "
					a href="#resolve-a-module-specifier" id="the-resolution-algorithm:resolve-a-module-specifier-3" {
						- "resolve a module specifier"
					}
					- " algorithm will\n   rethrow that exception, without any further fallbacks."
				}
			}
			li {
				p {
					- "Failing to resolve, without an error. In this case the outer "
					a href="#resolve-a-module-specifier" id="the-resolution-algorithm:resolve-a-module-specifier-4" {
						- "resolve a module\n   specifier"
					}
					- " algorithm will move on to the next candidate."
				}
			}
		}
		- "\n\n  "
		p {
			- "In the end, if no successful resolution is found via any of the candidate "
			a href="#module-specifier-map" id="the-resolution-algorithm:module-specifier-map-2" {
				- "module specifier maps"
			}
			- ", "
			a href="#resolve-a-module-specifier" id="the-resolution-algorithm:resolve-a-module-specifier-5" {
				- "resolve a module specifier"
			}
			- " will throw\n  an exception. Thus the result is always either a "
			a id="the-resolution-algorithm:url-3" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " or a thrown exception."
		}
		- "\n\n  \n\n  "
		p {
			- "To "
			dfn id="resolve-a-module-specifier" {
				- "resolve a module specifier"
			}
			- " given a "
			a href="#the-script-element" id="the-resolution-algorithm:the-script-element" {
				- "script"
			}
			- "-or-null\n  "
			var {
				- "referringScript"
			}
			- " and a "
			a id="the-resolution-algorithm:string" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
			}
			- " "
			var {
				- "specifier"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "settingsObject"
					}
					- " and "
					var {
						- "baseURL"
					}
					- " be null."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "referringScript"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "settingsObject"
							}
							- " to "
							var {
								- "referringScript"
							}
							- "'s\n     "
							a href="#settings-object" id="the-resolution-algorithm:settings-object" {
								- "settings object"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "baseURL"
							}
							- " to "
							var {
								- "referringScript"
							}
							- "'s "
							a href="#concept-script-base-url" id="the-resolution-algorithm:concept-script-base-url" {
								- "base URL"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a id="the-resolution-algorithm:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": there is a "
							a href="#current-settings-object" id="the-resolution-algorithm:current-settings-object" {
								- "current settings object"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "settingsObject"
							}
							- " to the "
							a href="#current-settings-object" id="the-resolution-algorithm:current-settings-object-2" {
								- "current settings object"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "baseURL"
							}
							- " to "
							var {
								- "settingsObject"
							}
							- "'s "
							a href="#api-base-url" id="the-resolution-algorithm:api-base-url" {
								- "API base\n     URL"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "importMap"
					}
					- " be an "
					a href="#empty-import-map" id="the-resolution-algorithm:empty-import-map" {
						- "empty import map"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "settingsObject"
					}
					- "'s "
					a href="#concept-settings-object-global" id="the-resolution-algorithm:concept-settings-object-global" {
						- "global\n   object"
					}
					- " implements "
					code id="the-resolution-algorithm:window" {
						a href="#window" {
							- "Window"
						}
					}
					- ", then set "
					var {
						- "importMap"
					}
					- " to\n   "
					var {
						- "settingsObject"
					}
					- "'s "
					a href="#concept-settings-object-global" id="the-resolution-algorithm:concept-settings-object-global-2" {
						- "global object"
					}
					- "'s\n   "
					a href="#concept-global-import-map" id="the-resolution-algorithm:concept-global-import-map" {
						- "import map"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "serializedBaseURL"
					}
					- " be "
					var {
						- "baseURL"
					}
					- ", "
					a href="https://url.spec.whatwg.org/#concept-url-serializer" id="the-resolution-algorithm:concept-url-serializer" data-x-internal="concept-url-serializer" {
						- "serialized"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "asURL"
					}
					- " be the result of "
					a href="#resolving-a-url-like-module-specifier" id="the-resolution-algorithm:resolving-a-url-like-module-specifier-2" {
						- "resolving a URL-like module specifier"
					}
					- "\n   given "
					var {
						- "specifier"
					}
					- " and "
					var {
						- "baseURL"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "normalizedSpecifier"
					}
					- " be the "
					a href="https://url.spec.whatwg.org/#concept-url-serializer" id="the-resolution-algorithm:concept-url-serializer-2" data-x-internal="concept-url-serializer" {
						- "serialization"
					}
					- " of "
					var {
						- "asURL"
					}
					- ", if "
					var {
						- "asURL"
					}
					- " is\n   non-null; otherwise, "
					var {
						- "specifier"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be a "
					a id="the-resolution-algorithm:url-4" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- "-or-null, initially null."
				}
			}
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="the-resolution-algorithm:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "scopePrefix"
					}
					- " → "
					var {
						- "scopeImports"
					}
					- "\n    of "
					var {
						- "importMap"
					}
					- "'s "
					a href="#concept-import-map-scopes" id="the-resolution-algorithm:concept-import-map-scopes-2" {
						- "scopes"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "scopePrefix"
							}
							- " is "
							var {
								- "serializedBaseURL"
							}
							- ", or if "
							var {
								- "scopePrefix"
							}
							- " ends\n      with U+002F (/) and "
							var {
								- "scopePrefix"
							}
							- " is a "
							a id="the-resolution-algorithm:code-unit-prefix" href="https://infra.spec.whatwg.org/#code-unit-prefix" data-x-internal="code-unit-prefix" {
								- "code unit prefix"
							}
							- " of\n      "
							var {
								- "serializedBaseURL"
							}
							- ", then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "scopeImportsMatch"
									}
									- " be the result of "
									a href="#resolving-an-imports-match" id="the-resolution-algorithm:resolving-an-imports-match-2" {
										- "resolving an imports\n       match"
									}
									- " given "
									var {
										- "normalizedSpecifier"
									}
									- ", "
									var {
										- "asURL"
									}
									- ", and\n       "
									var {
										- "scopeImports"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "scopeImportsMatch"
									}
									- " is not null, then set "
									var {
										- "result"
									}
									- " to\n       "
									var {
										- "scopeImportsMatch"
									}
									- ", and "
									a id="the-resolution-algorithm:break" href="https://infra.spec.whatwg.org/#iteration-break" data-x-internal="break" {
										- "break"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "result"
					}
					- " is null, set "
					var {
						- "result"
					}
					- " be the result of "
					a href="#resolving-an-imports-match" id="the-resolution-algorithm:resolving-an-imports-match-3" {
						- "resolving an\n   imports match"
					}
					- " given "
					var {
						- "normalizedSpecifier"
					}
