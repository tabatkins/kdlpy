			}
			- " and then attempting to populate its "
			a href="#she-document" id="populating-a-session-history-entry:she-document" {
				- "document"
			}
			- "\n  member, so that it can be presented inside the "
			a href="#navigable" id="populating-a-session-history-entry:navigable" {
				- "navigable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "This involves either: using "
			a href="#note-navigate-called-with-response" {
				- "an already-given\n  response"
			}
			- "; using the "
			a href="#document-state-resource" id="populating-a-session-history-entry:document-state-resource" {
				- "srcdoc resource"
			}
			- " stored in\n  the "
			a href="#session-history-entry" id="populating-a-session-history-entry:session-history-entry-2" {
				- "session history entry"
			}
			- "; or "
			a href="#create-navigation-params-by-fetching" id="populating-a-session-history-entry:create-navigation-params-by-fetching" {
				- "fetching"
			}
			- ". The process has several failure modes, which can either result in\n  doing nothing (leaving the "
			a href="#navigable" id="populating-a-session-history-entry:navigable-2" {
				- "navigable"
			}
			- " on its currently-"
			a href="#nav-document" id="populating-a-session-history-entry:nav-document" {
				- "active"
			}
			- " "
			code id="populating-a-session-history-entry:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ") or can result in populating the\n  "
			a href="#session-history-entry" id="populating-a-session-history-entry:session-history-entry-3" {
				- "session history entry"
			}
			- " with an "
			a href="#read-ua-inline" id="populating-a-session-history-entry:read-ua-inline" {
				- "error\n  document"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="attempt-to-populate-the-history-entry's-document" {
				- "attempt to populate the history entry's document"
			}
			- " for a "
			a href="#session-history-entry" id="populating-a-session-history-entry:session-history-entry-4" {
				- "session history\n  entry"
			}
			- " "
			var {
				- "entry"
			}
			- ", given a "
			a href="#navigable" id="populating-a-session-history-entry:navigable-3" {
				- "navigable"
			}
			- " "
			var {
				- "navigable"
			}
			- ", a\n  "
			code id="populating-a-session-history-entry:navigationtimingtype" {
				a data-x-internal="navigationtimingtype" href="https://w3c.github.io/navigation-timing/#dom-navigationtimingtype" {
					- "NavigationTimingType"
				}
			}
			- " "
			var {
				- "navTimingType"
			}
			- ", a "
			a href="#source-snapshot-params" id="populating-a-session-history-entry:source-snapshot-params" {
				- "source snapshot params"
			}
			- "\n  "
			var {
				- "sourceSnapshotParams"
			}
			- ", a "
			a href="#target-snapshot-params" id="populating-a-session-history-entry:target-snapshot-params" {
				- "target snapshot params"
			}
			- "\n  "
			var {
				- "targetSnapshotParams"
			}
			- ", a "
			a href="#user-navigation-involvement" id="populating-a-session-history-entry:user-navigation-involvement" {
				- "user navigation involvement"
			}
			- "\n  "
			var {
				- "userInvolvement"
			}
			- ", an optional "
			a href="#navigation-id" id="populating-a-session-history-entry:navigation-id" {
				- "navigation ID"
			}
			- "-or-null "
			var {
				- "navigationId"
			}
			- "\n  (default null), an optional "
			a href="#navigation-params" id="populating-a-session-history-entry:navigation-params" {
				- "navigation params"
			}
			- "-or-null "
			var {
				- "navigationParams"
			}
			- "\n  (default null), an optional string "
			var {
				- "cspNavigationType"
			}
			- " (default \""
			code {
				- "other"
			}
			- "\"), an optional boolean "
			dfn id="attempt-to-populate-allow-post" {
				var {
					- "allowPOST"
				}
			}
			- " (default false), and optional\n  algorithm steps "
			dfn id="attempt-to-populate-completion-steps" {
				var {
					- "completionSteps"
				}
			}
			- " (default an empty\n  algorithm):"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a id="populating-a-session-history-entry:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": this is running "
					a href="#in-parallel" id="populating-a-session-history-entry:in-parallel" {
						- "in parallel"
					}
					- "."
				}
			}
			li {
				p {
					a id="populating-a-session-history-entry:assert-2" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": if "
					var {
						- "navigationParams"
					}
					- " is non-null, then\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-response" id="populating-a-session-history-entry:navigation-params-response" {
						- "response"
					}
					- " is\n   non-null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "documentResource"
					}
					- " be "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-document-state" id="populating-a-session-history-entry:she-document-state" {
						- "document state"
					}
					- "'s "
					a href="#document-state-resource" id="populating-a-session-history-entry:document-state-resource-2" {
						- "resource"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "navigationParams"
					}
					- " is null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "documentResource"
							}
							- " is a string, then set "
							var {
								- "navigationParams"
							}
							- " to the\n     result of "
							a href="#create-navigation-params-from-a-srcdoc-resource" id="populating-a-session-history-entry:create-navigation-params-from-a-srcdoc-resource" {
								- "creating navigation\n     params from a srcdoc resource"
							}
							- " given "
							var {
								- "entry"
							}
							- ", "
							var {
								- "navigable"
							}
							- ",\n     "
							var {
								- "targetSnapshotParams"
							}
							- ", "
							var {
								- "userInvolvement"
							}
							- ", "
							var {
								- "navigationId"
							}
							- ", and\n     "
							var {
								- "navTimingType"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Otherwise, if all of the following are true:\n\n      "
						}
						ul {
							li {
								p {
									var {
										- "entry"
									}
									- "'s "
									a href="#she-url" id="populating-a-session-history-entry:she-url" {
										- "URL"
									}
									- "'s "
									a href="https://url.spec.whatwg.org/#concept-url-scheme" id="populating-a-session-history-entry:concept-url-scheme" data-x-internal="concept-url-scheme" {
										- "scheme"
									}
									- " is a "
									a id="populating-a-session-history-entry:fetch-scheme" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
										- "fetch scheme"
									}
									- "; and"
								}
							}
							li {
								p {
									var {
										- "documentResource"
									}
									- " is null, or "
									var {
										- "allowPOST"
									}
									- " is true and\n       "
									var {
										- "documentResource"
									}
									- "'s "
									a href="#post-resource-request-body" id="populating-a-session-history-entry:post-resource-request-body" {
										- "request body"
									}
									- "\n       is not failure,"
								}
							}
						}
						- "\n\n      "
						p {
							- "then set "
							var {
								- "navigationParams"
							}
							- " to the result of "
							a href="#create-navigation-params-by-fetching" id="populating-a-session-history-entry:create-navigation-params-by-fetching-2" {
								- "creating navigation params by fetching"
							}
							- " given "
							var {
								- "entry"
							}
							- ",\n      "
							var {
								- "navigable"
							}
							- ", "
							var {
								- "sourceSnapshotParams"
							}
							- ", "
							var {
								- "targetSnapshotParams"
							}
							- ",\n      "
							var {
								- "cspNavigationType"
							}
							- ", "
							var {
								- "userInvolvement"
							}
							- ", "
							var {
								- "navigationId"
							}
							- ", and\n      "
							var {
								- "navTimingType"
							}
							- "."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Otherwise, if "
							var {
								- "entry"
							}
							- "'s "
							a href="#she-url" id="populating-a-session-history-entry:she-url-2" {
								- "URL"
							}
							- "'s "
							a href="https://url.spec.whatwg.org/#concept-url-scheme" id="populating-a-session-history-entry:concept-url-scheme-2" data-x-internal="concept-url-scheme" {
								- "scheme"
							}
							- " is not a "
							a id="populating-a-session-history-entry:fetch-scheme-2" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
								- "fetch scheme"
							}
							- ", then set\n      "
							var {
								- "navigationParams"
							}
							- " to a new "
							a href="#non-fetch-scheme-navigation-params" id="populating-a-session-history-entry:non-fetch-scheme-navigation-params" {
								- "non-fetch scheme navigation params"
							}
							- ",\n      with"
						}
						- "\n\n      "
						dl class="props" {
							dt {
								a href="#non-fetch-scheme-params-id" id="populating-a-session-history-entry:non-fetch-scheme-params-id" {
									- "id"
								}
							}
							dd {
								var {
									- "navigationId"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-navigable" id="populating-a-session-history-entry:non-fetch-scheme-params-navigable" {
									- "navigable"
								}
							}
							dd {
								var {
									- "navigable"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-url" id="populating-a-session-history-entry:non-fetch-scheme-params-url" {
									- "URL"
								}
							}
							dd {
								var {
									- "entry"
								}
								- "'s "
								a href="#she-url" id="populating-a-session-history-entry:she-url-3" {
									- "URL"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-target-sandbox" id="populating-a-session-history-entry:non-fetch-scheme-params-target-sandbox" {
									- "target snapshot sandboxing flags"
								}
							}
							dd {
								var {
									- "targetSnapshotParams"
								}
								- "'s "
								a href="#target-snapshot-params-sandbox" id="populating-a-session-history-entry:target-snapshot-params-sandbox" {
									- "sandboxing flags"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-source-activation" id="populating-a-session-history-entry:non-fetch-scheme-params-source-activation" {
									- "source snapshot has transient activation"
								}
							}
							dd {
								var {
									- "sourceSnapshotParams"
								}
								- "'s "
								a href="#source-snapshot-params-activation" id="populating-a-session-history-entry:source-snapshot-params-activation" {
									- "has\n       transient activation"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-initiator-origin" id="populating-a-session-history-entry:non-fetch-scheme-params-initiator-origin" {
									- "initiator origin"
								}
							}
							dd {
								var {
									- "entry"
								}
								- "'s "
								a href="#she-document-state" id="populating-a-session-history-entry:she-document-state-2" {
									- "document state"
								}
								- "'s "
								a href="#document-state-initiator-origin" id="populating-a-session-history-entry:document-state-initiator-origin" {
									- "initiator origin"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-nav-timing-type" id="populating-a-session-history-entry:non-fetch-scheme-params-nav-timing-type" {
									- "navigation timing type"
								}
							}
							dd {
								var {
									- "navTimingType"
								}
							}
							dt {
								a href="#non-fetch-scheme-params-user-involvement" id="populating-a-session-history-entry:non-fetch-scheme-params-user-involvement" {
									- "user involvement"
								}
							}
							dd {
								var {
									- "userInvolvement"
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li id="process-a-navigate-response" {
				- "\n    "
				p {
					a href="#queue-a-global-task" id="populating-a-session-history-entry:queue-a-global-task" {
						- "Queue a global task"
					}
					- " on the "
					a href="#navigation-and-traversal-task-source" id="populating-a-session-history-entry:navigation-and-traversal-task-source" {
						- "navigation and traversal task source"
					}
					- ",\n    given "
					var {
						- "navigable"
					}
					- "'s "
					a href="#active-window" id="populating-a-session-history-entry:active-window" {
						- "active window"
					}
					- ", to run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "navigable"
							}
							- "'s "
							a href="#ongoing-navigation" id="populating-a-session-history-entry:ongoing-navigation" {
								- "ongoing navigation"
							}
							- " no longer equals\n     "
							var {
								- "navigationId"
							}
							- ", then run "
							var {
								- "completionSteps"
							}
							- " and abort these steps."
						}
					}
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "saveExtraDocumentState"
							}
							- " be true."
						}
						- "\n\n      "
						div class="note" {
							- "\n       "
							p {
								- "Usually, in the cases where we end up populating "
								var {
									- "entry"
								}
								- "'s "
								a href="#she-document-state" id="populating-a-session-history-entry:she-document-state-3" {
									- "document state"
								}
								- "'s "
								a href="#document-state-document" id="populating-a-session-history-entry:document-state-document" {
									- "document"
								}
								- ", we then want to save some of the state\n       from that "
								code id="populating-a-session-history-entry:document-2" {
									a href="#document" {
										- "Document"
									}
								}
								- " into "
								var {
									- "entry"
								}
								- ". This ensures that if there are future\n       traversals to "
								var {
									- "entry"
								}
								- " where its "
								a href="#document-state-document" id="populating-a-session-history-entry:document-state-document-2" {
									- "document"
								}
								- " "
								a href="#note-bfcache" {
									- "has been\n       destroyed"
								}
								- ", we can use that state when creating a new "
								code id="populating-a-session-history-entry:document-3" {
									a href="#document" {
										- "Document"
									}
								}
								- "."
							}
							- "\n\n       "
							p {
								- "However, in some specific cases, saving the state would be unhelpful. For those, we set\n       "
								var {
									- "saveExtraDocumentState"
								}
								- " to false later in this algorithm."
							}
							- "\n      "
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "navigationParams"
							}
							- " is a "
							a href="#non-fetch-scheme-navigation-params" id="populating-a-session-history-entry:non-fetch-scheme-navigation-params-2" {
								- "non-fetch scheme navigation params"
							}
							- ",\n      then:"
						}
						- "\n\n      "
						ol {
							li {
								- "\n        "
								p {
									- "Set "
									var {
										- "entry"
									}
									- "'s "
									a href="#she-document-state" id="populating-a-session-history-entry:she-document-state-4" {
										- "document state"
									}
									- "'s "
									a href="#document-state-document" id="populating-a-session-history-entry:document-state-document-3" {
										- "document"
									}
									- " to the result of running "
									a href="#attempt-to-create-a-non-fetch-scheme-document" id="populating-a-session-history-entry:attempt-to-create-a-non-fetch-scheme-document" {
										- "attempt to\n        create a non-fetch scheme document"
									}
									- " given "
									var {
										- "navigationParams"
									}
									- "."
								}
								- "\n\n        "
								p class="note" {
									- "This can result in setting "
									var {
										- "entry"
									}
									- "'s "
									a href="#she-document-state" id="populating-a-session-history-entry:she-document-state-5" {
										- "document state"
									}
									- "'s "
									a href="#document-state-document" id="populating-a-session-history-entry:document-state-document-4" {
										- "document"
									}
									- " to null, e.g., when "
									a href="#hand-off-to-external-software" id="populating-a-session-history-entry:hand-off-to-external-software" {
										- "handing-off to external software"
									}
									- "."
								}
								- "\n       "
							}
							li {
								p {
									- "Set "
									var {
										- "saveExtraDocumentState"
									}
									- " to false."
								}
							}
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Otherwise, if any of the following are true:"
						}
						- "\n\n      "
						ul {
							li {
								p {
									var {
										- "navigationParams"
									}
									- " is null;"
								}
							}
							li {
								p {
									- "the result of "
									a id="populating-a-session-history-entry:should-navigation-response-to-navigation-request-of-type-in-target-be-blocked-by-content-security-policy" href="https://w3c.github.io/webappsec-csp/#should-block-navigation-response" data-x-internal="should-navigation-response-to-navigation-request-of-type-in-target-be-blocked-by-content-security-policy" {
										- "should navigation response to navigation request of type in\n       target be blocked by Content Security Policy?"
									}
									- " given "
									var {
										- "navigationParams"
									}
									- "'s\n       "
									a href="#navigation-params-request" id="populating-a-session-history-entry:navigation-params-request" {
										- "request"
									}
									- ", "
									var {
										- "navigationParams"
									}
									- "'s "
									a href="#navigation-params-response" id="populating-a-session-history-entry:navigation-params-response-2" {
										- "response"
									}
									- ", "
									var {
										- "navigationParams"
									}
									- "'s "
									a href="#navigation-params-policy-container" id="populating-a-session-history-entry:navigation-params-policy-container" {
										- "policy container"
									}
									- "'s "
									a href="#policy-container-csp-list" id="populating-a-session-history-entry:policy-container-csp-list" {
										- "CSP list"
									}
									- ", "
									var {
										- "cspNavigationType"
									}
									- ", and\n       "
									var {
										- "navigable"
									}
									- " is \""
									code {
										- "Blocked"
									}
									- "\";"
								}
							}
							li {
								p {
									var {
										- "navigationParams"
									}
									- "'s "
									a href="#navigation-params-reserved-environment" id="populating-a-session-history-entry:navigation-params-reserved-environment" {
										- "reserved environment"
									}
									- " is non-null and\n       the result of "
									a href="#check-a-navigation-response's-adherence-to-its-embedder-policy" id="populating-a-session-history-entry:check-a-navigation-response's-adherence-to-its-embedder-policy" {
										- "checking a navigation response's adherence to its embedder policy"
									}
									- " given\n       "
									var {
										- "navigationParams"
