				}
			}
			- ", "
			code id="media-elements:attr-media-preload" {
				a href="#attr-media-preload" {
					- "preload"
				}
			}
			- ", "
			code id="media-elements:attr-media-autoplay" {
				a href="#attr-media-autoplay" {
					- "autoplay"
				}
			}
			- ",\n  "
			code id="media-elements:attr-media-loop" {
				a href="#attr-media-loop" {
					- "loop"
				}
			}
			- ", "
			code id="media-elements:attr-media-muted" {
				a href="#attr-media-muted" {
					- "muted"
				}
			}
			- ", and\n  "
			code id="media-elements:attr-media-controls" {
				a href="#attr-media-controls" {
					- "controls"
				}
			}
			- ", apply to all "
			a href="#media-element" id="media-elements:media-element" {
				- "media elements"
			}
			- ". They are defined in this section."
		}
		- "\n\n  \n\n  "
		p {
			a href="#media-element" id="media-elements:media-element-2" {
				- "Media elements"
			}
			- " are used to present audio data, or video and\n  audio data, to the user. This is referred to as "
			dfn data-dfn-for="HTMLMediaElement" id="media-data" data-export="" {
				- "media data"
			}
			- "\n  in this section, since this section applies equally to "
			a href="#media-element" id="media-elements:media-element-3" {
				- "media\n  elements"
			}
			- " for audio or for video.\n\n  The term "
			dfn id="media-resource" {
				- "media resource"
			}
			- " is used to refer to the complete set of media data, e.g. the\n  complete video file, or complete audio file.\n\n  "
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-resource" id="media-elements:media-resource" {
				- "media resource"
			}
			- " has an associated\n  "
			dfn id="media-resource-origin" {
				- "origin"
			}
			- ", which is either \""
			code {
				- "none"
			}
			- "\",\n  \""
			code {
				- "multiple"
			}
			- "\", \""
			code {
				- "rewritten"
			}
			- "\", or an\n  "
			a href="#concept-origin" id="media-elements:concept-origin" {
				- "origin"
			}
			- ". It is initially set to \""
			code {
				- "none"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-resource" id="media-elements:media-resource-2" {
				- "media resource"
			}
			- " can have multiple audio and video tracks. For the purposes of a\n  "
			a href="#media-element" id="media-elements:media-element-4" {
				- "media element"
			}
			- ", the video data of the "
			a href="#media-resource" id="media-elements:media-resource-3" {
				- "media resource"
			}
			- " is only that of the\n  currently selected track (if any) as given by the element's "
			code id="media-elements:dom-media-videotracks-2" {
				a href="#dom-media-videotracks" {
					- "videoTracks"
				}
			}
			- " attribute when the "
			a href="#event-loop" id="media-elements:event-loop" {
				- "event loop"
			}
			- " last\n  reached "
			a href="#step1" {
				- "step 1"
			}
			- ", and the audio data of the "
			a href="#media-resource" id="media-elements:media-resource-4" {
				- "media resource"
			}
			- " is the result of mixing all\n  the currently enabled tracks (if any) given by the element's "
			code id="media-elements:dom-media-audiotracks-2" {
				a href="#dom-media-audiotracks" {
					- "audioTracks"
				}
			}
			- " attribute when the "
			a href="#event-loop" id="media-elements:event-loop-2" {
				- "event loop"
			}
			- " last\n  reached "
			a href="#step1" {
				- "step 1"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "Both "
			code id="media-elements:the-audio-element-2" {
				a href="#the-audio-element" {
					- "audio"
				}
			}
			- " and "
			code id="media-elements:the-video-element-2" {
				a href="#the-video-element" {
					- "video"
				}
			}
			- " elements can be used for both audio\n  and video. The main difference between the two is simply that the "
			code id="media-elements:the-audio-element-3" {
				a href="#the-audio-element" {
					- "audio"
				}
			}
			- " element has\n  no playback area for visual content (such as video or captions), whereas the "
			code id="media-elements:the-video-element-3" {
				a href="#the-video-element" {
					- "video"
				}
			}
			- "\n  element does."
		}
		- "\n\n  \n\n  "
		p {
			- "Each "
			a href="#media-element" id="media-elements:media-element-5" {
				- "media element"
			}
			- " has a unique "
			dfn id="media-element-event-task-source" {
				- "media element event task source"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="queue-a-media-element-task" data-export="" {
				- "queue a media element task"
			}
			- " with a "
			a href="#media-element" id="media-elements:media-element-6" {
				- "media element"
			}
			- "\n  "
			var {
				- "element"
			}
			- " and a series of steps "
			var {
				- "steps"
			}
			- ", "
			a href="#queue-an-element-task" id="media-elements:queue-an-element-task" {
				- "queue an element task"
			}
			- " on\n  the "
			a href="#media-element" id="media-elements:media-element-7" {
				- "media element"
			}
			- "'s "
			a href="#media-element-event-task-source" id="media-elements:media-element-event-task-source" {
				- "media element event task source"
			}
			- " given\n  "
			var {
				- "element"
			}
			- " and "
			var {
				- "steps"
			}
			- "."
