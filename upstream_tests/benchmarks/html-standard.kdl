									}
									- "'s "
									a id="relaxing-the-same-origin-restriction:public-suffix-2" href="https://url.spec.whatwg.org/#host-public-suffix" data-x-internal="public-suffix" {
										- "public suffix"
									}
									- ","
								}
							}
						}
						- "\n\n      "
						p {
							- "then return false. "
							a href="#refsURL" {
								- "[URL]"
							}
						}
						- "\n     "
					}
					li {
						p {
							a id="relaxing-the-same-origin-restriction:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "originalHost"
							}
							- "'s "
							a id="relaxing-the-same-origin-restriction:public-suffix-3" href="https://url.spec.whatwg.org/#host-public-suffix" data-x-internal="public-suffix" {
								- "public suffix"
							}
							- ", prefixed by\n     U+002E (.), matches the end of "
							var {
								- "hostSuffix"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return true."
				}
			}
		}
		- "\n\n  "
		div id="example-registrable-domain-suffix" class="example" {
