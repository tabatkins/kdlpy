						a href="#document" {
							- "Document"
						}
					}
					- " as the current one, or not. This will be true, for example, when the entry\n   represents a fragment navigation or single-page app navigation."
				}
			}
			dt {
				code {
					var {
						- "entry"
					}
					- "."
					a href="#dom-navigationhistoryentry-getstate" id="dom-navigationhistoryentry-getstate-dev" {
						- "getState"
