								p {
									a href="https://fetch.spec.whatwg.org/#concept-fetch" id="loading-the-media-resource:concept-fetch" data-x-internal="concept-fetch" {
										- "Fetch"
									}
									- " "
									var {
										- "request"
									}
									- ", with\n        "
									i id="loading-the-media-resource:processresponse" {
										a data-x-internal="processresponse" href="https://fetch.spec.whatwg.org/#process-response" {
											- "processResponse"
										}
									}
									- " set to the following steps given\n        "
									a href="https://fetch.spec.whatwg.org/#concept-response" id="loading-the-media-resource:concept-response-2" data-x-internal="concept-response" {
										- "response"
									}
									- " "
									var {
										- "response"
									}
									- ":"
								}
								- "\n\n        "
								ol {
									li {
										p {
											- "Let "
											var {
												- "global"
											}
											- " be the "
											a href="#media-element" id="loading-the-media-resource:media-element-42" {
												- "media element"
											}
											- "'s\n         "
											a id="loading-the-media-resource:node-document-5" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
												- "node document"
											}
											- "'s "
											a href="#concept-relevant-global" id="loading-the-media-resource:concept-relevant-global" {
												- "relevant global object"
											}
											- "."
										}
									}
									li {
										p {
											- "Let "
											var {
												- "updateMedia"
											}
											- " be to "
											a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-11" {
												- "queue a media element task"
											}
											- " given\n         the "
											a href="#media-element" id="loading-the-media-resource:media-element-43" {
												- "media element"
											}
											- " to run the first appropriate steps from the\n         "
											a href="#media-data-processing-steps-list" id="loading-the-media-resource:media-data-processing-steps-list" {
												- "media data processing steps list"
											}
											- " below. (A new task is used for\n         this so that the work described below occurs relative to the appropriate\n         "
											a href="#media-element-event-task-source" id="loading-the-media-resource:media-element-event-task-source-2" {
												- "media element event task source"
											}
											- " rather than using the\n         "
