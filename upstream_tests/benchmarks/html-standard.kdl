							- "webcal"
						}
					}
					li {
						code {
							- "wtai"
						}
					}
					li {
						code {
							- "xmpp"
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "This list can be changed. If there are schemes that ought to be added, please\n    send feedback."
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "url"
					}
					- " does not contain \""
					code {
						- "%s"
					}
					- "\", then throw a\n   "
					a id="custom-handlers:syntaxerror-3" href="https://webidl.spec.whatwg.org/#syntaxerror" data-x-internal="syntaxerror" {
						- "\""
						code {
							- "SyntaxError"
						}
						- "\""
					}
					- " "
					code id="custom-handlers:domexception-6" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "urlRecord"
					}
					- " be the result of "
					a href="#encoding-parsing-a-url" id="custom-handlers:encoding-parsing-a-url" {
						- "encoding-parsing a URL"
					}
					- " given\n   "
					var {
						- "url"
					}
					- ", relative to "
					var {
						- "environment"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "urlRecord"
					}
					- " is failure, then throw a "
					a id="custom-handlers:syntaxerror-4" href="https://webidl.spec.whatwg.org/#syntaxerror" data-x-internal="syntaxerror" {
						- "\""
						code {
							- "SyntaxError"
						}
						- "\""
					}
					- "\n    "
					code id="custom-handlers:domexception-7" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This is forcibly the case if the "
					code {
						- "%s"
					}
					- " placeholder is in the\n    host or port of the URL."
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "urlRecord"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-scheme" id="custom-handlers:concept-url-scheme-2" data-x-internal="concept-url-scheme" {
						- "scheme"
					}
					- " is not an\n   "
					a id="custom-handlers:http(s)-scheme" href="https://fetch.spec.whatwg.org/#http-scheme" data-x-internal="http(s)-scheme" {
						- "HTTP(S) scheme"
					}
					- " or "
					var {
						- "urlRecord"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-origin" id="custom-handlers:concept-url-origin" data-x-internal="concept-url-origin" {
						- "origin"
					}
					- " is not "
					a href="#same-origin" id="custom-handlers:same-origin" {
						- "same origin"
					}
					- " with\n   "
					var {
						- "environment"
					}
					- "'s "
					a href="#concept-settings-object-origin" id="custom-handlers:concept-settings-object-origin" {
						- "origin"
					}
					- ", then throw\n   a "
					a id="custom-handlers:securityerror-4" href="https://webidl.spec.whatwg.org/#securityerror" data-x-internal="securityerror" {
						- "\""
						code {
							- "SecurityError"
						}
						- "\""
					}
					- " "
					code id="custom-handlers:domexception-8" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a id="custom-handlers:assert-2" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": the result of "
					a id="custom-handlers:is-url-potentially-trustworthy" href="https://w3c.github.io/webappsec-secure-contexts/#potentially-trustworthy-url" data-x-internal="is-url-potentially-trustworthy" {
						- "Is url potentially trustworthy?"
					}
					- " given\n    "
					var {
						- "urlRecord"
					}
					- " is \""
					code {
						- "Potentially Trustworthy"
					}
					- "\"."
				}
				- "\n\n    "
				p class="note" {
					- "Because "
					a href="#normalize-protocol-handler-parameters" id="custom-handlers:normalize-protocol-handler-parameters-3" {
						- "normalize protocol handler parameters"
					}
					- " is run within a\n    "
					a href="#secure-context" id="custom-handlers:secure-context" {
						- "secure context"
					}
					- ", this is implied by the "
					a href="#same-origin" id="custom-handlers:same-origin-2" {
						- "same origin"
					}
					- " condition."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Return ("
					var {
						- "scheme"
					}
					- ", "
					var {
						- "urlRecord"
					}
					- ")."
				}
				- "\n\n    "
				p class="note" {
					- "The "
					a href="https://url.spec.whatwg.org/#concept-url-serializer" id="custom-handlers:concept-url-serializer-2" data-x-internal="concept-url-serializer" {
						- "serialization"
					}
					- " of\n    "
					var {
						- "urlRecord"
					}
					- " will by definition not be a "
					a id="custom-handlers:valid-url-string" href="https://url.spec.whatwg.org/#valid-url-string" data-x-internal="valid-url-string" {
						- "valid URL string"
					}
					- " as it includes\n    the string \""
					code {
						- "%s"
					}
					- "\" which is not a valid component in a URL."
				}
				- "\n   "
			}
		}
		- "\n\n\n\n  "
		h6 id="security-and-privacy" {
			span class="secno" {
				- "8.9.1.4.1"
			}
			- " Security and privacy"
			a href="#security-and-privacy" class="self-link"
		}
		- "\n\n  "
		p {
			- "Custom scheme handlers can introduce a number of concerns, in particular privacy concerns."
		}
		- "\n\n  "
		p {
			strong {
				- "Hijacking all web usage."
			}
			- " User agents should not allow schemes that are key to\n  its normal operation, such as an "
			a id="security-and-privacy:http(s)-scheme" href="https://fetch.spec.whatwg.org/#http-scheme" data-x-internal="http(s)-scheme" {
				- "HTTP(S) scheme"
			}
			- ", to be rerouted through third-party\n  sites. This would allow a user's activities to be trivially tracked, and would allow user\n  information, even in secure connections, to be collected."
		}
		- "\n\n  "
		p {
			strong {
				- "Hijacking defaults."
			}
			- " User agents are strongly urged to not automatically change\n  any defaults, as this could lead the user to send data to remote hosts that the user is not\n  expecting. New handlers registering themselves should never automatically cause those sites to be\n  used."
		}
		- "\n\n  "
		p {
			strong {
				- "Registration spamming."
			}
			- " User agents should consider the possibility that a site\n  will attempt to register a large number of handlers, possibly from multiple domains (e.g., by\n  redirecting through a series of pages each on a different domain, and each registering a handler\n  for "
			code {
				- "web+spam:"
			}
			- " — analogous practices abusing other web browser\n  features have been used by pornography web sites for many years). User agents should gracefully\n  handle such hostile attempts, protecting the user."
		}
		- "\n\n  "
		p {
			strong {
				- "Hostile handler metadata."
			}
			- " User agents should protect against typical attacks\n  against strings embedded in their interface, for example ensuring that markup or escape characters\n  in such strings are not executed, that null bytes are properly handled, that over-long strings do\n  not cause crashes or buffer overruns, and so forth."
		}
		- "\n\n  "
		p {
			strong {
				- "Leaking private data."
			}
			- " Web page authors may reference a custom scheme\n  handler using URL data considered private. They might do so with the expectation that the user's\n  choice of handler points to a page inside the organization, ensuring that sensitive data will not\n  be exposed to third parties. However, a user may have registered a handler pointing to an\n  external site, resulting in a data leak to that third party. Implementers might wish to consider\n  allowing administrators to disable custom handlers on certain subdomains, content types, or\n  schemes."
		}
		- "\n\n  "
		p {
			strong {
				- "Interface interference."
			}
			- " User agents should be prepared to handle intentionally\n  long arguments to the methods. For example, if the user interface exposed consists of an \"accept\"\n  button and a \"deny\" button, with the \"accept\" binding containing the name of the handler, it's\n  important that a long name not cause the \"deny\" button to be pushed off the screen."
		}
		- "\n\n  "
		h6 id="user-agent-automation" {
			span class="secno" {
				- "8.9.1.4.2"
			}
			- " "
			dfn id="rph-user-agent-automation" {
				- "User agent automation"
			}
			a href="#user-agent-automation" class="self-link"
		}
		- "\n\n  "
		p {
			- "Each "
			code id="user-agent-automation:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " has a "
			dfn id="registerprotocolhandler()-automation-mode" {
				code {
					- "registerProtocolHandler()"
				}
				- " automation\n  mode"
			}
			- ". It defaults to \""
			code id="user-agent-automation:rph-automation-mode-none" {
				a href="#rph-automation-mode-none" {
					- "none"
				}
			}
			- "\", but it also can\n  be either \""
			code id="user-agent-automation:rph-automation-mode-auto-accept" {
				a href="#rph-automation-mode-auto-accept" {
					- "autoAccept"
				}
			}
			- "\" or \""
			code id="user-agent-automation:rph-automation-mode-auto-reject" {
				a href="#rph-automation-mode-auto-reject" {
					- "autoReject"
				}
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "For the purposes of user agent automation and website testing, this standard defines "
			dfn id="set-rph-registration-mode" {
				- "Set RPH Registration Mode"
			}
			- " WebDriver "
			a id="user-agent-automation:extension-command" href="https://w3c.github.io/webdriver/#dfn-extension-commands" data-x-internal="extension-command" {
				- "extension\n  command"
			}
			- ". It instructs the user agent to place a "
			code id="user-agent-automation:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " into a mode where it\n  will automatically simulate a user either accepting or rejecting and registration confirmation\n  prompt dialog."
		}
		- "\n\n  "
		table class="data" {
			thead {
				tr {
					th {
						- "HTTP Method\n     "
					}
					th {
						- "URI Template\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "`"
						code {
							- "POST"
						}
						- "`\n     "
					}
					td {
						code {
							- "/session/{session id}/custom-handlers/set-mode"
						}
						- "\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			a id="user-agent-automation:remote-end-steps" href="https://w3c.github.io/webdriver/#dfn-remote-end-steps" data-x-internal="remote-end-steps" {
				- "remote end steps"
			}
			- " are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "parameters"
					}
					- " is not a JSON Object, return a "
					a id="user-agent-automation:webdriver-error" href="https://w3c.github.io/webdriver/#dfn-errors" data-x-internal="webdriver-error" {
						- "WebDriver error"
					}
					- " with\n   "
					a id="user-agent-automation:webdriver-error-code" href="https://w3c.github.io/webdriver/#dfn-error-code" data-x-internal="webdriver-error-code" {
						- "WebDriver error code"
					}
					- " "
					a id="user-agent-automation:invalid-argument" href="https://w3c.github.io/webdriver/#dfn-invalid-argument" data-x-internal="invalid-argument" {
						- "invalid argument"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "mode"
					}
					- " be the result of "
					a id="user-agent-automation:getting-a-property" href="https://w3c.github.io/webdriver/#dfn-getting-properties" data-x-internal="getting-a-property" {
						- "getting a property"
					}
					- " named \""
					code {
						- "mode"
					}
					- "\" from "
					var {
						- "parameters"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "mode"
					}
					- " is not \""
					code id="user-agent-automation:rph-automation-mode-auto-accept-2" {
						a href="#rph-automation-mode-auto-accept" {
							- "autoAccept"
						}
					}
					- "\", \""
					code id="user-agent-automation:rph-automation-mode-auto-reject-2" {
						a href="#rph-automation-mode-auto-reject" {
							- "autoReject"
						}
					}
					- "\", or \""
					code id="user-agent-automation:rph-automation-mode-none-2" {
						a href="#rph-automation-mode-none" {
							- "none"
						}
					}
					- "\", return a "
					a id="user-agent-automation:webdriver-error-2" href="https://w3c.github.io/webdriver/#dfn-errors" data-x-internal="webdriver-error" {
						- "WebDriver error"
					}
					- " with\n   "
					a id="user-agent-automation:webdriver-error-code-2" href="https://w3c.github.io/webdriver/#dfn-error-code" data-x-internal="webdriver-error-code" {
						- "WebDriver error code"
					}
					- " "
					a id="user-agent-automation:invalid-argument-2" href="https://w3c.github.io/webdriver/#dfn-invalid-argument" data-x-internal="invalid-argument" {
						- "invalid argument"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "document"
					}
					- " be the "
					a href="https://w3c.github.io/webdriver/#dfn-current-browsing-context" id="user-agent-automation:webdriver-current-browsing-context" data-x-internal="webdriver-current-browsing-context" {
						- "current\n   browsing context"
					}
					- "'s "
					a href="#active-document" id="user-agent-automation:active-document" {
						- "active document"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "document"
					}
					- "'s "
					a href="#registerprotocolhandler()-automation-mode" id="user-agent-automation:registerprotocolhandler()-automation-mode" {
						code {
							- "registerProtocolHandler()"
						}
						- " automation\n   mode"
					}
					- " to "
					var {
						- "mode"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					a href="https://w3c.github.io/webdriver/#dfn-success" id="user-agent-automation:success-value" data-x-internal="success-value" {
						- "success"
					}
					- " with data null."
				}
			}
		}
		- "\n\n  \n\n  "
		h5 id="cookies" {
			span class="secno" {
				- "8.9.1.5"
			}
			- " Cookies"
			a href="#cookies" class="self-link"
		}
		- "\n\n  "
		pre {
			code class="idl" {
				c- b="" {
					- "interface"
				}
				- " "
				c- b="" {
					- "mixin"
				}
				- " "
				dfn id="navigatorcookies" data-dfn-type="interface" {
					c- g="" {
						- "NavigatorCookies"
					}
				}
				- " {\n  "
				c- b="" {
					- "readonly"
				}
				- " "
				c- b="" {
					- "attribute"
				}
				- " "
				c- b="" {
					- "boolean"
				}
				- " "
				a href="#dom-navigator-cookieenabled" id="cookies:dom-navigator-cookieenabled" {
					c- g="" {
						- "cookieEnabled"
					}
				}
				- ";\n};"
			}
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "window"
					}
					- "."
					a href="#dom-navigator" id="cookies:dom-navigator" {
						- "navigator"
					}
					- "."
					a href="#dom-navigator-cookieenabled" id="dom-navigator-cookieenabled-dev" {
						- "cookieEnabled"
					}
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						b title="Support in all current engines." class="all-engines-flag" {
							- "✔"
						}
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/Navigator/cookieEnabled" title="navigator.cookieEnabled returns a Boolean value that indicates whether cookies are enabled or not." {
								- "Navigator/cookieEnabled"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "1+"
								}
							}
							span class="safari yes" {
								span {
									- "Safari"
								}
								span {
									- "1+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "1+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "12.1+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "4+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios unknown" {
								span {
									- "Safari iOS"
								}
								span {
									- "?"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android unknown" {
								span {
									- "WebView Android"
								}
								span {
									- "?"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "12.1+"
								}
							}
						}
					}
				}
			}
			dd {
				p {
					- "Returns false if setting a cookie will be ignored, and true otherwise."
				}
			}
		}
		- "\n\n  \n\n   "
		p {
			- "The "
			dfn data-dfn-for="NavigatorCookies" id="dom-navigator-cookieenabled" data-dfn-type="attribute" {
				code {
					- "cookieEnabled"
				}
			}
			- " attribute must return true if the\n   user agent attempts to handle cookies according to "
			cite {
				- "HTTP State Management Mechanism"
			}
			- ",\n   and false if it ignores cookie change requests. "
			a href="#refsCOOKIES" {
				- "[COOKIES]"
			}
		}
		- "\n\n  \n\n  "
		h5 id="pdf-viewing-support" {
			span class="secno" {
				- "8.9.1.6"
			}
			- " PDF viewing support"
			a href="#pdf-viewing-support" class="self-link"
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "window"
					}
					- "."
					a href="#dom-navigator" id="pdf-viewing-support:dom-navigator" {
						- "navigator"
					}
					- "."
					a href="#dom-navigator-pdfviewerenabled" id="dom-navigator-pdfviewerenabled-dev" {
						- "pdfViewerEnabled"
					}
				}
			}
			dd {
				p {
					- "Returns true if the user agent supports inline viewing of PDF files when "
					a href="#navigate" id="pdf-viewing-support:navigate" {
						- "navigating"
					}
					- " to them, or false otherwise. In the latter case, PDF files\n   will be handled by "
					a href="#hand-off-to-external-software" id="pdf-viewing-support:hand-off-to-external-software" {
						- "external\n   software"
