									code id="drag-and-drop-processing-model:event-dnd-dragleave-2" {
										a href="#event-dnd-dragleave" {
											- "dragleave"
										}
									}
									- " at it; otherwise, if\n       it is not null, use platform-specific conventions for drag cancelation."
								}
							}
							li {
								p {
									- "Set the "
									a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation-8" {
										- "current drag operation"
									}
									- " to \""
									code id="drag-and-drop-processing-model:concept-current-drag-operation-none-7" {
										a href="#concept-current-drag-operation-none" {
											- "none"
										}
									}
									- "\"."
								}
							}
						}
						- "\n\n      "
						p {
							- "Otherwise, the drag operation might be a success; run these substeps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "dropped"
									}
									- " be true."
								}
							}
							li {
								p {
									- "If the "
									a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-20" {
										- "current target element"
									}
									- " is a DOM element, "
									a href="#fire-a-dnd-event" id="drag-and-drop-processing-model:fire-a-dnd-event-8" {
										- "fire a DND\n       event"
									}
									- " named "
									code id="drag-and-drop-processing-model:event-dnd-drop" {
										a href="#event-dnd-drop" {
											- "drop"
										}
									}
									- " at it; otherwise, use\n       platform-specific conventions for indicating a drop."
								}
							}
							li {
								- "\n        "
								p {
									- "If the event is canceled, set the "
									a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation-9" {
										- "current drag operation"
									}
									- " to the value of the\n        "
									code id="drag-and-drop-processing-model:dom-datatransfer-dropeffect-3" {
										a href="#dom-datatransfer-dropeffect" {
											- "dropEffect"
										}
									}
									- " attribute of the\n        "
									code id="drag-and-drop-processing-model:dragevent-2" {
										a href="#dragevent" {
											- "DragEvent"
										}
									}
									- " object's "
									code id="drag-and-drop-processing-model:dom-dragevent-datatransfer-2" {
										a href="#dom-dragevent-datatransfer" {
											- "dataTransfer"
										}
									}
									- "\n        object as it stood after the event "
									a href="https://dom.spec.whatwg.org/#concept-event-dispatch" id="drag-and-drop-processing-model:concept-event-dispatch-2" data-x-internal="concept-event-dispatch" {
										- "dispatch"
									}
									- "\n        finished."
								}
								- "\n\n        "
								p {
									- "Otherwise, the event is not canceled; perform the event's default action, which depends\n        on the exact target as follows:"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										- "If the "
										a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-21" {
											- "current target element"
										}
										- " is a text control (e.g.,\n         "
										code id="drag-and-drop-processing-model:the-textarea-element-3" {
											a href="#the-textarea-element" {
												- "textarea"
											}
										}
										- ", or an "
										code id="drag-and-drop-processing-model:the-input-element-3" {
											a href="#the-input-element" {
												- "input"
											}
										}
										- " element whose "
										code id="drag-and-drop-processing-model:attr-input-type-3" {
											a href="#attr-input-type" {
												- "type"
											}
										}
										- " attribute is in the "
										a href="#text-(type=text)-state-and-search-state-(type=search)" id="drag-and-drop-processing-model:text-(type=text)-state-and-search-state-(type=search)-3" {
											- "Text"
										}
										- " state) or an "
										a href="#editing-host" id="drag-and-drop-processing-model:editing-host-3" {
											- "editing host"
										}
										- " or\n         "
										a id="drag-and-drop-processing-model:editable-3" href="https://w3c.github.io/editing/docs/execCommand/#editable" data-x-internal="editable" {
											- "editable"
										}
										- " element, and the "
										a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-8" {
											- "drag data store item list"
										}
										- " has an item\n         with "
