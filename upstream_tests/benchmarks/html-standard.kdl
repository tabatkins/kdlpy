								- "If the property's "
								a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-15" {
									- "value"
								}
								- " is not an "
								a href="#concept-item" id="conversion-to-vcard:concept-item-12" {
									- "item"
								}
								- " and its "
								var {
									- "name"
								}
								- " is "
								code id="conversion-to-vcard:md-vcard-sex" {
									a href="#md-vcard-sex" {
										- "sex"
									}
								}
							}
							dd {
								- "\n        "
								p {
									- "If this is the first such property to be found, set "
									var {
										- "sex"
									}
									- " to the\n        property's "
									a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-16" {
										- "value"
									}
									- "."
								}
								- "\n       "
							}
							dt {
								- "If the property's "
								a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-17" {
									- "value"
								}
								- " is not an "
								a href="#concept-item" id="conversion-to-vcard:concept-item-13" {
									- "item"
								}
								- " and its "
								var {
									- "name"
								}
								- " is "
								code id="conversion-to-vcard:md-vcard-gender-identity" {
									a href="#md-vcard-gender-identity" {
										- "gender-identity"
									}
								}
							}
							dd {
								- "\n        "
								p {
									- "If this is the first such property to be found, set "
									var {
										- "gender-identity"
									}
									- "\n        to the property's "
									a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-18" {
										- "value"
									}
									- "."
								}
								- "\n       "
							}
							dt {
								- "Otherwise (the property's "
								a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-19" {
									- "value"
								}
								- " is not an\n       "
								a href="#concept-item" id="conversion-to-vcard:concept-item-14" {
									- "item"
								}
								- ")"
							}
							dd {
								- "\n        "
								ol {
									li {
										p {
											- "Let "
											var {
												- "value"
											}
											- " be the property's "
											a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-20" {
												- "value"
											}
											- "."
										}
									}
									li {
										p {
											- "If "
											var {
												- "element"
											}
											- " is one of the "
											a href="#url-property-elements" id="conversion-to-vcard:url-property-elements-2" {
												- "URL property elements"
											}
											- ", add\n         a parameter with the name \""
											code {
												- "VALUE"
											}
											- "\" and the value \""
											code {
												- "URI"
											}
											- "\" to "
											var {
												- "parameters"
											}
											- "."
										}
									}
									li {
										p {
											- "Otherwise, if "
											var {
												- "name"
											}
											- " is "
											code id="conversion-to-vcard:md-vcard-bday" {
												a href="#md-vcard-bday" {
													- "bday"
												}
											}
											- " or\n         "
											code id="conversion-to-vcard:md-vcard-anniversary" {
												a href="#md-vcard-anniversary" {
													- "anniversary"
												}
											}
											- " and the "
											var {
												- "value"
											}
											- " is\n         a "
											a href="#valid-date-string" id="conversion-to-vcard:valid-date-string" {
												- "valid date string"
											}
											- ", add a parameter with the name \""
											code {
												- "VALUE"
											}
											- "\" and the value \""
											code {
												- "DATE"
											}
											- "\" to "
											var {
												- "parameters"
											}
											- "."
										}
									}
									li {
										p {
											- "Otherwise, if "
											var {
												- "name"
											}
											- " is "
											code id="conversion-to-vcard:md-vcard-rev" {
												a href="#md-vcard-rev" {
													- "rev"
												}
											}
											- " and\n         the "
											var {
												- "value"
											}
											- " is a "
											a href="#valid-global-date-and-time-string" id="conversion-to-vcard:valid-global-date-and-time-string" {
												- "valid global date and time string"
											}
											- ", add a\n         parameter with the name \""
											code {
												- "VALUE"
											}
											- "\" and the value \""
											code {
												- "DATE-TIME"
											}
											- "\" to "
											var {
												- "parameters"
											}
											- "."
										}
									}
									li {
										p {
											- "Prefix every U+005C REVERSE SOLIDUS character (\\) in "
											var {
												- "value"
											}
											- " with\n         another U+005C REVERSE SOLIDUS character (\\)."
										}
									}
									li {
										p {
											- "Prefix every U+002C COMMA character (,) in "
											var {
												- "value"
											}
											- " with a U+005C\n         REVERSE SOLIDUS character (\\)."
										}
									}
									li {
										p {
											- "Unless "
											var {
												- "name"
											}
											- " is "
											code id="conversion-to-vcard:md-vcard-geo" {
												a href="#md-vcard-geo" {
													- "geo"
												}
											}
											- ", prefix\n         every U+003B SEMICOLON character (;) in "
											var {
												- "value"
											}
											- " with a U+005C REVERSE\n         SOLIDUS character (\\)."
										}
									}
									li {
										p {
											- "Replace every U+000D CARRIAGE RETURN U+000A LINE FEED character pair (CRLF) in "
											var {
												- "value"
											}
											- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN\n         SMALL LETTER N character (n)."
										}
									}
									li {
										p {
											- "Replace every remaining U+000D CARRIAGE RETURN (CR) or U+000A LINE FEED (LF)\n         character in "
											var {
												- "value"
											}
											- " with a U+005C REVERSE SOLIDUS character (\\) followed\n         by a U+006E LATIN SMALL LETTER N character (n)."
										}
									}
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-6" {
								- "Add a vCard line"
							}
							- " with the type "
							var {
								- "name"
							}
							- ", the parameters "
							var {
								- "parameters"
							}
							- ", and the value "
							var {
								- "value"
							}
							- " to "
							var {
								- "output"
							}
							- "."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If either "
					var {
						- "sex"
					}
					- " or "
					var {
						- "gender-identity"
					}
					- " has a value that\n   is not the empty string, "
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-7" {
						- "add a vCard line"
					}
					- " with the type \""
					code {
						- "GENDER"
					}
					- "\" and the value consisting of the concatenation of "
					var {
						- "sex"
					}
					- ",\n   a U+003B SEMICOLON character (;), and "
					var {
						- "gender-identity"
					}
					- " to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-8" {
						- "Add a vCard line"
					}
					- " with the type \""
					code {
						- "END"
					}
					- "\" and the value\n   \""
					code {
						- "VCARD"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the above algorithm says that the user agent is to "
			dfn id="add-a-vcard-line" {
				- "add a vCard line"
			}
			- " consisting\n  of a type "
			var {
				- "type"
			}
			- ", optionally some parameters, and a value "
			var {
				- "value"
			}
			- " to a string "
			var {
				- "output"
			}
			- ", it must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "line"
					}
					- " be an empty string.\n\n   "
				}
			}
			li {
				p {
					- "Append "
					var {
						- "type"
					}
					- ", "
					a id="conversion-to-vcard:converted-to-ascii-uppercase" href="https://infra.spec.whatwg.org/#ascii-uppercase" data-x-internal="converted-to-ascii-uppercase" {
						- "converted to ASCII uppercase"
					}
					- ", to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If there are any parameters, then for each parameter, in the order that they were added, run\n    these substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Append a U+003B SEMICOLON character (;) to "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append the parameter's name to "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+003D EQUALS SIGN character (=) to "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append the parameter's value to "
							var {
								- "line"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Append a U+003A COLON character (:) to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				p {
					- "Append "
					var {
						- "value"
					}
					- " to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "maximum length"
					}
					- " be 75."
				}
			}
			li {
				- "\n    "
				p {
					- "While "
					var {
						- "line"
					}
					- "'s "
					a id="conversion-to-vcard:code-point-length" href="https://infra.spec.whatwg.org/#string-code-point-length" data-x-internal="code-point-length" {
						- "code point length"
					}
					- " is greater than "
					var {
						- "maximum\n    length"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Append the first "
							var {
								- "maximum length"
							}
							- " code points of "
							var {
								- "line"
							}
							- " to\n     "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Remove the first "
							var {
								- "maximum length"
							}
							- " code points from "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+000D CARRIAGE RETURN character (CR) to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+000A LINE FEED character (LF) to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+0020 SPACE character to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "maximum length"
							}
							- " be 74."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Append (what remains of) "
					var {
						- "line"
					}
					- " to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "Append a U+000D CARRIAGE RETURN character (CR) to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "Append a U+000A LINE FEED character (LF) to "
					var {
						- "output"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the steps above require the user agent to obtain the result of "
			dfn id="collecting-vcard-subproperties" {
				- "collecting vCard\n  subproperties"
			}
			- " named "
			var {
				- "subname"
			}
			- " in "
			var {
				- "subitem"
			}
			- ", the user\n  agent must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "value"
					}
					- " be the empty string."
				}
			}
			li {
				- "\n    "
				p {
					- "For each property named "
					var {
						- "subname"
					}
					- " in the item "
					var {
						- "subitem"
					}
					- ",\n    run the following substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-21" {
								- "value"
							}
							- " of the property is itself an\n     "
							a href="#concept-item" id="conversion-to-vcard:concept-item-15" {
								- "item"
							}
							- ", then skip this property."
						}
					}
					li {
						p {
							- "If this is not the first property named "
							var {
								- "subname"
							}
							- " in "
							var {
								- "subitem"
							}
							- " (ignoring any that were skipped by the previous step), then append a\n     U+002C COMMA character (,) to "
							var {
								- "value"
							}
							- "."
						}
					}
					li {
						p {
							- "Append the result of "
							a href="#escaping-the-vcard-text-string" id="conversion-to-vcard:escaping-the-vcard-text-string-5" {
								- "escaping the vCard text string"
							}
							- " given by the "
							a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-22" {
								- "value"
							}
							- " of the property to "
							var {
								- "value"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "value"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the steps above require the user agent to obtain the result of "
			dfn id="collecting-the-first-vcard-subproperty" {
				- "collecting the first\n  vCard subproperty"
			}
			- " named "
			var {
				- "subname"
			}
			- " in "
			var {
				- "subitem"
			}
			- ", the user\n  agent must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If there are no properties named "
					var {
						- "subname"
					}
					- " in "
					var {
						- "subitem"
					}
					- ", then return the\n   empty string."
				}
			}
			li {
				p {
					- "If the "
					a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-23" {
						- "value"
					}
					- " of the first property named\n   "
					var {
						- "subname"
					}
					- " in "
					var {
						- "subitem"
					}
					- " is an "
					a href="#concept-item" id="conversion-to-vcard:concept-item-16" {
						- "item"
					}
					- ", then\n   return the empty string."
				}
			}
			li {
				p {
					- "Return the result of "
					a href="#escaping-the-vcard-text-string" id="conversion-to-vcard:escaping-the-vcard-text-string-6" {
						- "escaping the vCard text string"
					}
					- " given by the "
					a href="#concept-property-value" id="conversion-to-vcard:concept-property-value-24" {
						- "value"
					}
					- " of the first property named "
					var {
						- "subname"
					}
					- " in\n   "
					var {
						- "subitem"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the above algorithms say the user agent is to "
			dfn id="escaping-the-vcard-text-string" {
				- "escape the vCard text string"
			}
			- " "
			var {
				- "value"
			}
			- ", the user agent must use the\n  following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Prefix every U+005C REVERSE SOLIDUS character (\\) in "
					var {
						- "value"
					}
					- " with\n   another U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+002C COMMA character (,) in "
					var {
						- "value"
					}
					- " with a U+005C REVERSE\n   SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+003B SEMICOLON character (;) in "
					var {
						- "value"
					}
					- " with a U+005C\n   REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Replace every U+000D CARRIAGE RETURN U+000A LINE FEED character pair (CRLF) in "
					var {
						- "value"
					}
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN SMALL\n   LETTER N character (n)."
				}
			}
			li {
				p {
					- "Replace every remaining U+000D CARRIAGE RETURN (CR) or U+000A LINE FEED (LF) character in\n   "
					var {
						- "value"
					}
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN\n   SMALL LETTER N character (n)."
				}
			}
			li {
				p {
					- "Return the mutated "
					var {
						- "value"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "This algorithm can generate invalid vCard output, if the input does not conform to\n  the rules described for the "
			code id="conversion-to-vcard:md-vcard-4" {
				a href="#md-vcard" {
					- "http://microformats.org/profile/hcard"
				}
			}
			- "\n  "
			a href="#item-types" id="conversion-to-vcard:item-types-4" {
				- "item type"
			}
			- " and "
			a href="#defined-property-name" id="conversion-to-vcard:defined-property-name" {
				- "defined property\n  names"
			}
			- "."
		}
		- " \n\n\n\n  "
		h5 id="examples-2" {
			span class="secno" {
				- "5.3.1.2"
			}
			- " Examples"
			a href="#examples-2" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Here is a long example vCard for a fictional character called \"Jack Bauer\":"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "section"
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
