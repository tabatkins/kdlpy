				- "\n\n    "
				p {
					- "If the "
					a href="#adjusted-current-node" id="parsing-main-inforeign:adjusted-current-node-3" {
						- "adjusted current node"
					}
					- " is an element in the "
					a id="parsing-main-inforeign:svg-namespace-2" href="https://infra.spec.whatwg.org/#svg-namespace" data-x-internal="svg-namespace" {
						- "SVG namespace"
					}
					- ",\n    "
					a href="#adjust-svg-attributes" id="parsing-main-inforeign:adjust-svg-attributes" {
						- "adjust SVG attributes"
					}
					- " for the token. (This fixes the case of SVG attributes that\n    are not all lowercase.)"
				}
				- "\n\n    "
				p {
					a href="#adjust-foreign-attributes" id="parsing-main-inforeign:adjust-foreign-attributes" {
						- "Adjust foreign attributes"
					}
					- " for the token. (This fixes the use of namespaced\n    attributes, in particular XLink in SVG.)"
				}
				- "\n\n    "
				p {
					a href="#insert-a-foreign-element" id="parsing-main-inforeign:insert-a-foreign-element" {
						- "Insert a foreign element"
					}
					- " for the token, with "
					a href="#adjusted-current-node" id="parsing-main-inforeign:adjusted-current-node-4" {
						- "adjusted current\n    node"
					}
					- "'s namespace and false."
				}
				- "\n\n    "
				p {
					- "If the token has its "
					i id="parsing-main-inforeign:self-closing-flag" {
						a href="#self-closing-flag" {
							- "self-closing flag"
						}
					}
					- " set, then run the appropriate steps from the\n    following list:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If the token's tag name is \"script\", and the new "
						a href="#current-node" id="parsing-main-inforeign:current-node-2" {
							- "current node"
						}
						- " is in the "
						a id="parsing-main-inforeign:svg-namespace-3" href="https://infra.spec.whatwg.org/#svg-namespace" data-x-internal="svg-namespace" {
							- "SVG namespace"
						}
					}
					dd {
						- "\n      "
						p {
							a href="#acknowledge-self-closing-flag" id="parsing-main-inforeign:acknowledge-self-closing-flag" {
								- "Acknowledge the token's "
								i {
									- "self-closing\n      flag"
								}
							}
							- ", and then act as described in the steps for a \"script\" end tag below."
						}
						- "\n     "
					}
					dt {
						- "Otherwise"
					}
					dd {
						- "\n      "
						p {
							- "Pop the "
							a href="#current-node" id="parsing-main-inforeign:current-node-3" {
								- "current node"
							}
							- " off the "
							a href="#stack-of-open-elements" id="parsing-main-inforeign:stack-of-open-elements-2" {
								- "stack of open elements"
							}
							- " and "
							a href="#acknowledge-self-closing-flag" id="parsing-main-inforeign:acknowledge-self-closing-flag-2" {
								- "acknowledge the token's "
								i {
									- "self-closing\n      flag"
								}
							}
							- "."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			dt id="scriptForeignEndTag" {
				- "An end tag whose tag name is \"script\", if the "
				a href="#current-node" id="parsing-main-inforeign:current-node-4" {
					- "current\n   node"
				}
				- " is an "
				a id="parsing-main-inforeign:svg-script" href="https://svgwg.org/svg2-draft/interact.html#ScriptElement" data-x-internal="svg-script" {
					- "SVG "
					code {
						- "script"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-inforeign:current-node-5" {
						- "current node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-inforeign:stack-of-open-elements-3" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Let the "
					var {
						- "old insertion point"
					}
					- " have the same value as the current\n    "
					a href="#insertion-point" id="parsing-main-inforeign:insertion-point" {
						- "insertion point"
					}
					- ". Let the "
					a href="#insertion-point" id="parsing-main-inforeign:insertion-point-2" {
						- "insertion point"
					}
					- " be just before the "
					a href="#next-input-character" id="parsing-main-inforeign:next-input-character" {
						- "next\n    input character"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Increment the parser's "
					a href="#script-nesting-level" id="parsing-main-inforeign:script-nesting-level" {
						- "script nesting level"
					}
					- " by one. Set the "
					a href="#parser-pause-flag" id="parsing-main-inforeign:parser-pause-flag" {
						- "parser pause\n    flag"
					}
					- " to true."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#active-speculative-html-parser" id="parsing-main-inforeign:active-speculative-html-parser" {
						- "active speculative HTML parser"
					}
					- " is null and the user agent supports SVG,\n    then "
					a href="https://www.w3.org/TR/SVGMobile12/script.html#ScriptContentProcessing" {
						- "Process the\n    SVG "
						code {
