							}
							c- f="" {
								- "label"
							}
							c- p="" {
								- ">"
							}
							- "PIN: "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "input"
							}
							- " "
							c- e="" {
								- "type"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"password\""
							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"pin\""
							}
							- " "
							c- e="" {
								- "autocomplete"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"off\""
							}
							c- p="" {
								- "></"
							}
							c- f="" {
								- "label"
							}
							c- p="" {
								- "></"
							}
							c- f="" {
								- "p"
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n    "
				}
				- "\n\n    "
				p {
					- "When an element's "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-11" {
						- "autofill field name"
					}
					- " is "
					em {
						- "not"
					}
					- " \""
					code id="autofill-processing-model:attr-fe-autocomplete-off-5" {
						a href="#attr-fe-autocomplete-off" {
							- "off"
						}
					}
					- "\", the user agent may store the "
					a href="#control's-data" id="autofill-processing-model:control's-data-2" {
						- "control's\n    data"
					}
					- ", and may offer previously stored values to the user."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "For example, suppose a user visits a page with this control:"
					}
					- "\n\n     "
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "select"
							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"country\""
							}
							c- p="" {
								- ">"
							}
							- "\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Afghanistan\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Albania\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Algeria\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Andorra\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Angola\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Antigua and Barbuda\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Argentina\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Armenia\n "
							c- c="" {
								- "<!-- "
							}
							em {
								c- c="" {
									- "..."
								}
							}
							c- c="" {
								- " -->"
							}
							- "\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Yemen\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Zambia\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "option"
							}
							c- p="" {
								- ">"
							}
							- "Zimbabwe\n"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "select"
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n     "
					p {
						- "This might render as follows:"
					}
					- "\n\n     "
					p {
						img src="/images/select-country-1.png" alt="A drop-down control with a long alphabetical list of countries."
					}
					- "\n\n     "
					p {
						- "Suppose that on the first visit to this page, the user selects \"Zambia\". On the second visit,\n     the user agent could duplicate the entry for Zambia at the top of the list, so that the interface\n     instead looks like this:"
					}
					- "\n\n     "
					p {
						img src="/images/select-country-2.png" alt="The same drop-down control with the alphabetical list of countries, but with Zambia as an entry at the top."
					}
					- "\n\n    "
				}
				- "\n\n    "
				p {
					- "When the "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-12" {
						- "autofill field name"
					}
					- " is \""
					code id="autofill-processing-model:attr-fe-autocomplete-on-3" {
						a href="#attr-fe-autocomplete-on" {
							- "on"
						}
					}
					- "\", the user agent should attempt to use heuristics to\n    determine the most appropriate values to offer the user, e.g. based on the element's "
					code id="autofill-processing-model:attr-fe-name" {
						a href="#attr-fe-name" {
							- "name"
						}
					}
					- " value, the position of the element in its "
					a id="autofill-processing-model:tree" href="https://dom.spec.whatwg.org/#concept-tree" data-x-internal="tree" {
						- "tree"
					}
					- ",\n    what other fields exist in the form, and so forth."
				}
				- "\n\n    "
				p {
					- "When the "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-13" {
						- "autofill field name"
					}
					- " is one of the names of the "
					a href="#autofill-field" id="autofill-processing-model:autofill-field-2" {
						- "autofill fields"
					}
					- " described above, the user agent should provide suggestions that\n    match the meaning of the field name as given in the table earlier in this section. The\n    "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-8" {
						- "autofill hint set"
					}
					- " should be used to select amongst multiple possible suggestions."
				}
				- "\n\n    "
				p class="example" {
					- "For example, if a user once entered one address into fields that used the\n    \""
					code id="autofill-processing-model:attr-fe-autocomplete-shipping-3" {
						a href="#attr-fe-autocomplete-shipping" {
							- "shipping"
						}
					}
					- "\" keyword, and another address into\n    fields that used the \""
					code id="autofill-processing-model:attr-fe-autocomplete-billing-3" {
						a href="#attr-fe-autocomplete-billing" {
							- "billing"
						}
					}
					- "\" keyword, then in\n    subsequent forms only the first address would be suggested for form controls whose "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-9" {
						- "autofill\n    hint set"
					}
					- " contains the keyword \""
					code id="autofill-processing-model:attr-fe-autocomplete-shipping-4" {
						a href="#attr-fe-autocomplete-shipping" {
							- "shipping"
						}
					}
					- "\". Both addresses might be suggested,\n    however, for address-related form controls whose "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-10" {
						- "autofill hint set"
					}
					- " does not contain\n    either keyword."
				}
				- "\n   "
			}
			dt {
				- "When wearing the "
				a href="#autofill-anchor-mantle" id="autofill-processing-model:autofill-anchor-mantle-3" {
					- "autofill anchor mantle"
				}
				- "...\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "When the "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-14" {
						- "autofill field name"
					}
					- " is not the empty string, then the user agent must\n    act as if the user had specified the "
					a href="#control's-data" id="autofill-processing-model:control's-data-3" {
						- "control's data"
					}
					- " for the given "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-11" {
						- "autofill\n    hint set"
					}
					- ", "
					a href="#autofill-scope" id="autofill-processing-model:autofill-scope-5" {
						- "autofill scope"
					}
					- ", and "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-15" {
						- "autofill field name"
					}
					- "\n    combination."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "When the user agent "
			dfn id="concept-fe-autofill" {
				- "autofills form controls"
			}
			- ", elements\n  with the same "
			a href="#form-owner" id="autofill-processing-model:form-owner-2" {
				- "form owner"
			}
			- " and the same "
			a href="#autofill-scope" id="autofill-processing-model:autofill-scope-6" {
				- "autofill scope"
			}
			- " must use data\n  relating to the same person, address, payment instrument, and contact details. "
			span id="autofill-country" {
				- "When a user agent autofills \""
				code id="autofill-processing-model:attr-fe-autocomplete-country-2" {
					a href="#attr-fe-autocomplete-country" {
						- "country"
					}
				}
				- "\" and \""
				code id="autofill-processing-model:attr-fe-autocomplete-country-name-2" {
					a href="#attr-fe-autocomplete-country-name" {
						- "country-name"
					}
				}
				- "\" fields with the same "
				a href="#form-owner" id="autofill-processing-model:form-owner-3" {
					- "form\n  owner"
				}
				- " and "
				a href="#autofill-scope" id="autofill-processing-model:autofill-scope-7" {
					- "autofill scope"
				}
				- ", and the user agent has a value for the "
				code id="autofill-processing-model:attr-fe-autocomplete-country-3" {
					a href="#attr-fe-autocomplete-country" {
						- "country"
					}
				}
				- "\" field(s), then the \""
				code id="autofill-processing-model:attr-fe-autocomplete-country-name-3" {
					a href="#attr-fe-autocomplete-country-name" {
						- "country-name"
					}
				}
				- "\" field(s) must be filled using a\n  human-readable name for the same country."
			}
			- " When a user agent fills in multiple fields at\n  once, all fields with the same "
			a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-16" {
				- "autofill field name"
			}
			- ", "
			a href="#form-owner" id="autofill-processing-model:form-owner-4" {
				- "form owner"
			}
			- ", and\n  "
			a href="#autofill-scope" id="autofill-processing-model:autofill-scope-8" {
				- "autofill scope"
			}
			- " must be filled with the same value."
		}
		- "\n\n  "
		p class="example" {
			- "Suppose a user agent knows of two phone numbers, +1 555 123 1234 and +1 555 666\n  7777. It would not be conforming for the user agent to fill a field with "
			code {
				- "autocomplete=\"shipping tel-local-prefix\""
			}
			- " with the value \"123\" and another field\n  in the same form with "
			code {
				- "autocomplete=\"shipping tel-local-suffix\""
			}
			- " with the\n  value \"7777\". The only valid prefilled values given the aforementioned information would be \"123\"\n  and \"1234\", or \"666\" and \"7777\", respectively."
		}
		- "\n\n  "
		p class="example" {
			- "Similarly, if a form for some reason contained both a \""
			code id="autofill-processing-model:attr-fe-autocomplete-cc-exp-3" {
				a href="#attr-fe-autocomplete-cc-exp" {
					- "cc-exp"
				}
			}
			- "\" field and a \""
			code id="autofill-processing-model:attr-fe-autocomplete-cc-exp-month-2" {
				a href="#attr-fe-autocomplete-cc-exp-month" {
					- "cc-exp-month"
				}
			}
			- "\" field, and the user agent\n  prefilled the form, then the month component of the former would have to match the latter."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "This requirement interacts with the "
				a href="#autofill-anchor-mantle" id="autofill-processing-model:autofill-anchor-mantle-4" {
					- "autofill anchor mantle"
				}
				- " also. Consider the\n   following markup snippet:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "form"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "hidden"
					}
					- " "
					c- e="" {
						- "autocomplete"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"nickname\""
					}
					- " "
					c- e="" {
						- "value"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"TreePlate\""
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "text"
					}
					- " "
					c- e="" {
						- "autocomplete"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"nickname\""
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "form"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "The only value that a conforming user agent could suggest in the text control is \"TreePlate\",\n   the value given by the hidden "
				code id="autofill-processing-model:the-input-element-4" {
					a href="#the-input-element" {
						- "input"
					}
				}
				- " element."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "The \""
			code {
				- "section-*"
			}
			- "\" tokens in the "
			a href="#autofill-scope" id="autofill-processing-model:autofill-scope-9" {
				- "autofill scope"
			}
			- " are opaque;\n  user agents must not attempt to derive meaning from the precise values of these tokens."
		}
		- "\n\n  "
		p class="example" {
			- "For example, it would not be conforming if the user agent decided that it\n  should offer the address it knows to be the user's daughter's address for\n  \""
			code {
				- "section-child"
			}
			- "\" and the addresses it knows to be the user's spouses'\n  addresses for \""
			code {
				- "section-spouse"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "The autocompletion mechanism must be implemented by the user agent acting as if the user had\n  modified the "
			a href="#control's-data" id="autofill-processing-model:control's-data-4" {
				- "control's data"
			}
			- ", and must be done at a time where the element is "
			i id="autofill-processing-model:concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- " (e.g. just after the element has been inserted into the\n  document, or when the user agent "
			a href="#stop-parsing" id="autofill-processing-model:stop-parsing" {
				- "stops parsing"
			}
			- "). User agents\n  must only prefill controls using values that the user could have entered."
		}
		- "\n\n  "
		p class="example" {
			- "For example, if a "
			code id="autofill-processing-model:the-select-element-6" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element only has "
			code id="autofill-processing-model:the-option-element-3" {
				a href="#the-option-element" {
					- "option"
				}
			}
			- "\n  elements with values \"Steve\" and \"Rebecca\", \"Jay\", and \"Bob\", and has an "
			a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-17" {
				- "autofill field\n  name"
			}
			- " \""
			code id="autofill-processing-model:attr-fe-autocomplete-given-name-2" {
				a href="#attr-fe-autocomplete-given-name" {
					- "given-name"
				}
			}
			- "\", but the user\n  agent's only idea for what to prefill the field with is \"Evan\", then the user agent cannot prefill\n  the field. It would not be conforming to somehow set the "
			code id="autofill-processing-model:the-select-element-7" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element to the value\n  \"Evan\", since the user could not have done so themselves."
		}
		- "\n\n  "
		p {
			- "A user agent prefilling a form control must not discriminate between form controls that are\n  "
			a id="autofill-processing-model:in-a-document-tree" href="https://dom.spec.whatwg.org/#in-a-document-tree" data-x-internal="in-a-document-tree" {
				- "in a document tree"
			}
			- " and those that are "
			a id="autofill-processing-model:connected" href="https://dom.spec.whatwg.org/#connected" data-x-internal="connected" {
				- "connected"
			}
			- "; that is, it is not\n  conforming to make the decision on whether or not to autofill based on whether the element's\n  "
			a id="autofill-processing-model:root" href="https://dom.spec.whatwg.org/#concept-tree-root" data-x-internal="root" {
				- "root"
			}
			- " is a "
			a id="autofill-processing-model:shadow-root" href="https://dom.spec.whatwg.org/#concept-shadow-root" data-x-internal="shadow-root" {
				- "shadow root"
			}
			- " versus a "
			code id="autofill-processing-model:document" {
				a href="#document" {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A user agent prefilling a form control's "
			a href="#concept-fe-value" id="autofill-processing-model:concept-fe-value-2" {
				- "value"
			}
			- " must not\n  cause that control to "
			a href="#suffering-from-a-type-mismatch" id="autofill-processing-model:suffering-from-a-type-mismatch" {
				- "suffer from a type\n  mismatch"
			}
			- ", "
			a href="#suffering-from-being-too-long" id="autofill-processing-model:suffering-from-being-too-long" {
				- "suffer from being too long"
			}
			- ",\n  "
			a href="#suffering-from-being-too-short" id="autofill-processing-model:suffering-from-being-too-short" {
				- "suffer from being too short"
			}
			- ", "
			a href="#suffering-from-an-underflow" id="autofill-processing-model:suffering-from-an-underflow" {
				- "suffer from an underflow"
			}
			- ", "
			a href="#suffering-from-an-overflow" id="autofill-processing-model:suffering-from-an-overflow" {
				- "suffer from an overflow"
			}
			- ", or "
			a href="#suffering-from-a-step-mismatch" id="autofill-processing-model:suffering-from-a-step-mismatch" {
				- "suffer from a step mismatch"
			}
			- ". A user agent prefilling a form control's "
			a href="#concept-fe-value" id="autofill-processing-model:concept-fe-value-3" {
				- "value"
			}
			- " must not cause that control to "
			a href="#suffering-from-a-pattern-mismatch" id="autofill-processing-model:suffering-from-a-pattern-mismatch" {
				- "suffer from a pattern mismatch"
			}
			- " either. Where possible given the\n  control's constraints, user agents must use the format given as canonical in the aforementioned\n  table. Where it's not possible for the canonical format to be used, user agents should use\n  heuristics to attempt to convert values so that they can be used."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For example, if the user agent knows that the user's middle name is \"Ines\", and attempts to\n   prefill a form control that looks like this:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "name"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "middle-initial"
					}
					- " "
					c- e="" {
						- "maxlength"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "1"
					}
					- " "
					c- e="" {
						- "autocomplete"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"additional-name\""
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "...then the user agent could convert \"Ines\" to \"I\" and prefill it that way."
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "A more elaborate example would be with month values. If the user agent knows that the user's\n   birthday is the 27th of July 2012, then it might try to prefill all of the following controls\n   with slightly different values, all driven from this information:"
			}
			- "\n\n   "
			table {
