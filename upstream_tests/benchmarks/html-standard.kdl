		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLTableCellElement" id="dom-tdth-rowspan" data-dfn-type="attribute" {
				code {
					- "rowSpan"
				}
			}
			- " IDL attribute must "
			a href="#reflect" id="attributes-common-to-td-and-th-elements:reflect-2" {
