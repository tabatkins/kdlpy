							var {
								- "source set"
							}
							- "."
						}
					}
					li {
						p {
							- "Return."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p class="note" {
			- "Each "
			code id="updating-the-source-set:the-img-element-7" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element independently considers its previous sibling\n  "
			code id="updating-the-source-set:the-source-element-2" {
				a href="#the-source-element" {
					- "source"
				}
			}
			- " elements plus the "
			code id="updating-the-source-set:the-img-element-8" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element itself for selecting an "
			a href="#image-source" id="updating-the-source-set:image-source-2" {
				- "image\n  source"
			}
			- ", ignoring any other (invalid) elements, including other "
			code id="updating-the-source-set:the-img-element-9" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements in\n  the same "
			code id="updating-the-source-set:the-picture-element-2" {
				a href="#the-picture-element" {
					- "picture"
				}
			}
			- " element, or "
			code id="updating-the-source-set:the-source-element-3" {
				a href="#the-source-element" {
					- "source"
				}
			}
			- " elements that are following siblings\n  of the relevant "
			code id="updating-the-source-set:the-img-element-10" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element."
		}
		- "\n\n\n  "
		h6 id="parsing-a-srcset-attribute" {
			span class="secno" {
				- "4.8.4.3.10"
			}
			- " Parsing a srcset attribute"
			a href="#parsing-a-srcset-attribute" class="self-link"
		}
		- "\n\n  "
		p {
			- "When asked to "
			dfn id="parse-a-srcset-attribute" {
				- "parse a srcset attribute"
			}
			- " from an element, parse the value of the\n  element's "
			a href="#srcset-attribute" id="parsing-a-srcset-attribute:srcset-attribute" {
				- "srcset attribute"
			}
			- " as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "input"
					}
					- " be the value passed to this algorithm."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "position"
					}
					- " be a pointer into "
					var {
						- "input"
					}
					- ",\n   initially pointing at the start of the string."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "candidates"
					}
					- " be an initially empty "
					a href="#source-set" id="parsing-a-srcset-attribute:source-set" {
						- "source set"
					}
					- "."
				}
			}
			li {
				p {
					i {
						- "Splitting loop"
					}
					- ": "
					a id="parsing-a-srcset-attribute:collect-a-sequence-of-code-points" href="https://infra.spec.whatwg.org/#collect-a-sequence-of-code-points" data-x-internal="collect-a-sequence-of-code-points" {
						- "Collect a sequence of code points"
					}
					- " that are "
					a id="parsing-a-srcset-attribute:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII\n   whitespace"
					}
					- " or U+002C COMMA characters from "
					var {
						- "input"
					}
					- " given "
					var {
						- "position"
					}
					- ". If\n   any U+002C COMMA characters were collected, that is a "
					a href="#concept-microsyntax-parse-error" id="parsing-a-srcset-attribute:concept-microsyntax-parse-error" {
						- "parse error"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "position"
					}
					- " is past the end of "
					var {
						- "input"
					}
					- ",\n   return "
					var {
						- "candidates"
					}
					- "."
				}
			}
			li {
				p {
					a id="parsing-a-srcset-attribute:collect-a-sequence-of-code-points-2" href="https://infra.spec.whatwg.org/#collect-a-sequence-of-code-points" data-x-internal="collect-a-sequence-of-code-points" {
						- "Collect a sequence of code points"
					}
					- " that are not "
					a id="parsing-a-srcset-attribute:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- "\n   from "
					var {
						- "input"
					}
					- " given "
					var {
						- "position"
					}
					- ", and let that be "
					var {
						- "url"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "descriptors"
					}
					- " be a new empty list."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "url"
					}
					- " ends with U+002C (,), then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Remove all trailing U+002C COMMA characters from "
							var {
								- "url"
							}
							- ".\n     If this removed more than one character,\n     that is a "
							a href="#concept-microsyntax-parse-error" id="parsing-a-srcset-attribute:concept-microsyntax-parse-error-2" {
								- "parse error"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							i {
								- "Descriptor tokenizer"
							}
							- ": "
							a id="parsing-a-srcset-attribute:skip-ascii-whitespace" href="https://infra.spec.whatwg.org/#skip-ascii-whitespace" data-x-internal="skip-ascii-whitespace" {
								- "Skip ASCII whitespace"
							}
							- " within "
							var {
								- "input"
							}
							- "\n     given "
							var {
								- "position"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "current descriptor"
							}
							- " be the empty string."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "state"
							}
							- " be "
							i {
								- "in descriptor"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "c"
							}
							- " be the character at "
							var {
								- "position"
							}
							- ".\n      Do the following depending on the value of "
							var {
								- "state"
							}
							- ".\n      For the purpose of this step, \"EOF\" is a special character representing\n      that "
							var {
								- "position"
							}
							- " is past the end of "
							var {
								- "input"
							}
							- "."
						}
						- "\n\n      "
						dl class="switch" {
							dt {
								i {
									- "In descriptor"
								}
							}
							dd {
								- "\n        "
								p {
									- "Do the following, depending on the value of "
									var {
										- "c"
									}
									- ":"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										a id="parsing-a-srcset-attribute:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
											- "ASCII whitespace"
										}
									}
									dd {
										p {
											- "If "
											var {
												- "current descriptor"
											}
											- " is not empty,\n         append "
											var {
												- "current descriptor"
											}
											- " to "
											var {
												- "descriptors"
											}
											- "\n         and let "
											var {
												- "current descriptor"
											}
											- " be the empty string.\n         Set "
											var {
												- "state"
											}
											- " to "
											i {
												- "after descriptor"
											}
											- "."
										}
									}
									dt {
										- "U+002C COMMA (,)"
									}
									dd {
										p {
											- "Advance "
											var {
												- "position"
											}
											- " to the next character in "
											var {
												- "input"
											}
											- ".\n         If "
											var {
												- "current descriptor"
											}
											- " is not empty,\n         append "
											var {
												- "current descriptor"
											}
											- " to "
											var {
												- "descriptors"
											}
											- ".\n         Jump to the step labeled "
											i {
												- "descriptor parser"
											}
											- "."
										}
									}
									dt {
										- "U+0028 LEFT PARENTHESIS (()"
									}
									dd {
										p {
											- "Append "
											var {
												- "c"
											}
											- " to "
											var {
												- "current descriptor"
											}
											- ".\n         Set "
											var {
												- "state"
											}
											- " to "
											i {
												- "in parens"
											}
											- "."
										}
									}
									dt {
										- "EOF"
									}
									dd {
										p {
											- "If "
											var {
												- "current descriptor"
											}
											- " is not empty,\n         append "
											var {
												- "current descriptor"
											}
											- " to "
											var {
												- "descriptors"
											}
											- ".\n         Jump to the step labeled "
											i {
												- "descriptor parser"
											}
											- "."
										}
									}
									dt {
										- "Anything else"
									}
									dd {
										p {
											- "Append "
											var {
												- "c"
											}
											- " to "
											var {
												- "current descriptor"
											}
											- "."
										}
									}
								}
								- "\n       "
							}
							dt {
								i {
									- "In parens"
								}
							}
							dd {
								- "\n        "
								p {
									- "Do the following, depending on the value of "
									var {
										- "c"
									}
									- ":"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										- "U+0029 RIGHT PARENTHESIS ())"
									}
									dd {
										p {
											- "Append "
											var {
												- "c"
											}
											- " to "
											var {
												- "current descriptor"
											}
											- ".\n         Set "
											var {
												- "state"
											}
											- " to "
											i {
												- "in descriptor"
											}
											- "."
										}
									}
									dt {
										- "EOF"
									}
									dd {
										p {
											- "Append "
											var {
												- "current descriptor"
											}
											- " to "
											var {
												- "descriptors"
											}
											- ".\n         Jump to the step labeled "
											i {
												- "descriptor parser"
											}
											- "."
										}
									}
									dt {
										- "Anything else"
									}
									dd {
										p {
											- "Append "
											var {
												- "c"
											}
											- " to "
											var {
												- "current descriptor"
											}
											- "."
										}
									}
								}
								- "\n       "
							}
							dt {
								i {
									- "After descriptor"
								}
							}
							dd {
								- "\n        "
								p {
									- "Do the following, depending on the value of "
									var {
										- "c"
									}
									- ":"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										a id="parsing-a-srcset-attribute:space-characters-4" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
											- "ASCII whitespace"
										}
									}
									dd {
										p {
											- "Stay in this state."
										}
									}
									dt {
										- "EOF"
									}
									dd {
										p {
											- "Jump to the step labeled "
											i {
												- "descriptor parser"
											}
											- "."
										}
									}
									dt {
										- "Anything else"
									}
									dd {
										p {
											- "Set "
											var {
												- "state"
											}
											- " to "
											i {
												- "in descriptor"
											}
											- ".\n         Set "
											var {
												- "position"
											}
											- " to the "
											em {
												- "previous"
											}
											- " character in "
											var {
												- "input"
											}
											- "."
										}
									}
								}
								- "\n       "
							}
						}
						- "\n\n      "
						p {
							- "Advance "
							var {
								- "position"
							}
							- " to the next character in "
							var {
								- "input"
							}
							- ". Repeat this\n      step."
						}
						- "\n\n      "
						p class="note" {
							- "In order to be compatible with future additions,\n      this algorithm supports multiple descriptors and descriptors with parens."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					i {
						- "Descriptor parser"
					}
					- ": Let "
					var {
						- "error"
					}
					- " be "
					i {
						- "no"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "width"
					}
					- " be "
					i {
						- "absent"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "density"
					}
					- " be "
					i {
						- "absent"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "future-compat-h"
					}
					- " be "
					i {
						- "absent"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "For each descriptor in "
					var {
						- "descriptors"
					}
					- ",\n    run the appropriate set of steps from the following list:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If the descriptor consists of a "
						a href="#valid-non-negative-integer" id="parsing-a-srcset-attribute:valid-non-negative-integer" {
							- "valid non-negative integer"
						}
						- "\n     followed by a U+0077 LATIN SMALL LETTER W character"
					}
					dd {
						- "\n      "
						ol {
							li {
								- "\n        "
								p {
									- "If the user agent does not support the "
									code id="parsing-a-srcset-attribute:attr-img-sizes" {
										a href="#attr-img-sizes" {
											- "sizes"
										}
									}
									- " attribute,\n        let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- "."
								}
								- "\n\n        "
								p class="note" {
									- "A conforming user agent will support the "
									code id="parsing-a-srcset-attribute:attr-img-sizes-2" {
										a href="#attr-img-sizes" {
											- "sizes"
										}
									}
									- " attribute.\n        However, user agents typically implement and ship features in an incremental manner in practice."
								}
								- "\n       "
							}
							li {
								p {
									- "If "
									var {
										- "width"
									}
									- " and "
									var {
										- "density"
									}
									- "\n       are not both "
									i {
										- "absent"
									}
									- ",\n       then let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- "."
								}
							}
							li {
								p {
									- "Apply the "
									a href="#rules-for-parsing-non-negative-integers" id="parsing-a-srcset-attribute:rules-for-parsing-non-negative-integers" {
										- "rules for parsing non-negative integers"
									}
									- " to the descriptor. If\n       the result is 0, let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- ". Otherwise, let "
									var {
										- "width"
									}
									- " be the\n       result."
								}
							}
						}
						- "\n     "
					}
					dt {
						- "If the descriptor consists of a "
						a href="#valid-floating-point-number" id="parsing-a-srcset-attribute:valid-floating-point-number" {
							- "valid floating-point number"
						}
						- "\n     followed by a U+0078 LATIN SMALL LETTER X character"
					}
					dd {
						- "\n      "
						ol {
							li {
								p {
									- "If "
									var {
										- "width"
									}
									- ", "
									var {
										- "density"
									}
									- " and "
									var {
										- "future-compat-h"
									}
									- "\n       are not all "
									i {
										- "absent"
									}
									- ",\n       then let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- "."
								}
							}
							li {
								- "\n        "
								p {
									- "Apply the "
									a href="#rules-for-parsing-floating-point-number-values" id="parsing-a-srcset-attribute:rules-for-parsing-floating-point-number-values" {
										- "rules for parsing floating-point number values"
									}
									- " to the descriptor.\n        If the result is less than 0, let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- ". Otherwise, let\n        "
									var {
										- "density"
									}
									- " be the result."
								}
								- "\n\n        "
								p class="note" {
									- "If "
									var {
										- "density"
									}
									- " is 0, the "
									a id="parsing-a-srcset-attribute:natural-dimensions" href="https://drafts.csswg.org/css-images/#natural-dimensions" data-x-internal="natural-dimensions" {
										- "natural dimensions"
									}
									- " will be\n        infinite. User agents are "
									a href="https://infra.spec.whatwg.org/#algorithm-limits" {
										- "expected\n        to have limits"
									}
									- " in how big images can be rendered."
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					dt {
						- "If the descriptor consists of a "
						a href="#valid-non-negative-integer" id="parsing-a-srcset-attribute:valid-non-negative-integer-2" {
							- "valid non-negative integer"
						}
						- "\n     followed by a U+0068 LATIN SMALL LETTER H character"
					}
					dd {
						- "\n      "
						p {
							- "This is a "
							a href="#concept-microsyntax-parse-error" id="parsing-a-srcset-attribute:concept-microsyntax-parse-error-3" {
								- "parse error"
							}
							- "."
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "If "
									var {
										- "future-compat-h"
									}
									- " and "
									var {
										- "density"
									}
									- "\n       are not both "
									i {
										- "absent"
									}
									- ",\n       then let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- "."
								}
							}
							li {
								p {
									- "Apply the "
									a href="#rules-for-parsing-non-negative-integers" id="parsing-a-srcset-attribute:rules-for-parsing-non-negative-integers-2" {
										- "rules for parsing non-negative integers"
									}
									- " to the descriptor. If\n       the result is 0, let "
									var {
										- "error"
									}
									- " be "
									i {
										- "yes"
									}
									- ". Otherwise, let\n       "
									var {
										- "future-compat-h"
									}
									- " be the result."
								}
							}
						}
						- "\n     "
					}
					dt {
						- "Anything else"
					}
					dd {
						p {
							- "Let "
							var {
								- "error"
							}
							- " be "
							i {
								- "yes"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "future-compat-h"
					}
					- " is not "
					i {
						- "absent"
					}
					- " and "
					var {
						- "width"
					}
					- " is "
					i {
						- "absent"
					}
					- ",\n   let "
					var {
						- "error"
					}
					- " be "
					i {
						- "yes"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "error"
					}
					- " is still "
					i {
						- "no"
					}
					- ",\n   then append a new "
					a href="#image-source" id="parsing-a-srcset-attribute:image-source" {
						- "image source"
					}
					- " to "
					var {
						- "candidates"
					}
					- "\n   whose URL is "
					var {
						- "url"
					}
					- ",\n   associated with a width "
					var {
						- "width"
					}
					- " if not "
					i {
						- "absent"
					}
					- "\n   and a pixel density "
					var {
						- "density"
					}
					- " if not "
					i {
						- "absent"
					}
					- ".\n   Otherwise, there is a "
					a href="#concept-microsyntax-parse-error" id="parsing-a-srcset-attribute:concept-microsyntax-parse-error-4" {
						- "parse error"
					}
					- "."
				}
			}
			li {
				p {
					- "Return to the step labeled "
					i {
						- "splitting loop"
					}
					- "."
				}
			}
		}
		- "\n\n\n  "
		h6 id="parsing-a-sizes-attribute" {
			span class="secno" {
				- "4.8.4.3.11"
			}
			- " Parsing a sizes attribute"
			a href="#parsing-a-sizes-attribute" class="self-link"
		}
		- "\n\n  "
		p {
			- "When asked to "
			dfn id="parse-a-sizes-attribute" {
				- "parse a sizes attribute"
			}
			- " from an element "
			var {
				- "element"
			}
			- ", with an\n  "
			code id="parsing-a-sizes-attribute:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element or null "
			var {
				- "img"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "unparsed sizes list"
					}
					- " be the result of "
					a href="https://drafts.csswg.org/css-syntax/#parse-a-comma-separated-list-of-component-values" id="parsing-a-sizes-attribute:parse-a-comma-separated-list-of-component-values" data-x-internal="parse-a-comma-separated-list-of-component-values" {
						- "parsing a comma-separated list of component values"
					}
					- " from the\n   value of "
					var {
						- "element"
					}
					- "'s "
					a href="#sizes-attribute" id="parsing-a-sizes-attribute:sizes-attribute" {
						- "sizes attribute"
					}
					- " (or the empty string, if the attribute\n   is absent). "
					a href="#refsCSSSYNTAX" {
						- "[CSSSYNTAX]"
					}
				}
			}
			li {
				p {
					- "Let "
					var {
						- "size"
					}
					- " be null."
				}
			}
			li {
				- "\n    "
				p {
					- "For each "
					var {
						- "unparsed size"
					}
					- " in "
					var {
						- "unparsed sizes list"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Remove all consecutive "
							a id="parsing-a-sizes-attribute:whitespace-token" href="https://drafts.csswg.org/css-syntax/#typedef-whitespace-token" data-x-internal="whitespace-token" {
								- "<whitespace-token>"
							}
							- "s\n     from the end of "
							var {
								- "unparsed size"
							}
							- ".\n     If "
							var {
								- "unparsed size"
							}
							- " is now empty,\n     then that is a "
							a href="#concept-microsyntax-parse-error" id="parsing-a-sizes-attribute:concept-microsyntax-parse-error" {
								- "parse error"
							}
							- ";\n     "
							a id="parsing-a-sizes-attribute:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- "."
						}
					}
					li {
						p {
							- "If the last "
							a id="parsing-a-sizes-attribute:component-value" href="https://drafts.csswg.org/css-syntax/#component-value" data-x-internal="component-value" {
								- "component value"
							}
							- " in "
							var {
								- "unparsed size"
							}
							- "\n     is a valid non-negative "
							a href="#source-size-value" id="parsing-a-sizes-attribute:source-size-value" {
								- "<source-size-value>"
							}
							- ",\n     then set "
							var {
								- "size"
							}
							- " to its value\n     and remove the "
							a id="parsing-a-sizes-attribute:component-value-2" href="https://drafts.csswg.org/css-syntax/#component-value" data-x-internal="component-value" {
								- "component value"
							}
							- " from "
							var {
								- "unparsed size"
							}
							- ".\n     Any CSS function other than the "
							a id="parsing-a-sizes-attribute:math-functions" href="https://drafts.csswg.org/css-values/#math-function" data-x-internal="math-functions" {
								- "math functions"
							}
							- " is invalid.\n     Otherwise, there is a "
							a href="#concept-microsyntax-parse-error" id="parsing-a-sizes-attribute:concept-microsyntax-parse-error-2" {
								- "parse error"
							}
							- ";\n     "
							a id="parsing-a-sizes-attribute:continue-2" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "size"
							}
							- " is "
							code id="parsing-a-sizes-attribute:valdef-sizes-auto" {
								a href="#valdef-sizes-auto" {
									- "auto"
								}
							}
							- ", and "
							var {
								- "img"
							}
							- "\n      is not null, and "
							var {
								- "img"
							}
							- " is "
							a href="#being-rendered" id="parsing-a-sizes-attribute:being-rendered" {
								- "being rendered"
							}
							- ", and "
							var {
								- "img"
							}
							- "\n      "
							a href="#allows-auto-sizes" id="parsing-a-sizes-attribute:allows-auto-sizes" {
								- "allows auto-sizes"
							}
							- ", then set "
							var {
								- "size"
							}
							- " to the "
							a id="parsing-a-sizes-attribute:concrete-object-size" href="https://drafts.csswg.org/css-images/#concrete-object-size" data-x-internal="concrete-object-size" {
								- "concrete object\n      size"
							}
							- " width of "
							var {
								- "img"
							}
							- ", in "
							a href="https://drafts.csswg.org/css-values/#px" id="parsing-a-sizes-attribute:'px'" data-x-internal="'px'" {
								- "CSS pixels"
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "If "
							var {
								- "size"
							}
							- " is still "
							code id="parsing-a-sizes-attribute:valdef-sizes-auto-2" {
								a href="#valdef-sizes-auto" {
									- "auto"
								}
							}
							- ",\n      then it will be ignored."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Remove all consecutive "
							a id="parsing-a-sizes-attribute:whitespace-token-2" href="https://drafts.csswg.org/css-syntax/#typedef-whitespace-token" data-x-internal="whitespace-token" {
								- "<whitespace-token>"
							}
							- "s from the end of "
							var {
								- "unparsed\n      size"
							}
							- ". If "
							var {
								- "unparsed size"
							}
							- " is now empty:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "If this was not the last item in "
									var {
										- "unparsed sizes list"
									}
									- ", that is a "
									a href="#concept-microsyntax-parse-error" id="parsing-a-sizes-attribute:concept-microsyntax-parse-error-3" {
										- "parse error"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "size"
									}
									- " is not "
									code id="parsing-a-sizes-attribute:valdef-sizes-auto-3" {
										a href="#valdef-sizes-auto" {
											- "auto"
										}
									}
									- ", then return\n       "
									var {
										- "size"
									}
									- ". Otherwise, continue."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							- "Parse the remaining "
							a href="https://drafts.csswg.org/css-syntax/#component-value" id="parsing-a-sizes-attribute:component-value-3" data-x-internal="component-value" {
								- "component values"
							}
							- " in "
							var {
								- "unparsed size"
							}
							- "\n     as a "
							a id="parsing-a-sizes-attribute:media-condition" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
								- "<media-condition>"
							}
							- ".\n     If it does not parse correctly,\n     or it does parse correctly but the "
							a id="parsing-a-sizes-attribute:media-condition-2" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
								- "<media-condition>"
							}
							- " evaluates to false,\n     "
							a id="parsing-a-sizes-attribute:continue-3" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- ". "
							a href="#refsMQ" {
								- "[MQ]"
							}
						}
					}
					li {
						p {
							- "If "
							var {
								- "size"
							}
							- " is not "
							code id="parsing-a-sizes-attribute:valdef-sizes-auto-4" {
								a href="#valdef-sizes-auto" {
									- "auto"
								}
							}
							- ", then return\n     "
							var {
								- "size"
							}
							- ". Otherwise, continue."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					code {
						- "100vw"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "It is invalid to use a bare "
			a href="#source-size-value" id="parsing-a-sizes-attribute:source-size-value-2" {
				- "<source-size-value>"
			}
			- " that is a "
			a id="parsing-a-sizes-attribute:length-2" href="https://drafts.csswg.org/css-values/#lengths" data-x-internal="length-2" {
				- "<length>"
			}
			- "\n  (without an accompanying "
			a id="parsing-a-sizes-attribute:media-condition-3" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
				- "<media-condition>"
			}
			- ")\n  as an entry in the "
			a href="#source-size-list" id="parsing-a-sizes-attribute:source-size-list" {
				- "<source-size-list>"
			}
			- " that is not the last entry.\n  However, the parsing algorithm allows it at any point in the "
			a href="#source-size-list" id="parsing-a-sizes-attribute:source-size-list-2" {
				- "<source-size-list>"
			}
			- ",\n  and will accept it immediately as the size\n  if the preceding entries in the list weren't used.\n  This is to enable future extensions,\n  and protect against simple author errors such as a final trailing comma.\n  A bare "
			code id="parsing-a-sizes-attribute:valdef-sizes-auto-5" {
				a href="#valdef-sizes-auto" {
					- "auto"
				}
			}
			- " keyword is allowed to have other entries\n  following it to provide a fallback for legacy user agents."
		}
		- "\n\n\n  "
		h6 id="normalizing-the-source-densities" {
			span class="secno" {
				- "4.8.4.3.12"
			}
			- " Normalizing the source densities"
			a href="#normalizing-the-source-densities" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			a href="#image-source" id="normalizing-the-source-densities:image-source" {
				- "image source"
			}
			- " can have a "
			a href="#pixel-density-descriptor" id="normalizing-the-source-densities:pixel-density-descriptor" {
				- "pixel density descriptor"
			}
			- ", a "
			a href="#width-descriptor" id="normalizing-the-source-densities:width-descriptor" {
				- "width\n  descriptor"
			}
			- ", or no descriptor at all accompanying its URL. Normalizing a "
			a href="#source-set" id="normalizing-the-source-densities:source-set" {
				- "source\n  set"
			}
			- " gives every "
			a href="#image-source" id="normalizing-the-source-densities:image-source-2" {
				- "image source"
			}
			- " a "
			a href="#pixel-density-descriptor" id="normalizing-the-source-densities:pixel-density-descriptor-2" {
				- "pixel density descriptor"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When asked to "
			dfn id="normalise-the-source-densities" {
				- "normalize the source\n  densities"
			}
			- " of a "
			a href="#source-set" id="normalizing-the-source-densities:source-set-2" {
				- "source set"
			}
			- " "
			var {
				- "source set"
			}
			- ", the user agent must do the\n  following:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "source size"
					}
					- " be "
					var {
						- "source set"
					}
					- "'s "
					a href="#source-size-2" id="normalizing-the-source-densities:source-size-2" {
						- "source size"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "For each "
					a href="#image-source" id="normalizing-the-source-densities:image-source-3" {
						- "image source"
					}
					- " in "
					var {
						- "source set"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							a href="#image-source" id="normalizing-the-source-densities:image-source-4" {
								- "image source"
							}
							- " has a "
							a href="#pixel-density-descriptor" id="normalizing-the-source-densities:pixel-density-descriptor-3" {
								- "pixel density descriptor"
							}
							- ", "
							a id="normalizing-the-source-densities:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- " to the next\n     "
							a href="#image-source" id="normalizing-the-source-densities:image-source-5" {
								- "image source"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Otherwise, if the "
							a href="#image-source" id="normalizing-the-source-densities:image-source-6" {
								- "image source"
							}
							- " has a "
							a href="#width-descriptor" id="normalizing-the-source-densities:width-descriptor-2" {
								- "width descriptor"
							}
							- ", replace the "
							a href="#width-descriptor" id="normalizing-the-source-densities:width-descriptor-3" {
								- "width\n      descriptor"
							}
							- " with a "
							a href="#pixel-density-descriptor" id="normalizing-the-source-densities:pixel-density-descriptor-4" {
								- "pixel density descriptor"
							}
							- " with a "
							a href="#pixel-density-descriptor-value" id="normalizing-the-source-densities:pixel-density-descriptor-value" {
								- "value"
							}
							- " of the "
							a href="#width-descriptor-value" id="normalizing-the-source-densities:width-descriptor-value" {
								- "width descriptor value"
							}
							- " divided by the "
							a href="#source-size-2" id="normalizing-the-source-densities:source-size-2-2" {
								- "source size"
							}
							- " and a unit\n      of "
							code {
								- "x"
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "If the "
							a href="#source-size-2" id="normalizing-the-source-densities:source-size-2-3" {
								- "source size"
							}
							- " is 0, then the density would be infinity,\n      which results in the "
							a id="normalizing-the-source-densities:natural-dimensions" href="https://drafts.csswg.org/css-images/#natural-dimensions" data-x-internal="natural-dimensions" {
								- "natural dimensions"
							}
							- " being 0 by 0."
						}
						- "\n     "
					}
					li {
						p {
							- "Otherwise, give the "
							a href="#image-source" id="normalizing-the-source-densities:image-source-7" {
								- "image source"
							}
							- " a "
							a href="#pixel-density-descriptor" id="normalizing-the-source-densities:pixel-density-descriptor-5" {
								- "pixel density descriptor"
							}
							- " of "
							code {
								- "1x"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="reacting-to-environment-changes" {
			span class="secno" {
				- "4.8.4.3.13"
			}
			- " Reacting to environment changes"
			a href="#reacting-to-environment-changes" class="self-link"
		}
		- "\n\n  "
		p {
			- "The user agent may at any time run the following algorithm to update an "
			code id="reacting-to-environment-changes:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- "\n  element's image in order to "
			dfn id="img-environment-changes" {
				- "react to changes in the\n  environment"
			}
			- ". (User agents are "
			em {
				- "not required"
			}
			- " to ever run this algorithm; for example,\n  if the user is not looking at the page any more, the user agent might want to wait until the user\n  has returned to the page before determining which image to use, in case the environment changes\n  again in the meantime.)"
		}
		- "\n\n  "
		p class="note" {
			- "User agents are encouraged to run this algorithm in particular when the user changes\n  the "
			a id="reacting-to-environment-changes:viewport" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- "'s size (e.g. by resizing the window or changing the page zoom), and when\n  an "
			code id="reacting-to-environment-changes:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element is "
			a href="#insert-an-element-into-a-document" id="reacting-to-environment-changes:insert-an-element-into-a-document" {
				- "inserted into a\n  document"
			}
			- ", so that the "
			a href="#density-corrected-intrinsic-width-and-height" id="reacting-to-environment-changes:density-corrected-intrinsic-width-and-height" {
				- "density-corrected natural width and height"
			}
			- " match the\n  new "
			a id="reacting-to-environment-changes:viewport-2" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- ", and so that the correct image is chosen when "
			a href="#art-direction" id="reacting-to-environment-changes:art-direction" {
				- "art direction"
			}
			- "\n  is involved."
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="#await-a-stable-state" id="reacting-to-environment-changes:await-a-stable-state" {
						- "Await a stable state"
					}
					- ". The "
					a href="#synchronous-section" id="reacting-to-environment-changes:synchronous-section" {
						- "synchronous section"
					}
					- "\n   consists of all the remaining steps of this algorithm until the algorithm says the\n   "
					a href="#synchronous-section" id="reacting-to-environment-changes:synchronous-section-2" {
						- "synchronous section"
					}
