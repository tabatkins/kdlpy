		- "\n\n  "
		p id="structuredclone" {
			span id="structured-clone"
			- "To support passing JavaScript objects,\n  including "
			a href="https://webidl.spec.whatwg.org/#dfn-platform-object" id="safe-passing-of-structured-data:platform-object" data-x-internal="platform-object" {
