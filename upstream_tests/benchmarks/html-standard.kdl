								- "resizeHeight"
							}
						}
						- " are specified"
					}
					dd {
						- "the height of "
						var {
							- "sourceRectangle"
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Place "
					var {
						- "input"
					}
					- " on an infinite "
					a id="images-2:transparent-black-2" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
						- "transparent black"
					}
					- " grid plane,\n   positioned so that its top left corner is at the origin of the plane, with the\n   "
					var {
						- "x"
					}
					- "-coordinate increasing to the right, and the "
					var {
						- "y"
					}
					- "-coordinate increasing down,\n   and with each pixel in the "
					var {
						- "input"
					}
					- " image data occupying a cell on the plane's\n   grid."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "output"
					}
					- " be the rectangle on the plane denoted by\n   "
					var {
						- "sourceRectangle"
					}
					- "."
				}
			}
			li {
				p {
					- "Scale "
					var {
						- "output"
					}
					- " to the size specified by "
					var {
						- "outputWidth"
					}
					- " and\n   "
					var {
						- "outputHeight"
					}
					- ". The user agent should use the value of the "
					dfn data-dfn-for="ImageBitmapOptions" id="dom-imagebitmapoptions-resizequality" data-dfn-type="dict-member" {
						code {
							- "resizeQuality"
						}
					}
					- " option to guide the\n   choice of scaling algorithm."
				}
			}
			li {
				- "\n    "
				p {
					- "If the value of the "
					dfn data-dfn-for="ImageBitmapOptions" id="dom-imagebitmapoptions-imageorientation" data-dfn-type="dict-member" {
						code {
							- "imageOrientation"
						}
					}
					- " member of\n    "
					var {
						- "options"
					}
					- " is \""
					dfn data-dfn-for="ImageOrientation" id="dom-imageorientation-flipy" data-dfn-type="enum-value" {
						code {
							- "flipY"
						}
					}
					- "\", "
					var {
						- "output"
					}
					- " must be flipped\n    vertically, disregarding any image orientation metadata of the source (such as EXIF metadata),\n    if any. "
					a href="#refsEXIF" {
						- "[EXIF]"
					}
				}
				- "\n\n    "
				p class="note" {
					- "If the value is \""
					dfn data-dfn-for="ImageOrientation" id="dom-imageorientation-from-image" data-dfn-type="enum-value" {
						code {
							- "from-image"
						}
					}
					- "\", no extra step is needed."
				}
				- "\n\n    "
				p class="note" {
					- "There used to be a \""
					dfn id="dom-imagebitmapoptions-imageorientation-none" {
						code {
							- "none"
						}
					}
					- "\" enum value. It was\n    renamed to \""
					code id="images-2:dom-imageorientation-from-image-3" {
						a href="#dom-imageorientation-from-image" {
							- "from-image"
						}
					}
					- "\". In the future,\n    \""
					code id="images-2:dom-imagebitmapoptions-imageorientation-none" {
						a href="#dom-imagebitmapoptions-imageorientation-none" {
							- "none"
						}
					}
					- "\" will be added back\n    with a different meaning."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "image"
					}
					- " is an "
					code id="images-2:the-img-element-4" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element or a "
