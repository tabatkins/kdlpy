										- "If the attribute is in the "
										a id="serialising-html-fragments:xml-namespace" href="https://infra.spec.whatwg.org/#xml-namespace" data-x-internal="xml-namespace" {
											- "XML namespace"
										}
									}
									dd {
										p {
											- "The attribute's serialized name is the string \""
