									a href="#dom-datatransfer-dropeffect-copy" {
										- "copy"
									}
								}
								- "\" or \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-link-5" {
									a href="#dom-datatransfer-dropeffect-link" {
										- "link"
									}
								}
								- "\""
							}
						}
						tr {
							td {
								- "\""
								code id="the-dragevent-interface:dom-datatransfer-effectallowed-uninitialized-2" {
									a href="#dom-datatransfer-effectallowed-uninitialized" {
										- "uninitialized"
									}
								}
								- "\" when what is being dragged is a selection"
							}
							td {
								- "\""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-copy-6" {
									a href="#dom-datatransfer-dropeffect-copy" {
										- "copy"
									}
								}
								- "\", or, "
								a href="#concept-platform-dropeffect-override" id="the-dragevent-interface:concept-platform-dropeffect-override-6" {
									- "if appropriate"
								}
								- ", either \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-link-6" {
									a href="#dom-datatransfer-dropeffect-link" {
										- "link"
									}
								}
								- "\" or \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-move-6" {
									a href="#dom-datatransfer-dropeffect-move" {
										- "move"
									}
								}
								- "\""
							}
						}
						tr {
							td {
								- "\""
								code id="the-dragevent-interface:dom-datatransfer-effectallowed-uninitialized-3" {
									a href="#dom-datatransfer-effectallowed-uninitialized" {
										- "uninitialized"
									}
								}
								- "\" when what is being dragged is an "
								code id="the-dragevent-interface:the-a-element" {
									a href="#the-a-element" {
										- "a"
									}
								}
								- " element with an "
								code id="the-dragevent-interface:attr-hyperlink-href" {
									a href="#attr-hyperlink-href" {
										- "href"
									}
								}
								- " attribute"
							}
							td {
								- "\""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-link-7" {
									a href="#dom-datatransfer-dropeffect-link" {
										- "link"
									}
								}
								- "\", or, "
								a href="#concept-platform-dropeffect-override" id="the-dragevent-interface:concept-platform-dropeffect-override-7" {
									- "if appropriate"
								}
								- ", either \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-copy-7" {
									a href="#dom-datatransfer-dropeffect-copy" {
										- "copy"
									}
								}
								- "\" or \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-move-7" {
									a href="#dom-datatransfer-dropeffect-move" {
										- "move"
									}
								}
								- "\""
							}
						}
						tr {
							td {
								- "Any other case"
							}
							td {
								- "\""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-copy-8" {
									a href="#dom-datatransfer-dropeffect-copy" {
										- "copy"
									}
								}
								- "\", or, "
								a href="#concept-platform-dropeffect-override" id="the-dragevent-interface:concept-platform-dropeffect-override-8" {
									- "if appropriate"
								}
								- ", either \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-link-8" {
									a href="#dom-datatransfer-dropeffect-link" {
										- "link"
									}
								}
								- "\" or \""
								code id="the-dragevent-interface:dom-datatransfer-dropeffect-move-8" {
									a href="#dom-datatransfer-dropeffect-move" {
										- "move"
									}
								}
								- "\""
							}
						}
					}
				}
				- "\n\n    "
				p {
					- "Where the table above provides "
					dfn id="concept-platform-dropeffect-override" {
						- "possibly\n    appropriate alternatives"
					}
					- ", user agents may instead use the listed alternative values if\n    platform conventions dictate that the user has requested those alternate effects."
				}
				- "\n\n    "
				p class="example" {
					- "For example, Windows platform conventions are such that dragging while\n    holding the \"alt\" key indicates a preference for linking the data, rather than moving or copying\n    it. Therefore, on a Windows system, if \""
					code id="the-dragevent-interface:dom-datatransfer-dropeffect-link-9" {
						a href="#dom-datatransfer-dropeffect-link" {
							- "link"
						}
					}
					- "\" is an option according to\n    the table above while the \"alt\" key is depressed, the user agent could select that instead of\n    \""
					code id="the-dragevent-interface:dom-datatransfer-dropeffect-copy-9" {
						a href="#dom-datatransfer-dropeffect-copy" {
							- "copy"
						}
					}
					- "\" or \""
					code id="the-dragevent-interface:dom-datatransfer-dropeffect-move-9" {
						a href="#dom-datatransfer-dropeffect-move" {
							- "move"
						}
					}
					- "\"."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "event"
					}
					- " be the result of "
					a id="the-dragevent-interface:creating-an-event" href="https://dom.spec.whatwg.org/#concept-event-create" data-x-internal="creating-an-event" {
						- "creating an event"
					}
					- " using\n   "
					code id="the-dragevent-interface:dragevent-5" {
						a href="#dragevent" {
							- "DragEvent"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code id="the-dragevent-interface:dom-event-type" {
						a data-x-internal="dom-event-type" href="https://dom.spec.whatwg.org/#dom-event-type" {
							- "type"
						}
					}
					- " attribute to\n   "
					var {
						- "e"
					}
					- ", its "
					code id="the-dragevent-interface:dom-event-bubbles" {
						a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
							- "bubbles"
						}
					}
					- " attribute to true, its "
					code id="the-dragevent-interface:dom-uievent-view" {
						a data-x-internal="dom-uievent-view" href="https://w3c.github.io/uievents/#dom-uievent-view" {
							- "view"
						}
					}
					- " attribute to "
					var {
						- "window"
					}
					- ", its "
					code id="the-dragevent-interface:dom-mouseevent-relatedtarget" {
						a data-x-internal="dom-mouseevent-relatedtarget" href="https://w3c.github.io/uievents/#dom-mouseevent-relatedtarget" {
							- "relatedTarget"
						}
					}
					- " attribute to "
					var {
						- "related\n   target"
					}
					- ", and its "
					code id="the-dragevent-interface:dom-dragevent-datatransfer-2" {
						a href="#dom-dragevent-datatransfer" {
							- "dataTransfer"
						}
					}
					- " attribute to\n   "
					var {
						- "dataTransfer"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "e"
					}
					- " is not "
					code id="the-dragevent-interface:event-dnd-dragleave-2" {
						a href="#event-dnd-dragleave" {
							- "dragleave"
						}
					}
					- " or "
					code id="the-dragevent-interface:event-dnd-dragend-2" {
						a href="#event-dnd-dragend" {
							- "dragend"
						}
					}
					- ", then initialize "
					var {
						- "event"
					}
					- "'s "
					code id="the-dragevent-interface:dom-event-cancelable" {
						a data-x-internal="dom-event-cancelable" href="https://dom.spec.whatwg.org/#dom-event-cancelable" {
							- "cancelable"
						}
					}
					- " attribute to true."
				}
			}
			li {
				- "\n    "
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s mouse and key attributes initialized according to the state of\n    the input devices as they would be for user interaction events."
				}
				- "\n\n    \n\n    "
				p {
					- "If there is no relevant pointing device, then initialize "
					var {
						- "event"
					}
					- "'s "
					code {
						- "screenX"
					}
					- ", "
					code {
						- "screenY"
					}
					- ", "
					code id="the-dragevent-interface:mouseevent-clientx" {
						a data-x-internal="mouseevent-clientx" href="https://drafts.csswg.org/cssom-view/#dom-mouseevent-clientx" {
							- "clientX"
						}
					}
					- ", "
					code id="the-dragevent-interface:mouseevent-clienty" {
						a data-x-internal="mouseevent-clienty" href="https://drafts.csswg.org/cssom-view/#dom-mouseevent-clienty" {
							- "clientY"
						}
					}
					- ",\n    and "
					code {
						- "button"
					}
					- " attributes to 0."
				}
				- "\n   "
			}
			li {
				p {
					a href="https://dom.spec.whatwg.org/#concept-event-dispatch" id="the-dragevent-interface:concept-event-dispatch" data-x-internal="concept-event-dispatch" {
						- "Dispatch"
					}
					- " "
					var {
						- "event"
					}
					- " at the specified\n   target element."
				}
			}
			li {
				p {
					- "Set the "
					a href="#drag-data-store-allowed-effects-state" id="the-dragevent-interface:drag-data-store-allowed-effects-state-2" {
						- "drag data store allowed effects state"
					}
					- " to the current value of\n   "
					var {
						- "dataTransfer"
					}
					- "'s "
					code id="the-dragevent-interface:dom-datatransfer-effectallowed-4" {
						a href="#dom-datatransfer-effectallowed" {
							- "effectAllowed"
						}
					}
					- "\n   attribute. (It can only have changed value if "
					var {
						- "e"
					}
					- " is "
					code id="the-dragevent-interface:event-dnd-dragstart-3" {
						a href="#event-dnd-dragstart" {
							- "dragstart"
						}
					}
					- ".)"
				}
			}
			li {
				p {
					- "If "
					var {
						- "dataDragStoreWasChanged"
					}
					- " is true, then set the "
					a href="#drag-data-store-mode" id="the-dragevent-interface:drag-data-store-mode-3" {
						- "drag data store\n   mode"
					}
					- " back to the "
					a href="#concept-dnd-p" id="the-dragevent-interface:concept-dnd-p" {
						- "protected mode"
					}
					- "."
				}
			}
			li {
				p {
					- "Break the association between "
					var {
						- "dataTransfer"
					}
					- " and the "
					a href="#drag-data-store" id="the-dragevent-interface:drag-data-store-4" {
						- "drag data\n   store"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  \n\n  "
		h4 id="drag-and-drop-processing-model" {
			span class="secno" {
				- "6.11.5"
			}
			- " Processing model"
			a href="#drag-and-drop-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user attempts to begin a drag operation, the user agent must run the following steps.\n  User agents must act as if these steps were run even if the drag actually started in another\n  document or application and the user agent was not aware that the drag was occurring until it\n  intersected with a document under the user agent's purview."
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Determine what is being dragged, as follows:"
				}
				- "\n\n    "
				p {
					- "If the drag operation was invoked on a selection, then it is the selection that is being\n    dragged."
				}
				- "\n\n    "
				p {
					- "Otherwise, if the drag operation was invoked on a "
					code id="drag-and-drop-processing-model:document" {
						a href="#document" {
							- "Document"
						}
					}
					- ", it is the first\n    element, going up the ancestor chain, starting at the node that the user tried to drag, that has\n    the IDL attribute "
					code id="drag-and-drop-processing-model:dom-draggable" {
						a href="#dom-draggable" {
							- "draggable"
						}
					}
					- " set to true. If there is no such\n    element, then nothing is being dragged; return, the drag-and-drop operation is never\n    started."
				}
				- "\n\n    "
				p {
					- "Otherwise, the drag operation was invoked outside the user agent's purview. What is being\n    dragged is defined by the document or application where the drag was started."
				}
				- "\n\n    "
				p class="note" {
					code id="drag-and-drop-processing-model:the-img-element" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " elements and "
					code id="drag-and-drop-processing-model:the-a-element" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " elements with an "
					code id="drag-and-drop-processing-model:attr-hyperlink-href" {
						a href="#attr-hyperlink-href" {
							- "href"
						}
					}
					- " attribute have their "
					code id="drag-and-drop-processing-model:dom-draggable-2" {
						a href="#dom-draggable" {
							- "draggable"
						}
					}
					- " attribute set to true by default."
				}
				- "\n   "
			}
			li {
				p {
					a href="#create-a-drag-data-store" id="drag-and-drop-processing-model:create-a-drag-data-store" {
						- "Create a drag data store"
					}
					- ". All the DND events fired subsequently by the steps\n   in this section must use this "
					a href="#drag-data-store" id="drag-and-drop-processing-model:drag-data-store" {
						- "drag data store"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Establish which DOM node is the "
					dfn id="source-node" {
						- "source node"
					}
					- ", as follows:"
				}
				- "\n\n    "
				p {
					- "If it is a selection that is being dragged, then the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node" {
						- "source node"
					}
					- " is the\n    "
					code id="drag-and-drop-processing-model:text" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node that the user started the drag on (typically the "
					code id="drag-and-drop-processing-model:text-2" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node\n    that the user originally clicked). If the user did not specify a particular node, for example if\n    the user just told the user agent to begin a drag of \"the selection\", then the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-2" {
						- "source\n    node"
					}
					- " is the first "
					code id="drag-and-drop-processing-model:text-3" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node containing a part of the selection."
				}
				- "\n\n    "
				p {
					- "Otherwise, if it is an element that is being dragged, then the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-3" {
						- "source node"
					}
					- " is\n    the element that is being dragged."
				}
				- "\n\n    "
				p {
					- "Otherwise, the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-4" {
						- "source node"
					}
					- " is part of another document or application. When this\n    specification requires that an event be dispatched at the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-5" {
						- "source node"
					}
					- " in this case,\n    the user agent must instead follow the platform-specific conventions relevant to that\n    situation."
				}
				- "\n\n    "
				p class="note" {
					- "Multiple events are fired on the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-6" {
						- "source node"
					}
					- " during the course of\n    the drag-and-drop operation."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Determine the "
					dfn id="list-of-dragged-nodes" {
						- "list of dragged nodes"
					}
					- ", as follows:"
				}
				- "\n\n    "
				p {
					- "If it is a selection that is being dragged, then the "
					a href="#list-of-dragged-nodes" id="drag-and-drop-processing-model:list-of-dragged-nodes" {
						- "list of dragged nodes"
					}
					- "\n    contains, in "
					a id="drag-and-drop-processing-model:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
						- "tree order"
					}
					- ", every node that is partially or completely included in the\n    selection (including all their ancestors)."
				}
				- "\n\n    "
				p {
					- "Otherwise, the "
					a href="#list-of-dragged-nodes" id="drag-and-drop-processing-model:list-of-dragged-nodes-2" {
						- "list of dragged nodes"
					}
					- " contains only the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-7" {
						- "source node"
					}
					- ",\n    if any."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If it is a selection that is being dragged, then add an item to the "
					a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list" {
						- "drag data store\n    item list"
					}
					- ", with its properties set as follows:"
				}
				- "\n\n    "
				dl {
					dt {
						a href="#the-drag-data-item-type-string" id="drag-and-drop-processing-model:the-drag-data-item-type-string" {
							- "The drag data item type string"
						}
						- "\n     "
					}
					dd {
						- "\""
						code id="drag-and-drop-processing-model:text/plain" {
							a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
								- "text/plain"
							}
						}
						- "\""
					}
					dt {
						a href="#the-drag-data-item-kind" id="drag-and-drop-processing-model:the-drag-data-item-kind" {
							- "The drag data item kind"
						}
						- "\n     "
					}
					dd {
						i {
							- "Text"
						}
					}
					dt {
						- "The actual data"
					}
					dd {
						- "The text of the selection"
					}
				}
				- "\n\n    "
				p {
					- "Otherwise, if any files are being dragged, then add one item per file to the "
					a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-2" {
						- "drag data\n    store item list"
					}
					- ", with their properties set as follows:"
				}
				- "\n\n    "
				dl {
					dt {
						a href="#the-drag-data-item-type-string" id="drag-and-drop-processing-model:the-drag-data-item-type-string-2" {
							- "The drag data item type string"
						}
						- "\n     "
					}
					dd {
						- "The MIME type of the file, if known, or \""
						code id="drag-and-drop-processing-model:application/octet-stream" {
							a data-x-internal="application/octet-stream" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.5.1" {
								- "application/octet-stream"
							}
						}
						- "\" otherwise."
					}
					dt {
						a href="#the-drag-data-item-kind" id="drag-and-drop-processing-model:the-drag-data-item-kind-2" {
							- "The drag data item kind"
						}
						- "\n     "
					}
					dd {
						i {
							- "File"
						}
					}
					dt {
						- "The actual data"
					}
					dd {
						- "The file's contents and name."
					}
				}
				- "\n\n    "
				p class="note" {
					- "Dragging files can currently only happen from outside a "
					a href="#navigable" id="drag-and-drop-processing-model:navigable" {
						- "navigable"
					}
					- ",\n    for example from a file system manager application."
				}
				- "\n\n    "
				p {
					- "If the drag initiated outside of the application, the user agent must add items to the\n    "
					a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-3" {
						- "drag data store item list"
					}
					- " as appropriate for the data being dragged, honoring\n    platform conventions where appropriate; however, if the platform conventions do not use "
					a href="https://mimesniff.spec.whatwg.org/#mime-type" id="drag-and-drop-processing-model:mime-type" data-x-internal="mime-type" {
						- "MIME types"
					}
					- " to label dragged data, the user agent must make a\n    best-effort attempt to map the types to MIME types, and, in any case, all the "
					a href="#the-drag-data-item-type-string" id="drag-and-drop-processing-model:the-drag-data-item-type-string-3" {
						- "drag data item type strings"
					}
					- " must be "
					a id="drag-and-drop-processing-model:converted-to-ascii-lowercase" href="https://infra.spec.whatwg.org/#ascii-lowercase" data-x-internal="converted-to-ascii-lowercase" {
						- "converted to ASCII\n    lowercase"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "User agents may also add one or more items representing the selection or dragged element(s)\n    in other forms, e.g. as HTML."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					a href="#list-of-dragged-nodes" id="drag-and-drop-processing-model:list-of-dragged-nodes-3" {
						- "list of dragged nodes"
					}
					- " is not empty, then "
					a href="#extracting-json" id="drag-and-drop-processing-model:extracting-json" {
						- "extract the microdata from those nodes into a JSON form"
					}
					- ", and add one item to the\n    "
					a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-4" {
						- "drag data store item list"
					}
					- ", with its properties set as follows:"
				}
				- "\n\n    "
				dl {
					dt {
						a href="#the-drag-data-item-type-string" id="drag-and-drop-processing-model:the-drag-data-item-type-string-4" {
							- "The drag data item type string"
						}
						- "\n     "
					}
					dd {
						code id="drag-and-drop-processing-model:application/microdata+json" {
							a href="#application/microdata+json" {
								- "application/microdata+json"
							}
						}
					}
					dt {
						a href="#the-drag-data-item-kind" id="drag-and-drop-processing-model:the-drag-data-item-kind-3" {
							- "The drag data item kind"
						}
						- "\n     "
					}
					dd {
						i {
							- "Text"
						}
					}
					dt {
						- "The actual data"
					}
					dd {
						- "The resulting JSON string."
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Run the following substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "urls"
							}
							- " be « »."
						}
					}
					li {
						- "\n      "
						p {
							- "For each "
							var {
								- "node"
							}
							- " in the "
							a href="#list-of-dragged-nodes" id="drag-and-drop-processing-model:list-of-dragged-nodes-4" {
								- "list of dragged nodes"
							}
							- ":"
						}
						- "\n\n      "
						dl {
							dt {
								- "If the node is an "
								code id="drag-and-drop-processing-model:the-a-element-2" {
									a href="#the-a-element" {
										- "a"
									}
								}
								- " element with an "
								code id="drag-and-drop-processing-model:attr-hyperlink-href-2" {
									a href="#attr-hyperlink-href" {
										- "href"
									}
								}
								- " attribute"
							}
							dd {
								- "Add to "
								var {
									- "urls"
								}
								- " the result of "
								a href="#encoding-parsing-and-serializing-a-url" id="drag-and-drop-processing-model:encoding-parsing-and-serializing-a-url" {
									- "encoding-parsing-and-serializing a URL"
								}
								- "\n       given the element's "
								code id="drag-and-drop-processing-model:attr-hyperlink-href-3" {
									a href="#attr-hyperlink-href" {
										- "href"
									}
								}
								- " content attribute's value,\n       relative to the element's "
								a id="drag-and-drop-processing-model:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
									- "node document"
								}
								- "."
							}
							dt {
								- "If the node is an "
								code id="drag-and-drop-processing-model:the-img-element-2" {
									a href="#the-img-element" {
										- "img"
									}
								}
								- " element with a "
								code id="drag-and-drop-processing-model:attr-img-src" {
									a href="#attr-img-src" {
										- "src"
									}
								}
								- "\n       attribute"
							}
							dd {
								- "Add to "
								var {
									- "urls"
								}
								- " the result of "
								a href="#encoding-parsing-and-serializing-a-url" id="drag-and-drop-processing-model:encoding-parsing-and-serializing-a-url-2" {
									- "encoding-parsing-and-serializing a URL"
								}
								- "\n       given the element's "
								code id="drag-and-drop-processing-model:attr-img-src-2" {
									a href="#attr-img-src" {
										- "src"
									}
								}
								- " content attribute's value, relative to\n       the element's "
								a id="drag-and-drop-processing-model:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
									- "node document"
								}
								- "."
							}
						}
						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "urls"
							}
							- " is still empty, then return."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "url string"
							}
							- " be the result of concatenating the strings in "
							var {
								- "urls"
							}
							- ",\n     in the order they were added, separated by a U+000D CARRIAGE RETURN U+000A LINE FEED character\n     pair (CRLF)."
						}
					}
					li {
						p {
							- "Add one item to the "
							a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-5" {
								- "drag data store item list"
							}
							- ", with its properties set as\n     follows:"
						}
						- "\n\n      "
						dl {
							dt {
								a href="#the-drag-data-item-type-string" id="drag-and-drop-processing-model:the-drag-data-item-type-string-5" {
									- "The drag data item type string"
								}
								- "\n       "
							}
							dd {
								code id="drag-and-drop-processing-model:text/uri-list" {
									a href="#text/uri-list" {
										- "text/uri-list"
									}
								}
							}
							dt {
								a href="#the-drag-data-item-kind" id="drag-and-drop-processing-model:the-drag-data-item-kind-4" {
									- "The drag data item kind"
								}
								- "\n       "
							}
							dd {
								i {
									- "Text"
								}
							}
							dt {
								- "The actual data"
							}
							dd {
								var {
									- "url string"
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Update the "
					a href="#drag-data-store-default-feedback" id="drag-and-drop-processing-model:drag-data-store-default-feedback" {
						- "drag data store default feedback"
					}
					- " as appropriate for the user agent\n    (if the user is dragging the selection, then the selection would likely be the basis for this\n    feedback; if the user is dragging an element, then that element's rendering would be used; if\n    the drag began outside the user agent, then the platform conventions for determining the drag\n    feedback should be used)."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					a href="#fire-a-dnd-event" id="drag-and-drop-processing-model:fire-a-dnd-event" {
						- "Fire a DND event"
					}
					- " named "
					code id="drag-and-drop-processing-model:event-dnd-dragstart" {
						a href="#event-dnd-dragstart" {
							- "dragstart"
						}
					}
					- " at the\n    "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-8" {
						- "source node"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If the event is canceled, then the drag-and-drop operation should not occur; return."
				}
				- "\n    \n\n    "
				p class="note" {
					- "Since events with no event listeners registered are, almost by definition, never\n    canceled, drag-and-drop is always available to the user if the author does not specifically\n    prevent it."
				}
				- "\n   "
			}
			li {
				p {
					a id="drag-and-drop-processing-model:fire-a-pointer-event" href="https://w3c.github.io/pointerevents/#dfn-fire-a-pointer-event" data-x-internal="fire-a-pointer-event" {
						- "Fire a pointer event"
					}
					- " at the "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-9" {
						- "source node"
					}
					- " named "
					code id="drag-and-drop-processing-model:event-pointercancel" {
						a data-x-internal="event-pointercancel" href="https://w3c.github.io/pointerevents/#the-pointercancel-event" {
							- "pointercancel"
						}
					}
					- ", and fire any other follow-up events as\n   required by "
					cite {
						- "Pointer Events"
					}
					- ". "
					a href="#refsPOINTEREVENTS" {
						- "[POINTEREVENTS]"
					}
				}
			}
			li {
				- "\n    "
				p {
					a href="#initiate-the-drag-and-drop-operation" id="drag-and-drop-processing-model:initiate-the-drag-and-drop-operation" {
						- "Initiate the drag-and-drop operation"
					}
					- " in a manner consistent with platform\n    conventions, and as described below."
				}
				- "\n\n    "
				p id="base-dnd-feedback" {
					- "The drag-and-drop feedback must be generated from the first of the\n    following sources that is available:"
				}
				- "\n\n    "
				ol {
					li {
						- "The "
						a href="#drag-data-store-bitmap" id="drag-and-drop-processing-model:drag-data-store-bitmap" {
							- "drag data store bitmap"
						}
						- ", if any. In this case, the "
						a href="#drag-data-store-hot-spot-coordinate" id="drag-and-drop-processing-model:drag-data-store-hot-spot-coordinate" {
							- "drag data store\n     hot spot coordinate"
						}
						- " should be used as hints for where to put the cursor relative to the\n     resulting image. The values are expressed as distances in "
						a href="https://drafts.csswg.org/css-values/#px" id="drag-and-drop-processing-model:'px'" data-x-internal="'px'" {
							- "CSS pixels"
						}
						- "\n     from the left side and from the top side of the image respectively. "
						a href="#refsCSS" {
							- "[CSS]"
						}
					}
					li {
						- "The "
						a href="#drag-data-store-default-feedback" id="drag-and-drop-processing-model:drag-data-store-default-feedback-2" {
							- "drag data store default feedback"
						}
						- "."
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "From the moment that the user agent is to "
			dfn id="initiate-the-drag-and-drop-operation" {
				- "initiate the drag-and-drop operation"
			}
			- ",\n  until the end of the drag-and-drop operation, device input events (e.g. mouse and keyboard events)\n  must be suppressed."
		}
		- "\n\n  "
		p {
			- "During the drag operation, the element directly indicated by the user as the drop target is\n  called the "
			dfn id="immediate-user-selection" {
				- "immediate user selection"
			}
			- ". (Only elements can be selected by the user; other\n  nodes must not be made available as drop targets.) However, the "
			a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection" {
				- "immediate user\n  selection"
			}
			- " is not necessarily the "
			dfn id="current-target-element" {
				- "current target element"
			}
			- ", which is the element\n  currently selected for the drop part of the drag-and-drop operation."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-2" {
				- "immediate user selection"
			}
			- " changes as the user selects different elements\n  (either by pointing at them with a pointing device, or by selecting them in some other way). The\n  "
			a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element" {
				- "current target element"
			}
			- " changes when the "
			a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-3" {
				- "immediate user selection"
			}
			- "\n  changes, based on the results of event listeners in the document, as described below."
		}
		- "\n\n  "
		p {
			- "Both the "
			a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-2" {
				- "current target element"
			}
			- " and the "
			a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-4" {
				- "immediate user selection"
			}
			- " can\n  be null, which means no target element is selected. They can also both be elements in other\n  (DOM-based) documents, or other (non-web) programs altogether. (For example, a user could drag\n  text to a word-processor.) The "
			a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-3" {
				- "current target element"
			}
			- " is initially null."
		}
		- "\n\n  "
		p {
			- "In addition, there is also a "
			dfn id="current-drag-operation" {
				- "current drag operation"
			}
			- ", which can take on the values\n  \""
			dfn id="concept-current-drag-operation-none" {
				code {
					- "none"
				}
			}
			- "\", \""
			dfn id="concept-current-drag-operation-copy" {
				code {
					- "copy"
				}
			}
			- "\", \""
			dfn id="concept-current-drag-operation-link" {
				code {
					- "link"
				}
			}
			- "\", and \""
			dfn id="concept-current-drag-operation-move" {
				code {
					- "move"
				}
			}
			- "\". Initially, it has the value\n  \""
			code id="drag-and-drop-processing-model:concept-current-drag-operation-none" {
				a href="#concept-current-drag-operation-none" {
					- "none"
				}
			}
			- "\". It is updated by the user agent\n  as described in the steps below."
		}
		- "\n\n  "
		p {
			- "User agents must, as soon as the drag operation is "
			a href="#initiate-the-drag-and-drop-operation" id="drag-and-drop-processing-model:initiate-the-drag-and-drop-operation-2" {
				- "initiated"
			}
			- " and every 350ms (±200ms) thereafter for as long as the drag\n  operation is ongoing, "
			a href="#queue-a-task" id="drag-and-drop-processing-model:queue-a-task" {
				- "queue a task"
			}
			- " to perform the following steps in sequence:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the user agent is still performing the previous iteration of the sequence (if any) when\n    the next iteration becomes due, return for this iteration (effectively \"skipping\n    missed frames\" of the drag-and-drop operation)."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					a href="#fire-a-dnd-event" id="drag-and-drop-processing-model:fire-a-dnd-event-2" {
						- "Fire a DND event"
					}
					- " named "
					code id="drag-and-drop-processing-model:event-dnd-drag" {
						a href="#event-dnd-drag" {
							- "drag"
						}
					}
					- " at the\n    "
					a href="#source-node" id="drag-and-drop-processing-model:source-node-10" {
						- "source node"
					}
					- ". If this event is canceled, the user agent must set the "
					a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation" {
						- "current\n    drag operation"
					}
					- " to \""
					code id="drag-and-drop-processing-model:concept-current-drag-operation-none-2" {
						a href="#concept-current-drag-operation-none" {
							- "none"
						}
					}
					- "\" (no\n    drag operation)."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					code id="drag-and-drop-processing-model:event-dnd-drag-2" {
						a href="#event-dnd-drag" {
							- "drag"
						}
					}
					- " event was not canceled and the user has not\n    ended the drag-and-drop operation, check the state of the drag-and-drop operation, as\n    follows:"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If the user is indicating a different "
							a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-5" {
								- "immediate user selection"
							}
							- " than during the\n      last iteration (or if this is the first iteration), and if this "
							a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-6" {
								- "immediate user\n      selection"
							}
							- " is not the same as the "
							a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-4" {
								- "current target element"
							}
							- ", then update the\n      "
							a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-5" {
								- "current target element"
							}
							- " as follows:"
						}
						- "\n\n      "
						dl class="switch" {
							dt {
								- "If the new "
								a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-7" {
									- "immediate user selection"
								}
								- " is null"
							}
							dd {
								p {
									- "Set the "
									a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-6" {
										- "current target element"
									}
									- " to null also."
								}
							}
							dt {
								- "If the new "
								a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-8" {
									- "immediate user selection"
								}
								- " is in a non-DOM document or\n       application"
							}
							dd {
								p {
									- "Set the "
									a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-7" {
										- "current target element"
									}
									- " to the "
									a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-9" {
										- "immediate user\n       selection"
									}
									- "."
								}
							}
							dt {
								- "Otherwise"
							}
							dd {
								- "\n        "
								p {
									a href="#fire-a-dnd-event" id="drag-and-drop-processing-model:fire-a-dnd-event-3" {
										- "Fire a DND event"
									}
									- " named "
									code id="drag-and-drop-processing-model:event-dnd-dragenter" {
										a href="#event-dnd-dragenter" {
											- "dragenter"
										}
									}
									- "\n        at the "
									a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-10" {
										- "immediate user selection"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "If the event is canceled, then set the "
									a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-8" {
										- "current target element"
									}
									- " to the\n        "
									a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-11" {
										- "immediate user selection"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "Otherwise, run the appropriate step from the following list:"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										- "If the "
										a href="#immediate-user-selection" id="drag-and-drop-processing-model:immediate-user-selection-12" {
											- "immediate user selection"
										}
										- " is a text control (e.g.,\n         "
										code id="drag-and-drop-processing-model:the-textarea-element" {
											a href="#the-textarea-element" {
												- "textarea"
											}
										}
										- ", or an "
										code id="drag-and-drop-processing-model:the-input-element" {
											a href="#the-input-element" {
												- "input"
											}
										}
										- " element whose "
										code id="drag-and-drop-processing-model:attr-input-type" {
											a href="#attr-input-type" {
												- "type"
											}
										}
										- " attribute is in the "
										a href="#text-(type=text)-state-and-search-state-(type=search)" id="drag-and-drop-processing-model:text-(type=text)-state-and-search-state-(type=search)" {
											- "Text"
										}
										- " state) or an "
										a href="#editing-host" id="drag-and-drop-processing-model:editing-host" {
											- "editing host"
										}
										- " or\n         "
										a id="drag-and-drop-processing-model:editable" href="https://w3c.github.io/editing/docs/execCommand/#editable" data-x-internal="editable" {
											- "editable"
										}
										- " element, and the "
										a href="#drag-data-store-item-list" id="drag-and-drop-processing-model:drag-data-store-item-list-6" {
