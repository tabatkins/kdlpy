							- "http://microformats.org/profile/hcard"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vcard-uid" {
					code {
						- "uid"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives a globally unique identifier corresponding to the person or organization."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vcard:concept-property-value-69" {
						- "value"
					}
					- " must be text."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vcard:md-vcard-uid" {
						a href="#md-vcard-uid" {
							- "uid"
						}
					}
					- " may be present within\n    each "
					a href="#concept-item" id="vcard:concept-item-79" {
