					- " is \""
					code id="persisted-user-state-restoration:dom-scrollrestoration-auto" {
						a href="#dom-scrollrestoration-auto" {
							- "auto"
						}
					}
					- "\", and "
					var {
						- "entry"
					}
					- "'s\n    "
					a href="#she-document" id="persisted-user-state-restoration:she-document-2" {
						- "document"
					}
					- "'s "
					a href="#concept-relevant-global" id="persisted-user-state-restoration:concept-relevant-global" {
						- "relevant global object"
					}
					- "'s "
					a href="#window-navigation-api" id="persisted-user-state-restoration:window-navigation-api" {
						- "navigation API"
					}
					- "'s "
					a href="#suppress-normal-scroll-restoration-during-ongoing-navigation" id="persisted-user-state-restoration:suppress-normal-scroll-restoration-during-ongoing-navigation" {
						- "suppress normal scroll restoration\n    during ongoing navigation"
					}
					- " is false, then "
					a href="#restore-scroll-position-data" id="persisted-user-state-restoration:restore-scroll-position-data" {
						- "restore scroll position data"
					}
					- " given\n    "
					var {
						- "entry"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "The user agent not restoring scroll positions does not imply that scroll\n    positions will be left at any particular value (e.g., (0,0)). The actual scroll position depends\n    on the navigation type and the user agent's particular caching strategy. So web applications\n    cannot assume any particular scroll position but rather are urged to set it to what they want it\n    to be."
				}
				- "\n\n    "
				p class="note" {
					- "If "
					a href="#suppress-normal-scroll-restoration-during-ongoing-navigation" id="persisted-user-state-restoration:suppress-normal-scroll-restoration-during-ongoing-navigation-2" {
						- "suppress normal scroll restoration during ongoing navigation"
					}
					- " is\n    true, then "
					a href="#restore-scroll-position-data" id="persisted-user-state-restoration:restore-scroll-position-data-2" {
						- "restoring scroll position data"
					}
