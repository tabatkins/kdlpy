					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
					- "\ncustomElements"
					c- p="" {
						- "."
					}
					- "define"
					c- p="" {
						- "("
					}
					c- u="" {
						- "\"c-child\""
					}
					c- p="" {
						- ","
					}
					- " CChild"
					c- p="" {
						- ");"
					}
					- "\n\n"
					c- a="" {
						- "const"
					}
					- " parent "
					c- o="" {
						- "="
					}
					- " "
					c- k="" {
						- "new"
					}
					- " CParent"
					c- p="" {
						- "(),"
					}
					- "\n      child "
					c- o="" {
