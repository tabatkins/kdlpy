					}
				}
			}
			- "\n\n   "
			p {
				- "This creates a single item with a two name-value pairs, one with the name \"fn\" and the value\n   \"George Washington\", and the other with the name \"n\" and a second item as its value, the second\n   item having the two name-value pairs \"given-name\" and \"family-name\" with the values \"George\" and\n   \"Washington\" respectively. This is defined to map to the following vCard:"
			}
			- "\n\n   "
			pre {
				- "BEGIN:VCARD\nPROFILE:VCARD\nVERSION:4.0\nSOURCE:"
				var {
					- "document's address"
				}
				- "\nFN:George Washington\nN:Washington;George;;;\nEND:VCARD"
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h4 id="vevent" {
			span class="secno" {
				- "5.3.2"
			}
			- " vEvent"
			a href="#vevent" class="self-link"
		}
		- "\n\n  "
		p {
			- "An item with the "
			a href="#item-types" id="vevent:item-types" {
				- "item type"
			}
			- " "
			dfn id="md-vevent" {
				code {
					- "http://microformats.org/profile/hcalendar#vevent"
				}
			}
			- " represents\n  an event."
		}
		- "\n\n  "
		p {
			- "This vocabulary does not "
			a href="#support-global-identifiers-for-items" id="vevent:support-global-identifiers-for-items" {
				- "support global identifiers for items"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The following are the type's "
			a href="#defined-property-name" id="vevent:defined-property-name" {
				- "defined property\n  names"
			}
			- ". They are based on the vocabulary defined in "
			cite {
				- "Internet Calendaring and\n  Scheduling Core Object Specification"
			}
			- " ("
			cite {
				- "iCalendar"
			}
			- "), where more information on\n  how to interpret the values can be found. "
			a href="#refsRFC5545" {
				- "[RFC5545]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "Only the parts of the iCalendar vocabulary relating to events are used here; this\n  vocabulary cannot express a complete iCalendar instance."
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="md-vevent-attach" {
					code {
						- "attach"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the address of an associated document for the event."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value" {
						- "value"
					}
					- " must be an "
					a id="vevent:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
						- "absolute\n    URL"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vevent:md-vevent-attach" {
						a href="#md-vevent-attach" {
							- "attach"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-categories" {
					code {
						- "categories"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the name of a category or tag that the event could be classified as."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-2" {
						- "value"
					}
					- " must be text."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vevent:md-vevent-categories" {
						a href="#md-vevent-categories" {
							- "categories"
						}
					}
					- "\n    may be present within each "
					a href="#concept-item" id="vevent:concept-item-2" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-2" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-class" {
					code {
						- "class"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the access classification of the information regarding the event."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-3" {
						- "value"
					}
					- " must be text with one of the following\n    values:"
				}
				- "\n\n    "
				ul class="brief" {
					li {
						code {
							- "public"
						}
					}
					li {
						code {
							- "private"
						}
					}
					li {
						code {
							- "confidential"
						}
					}
				}
				- "\n\n    "
				p class="warning" {
					- "This is merely advisory and cannot be considered a confidentiality\n    measure."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-class" {
						a href="#md-vevent-class" {
							- "class"
						}
					}
					- " may be present\n    within each "
					a href="#concept-item" id="vevent:concept-item-3" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-3" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-comment" {
					code {
						- "comment"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives a comment regarding the event."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-4" {
						- "value"
					}
					- " must be text."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vevent:md-vevent-comment" {
						a href="#md-vevent-comment" {
							- "comment"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item-4" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-4" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-description" {
					code {
						- "description"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives a detailed description of the event."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-5" {
						- "value"
					}
					- " must be text."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-description" {
						a href="#md-vevent-description" {
							- "description"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item-5" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-5" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-geo" {
					code {
						- "geo"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the geographical position of the event."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-6" {
						- "value"
					}
					- " must be text and must match the\n    following syntax:"
				}
				- "\n\n    "
				ol {
					li {
						- "Optionally, either a U+002B PLUS SIGN character (+) or a U+002D HYPHEN-MINUS character\n     (-)."
					}
					li {
						- "One or more "
						a id="vevent:ascii-digits" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
							- "ASCII digits"
						}
						- "."
					}
					li {
						- "Optionally*, a U+002E FULL STOP character (.) followed by one or more "
						a id="vevent:ascii-digits-2" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
							- "ASCII\n     digits"
						}
						- "."
					}
					li {
						- "A U+003B SEMICOLON character (;)."
					}
					li {
						- "Optionally, either a U+002B PLUS SIGN character (+) or a U+002D HYPHEN-MINUS character\n     (-)."
					}
					li {
						- "One or more "
						a id="vevent:ascii-digits-3" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
							- "ASCII digits"
						}
						- "."
					}
					li {
						- "Optionally*, a U+002E FULL STOP character (.) followed by one or more "
