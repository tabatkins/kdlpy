					}
				}
				- "\n\n    "
				p class="note" {
					- "Even if this causes "
					a href="#dom-document-write" id="parsing-main-inforeign:dom-document-write" {
						- "new characters to be\n    inserted into the tokenizer"
					}
					- ", the parser will not be executed reentrantly, since the\n    "
					a href="#parser-pause-flag" id="parsing-main-inforeign:parser-pause-flag-2" {
						- "parser pause flag"
					}
					- " is true."
				}
				- "\n\n    "
				p {
					- "Decrement the parser's "
					a href="#script-nesting-level" id="parsing-main-inforeign:script-nesting-level-2" {
						- "script nesting level"
					}
					- " by one. If the parser's "
					a href="#script-nesting-level" id="parsing-main-inforeign:script-nesting-level-3" {
						- "script\n    nesting level"
					}
					- " is zero, then set the "
					a href="#parser-pause-flag" id="parsing-main-inforeign:parser-pause-flag-3" {
						- "parser pause flag"
					}
					- " to false."
				}
				- "\n\n    "
				p {
					- "Let the "
					a href="#insertion-point" id="parsing-main-inforeign:insertion-point-3" {
						- "insertion point"
					}
					- " have the value of the "
					var {
