					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-8" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p {
					- "Switch the tokenizer to the "
					a href="#plaintext-state" id="parsing-main-inbody:plaintext-state" {
						- "PLAINTEXT state"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "Once a start tag with the tag name \"plaintext\" has been seen, all remaining\n    tokens will be character tokens (and a final end-of-file token) because there is no way to\n    switch the tokenizer out of the "
					a href="#plaintext-state" id="parsing-main-inbody:plaintext-state-2" {
						- "PLAINTEXT state"
					}
					- ". However, as the tree builder\n    remains in its existing insertion mode, it might "
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-3" {
						- "reconstruct the active formatting\n    elements"
					}
					- " while processing those character tokens. This means that the parser can\n    insert other elements into the "
					code id="parsing-main-inbody:plaintext" {
						a href="#plaintext" {
							- "plaintext"
						}
					}
					- " element."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"button\""
			}
			dd {
				- "\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-31" {
