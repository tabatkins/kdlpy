							}
							- " with "
							var {
								- "response"
							}
							- " and\n     "
							var {
								- "bodyBytes"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The following algorithms are meant for internal use by this specification only as part of "
			a href="#fetch-a-module-script-tree" id="fetching-scripts:fetch-a-module-script-tree-3" {
				- "fetching an external module script graph"
			}
			- " or\n  other similar concepts above, and should not be used directly by other specifications."
