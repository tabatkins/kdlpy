												a href="#event-media-suspend" {
													- "suspend"
												}
											}
											- " at the element."
										}
									}
									li {
										p {
											a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-10" {
												- "Queue a media element task"
											}
											- " given the "
											a href="#media-element" id="loading-the-media-resource:media-element-38" {
												- "media element"
											}
											- " to set\n         the element's "
											a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-7" {
												- "delaying-the-load-event flag"
											}
											- " to false. This stops "
											a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-7" {
												- "delaying the load event"
											}
											- "."
										}
									}
									li {
										p {
											- "Wait for the task to be run."
										}
									}
									li {
										p {
											- "Wait for an "
											a id="loading-the-media-resource:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
												- "implementation-defined"
											}
											- " event (e.g., the user requesting\n         that the media element begin playback)."
										}
									}
									li {
										p {
											- "Set the element's "
											a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-8" {
												- "delaying-the-load-event flag"
											}
											- " back to true (this "
											a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-8" {
