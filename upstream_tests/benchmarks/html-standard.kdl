					- "\n\n     "
					p {
						- "The user agent will pick a width from the "
						code id="introduction-3:attr-img-sizes-5" {
							a href="#attr-img-sizes" {
								- "sizes"
							}
						}
						- "\n     attribute, using the first item with a "
						a id="introduction-3:media-condition" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
							- "<media-condition>"
