			dd {
				- "\n    "
				p {
					- "Adds a new closed subpath to the path representing the given rounded rectangle.\n    "
					var {
						- "radii"
					}
					- " is either a list of radii or a single radius representing the corners of the\n    rectangle in pixels. If a list is provided, the number and order of these radii function in the\n    same way as the CSS "
					a id="building-paths:'border-radius'" href="https://drafts.csswg.org/css-backgrounds/#propdef-border-radius" data-x-internal="'border-radius'" {
