						a href="#media-data" id="loading-the-media-resource:media-data-9" {
							- "media data"
						}
						- " has been fetched to\n     determine the duration of the "
						a href="#media-resource" id="loading-the-media-resource:media-resource-12" {
							- "media resource"
						}
