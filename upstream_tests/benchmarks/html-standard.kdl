					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "5.5+"
						}
					}
					hr
					span class="firefox_android yes" {
						span {
							- "Firefox Android"
						}
						span {
							- "4+"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "2+"
						}
					}
					span class="chrome_android yes" {
						span {
