				p {
					- "If the user agent's "
					a href="#volume-locked" id="user-interface:volume-locked" {
						- "volume locked"
					}
					- " is true, then return the system\n   volume."
				}
			}
			li {
				p {
					- "If the element's audio output is "
					a href="#concept-media-muted" id="user-interface:concept-media-muted-2" {
						- "muted"
					}
					- ", then\n   return zero."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "volume"
					}
					- " be the "
					a href="#concept-media-volume" id="user-interface:concept-media-volume-4" {
						- "playback\n   volume"
					}
					- " of the audio portions of the "
					a href="#media-element" id="user-interface:media-element-15" {
						- "media element"
					}
					- ", in range 0.0 (silent) to\n   1.0 (loudest)."
