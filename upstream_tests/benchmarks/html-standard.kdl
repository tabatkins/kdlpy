		- "\n\n  \n\n  "
		h5 id="script-structs" {
			span class="secno" {
				- "8.1.4.1"
			}
			- " "
			span id="definitions-2"
			- "Scripts"
			a href="#script-structs" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-script" data-export="" {
				- "script"
			}
			- " is one of two possible "
			a href="https://infra.spec.whatwg.org/#struct" id="script-structs:struct" data-x-internal="struct" {
				- "structs"
			}
			- " (namely, a "
			a href="#classic-script" id="script-structs:classic-script" {
				- "classic script"
			}
			- " or a\n  "
			a href="#module-script" id="script-structs:module-script" {
				- "module script"
			}
			- "). All scripts have:"
		}
		- "\n\n  "
		dl {
			dt {
				- "A "
				dfn data-dfn-for="script" id="settings-object" data-export="" {
					- "settings object"
				}
			}
			dd {
				p {
					- "An "
					a href="#environment-settings-object" id="script-structs:environment-settings-object" {
						- "environment settings object"
					}
					- ", containing various settings that are shared\n   with other "
					a href="#concept-script" id="script-structs:concept-script" {
						- "scripts"
					}
					- " in the same context."
				}
			}
			dt {
				- "A "
				dfn data-dfn-for="script" id="concept-script-record" data-export="" {
					- "record"
				}
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "a "
							a id="script-structs:script-record" href="https://tc39.es/ecma262/#sec-script-records" data-x-internal="script-record" {
								- "script record"
							}
							- ", for "
							a href="#classic-script" id="script-structs:classic-script-2" {
								- "classic\n     scripts"
							}
							- ";"
						}
					}
					li {
						p {
							- "a "
							a id="script-structs:source-text-module-record" href="https://tc39.es/ecma262/#sec-source-text-module-records" data-x-internal="source-text-module-record" {
								- "Source Text Module Record"
							}
							- ", for "
							a href="#javascript-module-script" id="script-structs:javascript-module-script" {
								- "JavaScript module scripts"
							}
							- ";"
						}
					}
					li {
						p {
							- "a "
							a id="script-structs:synthetic-module-record" href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" data-x-internal="synthetic-module-record" {
								- "Synthetic Module Record"
							}
							- ", for "
							a href="#css-module-script" id="script-structs:css-module-script" {
								- "CSS module\n     scripts"
							}
							- " and "
							a href="#json-module-script" id="script-structs:json-module-script" {
								- "JSON module scripts"
							}
							- ";"
						}
					}
					li {
						p {
							- "a "
							a id="script-structs:webassembly-module-record" href="https://webassembly.github.io/esm-integration/js-api/index.html#webassembly-module-record" data-x-internal="webassembly-module-record" {
								- "WebAssembly Module Record"
							}
							- ", for "
							a href="#webassembly-module-script" id="script-structs:webassembly-module-script" {
								- "WebAssembly module scripts"
							}
							- "; or"
						}
					}
					li {
						p {
							- "null, representing a parsing failure."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="script" id="concept-script-parse-error" {
					- "parse error"
				}
			}
			dd {
				- "\n    "
				p {
					- "A JavaScript value, which has meaning only if the "
					a href="#concept-script-record" id="script-structs:concept-script-record" {
						- "record"
					}
					- " is null, indicating that the corresponding script\n    source text could not be parsed."
				}
				- "\n\n    "
				p class="note" {
					- "This value is used for internal tracking of immediate parse errors when "
					a href="#creating-scripts" {
						- "creating scripts"
					}
					- ", and is not to be used directly. Instead, consult\n    the "
					a href="#concept-script-error-to-rethrow" id="script-structs:concept-script-error-to-rethrow" {
						- "error to rethrow"
					}
					- " when determining\n    \"what went wrong\" for this script."
				}
				- "\n  "
			}
			dt {
				- "An "
				dfn data-dfn-for="script" id="concept-script-error-to-rethrow" data-export="" {
					- "error\n   to rethrow"
				}
			}
			dd {
				- "\n    "
				p {
					- "A JavaScript value representing an error that will prevent evaluation from succeeding. It\n    will be re-thrown by any attempts to "
					a href="#calling-scripts" {
						- "run"
					}
					- " the script."
				}
				- "\n\n    "
				p class="note" {
					- "This could be the script's "
					a href="#concept-script-parse-error" id="script-structs:concept-script-parse-error" {
						- "parse\n    error"
					}
					- ", but in the case of a "
					a href="#module-script" id="script-structs:module-script-2" {
						- "module script"
					}
					- " it could instead be the\n    "
					a href="#concept-script-parse-error" id="script-structs:concept-script-parse-error-2" {
						- "parse error"
					}
					- " from one of its dependencies, or\n    an error from "
					a href="#resolve-a-module-specifier" id="script-structs:resolve-a-module-specifier" {
						- "resolve a module specifier"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "Since this exception value is provided by the JavaScript specification, we know\n    that it is never null, so we use null to signal that no error has occurred."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="script" id="concept-script-script-fetch-options" data-export="" {
					- "Fetch options"
				}
			}
			dd {
				- "Null or a "
				a href="#script-fetch-options" id="script-structs:script-fetch-options" {
					- "script fetch options"
				}
				- ", containing various options related to fetching\n   this script or "
				a href="#module-script" id="script-structs:module-script-3" {
					- "module scripts"
				}
				- " that it imports."
			}
			dt {
				- "A "
				dfn data-dfn-for="script" id="concept-script-base-url" data-export="" {
					- "base\n   URL"
				}
			}
			dd {
				p {
					- "Null or a base "
					a id="script-structs:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " used for "
					a href="#resolve-a-module-specifier" id="script-structs:resolve-a-module-specifier-2" {
						- "resolving module specifiers"
					}
					- ". When non-null, this will either be the URL from\n   which the script was obtained, for external scripts, or the "
					a href="#document-base-url" id="script-structs:document-base-url" {
						- "document base URL"
					}
					- " of the\n   containing document, for inline scripts."
				}
			}
		}
		- "\n\n\n  "
		p {
			- "A "
			dfn id="classic-script" data-export="" {
				- "classic script"
			}
			- " is a type of "
			a href="#concept-script" id="script-structs:concept-script-2" {
				- "script"
			}
			- "\n  that has the following additional "
			a href="https://infra.spec.whatwg.org/#struct-item" id="script-structs:struct-item" data-x-internal="struct-item" {
				- "item"
			}
			- ":"
		}
		- "\n\n  "
		dl {
			dt {
				- "A "
				dfn id="muted-errors" {
					- "muted errors"
				}
				- " boolean"
			}
			dd {
				p {
					- "A boolean which, if true, means that error information will not be provided for errors in\n   this script. This is used to mute errors for cross-origin scripts, since that can leak private\n   information."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="module-script" data-export="" {
				- "module script"
			}
			- " is another type of "
			a href="#concept-script" id="script-structs:concept-script-3" {
				- "script"
			}
			- ". It has no additional "
			a href="https://infra.spec.whatwg.org/#struct-item" id="script-structs:struct-item-2" data-x-internal="struct-item" {
				- "items"
			}
			- "."
		}
		- "\n\n  "
		p {
			a href="#module-script" id="script-structs:module-script-4" {
				- "Module scripts"
			}
			- " can be classified into four types:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					a href="#module-script" id="script-structs:module-script-5" {
						- "module script"
					}
					- " is a "
					dfn id="javascript-module-script" data-export="" {
						- "JavaScript module script"
					}
					- " if\n   its "
					a href="#concept-script-record" id="script-structs:concept-script-record-2" {
						- "record"
					}
					- " is a "
					a id="script-structs:source-text-module-record-2" href="https://tc39.es/ecma262/#sec-source-text-module-records" data-x-internal="source-text-module-record" {
						- "Source Text Module\n   Record"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "A "
					a href="#module-script" id="script-structs:module-script-6" {
						- "module script"
					}
					- " is a "
					dfn id="css-module-script" data-export="" {
						- "CSS module script"
					}
					- " if its "
					a href="#concept-script-record" id="script-structs:concept-script-record-3" {
						- "record"
					}
					- " is a "
					a id="script-structs:synthetic-module-record-2" href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" data-x-internal="synthetic-module-record" {
						- "Synthetic Module Record"
					}
					- ", and it\n    was created via the "
					a href="#creating-a-css-module-script" id="script-structs:creating-a-css-module-script" {
						- "create a CSS module\n    script"
					}
					- " algorithm. CSS module scripts represent a parsed CSS stylesheet."
				}
				- "\n\n    \n   "
			}
			li {
				- "\n    "
				p {
					- "A "
					a href="#module-script" id="script-structs:module-script-7" {
						- "module script"
					}
					- " is a "
					dfn id="json-module-script" data-export="" {
						- "JSON module script"
					}
					- " if its "
					a href="#concept-script-record" id="script-structs:concept-script-record-4" {
						- "record"
					}
					- " is a "
					a id="script-structs:synthetic-module-record-3" href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" data-x-internal="synthetic-module-record" {
						- "Synthetic Module Record"
					}
					- ", and it\n    was created via the "
					a href="#creating-a-json-module-script" id="script-structs:creating-a-json-module-script" {
						- "create a JSON module\n    script"
					}
					- " algorithm. JSON module scripts represent a parsed JSON document."
				}
				- "\n\n    \n   "
			}
			li {
				- "\n    "
				p {
					- "A "
					a href="#module-script" id="script-structs:module-script-8" {
						- "module script"
					}
					- " is a "
					dfn id="webassembly-module-script" data-export="" {
						- "WebAssembly module script"
					}
					- " if\n    its "
					a href="#concept-script-record" id="script-structs:concept-script-record-5" {
						- "record"
					}
					- " is a "
					a id="script-structs:webassembly-module-record-2" href="https://webassembly.github.io/esm-integration/js-api/index.html#webassembly-module-record" data-x-internal="webassembly-module-record" {
						- "WebAssembly Module\n    Record"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p class="note" {
			- "As CSS stylesheets and JSON documents do not import dependent modules, and do not\n  throw exceptions on evaluation, the "
			a href="#concept-script-script-fetch-options" id="script-structs:concept-script-script-fetch-options" {
				- "fetch\n  options"
			}
			- " and "
			a href="#concept-script-base-url" id="script-structs:concept-script-base-url" {
				- "base URL"
			}
			- " of "
			a href="#css-module-script" id="script-structs:css-module-script-2" {
				- "CSS module scripts"
			}
			- " and "
			a href="#json-module-script" id="script-structs:json-module-script-2" {
				- "JSON module\n  scripts"
			}
			- " and are always null."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="active-script" {
				- "active script"
			}
			- " is determined by the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "record"
					}
					- " be "
					a id="script-structs:getactivescriptormodule" href="https://tc39.es/ecma262/#sec-getactivescriptormodule" data-x-internal="getactivescriptormodule" {
						- "GetActiveScriptOrModule"
					}
					- "()."
				}
			}
			li {
				p {
					- "If "
					var {
						- "record"
					}
					- " is null, return null."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "record"
					}
					- ".[[HostDefined]]."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#active-script" id="script-structs:active-script" {
				- "active script"
			}
			- " concept is so far only used by the\n  "
			code id="script-structs:import()" {
				a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" {
					- "import()"
				}
			}
			- " feature, to determine the "
			a href="#concept-script-base-url" id="script-structs:concept-script-base-url-2" {
				- "base\n  URL"
			}
			- " to use for resolving relative module specifiers."
		}
		- "\n\n  "
		h5 id="fetching-scripts" {
			span class="secno" {
				- "8.1.4.2"
			}
			- " Fetching scripts"
			a href="#fetching-scripts" class="self-link"
		}
		- "\n\n  "
		p {
			- "This section introduces a number of algorithms for fetching scripts, taking various necessary\n  inputs and resulting in "
			a href="#classic-script" id="fetching-scripts:classic-script" {
				- "classic"
			}
			- " or "
			a href="#module-script" id="fetching-scripts:module-script" {
				- "module scripts"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			dfn id="script-fetch-options" {
				- "Script fetch options"
			}
			- " is a "
			a id="fetching-scripts:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="fetching-scripts:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="concept-script-fetch-options-nonce" {
					- "cryptographic nonce"
				}
			}
			dd {
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#concept-request-nonce-metadata" id="fetching-scripts:concept-request-nonce-metadata" data-x-internal="concept-request-nonce-metadata" {
						- "cryptographic nonce metadata"
					}
					- " used\n   for the initial fetch and for fetching any imported modules"
				}
			}
			dt {
				dfn id="concept-script-fetch-options-integrity" {
					- "integrity metadata"
				}
			}
			dd {
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#concept-request-integrity-metadata" id="fetching-scripts:concept-request-integrity-metadata" data-x-internal="concept-request-integrity-metadata" {
						- "integrity metadata"
					}
					- " used for\n   the initial fetch"
				}
			}
			dt {
				dfn id="concept-script-fetch-options-parser" {
					- "parser metadata"
				}
			}
			dd {
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#concept-request-parser-metadata" id="fetching-scripts:concept-request-parser-metadata" data-x-internal="concept-request-parser-metadata" {
						- "parser metadata"
					}
					- " used for the\n   initial fetch and for fetching any imported modules"
				}
			}
			dt {
				dfn id="concept-script-fetch-options-credentials" {
					- "credentials mode"
				}
			}
			dd {
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#concept-request-credentials-mode" id="fetching-scripts:concept-request-credentials-mode" data-x-internal="concept-request-credentials-mode" {
						- "credentials mode"
					}
					- " used for the\n   initial fetch (for "
					a href="#module-script" id="fetching-scripts:module-script-2" {
						- "module scripts"
					}
					- ") and for fetching any\n   imported modules (for both "
					a href="#module-script" id="fetching-scripts:module-script-3" {
						- "module scripts"
					}
					- " and "
					a href="#classic-script" id="fetching-scripts:classic-script-2" {
						- "classic scripts"
					}
					- ")"
				}
			}
			dt {
				dfn id="concept-script-fetch-options-referrer-policy" {
					- "referrer policy"
				}
			}
			dd {
				- "\n    "
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#concept-request-referrer-policy" id="fetching-scripts:concept-request-referrer-policy" data-x-internal="concept-request-referrer-policy" {
						- "referrer policy"
					}
					- " used for the\n    initial fetch and for fetching any imported modules"
				}
				- "\n\n    "
				p class="note" {
					- "This policy can mutate after a "
					a href="#module-script" id="fetching-scripts:module-script-4" {
						- "module script"
					}
					- "'s "
					a href="https://fetch.spec.whatwg.org/#concept-response" id="fetching-scripts:concept-response" data-x-internal="concept-response" {
						- "response"
					}
					- " is received, to be the "
					a id="fetching-scripts:referrer-policy" href="https://w3c.github.io/webappsec-referrer-policy/#referrer-policy" data-x-internal="referrer-policy" {
						- "referrer policy"
					}
					- "\n    "
					a href="https://w3c.github.io/webappsec-referrer-policy/#parse-referrer-policy-from-header" id="fetching-scripts:parse-referrer-policy-header" data-x-internal="parse-referrer-policy-header" {
						- "parsed"
					}
					- " from the "
					a href="https://fetch.spec.whatwg.org/#concept-response" id="fetching-scripts:concept-response-2" data-x-internal="concept-response" {
						- "response"
					}
					- ", and used when fetching any module dependencies."
				}
				- "\n   "
			}
			dt {
				dfn id="concept-script-fetch-options-render-blocking" {
					- "render-blocking"
				}
			}
			dd {
				p {
					- "The boolean value of "
					a href="https://fetch.spec.whatwg.org/#request-render-blocking" id="fetching-scripts:concept-request-render-blocking" data-x-internal="concept-request-render-blocking" {
						- "render-blocking"
					}
					- "\n   used for the initial fetch and for fetching any imported modules. Unless otherwise stated, its\n   value is false."
				}
			}
			dt {
				dfn id="concept-script-fetch-options-fetch-priority" {
					- "fetch priority"
				}
			}
			dd {
				p {
					- "The "
					a href="https://fetch.spec.whatwg.org/#request-priority" id="fetching-scripts:concept-request-priority" data-x-internal="concept-request-priority" {
						- "priority"
					}
					- " used for the\n   initial fetch"
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "Recall that via the "
			code id="fetching-scripts:import()" {
				a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" {
					- "import()"
				}
			}
			- " feature, "
			a href="#classic-script" id="fetching-scripts:classic-script-3" {
				- "classic scripts"
			}
			- " can import "
			a href="#module-script" id="fetching-scripts:module-script-5" {
				- "module scripts"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="default-script-fetch-options" {
				- "default script fetch options"
			}
			- " are a "
			a href="#script-fetch-options" id="fetching-scripts:script-fetch-options" {
				- "script fetch options"
			}
			- " whose "
			a href="#concept-script-fetch-options-nonce" id="fetching-scripts:concept-script-fetch-options-nonce" {
				- "cryptographic nonce"
			}
			- " is the empty string, "
			a href="#concept-script-fetch-options-integrity" id="fetching-scripts:concept-script-fetch-options-integrity" {
				- "integrity metadata"
			}
			- " is the empty string,\n  "
			a href="#concept-script-fetch-options-parser" id="fetching-scripts:concept-script-fetch-options-parser" {
				- "parser metadata"
			}
			- " is \""
			code {
				- "not-parser-inserted"
			}
			- "\", "
			a href="#concept-script-fetch-options-credentials" id="fetching-scripts:concept-script-fetch-options-credentials" {
				- "credentials mode"
			}
			- " is \""
			code {
