						- "Assert"
					}
					- ": "
					var {
						- "window"
					}
					- "'s "
					a href="#concept-document-window" id="close-watcher-infrastructure:concept-document-window" {
						- "associated "
						code {
							- "Document"
						}
					}
					- " is "
					a href="#fully-active" id="close-watcher-infrastructure:fully-active" {
						- "fully\n   active"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "closeWatcher"
					}
					- " be a new "
					a href="#close-watcher" id="close-watcher-infrastructure:close-watcher-5" {
						- "close watcher"
					}
					- ", with"
				}
				- "\n\n    "
				dl class="props" {
					dt {
						a href="#close-watcher-window" id="close-watcher-infrastructure:close-watcher-window-2" {
							- "window"
						}
					}
					dd {
						var {
							- "window"
						}
					}
