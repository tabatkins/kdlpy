		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="Document" id="dom-document-lastmodified" data-dfn-type="attribute" {
				code {
					- "lastModified"
				}
			}
			- " attribute, on getting, must return\n  the date and time of the "
			code id="resource-metadata-management:document-8" {
