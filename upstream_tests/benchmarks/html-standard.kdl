						- "\n\n      "
						ul {
							li {
								- "is between the end of the list and the last "
								a href="#concept-parser-marker" id="parsing-main-inbody:concept-parser-marker-4" {
									- "marker"
								}
								- " in the list, if any, or the start of the list\n       otherwise, and"
							}
							li {
								- "has the tag name "
								var {
									- "subject"
								}
								- "."
							}
						}
						- "\n\n      "
						p {
							- "If there is no such element, then return and instead act as described in the \"any other end\n      tag\" entry above."
						}
						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "formattingElement"
							}
							- " is not in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-67" {
								- "stack of open elements"
							}
							- ", then\n     this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-42" {
								- "parse error"
							}
							- "; remove the element from the list, and return."
						}
					}
					li {
						p {
							- "If "
							var {
								- "formattingElement"
							}
							- " is in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-68" {
								- "stack of open elements"
							}
							- ", but the\n     element is not "
							a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-13" {
								- "in scope"
							}
							- ", then this is a\n     "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-43" {
								- "parse error"
							}
							- "; return."
						}
					}
					li {
						p {
							- "If "
							var {
								- "formattingElement"
							}
							- " is not the "
							a href="#current-node" id="parsing-main-inbody:current-node-33" {
								- "current node"
							}
							- ", this is a\n     "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-44" {
								- "parse error"
							}
							- ". (But do not return.)"
						}
					}
					li {
						p {
							- "Let "
							var {
								- "furthestBlock"
							}
							- " be the topmost node in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-69" {
								- "stack of open\n     elements"
							}
							- " that is lower in the stack than "
							var {
								- "formattingElement"
							}
							- ", and is an\n     element in the "
							a href="#special" id="parsing-main-inbody:special-4" {
								- "special"
							}
							- " category. There might not be one."
						}
					}
					li {
						p {
							- "If there is no "
							var {
								- "furthestBlock"
							}
							- ", then the UA must first pop all the nodes from\n     the bottom of the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-70" {
								- "stack of open elements"
							}
							- ", from the "
							a href="#current-node" id="parsing-main-inbody:current-node-34" {
								- "current node"
							}
							- " up to\n     and including "
							var {
								- "formattingElement"
							}
							- ", then remove "
							var {
								- "formattingElement"
							}
							- " from the\n     "
							a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-6" {
								- "list of active formatting elements"
							}
							- ", and finally return."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "commonAncestor"
							}
							- " be the element immediately above\n     "
							var {
								- "formattingElement"
							}
							- " in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-71" {
								- "stack of open elements"
							}
							- "."
						}
					}
					li {
						p {
							- "Let a bookmark note the position of "
							var {
								- "formattingElement"
							}
							- " in the "
							a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-7" {
								- "list of\n     active formatting elements"
							}
							- " relative to the elements on either side of it in the\n     list."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "node"
							}
							- " and "
							var {
								- "lastNode"
							}
							- " be "
							var {
								- "furthestBlock"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "innerLoopCounter"
							}
							- " be 0."
						}
					}
					li {
						- "\n      "
						p {
							- "While true:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Increment "
									var {
										- "innerLoopCounter"
									}
									- " by 1."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "node"
									}
									- " be the element immediately above "
									var {
										- "node"
									}
									- " in the\n       "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-72" {
										- "stack of open elements"
									}
									- ", or if "
									var {
										- "node"
									}
									- " is no longer in the "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-73" {
										- "stack of\n       open elements"
									}
									- " (e.g. because it got removed by this algorithm), the element that was immediately above "
									var {
										- "node"
									}
									- " in\n       the "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-74" {
										- "stack of open elements"
									}
									- " before "
									var {
										- "node"
									}
									- " was removed."
								}
							}
							li {
								p {
									- "If "
									var {
										- "node"
									}
									- " is "
									var {
										- "formattingElement"
									}
									- ", then "
									a id="parsing-main-inbody:break" href="https://infra.spec.whatwg.org/#iteration-break" data-x-internal="break" {
										- "break"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "innerLoopCounter"
									}
									- " is greater than 3 and "
									var {
										- "node"
									}
									- " is in the\n       "
									a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-8" {
										- "list of active formatting elements"
									}
									- ", then remove "
									var {
										- "node"
									}
									- " from the\n       "
									a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-9" {
										- "list of active formatting elements"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "node"
									}
									- " is not in the "
									a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-10" {
										- "list of active\n       formatting elements"
									}
									- ", then remove "
									var {
										- "node"
									}
									- " from the "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-75" {
										- "stack of open\n       elements"
