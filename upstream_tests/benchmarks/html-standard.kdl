		- "\n\n\n  "
		h5 id="conversion-to-vcard" {
			span class="secno" {
				- "5.3.1.1"
			}
			- " Conversion to vCard"
			a href="#conversion-to-vcard" class="self-link"
		}
		- "\n\n  "
		p {
			- "Given a list of nodes "
			var {
				- "nodes"
			}
			- " in a "
			code id="conversion-to-vcard:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ", a user agent must\n  run the following algorithm to "
			dfn id="extracting-a-vcard" {
				- "extract any vCard data represented\n  by those nodes"
			}
			- " (only the first vCard is returned):"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If none of the nodes in "
					var {
						- "nodes"
					}
					- " are "
					a href="#concept-item" id="conversion-to-vcard:concept-item" {
						- "items"
					}
					- " with the "
					a href="#item-types" id="conversion-to-vcard:item-types" {
						- "item type"
					}
					- " "
					code id="conversion-to-vcard:md-vcard" {
						a href="#md-vcard" {
							- "http://microformats.org/profile/hcard"
						}
					}
					- ", then there is no vCard. Abort the\n   algorithm, returning nothing."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "node"
					}
					- " be the first node in "
					var {
						- "nodes"
					}
					- " that is an\n   "
					a href="#concept-item" id="conversion-to-vcard:concept-item-2" {
						- "item"
					}
					- " with the "
					a href="#item-types" id="conversion-to-vcard:item-types-2" {
						- "item type"
					}
					- " "
					code id="conversion-to-vcard:md-vcard-2" {
						a href="#md-vcard" {
							- "http://microformats.org/profile/hcard"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "output"
					}
					- " be an empty string."
				}
			}
			li {
				p {
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line" {
						- "Add a vCard line"
					}
					- " with the type \""
					code {
						- "BEGIN"
					}
					- "\" and the value\n   \""
					code {
						- "VCARD"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-2" {
						- "Add a vCard line"
					}
					- " with the type \""
					code {
						- "PROFILE"
					}
					- "\" and the value\n   \""
					code {
						- "VCARD"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-3" {
						- "Add a vCard line"
					}
					- " with the type \""
					code {
						- "VERSION"
					}
					- "\" and the value\n   \""
					code {
						- "4.0"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-4" {
						- "Add a vCard line"
					}
					- " with the type \""
					code {
						- "SOURCE"
					}
					- "\" and the result\n   of "
					a href="#escaping-the-vcard-text-string" id="conversion-to-vcard:escaping-the-vcard-text-string" {
						- "escaping the vCard text string"
					}
					- " that is the document's "
					a href="https://dom.spec.whatwg.org/#concept-document-url" id="conversion-to-vcard:the-document's-address" data-x-internal="the-document's-address" {
						- "URL"
					}
					- " as the value to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					a href="#the-title-element-2" id="conversion-to-vcard:the-title-element-2" {
						- "the "
						code {
							- "title"
						}
						- " element"
					}
					- " is not null, "
					a href="#add-a-vcard-line" id="conversion-to-vcard:add-a-vcard-line-5" {
						- "add a vCard line"
					}
					- "\n   with the type \""
					code {
						- "NAME"
					}
					- "\" and with the result of "
					a href="#escaping-the-vcard-text-string" id="conversion-to-vcard:escaping-the-vcard-text-string-2" {
						- "escaping the vCard text\n   string"
					}
					- " obtained from "
					a href="#the-title-element-2" id="conversion-to-vcard:the-title-element-2-2" {
						- "the "
						code {
							- "title"
						}
						- " element"
					}
					- "'s "
					a id="conversion-to-vcard:descendant-text-content" href="https://dom.spec.whatwg.org/#concept-descendant-text-content" data-x-internal="descendant-text-content" {
						- "descendant\n   text content"
					}
					- " as the value to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "sex"
					}
					- " be the empty string."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "gender-identity"
					}
					- " be the empty string."
				}
			}
			li {
				- "\n    "
				p {
					- "For each element "
					var {
						- "element"
					}
					- " that is "
					a href="#the-properties-of-an-item" id="conversion-to-vcard:the-properties-of-an-item" {
						- "a property of the item"
					}
					- " "
					var {
						- "node"
					}
					- ": for each name "
					var {
						- "name"
					}
					- " in "
					var {
						- "element"
					}
					- "'s "
					a href="#property-names" id="conversion-to-vcard:property-names" {
						- "property names"
					}
					- ", run the\n    following substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "parameters"
							}
							- " be an empty set of name-value pairs."
						}
					}
					li {
						- "\n      "
						p {
							- "Run the appropriate set of substeps from the following list. The steps will set a variable\n      "
							var {
								- "value"
							}
							- ", which is used in the next step."
						}
						- "\n\n      "
						dl {
							dt {
								- "If the property's "
								a href="#concept-property-value" id="conversion-to-vcard:concept-property-value" {
									- "value"
								}
								- " is an "
								a href="#concept-item" id="conversion-to-vcard:concept-item-3" {
									- "item"
								}
								- " "
								var {
									- "subitem"
								}
								- " and "
								var {
									- "name"
								}
								- " is\n       "
								code id="conversion-to-vcard:md-vcard-n" {
									a href="#md-vcard-n" {
										- "n"
									}
								}
							}
							dd {
								- "\n        "
								ol {
									li {
										p {
											- "Let "
											var {
												- "value"
											}
											- " be the empty string."
										}
									}
									li {
										p {
											- "Append to "
											var {
												- "value"
											}
											- " the result of "
											a href="#collecting-the-first-vcard-subproperty" id="conversion-to-vcard:collecting-the-first-vcard-subproperty" {
												- "collecting the first vCard\n         subproperty"
											}
											- " named "
