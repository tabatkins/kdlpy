						- "\n\n      "
						p {
							- "(See the table below for descriptions of these values.)"
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The following, in the given order:"
						}
						- "\n\n      "
						ol {
							li {
								- "\n        "
								p {
									- "Optionally, a token that is an "
									a id="autofilling-form-controls:-the-autocomplete-attribute:ascii-case-insensitive-6" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
										- "ASCII case-insensitive"
									}
									- " match for one of the\n        following strings:"
								}
								- "\n\n        "
								ul class="brief" {
									li {
										- "\""
										dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-home" data-dfn-type="attr-value" {
											code {
												- "home"
											}
										}
										- "\", meaning the field is for contacting\n         someone at their residence\n\n         "
									}
									li {
										- "\""
										dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-work" data-dfn-type="attr-value" {
											code {
												- "work"
											}
										}
										- "\", meaning the field is for contacting\n         someone at their workplace\n\n         "
									}
									li {
										- "\""
										dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-mobile" data-dfn-type="attr-value" {
											code {
												- "mobile"
											}
										}
										- "\", meaning the\n         field is for contacting someone regardless of location\n\n         "
									}
									li {
										- "\""
										dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-fax" data-dfn-type="attr-value" {
											code {
												- "fax"
											}
										}
										- "\", meaning the field describes a fax\n         machine's contact details\n\n         "
									}
									li {
										- "\""
										dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-pager" data-dfn-type="attr-value" {
											code {
												- "pager"
											}
										}
										- "\", meaning the field describes a\n         pager's or beeper's contact details\n        "
									}
								}
								- "\n       "
							}
							li {
								- "\n        "
								p {
									- "A token that is an "
									a id="autofilling-form-controls:-the-autocomplete-attribute:ascii-case-insensitive-7" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
										- "ASCII case-insensitive"
									}
									- " match for one of the following\n        "
									a href="#autofill-field" id="autofilling-form-controls:-the-autocomplete-attribute:autofill-field-2" {
										- "autofill field"
									}
									- " names, excluding those that are "
									a href="#inappropriate-for-the-control" id="autofilling-form-controls:-the-autocomplete-attribute:inappropriate-for-the-control-2" {
										- "inappropriate for the\n        control"
									}
									- ":"
								}
								- "\n\n        "
								ul class="brief" {
									li {
										- "\""
										code id="autofilling-form-controls:-the-autocomplete-attribute:attr-fe-autocomplete-tel" {
											a href="#attr-fe-autocomplete-tel" {
												- "tel"
											}
										}
										- "\"\n         "
									}
									li {
