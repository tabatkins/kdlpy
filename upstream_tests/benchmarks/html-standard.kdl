										- "type"
									}
									c- o="" {
										- "="
									}
									c- s="" {
										- "number"
									}
									- " "
									c- e="" {
										- "min"
									}
									c- o="" {
										- "="
									}
									c- s="" {
										- "0"
									}
									- " "
									c- e="" {
										- "max"
									}
									c- o="" {
