					- "."
				}
				- "\n\n    "
				p {
					- "Once the animation has ended, the user agent is expected to "
					a href="#increment-the-marquee-current-loop-index" id="the-marquee-element-2:increment-the-marquee-current-loop-index-3" {
						- "increment the marquee\n    current loop index"
					}
					- ". If the element is still "
					a href="#concept-marquee-on" id="the-marquee-element-2:concept-marquee-on-4" {
						- "turned\n    on"
					}
					- " after this, then the user agent is expected to continue the animation."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-marquee-element-2:attr-marquee-direction-8" {
				a href="#attr-marquee-direction" {
					- "direction"
				}
			}
			- " attribute has the meanings described\n  in the following table:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						code id="the-marquee-element-2:attr-marquee-direction-9" {
