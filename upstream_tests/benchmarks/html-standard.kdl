						}
					}
					- "\" navigations, and will survive reloads and\n    session restores."
				}
				- "\n\n    "
				p {
					- "This is useful for navigating back to this entry in the navigation history list, using "
					code id="the-navigationhistoryentry-interface:dom-navigation-traverseto" {
						a href="#dom-navigation-traverseto" {
							- "navigation.traverseTo(key)"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "entry"
					}
					- "."
					a href="#dom-navigationhistoryentry-id" id="dom-navigationhistoryentry-id-dev" {
						- "id"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "A user agent-generated random UUID string representing this specific navigation history\n    entry. This value will "
					em {
						- "not"
					}
					- " be reused by other "
					code id="the-navigationhistoryentry-interface:navigationhistoryentry-3" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- "\n    instances. This value will survive reloads and session restores."
				}
				- "\n\n    "
				p {
					- "This is useful for associating data with this navigation history entry using other storage\n    APIs."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "entry"
					}
					- "."
					a href="#dom-navigationhistoryentry-index" id="dom-navigationhistoryentry-index-dev" {
						- "index"
					}
				}
			}
			dd {
				p {
					- "The index of this "
					code id="the-navigationhistoryentry-interface:navigationhistoryentry-4" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- " within "
					code id="the-navigationhistoryentry-interface:dom-navigation-entries" {
