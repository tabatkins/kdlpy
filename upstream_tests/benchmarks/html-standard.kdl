					- "attr"
				}
				- "-associated elements object"
			}
			- " are to be\n  treated as internal implementation details and not to be built upon."
		}
		- "\n\n  \n\n  "
		h4 id="collections" {
			span class="secno" {
				- "2.6.3"
			}
			- " Collections"
			a href="#collections" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="collections:htmlformcontrolscollection" {
				a href="#htmlformcontrolscollection" {
					- "HTMLFormControlsCollection"
				}
			}
			- " and "
			code id="collections:htmloptionscollection" {
				a href="#htmloptionscollection" {
					- "HTMLOptionsCollection"
				}
			}
			- " interfaces\n  are "
			a href="https://dom.spec.whatwg.org/#concept-collection" id="collections:concept-collection" data-x-internal="concept-collection" {
				- "collections"
			}
			- " derived from the\n  "
			code id="collections:htmlcollection" {
				a data-x-internal="htmlcollection" href="https://dom.spec.whatwg.org/#interface-htmlcollection" {
					- "HTMLCollection"
				}
			}
			- " interface. The "
			code id="collections:htmlallcollection" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " interface is a "
			a href="https://dom.spec.whatwg.org/#concept-collection" id="collections:concept-collection-2" data-x-internal="concept-collection" {
				- "collection"
			}
			- ", but is not so derived."
		}
		- "\n\n\n  "
		h5 id="the-htmlallcollection-interface" {
			span class="secno" {
				- "2.6.3.1"
			}
			- " The "
			code id="the-htmlallcollection-interface:htmlallcollection" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " interface"
			a href="#the-htmlallcollection-interface" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-htmlallcollection-interface:htmlallcollection-2" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " interface is used for the legacy "
			code id="the-htmlallcollection-interface:dom-document-all" {
				a href="#dom-document-all" {
					- "document.all"
				}
			}
			- " attribute. It operates similarly to\n  "
			code id="the-htmlallcollection-interface:htmlcollection" {
				a data-x-internal="htmlcollection" href="https://dom.spec.whatwg.org/#interface-htmlcollection" {
					- "HTMLCollection"
				}
			}
			- "; the main differences are that it allows a staggering variety of\n  different (ab)uses of its methods to all end up returning something, and that it can be called as\n  a function as an alternative to property access."
		}
		- "\n\n  "
		p class="note" {
			- "All "
			code id="the-htmlallcollection-interface:htmlallcollection-3" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " objects are rooted at a "
			code id="the-htmlallcollection-interface:document" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  and have a filter that matches all elements, so the elements "
			a id="the-htmlallcollection-interface:represented-by-the-collection" href="https://dom.spec.whatwg.org/#represented-by-the-collection" data-x-internal="represented-by-the-collection" {
				- "represented by the\n  collection"
			}
			- " of an "
			code id="the-htmlallcollection-interface:htmlallcollection-4" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " object consist of all the descendant\n  elements of the root "
			code id="the-htmlallcollection-interface:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Objects that implement the "
			code id="the-htmlallcollection-interface:htmlallcollection-5" {
				a href="#htmlallcollection" {
					- "HTMLAllCollection"
				}
			}
			- " interface are "
			a href="https://webidl.spec.whatwg.org/#dfn-legacy-platform-object" id="the-htmlallcollection-interface:legacy-platform-object" data-x-internal="legacy-platform-object" {
				- "legacy platform objects"
			}
			- " with an additional [[Call]] internal\n  method described in the "
			a href="#HTMLAllCollection-call" {
				- "section below"
			}
			- ". They also have an\n  "
			a id="the-htmlallcollection-interface:ishtmldda" href="https://tc39.es/ecma262/#sec-IsHTMLDDA-internal-slot" data-x-internal="ishtmldda" {
				- "[[IsHTMLDDA]]"
			}
			- " internal slot."
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "Objects that implement the "
				code id="the-htmlallcollection-interface:htmlallcollection-6" {
					a href="#htmlallcollection" {
						- "HTMLAllCollection"
					}
				}
				- " interface have several unusual\n   behaviors, due of the fact that they have an "
				a id="the-htmlallcollection-interface:ishtmldda-2" href="https://tc39.es/ecma262/#sec-IsHTMLDDA-internal-slot" data-x-internal="ishtmldda" {
					- "[[IsHTMLDDA]]"
				}
				- " internal slot:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "The "
						a href="https://tc39.es/ecma262/#sec-toboolean" id="the-htmlallcollection-interface:js-toboolean" data-x-internal="js-toboolean" {
							- "ToBoolean"
						}
						- " abstract operation in JavaScript returns\n    false when given objects implementing the "
						code id="the-htmlallcollection-interface:htmlallcollection-7" {
							a href="#htmlallcollection" {
								- "HTMLAllCollection"
							}
						}
						- " interface."
					}
				}
				li {
					p {
						- "The "
						a href="https://tc39.es/ecma262/#sec-islooselyequal" id="the-htmlallcollection-interface:js-abstract-equality" data-x-internal="js-abstract-equality" {
							- "IsLooselyEqual"
						}
						- " abstract operation,\n    when given objects implementing the "
						code id="the-htmlallcollection-interface:htmlallcollection-8" {
							a href="#htmlallcollection" {
								- "HTMLAllCollection"
							}
						}
						- " interface, returns true when\n    compared to the "
						code {
							- "undefined"
						}
						- " and "
						code {
							- "null"
						}
						- " values.\n    (Comparisons using the "
						a href="https://tc39.es/ecma262/#sec-isstrictlyequal" id="the-htmlallcollection-interface:js-strict-equality" data-x-internal="js-strict-equality" {
							- "IsStrictlyEqual"
						}
						- " abstract\n    operation, and IsLooselyEqual comparisons to other values such as strings or objects, are\n    unaffected.)"
					}
				}
				li {
					p {
						- "The "
						code id="the-htmlallcollection-interface:js-typeof" {
							a data-x-internal="js-typeof" href="https://tc39.es/ecma262/#sec-typeof-operator" {
								- "typeof"
							}
						}
						- " operator in JavaScript returns the string\n    "
						code {
							- "\"undefined\""
						}
						- " when applied to objects implementing the\n    "
						code id="the-htmlallcollection-interface:htmlallcollection-9" {
							a href="#htmlallcollection" {
								- "HTMLAllCollection"
							}
						}
						- " interface."
					}
				}
			}
			- "\n\n   "
			p {
				- "These special behaviors are motivated by a desire for compatibility with two classes of legacy\n   content: one that uses the presence of "
				code id="the-htmlallcollection-interface:dom-document-all-2" {
					a href="#dom-document-all" {
						- "document.all"
					}
				}
				- " as a\n   way to detect legacy user agents, and one that only supports those legacy user agents and uses\n   the "
				code id="the-htmlallcollection-interface:dom-document-all-3" {
					a href="#dom-document-all" {
						- "document.all"
					}
				}
				- " object without testing for its presence\n   first. "
				a href="#refsJAVASCRIPT" {
					- "[JAVASCRIPT]"
				}
			}
			- "\n  "
		}
		- "\n\n  "
		pre {
