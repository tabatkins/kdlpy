						- "key"
					}
					- " to "
					var {
						- "origin"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, if "
					var {
						- "group"
					}
					- "'s "
					a href="#historical-agent-cluster-key-map" id="integration-with-the-javascript-agent-cluster-formalism:historical-agent-cluster-key-map" {
						- "historical agent cluster key\n   map"
					}
					- "["
					var {
						- "origin"
					}
					- "] "
					a href="https://infra.spec.whatwg.org/#map-exists" id="integration-with-the-javascript-agent-cluster-formalism:map-exists" data-x-internal="map-exists" {
						- "exists"
					}
					- ", then set "
					var {
						- "key"
					}
					- " to\n   "
					var {
						- "group"
					}
					- "'s "
					a href="#historical-agent-cluster-key-map" id="integration-with-the-javascript-agent-cluster-formalism:historical-agent-cluster-key-map-2" {
						- "historical agent cluster key map"
					}
					- "["
					var {
						- "origin"
					}
					- "]."
				}
			}
			li {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "requestsOAC"
							}
							- " is true, then set "
							var {
								- "key"
							}
							- " to\n     "
							var {
								- "origin"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "group"
							}
							- "'s "
							a href="#historical-agent-cluster-key-map" id="integration-with-the-javascript-agent-cluster-formalism:historical-agent-cluster-key-map-3" {
								- "historical agent cluster key map"
							}
							- "["
							var {
