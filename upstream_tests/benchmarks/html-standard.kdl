		- "\n\n  "
		p {
			- "We then need to use this class to define the element:"
		}
		- "\n\n  "
		pre {
			code class="js" {
				- "customElements"
				c- p="" {
					- "."
				}
				- "define"
				c- p="" {
					- "("
				}
				c- u="" {
					- "\"flag-icon\""
				}
				c- p="" {
					- ","
				}
				- " FlagIcon"
				c- p="" {
					- ");"
				}
			}
		}
		- "\n\n  "
		p {
			- "At this point, our above code will work! The parser, whenever it sees the "
			code {
				- "flag-icon"
			}
			- " tag, will construct a new instance of our "
			code {
				- "FlagIcon"
			}
			- " class, and tell our code about its new "
			code {
				- "country"
			}
			- "\n  attribute, which we then use to set the element's internal state and update its rendering (when\n  appropriate)."
		}
		- "\n\n  "
		p {
			- "You can also create "
			code {
				- "flag-icon"
			}
			- " elements using the DOM API:"
		}
		- "\n\n  "
		pre {
			code class="js" {
				c- a="" {
					- "const"
