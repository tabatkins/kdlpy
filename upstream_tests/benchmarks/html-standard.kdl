			dt {
				- "Group ruby for describing meanings\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "The annotation describes the meaning of the base text, rather than (or in addition to) the\n    pronunciation. As such, both the base text and the annotation can be multiple characters long.\n\n    "
				}
				div class="example" {
					- " "
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "ruby"
