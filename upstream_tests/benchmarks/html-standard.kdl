					code id="the-history-entry-list:dom-navigation-currententry-2" {
						a href="#dom-navigation-currententry" {
							- "currentEntry"
						}
					}
					- ") is\n   not the last one in the navigation history entry list (i.e., in "
					code id="the-history-entry-list:dom-navigation-entries-2" {
						a href="#dom-navigation-entries" {
							- "entries()"
						}
					}
					- "). This means that there is a next "
					a href="#session-history-entry" id="the-history-entry-list:session-history-entry-3" {
						- "session\n   history entry"
					}
					- " for this "
					a href="#navigable" id="the-history-entry-list:navigable-3" {
						- "navigable"
					}
					- ", and its "
					a href="#she-document-state" id="the-history-entry-list:she-document-state-2" {
						- "document state"
					}
					- "'s "
