		- "\n\n  "
		h3 id="common-dom-interfaces" {
			span class="secno" {
				- "2.6"
			}
			- " Common DOM interfaces"
			a href="#common-dom-interfaces" class="self-link"
		}
		- "\n\n  "
		h4 id="reflecting-content-attributes-in-idl-attributes" {
			span class="secno" {
				- "2.6.1"
			}
			- " Reflecting content attributes in IDL attributes"
			a href="#reflecting-content-attributes-in-idl-attributes" class="self-link"
		}
		- "\n\n  "
		p {
			- "The building blocks for reflecting are as follows:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					dfn id="reflected-target" {
						- "reflected target"
					}
					- " is an element or "
					code id="reflecting-content-attributes-in-idl-attributes:elementinternals" {
						a href="#elementinternals" {
							- "ElementInternals"
						}
					}
					- "\n   object. It is typically clear from context and typically identical to the interface of the\n   "
					a href="#reflected-idl-attribute" id="reflecting-content-attributes-in-idl-attributes:reflected-idl-attribute" {
						- "reflected IDL attribute"
					}
					- ". It is always identical to that interface when it is an\n   "
					code id="reflecting-content-attributes-in-idl-attributes:elementinternals-2" {
						a href="#elementinternals" {
							- "ElementInternals"
						}
					}
					- " object."
				}
			}
			li {
				p {
					- "A "
					dfn id="reflected-idl-attribute" {
						- "reflected IDL attribute"
					}
					- " is an attribute interface member."
				}
			}
			li {
				p {
					- "A "
					dfn id="reflected-content-attribute-name" {
						- "reflected content attribute name"
					}
					- " is a string. When the "
					a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target" {
						- "reflected\n   target"
					}
					- " is an element, it represents the local name of a content attribute whose namespace\n   is null. When the "
					a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-2" {
						- "reflected target"
					}
					- " is an "
					code id="reflecting-content-attributes-in-idl-attributes:elementinternals-3" {
						a href="#elementinternals" {
							- "ElementInternals"
						}
					}
					- " object, it\n   represents a key of the "
					a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-3" {
						- "reflected target"
					}
					- "'s "
					a href="#internals-target" id="reflecting-content-attributes-in-idl-attributes:internals-target" {
						- "target\n   element"
					}
					- "'s "
					a href="#internal-content-attribute-map" id="reflecting-content-attributes-in-idl-attributes:internal-content-attribute-map" {
						- "internal content attribute map"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#reflected-idl-attribute" id="reflecting-content-attributes-in-idl-attributes:reflected-idl-attribute-2" {
				- "reflected IDL attribute"
			}
			- " can be defined to "
			dfn id="reflect" data-export="" {
				- "reflect"
			}
			- " a\n  "
			a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name" {
				- "reflected content attribute name"
			}
			- " of a "
			a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-4" {
				- "reflected target"
			}
			- ". In general this\n  means that the IDL attribute getter returns the current value of the content attribute, and the\n  setter changes the value of the content attribute to the given value."
		}
		- "\n\n  "
		p {
			- "If the "
			a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-5" {
				- "reflected target"
			}
			- " is an element, then the "
			a href="#reflected-idl-attribute" id="reflecting-content-attributes-in-idl-attributes:reflected-idl-attribute-3" {
				- "reflected IDL\n  attribute"
			}
			- " can additionally declare to "
			dfn id="support-elementinternals" {
				- "support "
				code {
					- "ElementInternals"
				}
			}
			- ".\n  This means that the "
			code id="reflecting-content-attributes-in-idl-attributes:elementinternals-4" {
				a href="#elementinternals" {
					- "ElementInternals"
				}
			}
			- " interface also has a "
			a href="#reflected-idl-attribute" id="reflecting-content-attributes-in-idl-attributes:reflected-idl-attribute-4" {
				- "reflected IDL\n  attribute"
			}
			- ", with the same identifier, and that "
			a href="#reflected-idl-attribute" id="reflecting-content-attributes-in-idl-attributes:reflected-idl-attribute-5" {
				- "reflected IDL attribute"
			}
			- " "
			a href="#reflect" id="reflecting-content-attributes-in-idl-attributes:reflect" {
				- "reflects"
			}
			- " the same "
			a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-2" {
				- "reflected content attribute name"
			}
			- "."
		}
		- "\n\n  "
		p id="example-reflect-incantation" class="example" {
			- "The "
			code {
				var {
					- "fooBar"
				}
			}
			- "\n  IDL attribute must "
			a href="#reflect" id="reflecting-content-attributes-in-idl-attributes:reflect-2" {
				- "reflect"
			}
			- " the "
			code {
				var {
					- "foobar"
				}
			}
			- " content attribute and "
			a href="#support-elementinternals" id="reflecting-content-attributes-in-idl-attributes:support-elementinternals" {
				- "support\n  "
				code {
					- "ElementInternals"
				}
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-6" {
				- "Reflected targets"
			}
			- " have these associated algorithms:\n\n  "
		}
		ul class="brief" {
			li {
				dfn id="get-the-element" {
					- "get the element"
				}
				- ": takes no arguments; returns an element."
			}
			li {
				dfn id="get-the-content-attribute" {
					- "get the content attribute"
				}
				- ": takes no arguments; returns null or a string."
			}
			li {
				dfn id="set-the-content-attribute" {
					- "set the content attribute"
				}
				- ": takes a string "
				var {
					- "value"
				}
				- "; returns nothing."
			}
			li {
				dfn id="delete-the-content-attribute" {
					- "delete the content attribute"
				}
				- ": takes no arguments; returns nothing."
			}
		}
		- "\n\n  "
		p {
			- "For a "
			a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-7" {
				- "reflected target"
			}
			- " that is an element "
			var {
				- "element"
			}
			- ", these are defined as\n  follows:"
		}
		- "\n\n  "
		dl {
			dt {
				a href="#get-the-element" id="reflecting-content-attributes-in-idl-attributes:get-the-element" {
					- "get the element"
				}
			}
			dd {
				ol {
					li {
						p {
							- "Return "
							var {
								- "element"
							}
							- "."
						}
					}
				}
			}
			dt {
				a href="#get-the-content-attribute" id="reflecting-content-attributes-in-idl-attributes:get-the-content-attribute" {
					- "get the content attribute"
				}
			}
			dd {
				- "\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "attribute"
							}
							- " be the result of running "
							a href="https://dom.spec.whatwg.org/#concept-element-attributes-get-by-namespace" id="reflecting-content-attributes-in-idl-attributes:concept-element-attributes-get-by-namespace" data-x-internal="concept-element-attributes-get-by-namespace" {
								- "get an attribute by namespace and local\n     name"
							}
							- " given null, the "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-3" {
								- "reflected content attribute name"
							}
							- ", and\n     "
							var {
								- "element"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "attribute"
							}
							- " is null, then return null."
						}
					}
					li {
						p {
							- "Return "
							var {
								- "attribute"
							}
							- "'s "
							a href="https://dom.spec.whatwg.org/#concept-attribute-value" id="reflecting-content-attributes-in-idl-attributes:concept-attribute-value" data-x-internal="concept-attribute-value" {
								- "value"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			dt {
				a href="#set-the-content-attribute" id="reflecting-content-attributes-in-idl-attributes:set-the-content-attribute" {
					- "set the content attribute"
				}
				- " with a string "
				var {
					- "value"
				}
			}
			dd {
				ol {
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-element-attributes-set-value" id="reflecting-content-attributes-in-idl-attributes:concept-element-attributes-set-value" data-x-internal="concept-element-attributes-set-value" {
								- "Set an attribute value"
							}
							- "\n   given "
							var {
								- "element"
							}
							- ", the "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-4" {
								- "reflected content attribute name"
							}
							- ", and\n   "
							var {
								- "value"
							}
							- "."
						}
					}
				}
			}
			dt {
				a href="#delete-the-content-attribute" id="reflecting-content-attributes-in-idl-attributes:delete-the-content-attribute" {
					- "delete the content attribute"
				}
			}
			dd {
				ol {
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-element-attributes-remove-by-namespace" id="reflecting-content-attributes-in-idl-attributes:concept-element-attributes-remove-by-namespace" data-x-internal="concept-element-attributes-remove-by-namespace" {
								- "Remove an attribute\n   by namespace and local name"
							}
							- " given null, the "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-5" {
								- "reflected content attribute name"
							}
							- ",\n   and "
							var {
								- "element"
							}
							- "."
						}
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "For a "
			a href="#reflected-target" id="reflecting-content-attributes-in-idl-attributes:reflected-target-8" {
				- "reflected target"
			}
			- " that is an "
			code id="reflecting-content-attributes-in-idl-attributes:elementinternals-5" {
				a href="#elementinternals" {
					- "ElementInternals"
				}
			}
			- " object\n  "
			var {
				- "elementInternals"
			}
			- ", they are defined as follows:"
		}
		- "\n\n  "
		dl {
			dt {
				a href="#get-the-element" id="reflecting-content-attributes-in-idl-attributes:get-the-element-2" {
					- "get the element"
				}
			}
			dd {
				ol {
					li {
						p {
							- "Return "
							var {
								- "elementInternals"
							}
							- "'s "
							a href="#internals-target" id="reflecting-content-attributes-in-idl-attributes:internals-target-2" {
								- "target\n   element"
							}
							- "."
						}
					}
				}
			}
			dt {
				a href="#get-the-content-attribute" id="reflecting-content-attributes-in-idl-attributes:get-the-content-attribute-2" {
					- "get the content attribute"
				}
			}
			dd {
				- "\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "elementInternals"
							}
							- "'s "
							a href="#internals-target" id="reflecting-content-attributes-in-idl-attributes:internals-target-3" {
								- "target element"
							}
							- "'s\n     "
							a href="#internal-content-attribute-map" id="reflecting-content-attributes-in-idl-attributes:internal-content-attribute-map-2" {
								- "internal content attribute map"
							}
							- "[the "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-6" {
								- "reflected content attribute name"
							}
							- "]\n     "
							a href="https://infra.spec.whatwg.org/#map-exists" id="reflecting-content-attributes-in-idl-attributes:map-exists" data-x-internal="map-exists" {
								- "does not exist"
							}
							- ", then return null.\n\n     "
						}
					}
					li {
						p {
							- "Return "
							var {
								- "elementInternals"
							}
							- "'s "
							a href="#internals-target" id="reflecting-content-attributes-in-idl-attributes:internals-target-4" {
								- "target\n     element"
							}
							- "'s "
							a href="#internal-content-attribute-map" id="reflecting-content-attributes-in-idl-attributes:internal-content-attribute-map-3" {
								- "internal content attribute map"
							}
							- "[the "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-7" {
								- "reflected content\n     attribute name"
							}
							- "]."
						}
					}
				}
				- "\n   "
			}
			dt {
				a href="#set-the-content-attribute" id="reflecting-content-attributes-in-idl-attributes:set-the-content-attribute-2" {
					- "set the content attribute"
				}
				- " with a string "
				var {
					- "value"
				}
			}
			dd {
				ol {
					li {
						p {
							a href="https://infra.spec.whatwg.org/#map-set" id="reflecting-content-attributes-in-idl-attributes:map-set" data-x-internal="map-set" {
								- "Set"
							}
							- " "
							var {
								- "elementInternals"
							}
							- "'s "
							a href="#internals-target" id="reflecting-content-attributes-in-idl-attributes:internals-target-5" {
								- "target element"
							}
							- "'s "
							a href="#internal-content-attribute-map" id="reflecting-content-attributes-in-idl-attributes:internal-content-attribute-map-4" {
								- "internal content attribute map"
							}
							- "[the\n   "
							a href="#reflected-content-attribute-name" id="reflecting-content-attributes-in-idl-attributes:reflected-content-attribute-name-8" {
								- "reflected content attribute name"
							}
							- "] to "
							var {
								- "value"
							}
							- "."
						}
					}
				}
