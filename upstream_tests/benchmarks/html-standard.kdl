										code {
											- "Document"
										}
									}
									- " is "
									a href="#allowed-to-use" id="script-settings-for-window-objects:allowed-to-use" {
										- "allowed to use"
									}
									- " the \""
									code id="script-settings-for-window-objects:cross-origin-isolated-feature" {
