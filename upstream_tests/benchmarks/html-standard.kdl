								- "auto-directionality form-associated\n      element"
							}
							- ":\n\n      "
						}
						ol {
							li {
								p {
									- "Let "
									var {
										- "dirname"
									}
									- " be the value of the element's "
									code id="constructing-form-data-set:attr-fe-dirname-2" {
										a href="#attr-fe-dirname" {
											- "dirname"
										}
									}
									- " attribute."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "dir"
									}
									- " be the string \""
									code {
										- "ltr"
									}
									- "\" if "
									a href="#the-directionality" id="constructing-form-data-set:the-directionality" {
										- "the\n       directionality"
									}
									- " of the element is '"
									a href="#concept-ltr" id="constructing-form-data-set:concept-ltr" {
										- "ltr"
									}
									- "', and \""
									code {
										- "rtl"
									}
									- "\" otherwise (i.e., when "
									a href="#the-directionality" id="constructing-form-data-set:the-directionality-2" {
										- "the directionality"
									}
									- " of the element is\n       '"
									a href="#concept-rtl" id="constructing-form-data-set:concept-rtl" {
										- "rtl"
									}
									- "')."
								}
							}
							li {
								p {
									a href="#create-an-entry" id="constructing-form-data-set:create-an-entry-9" {
										- "Create an entry"
									}
									- " with "
									var {
										- "dirname"
									}
									- " and "
									var {
										- "dir"
									}
									- ", and "
									a href="https://infra.spec.whatwg.org/#list-append" id="constructing-form-data-set:list-append-9" data-x-internal="list-append" {
										- "append"
									}
									- " it to "
									var {
										- "entry list"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "form data"
					}
					- " be a new "
					code id="constructing-form-data-set:formdata" {
						a data-x-internal="formdata" href="https://xhr.spec.whatwg.org/#formdata" {
							- "FormData"
						}
					}
					- " object associated with\n   "
					var {
						- "entry list"
					}
					- "."
				}
			}
			li {
				p {
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="constructing-form-data-set:concept-event-fire" data-x-internal="concept-event-fire" {
						- "Fire an event"
					}
					- " named\n   "
					code id="constructing-form-data-set:event-formdata" {
						a href="#event-formdata" {
							- "formdata"
						}
					}
					- " at "
					var {
						- "form"
					}
					- " using\n   "
					code id="constructing-form-data-set:formdataevent" {
						a href="#formdataevent" {
							- "FormDataEvent"
						}
					}
					- ", with the "
					code id="constructing-form-data-set:dom-formdataevent-formdata" {
						a href="#dom-formdataevent-formdata" {
							- "formData"
						}
					}
					- "\n   attribute initialized to "
					var {
						- "form data"
					}
					- " and the\n   "
					code id="constructing-form-data-set:dom-event-bubbles" {
						a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
							- "bubbles"
						}
					}
					- " attribute initialized to true."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "form"
					}
					- "'s "
					a href="#constructing-entry-list" id="constructing-form-data-set:constructing-entry-list-3" {
						- "constructing entry list"
					}
					- " to false."
				}
			}
			li {
				p {
					- "Return a "
					a href="https://infra.spec.whatwg.org/#list-clone" id="constructing-form-data-set:list-clone" data-x-internal="list-clone" {
						- "clone"
					}
					- " of "
					var {
						- "entry list"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  \n\n  "
		h5 id="selecting-a-form-submission-encoding" {
			span class="secno" {
				- "4.10.21.5"
			}
			- " Selecting a form submission encoding"
			a href="#selecting-a-form-submission-encoding" class="self-link"
		}
		- "\n\n  "
		p {
			- "If the user agent is to "
			dfn id="picking-an-encoding-for-the-form" {
				- "pick an encoding for a\n  form"
			}
			- ", it must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "encoding"
					}
					- " be the "
					a id="selecting-a-form-submission-encoding:document's-character-encoding" href="https://dom.spec.whatwg.org/#concept-document-encoding" data-x-internal="document's-character-encoding" {
						- "document's character encoding"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If the "
					code id="selecting-a-form-submission-encoding:the-form-element" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element has an "
					code id="selecting-a-form-submission-encoding:attr-form-accept-charset" {
						a href="#attr-form-accept-charset" {
							- "accept-charset"
						}
					}
					- " attribute, set "
					var {
						- "encoding"
					}
					- " to\n    the return value of running these substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "input"
							}
							- " be the value of the "
							code id="selecting-a-form-submission-encoding:the-form-element-2" {
								a href="#the-form-element" {
									- "form"
								}
							}
							- " element's "
							code id="selecting-a-form-submission-encoding:attr-form-accept-charset-2" {
								a href="#attr-form-accept-charset" {
									- "accept-charset"
								}
							}
							- " attribute."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "candidate encoding labels"
							}
							- " be the result of "
							a href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id="selecting-a-form-submission-encoding:split-a-string-on-spaces" data-x-internal="split-a-string-on-spaces" {
								- "splitting "
								var {
									- "input"
								}
								- " on ASCII whitespace"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "candidate encodings"
							}
							- " be an empty list of "
							a href="https://encoding.spec.whatwg.org/#encoding" id="selecting-a-form-submission-encoding:encoding" data-x-internal="encoding" {
								- "character\n     encodings"
							}
							- "."
						}
					}
					li {
						p {
							- "For each token in "
							var {
								- "candidate encoding labels"
							}
							- " in turn (in the order in which\n     they were found in "
							var {
								- "input"
							}
							- "), "
							a href="https://encoding.spec.whatwg.org/#concept-encoding-get" id="selecting-a-form-submission-encoding:getting-an-encoding" data-x-internal="getting-an-encoding" {
								- "get an encoding"
							}
							- "\n     for the token and, if this does not result in failure, append the "
							a id="selecting-a-form-submission-encoding:encoding-2" href="https://encoding.spec.whatwg.org/#encoding" data-x-internal="encoding" {
								- "encoding"
							}
							- " to\n     "
							var {
								- "candidate encodings"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "candidate encodings"
							}
							- " is empty, return "
							a id="selecting-a-form-submission-encoding:utf-8" href="https://encoding.spec.whatwg.org/#utf-8" data-x-internal="utf-8" {
								- "UTF-8"
							}
							- "."
						}
					}
					li {
						p {
							- "Return the first encoding in "
							var {
								- "candidate encodings"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return the result of "
					a href="https://encoding.spec.whatwg.org/#get-an-output-encoding" id="selecting-a-form-submission-encoding:get-an-output-encoding" data-x-internal="get-an-output-encoding" {
						- "getting an output\n   encoding"
					}
					- " from "
					var {
						- "encoding"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  \n\n  "
		h5 id="converting-an-entry-list-to-a-list-of-name-value-pairs" {
			span class="secno" {
				- "4.10.21.6"
			}
			- " Converting an entry list to a list of name-value pairs"
			a href="#converting-an-entry-list-to-a-list-of-name-value-pairs" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="converting-an-entry-list-to-a-list-of-name-value-pairs:application/x-www-form-urlencoded" {
				a data-x-internal="application/x-www-form-urlencoded" href="https://url.spec.whatwg.org/#concept-urlencoded" {
					- "application/x-www-form-urlencoded"
				}
			}
			- " and "
			code id="converting-an-entry-list-to-a-list-of-name-value-pairs:text/plain-encoding-algorithm" {
				a href="#text/plain-encoding-algorithm" {
					- "text/plain"
				}
			}
			- " encoding algorithms take a list of name-value pairs, where the values\n  must be strings, rather than an "
			a href="#entry-list" id="converting-an-entry-list-to-a-list-of-name-value-pairs:entry-list" {
				- "entry list"
			}
			- " where the value can be a\n  "
			code id="converting-an-entry-list-to-a-list-of-name-value-pairs:file" {
				a data-x-internal="file" href="https://w3c.github.io/FileAPI/#dfn-file" {
					- "File"
				}
			}
			- ". The following algorithm performs the conversion."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="convert-to-a-list-of-name-value-pairs" {
				- "convert to a list of name-value pairs"
			}
			- " an "
			a href="#entry-list" id="converting-an-entry-list-to-a-list-of-name-value-pairs:entry-list-2" {
				- "entry list"
			}
			- " "
			var {
				- "entry\n  list"
			}
			- ", run these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "list"
					}
					- " be an empty "
					a id="converting-an-entry-list-to-a-list-of-name-value-pairs:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- " of name-value pairs."
				}
			}
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="converting-an-entry-list-to-a-list-of-name-value-pairs:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "entry"
					}
					- " of "
					var {
						- "entry list"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "name"
							}
							- " be "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-name" id="converting-an-entry-list-to-a-list-of-name-value-pairs:form-entry-name" {
								- "name"
							}
							- ",\n     with every occurrence of U+000D (CR) not followed by U+000A (LF), and every occurrence of\n     U+000A (LF) not preceded by U+000D (CR), replaced by a string consisting of U+000D (CR) and\n     U+000A (LF)."
						}
					}
					li {
						p {
							- "If "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-value" id="converting-an-entry-list-to-a-list-of-name-value-pairs:form-entry-value" {
								- "value"
							}
							- " is a\n     "
							code id="converting-an-entry-list-to-a-list-of-name-value-pairs:file-2" {
								a data-x-internal="file" href="https://w3c.github.io/FileAPI/#dfn-file" {
									- "File"
								}
							}
							- " object, then let "
							var {
								- "value"
							}
							- " be "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-value" id="converting-an-entry-list-to-a-list-of-name-value-pairs:form-entry-value-2" {
								- "value"
							}
							- "'s "
							code id="converting-an-entry-list-to-a-list-of-name-value-pairs:dom-file-name" {
								a data-x-internal="dom-file-name" href="https://w3c.github.io/FileAPI/#dfn-name" {
									- "name"
								}
							}
							- ". Otherwise, let\n     "
							var {
								- "value"
							}
							- " be "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-value" id="converting-an-entry-list-to-a-list-of-name-value-pairs:form-entry-value-3" {
								- "value"
							}
							- "."
						}
					}
					li {
						p {
							- "Replace every occurrence of U+000D (CR) not followed by U+000A (LF), and every occurrence\n     of U+000A (LF) not preceded by U+000D (CR), in "
							var {
								- "value"
							}
							- ", by a string consisting of\n     U+000D (CR) and U+000A (LF)."
						}
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-append" id="converting-an-entry-list-to-a-list-of-name-value-pairs:list-append" data-x-internal="list-append" {
								- "Append"
							}
							- " to "
							var {
								- "list"
							}
							- " a new name-value pair whose\n     name is "
							var {
								- "name"
							}
							- " and whose value is "
							var {
								- "value"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "list"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h5 id="url-encoded-form-data" {
			span class="secno" {
				- "4.10.21.7"
			}
			- " URL-encoded form data"
			a href="#url-encoded-form-data" class="self-link"
		}
		- "\n\n  "
		p id="application-x-www-form-urlencoded-encoding-algorithm" {
			span id="application/x-www-form-urlencoded-encoding-algorithm"
			- "See "
			cite {
				- "URL"
			}
			- " for details\n  on "
			code id="url-encoded-form-data:application/x-www-form-urlencoded" {
				a data-x-internal="application/x-www-form-urlencoded" href="https://url.spec.whatwg.org/#concept-urlencoded" {
					- "application/x-www-form-urlencoded"
				}
			}
			- ". "
			a href="#refsURL" {
				- "[URL]"
			}
		}
		- "\n\n\n  "
		h5 id="multipart-form-data" {
			span class="secno" {
				- "4.10.21.8"
			}
			- " Multipart form data"
			a href="#multipart-form-data" class="self-link"
		}
		- "\n\n  \n\n  \n\n  \n\n  "
		p {
			- "The "
			dfn id="multipart/form-data-encoding-algorithm" data-export="" {
				code {
					- "multipart/form-data"
				}
				- " encoding algorithm"
			}
			- ", given an "
			a href="#entry-list" id="multipart-form-data:entry-list" {
				- "entry\n  list"
			}
			- " "
			var {
				- "entry list"
			}
			- " and an "
			a id="multipart-form-data:encoding" href="https://encoding.spec.whatwg.org/#encoding" data-x-internal="encoding" {
				- "encoding"
			}
			- " "
			var {
				- "encoding"
			}
			- ", is as\n  follows:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="multipart-form-data:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "entry"
					}
					- " of "
					var {
						- "entry list"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Replace every occurrence of U+000D (CR) not followed by U+000A (LF), and every\n     occurrence of U+000A (LF) not preceded by U+000D (CR), in "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-name" id="multipart-form-data:form-entry-name" {
								- "name"
							}
							- ", by a string consisting of a U+000D (CR) and U+000A (LF)."
						}
					}
					li {
						p {
							- "If "
							var {
								- "entry"
							}
							- "'s "
							a href="#form-entry-value" id="multipart-form-data:form-entry-value" {
								- "value"
							}
							- " is not a\n     "
							code id="multipart-form-data:file" {
								a data-x-internal="file" href="https://w3c.github.io/FileAPI/#dfn-file" {
									- "File"
								}
							}
							- " object, then replace every occurrence of U+000D (CR) not followed by U+000A\n     (LF), and every occurrence of U+000A (LF) not preceded by U+000D (CR), in "
							var {
								- "entry"
							}
							- "'s\n     "
							a href="#form-entry-value" id="multipart-form-data:form-entry-value-2" {
								- "value"
							}
							- ", by a string consisting of a U+000D (CR) and\n     U+000A (LF)."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Return the byte sequence resulting from encoding the "
					var {
						- "entry list"
					}
					- " using the rules\n    described by RFC 7578, "
					cite {
						- "Returning Values from Forms: "
						code {
							- "multipart/form-data"
						}
					}
					- ", given the following conditions:\n    "
					a href="#refsRFC7578" {
						- "[RFC7578]"
					}
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "Each "
							a href="#form-entry" id="multipart-form-data:form-entry" {
								- "entry"
							}
							- " in "
							var {
								- "entry list"
							}
							- " is a "
							i {
								- "field"
							}
							- ",\n     the "
							a href="#form-entry-name" id="multipart-form-data:form-entry-name-2" {
								- "name"
							}
							- " of the entry is the "
							i {
								- "field name"
							}
							- " and the\n     "
							a href="#form-entry-value" id="multipart-form-data:form-entry-value-3" {
								- "value"
							}
							- " of the entry is the "
							i {
								- "field value"
							}
							- "."
						}
					}
					li {
						p {
							- "The order of parts must be the same as the order of fields in "
							var {
								- "entry list"
							}
							- ".\n     Multiple entries with the same name must be treated as distinct fields."
						}
					}
					li {
						p {
							- "Field names, field values for non-file fields, and filenames for file fields, in the\n     generated "
							code id="multipart-form-data:multipart/form-data" {
								a href="#multipart/form-data" {
									- "multipart/form-data"
								}
							}
							- " resource must be set to the result of "
							a href="https://encoding.spec.whatwg.org/#encode" id="multipart-form-data:encode" data-x-internal="encode" {
								- "encoding"
							}
							- " the corresponding entry's name or value with\n     "
							var {
								- "encoding"
							}
							- ", converted to a byte sequence."
						}
					}
					li {
						p {
							- "For field names and filenames for file fields, the result of the encoding in the\n     previous bullet point must be escaped by replacing any 0x0A (LF) bytes with the byte sequence\n     `"
							code {
								- "%0A"
							}
							- "`, 0x0D (CR) with `"
							code {
								- "%0D"
							}
							- "` and 0x22 (\") with\n     `"
							code {
								- "%22"
							}
							- "`. The user agent must not perform any other escapes."
						}
					}
					li {
						p {
							- "The parts of the generated "
							code id="multipart-form-data:multipart/form-data-2" {
								a href="#multipart/form-data" {
									- "multipart/form-data"
								}
							}
							- " resource that correspond to\n     non-file fields must not have a `"
							code id="multipart-form-data:content-type" {
								a href="#content-type" {
									- "Content-Type"
								}
							}
							- "` header specified."
						}
					}
					li {
						p {
							- "The boundary used by the user agent in generating the return value of this algorithm is\n     the "
							dfn id="multipart/form-data-boundary-string" data-export="" {
								code {
									- "multipart/form-data"
								}
								- " boundary string"
							}
							- ". (This value is used to\n     generate the MIME type of the form submission payload generated by this algorithm.)"
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "For details on how to interpret "
			code id="multipart-form-data:multipart/form-data-3" {
				a href="#multipart/form-data" {
					- "multipart/form-data"
				}
			}
			- " payloads, see RFC 7578.\n  "
			a href="#refsRFC7578" {
				- "[RFC7578]"
			}
		}
		- "\n\n\n  "
		h5 id="plain-text-form-data" {
