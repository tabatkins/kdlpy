		- "\n\n  "
		p class="XXX" {
			- "Both "
			a href="#implied-event-loop" id="queuing-tasks:implied-event-loop-4" {
				- "implied event loop"
			}
			- " and "
			a href="#implied-document" id="queuing-tasks:implied-document-4" {
