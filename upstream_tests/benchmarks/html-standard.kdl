								a href="#meta-referrer" {
									- "referrer"
								}
							}
							- "\", then return."
						}
					}
					li {
						p {
							- "If "
							var {
								- "element"
							}
							- " does not have a "
							code id="standard-metadata-names:attr-meta-content-4" {
								a href="#attr-meta-content" {
									- "content"
								}
							}
