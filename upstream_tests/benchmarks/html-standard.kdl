					}
					- ". (In other words, restore the "
					a href="#insertion-point" id="parsing-main-inforeign:insertion-point-4" {
						- "insertion point"
					}
					- " to its previous value.\n    This value might be the \"undefined\" value.)"
				}
				- "\n   "
			}
			dt {
				- "Any other end tag"
			}
			dd {
