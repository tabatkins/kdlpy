						- "details"
					}
				}
				- " element could be used."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "Authors are also encouraged to make their applications degrade gracefully in the absence of\n  scripting support."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
