			li {
				p {
					- "Run the "
					a href="#check-validity-steps" id="the-constraint-validation-api:check-validity-steps-2" {
						- "check validity steps"
					}
					- " on "
					var {
						- "element"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="report-validity-steps" {
				- "report validity steps"
			}
			- " for an element "
			var {
				- "element"
			}
			- " are:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "element"
					}
					- " is a "
					a href="#candidate-for-constraint-validation" id="the-constraint-validation-api:candidate-for-constraint-validation-4" {
						- "candidate for constraint validation"
					}
					- " and does not\n    "
					a href="#concept-fv-valid" id="the-constraint-validation-api:concept-fv-valid-2" {
						- "satisfy its constraints"
					}
					- ", then:\n\n    "
				}
				ol {
					li {
						p {
							- "Let "
							var {
								- "report"
							}
							- " be the result of "
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-constraint-validation-api:concept-event-fire-2" data-x-internal="concept-event-fire" {
								- "firing an\n     event"
							}
							- " named "
							code id="the-constraint-validation-api:event-invalid-4" {
								a href="#event-invalid" {
									- "invalid"
								}
							}
							- " at "
							var {
								- "element"
							}
							- ", with the\n     "
							code id="the-constraint-validation-api:dom-event-cancelable-2" {
								a data-x-internal="dom-event-cancelable" href="https://dom.spec.whatwg.org/#dom-event-cancelable" {
									- "cancelable"
								}
							}
							- " attribute initialized to true."
						}
					}
					li {
						p {
							- "If "
							var {
								- "report"
							}
							- " is true, then report the problems with the constraints of this\n     element to the user. When reporting the problem with the constraints to the user, the user\n     agent may run the "
							a href="#focusing-steps" id="the-constraint-validation-api:focusing-steps" {
								- "focusing steps"
							}
							- " for "
							var {
								- "element"
							}
							- ", and may change the\n     scrolling position of the document, or perform some other action that brings "
							var {
								- "element"
							}
							- "\n     to the user's attention. User agents may report more than one constraint violation, if\n     "
							var {
								- "element"
							}
							- " suffers from multiple problems at once."
						}
						- "\n\n     "
					}
					li {
						p {
							- "Return false."
						}
					}
				}
				- "\n\n   "
			}
			li {
				p {
					- "Return true."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLObjectElement,HTMLInputElement,HTMLButtonElement,HTMLSelectElement,HTMLTextAreaElement,HTMLOutputElement,HTMLFieldSetElement" id="dom-cva-reportvalidity" data-dfn-type="method" {
				code {
					- "reportValidity()"
				}
			}
			- " method, when invoked, must run the\n  "
			a href="#report-validity-steps" id="the-constraint-validation-api:report-validity-steps" {
				- "report validity steps"
			}
			- " on this element."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
