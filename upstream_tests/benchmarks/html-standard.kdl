					}
					- ".\n   (Zero if the given baseline is the "
					a id="drawing-text-to-the-bitmap:hanging-baseline-3" href="https://drafts.csswg.org/css-inline/#hanging-baseline" data-x-internal="hanging-baseline" {
						- "hanging baseline"
					}
					- ".)"
				}
