		- "\n\n\n  "
		h6 id="number-state-(type=number)" {
			span class="secno" {
				- "4.10.5.1.12"
			}
			- " "
			dfn data-dfn-for="input" id="number-state" data-dfn-type="element-state" {
				- "Number"
			}
			- " state ("
			code {
				- "type=number"
			}
			- ")"
			a href="#number-state-(type=number)" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/number" title="<input> elements of type number are used to let the user enter a number. They include built-in validation to reject non-numerical entries." {
						- "Element/input/number"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "29+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "5.1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "7+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "10+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="number-state-(type=number):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="number-state-(type=number):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#number-state-(type=number)" id="number-state-(type=number):number-state-(type=number)" {
				- "Number"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="number-state-(type=number):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="number-state-(type=number):represents" {
				- "represents"
			}
			- " a control for setting the element's\n  "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value" {
				- "value"
			}
			- " to a string representing a number."
		}
		- "\n\n  \n\n  "
		p {
			- "If the element is "
			i id="number-state-(type=number):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the number represented by its "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-2" {
				- "value"
			}
			- ", as\n  obtained from applying the "
			a href="#rules-for-parsing-floating-point-number-values" id="number-state-(type=number):rules-for-parsing-floating-point-number-values" {
				- "rules for parsing floating-point number values"
			}
			- " to it. User\n  agents must not allow the user to set the "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-3" {
				- "value"
			}
			- " to a\n  non-empty string that is not a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number" {
				- "valid floating-point number"
			}
			- ". If the user agent\n  provides a user interface for selecting a number, then the "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-4" {
				- "value"
			}
			- " must be set to the "
			a href="#best-representation-of-the-number-as-a-floating-point-number" id="number-state-(type=number):best-representation-of-the-number-as-a-floating-point-number" {
				- "best representation of the number representing the user's\n  selection as a floating-point number"
			}
			- ". User agents should allow the user to set the "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-5" {
				- "value"
			}
			- " to the empty string."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the user interface describes input that the user\n  agent cannot convert to a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number-2" {
				- "valid floating-point number"
			}
			- ", the control is "
			a href="#suffering-from-bad-input" id="number-state-(type=number):suffering-from-bad-input" {
				- "suffering\n  from bad input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "This specification does not define what user interface user agents are to use;\n  user agent vendors are encouraged to consider what would best serve their users' needs. For\n  example, a user agent in Persian or Arabic markets might support Persian and Arabic numeric input\n  (converting it to the format required for submission as described above). Similarly, a user agent\n  designed for Romans might display the value in Roman numerals rather than in decimal; or (more\n  realistically) a user agent designed for the French market might display the value with\n  apostrophes between thousands and commas before the decimals, and allow the user to enter a value\n  in that manner, internally converting it to the submission format described above."
		}
		- "\n\n  "
		p {
			- "The "
			code id="number-state-(type=number):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not empty, must\n  have a value that is a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number-3" {
				- "valid floating-point number"
			}
			- "."
		}
		- " \n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="number-state-(type=number):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": If the "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-6" {
				- "value"
			}
			- " of the element is not a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number-4" {
				- "valid floating-point\n  number"
			}
			- ", then set it to the empty string instead."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="number-state-(type=number):attr-input-min" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute, if specified, must have a value that is\n  a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number-5" {
				- "valid floating-point number"
			}
			- ". The "
			code id="number-state-(type=number):attr-input-max" {
				a href="#attr-input-max" {
					- "max"
				}
			}
			- " attribute,\n  if specified, must have a value that is a "
			a href="#valid-floating-point-number" id="number-state-(type=number):valid-floating-point-number-6" {
				- "valid floating-point number"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-input-step-scale" id="number-state-(type=number):concept-input-step-scale" {
				- "step scale factor"
			}
			- " is\n  1. The "
			a href="#concept-input-step-default" id="number-state-(type=number):concept-input-step-default" {
				- "default step"
			}
			- " is 1 (allowing only\n  integers to be selected by the user, unless the "
			a href="#concept-input-min-zero" id="number-state-(type=number):concept-input-min-zero" {
				- "step\n  base"
			}
			- " has a non-integer value)."
		}
		- "\n\n  \n\n  "
		p {
			- "When the element is "
			a href="#suffering-from-a-step-mismatch" id="number-state-(type=number):suffering-from-a-step-mismatch" {
				- "suffering from a step mismatch"
			}
			- ", the user agent may round the\n  element's "
			a href="#concept-fe-value" id="number-state-(type=number):concept-fe-value-7" {
				- "value"
			}
			- " to the nearest number for which the element\n  would not "
			a href="#suffering-from-a-step-mismatch" id="number-state-(type=number):suffering-from-a-step-mismatch-2" {
				- "suffer from a step mismatch"
			}
			- ". If\n  there are two such numbers, user agents are encouraged to pick the one nearest positive\n  infinity."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-string-number" id="number-state-(type=number):concept-input-value-string-number" {
					- "algorithm to convert a string to a\n  number"
				}
				- ", given a string "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": If applying the\n  "
			a href="#rules-for-parsing-floating-point-number-values" id="number-state-(type=number):rules-for-parsing-floating-point-number-values-2" {
				- "rules for parsing floating-point number values"
			}
			- " to "
			var {
				- "input"
			}
			- " results\n  in an error, then return an error; otherwise, return the resulting number."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-number-string" id="number-state-(type=number):concept-input-value-number-string" {
					- "algorithm to convert a number to a\n  string"
				}
				- ", given a number "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": Return a\n  "
