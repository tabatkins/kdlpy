						- "optionally truncating"
					}
					- " "
					var {
						- "default"
					}
					- "."
				}
			}
			li {
				p {
					- "Show "
					var {
						- "message"
					}
					- " to the user, treating U+000A LF as a line break, and ask the user\n   to either respond with a string value or abort. The response must be defaulted to the value given\n   by "
					var {
						- "default"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "userPromptHandler"
					}
