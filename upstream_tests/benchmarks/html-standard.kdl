		- "\n\n  \n\n  \n\n\n  "
		h6 id="selecting-specific-audio-and-video-tracks-declaratively" {
			span class="secno" {
				- "4.8.11.10.2"
			}
			- " Selecting specific audio and video tracks declaratively"
			a href="#selecting-specific-audio-and-video-tracks-declaratively" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="selecting-specific-audio-and-video-tracks-declaratively:dom-media-audiotracks" {
				a href="#dom-media-audiotracks" {
					- "audioTracks"
				}
			}
			- " and "
			code id="selecting-specific-audio-and-video-tracks-declaratively:dom-media-videotracks" {
				a href="#dom-media-videotracks" {
					- "videoTracks"
				}
			}
			- " attributes allow scripts to select which track\n  should play, but it is also possible to select specific tracks declaratively, by specifying\n  particular tracks in the "
			a href="https://url.spec.whatwg.org/#concept-url-fragment" id="selecting-specific-audio-and-video-tracks-declaratively:concept-url-fragment" data-x-internal="concept-url-fragment" {
				- "fragment"
			}
			- " of the\n  "
			a id="selecting-specific-audio-and-video-tracks-declaratively:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " of the "
			a href="#media-resource" id="selecting-specific-audio-and-video-tracks-declaratively:media-resource" {
				- "media resource"
			}
			- ". The format of the "
			a href="https://url.spec.whatwg.org/#concept-url-fragment" id="selecting-specific-audio-and-video-tracks-declaratively:concept-url-fragment-2" data-x-internal="concept-url-fragment" {
				- "fragment"
			}
			- " depends on the "
			a id="selecting-specific-audio-and-video-tracks-declaratively:mime-type" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
				- "MIME type"
			}
			- " of the\n  "
			a href="#media-resource" id="selecting-specific-audio-and-video-tracks-declaratively:media-resource-2" {
				- "media resource"
			}
			- ". "
			a href="#refsRFC2046" {
				- "[RFC2046]"
			}
			- " "
			a href="#refsURL" {
				- "[URL]"
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In this example, a video that uses a format that supports "
				a id="selecting-specific-audio-and-video-tracks-declaratively:media-fragment-syntax" href="https://www.w3.org/TR/media-frags/#media-fragment-syntax" data-x-internal="media-fragment-syntax" {
					- "media fragment syntax"
				}
				- "\n   is embedded in such a way that the alternative angles labeled \"Alternative\" are enabled instead\n   of the default video track."
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "video"
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"myvideo#track=Alternative\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "video"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n\n\n  "
		h5 id="timed-text-tracks" {
			span class="secno" {
				- "4.8.11.11"
			}
			- " Timed text tracks"
			a href="#timed-text-tracks" class="self-link"
		}
		- "\n\n  "
		h6 id="text-track-model" {
			span class="secno" {
				- "4.8.11.11.1"
			}
			- " Text track model"
			a href="#text-track-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="text-track-model:media-element" {
				- "media element"
			}
			- " can have a group of associated "
			dfn id="text-track" {
				- "text\n  tracks"
			}
			- ", known as the "
			a href="#media-element" id="text-track-model:media-element-2" {
				- "media element"
			}
			- "'s "
			dfn id="list-of-text-tracks" {
				- "list of text tracks"
			}
			- ". The "
			a href="#text-track" id="text-track-model:text-track" {
				- "text tracks"
			}
			- " are sorted as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "The "
					a href="#text-track" id="text-track-model:text-track-2" {
						- "text tracks"
					}
					- " corresponding to "
					code id="text-track-model:the-track-element" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- "\n   element children of the "
					a href="#media-element" id="text-track-model:media-element-3" {
						- "media element"
					}
					- ", in "
					a id="text-track-model:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
						- "tree order"
					}
					- "."
				}
			}
			li {
				p {
					- "Any "
					a href="#text-track" id="text-track-model:text-track-3" {
						- "text tracks"
					}
					- " added using the "
					code id="text-track-model:dom-media-addtexttrack" {
						a href="#dom-media-addtexttrack" {
							- "addTextTrack()"
						}
					}
					- " method, in the order they were added,\n   oldest first."
				}
			}
			li {
				p {
					- "Any "
					a href="#media-resource-specific-text-track" id="text-track-model:media-resource-specific-text-track" {
						- "media-resource-specific text\n   tracks"
					}
					- " ("
					a href="#text-track" id="text-track-model:text-track-4" {
						- "text tracks"
					}
					- " corresponding to data in the\n   "
					a href="#media-resource" id="text-track-model:media-resource" {
						- "media resource"
					}
					- "), in the order defined by the "
					a href="#media-resource" id="text-track-model:media-resource-2" {
						- "media resource"
					}
					- "'s format\n   specification."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#text-track" id="text-track-model:text-track-5" {
				- "text track"
			}
			- " consists of:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="text-track-kind" {
					- "The kind of text track"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "This decides how the track is handled by the user agent. The kind is represented by a string.\n    The possible strings are:"
				}
				- "\n\n    "
				ul class="brief" {
					li {
						dfn id="dom-texttrack-kind-subtitles" {
							code {
								- "subtitles"
							}
						}
						- "\n     "
					}
					li {
						dfn id="dom-texttrack-kind-captions" {
							code {
								- "captions"
							}
						}
						- "\n     "
					}
					li {
						dfn id="dom-texttrack-kind-descriptions" {
							code {
								- "descriptions"
							}
						}
						- "\n     "
					}
					li {
						dfn id="dom-texttrack-kind-chapters" {
							code {
								- "chapters"
							}
						}
						- "\n     "
					}
					li {
						dfn id="dom-texttrack-kind-metadata" {
							code {
								- "metadata"
							}
						}
						- "\n    "
					}
				}
				- "\n\n    "
				p {
					- "The "
					a href="#text-track-kind" id="text-track-model:text-track-kind" {
						- "kind of track"
					}
					- " can change dynamically, in the case of\n    a "
					a href="#text-track" id="text-track-model:text-track-6" {
						- "text track"
					}
					- " corresponding to a "
					code id="text-track-model:the-track-element-2" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-label" {
					- "A label"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "This is a human-readable string intended to identify the track for the user."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#text-track-label" id="text-track-model:text-track-label" {
						- "label of a track"
					}
					- " can change dynamically, in the\n    case of a "
					a href="#text-track" id="text-track-model:text-track-7" {
						- "text track"
					}
					- " corresponding to a "
					code id="text-track-model:the-track-element-3" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n\n    "
				p {
					- "When a "
					a href="#text-track-label" id="text-track-model:text-track-label-2" {
						- "text track label"
					}
					- " is the empty string, the user agent should automatically\n    generate an appropriate label from the text track's other properties (e.g. the kind of text\n    track and the text track's language) for use in its user interface. This automatically-generated\n    label is not exposed in the API."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-in-band-metadata-track-dispatch-type" {
					- "An in-band metadata track dispatch type"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "This is a string extracted from the "
					a href="#media-resource" id="text-track-model:media-resource-3" {
						- "media resource"
					}
					- " specifically for in-band\n    metadata tracks to enable such tracks to be dispatched to different scripts in the document."
				}
				- "\n\n    "
				p class="example" {
					- "For example, a traditional TV station broadcast streamed on the web and\n    augmented with web-specific interactive features could include text tracks with metadata for ad\n    targeting, trivia game data during game shows, player states during sports games, recipe\n    information during food programs, and so forth. As each program starts and ends, new tracks\n    might be added or removed from the stream, and as each one is added, the user agent could bind\n    them to dedicated script modules using the value of this attribute."
				}
				- "\n\n    "
				p {
					- "Other than for in-band metadata text tracks, the "
					a href="#text-track-in-band-metadata-track-dispatch-type" id="text-track-model:text-track-in-band-metadata-track-dispatch-type" {
						- "in-band metadata track dispatch type"
					}
					- " is the empty string. How this\n    value is populated for different media formats is described in "
					a href="#steps-to-expose-a-media-resource-specific-text-track" id="text-track-model:steps-to-expose-a-media-resource-specific-text-track" {
						- "steps to expose a\n    media-resource-specific text track"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-language" {
					- "A language"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "This is a string (a BCP 47 language tag) representing the language of the text track's cues.\n    "
					a href="#refsBCP47" {
						- "[BCP47]"
					}
				}
				- "\n\n    "
				p {
					- "The "
					a href="#text-track-language" id="text-track-model:text-track-language" {
						- "language of a text track"
					}
					- " can change dynamically,\n    in the case of a "
					a href="#text-track" id="text-track-model:text-track-8" {
						- "text track"
					}
					- " corresponding to a "
					code id="text-track-model:the-track-element-4" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-readiness-state" {
					- "A readiness state"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						dfn id="text-track-not-loaded" {
							- "Not loaded"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track's cues have not been obtained."
						}
						- "\n     "
					}
					dt {
						dfn id="text-track-loading" {
							- "Loading"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track is loading and there have been no fatal errors encountered so\n      far. Further cues might still be added to the track by the parser."
						}
						- "\n     "
					}
					dt {
						dfn id="text-track-loaded" {
							- "Loaded"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track has been loaded with no fatal errors."
						}
						- "\n     "
					}
					dt {
						dfn id="text-track-failed-to-load" {
							- "Failed to load"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track was enabled, but when the user agent attempted to obtain it,\n      this failed in some way (e.g., "
							a id="text-track-model:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
								- "URL"
							}
							- " could not be "
							a href="#encoding-parsing-a-url" id="text-track-model:encoding-parsing-a-url" {
								- "parsed"
							}
							- ", network error, unknown text track format). Some or all of the cues are\n      likely missing and will not be obtained."
						}
						- "\n     "
					}
				}
				- "\n\n    "
				p {
					- "The "
					a href="#text-track-readiness-state" id="text-track-model:text-track-readiness-state" {
						- "readiness state"
					}
					- " of a "
					a href="#text-track" id="text-track-model:text-track-9" {
						- "text\n    track"
					}
					- " changes dynamically as the track is obtained."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-mode" {
					- "A mode"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						dfn id="text-track-disabled" {
							- "Disabled"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track is not active. Other than for the purposes of exposing the\n      track in the DOM, the user agent is ignoring the text track. No cues are active, no events are\n      fired, and the user agent will not attempt to obtain the track's cues."
						}
						- "\n     "
					}
					dt {
						dfn id="text-track-hidden" {
							- "Hidden"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track is active, but that the user agent is not actively displaying\n      the cues. If no attempt has yet been made to obtain the track's cues, the user agent will\n      perform such an attempt momentarily. The user agent is maintaining a list of which cues are\n      active, and events are being fired accordingly."
						}
						- "\n     "
					}
					dt {
						dfn id="text-track-showing" {
							- "Showing"
						}
						- "\n\n     "
					}
					dd {
						- "\n      "
						p {
							- "Indicates that the text track is active. If no attempt has yet been made to obtain the\n      track's cues, the user agent will perform such an attempt momentarily. The user agent is\n      maintaining a list of which cues are active, and events are being fired accordingly. In\n      addition, for text tracks whose "
							a href="#text-track-kind" id="text-track-model:text-track-kind-2" {
								- "kind"
							}
							- " is "
							code id="text-track-model:dom-texttrack-kind-subtitles" {
								a href="#dom-texttrack-kind-subtitles" {
									- "subtitles"
								}
							}
							- " or "
							code id="text-track-model:dom-texttrack-kind-captions" {
								a href="#dom-texttrack-kind-captions" {
									- "captions"
								}
							}
							- ", the cues are being overlaid on the video\n      as appropriate; for text tracks whose "
							a href="#text-track-kind" id="text-track-model:text-track-kind-3" {
								- "kind"
							}
							- " is "
							code id="text-track-model:dom-texttrack-kind-descriptions" {
								a href="#dom-texttrack-kind-descriptions" {
									- "descriptions"
								}
							}
							- ", the user agent is making the\n      cues available to the user in a non-visual fashion; and for text tracks whose "
							a href="#text-track-kind" id="text-track-model:text-track-kind-4" {
								- "kind"
							}
							- " is "
							code id="text-track-model:dom-texttrack-kind-chapters" {
								a href="#dom-texttrack-kind-chapters" {
									- "chapters"
								}
							}
							- ", the user agent is making available to\n      the user a mechanism by which the user can navigate to any point in the "
							a href="#media-resource" id="text-track-model:media-resource-4" {
								- "media\n      resource"
							}
							- " by selecting a cue."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-list-of-cues" {
					- "A list of zero or more cues"
				}
				- "\n\n   "
			}
			dd {
				- "\n    "
				p {
					- "A list of "
					a href="#text-track-cue" id="text-track-model:text-track-cue" {
						- "text track cues"
					}
					- ", along with "
					dfn id="rules-for-updating-the-text-track-rendering" {
						- "rules for\n    updating the text track rendering"
					}
					- ". For example, for WebVTT, the "
					a id="text-track-model:rules-for-updating-the-display-of-webvtt-text-tracks" href="https://w3c.github.io/webvtt/#rules-for-updating-the-display-of-webvtt-text-tracks" data-x-internal="rules-for-updating-the-display-of-webvtt-text-tracks" {
						- "rules for updating\n    the display of WebVTT text tracks"
					}
					- ". "
					a href="#refsWEBVTT" {
						- "[WEBVTT]"
					}
					- " "
				}
				- "\n\n    "
				p {
					- "The "
					a href="#text-track-list-of-cues" id="text-track-model:text-track-list-of-cues" {
						- "list of cues of a text track"
					}
					- " can change\n    dynamically, either because the "
					a href="#text-track" id="text-track-model:text-track-10" {
						- "text track"
					}
					- " has "
					a href="#text-track-not-loaded" id="text-track-model:text-track-not-loaded" {
						- "not yet been loaded"
					}
					- " or is still "
					a href="#text-track-loading" id="text-track-model:text-track-loading" {
						- "loading"
					}
					- ",\n    or due to DOM manipulation."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#text-track" id="text-track-model:text-track-11" {
				- "text track"
			}
			- " has a corresponding "
			code id="text-track-model:texttrack" {
				a href="#texttrack" {
					- "TextTrack"
				}
			}
			- " object."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			a href="#media-element" id="text-track-model:media-element-4" {
				- "media element"
			}
			- " has a "
			dfn id="list-of-pending-text-tracks" {
				- "list of pending text tracks"
			}
			- ", which must\n  initially be empty, a "
			dfn id="blocked-on-parser" {
				- "blocked-on-parser"
			}
			- " flag, which must initially be false, and a\n  "
			dfn id="did-perform-automatic-track-selection" {
				- "did-perform-automatic-track-selection"
			}
			- " flag, which must also initially be false."
		}
		- "\n\n  "
		p {
			- "When the user agent is required to "
			dfn id="populate-the-list-of-pending-text-tracks" {
				- "populate the list of pending text tracks"
			}
			- " of a\n  "
			a href="#media-element" id="text-track-model:media-element-5" {
				- "media element"
			}
			- ", the user agent must add to the element's "
			a href="#list-of-pending-text-tracks" id="text-track-model:list-of-pending-text-tracks" {
				- "list of pending text\n  tracks"
			}
			- " each "
			a href="#text-track" id="text-track-model:text-track-12" {
				- "text track"
			}
			- " in the element's "
			a href="#list-of-text-tracks" id="text-track-model:list-of-text-tracks" {
				- "list of text tracks"
			}
			- " whose\n  "
			a href="#text-track-mode" id="text-track-model:text-track-mode" {
				- "text track mode"
			}
			- " is not "
			a href="#text-track-disabled" id="text-track-model:text-track-disabled" {
				- "disabled"
			}
			- " and whose\n  "
			a href="#text-track-readiness-state" id="text-track-model:text-track-readiness-state-2" {
				- "text track readiness state"
			}
			- " is  "
			a href="#text-track-loading" id="text-track-model:text-track-loading-2" {
				- "loading"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Whenever a "
			code id="text-track-model:the-track-element-5" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element's parent node changes, the user agent must remove the\n  corresponding "
			a href="#text-track" id="text-track-model:text-track-13" {
				- "text track"
			}
			- " from any "
			a href="#list-of-pending-text-tracks" id="text-track-model:list-of-pending-text-tracks-2" {
				- "list of pending text tracks"
			}
			- " that it is\n  in."
		}
		- "\n\n  "
		p {
			- "Whenever a "
			a href="#text-track" id="text-track-model:text-track-14" {
				- "text track"
			}
			- "'s "
			a href="#text-track-readiness-state" id="text-track-model:text-track-readiness-state-3" {
				- "text track readiness state"
			}
			- " changes to either\n  "
			a href="#text-track-loaded" id="text-track-model:text-track-loaded" {
				- "loaded"
			}
			- " or "
			a href="#text-track-failed-to-load" id="text-track-model:text-track-failed-to-load" {
				- "failed to\n  load"
			}
			- ", the user agent must remove it from any "
			a href="#list-of-pending-text-tracks" id="text-track-model:list-of-pending-text-tracks-3" {
				- "list of pending text tracks"
			}
			- " that\n  it is in."
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#media-element" id="text-track-model:media-element-6" {
				- "media element"
			}
			- " is created by an "
			a href="#html-parser" id="text-track-model:html-parser" {
				- "HTML parser"
			}
			- " or "
			a href="#xml-parser" id="text-track-model:xml-parser" {
				- "XML\n  parser"
			}
			- ", the user agent must set the element's "
			a href="#blocked-on-parser" id="text-track-model:blocked-on-parser" {
				- "blocked-on-parser"
			}
			- " flag to true.\n  When a "
			a href="#media-element" id="text-track-model:media-element-7" {
				- "media element"
			}
			- " is popped off the "
			a href="#stack-of-open-elements" id="text-track-model:stack-of-open-elements" {
				- "stack of open elements"
			}
			- " of an\n  "
			a href="#html-parser" id="text-track-model:html-parser-2" {
				- "HTML parser"
			}
			- " or "
			a href="#xml-parser" id="text-track-model:xml-parser-2" {
				- "XML parser"
			}
			- ", the user agent must "
			a href="#honor-user-preferences-for-automatic-text-track-selection" id="text-track-model:honor-user-preferences-for-automatic-text-track-selection" {
				- "honor user\n  preferences for automatic text track selection"
			}
			- ", "
			a href="#populate-the-list-of-pending-text-tracks" id="text-track-model:populate-the-list-of-pending-text-tracks" {
				- "populate the list of pending text\n  tracks"
			}
			- ", and set the element's "
			a href="#blocked-on-parser" id="text-track-model:blocked-on-parser-2" {
				- "blocked-on-parser"
			}
			- " flag to false."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#text-track" id="text-track-model:text-track-15" {
				- "text tracks"
			}
			- " of a "
			a href="#media-element" id="text-track-model:media-element-8" {
				- "media element"
			}
			- " are "
			dfn id="the-text-tracks-are-ready" {
				- "ready"
			}
			- " when both the element's "
			a href="#list-of-pending-text-tracks" id="text-track-model:list-of-pending-text-tracks-4" {
				- "list of pending text\n  tracks"
			}
			- " is empty and the element's "
			a href="#blocked-on-parser" id="text-track-model:blocked-on-parser-3" {
				- "blocked-on-parser"
			}
			- " flag is false."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#media-element" id="text-track-model:media-element-9" {
				- "media element"
			}
			- " has a "
			dfn id="pending-text-track-change-notification-flag" {
				- "pending text track change notification flag"
			}
			- ",\n  which must initially be unset."
		}
		- "\n\n  "
		p {
			- "Whenever a "
			a href="#text-track" id="text-track-model:text-track-16" {
				- "text track"
			}
			- " that is in a "
			a href="#media-element" id="text-track-model:media-element-10" {
				- "media element"
			}
			- "'s "
			a href="#list-of-text-tracks" id="text-track-model:list-of-text-tracks-2" {
				- "list of text\n  tracks"
			}
			- " has its "
			a href="#text-track-mode" id="text-track-model:text-track-mode-2" {
				- "text track mode"
			}
			- " change value, the user agent must run the\n  following steps for the "
			a href="#media-element" id="text-track-model:media-element-11" {
				- "media element"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the "
					a href="#media-element" id="text-track-model:media-element-12" {
						- "media element"
					}
					- "'s "
					a href="#pending-text-track-change-notification-flag" id="text-track-model:pending-text-track-change-notification-flag" {
						- "pending text track change notification\n   flag"
					}
					- " is set, return."
				}
			}
			li {
				p {
					- "Set the "
					a href="#media-element" id="text-track-model:media-element-13" {
						- "media element"
					}
					- "'s "
					a href="#pending-text-track-change-notification-flag" id="text-track-model:pending-text-track-change-notification-flag-2" {
						- "pending text track change notification\n   flag"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="#queue-a-media-element-task" id="text-track-model:queue-a-media-element-task" {
						- "Queue a media element task"
					}
					- " given the "
					a href="#media-element" id="text-track-model:media-element-14" {
						- "media element"
					}
					- " to run these\n    steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Unset the "
							a href="#media-element" id="text-track-model:media-element-15" {
								- "media element"
							}
							- "'s "
							a href="#pending-text-track-change-notification-flag" id="text-track-model:pending-text-track-change-notification-flag-3" {
								- "pending text track change notification\n     flag"
							}
							- "."
						}
					}
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="text-track-model:concept-event-fire" data-x-internal="concept-event-fire" {
								- "Fire an event"
							}
							- " named "
							code id="text-track-model:event-media-change" {
								a href="#event-media-change" {
									- "change"
								}
							}
							- " at the "
							a href="#media-element" id="text-track-model:media-element-16" {
								- "media element"
							}
							- "'s "
							code id="text-track-model:dom-media-texttracks" {
								a href="#dom-media-texttracks" {
									- "textTracks"
								}
							}
							- " attribute's "
							code id="text-track-model:texttracklist" {
								a href="#texttracklist" {
									- "TextTrackList"
								}
							}
							- "\n     object."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If the "
					a href="#media-element" id="text-track-model:media-element-17" {
						- "media element"
					}
					- "'s "
					a href="#show-poster-flag" id="text-track-model:show-poster-flag" {
						- "show poster flag"
					}
					- " is not set, run the\n   "
					i id="text-track-model:time-marches-on" {
						a href="#time-marches-on" {
							- "time marches on"
						}
					}
					- " steps."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			a href="#task-source" id="text-track-model:task-source" {
				- "task source"
			}
			- " for the "
			a href="#concept-task" id="text-track-model:concept-task" {
				- "tasks"
			}
			- " listed in this\n  section is the "
			a href="#dom-manipulation-task-source" id="text-track-model:dom-manipulation-task-source" {
				- "DOM manipulation task source"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="text-track-cue" {
				- "text track cue"
			}
			- " is the unit of time-sensitive data in a "
			a href="#text-track" id="text-track-model:text-track-17" {
				- "text track"
			}
			- ",\n  corresponding for instance for subtitles and captions to the text that appears at a particular\n  time and disappears at another time."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#text-track-cue" id="text-track-model:text-track-cue-2" {
				- "text track cue"
			}
			- " consists of:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="text-track-cue-identifier" {
					- "An identifier"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "An arbitrary string."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-cue-start-time" {
					- "A start time"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "The time, in seconds and fractions of a second, that describes the beginning of the range of\n    the "
					a href="#media-data" id="text-track-model:media-data" {
						- "media data"
					}
					- " to which the cue applies."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-cue-end-time" {
					- "An end time"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "The time, in seconds and fractions of a second, that describes the end of the range of the\n    "
					a href="#media-data" id="text-track-model:media-data-2" {
						- "media data"
					}
					- " to which the cue applies, or positive Infinity for an "
					a href="#unbounded-text-track-cue" id="text-track-model:unbounded-text-track-cue" {
						- "unbounded\n    text track cue"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="text-track-cue-pause-on-exit-flag" {
					- "A pause-on-exit flag"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "A boolean indicating whether playback of the "
					a href="#media-resource" id="text-track-model:media-resource-5" {
						- "media resource"
					}
					- " is to pause when the\n    end of the range to which the cue applies is reached."
				}
				- "\n   "
			}
			dt {
				- "Some additional format-specific data"
			}
			dd {
				- "\n    "
				p {
					- "Additional fields, as needed for the format, including the actual data of the cue. For\n    example, WebVTT has a "
					a id="text-track-model:text-track-cue-writing-direction" href="https://w3c.github.io/webvtt/#webvtt-cue-writing-direction" data-x-internal="text-track-cue-writing-direction" {
						- "text track cue writing direction"
					}
					- " and so forth.\n    "
					a href="#refsWEBVTT" {
						- "[WEBVTT]"
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="unbounded-text-track-cue" {
				- "unbounded text track cue"
			}
			- " is a text track cue\n  with a "
			a href="#text-track-cue-end-time" id="text-track-model:text-track-cue-end-time" {
				- "text track cue end time"
			}
			- " set to positive Infinity. An active "
			a href="#unbounded-text-track-cue" id="text-track-model:unbounded-text-track-cue-2" {
				- "unbounded\n  text track cue"
			}
			- " cannot become inactive through the usual monotonic increase of the\n  "
			a href="#current-playback-position" id="text-track-model:current-playback-position" {
				- "current playback position"
			}
			- " during normal playback (e.g. a metadata cue for a chapter in a live\n  event with no announced end time.)"
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#text-track-cue-start-time" id="text-track-model:text-track-cue-start-time" {
				- "text track cue start time"
			}
			- " and "
			a href="#text-track-cue-end-time" id="text-track-model:text-track-cue-end-time-2" {
				- "text track cue end\n  time"
			}
			- " can be negative. (The "
			a href="#current-playback-position" id="text-track-model:current-playback-position-2" {
				- "current playback position"
			}
			- " can never be negative,\n  though, so cues entirely before time zero cannot be active.)"
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#text-track-cue" id="text-track-model:text-track-cue-3" {
				- "text track cue"
			}
			- " has a corresponding "
			code id="text-track-model:texttrackcue" {
				a href="#texttrackcue" {
					- "TextTrackCue"
				}
			}
			- " object (or more\n  specifically, an object that inherits from "
			code id="text-track-model:texttrackcue-2" {
				a href="#texttrackcue" {
					- "TextTrackCue"
				}
			}
			- " — for example, WebVTT\n  cues use the "
			code id="text-track-model:vttcue" {
				a data-x-internal="vttcue" href="https://w3c.github.io/webvtt/#vttcue" {
					- "VTTCue"
				}
			}
			- " interface). A "
			a href="#text-track-cue" id="text-track-model:text-track-cue-4" {
				- "text track cue"
			}
			- "'s in-memory\n  representation can be dynamically changed through this "
			code id="text-track-model:texttrackcue-3" {
				a href="#texttrackcue" {
					- "TextTrackCue"
				}
			}
			- " API.\n  "
			a href="#refsWEBVTT" {
				- "[WEBVTT]"
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#text-track-cue" id="text-track-model:text-track-cue-5" {
				- "text track cue"
			}
			- " is associated with "
			a href="#rules-for-updating-the-text-track-rendering" id="text-track-model:rules-for-updating-the-text-track-rendering" {
				- "rules for updating the text track\n  rendering"
			}
			- ", as defined by the specification for the specific kind of "
			a href="#text-track-cue" id="text-track-model:text-track-cue-6" {
				- "text track\n  cue"
			}
			- ". These rules are used specifically when the object representing the cue is added to a\n  "
			code id="text-track-model:texttrack-2" {
				a href="#texttrack" {
					- "TextTrack"
				}
			}
			- " object using the "
			code id="text-track-model:dom-texttrack-addcue" {
				a href="#dom-texttrack-addcue" {
					- "addCue()"
				}
			}
			- "\n  method."
		}
		- "\n\n  "
		p {
			- "In addition, each "
			a href="#text-track-cue" id="text-track-model:text-track-cue-7" {
				- "text track cue"
			}
			- " has two pieces of dynamic information:"
		}
		- "\n\n  "
		dl {
			dt {
				- "The "
				dfn id="text-track-cue-active-flag" {
					- "active flag"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "This flag must be initially unset. The flag is used to ensure events are fired appropriately\n    when the cue becomes active or inactive, and to make sure the right cues are rendered."
				}
				- "\n\n    "
				p {
					- "The user agent must synchronously unset this flag whenever the "
					a href="#text-track-cue" id="text-track-model:text-track-cue-8" {
						- "text track cue"
					}
					- " is\n    removed from its "
					a href="#text-track" id="text-track-model:text-track-18" {
						- "text track"
					}
					- "'s "
					a href="#text-track-list-of-cues" id="text-track-model:text-track-list-of-cues-2" {
						- "text track list of cues"
					}
					- "; whenever the\n    "
					a href="#text-track" id="text-track-model:text-track-19" {
						- "text track"
					}
					- " itself is removed from its "
					a href="#media-element" id="text-track-model:media-element-18" {
						- "media element"
					}
					- "'s "
					a href="#list-of-text-tracks" id="text-track-model:list-of-text-tracks-3" {
						- "list of\n    text tracks"
					}
					- " or has its "
					a href="#text-track-mode" id="text-track-model:text-track-mode-3" {
						- "text track mode"
					}
					- " changed to "
					a href="#text-track-disabled" id="text-track-model:text-track-disabled-2" {
						- "disabled"
					}
					- "; and whenever the "
					a href="#media-element" id="text-track-model:media-element-19" {
						- "media element"
					}
					- "'s "
					code id="text-track-model:dom-media-readystate" {
						a href="#dom-media-readystate" {
							- "readyState"
						}
					}
					- " is changed back to "
					code id="text-track-model:dom-media-have_nothing" {
						a href="#dom-media-have_nothing" {
							- "HAVE_NOTHING"
						}
					}
					- ". When the flag is unset in this way for one\n    or more cues in "
					a href="#text-track" id="text-track-model:text-track-20" {
						- "text tracks"
					}
					- " that were "
					a href="#text-track-showing" id="text-track-model:text-track-showing" {
						- "showing"
					}
					- " prior to the relevant incident, the user agent must, after having unset\n    the flag for all the affected cues, apply the "
					a href="#rules-for-updating-the-text-track-rendering" id="text-track-model:rules-for-updating-the-text-track-rendering-2" {
						- "rules for updating the text track\n    rendering"
					}
					- " of those "
					a href="#text-track" id="text-track-model:text-track-21" {
						- "text tracks"
					}
					- ". For example, for "
					a href="#text-track" id="text-track-model:text-track-22" {
						- "text tracks"
					}
					- " based on WebVTT, the "
					a id="text-track-model:rules-for-updating-the-display-of-webvtt-text-tracks-2" href="https://w3c.github.io/webvtt/#rules-for-updating-the-display-of-webvtt-text-tracks" data-x-internal="rules-for-updating-the-display-of-webvtt-text-tracks" {
						- "rules for updating the display\n    of WebVTT text tracks"
					}
					- ". "
					a href="#refsWEBVTT" {
						- "[WEBVTT]"
					}
				}
				- " "
			}
			dt {
				- "The "
				dfn id="text-track-cue-display-state" {
					- "display state"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "This is used as part of the rendering model, to keep cues in a consistent position. It must\n    initially be empty. Whenever the "
					a href="#text-track-cue-active-flag" id="text-track-model:text-track-cue-active-flag" {
						- "text track cue active flag"
					}
					- " is unset, the user\n    agent must empty the "
					a href="#text-track-cue-display-state" id="text-track-model:text-track-cue-display-state" {
						- "text track cue display state"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			a href="#text-track-cue" id="text-track-model:text-track-cue-9" {
				- "text track cues"
			}
			- " of a "
			a href="#media-element" id="text-track-model:media-element-20" {
				- "media element"
			}
			- "'s\n  "
			a href="#text-track" id="text-track-model:text-track-23" {
				- "text tracks"
			}
			- " are ordered relative to each other in the "
			dfn id="text-track-cue-order" {
				- "text\n  track cue order"
			}
			- ", which is determined as follows: first group the "
			a href="#text-track-cue" id="text-track-model:text-track-cue-10" {
				- "cues"
			}
			- " by their "
			a href="#text-track" id="text-track-model:text-track-24" {
				- "text track"
			}
			- ", with the groups being sorted in the same order\n  as their "
			a href="#text-track" id="text-track-model:text-track-25" {
				- "text tracks"
			}
			- " appear in the "
			a href="#media-element" id="text-track-model:media-element-21" {
				- "media element"
			}
			- "'s\n  "
			a href="#list-of-text-tracks" id="text-track-model:list-of-text-tracks-4" {
				- "list of text tracks"
			}
			- "; then, within each group, "
			a href="#text-track-cue" id="text-track-model:text-track-cue-11" {
				- "cues"
			}
			- " must be sorted by their "
			a href="#text-track-cue-start-time" id="text-track-model:text-track-cue-start-time-2" {
				- "start\n  time"
			}
			- ", earliest first; then, any "
			a href="#text-track-cue" id="text-track-model:text-track-cue-12" {
				- "cues"
			}
			- " with the same\n  "
			a href="#text-track-cue-start-time" id="text-track-model:text-track-cue-start-time-3" {
				- "start time"
			}
			- " must be sorted by their "
			a href="#text-track-cue-end-time" id="text-track-model:text-track-cue-end-time-3" {
				- "end time"
			}
			- ", latest first; and finally, any "
			a href="#text-track-cue" id="text-track-model:text-track-cue-13" {
				- "cues"
			}
			- " with identical "
			a href="#text-track-cue-end-time" id="text-track-model:text-track-cue-end-time-4" {
				- "end\n  times"
			}
			- " must be sorted in the order they were last added to their respective "
			a href="#text-track-list-of-cues" id="text-track-model:text-track-list-of-cues-3" {
				- "text track\n  list of cues"
			}
			- ", oldest first (so e.g. for cues from a WebVTT file, that would initially be\n  the order in which the cues were listed in the file). "
			a href="#refsWEBVTT" {
				- "[WEBVTT]"
			}
		}
		- "\n\n\n  "
		h6 id="sourcing-in-band-text-tracks" {
			span class="secno" {
				- "4.8.11.11.2"
			}
			- " Sourcing in-band text tracks"
			a href="#sourcing-in-band-text-tracks" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="media-resource-specific-text-track" {
				- "media-resource-specific text track"
			}
			- " is a "
			a href="#text-track" id="sourcing-in-band-text-tracks:text-track" {
				- "text track"
			}
			- " that corresponds\n  to data found in the "
			a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource" {
				- "media resource"
			}
			- "."
		}
		- "\n\n\n  \n\n  "
		p {
			- "Rules for processing and rendering such data are defined by the relevant specifications, e.g.\n  the specification of the video format if the "
			a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-2" {
				- "media resource"
			}
			- " is a video. Details for\n  some legacy formats can be found in "
			cite {
				- "Sourcing In-band Media Resource Tracks from Media\n  Containers into HTML"
			}
			- ". "
			a href="#refsINBAND" {
				- "[INBAND]"
			}
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-3" {
				- "media resource"
			}
			- " contains data that the user agent recognizes and supports as\n  being equivalent to a "
			a href="#text-track" id="sourcing-in-band-text-tracks:text-track-2" {
				- "text track"
			}
			- ", the user agent "
			a href="#found-a-media-resource-specific-timed-track" {
				- "runs"
			}
			- " the "
			dfn id="steps-to-expose-a-media-resource-specific-text-track" {
				- "steps to expose a\n  media-resource-specific text track"
			}
			- " with the relevant data, as follows."
		}
		- "\n\n  \n\n  "
		ol {
			li {
				p {
					- "Associate the relevant data with a new "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-3" {
						- "text track"
					}
					- " and its corresponding new\n   "
					code id="sourcing-in-band-text-tracks:texttrack" {
						a href="#texttrack" {
							- "TextTrack"
						}
					}
					- " object. The "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-4" {
						- "text track"
					}
					- " is a "
					a href="#media-resource-specific-text-track" id="sourcing-in-band-text-tracks:media-resource-specific-text-track" {
						- "media-resource-specific\n   text track"
					}
					- "."
				}
			}
			li {
				p {
					- "Set the new "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-5" {
						- "text track"
					}
					- "'s "
					a href="#text-track-kind" id="sourcing-in-band-text-tracks:text-track-kind" {
						- "kind"
					}
					- ", "
					a href="#text-track-label" id="sourcing-in-band-text-tracks:text-track-label" {
						- "label"
					}
					- ", and "
					a href="#text-track-language" id="sourcing-in-band-text-tracks:text-track-language" {
						- "language"
					}
					- "\n   based on the semantics of the relevant data, as defined by the relevant specification. If there\n   is no label in that data, then the "
					a href="#text-track-label" id="sourcing-in-band-text-tracks:text-track-label-2" {
						- "label"
					}
					- " must be set to the\n   empty string."
				}
			}
			li {
				p {
					- "Associate the "
					a href="#text-track-list-of-cues" id="sourcing-in-band-text-tracks:text-track-list-of-cues" {
						- "text track list of cues"
					}
					- " with the "
					a href="#rules-for-updating-the-text-track-rendering" id="sourcing-in-band-text-tracks:rules-for-updating-the-text-track-rendering" {
						- "rules for updating the\n   text track rendering"
					}
					- " appropriate for the format in question."
				}
				- "\n\n   "
			}
			li {
				- "\n    "
				p {
					- "If the new "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-6" {
						- "text track"
					}
					- "'s "
					a href="#text-track-kind" id="sourcing-in-band-text-tracks:text-track-kind-2" {
						- "kind"
					}
					- " is "
					code id="sourcing-in-band-text-tracks:dom-texttrack-kind-chapters" {
						a href="#dom-texttrack-kind-chapters" {
							- "chapters"
						}
					}
					- " or "
					code id="sourcing-in-band-text-tracks:dom-texttrack-kind-metadata" {
						a href="#dom-texttrack-kind-metadata" {
							- "metadata"
						}
					}
					- ", then set the "
					a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type" {
						- "text track in-band\n    metadata track dispatch type"
					}
					- " as follows, based on the type of the "
					a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-4" {
						- "media\n    resource"
					}
					- ":"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If the "
						a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-5" {
							- "media resource"
						}
						- " is an Ogg file"
					}
					dd {
						- "The "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-2" {
							- "text track in-band metadata track dispatch type"
						}
						- " must be set to the value\n     of the Name header field. "
						a href="#refsOGGSKELETONHEADERS" {
							- "[OGGSKELETONHEADERS]"
						}
					}
					dt {
						- "If the "
						a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-6" {
							- "media resource"
						}
						- " is a WebM file"
					}
					dd {
						- "The "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-3" {
							- "text track in-band metadata track dispatch type"
						}
						- " must be set to the value\n     of the "
						code {
							- "CodecID"
						}
						- " element. "
						a href="#refsWEBMCG" {
							- "[WEBMCG]"
						}
					}
					dt {
						- "If the "
						a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-7" {
							- "media resource"
						}
						- " is an MPEG-2 file"
					}
					dd {
						- "Let "
						var {
							- "stream type"
						}
						- " be the value of the \"stream_type\" field describing the text\n     track's type in the file's program map section, interpreted as an 8-bit unsigned integer. Let\n     "
						var {
							- "length"
						}
						- " be the value of the \"ES_info_length\" field for the track in the same part of\n     the program map section, interpreted as an integer as defined by "
						cite {
							- "Generic coding of moving\n     pictures and associated audio information"
						}
						- ". Let "
						var {
							- "descriptor bytes"
						}
						- " be the\n     "
						var {
							- "length"
						}
						- " bytes following the \"ES_info_length\" field. The "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-4" {
							- "text track in-band\n     metadata track dispatch type"
						}
						- " must be set to the concatenation of the "
						var {
							- "stream\n     type"
						}
						- " byte and the zero or more "
						var {
							- "descriptor bytes"
						}
						- " bytes, expressed in\n     hexadecimal using "
						a href="https://infra.spec.whatwg.org/#ascii-upper-hex-digit" id="sourcing-in-band-text-tracks:uppercase-ascii-hex-digits" data-x-internal="uppercase-ascii-hex-digits" {
							- "ASCII upper hex digits"
						}
						- ".\n     "
						a href="#refsMPEG2" {
							- "[MPEG2]"
						}
						- "\n     "
					}
					dt {
						- "If the "
						a href="#media-resource" id="sourcing-in-band-text-tracks:media-resource-8" {
							- "media resource"
						}
						- " is an MPEG-4 file"
					}
					dd {
						- "Let the\n     first "
						code {
							- "stsd"
						}
						- " box of the\n     first "
						code {
							- "stbl"
						}
						- " box of the\n     first "
						code {
							- "minf"
						}
						- " box of the\n     first "
						code {
							- "mdia"
						}
						- " box of the\n     "
						a href="#text-track" id="sourcing-in-band-text-tracks:text-track-7" {
							- "text track"
						}
						- "'s "
						code {
							- "trak"
						}
						- " box in the\n     first "
						code {
							- "moov"
						}
						- " box\n     of the file be the "
						i {
							- "stsd box"
						}
						- ", if any.\n\n     If the file has no "
						i {
							- "stsd box"
						}
						- ", or if the "
						i {
							- "stsd box"
						}
						- " has neither a "
						code {
							- "mett"
						}
						- " box nor a "
						code {
							- "metx"
						}
						- " box, then the "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-5" {
							- "text track\n     in-band metadata track dispatch type"
						}
						- " must be set to the empty string.\n\n     Otherwise, if the "
						i {
							- "stsd box"
						}
						- " has a "
						code {
							- "mett"
						}
						- " box then the "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-6" {
							- "text\n     track in-band metadata track dispatch type"
						}
						- " must be set to the concatenation of the\n     string \""
						code {
							- "mett"
						}
						- "\", a U+0020 SPACE character, and the value of the first "
						code {
							- "mime_format"
						}
						- " field of the first "
						code {
							- "mett"
						}
						- " box of the "
						i {
							- "stsd\n     box"
						}
						- ", or the empty string if that field is absent in that box.\n\n     Otherwise, if the "
						i {
							- "stsd box"
						}
						- " has no "
						code {
							- "mett"
						}
						- " box but has a "
						code {
							- "metx"
						}
						- " box then the "
						a href="#text-track-in-band-metadata-track-dispatch-type" id="sourcing-in-band-text-tracks:text-track-in-band-metadata-track-dispatch-type-7" {
							- "text track in-band metadata track dispatch type"
						}
						- "\n     must be set to the concatenation of the string \""
						code {
							- "metx"
						}
						- "\", a U+0020 SPACE\n     character, and the value of the first "
						code {
							- "namespace"
						}
						- " field of the first "
						code {
							- "metx"
						}
						- " box of the "
						i {
							- "stsd box"
						}
						- ", or the empty string if that field is absent in\n     that box.\n\n     "
						a href="#refsMPEG4" {
							- "[MPEG4]"
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Populate the new "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-8" {
						- "text track"
					}
					- "'s "
					a href="#text-track-list-of-cues" id="sourcing-in-band-text-tracks:text-track-list-of-cues-2" {
						- "list of\n   cues"
					}
					- " with the cues parsed so far, following the "
					a href="#guidelines-for-exposing-cues-in-various-formats-as-text-track-cues" id="sourcing-in-band-text-tracks:guidelines-for-exposing-cues-in-various-formats-as-text-track-cues" {
						- "guidelines for exposing\n   cues"
					}
					- ", and begin updating it dynamically as necessary."
				}
			}
			li {
				p {
					- "Set the new "
					a href="#text-track" id="sourcing-in-band-text-tracks:text-track-9" {
						- "text track"
					}
					- "'s "
					a href="#text-track-readiness-state" id="sourcing-in-band-text-tracks:text-track-readiness-state" {
						- "readiness\n   state"
					}
