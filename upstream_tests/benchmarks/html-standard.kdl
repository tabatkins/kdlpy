					}
					c- p="" {
						- ">"
					}
					- "\n\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "iframe"
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"c.html\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "iframe"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "At this point, the documents given by "
				code {
					- "a.html"
				}
				- ", "
				code {
					- "b-1.html"
				}
				- ", and "
				code {
					- "c.html"
				}
				- " are all the "
				a href="#nav-document" id="fully-active-documents:nav-document-3" {
					- "active documents"
				}
				- " of their respective "
				a href="#node-navigable" id="fully-active-documents:node-navigable-2" {
					- "node navigables"
				}
				- ". They are also all "
				a href="#fully-active" id="fully-active-documents:fully-active-4" {
					- "fully active"
				}
				- "."
			}
			- "\n\n   "
			p {
				- "After clicking on the "
				code id="fully-active-documents:the-button-element" {
					a href="#the-button-element" {
						- "button"
					}
				}
				- ", and thus loading a new "
				code id="fully-active-documents:document-4" {
					a href="#document" {
						- "Document"
					}
				}
				- " from\n   "
				code {
					- "b-2.html"
				}
				- " into navigable B, we have the following results:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "The "
						code {
							- "a.html"
						}
						- " "
						code id="fully-active-documents:document-5" {
							a href="#document" {
								- "Document"
							}
						}
						- " remains both the "
						a href="#nav-document" id="fully-active-documents:nav-document-4" {
							- "active document"
						}
						- " of navigable A, and "
						a href="#fully-active" id="fully-active-documents:fully-active-5" {
							- "fully\n    active"
						}
						- "."
					}
				}
				li {
					p {
						- "The "
						code {
							- "b-1.html"
						}
						- " "
						code id="fully-active-documents:document-6" {
							a href="#document" {
								- "Document"
							}
						}
						- " is now "
						em {
							- "not"
						}
						- " the "
						a href="#nav-document" id="fully-active-documents:nav-document-5" {
							- "active document"
						}
						- " of navigable B. As such it is also not "
						a href="#fully-active" id="fully-active-documents:fully-active-6" {
							- "fully\n    active"
						}
						- "."
					}
				}
				li {
					p {
						- "The new "
						code {
							- "b-2.html"
						}
						- " "
						code id="fully-active-documents:document-7" {
							a href="#document" {
								- "Document"
							}
						}
						- " is now the "
						a href="#nav-document" id="fully-active-documents:nav-document-6" {
							- "active document"
						}
						- " of navigable B, and is also "
						a href="#fully-active" id="fully-active-documents:fully-active-7" {
							- "fully\n    active"
						}
						- "."
					}
				}
				li {
					p {
						- "The "
						code {
							- "c.html"
						}
						- " "
						code id="fully-active-documents:document-8" {
							a href="#document" {
								- "Document"
							}
						}
						- " is still the "
						a href="#nav-document" id="fully-active-documents:nav-document-7" {
							- "active document"
						}
						- " of navigable C. However, since C's "
						a href="#nav-container-document" id="fully-active-documents:nav-container-document-4" {
							- "container document"
						}
						- " is the "
						code {
							- "b-1.html"
						}
						- " "
						code id="fully-active-documents:document-9" {
							a href="#document" {
								- "Document"
							}
						}
						- ", which is itself not "
						a href="#fully-active" id="fully-active-documents:fully-active-8" {
							- "fully active"
						}
						- ",\n    this means the "
						code {
							- "c.html"
						}
						- " "
						code id="fully-active-documents:document-10" {
							a href="#document" {
								- "Document"
							}
						}
						- " is now not "
						a href="#fully-active" id="fully-active-documents:fully-active-9" {
							- "fully\n    active"
						}
						- "."
					}
				}
			}
			- "\n  "
		}
		- "\n\n\n  "
		h3 id="navigation-and-session-history" {
			span class="secno" {
				- "7.4"
			}
			- " "
			span id="history"
			- "Navigation and session\n  history"
			a href="#navigation-and-session-history" class="self-link"
		}
		- "\n\n  "
		p {
			- "Welcome to the dragon's maw. Navigation, session history, and the traversal through that\n  session history are some of the most complex parts of this standard."
		}
		- "\n\n  "
		p {
			- "The basic concept may not seem so difficult:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The user is looking at a "
					a href="#navigable" id="navigation-and-session-history:navigable" {
						- "navigable"
					}
					- " that is presenting its "
					a href="#nav-document" id="navigation-and-session-history:nav-document" {
						- "active document"
					}
					- ". They "
					a href="#navigate" id="navigation-and-session-history:navigate" {
						- "navigate"
					}
					- " it to another\n   "
					a id="navigation-and-session-history:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- "."
				}
			}
			li {
				p {
					- "The browser fetches the given URL from the network, using it to "
					a href="#attempt-to-populate-the-history-entry's-document" id="navigation-and-session-history:attempt-to-populate-the-history-entry's-document" {
						- "populate"
					}
					- " a new "
					a href="#session-history-entry" id="navigation-and-session-history:session-history-entry" {
						- "session history entry"
					}
					- "\n   with a newly-"
					a href="#initialise-the-document-object" id="navigation-and-session-history:initialise-the-document-object" {
						- "created"
					}
					- "\n   "
					code id="navigation-and-session-history:document" {
						a href="#document" {
							- "Document"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "The browser updates the "
					a href="#navigable" id="navigation-and-session-history:navigable-2" {
						- "navigable"
					}
					- "'s "
					a href="#nav-active-history-entry" id="navigation-and-session-history:nav-active-history-entry" {
						- "active session history entry"
					}
					- " to the newly-populated\n   one, and thus updates the "
					a href="#nav-document" id="navigation-and-session-history:nav-document-2" {
						- "active document"
					}
					- " that it is showing\n   to the user."
				}
			}
			li {
				p {
					- "At some point later, the user "
					a href="#traverse-the-history-by-a-delta" id="navigation-and-session-history:traverse-the-history-by-a-delta" {
						- "presses the\n   browser back button"
					}
					- " to go back to the previous "
					a href="#session-history-entry" id="navigation-and-session-history:session-history-entry-2" {
						- "session history\n   entry"
					}
					- "."
				}
			}
			li {
				p {
					- "The browser looks at the "
					a href="#she-url" id="navigation-and-session-history:she-url" {
						- "URL"
					}
					- " stored in that "
					a href="#session-history-entry" id="navigation-and-session-history:session-history-entry-3" {
						- "session\n   history entry"
					}
					- ", and uses it to re-fetch and "
					a href="#attempt-to-populate-the-history-entry's-document" id="navigation-and-session-history:attempt-to-populate-the-history-entry's-document-2" {
						- "populate"
					}
					- " that entry's "
					a href="#she-document" id="navigation-and-session-history:she-document" {
						- "document"
					}
					- "."
				}
			}
			li {
				p {
					- "The browser again updates the "
					a href="#navigable" id="navigation-and-session-history:navigable-3" {
						- "navigable"
					}
					- "'s "
					a href="#nav-active-history-entry" id="navigation-and-session-history:nav-active-history-entry-2" {
						- "active session history entry"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "You can see some of the intertwined complexity peeking through here, in how traversal can\n  cause a navigation (i.e., a network fetch to a stored URL), and how a navigation necessarily\n  needs to interface with the session history list to ensure that when it finishes the user is\n  looking at the right thing. But the real problems come in with the various edge cases and\n  interacting web platform features:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					a href="#child-navigable" id="navigation-and-session-history:child-navigable" {
						- "Child navigables"
					}
					- " (e.g., those contained in\n   "
					code id="navigation-and-session-history:the-iframe-element" {
						a href="#the-iframe-element" {
							- "iframe"
						}
					}
					- "s) can also navigate and traverse, but those navigations need to be\n   linearized into "
					a href="#tn-session-history-entries" id="navigation-and-session-history:tn-session-history-entries" {
						- "a single session history list"
					}
					- "\n   since the user only has a single back/forward interface for the entire "
					a href="#traversable-navigable" id="navigation-and-session-history:traversable-navigable" {
						- "traversable\n   navigable"
					}
					- " (e.g., browser tab)."
				}
			}
			li {
				p {
					- "Since the user can traverse back more than a single step in the session history (e.g., by\n   holding down their back button), they can end up traversing multiple "
					a href="#navigable" id="navigation-and-session-history:navigable-4" {
						- "navigables"
					}
					- " at the same time when "
					a href="#child-navigable" id="navigation-and-session-history:child-navigable-2" {
						- "child navigables"
					}
					- " are involved. This needs to be synchronized across all of\n   the involved navigables, which might involve multiple "
					a href="#event-loop" id="navigation-and-session-history:event-loop" {
						- "event\n   loops"
					}
					- " or even "
					a href="https://tc39.es/ecma262/#sec-agent-clusters" id="navigation-and-session-history:agent-cluster" data-x-internal="agent-cluster" {
						- "agent clusters"
					}
					- "."
				}
			}
			li {
				p {
					- "During navigation, servers can respond with 204 or 205 status codes or with `"
					code id="navigation-and-session-history:http-content-disposition" {
						a data-x-internal="http-content-disposition" href="https://httpwg.org/specs/rfc6266.html" {
							- "Content-Disposition: attachment"
						}
					}
					- "` headers, which cause\n   navigation to abort and the "
					a href="#navigable" id="navigation-and-session-history:navigable-5" {
						- "navigable"
					}
					- " to stay on its original "
					a href="#active-document" id="navigation-and-session-history:active-document" {
						- "active document"
					}
					- ". (This is much worse if it happens during a traversal-initiated\n   navigation!)"
				}
			}
			li {
				p {
					- "Various other HTTP headers, such as `"
					code {
						- "Location"
					}
					- "`,\n   `"
					code id="navigation-and-session-history:refresh" {
						a href="#refresh" {
							- "Refresh"
						}
					}
					- "`, `"
					code id="navigation-and-session-history:x-frame-options" {
						a href="#x-frame-options" {
							- "X-Frame-Options"
						}
					}
					- "`, and those for Content Security Policy,\n   contribute to either the "
					a href="#create-navigation-params-by-fetching" id="navigation-and-session-history:create-navigation-params-by-fetching" {
						- "fetching\n   process"
					}
					- ", or the "
					a href="#initialise-the-document-object" id="navigation-and-session-history:initialise-the-document-object-2" {
						code {
							- "Document"
						}
						- "-creation\n   process"
					}
					- ", or both. The `"
					code id="navigation-and-session-history:cross-origin-opener-policy-2" {
						a href="#cross-origin-opener-policy-2" {
							- "Cross-Origin-Opener-Policy"
						}
					}
					- "` header even contributes\n   to the "
					a href="#browsing-context-group-switches-due-to-cross-origin-opener-policy" {
						- "browsing\n   context selection and creation"
					}
					- " process!"
				}
			}
			li {
				p {
					- "Some navigations (namely "
					a href="#scroll-to-fragid" {
						- "fragment navigations"
					}
					- " and "
					a href="#navigate-non-frag-sync" {
						- "single-page app navigations"
					}
					- ") are synchronous, meaning that\n   JavaScript code expects to observe the navigation's results instantly. This then needs to be\n   synchronized with the view of the session history that all other "
					a href="#navigable" id="navigation-and-session-history:navigable-6" {
						- "navigables"
					}
					- " in the tree see, which can be subject to race conditions\n   and necessitate resolving conflicting views of the session history."
				}
			}
			li {
				p {
					- "The platform has accumulated various exciting navigation-related features that need\n   special-casing, such as "
					code id="navigation-and-session-history:the-javascript:-url-special-case" {
						a href="#the-javascript:-url-special-case" {
							- "javascript:"
						}
					}
					- " URLs, "
					code id="navigation-and-session-history:attr-iframe-srcdoc" {
						a href="#attr-iframe-srcdoc" {
							- "srcdoc"
						}
					}
					- " "
					code id="navigation-and-session-history:the-iframe-element-2" {
						a href="#the-iframe-element" {
							- "iframe"
						}
					}
					- "s, and the "
					code id="navigation-and-session-history:event-beforeunload" {
						a href="#event-beforeunload" {
							- "beforeunload"
						}
					}
					- " event."
				}
			}
		}
		- "\n\n  "
		p {
			- "In what follows, we have attempted to guide the reader through these complexities by\n  appropriately cordoning them off into labeled sections and algorithms, and giving appropriate\n  words of introduction where possible. Nevertheless, if you wish to truly understand navigation\n  and session history, "
			a href="#how-to-read-this-specification" {
				- "the usual advice"
			}
			- " will be\n  invaluable."
		}
		- "\n\n\n  "
		h4 id="session-history-infrastructure" {
			span class="secno" {
				- "7.4.1"
			}
			- " "
			span id="the-session-history-of-browsing-contexts"
			- "Session history"
			a href="#session-history-infrastructure" class="self-link"
		}
		- "\n\n  "
		h5 id="session-history-entries" {
			span class="secno" {
				- "7.4.1.1"
			}
			- " Session history entries"
			a href="#session-history-entries" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="session-history-entry" {
				- "session history entry"
			}
			- " is a "
			a id="session-history-entries:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="session-history-entries:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					dfn id="she-step" {
						- "step"
					}
					- ", a non-negative integer or \""
					code {
						- "pending"
					}
					- "\", initially \""
					code {
						- "pending"
					}
					- "\"."
				}
			}
			li {
				p {
					dfn id="she-url" {
						- "URL"
					}
					- ", a "
					a id="session-history-entries:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
				}
			}
			li {
				p {
					dfn id="she-document-state" {
						- "document state"
					}
					- ", a "
					a href="#document-state-2" id="session-history-entries:document-state-2" {
						- "document\n   state"
					}
					- "."
				}
			}
			li {
				p id="she-serialized-state" {
					dfn id="she-classic-history-api-state" {
						- "classic history API\n   state"
					}
					- ", which is "
					a href="#serialized-state" id="session-history-entries:serialized-state" {
						- "serialized state"
					}
					- ", initially\n   "
					a href="#structuredserializeforstorage" id="session-history-entries:structuredserializeforstorage" {
						- "StructuredSerializeForStorage"
					}
					- "(null)."
				}
			}
			li {
				p {
					dfn id="she-navigation-api-state" {
						- "navigation API state"
					}
					- ", which is a\n   "
					a href="#serialized-state" id="session-history-entries:serialized-state-2" {
						- "serialized state"
					}
					- ", initially\n   "
					a href="#structuredserializeforstorage" id="session-history-entries:structuredserializeforstorage-2" {
						- "StructuredSerializeForStorage"
					}
					- "(undefined)."
				}
			}
			li {
				p {
					dfn id="she-navigation-api-key" {
						- "navigation API key"
					}
					- ", which is a string,\n   initially set to the result of "
					a id="session-history-entries:generating-a-random-uuid" href="https://w3c.github.io/webcrypto/#dfn-generate-a-random-uuid" data-x-internal="generating-a-random-uuid" {
						- "generating a random UUID"
					}
					- "."
				}
			}
			li {
				p {
					dfn id="she-navigation-api-id" {
						- "navigation API ID"
					}
					- ", which is a string, initially\n   set to the result of "
					a id="session-history-entries:generating-a-random-uuid-2" href="https://w3c.github.io/webcrypto/#dfn-generate-a-random-uuid" data-x-internal="generating-a-random-uuid" {
						- "generating a random UUID"
					}
					- "."
				}
			}
			li {
				p {
					dfn id="she-scroll-restoration-mode" {
						- "scroll restoration mode"
					}
					- ", a "
					a href="#scroll-restoration-mode" id="session-history-entries:scroll-restoration-mode" {
						- "scroll\n   restoration mode"
					}
					- ", initially \""
					code id="session-history-entries:dom-scrollrestoration-auto" {
						a href="#dom-scrollrestoration-auto" {
							- "auto"
						}
					}
					- "\"."
				}
			}
			li {
				p {
					dfn id="she-scroll-position" {
						- "scroll position data"
					}
					- ", which is scroll position\n   data for the "
					a href="#she-document" id="session-history-entries:she-document" {
						- "document"
					}
					- "'s "
					a href="#restorable-scrollable-regions" id="session-history-entries:restorable-scrollable-regions" {
						- "restorable scrollable\n   regions"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p id="an-entry-with-persisted-user-state" {
					dfn id="she-other" {
						- "persisted user state"
					}
					- ",\n    which is "
					a id="session-history-entries:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- ", initially null"
				}
				- "\n\n    "
				p class="example" {
					- "For example, some user agents might want to persist the values of form\n    controls."
				}
				- "\n\n    "
				p class="note" {
					- "User agents that persist the value of form controls are encouraged to also\n    persist their directionality (the value of the element's "
					code id="session-history-entries:attr-dir" {
						a href="#attr-dir" {
							- "dir"
						}
					}
					- "\n    attribute). This prevents values from being displayed incorrectly after a history traversal\n    when the user had originally entered the values with an explicit, non-default\n    directionality."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "To get a "
			a href="#session-history-entry" id="session-history-entries:session-history-entry" {
				- "session history entry"
			}
			- "'s "
			dfn id="she-document" {
				- "document"
			}
			- ",\n  return its "
			a href="#she-document-state" id="session-history-entries:she-document-state" {
				- "document state"
			}
			- "'s "
			a href="#document-state-document" id="session-history-entries:document-state-document" {
				- "document"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p id="state-object" {
			dfn id="serialized-state" {
				- "Serialized state"
			}
			- " is a serialization (via\n  "
			a href="#structuredserializeforstorage" id="session-history-entries:structuredserializeforstorage-3" {
				- "StructuredSerializeForStorage"
			}
			- ") of an object representing a user interface state. We\n  sometimes informally refer to \"state objects\", which are the objects representing user interface\n  state supplied by the author, or alternately the objects created by deserializing (via\n  "
			a href="#structureddeserialize" id="session-history-entries:structureddeserialize" {
				- "StructuredDeserialize"
			}
			- ") serialized state."
		}
		- "\n\n  "
		p {
			- "Pages can "
			a href="#dom-history-pushstate" id="session-history-entries:dom-history-pushstate" {
				- "add"
			}
			- " "
			a href="#serialized-state" id="session-history-entries:serialized-state-3" {
				- "serialized state"
			}
			- " to the\n  session history. These are then "
			a href="#structureddeserialize" id="session-history-entries:structureddeserialize-2" {
				- "deserialized"
			}
			- " and "
			a href="#event-popstate" id="session-history-entries:event-popstate" {
				- "returned to the script"
			}
			- " when the user (or script) goes back in the\n  history, thus enabling authors to use the \"navigation\" metaphor even in one-page applications."
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				a href="#serialized-state" id="session-history-entries:serialized-state-4" {
					- "Serialized state"
				}
				- " is intended to be used for two main purposes: first, storing a\n   preparsed description of the state in the "
				a id="session-history-entries:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
					- "URL"
				}
				- " so that in the simple case an author\n   doesn't have to do the parsing (though one would still need the parsing for handling "
				a href="https://url.spec.whatwg.org/#concept-url" id="session-history-entries:url-3" data-x-internal="url" {
					- "URLs"
				}
				- " passed around by users, so it's only a minor optimization). Second, so\n   that the author can store state that one wouldn't store in the URL because it only applies to the\n   current "
				code id="session-history-entries:document" {
					a href="#document" {
						- "Document"
					}
				}
				- " instance and it would have to be reconstructed if a new\n   "
				code id="session-history-entries:document-2" {
					a href="#document" {
						- "Document"
					}
				}
				- " were opened."
			}
			- "\n\n   "
			p {
				- "An example of the latter would be something like keeping track of the precise coordinate from\n   which a popup "
				code id="session-history-entries:the-div-element" {
					a href="#the-div-element" {
						- "div"
					}
				}
				- " was made to animate, so that if the user goes back, it can be made\n   to animate to the same location. Or alternatively, it could be used to keep a pointer into a\n   cache of data that would be fetched from the server based on the information in the\n   "
				a id="session-history-entries:url-4" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
					- "URL"
				}
				- ", so that when going back and forward, the information doesn't have to be fetched\n   again."
			}
			- "\n  "
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="scroll-restoration-mode" {
				- "scroll restoration mode"
			}
			- " indicates whether the user agent should restore the\n  persisted scroll position (if any) when traversing to an "
			a href="#session-history-entry" id="session-history-entries:session-history-entry-2" {
				- "entry"
			}
			- ". A scroll restoration mode is one of the following:"
		}
		- "\n\n  "
		dl {
			dt {
				- "\""
				dfn data-dfn-for="ScrollRestoration" id="dom-scrollrestoration-auto" data-dfn-type="enum-value" {
					code {
						- "auto"
					}
				}
				- "\""
			}
			dd {
				- "The user agent is responsible for restoring the scroll position upon navigation."
			}
			dt {
				- "\""
				dfn data-dfn-for="ScrollRestoration" id="dom-scrollrestoration-manual" data-dfn-type="enum-value" {
					code {
						- "manual"
					}
				}
				- "\""
			}
			dd {
				- "The page is responsible for restoring the scroll position and the user agent does not\n   attempt to do so automatically"
			}
		}
		- "\n\n\n  "
		h5 id="document-state" {
			span class="secno" {
				- "7.4.1.2"
			}
			- " Document state"
			a href="#document-state" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="document-state-2" {
				- "Document state"
			}
			- " holds state inside a "
			a href="#session-history-entry" id="document-state:session-history-entry" {
				- "session history entry"
			}
			- " regarding\n  how to present and, if necessary, recreate, a "
			code id="document-state:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ". It has:"
		}
		- "\n\n  "
		ul {
			li {
				- "\n    "
				p {
					- "A "
					dfn id="document-state-document" {
						- "document"
					}
					- ", a "
					code id="document-state:document-2" {
						a href="#document" {
							- "Document"
						}
					}
					- " or null,\n    initially null."
				}
				- "\n\n    "
				div id="note-bfcache" class="note" {
					- "\n     "
					p {
						- "When a history entry is "
						a href="#nav-active-history-entry" id="document-state:nav-active-history-entry" {
							- "active"
						}
						- ", it has a\n     "
						code id="document-state:document-3" {
							a href="#document" {
								- "Document"
							}
						}
						- " in its "
						a href="#she-document-state" id="document-state:she-document-state" {
							- "document state"
						}
						- ". However,\n     when a "
						code id="document-state:document-4" {
							a href="#document" {
								- "Document"
							}
						}
						- " is not "
						a href="#fully-active" id="document-state:fully-active" {
							- "fully active"
						}
						- ", it's possible for it to be\n     "
						a href="#destroy-a-document" id="document-state:destroy-a-document" {
							- "destroyed"
						}
						- " to free resources. In such cases, this\n     "
						a href="#document-state-document" id="document-state:document-state-document" {
							- "document"
						}
						- " item will be nulled out. The "
						a href="#she-url" id="document-state:she-url" {
							- "URL"
						}
						- " and other data in the "
						a href="#session-history-entry" id="document-state:session-history-entry-2" {
							- "session history entry"
						}
						- " and "
						a href="#she-document-state" id="document-state:she-document-state-2" {
							- "document state"
						}
						- " is then used to bring a new\n     "
						code id="document-state:document-5" {
							a href="#document" {
								- "Document"
							}
						}
						- " into being to take the place of the original, in the case where the user\n     agent finds itself having to traverse to the entry."
					}
					- "\n\n     "
					p {
						- "If the "
						code id="document-state:document-6" {
							a href="#document" {
								- "Document"
							}
						}
						- " is "
						em {
							- "not"
						}
						- " "
						a href="#destroy-a-document" id="document-state:destroy-a-document-2" {
							- "destroyed"
						}
						- ", then during "
						a href="#traverse-the-history-by-a-delta" id="document-state:traverse-the-history-by-a-delta" {
							- "history\n     traversal"
						}
						- ", it can be "
						a href="#reactivate-a-document" id="document-state:reactivate-a-document" {
							- "reactivated"
						}
						- ". The cache\n     in which browsers store such "
						code id="document-state:document-7" {
							a href="#document" {
								- "Document"
							}
						}
						- "s is often called a "
						em {
							- "back-forward\n     cache"
						}
						- ", or "
						em {
							- "bfcache"
						}
						- " (or perhaps "
						a href="https://bugzilla.mozilla.org/show_bug.cgi?id=274784" {
							- "\"blazingly fast\""
						}
						- " cache)."
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				p id="she-policy-container" {
					- "A "
					dfn id="document-state-history-policy-container" {
						- "history\n   policy container"
					}
					- ", a "
					a href="#policy-container" id="document-state:policy-container" {
						- "policy container"
					}
					- " or null, initially null."
				}
			}
			li {
				p {
					- "A "
					dfn id="document-state-request-referrer" {
						- "request referrer"
					}
					- ", which is \""
					code {
						- "no-referrer"
					}
					- "\", \""
					code {
						- "client"
					}
					- "\", or a "
					a id="document-state:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- ", initially\n   \""
					code {
						- "client"
					}
					- "\"."
				}
			}
			li {
				- "\n    "
				p {
					- "A "
					dfn id="document-state-request-referrer-policy" {
						- "request referrer policy"
					}
					- ", which\n    is a "
					a id="document-state:referrer-policy" href="https://w3c.github.io/webappsec-referrer-policy/#referrer-policy" data-x-internal="referrer-policy" {
						- "referrer policy"
					}
					- ", initially the "
					a id="document-state:default-referrer-policy" href="https://w3c.github.io/webappsec-referrer-policy/#default-referrer-policy" data-x-internal="default-referrer-policy" {
						- "default referrer policy"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "The "
					a href="#document-state-request-referrer-policy" id="document-state:document-state-request-referrer-policy" {
						- "request referrer\n    policy"
					}
					- " is distinct from the "
					a href="#document-state-history-policy-container" id="document-state:document-state-history-policy-container" {
						- "history policy container"
					}
					- "'s "
					a href="#policy-container-referrer-policy" id="document-state:policy-container-referrer-policy" {
						- "referrer policy"
					}
					- ". The former is used for\n    fetches "
					em {
						- "of"
					}
					- " this document, whereas the latter controls fetches "
					em {
						- "by"
					}
					- " this\n    document."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "An "
					dfn id="document-state-initiator-origin" {
						- "initiator origin"
					}
					- ", which is an\n    "
					a href="#concept-origin" id="document-state:concept-origin" {
						- "origin"
					}
					- " or null, initially null."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "An "
					dfn id="document-state-origin" {
						- "origin"
					}
					- ", which is an "
					a href="#concept-origin" id="document-state:concept-origin-2" {
						- "origin"
					}
					- " or\n    null, initially null."
				}
				- "\n\n    "
				p class="note" {
					- "This is the origin that we set \""
					code {
						- "about:"
					}
					- "\"-schemed\n    "
					code id="document-state:document-8" {
						a href="#document" {
							- "Document"
						}
					}
					- "s' "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="document-state:concept-document-origin" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " to. We store it\n    here because it is also used when restoring these "
					code id="document-state:document-9" {
						a href="#document" {
							- "Document"
						}
					}
					- "s during traversal,\n    since they are reconstructed locally without visiting the network. It is also used to compare\n    the origin before and after the "
					a href="#session-history-entry" id="document-state:session-history-entry-3" {
						- "session history entry"
					}
					- " is "
					a href="#attempt-to-populate-the-history-entry's-document" id="document-state:attempt-to-populate-the-history-entry's-document" {
						- "repopulated"
					}
					- ". If the origins change, the "
					a href="#document-state-nav-target-name" id="document-state:document-state-nav-target-name" {
						- "navigable target name"
					}
					- " is cleared."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "An "
					dfn id="document-state-about-base-url" {
						- "about base URL"
					}
					- ", which is a\n    "
					a id="document-state:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " or null, initially null."
				}
				- "\n\n    "
				p class="note" {
					- "This will be populated only for \""
					code {
						- "about:"
					}
					- "\"-schemed\n    "
					code id="document-state:document-10" {
						a href="#document" {
							- "Document"
						}
					}
					- "s and will be the "
					a href="#fallback-base-url" id="document-state:fallback-base-url" {
						- "fallback base URL"
					}
					- " for those\n    "
					code id="document-state:document-11" {
						a href="#document" {
							- "Document"
						}
					}
					- "s. It is a snapshot of the initiator "
					code id="document-state:document-12" {
						a href="#document" {
							- "Document"
						}
					}
					- "'s "
					a href="#document-base-url" id="document-state:document-base-url" {
						- "document\n    base URL"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					dfn id="document-state-nested-histories" {
						- "Nested histories"
					}
					- ", a "
					a id="document-state:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- "\n   of "
					a href="#nested-history" id="document-state:nested-history" {
						- "nested histories"
					}
					- ", initially an empty\n   "
					a id="document-state:list-2" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "A "
					dfn id="document-state-resource" {
						- "resource"
					}
					- ", a string, "
					a href="#post-resource" id="document-state:post-resource" {
						- "POST resource"
					}
					- "\n    or null, initially null."
				}
				- "\n\n    "
				p class="note" {
					- "A string is treated as HTML. It's used to store the source of an "
					a href="#an-iframe-srcdoc-document" id="document-state:an-iframe-srcdoc-document" {
						code {
							- "iframe"
						}
						- " "
						code {
							- "srcdoc"
						}
						- " document"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "A "
					dfn id="document-state-reload-pending" {
						- "reload pending"
					}
					- " boolean, initially\n   false."
				}
			}
			li {
				p {
					- "An "
					dfn id="document-state-ever-populated" {
						- "ever populated"
					}
					- " boolean, initially\n   false."
				}
			}
			li {
				p id="she-bc-name" {
					- "A "
					dfn id="document-state-nav-target-name" {
						- "navigable target\n   name"
					}
					- " string, initially the empty string."
				}
			}
			li {
				p {
					- "A "
					dfn id="document-state-not-restored-reasons" {
						- "not restored reasons"
					}
					- ", a\n   "
					a href="#nrr-struct" id="document-state:nrr-struct" {
						- "not restored reasons"
					}
					- " or null, initially null."
				}
			}
		}
		- "\n\n  "
		p {
			- "User agents may "
			a href="#destroy-a-document-and-its-descendants" id="document-state:destroy-a-document-and-its-descendants" {
				- "destroy a document and its descendants"
			}
			- " given the "
			a href="#document-state-document" id="document-state:document-state-document-2" {
				- "documents"
			}
			- " of "
			a href="#document-state-2" id="document-state:document-state-2" {
				- "document\n  states"
			}
			- " with non-null "
			a href="#document-state-document" id="document-state:document-state-document-3" {
				- "documents"
			}
			- ", as long as\n  the "
			code id="document-state:document-13" {
				a href="#document" {
					- "Document"
				}
			}
			- " is not "
			a href="#fully-active" id="document-state:fully-active-2" {
				- "fully active"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Apart from that restriction, this standard does not specify when user agents should destroy\n  the "
			a href="#document-state-document" id="document-state:document-state-document-4" {
				- "document"
			}
			- " stored in a "
			a href="#document-state-2" id="document-state:document-state-2-2" {
				- "document\n  state"
			}
			- ", versus keeping it cached."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="post-resource" data-export="" {
				- "POST resource"
			}
			- " has:"
		}
		- "\n\n  "
		ul {
			li {
				- "\n    "
				p {
					- "A "
					dfn data-dfn-for="POST resource" id="post-resource-request-body" data-export="" {
						- "request body"
					}
					- ", a\n    "
					a id="document-state:byte-sequence" href="https://infra.spec.whatwg.org/#byte-sequence" data-x-internal="byte-sequence" {
						- "byte sequence"
					}
					- " or failure."
				}
				- "\n\n    "
				p {
					- "This is only ever accessed "
					a href="#in-parallel" id="document-state:in-parallel" {
						- "in parallel"
					}
					- ", so it doesn't need to be stored in\n    memory. However, it must return the same "
					a id="document-state:byte-sequence-2" href="https://infra.spec.whatwg.org/#byte-sequence" data-x-internal="byte-sequence" {
						- "byte sequence"
					}
					- " each time. If this isn't\n    possible due to resources changing on disk, or if resources can no longer be accessed, then\n    this must be set to failure."
				}
				- "\n   "
			}
			li {
				p {
					- "A "
					dfn data-dfn-for="POST resource" id="post-resource-request-content-type" data-export="" {
						- "request\n   content-type"
					}
					- ", which is `"
					code id="document-state:application/x-www-form-urlencoded" {
						a data-x-internal="application/x-www-form-urlencoded" href="https://url.spec.whatwg.org/#concept-urlencoded" {
							- "application/x-www-form-urlencoded"
						}
					}
					- "`,\n   `"
					code id="document-state:multipart/form-data" {
						a href="#multipart/form-data" {
							- "multipart/form-data"
						}
					}
					- "`, or `"
					code id="document-state:text/plain" {
						a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
							- "text/plain"
						}
					}
					- "`."
				}
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="nested-history" {
				- "nested history"
			}
			- " has:"
		}
		- "\n\n  "
		ul {
			li {
				- "\n    "
				p {
					- "An "
					dfn id="nested-history-id" {
						- "id"
					}
					- ", a "
					a href="#unique-internal-value" id="document-state:unique-internal-value" {
						- "unique internal value"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This is used to associate the "
					a href="#nested-history" id="document-state:nested-history-2" {
						- "nested history"
					}
					- " with a\n    "
					a href="#navigable" id="document-state:navigable" {
						- "navigable"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					dfn id="nested-history-entries" {
						- "Entries"
					}
					- ", a "
					a id="document-state:list-3" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- " of "
					a href="#session-history-entry" id="document-state:session-history-entry-4" {
						- "session history entries"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="XXX" {
			- "This will later contain ways to identify a child navigable across reloads."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Several contiguous entries in a session history can share the same "
			a href="#she-document-state" id="document-state:she-document-state-3" {
				- "document state"
			}
			- ". This can occur when the initial entry is\n  reached via normal "
			a href="#navigate" id="document-state:navigate" {
				- "navigation"
			}
			- ", and the following entry is added\n  via "
			code id="document-state:dom-history-pushstate" {
				a href="#dom-history-pushstate" {
					- "history.pushState()"
				}
			}
			- ". Or it can occur via "
			a href="#navigate-fragid" id="document-state:navigate-fragid" {
				- "navigation to a fragment"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "All entries that share the same "
			a href="#she-document-state" id="document-state:she-document-state-4" {
				- "document\n  state"
			}
			- " (and that are therefore merely different states of one particular document) are\n  contiguous by construction."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			code id="document-state:document-14" {
				a href="#document" {
					- "Document"
				}
			}
			- " has a "
			dfn id="latest-entry" {
				- "latest entry"
			}
			- ", a "
			a href="#session-history-entry" id="document-state:session-history-entry-5" {
				- "session history entry"
			}
			- " or\n  null."
		}
		- "\n\n  "
		p class="note" {
			- "This is the entry that was most recently represented by a given\n  "
			code id="document-state:document-15" {
				a href="#document" {
					- "Document"
				}
			}
			- ". A single "
			code id="document-state:document-16" {
				a href="#document" {
					- "Document"
				}
			}
			- " can represent many "
			a href="#session-history-entry" id="document-state:session-history-entry-6" {
				- "session history entries"
			}
			- " over time, as many contiguous "
			a href="#session-history-entry" id="document-state:session-history-entry-7" {
				- "session history entries"
			}
			- " can share the same "
			a href="#she-document-state" id="document-state:she-document-state-5" {
				- "document state"
			}
			- " as explained above."
		}
		- "\n\n\n  "
		h5 id="centralized-modifications-of-session-history" {
			span class="secno" {
				- "7.4.1.3"
			}
			- " Centralized modifications of session history"
			a href="#centralized-modifications-of-session-history" class="self-link"
		}
		- "\n\n  "
		p {
			- "To maintain a single source of truth, all modifications to a "
			a href="#traversable-navigable" id="centralized-modifications-of-session-history:traversable-navigable" {
				- "traversable\n  navigable"
			}
			- "'s "
			a href="#tn-session-history-entries" id="centralized-modifications-of-session-history:tn-session-history-entries" {
				- "session history entries"
			}
			- " need\n  to be synchronized. This is especially important due to how session history is influenced by all\n  of the descendant "
			a href="#navigable" id="centralized-modifications-of-session-history:navigable" {
				- "navigables"
			}
			- ", and thus by multiple "
			a href="#event-loop" id="centralized-modifications-of-session-history:event-loop" {
				- "event loops"
			}
			- ". To accomplish this, we use the "
			a href="#session-history-traversal-parallel-queue" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue" {
				- "session history\n  traversal parallel queue"
			}
			- " structure."
		}
		- "\n\n  "
		p id="session-history-traversal-queue" {
			- "A "
			dfn id="session-history-traversal-parallel-queue" {
				- "session history traversal parallel queue"
			}
			- " is\n  very similar to a "
			a href="#parallel-queue" id="centralized-modifications-of-session-history:parallel-queue" {
				- "parallel queue"
			}
			- ". It has an "
			dfn id="session-history-traversal-parallel-queue-algorithm-set" {
				- "algorithm set"
			}
			- ", an "
			a href="https://infra.spec.whatwg.org/#ordered-set" id="centralized-modifications-of-session-history:set" data-x-internal="set" {
				- "ordered set"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="https://infra.spec.whatwg.org/#list-item" id="centralized-modifications-of-session-history:list-item" data-x-internal="list-item" {
				- "items"
			}
			- " in a "
			a href="#session-history-traversal-parallel-queue" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-2" {
				- "session history traversal parallel\n  queue"
			}
			- "'s "
			a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set" {
				- "algorithm\n  set"
			}
			- " are either algorithm steps, or "
			dfn id="session-history-traversal-parallel-queue-sync-nav-steps" {
				- "synchronous navigation\n  steps"
			}
			- ", which are a particular brand of algorithm steps involving a "
			dfn id="session-history-traversal-parallel-queue-sync-nav-steps-target-nav" {
				- "target\n  navigable"
			}
			- " (a "
			a href="#navigable" id="centralized-modifications-of-session-history:navigable-2" {
				- "navigable"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="tn-append-session-history-traversal-steps" {
				- "append session history traversal\n  steps"
			}
			- " to a "
			a href="#traversable-navigable" id="centralized-modifications-of-session-history:traversable-navigable-2" {
				- "traversable navigable"
			}
			- " "
			var {
				- "traversable"
			}
			- " given algorithm steps\n  "
			var {
				- "steps"
			}
			- ", "
			a href="https://infra.spec.whatwg.org/#list-append" id="centralized-modifications-of-session-history:list-append" data-x-internal="list-append" {
				- "append"
			}
			- " "
			var {
				- "steps"
			}
			- " to\n  "
			var {
				- "traversable"
			}
			- "'s "
			a href="#tn-session-history-traversal-queue" id="centralized-modifications-of-session-history:tn-session-history-traversal-queue" {
				- "session history\n  traversal queue"
			}
			- "'s "
			a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set-2" {
				- "algorithm set"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="tn-append-session-history-sync-nav-steps" {
				- "append session history synchronous\n  navigation steps"
			}
			- " involving a "
			a href="#navigable" id="centralized-modifications-of-session-history:navigable-3" {
				- "navigable"
			}
			- " "
			var {
				- "targetNavigable"
			}
			- " to a\n  "
			a href="#traversable-navigable" id="centralized-modifications-of-session-history:traversable-navigable-3" {
				- "traversable navigable"
			}
			- " "
			var {
				- "traversable"
			}
			- " given algorithm steps "
			var {
				- "steps"
			}
			- ",\n  "
			a href="https://infra.spec.whatwg.org/#list-append" id="centralized-modifications-of-session-history:list-append-2" data-x-internal="list-append" {
				- "append"
			}
			- " "
			var {
				- "steps"
			}
			- " as "
			a href="#session-history-traversal-parallel-queue-sync-nav-steps" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-sync-nav-steps" {
				- "synchronous navigation\n  steps"
			}
			- " targeting "
			a href="#session-history-traversal-parallel-queue-sync-nav-steps-target-nav" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-sync-nav-steps-target-nav" {
				- "target\n  navigable"
			}
			- " "
			var {
				- "targetNavigable"
			}
			- " to "
			var {
				- "traversable"
			}
			- "'s "
			a href="#tn-session-history-traversal-queue" id="centralized-modifications-of-session-history:tn-session-history-traversal-queue-2" {
				- "session history traversal queue"
			}
			- "'s "
			a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set-3" {
				- "algorithm set"
			}
			- "."
		}
		- "\n\n  "
		p id="session-history-event-loop" {
			- "To "
			dfn id="starting-a-new-session-history-traversal-parallel-queue" {
				- "start a new session history traversal parallel queue"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "sessionHistoryTraversalQueue"
					}
					- " be a new "
					a href="#session-history-traversal-parallel-queue" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-3" {
						- "session history traversal\n   parallel queue"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Run the following steps "
					a href="#in-parallel" id="centralized-modifications-of-session-history:in-parallel" {
						- "in parallel"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "While true:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "If "
									var {
										- "sessionHistoryTraversalQueue"
									}
									- "'s "
									a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set-4" {
										- "algorithm set"
									}
									- " is\n       empty, then "
									a id="centralized-modifications-of-session-history:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
										- "continue"
									}
									- "."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "steps"
									}
									- " be the result of "
									a href="https://infra.spec.whatwg.org/#queue-dequeue" id="centralized-modifications-of-session-history:dequeue" data-x-internal="dequeue" {
										- "dequeuing"
									}
									- " from\n       "
									var {
										- "sessionHistoryTraversalQueue"
									}
									- "'s "
									a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set-5" {
										- "algorithm\n       set"
									}
									- "."
								}
							}
							li {
								p {
									- "Run "
									var {
										- "steps"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "sessionHistoryTraversalQueue"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p id="sync-navigation-steps-queue-jumping-examples" {
			a href="#session-history-traversal-parallel-queue-sync-nav-steps" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-sync-nav-steps-2" {
				- "Synchronous navigation\n  steps"
			}
			- " are tagged in the "
			a href="#session-history-traversal-parallel-queue-algorithm-set" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-algorithm-set-6" {
				- "algorithm set"
			}
			- " to allow\n  them to conditionally \"jump the queue\". This is handled "
			a href="#sync-navigations-jump-queue" {
				- "within apply the history step"
			}
			- "."
		}
		- "\n\n  "
		div id="example-sync-navigation-steps-queue-jumping-basic" class="example" {
			- "\n   "
			p {
				- "Imagine the joint session history depicted by this "
				a href="#jake-diagram" id="centralized-modifications-of-session-history:jake-diagram" {
					- "Jake diagram"
				}
				- ":"
			}
			- "\n\n   \n   "
			table class="jake-diagram" {
				thead {
					tr {
						td
						th class="step" {
							- "0"
						}
						th class="step current" {
							- "1"
						}
					}
				}
				tbody {
					tr {
						th {
							code {
								- "top"
							}
						}
						td colspan="1" class="doc-0" {
							- "/a"
						}
						td colspan="1" class="doc-1 current" {
							- "/b"
						}
					}
				}
			}
			- "\n\n   "
			p {
				- "And the following code runs at the top level:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					- "history"
					c- p="" {
						- "."
					}
					- "back"
					c- p="" {
						- "();"
					}
					- "\nlocation"
					c- p="" {
						- "."
					}
					- "href "
					c- o="" {
						- "="
					}
					- " "
					c- t="" {
						- "'#foo'"
					}
					c- p="" {
						- ";"
					}
				}
			}
			- "\n\n   "
			p {
				- "The desired result is:"
			}
			- "\n\n   \n   "
			table class="jake-diagram" {
				thead {
					tr {
						td
						th class="step current" {
							- "0"
						}
						th class="step" {
							- "1"
						}
						th class="step" {
							- "2"
						}
					}
				}
				tbody {
					tr {
						th {
							code {
								- "top"
							}
						}
						td colspan="1" class="doc-0 current" {
							- "/a"
						}
						td colspan="1" class="doc-1 next-is-same-doc" {
							- "/b"
						}
						td colspan="1" class="doc-1 prev-is-same-doc" {
							- "/b#foo"
						}
					}
				}
			}
			- "\n\n   "
			p {
				- "This isn't straightforward, as the sync navigation wins the race in terms of being\n   observable, whereas the traversal wins the race in terms of queuing steps on the "
				a href="#session-history-traversal-parallel-queue" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-4" {
					- "session\n   history traversal parallel queue"
				}
				- ". To achieve this result, the following happens:"
			}
			- "\n\n   "
			ol {
				li {
					p {
						code id="centralized-modifications-of-session-history:dom-history-back" {
							a href="#dom-history-back" {
								- "history.back()"
							}
						}
						- " "
						a href="#tn-append-session-history-traversal-steps" id="centralized-modifications-of-session-history:tn-append-session-history-traversal-steps" {
							- "appends steps"
						}
						- " intended to traverse by\n    a delta of −1."
					}
				}
				li {
					p {
						code id="centralized-modifications-of-session-history:dom-location-href" {
							a href="#dom-location-href" {
								- "location.href = '#foo'"
							}
						}
						- " synchronously changes the\n    "
						a href="#nav-active-history-entry" id="centralized-modifications-of-session-history:nav-active-history-entry" {
							- "active session history entry"
						}
						- " entry to a\n    newly-created one, with the URL "
						code {
							- "/b#foo"
						}
						- ", and "
						a href="#tn-append-session-history-sync-nav-steps" id="centralized-modifications-of-session-history:tn-append-session-history-sync-nav-steps" {
							- "appends synchronous steps"
						}
						- " to notify\n    the central source of truth about that new entry. Note that this does "
						em {
							- "not"
						}
						- " yet update\n    the "
						a href="#nav-current-history-entry" id="centralized-modifications-of-session-history:nav-current-history-entry" {
							- "current session history entry"
						}
						- ", "
						a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step" {
							- "current session history step"
						}
						- ", or the "
						a href="#tn-session-history-entries" id="centralized-modifications-of-session-history:tn-session-history-entries-2" {
							- "session history entries"
						}
						- " list; those updates cannot\n    be done synchronously, and instead must be done as part of the queued steps."
					}
				}
				li {
					- "\n     "
					p {
						- "On the "
						a href="#session-history-traversal-parallel-queue" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-5" {
							- "session history traversal parallel queue"
						}
						- ", the steps queued by "
						code id="centralized-modifications-of-session-history:dom-history-back-2" {
							a href="#dom-history-back" {
								- "history.back()"
							}
						}
						- " run:"
					}
					- "\n\n     "
					ol {
						li {
							p {
								- "The target history step is determined to be 0: the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-2" {
									- "current session history step"
								}
								- " (i.e., 1) plus\n      the intended delta of −1."
							}
						}
						li {
							- "\n       "
							p {
								- "We enter the main "
								a href="#apply-the-history-step" id="centralized-modifications-of-session-history:apply-the-history-step" {
									- "apply the history step"
								}
								- " algorithm."
							}
							- "\n\n       "
							p {
								- "The entry at step 0, for the "
								code {
									- "/a"
								}
								- " URL, has its "
								a href="#she-document" id="centralized-modifications-of-session-history:she-document" {
									- "document"
								}
								- " "
								a href="#attempt-to-populate-the-history-entry's-document" id="centralized-modifications-of-session-history:attempt-to-populate-the-history-entry's-document" {
									- "populated"
								}
								- "."
							}
							- "\n\n       "
							p {
								- "Meanwhile, the queue is checked for "
								a href="#session-history-traversal-parallel-queue-sync-nav-steps" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-sync-nav-steps-3" {
									- "synchronous navigation\n       steps"
								}
								- ". The steps queued by the "
								code id="centralized-modifications-of-session-history:dom-location-href-2" {
									a href="#dom-location-href" {
										- "location.href"
									}
								}
								- "\n       setter now run, and block the traversal from performing effects beyond document population\n       (such as, unloading documents and switching active history entries) until they are finished.\n       Those steps cause the following to happen:"
							}
							- "\n\n       "
							ol {
								li {
									p {
										- "The entry with URL "
										code {
											- "/b#foo"
										}
										- " is added, with its "
										a href="#she-step" id="centralized-modifications-of-session-history:she-step" {
											- "step"
										}
										- " determined to be 2: the "
										a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-3" {
											- "current session history step"
										}
										- " (i.e., 1) plus\n        1."
									}
								}
								li {
									p {
										- "We fully switch to that newly added entry, including a nested call to "
										a href="#apply-the-history-step" id="centralized-modifications-of-session-history:apply-the-history-step-2" {
											- "apply\n        the history step"
										}
										- ". This ultimately results in "
										a href="#update-document-for-history-step-application" id="centralized-modifications-of-session-history:update-document-for-history-step-application" {
											- "updating the document"
										}
										- " by dispatching events like "
										code id="centralized-modifications-of-session-history:event-hashchange" {
											a href="#event-hashchange" {
												- "hashchange"
											}
										}
										- "."
									}
								}
							}
							- "\n\n       "
							p {
								- "Only once that is all complete, and the "
								code {
									- "/a"
								}
								- " history entry has been\n       fully populated with a "
								a href="#she-document" id="centralized-modifications-of-session-history:she-document-2" {
									- "document"
								}
								- ", do we move on with\n       applying the history step given the target step of 0."
							}
							- "\n\n       "
							p {
								- "At this point, the "
								code id="centralized-modifications-of-session-history:document" {
									a href="#document" {
										- "Document"
									}
								}
								- " with URL "
								code {
									- "/b#foo"
								}
								- " "
								a href="#unload-a-document" id="centralized-modifications-of-session-history:unload-a-document" {
									- "unloads"
								}
								- ", and we finish moving to our target history step\n       0, which makes the entry with URL "
								code {
									- "/a"
								}
								- " become the "
								a href="#nav-active-history-entry" id="centralized-modifications-of-session-history:nav-active-history-entry-2" {
									- "active session history entry"
								}
								- " and 0 become the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-4" {
									- "current session history step"
								}
								- "."
							}
							- "\n      "
						}
					}
					- "\n    "
				}
			}
			- "\n  "
		}
		- "\n\n  "
		div id="example-sync-navigation-steps-queue-jumping-complex" class="example" {
			- "\n   "
			p {
				- "Here is another more complex example, involving races between populating two different\n   "
				code id="centralized-modifications-of-session-history:the-iframe-element" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- "s, and a synchronous navigation once one of those iframes loads. We start\n   with this setup:"
			}
			- "\n\n   \n   "
			table class="jake-diagram" {
				thead {
					tr {
						td
						th class="step" {
							- "0"
						}
						th class="step" {
							- "1"
						}
						th class="step current" {
							- "2"
						}
					}
				}
				tbody {
					tr {
						th {
							code {
								- "top"
							}
						}
						td colspan="3" class="doc-0 current" {
							- "/t"
						}
					}
					tr {
						th {
							code {
								- "frames[0]"
							}
						}
						td colspan="1" class="doc-1" {
							- "/i-0-a"
						}
						td colspan="2" class="doc-2 current" {
							- "/i-0-b"
						}
					}
					tr {
						th {
							code {
								- "frames[1]"
							}
						}
						td colspan="2" class="doc-3" {
							- "/i-1-a"
						}
						td colspan="1" class="doc-4 current" {
							- "/i-1-b"
						}
					}
				}
			}
			- "\n\n   "
			p {
				- "and then call "
				code id="centralized-modifications-of-session-history:dom-history-go" {
					a href="#dom-history-go" {
						- "history.go(-2)"
					}
				}
				- ". The following then\n   occurs:"
			}
			- "\n\n   "
			ol {
				li {
					- "\n     "
					p {
						code id="centralized-modifications-of-session-history:dom-history-go-2" {
							a href="#dom-history-go" {
								- "history.go(-2)"
							}
						}
						- " "
						a href="#tn-append-session-history-traversal-steps" id="centralized-modifications-of-session-history:tn-append-session-history-traversal-steps-2" {
							- "appends steps"
						}
						- " intended to traverse\n     by a delta of −2. Once those steps run:"
					}
					- "\n\n     "
					ol {
						li {
							p {
								- "The target step is determined to be 2 + (−2) = 0."
							}
						}
						li {
							- "\n       "
							p {
								- "In parallel, the fetches are made to "
								a href="#attempt-to-populate-the-history-entry's-document" id="centralized-modifications-of-session-history:attempt-to-populate-the-history-entry's-document-2" {
									- "populate"
								}
								- " the two iframes, fetching "
								code {
									- "/i-0-a"
								}
								- "\n       and "
								code {
									- "/i-1-a"
								}
								- " respectively."
							}
							- "\n\n       "
							p {
								- "Meanwhile, the queue is checked for "
								a href="#session-history-traversal-parallel-queue-sync-nav-steps" id="centralized-modifications-of-session-history:session-history-traversal-parallel-queue-sync-nav-steps-4" {
									- "synchronous navigation\n       steps"
								}
								- ". There aren't any right now."
							}
							- "\n      "
						}
						li {
							p {
								- "In the fetch race, the fetch for "
								code {
									- "/i-0-a"
								}
								- " wins. We proceed onward\n      to finish all of "
								a href="#apply-the-history-step" id="centralized-modifications-of-session-history:apply-the-history-step-3" {
									- "apply the history step"
								}
								- "'s work for how the traversal impacts the\n      "
								code {
									- "frames[0]"
								}
								- " "
								a href="#navigable" id="centralized-modifications-of-session-history:navigable-4" {
									- "navigable"
								}
								- ", including updating its "
								a href="#nav-active-history-entry" id="centralized-modifications-of-session-history:nav-active-history-entry-3" {
									- "active session history entry"
								}
								- " to the entry with URL\n      "
								code {
									- "/i-0-a"
								}
								- "."
							}
						}
						li {
							- "\n       "
							p {
								- "Before the fetch for "
								code {
									- "/i-1-a"
								}
								- " finishes, we reach the point where\n       "
								a href="#scripts-may-run-for-the-newly-created-document" id="centralized-modifications-of-session-history:scripts-may-run-for-the-newly-created-document" {
									- "scripts may run for the newly-created document"
								}
								- " in the "
								code {
									- "frames[0]"
								}
								- " "
								a href="#navigable" id="centralized-modifications-of-session-history:navigable-5" {
									- "navigable"
								}
								- "'s "
								a href="#nav-document" id="centralized-modifications-of-session-history:nav-document" {
									- "active\n       document"
								}
								- ". Some such script does run:"
							}
							- "\n\n       "
							pre {
								code class="js" {
									- "location"
									c- p="" {
										- "."
									}
									- "href "
									c- o="" {
										- "="
									}
									- " "
									c- t="" {
										- "'#foo'"
									}
								}
							}
							- "\n\n       "
							p {
								- "This synchronously changes the "
								code {
									- "frames[0]"
								}
								- " navigable's "
								a href="#nav-active-history-entry" id="centralized-modifications-of-session-history:nav-active-history-entry-4" {
									- "active session history entry"
								}
								- " entry to a\n       newly-created one, with the URL "
								code {
									- "/i-0-a#foo"
								}
								- ", and "
								a href="#tn-append-session-history-sync-nav-steps" id="centralized-modifications-of-session-history:tn-append-session-history-sync-nav-steps-2" {
									- "appends synchronous steps"
								}
								- " to notify\n       the central source of truth about that new entry."
							}
							- "\n\n       "
							p {
								- "Unlike in the "
								a href="#example-sync-navigation-steps-queue-jumping-basic" {
									- "previous\n       example"
								}
								- ", these synchronous steps do "
								em {
									- "not"
								}
								- " \"jump the queue\" and update the "
								a href="#traversable-navigable" id="centralized-modifications-of-session-history:traversable-navigable-4" {
									- "traversable"
								}
								- " before we finish the fetch for "
								code {
									- "/i-1-a"
								}
								- ". This is because the navigable in question, "
								code {
									- "frames[0]"
								}
								- ", has already been altered as part of the traversal, so we know\n       that with the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-5" {
									- "current session history\n       step"
								}
								- " being 2, adding the new entry as a step 3 doesn't make sense."
							}
							- "\n      "
						}
						li {
							p {
								- "Once the fetch for "
								code {
									- "/i-1-a"
								}
								- " finally finishes, we proceed to finish\n      updating the "
								code {
									- "frames[1]"
								}
								- " "
								a href="#navigable" id="centralized-modifications-of-session-history:navigable-6" {
									- "navigable"
								}
								- " for the traversal,\n      including updating its "
								a href="#nav-active-history-entry" id="centralized-modifications-of-session-history:nav-active-history-entry-5" {
									- "active session history\n      entry"
								}
								- " to the entry with URL "
								code {
									- "/i-1-a"
								}
								- "."
							}
						}
						li {
							p {
								- "Now that both navigables have finished processing the traversal, we update the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-6" {
									- "current session history step"
								}
								- " to the target\n      step of 0."
							}
						}
					}
					- "\n    "
				}
				li {
					- "\n     "
					p {
						- "Now we can process the steps that were queued for the synchronous navigation:"
					}
					- "\n\n     "
					ol {
						li {
							p {
								- "The "
								code {
									- "/i-0-a#foo"
								}
								- " entry is added, with its "
								a href="#she-step" id="centralized-modifications-of-session-history:she-step-2" {
									- "step"
								}
								- " determined to be 1: the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-7" {
									- "current session history step"
								}
								- " (i.e., 0) plus\n      1. This also "
								a href="#clear-the-forward-session-history" id="centralized-modifications-of-session-history:clear-the-forward-session-history" {
									- "clears existing forward\n      history"
								}
								- "."
							}
						}
						li {
							p {
								- "We fully switch to that newly added entry, including calling "
								a href="#apply-the-history-step" id="centralized-modifications-of-session-history:apply-the-history-step-4" {
									- "apply the history\n      step"
								}
								- ". This ultimately results in "
								a href="#update-document-for-history-step-application" id="centralized-modifications-of-session-history:update-document-for-history-step-application-2" {
									- "updating the document"
								}
								- " by dispatching events like "
								code id="centralized-modifications-of-session-history:event-hashchange-2" {
									a href="#event-hashchange" {
										- "hashchange"
									}
								}
								- ", as well as updating the "
								a href="#tn-current-session-history-step" id="centralized-modifications-of-session-history:tn-current-session-history-step-8" {
									- "current session history step"
								}
								- " to the target\n      step of 1."
							}
						}
					}
					- "\n    "
				}
			}
			- "\n\n   "
			p {
				- "The end result is:"
			}
			- "\n\n   \n   "
			table class="jake-diagram" {
				thead {
					tr {
						td
						th class="step" {
							- "0"
						}
						th class="step current" {
							- "1"
						}
					}
				}
				tbody {
					tr {
						th {
							code {
								- "top"
							}
						}
						td colspan="2" class="doc-0 current" {
							- "/t"
						}
					}
					tr {
						th {
							code {
								- "frames[0]"
							}
						}
						td colspan="1" class="doc-1 next-is-same-doc" {
							- "/i-0-a"
						}
						td colspan="1" class="doc-1 current prev-is-same-doc" {
							- "/i-0-a#foo"
						}
					}
					tr {
						th {
							code {
								- "frames[1]"
							}
						}
						td colspan="2" class="doc-3 current" {
							- "/i-1-a"
						}
					}
				}
			}
			- "\n  "
		}
		- "\n\n\n  "
		h5 id="low-level-operations-on-session-history" {
			span class="secno" {
				- "7.4.1.4"
			}
			- " Low-level operations on session history"
			a href="#low-level-operations-on-session-history" class="self-link"
		}
		- "\n\n  "
		p {
			- "This section contains a miscellaneous grab-bag of operations that we perform throughout the\n  standard when manipulating session history. The best way to get a sense of what they do is to\n  look at their call sites."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="getting-session-history-entries" {
				- "get session history entries"
			}
			- " of a\n  "
			a href="#navigable" id="low-level-operations-on-session-history:navigable" {
				- "navigable"
			}
			- " "
			var {
				- "navigable"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "traversable"
					}
					- " be "
					var {
						- "navigable"
					}
					- "'s "
					a href="#nav-traversable" id="low-level-operations-on-session-history:nav-traversable" {
						- "traversable navigable"
					}
					- "."
				}
			}
			li {
				p {
					a id="low-level-operations-on-session-history:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": this is running within "
					var {
						- "traversable"
					}
					- "'s "
					a href="#tn-session-history-traversal-queue" id="low-level-operations-on-session-history:tn-session-history-traversal-queue" {
						- "session history traversal queue"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "navigable"
					}
					- " is "
					var {
						- "traversable"
					}
					- ", return "
					var {
						- "traversable"
					}
					- "'s "
					a href="#tn-session-history-entries" id="low-level-operations-on-session-history:tn-session-history-entries" {
						- "session history entries"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "docStates"
					}
					- " be an empty "
					a href="https://infra.spec.whatwg.org/#ordered-set" id="low-level-operations-on-session-history:set" data-x-internal="set" {
						- "ordered set"
					}
					- " of "
					a href="#document-state-2" id="low-level-operations-on-session-history:document-state-2" {
						- "document states"
					}
					- "."
				}
			}
			li {
				p {
					- "For each "
					var {
						- "entry"
					}
					- " of "
					var {
						- "traversable"
					}
					- "'s "
					a href="#tn-session-history-entries" id="low-level-operations-on-session-history:tn-session-history-entries-2" {
						- "session history entries"
					}
					- ", "
					a href="https://infra.spec.whatwg.org/#set-append" id="low-level-operations-on-session-history:set-append" data-x-internal="set-append" {
						- "append"
					}
					- " "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-document-state" id="low-level-operations-on-session-history:she-document-state" {
						- "document state"
					}
					- "\n   to "
					var {
						- "docStates"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="low-level-operations-on-session-history:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "docState"
					}
					- " of "
					var {
						- "docStates"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							a href="https://infra.spec.whatwg.org/#list-iterate" id="low-level-operations-on-session-history:list-iterate-2" data-x-internal="list-iterate" {
								- "For each"
							}
							- " "
							var {
								- "nestedHistory"
							}
							- " of\n      "
							var {
								- "docState"
							}
							- "'s "
							a href="#document-state-nested-histories" id="low-level-operations-on-session-history:document-state-nested-histories" {
								- "nested\n      histories"
							}
							- ":"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "If "
									var {
										- "nestedHistory"
									}
									- "'s "
									a href="#nested-history-id" id="low-level-operations-on-session-history:nested-history-id" {
										- "id"
									}
									- " equals\n       "
									var {
										- "navigable"
									}
									- "'s "
									a href="#nav-id" id="low-level-operations-on-session-history:nav-id" {
										- "id"
									}
									- ", return "
									var {
										- "nestedHistory"
									}
									- "'s\n       "
									a href="#nested-history-entries" id="low-level-operations-on-session-history:nested-history-entries" {
										- "entries"
									}
									- "."
								}
							}
							li {
								p {
									- "For each "
									var {
										- "entry"
									}
									- " of "
									var {
										- "nestedHistory"
									}
									- "'s "
									a href="#nested-history-entries" id="low-level-operations-on-session-history:nested-history-entries-2" {
										- "entries"
									}
									- ", "
									a href="https://infra.spec.whatwg.org/#set-append" id="low-level-operations-on-session-history:set-append-2" data-x-internal="set-append" {
										- "append"
									}
									- "\n       "
									var {
										- "entry"
									}
									- "'s "
									a href="#she-document-state" id="low-level-operations-on-session-history:she-document-state-2" {
										- "document state"
									}
									- " to\n       "
									var {
										- "docStates"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					a id="low-level-operations-on-session-history:assert-2" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": this step is not reached."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="getting-session-history-entries-for-the-navigation-api" {
				- "get session history\n  entries for the navigation API"
			}
			- " of a "
			a href="#navigable" id="low-level-operations-on-session-history:navigable-2" {
				- "navigable"
			}
			- " "
			var {
				- "navigable"
			}
			- " given an\n  integer "
			var {
				- "targetStep"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "rawEntries"
					}
					- " be the result of "
					a href="#getting-session-history-entries" id="low-level-operations-on-session-history:getting-session-history-entries" {
						- "getting session history entries"
					}
					- "\n   for "
					var {
						- "navigable"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "entriesForNavigationAPI"
					}
					- " be a new empty "
					a id="low-level-operations-on-session-history:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "startingIndex"
					}
					- " be the index of the "
					a href="#session-history-entry" id="low-level-operations-on-session-history:session-history-entry" {
						- "session history entry"
					}
					- " in\n    "
					var {
						- "rawEntries"
					}
					- " who has the greatest "
					a href="#she-step" id="low-level-operations-on-session-history:she-step" {
						- "step"
					}
					- " less than or\n    equal to "
					var {
						- "targetStep"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "See "
					a href="#example-getting-the-target-history-entry" {
						- "this example"
					}
					- " to\n    understand why it's the greatest step less than or equal to "
					var {
						- "targetStep"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					a href="https://infra.spec.whatwg.org/#list-append" id="low-level-operations-on-session-history:list-append" data-x-internal="list-append" {
						- "Append"
					}
					- " "
					var {
						- "rawEntries"
					}
					- "["
					var {
						- "startingIndex"
					}
					- "]\n   to "
					var {
						- "entriesForNavigationAPI"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "startingOrigin"
					}
					- " be "
					var {
						- "rawEntries"
					}
					- "["
					var {
						- "startingIndex"
					}
					- "]'s "
					a href="#she-document-state" id="low-level-operations-on-session-history:she-document-state-3" {
						- "document state"
					}
					- "'s "
					a href="#document-state-origin" id="low-level-operations-on-session-history:document-state-origin" {
						- "origin"
					}
					- "."
				}
			}
