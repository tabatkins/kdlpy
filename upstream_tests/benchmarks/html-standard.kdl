						- "<"
					}
					c- f="" {
						- "ul"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "li"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"flavor\""
					}
					c- p="" {
						- ">"
					}
					- "Lemon sorbet"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "li"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "li"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
