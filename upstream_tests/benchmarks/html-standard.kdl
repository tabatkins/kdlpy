							- " named\n      "
							code id="loading-the-media-resource:event-media-suspend-5" {
								a href="#event-media-suspend" {
									- "suspend"
								}
							}
							- " at the "
							a href="#media-element" id="loading-the-media-resource:media-element-63" {
								- "media element"
							}
							- "."
						}
						- "\n\n      "
						p {
							- "If the user agent ever discards any "
							a href="#media-data" id="loading-the-media-resource:media-data-11" {
								- "media data"
							}
							- " and then needs to resume the\n      network activity to obtain it again, then it must "
							a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-20" {
								- "queue a media element task"
							}
							- "\n      given the "
							a href="#media-element" id="loading-the-media-resource:media-element-64" {
								- "media element"
							}
							- " to set the "
							code id="loading-the-media-resource:dom-media-networkstate-15" {
								a href="#dom-media-networkstate" {
									- "networkState"
								}
							}
							- " to "
							code id="loading-the-media-resource:dom-media-network_loading-6" {
								a href="#dom-media-network_loading" {
									- "NETWORK_LOADING"
								}
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "If the user agent can keep the "
							a href="#media-resource" id="loading-the-media-resource:media-resource-18" {
								- "media resource"
							}
							- " loaded, then the\n      algorithm will continue to its "
							i {
								- "final step"
							}
							- " below, which aborts the algorithm."
						}
						- "\n     "
					}
					dt {
						- "If the connection is interrupted after some "
						a href="#media-data" id="loading-the-media-resource:media-data-12" {
							- "media data"
						}
						- " has been received,\n     causing the user agent to give up trying to fetch the resource"
					}
					dd {
						- "\n      "
						p {
							- "Fatal network errors that occur after the user agent has established whether the "
							var {
								- "current media resource"
							}
							- " is usable (i.e. once the "
							a href="#media-element" id="loading-the-media-resource:media-element-65" {
								- "media element"
							}
							- "'s\n      "
							code id="loading-the-media-resource:dom-media-readystate-5" {
								a href="#dom-media-readystate" {
									- "readyState"
								}
							}
							- " attribute is no longer "
							code id="loading-the-media-resource:dom-media-have_nothing-2" {
								a href="#dom-media-have_nothing" {
									- "HAVE_NOTHING"
								}
							}
							- ") must cause the user agent to execute the\n      following steps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "The user agent should cancel the fetching process."
								}
							}
							li {
								p {
									- "Set the "
									code id="loading-the-media-resource:dom-media-error-3" {
										a href="#dom-media-error" {
											- "error"
										}
									}
									- " attribute to the result of\n       "
									a href="#creating-a-mediaerror" id="loading-the-media-resource:creating-a-mediaerror-2" {
										- "creating a "
										code {
											- "MediaError"
										}
									}
									- " with "
									code id="loading-the-media-resource:dom-mediaerror-media_err_network" {
										a href="#dom-mediaerror-media_err_network" {
											- "MEDIA_ERR_NETWORK"
										}
									}
									- "."
								}
							}
							li {
								p {
									- "Set the element's "
									code id="loading-the-media-resource:dom-media-networkstate-16" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- " attribute\n       to the "
									code id="loading-the-media-resource:dom-media-network_idle-6" {
										a href="#dom-media-network_idle" {
											- "NETWORK_IDLE"
										}
									}
									- " value."
								}
							}
							li {
								p {
									- "Set the element's "
									a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-11" {
										- "delaying-the-load-event flag"
									}
									- " to false. This stops "
									a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-11" {
										- "delaying the load event"
									}
									- "."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-17" data-x-internal="concept-event-fire" {
										- "Fire an event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-error-2" {
										a href="#event-media-error" {
											- "error"
										}
									}
									- " at the "
									a href="#media-element" id="loading-the-media-resource:media-element-66" {
										- "media element"
									}
									- "."
								}
							}
							li {
								p {
									- "Abort the overall "
									a href="#concept-media-load-algorithm" id="loading-the-media-resource:concept-media-load-algorithm-4" {
										- "resource selection\n       algorithm"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					dt id="fatal-decode-error" {
						- "If the "
						a href="#media-data" id="loading-the-media-resource:media-data-13" {
							- "media data"
						}
						- " is corrupted"
					}
					dd {
						- "\n      "
						p {
							- "Fatal errors in decoding the "
							a href="#media-data" id="loading-the-media-resource:media-data-14" {
								- "media data"
							}
							- " that occur after the user agent has\n      established whether the "
							var {
								- "current media resource"
							}
							- " is usable (i.e. once the "
							a href="#media-element" id="loading-the-media-resource:media-element-67" {
								- "media element"
							}
							- "'s\n      "
							code id="loading-the-media-resource:dom-media-readystate-6" {
								a href="#dom-media-readystate" {
									- "readyState"
								}
							}
							- " attribute is no longer "
							code id="loading-the-media-resource:dom-media-have_nothing-3" {
								a href="#dom-media-have_nothing" {
									- "HAVE_NOTHING"
								}
							}
							- ") must cause the\n      user agent to execute the following steps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "The user agent should cancel the fetching process."
								}
							}
							li {
								p {
									- "Set the "
									code id="loading-the-media-resource:dom-media-error-4" {
										a href="#dom-media-error" {
											- "error"
										}
									}
									- " attribute to the result of\n       "
									a href="#creating-a-mediaerror" id="loading-the-media-resource:creating-a-mediaerror-3" {
										- "creating a "
										code {
											- "MediaError"
										}
									}
									- " with "
									code id="loading-the-media-resource:dom-mediaerror-media_err_decode" {
										a href="#dom-mediaerror-media_err_decode" {
											- "MEDIA_ERR_DECODE"
										}
									}
									- "."
								}
							}
							li {
								p {
									- "Set the element's "
									code id="loading-the-media-resource:dom-media-networkstate-17" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- " attribute\n       to the "
									code id="loading-the-media-resource:dom-media-network_idle-7" {
										a href="#dom-media-network_idle" {
											- "NETWORK_IDLE"
										}
									}
									- " value."
								}
							}
							li {
								p {
									- "Set the element's "
									a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-12" {
										- "delaying-the-load-event flag"
									}
									- " to false. This stops "
									a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-12" {
										- "delaying the load event"
									}
									- "."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-18" data-x-internal="concept-event-fire" {
										- "Fire an event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-error-3" {
										a href="#event-media-error" {
											- "error"
										}
									}
									- " at the "
									a href="#media-element" id="loading-the-media-resource:media-element-68" {
										- "media element"
									}
									- "."
								}
							}
							li {
								p {
									- "Abort the overall "
									a href="#concept-media-load-algorithm" id="loading-the-media-resource:concept-media-load-algorithm-5" {
										- "resource selection\n       algorithm"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					dt {
						- "If the "
						a href="#media-data" id="loading-the-media-resource:media-data-15" {
							- "media data"
						}
						- " fetching process is aborted by the user"
					}
					dd {
						- "\n      "
						p {
							- "The fetching process is aborted by the user, e.g. because the user\n      pressed a \"stop\" button, the user agent must execute the following steps. These steps are not\n      followed if the "
							code id="loading-the-media-resource:dom-media-load" {
								a href="#dom-media-load" {
									- "load()"
								}
							}
							- " method itself is invoked while\n      these steps are running, as the steps above handle that particular kind of abort."
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "The user agent should cancel the fetching process."
								}
							}
							li {
								p {
									- "Set the "
									code id="loading-the-media-resource:dom-media-error-5" {
										a href="#dom-media-error" {
											- "error"
										}
									}
									- " attribute to the result of\n       "
									a href="#creating-a-mediaerror" id="loading-the-media-resource:creating-a-mediaerror-4" {
										- "creating a "
										code {
											- "MediaError"
										}
									}
									- " with "
									code id="loading-the-media-resource:dom-mediaerror-media_err_aborted" {
										a href="#dom-mediaerror-media_err_aborted" {
											- "MEDIA_ERR_ABORTED"
										}
									}
									- "."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-19" data-x-internal="concept-event-fire" {
										- "Fire an event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-abort-2" {
										a href="#event-media-abort" {
											- "abort"
										}
									}
									- " at the "
									a href="#media-element" id="loading-the-media-resource:media-element-69" {
										- "media element"
									}
									- "."
								}
							}
							li {
								- "\n        "
								p {
									- "If the "
									a href="#media-element" id="loading-the-media-resource:media-element-70" {
										- "media element"
									}
									- "'s "
									code id="loading-the-media-resource:dom-media-readystate-7" {
										a href="#dom-media-readystate" {
											- "readyState"
										}
									}
									- "\n        attribute has a value equal to "
									code id="loading-the-media-resource:dom-media-have_nothing-4" {
										a href="#dom-media-have_nothing" {
											- "HAVE_NOTHING"
										}
									}
									- ", set\n        the element's "
									code id="loading-the-media-resource:dom-media-networkstate-18" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- " attribute to the\n        "
									code id="loading-the-media-resource:dom-media-network_empty-3" {
										a href="#dom-media-network_empty" {
											- "NETWORK_EMPTY"
										}
									}
									- " value, set the element's\n        "
									a href="#show-poster-flag" id="loading-the-media-resource:show-poster-flag-4" {
										- "show poster flag"
									}
									- " to true, and "
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-20" data-x-internal="concept-event-fire" {
										- "fire an\n        event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-emptied-2" {
										a href="#event-media-emptied" {
											- "emptied"
										}
									}
									- " at the element."
								}
								- "\n\n        "
								p {
									- "Otherwise, set the element's "
									code id="loading-the-media-resource:dom-media-networkstate-19" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- "\n        attribute to the "
									code id="loading-the-media-resource:dom-media-network_idle-8" {
										a href="#dom-media-network_idle" {
											- "NETWORK_IDLE"
										}
									}
									- " value."
								}
								- "\n       "
							}
							li {
								p {
									- "Set the element's "
									a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-13" {
										- "delaying-the-load-event flag"
									}
									- " to false. This stops "
									a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-13" {
										- "delaying the load event"
									}
									- "."
								}
							}
							li {
								p {
									- "Abort the overall "
									a href="#concept-media-load-algorithm" id="loading-the-media-resource:concept-media-load-algorithm-6" {
										- "resource selection\n       algorithm"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					dt id="non-fatal-media-error" {
						- "If the "
						a href="#media-data" id="loading-the-media-resource:media-data-16" {
							- "media data"
						}
						- " can be fetched but has non-fatal\n     errors or uses, in part, codecs that are unsupported, preventing the user agent from rendering\n     the content completely correctly but not preventing playback altogether"
					}
					dd {
						- "\n      "
						p {
							- "The server returning data that is partially usable but cannot be optimally rendered must\n      cause the user agent to render just the bits it can handle, and ignore the rest."
						}
						- "\n\n      \n     "
					}
					dt id="found-a-media-resource-specific-timed-track" {
						- "If the "
						a href="#media-resource" id="loading-the-media-resource:media-resource-19" {
							- "media resource"
						}
						- " is\n     found to declare a "
						a href="#media-resource-specific-text-track" id="loading-the-media-resource:media-resource-specific-text-track-2" {
							- "media-resource-specific text track"
						}
						- " that the user agent\n     supports"
					}
					dd {
						- "\n      "
						p {
							- "If the "
							a href="#media-data" id="loading-the-media-resource:media-data-17" {
								- "media data"
							}
							- " is "
							a href="#cors-same-origin" id="loading-the-media-resource:cors-same-origin-3" {
								- "CORS-same-origin"
							}
							- ", run the "
							a href="#steps-to-expose-a-media-resource-specific-text-track" id="loading-the-media-resource:steps-to-expose-a-media-resource-specific-text-track" {
								- "steps to\n      expose a media-resource-specific text track"
							}
							- " with the relevant data."
						}
						- "\n\n      "
						p class="note" {
							- "Cross-origin videos do not expose their subtitles, since that would allow\n      attacks such as hostile sites reading subtitles from confidential videos on a user's\n      intranet."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					i {
						- "Final step"
					}
					- ": If the user agent ever reaches this step (which can only happen if the entire resource\n   gets loaded and kept available): abort the overall "
					a href="#concept-media-load-algorithm" id="loading-the-media-resource:concept-media-load-algorithm-7" {
						- "resource selection algorithm"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#media-element" id="loading-the-media-resource:media-element-71" {
				- "media element"
			}
			- " is to "
			dfn id="forget-the-media-element's-media-resource-specific-tracks" {
				- "forget the media element's media-resource-specific\n  tracks"
			}
			- ", the user agent must remove from the "
			a href="#media-element" id="loading-the-media-resource:media-element-72" {
				- "media element"
			}
			- "'s "
			a href="#list-of-text-tracks" id="loading-the-media-resource:list-of-text-tracks" {
				- "list of text\n  tracks"
			}
			- " all the "
			a href="#media-resource-specific-text-track" id="loading-the-media-resource:media-resource-specific-text-track-3" {
				- "media-resource-specific\n  text tracks"
			}
			- ", then empty the "
			a href="#media-element" id="loading-the-media-resource:media-element-73" {
				- "media element"
			}
			- "'s "
			code id="loading-the-media-resource:dom-media-audiotracks-2" {
				a href="#dom-media-audiotracks" {
					- "audioTracks"
				}
			}
			- " attribute's "
			code id="loading-the-media-resource:audiotracklist-3" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " object,\n  then empty the "
			a href="#media-element" id="loading-the-media-resource:media-element-74" {
				- "media element"
			}
			- "'s "
			code id="loading-the-media-resource:dom-media-videotracks-2" {
				a href="#dom-media-videotracks" {
					- "videoTracks"
				}
			}
			- "\n  attribute's "
			code id="loading-the-media-resource:videotracklist-3" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object. No events (in particular, no "
			code id="loading-the-media-resource:event-media-removetrack" {
				a href="#event-media-removetrack" {
					- "removetrack"
				}
			}
			- " events) are fired as part of this; the "
			code id="loading-the-media-resource:event-media-error-4" {
				a href="#event-media-error" {
					- "error"
				}
			}
			- " and "
			code id="loading-the-media-resource:event-media-emptied-3" {
				a href="#event-media-emptied" {
					- "emptied"
				}
			}
			- "\n  events, fired by the algorithms that invoke this one, can be used instead."
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="audio,video" id="attr-media-preload" data-dfn-type="element-attr" {
				code {
					- "preload"
				}
			}
			- "\n  attribute is an "
			a href="#enumerated-attribute" id="loading-the-media-resource:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following keywords and\n  states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="audio/preload,video/preload" id="attr-media-preload-auto" data-dfn-type="attr-value" {
							code {
								- "auto"
							}
						}
						- "\n     "
					}
					td rowspan="2" {
						dfn id="attr-media-preload-auto-state" {
							- "Automatic"
						}
						- "\n     "
					}
					td rowspan="2" {
						- "Hints to the user agent that the user agent can put the user's needs first without risk to the server, up to and including optimistically downloading the entire resource.\n    "
					}
				}
				tr {
					td {
						- "(the empty string)\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="audio/preload,video/preload" id="attr-media-preload-none" data-dfn-type="attr-value" {
							code {
								- "none"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-media-preload-none-state" {
							- "None"
						}
						- "\n     "
					}
					td {
						- "Hints to the user agent that either the author does not expect the user to need the media resource, or that the server wants to minimize unnecessary traffic.\n         This state does not provide a hint regarding how aggressively to actually download the media resource if buffering starts anyway (e.g. once the user hits \"play\").\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="audio/preload,video/preload" id="attr-media-preload-metadata" data-dfn-type="attr-value" {
							code {
								- "metadata"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-media-preload-metadata-state" {
							- "Metadata"
						}
						- "\n     "
					}
					td {
						- "Hints to the user agent that the author does not expect the user to need the media resource, but that fetching the resource metadata (dimensions, track list, duration, etc.), and maybe even the first few frames, is reasonable. If the user agent precisely fetches no more than the metadata, then the "
						a href="#media-element" id="loading-the-media-resource:media-element-75" {
							- "media element"
						}
						- " will end up with its "
						code id="loading-the-media-resource:dom-media-readystate-8" {
							a href="#dom-media-readystate" {
								- "readyState"
							}
						}
						- " attribute set to "
						code id="loading-the-media-resource:dom-media-have_metadata-2" {
							a href="#dom-media-have_metadata" {
								- "HAVE_METADATA"
							}
						}
						- "; typically though, some frames will be obtained as well and it will probably be "
						code id="loading-the-media-resource:dom-media-have_current_data-2" {
							a href="#dom-media-have_current_data" {
								- "HAVE_CURRENT_DATA"
							}
						}
						- " or "
						code id="loading-the-media-resource:dom-media-have_future_data" {
							a href="#dom-media-have_future_data" {
								- "HAVE_FUTURE_DATA"
							}
						}
						- ".\n         When the media resource is playing, hints to the user agent that bandwidth is to be considered scarce, e.g. suggesting throttling the download so that the media data is obtained at the slowest possible rate that still maintains consistent playback.\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="loading-the-media-resource:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="loading-the-media-resource:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both\n  "
			a id="loading-the-media-resource:implementation-defined-4" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- ", though the "
			a href="#attr-media-preload-metadata-state" id="loading-the-media-resource:attr-media-preload-metadata-state" {
				- "Metadata"
			}
			- " state is suggested as a compromise\n  between reducing server load and providing an optimal user experience."
		}
		- "\n\n  "
		p {
			- "The attribute can be changed even once the "
			a href="#media-resource" id="loading-the-media-resource:media-resource-20" {
				- "media resource"
			}
			- " is being buffered or\n  played; the descriptions in the table above are to be interpreted with that in mind."
		}
		- "\n\n  "
		p class="note" {
			- "Authors might switch the attribute from \""
			code id="loading-the-media-resource:attr-media-preload-none-2" {
				a href="#attr-media-preload-none" {
					- "none"
				}
			}
			- "\" or \""
			code id="loading-the-media-resource:attr-media-preload-metadata" {
				a href="#attr-media-preload-metadata" {
					- "metadata"
				}
			}
			- "\" to \""
			code id="loading-the-media-resource:attr-media-preload-auto" {
				a href="#attr-media-preload-auto" {
					- "auto"
				}
			}
			- "\" dynamically once the user begins playback. For\n  example, on a page with many videos this might be used to indicate that the many videos are not to\n  be downloaded unless requested, but that once one "
			em {
				- "is"
			}
			- " requested it is to be downloaded\n  aggressively."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="loading-the-media-resource:attr-media-preload-3" {
				a href="#attr-media-preload" {
					- "preload"
				}
			}
			- " attribute is intended to provide a hint to\n  the user agent about what the author thinks will lead to the best user experience. The attribute\n  may be ignored altogether, for example based on explicit user preferences or based on the\n  available connectivity."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-preload" data-dfn-type="attribute" {
				code {
					- "preload"
				}
			}
			- "\n  IDL attribute must "
			a href="#reflect" id="loading-the-media-resource:reflect" {
				- "reflect"
			}
			- " the content attribute of the same name, "
			a href="#limited-to-only-known-values" id="loading-the-media-resource:limited-to-only-known-values" {
				- "limited to\n  only known values"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "The "
			code id="loading-the-media-resource:attr-media-autoplay-2" {
				a href="#attr-media-autoplay" {
					- "autoplay"
				}
			}
			- " attribute can override the\n  "
			code id="loading-the-media-resource:attr-media-preload-4" {
				a href="#attr-media-preload" {
					- "preload"
				}
			}
			- " attribute (since if the media plays, it naturally\n  has to buffer first, regardless of the hint given by the "
			code id="loading-the-media-resource:attr-media-preload-5" {
				a href="#attr-media-preload" {
					- "preload"
				}
			}
			- " attribute). Including both is not an error, however."
		}
		- "\n\n  "
		hr
		- "\n\n\n\n  "
		dl class="domintro" {
