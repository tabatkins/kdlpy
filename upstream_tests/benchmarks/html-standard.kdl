						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push the node pointed to by the "
					a href="#head-element-pointer" id="the-after-head-insertion-mode:head-element-pointer" {
						code {
							- "head"
						}
						- " element pointer"
					}
					- " onto\n    the "
					a href="#stack-of-open-elements" id="the-after-head-insertion-mode:stack-of-open-elements" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="the-after-head-insertion-mode:using-the-rules-for-2" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inhead" id="the-after-head-insertion-mode:parsing-main-inhead" {
						- "in head"
					}
					- "\" "
					a href="#insertion-mode" id="the-after-head-insertion-mode:insertion-mode-5" {
						- "insertion mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Remove the node pointed to by the "
					a href="#head-element-pointer" id="the-after-head-insertion-mode:head-element-pointer-2" {
						code {
							- "head"
						}
						- " element pointer"
					}
					- "\n    from the "
					a href="#stack-of-open-elements" id="the-after-head-insertion-mode:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- ". (It might not be the "
					a href="#current-node" id="the-after-head-insertion-mode:current-node" {
						- "current node"
					}
					- " at\n    this point.)"
				}
				- "\n\n    "
				p class="note" {
					- "The "
					a href="#head-element-pointer" id="the-after-head-insertion-mode:head-element-pointer-3" {
						code {
							- "head"
						}
						- " element pointer"
					}
					- " cannot be null at\n    this point."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"template\""
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="the-after-head-insertion-mode:using-the-rules-for-3" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inhead" id="the-after-head-insertion-mode:parsing-main-inhead-2" {
						- "in head"
					}
					- "\" "
					a href="#insertion-mode" id="the-after-head-insertion-mode:insertion-mode-6" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"body\", \"html\", \"br\""
			}
			dd {
				- "\n    "
				p {
					- "Act as described in the \"anything else\" entry below."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"head\""
			}
			dt {
				- "Any other end tag"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="the-after-head-insertion-mode:parse-errors-3" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "Anything else"
			}
			dd {
				- "\n    \n    "
				p {
					a href="#insert-an-html-element" id="the-after-head-insertion-mode:insert-an-html-element-3" {
						- "Insert an HTML element"
					}
					- " for a \"body\" start tag token with no attributes."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="the-after-head-insertion-mode:insertion-mode-7" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inbody" id="the-after-head-insertion-mode:parsing-main-inbody-3" {
						- "in\n    body"
					}
					- "\"."
				}
				- "\n    \n\n    "
				p {
					- "Reprocess the current token."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="parsing-main-inbody" {
			span class="secno" {
				- "13.2.6.4.7"
			}
			- " The \""
			dfn {
				- "in body"
			}
			- "\" insertion mode"
			a href="#parsing-main-inbody" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-inbody" id="parsing-main-inbody:parsing-main-inbody" {
				- "in\n  body"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-inbody:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token that is U+0000 NULL"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n\n    \n   "
			}
			dt {
				- "A character token that is one of U+0009 CHARACTER TABULATION,\n   U+000A LINE FEED (LF), U+000C FORM FEED (FF), U+000D CARRIAGE\n   RETURN (CR), or U+0020 SPACE"
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-a-character" id="parsing-main-inbody:insert-a-character" {
						- "Insert the token's character"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "Any other character token"
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-2" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-a-character" id="parsing-main-inbody:insert-a-character-2" {
						- "Insert the token's character"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Set the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"."
				}
				- "\n   "
			}
			dt {
				- "A comment token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-comment" id="parsing-main-inbody:insert-a-comment" {
						- "Insert a comment"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A DOCTYPE token"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-2" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"html\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-3" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If there is a "
					code id="parsing-main-inbody:the-template-element" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements" {
						- "stack of open elements"
					}
					- ", then\n    ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, for each attribute on the token, check to see if the attribute is already present\n    on the top element of the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- ". If it is not, add the attribute\n    and its corresponding value to that element."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"base\", \"basefont\", \"bgsound\", \"link\", \"meta\",\n   \"noframes\", \"script\", \"style\", \"template\", \"title\""
			}
			dt {
				- "An end tag whose tag name is \"template\""
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-inbody:using-the-rules-for" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inhead" id="parsing-main-inbody:parsing-main-inhead" {
						- "in head"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-inbody:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"body\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-4" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-3" {
						- "stack of open elements"
					}
					- " has only one node on it, if the second element\n    on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-4" {
						- "stack of open elements"
					}
					- " is not a "
					code id="parsing-main-inbody:the-body-element" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element, or if there is a\n    "
					code id="parsing-main-inbody:the-template-element-2" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-5" {
						- "stack of open elements"
					}
					- ", then ignore the token.\n    ("
					a href="#fragment-case" id="parsing-main-inbody:fragment-case" {
						- "fragment case"
					}
					- " or there is a "
					code id="parsing-main-inbody:the-template-element-3" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the stack)"
				}
				- "\n\n    "
				p {
					- "Otherwise, set the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag-2" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"; then, for each attribute on the\n    token, check to see if the attribute is already present on the "
					code id="parsing-main-inbody:the-body-element-2" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element (the\n    second element) on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-6" {
						- "stack of open elements"
					}
					- ", and if it is not, add the attribute\n    and its corresponding value to that element."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"frameset\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-5" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-7" {
						- "stack of open elements"
					}
					- " has only one node on it, or if the second element\n    on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-8" {
						- "stack of open elements"
					}
					- " is not a "
					code id="parsing-main-inbody:the-body-element-3" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element, then ignore the\n    token. ("
					a href="#fragment-case" id="parsing-main-inbody:fragment-case-2" {
						- "fragment case"
					}
					- " or there is a "
					code id="parsing-main-inbody:the-template-element-4" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the\n    stack)"
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag-3" {
						- "frameset-ok flag"
					}
					- " is set to \"not ok\", ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, run the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Remove the second element on the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-9" {
								- "stack of open elements"
							}
							- " from its parent\n     node, if it has one."
						}
					}
					li {
						p {
							- "Pop all the nodes from the bottom of the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-10" {
								- "stack of open elements"
							}
							- ", from the\n     "
							a href="#current-node" id="parsing-main-inbody:current-node" {
								- "current node"
							}
							- " up to, but not including, the root "
							code id="parsing-main-inbody:the-html-element" {
								a href="#the-html-element" {
									- "html"
								}
							}
							- " element."
						}
						- "\n\n     "
					}
					li {
						p {
							a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element" {
								- "Insert an HTML element"
							}
							- " for the token."
						}
					}
					li {
						p {
							- "Switch the "
							a href="#insertion-mode" id="parsing-main-inbody:insertion-mode-3" {
								- "insertion mode"
							}
							- " to \""
							a href="#parsing-main-inframeset" id="parsing-main-inbody:parsing-main-inframeset" {
								- "in\n     frameset"
							}
							- "\"."
						}
						- "\n    "
					}
				}
				- "\n   "
			}
			dt {
				- "An end-of-file token"
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-inbody:stack-of-template-insertion-modes" {
						- "stack of template insertion modes"
					}
					- " is not empty, then process the token\n    "
					a href="#using-the-rules-for" id="parsing-main-inbody:using-the-rules-for-2" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-intemplate" id="parsing-main-inbody:parsing-main-intemplate" {
						- "in\n    template"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-inbody:insertion-mode-4" {
						- "insertion mode"
					}
					- "."
				}
				- "\n    \n\n    "
				p {
					- "Otherwise, follow these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If there is a node in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-11" {
								- "stack of open elements"
							}
							- " that is not either a\n     "
							code id="parsing-main-inbody:the-dd-element" {
								a href="#the-dd-element" {
									- "dd"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-dt-element" {
								a href="#the-dt-element" {
									- "dt"
								}
							}
							- " element, an "
							code id="parsing-main-inbody:the-li-element" {
								a href="#the-li-element" {
									- "li"
								}
							}
							- " element, an\n     "
							code id="parsing-main-inbody:the-optgroup-element" {
								a href="#the-optgroup-element" {
									- "optgroup"
								}
							}
							- " element, an "
							code id="parsing-main-inbody:the-option-element" {
								a href="#the-option-element" {
									- "option"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-p-element" {
								a href="#the-p-element" {
									- "p"
								}
							}
							- " element, an\n     "
							code id="parsing-main-inbody:rb" {
								a href="#rb" {
									- "rb"
								}
							}
							- " element, an "
							code id="parsing-main-inbody:the-rp-element" {
								a href="#the-rp-element" {
									- "rp"
								}
							}
							- " element, an "
							code id="parsing-main-inbody:the-rt-element" {
								a href="#the-rt-element" {
									- "rt"
								}
							}
							- " element, an\n     "
							code id="parsing-main-inbody:rtc" {
								a href="#rtc" {
									- "rtc"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-tbody-element" {
								a href="#the-tbody-element" {
									- "tbody"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-td-element" {
								a href="#the-td-element" {
									- "td"
								}
							}
							- " element, a\n     "
							code id="parsing-main-inbody:the-tfoot-element" {
								a href="#the-tfoot-element" {
									- "tfoot"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-th-element" {
								a href="#the-th-element" {
									- "th"
								}
							}
							- " element, a "
							code id="parsing-main-inbody:the-thead-element" {
								a href="#the-thead-element" {
									- "thead"
								}
							}
							- " element, a\n     "
							code id="parsing-main-inbody:the-tr-element" {
								a href="#the-tr-element" {
									- "tr"
								}
							}
							- " element, the "
							code id="parsing-main-inbody:the-body-element-4" {
								a href="#the-body-element" {
									- "body"
								}
							}
							- " element, or the "
							code id="parsing-main-inbody:the-html-element-2" {
								a href="#the-html-element" {
									- "html"
								}
							}
							- " element, then\n     this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-6" {
								- "parse error"
							}
							- "."
						}
					}
					li {
						p {
							a href="#stop-parsing" id="parsing-main-inbody:stop-parsing" {
								- "Stop parsing"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"body\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-12" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope" {
						- "have a "
						code {
							- "body"
						}
						- " element in scope"
					}
					- ", this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-7" {
						- "parse error"
					}
					- ";\n    ignore the token."
				}
				- "\n\n    \n\n    "
				p {
					- "Otherwise, if there is a node in the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-13" {
						- "stack of open elements"
					}
					- " that is not either a\n    "
					code id="parsing-main-inbody:the-dd-element-2" {
						a href="#the-dd-element" {
							- "dd"
						}
					}
					- " element, a "
					code id="parsing-main-inbody:the-dt-element-2" {
						a href="#the-dt-element" {
							- "dt"
						}
					}
					- " element, an "
					code id="parsing-main-inbody:the-li-element-2" {
						a href="#the-li-element" {
							- "li"
						}
					}
					- " element, an\n    "
					code id="parsing-main-inbody:the-optgroup-element-2" {
						a href="#the-optgroup-element" {
							- "optgroup"
						}
					}
					- " element, an "
					code id="parsing-main-inbody:the-option-element-2" {
						a href="#the-option-element" {
							- "option"
						}
					}
					- " element, a "
					code id="parsing-main-inbody:the-p-element-2" {
