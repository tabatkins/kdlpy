		- "\n\n\n  "
		h6 id="building-paths" {
			span class="secno" {
				- "4.12.5.1.5"
			}
			- " Building paths"
			a href="#building-paths" class="self-link"
		}
		- "\n\n  "
		p {
			- "Objects that implement the "
			code id="building-paths:canvaspath" {
				a href="#canvaspath" {
					- "CanvasPath"
				}
			}
			- " interface have a "
			a href="#concept-path" id="building-paths:concept-path" {
				- "path"
			}
			- ". A "
			dfn id="concept-path" {
				- "path"
			}
			- " has a list of zero or\n  more subpaths. Each subpath consists of a list of one or more points, connected by straight or\n  curved "
			dfn id="line-segments" {
				- "line segments"
			}
			- ", and a flag indicating whether the subpath is closed or not. A\n  closed subpath is one where the last point of the subpath is connected to the first point of the\n  subpath by a straight line. Subpaths with only one point are ignored when painting the path."
		}
		- "\n\n  "
		p {
			a href="#concept-path" id="building-paths:concept-path-2" {
				- "Paths"
			}
			- " have a "
			dfn id="need-new-subpath" {
				- "need new subpath"
			}
			- " flag. When this\n  flag is set, certain APIs create a new subpath rather than extending the previous one. When a\n  "
			a href="#concept-path" id="building-paths:concept-path-3" {
				- "path"
			}
			- " is created, its "
			a href="#need-new-subpath" id="building-paths:need-new-subpath" {
				- "need new subpath"
			}
			- " flag must be\n  set."
		}
		- "\n\n  "
		p {
			- "When an object implementing the "
			code id="building-paths:canvaspath-2" {
				a href="#canvaspath" {
					- "CanvasPath"
				}
			}
			- " interface is created, its "
			a href="#concept-path" id="building-paths:concept-path-4" {
				- "path"
			}
			- " must be initialized to zero subpaths."
		}
