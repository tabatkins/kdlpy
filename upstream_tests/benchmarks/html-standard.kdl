		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="input" id="attr-input-readonly" data-dfn-type="element-attr" {
				code {
					- "readonly"
				}
			}
			- "\n  attribute is a "
			a href="#boolean-attribute" id="the-readonly-attribute:boolean-attribute" {
				- "boolean attribute"
			}
			- " that controls whether or not the user can edit the\n  form control. When specified, the element is not "
			i id="the-readonly-attribute:concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": If the "
			code id="the-readonly-attribute:attr-input-readonly-2" {
				a href="#attr-input-readonly" {
					- "readonly"
				}
			}
			- " attribute is specified on an "
			code id="the-readonly-attribute:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- "\n  element, the element is "
			a href="#barred-from-constraint-validation" id="the-readonly-attribute:barred-from-constraint-validation" {
				- "barred from constraint validation"
			}
			- "."
		}
		- "\n\n  \n\n  "
		div class="note" {
			- "\n   "
			p {
				- "The difference between "
				code id="the-readonly-attribute:attr-fe-disabled" {
					a href="#attr-fe-disabled" {
						- "disabled"
					}
				}
				- " and "
				code id="the-readonly-attribute:attr-input-readonly-3" {
					a href="#attr-input-readonly" {
						- "readonly"
					}
				}
				- " is that read-only controls can still function,\n   whereas disabled controls generally do not function as controls until they are enabled. This is\n   spelled out in more detail elsewhere in this specification with normative requirements that refer\n   to the "
				a href="#concept-fe-disabled" id="the-readonly-attribute:concept-fe-disabled" {
					- "disabled"
				}
				- " concept (for example, the element's\n   "
				a id="the-readonly-attribute:activation-behaviour" href="https://dom.spec.whatwg.org/#eventtarget-activation-behavior" data-x-internal="activation-behaviour" {
					- "activation behavior"
				}
				- ", whether or not it is a "
				a href="#focusable-area" id="the-readonly-attribute:focusable-area" {
					- "focusable area"
				}
				- ", or when\n   "
				a href="#constructing-the-form-data-set" id="the-readonly-attribute:constructing-the-form-data-set" {
					- "constructing the entry list"
				}
				- "). Any other behavior related to user interaction with\n   disabled controls, such as whether text can be selected or copied, is not defined in this\n   standard."
			}
			- "\n\n   "
			p {
				- "Only text controls can be made read-only, since for other controls (such as checkboxes and\n   buttons) there is no useful distinction between being read-only and being disabled, so the\n   "
				code id="the-readonly-attribute:attr-input-readonly-4" {
					a href="#attr-input-readonly" {
						- "readonly"
					}
				}
				- " attribute "
				a href="#do-not-apply" id="the-readonly-attribute:do-not-apply" {
					- "does not\n   apply"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  "
