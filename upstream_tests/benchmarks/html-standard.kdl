							}
							- " is \""
							dfn data-dfn-for="PremultiplyAlpha" id="dom-premultiplyalpha-none" data-dfn-type="enum-value" {
								code {
									- "none"
								}
							}
							- "\", the "
							var {
								- "output"
							}
							- " that is not\n     premultiplied by alpha must be left untouched and that is premultiplied by alpha must have its\n     color components "
