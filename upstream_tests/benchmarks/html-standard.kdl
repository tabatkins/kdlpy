				a href="#texttrack" {
					- "TextTrack"
				}
			}
			- " object represents."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="TextTrack" id="dom-texttrack-id" data-dfn-type="attribute" {
				code {
					- "id"
				}
			}
			- " attribute\n  returns the track's identifier, if it has one, or the empty string otherwise. For tracks that\n  correspond to "
			code id="text-track-api:the-track-element-4" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " elements, the track's identifier is the value of the element's\n  "
			code id="text-track-api:the-id-attribute" {
				a href="#the-id-attribute" {
					- "id"
				}
			}
			- " attribute, if any. For in-band tracks, the track's identifier is\n  specified by the "
			a href="#media-resource" id="text-track-api:media-resource" {
				- "media resource"
			}
			- ". If the "
			a href="#media-resource" id="text-track-api:media-resource-2" {
				- "media resource"
			}
			- " is in a format\n  that supports "
			a id="text-track-api:media-fragment-syntax-2" href="https://www.w3.org/TR/media-frags/#media-fragment-syntax" data-x-internal="media-fragment-syntax" {
				- "media fragment syntax"
			}
			- ", the identifier returned for a particular track\n  must be the same identifier that would enable the track if used as the name of a track in the\n  track dimension of such a "
			a href="https://url.spec.whatwg.org/#concept-url-fragment" id="text-track-api:concept-url-fragment-2" data-x-internal="concept-url-fragment" {
				- "fragment"
			}
