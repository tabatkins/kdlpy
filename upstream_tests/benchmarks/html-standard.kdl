		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-4" {
				- "media element"
			}
			- " is said to be "
			dfn id="eligible-for-autoplay" {
				- "eligible for autoplay"
			}
			- " when all of the\n  following are true:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "its "
					a href="#can-autoplay-flag" id="playing-the-media-resource:can-autoplay-flag" {
						- "can autoplay flag"
					}
					- " is true;"
				}
			}
			li {
				p {
