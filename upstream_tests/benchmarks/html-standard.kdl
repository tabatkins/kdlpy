			}
			- " elements. This is\n  equivalent to prepending the contents of the early and final `"
			code id="early-hints:http-link-4" {
				a data-x-internal="http-link" href="https://httpwg.org/specs/rfc8288.html#header" {
					- "Link"
				}
			}
			- "` headers to the "
			code id="early-hints:document" {
