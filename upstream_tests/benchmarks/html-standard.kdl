			li {
				p {
					- "If "
					var {
						- "node"
					}
					- " is a "
					code id="the-insertion-mode:the-head-element" {
						a href="#the-head-element" {
							- "head"
						}
					}
					- " element and "
					var {
						- "last"
					}
					- " is\n   false, then switch the "
					a href="#insertion-mode" id="the-insertion-mode:insertion-mode-14" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inhead" id="the-insertion-mode:parsing-main-inhead-3" {
						- "in\n   head"
					}
					- "\" and return."
				}
			}
			li {
				p {
					- "If "
					var {
						- "node"
					}
					- " is a "
