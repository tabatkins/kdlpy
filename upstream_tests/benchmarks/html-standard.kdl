					}
					- " flag to true for a\n    "
					a href="#form-associated-custom-element" id="definitions:form-associated-custom-element-6" {
						- "form-associated custom element"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- " "
				dfn id="suffering-from-being-too-short" {
					- "Suffering from being too short"
