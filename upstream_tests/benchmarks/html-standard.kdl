			dd {
				- "\n    "
				p {
					- "Replaces a range of text with the new text. If the "
					var {
						- "start"
					}
					- " and "
					var {
						- "end"
					}
					- "\n    arguments are not provided, the range is assumed to be the selection."
				}
				- "\n\n    "
				p {
					- "The final argument determines how the selection will be set after the text has been replaced.\n    The possible values are:"
				}
				- "\n\n    "
				dl {
					dt {
						- "\""
						code id="dom-selectionmode-select-dev" {
							a href="#dom-selectionmode-select" {
								- "select"
							}
						}
						- "\""
					}
					dd {
						- "Selects the newly inserted text."
					}
					dt {
						- "\""
						code id="dom-selectionmode-start-dev" {
							a href="#dom-selectionmode-start" {
								- "start"
							}
						}
						- "\""
					}
					dd {
						- "Moves the selection to just before the inserted text."
					}
					dt {
						- "\""
						code id="dom-selectionmode-end-dev" {
							a href="#dom-selectionmode-end" {
								- "end"
							}
						}
						- "\""
					}
					dd {
						- "Moves the selection to just after the selected text."
					}
					dt {
						- "\""
						code id="dom-selectionmode-preserve-dev" {
							a href="#dom-selectionmode-preserve" {
								- "preserve"
							}
						}
