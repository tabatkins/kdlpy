			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-inheadnoscript:using-the-rules-for-2" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inhead" id="parsing-main-inheadnoscript:parsing-main-inhead-2" {
						- "in head"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-inheadnoscript:insertion-mode-4" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"br\""
