							var {
								- "index"
							}
							- "th entry in "
							var {
								- "tokens"
							}
							- " is the first\n     entry, then skip to the step labeled "
							i {
								- "done"
							}
							- "."
						}
					}
					li {
						p {
							- "Decrement "
							var {
								- "index"
							}
							- " by one."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					var {
						- "index"
					}
					- "th token in "
					var {
						- "tokens"
					}
					- " is an "
					a id="autofill-processing-model:ascii-case-insensitive-3" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
