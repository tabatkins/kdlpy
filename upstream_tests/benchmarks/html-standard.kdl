		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="month-state-(type=month):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="month-state-(type=month):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#month-state-(type=month)" id="month-state-(type=month):month-state-(type=month)" {
				- "Month"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="month-state-(type=month):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="month-state-(type=month):represents" {
				- "represents"
			}
			- " a control for setting the element's\n  "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value" {
				- "value"
			}
			- " to a string representing a specific "
			a href="#concept-month" id="month-state-(type=month):concept-month" {
				- "month"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "If the element is "
			i id="month-state-(type=month):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the "
			a href="#concept-month" id="month-state-(type=month):concept-month-2" {
				- "month"
			}
			- " represented by its "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value-2" {
				- "value"
			}
			- ", as obtained by "
			a href="#parse-a-month-string" id="month-state-(type=month):parse-a-month-string" {
				- "parsing a\n  month"
			}
			- " from it. User agents must not allow the user to set the "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value-3" {
				- "value"
			}
			- " to a non-empty string that is not a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string" {
				- "valid month\n  string"
			}
			- ". If the user agent provides a user interface for selecting a "
			a href="#concept-month" id="month-state-(type=month):concept-month-3" {
				- "month"
			}
			- ", then the "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value-4" {
				- "value"
			}
			- " must be\n  set to a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string-2" {
				- "valid month string"
			}
			- " representing the user's selection. User agents should\n  allow the user to set the "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value-5" {
				- "value"
			}
			- " to the empty string."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the user interface describes input that the user\n  agent cannot convert to a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string-3" {
				- "valid month string"
			}
			- ", the control is "
			a href="#suffering-from-bad-input" id="month-state-(type=month):suffering-from-bad-input" {
				- "suffering from bad\n  input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "See the "
			a href="#input-author-notes" {
				- "introduction section"
			}
			- " for a discussion of\n  the difference between the input format and submission format for date, time, and number form\n  controls, and the "
			a href="#input-impl-notes" {
				- "implementation notes"
			}
			- "\n  regarding localization of form controls."
		}
		- "\n\n  "
		p {
			- "The "
			code id="month-state-(type=month):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not empty, must\n  have a value that is a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string-4" {
				- "valid month string"
			}
			- "."
		}
		- " \n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="month-state-(type=month):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": If the "
			a href="#concept-fe-value" id="month-state-(type=month):concept-fe-value-6" {
				- "value"
			}
			- " of the element is not a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string-5" {
				- "valid month string"
			}
			- ",\n  then set it to the empty string instead."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="month-state-(type=month):attr-input-min" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute, if specified, must have a value that is\n  a "
			a href="#valid-month-string" id="month-state-(type=month):valid-month-string-6" {
				- "valid month string"
			}
			- ". The "
			code id="month-state-(type=month):attr-input-max" {
				a href="#attr-input-max" {
					- "max"
				}
