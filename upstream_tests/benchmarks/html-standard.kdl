			- "; if the UA does support the given "
			a id="processing-the-type-attribute:mime-type-2" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
				- "MIME type"
			}
			- " for the given link\n  relationship, then the UA should "
			a href="#fetch-and-process-the-linked-resource" id="processing-the-type-attribute:fetch-and-process-the-linked-resource-2" {
				- "fetch and process the linked resource"
			}
