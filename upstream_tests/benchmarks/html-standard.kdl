						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android no" {
						span {
							- "WebView Android"
						}
						span {
							- "No"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android no" {
						span {
							- "Opera Android"
						}
						span {
							- "No"
						}
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			code id="the-coop-headers:document" {
				a href="#document" {
					- "Document"
				}
			}
			- "'s "
			a href="#concept-document-coop" id="the-coop-headers:concept-document-coop" {
				- "cross-origin opener\n  policy"
			}
			- " is derived from the `"
			dfn id="cross-origin-opener-policy-2" data-dfn-type="http-header" {
				code {
					- "Cross-Origin-Opener-Policy"
				}
			}
			- "` and `"
			dfn id="cross-origin-opener-policy-report-only" data-dfn-type="http-header" {
				code {
					- "Cross-Origin-Opener-Policy-Report-Only"
				}
			}
			- "` HTTP response headers.\n  These headers are "
			a href="https://httpwg.org/specs/rfc8941.html" id="the-coop-headers:http-structured-header" data-x-internal="http-structured-header" {
				- "structured headers"
			}
			- " whose value must\n  be a "
			a href="https://httpwg.org/specs/rfc8941.html#token" id="the-coop-headers:http-structured-header-token" data-x-internal="http-structured-header-token" {
				- "token"
			}
			- ". "
			a href="#refsSTRUCTURED-FIELDS" {
				- "[STRUCTURED-FIELDS]"
			}
		}
		- "\n\n  "
		p {
			- "The valid "
			a href="https://httpwg.org/specs/rfc8941.html#token" id="the-coop-headers:http-structured-header-token-2" data-x-internal="http-structured-header-token" {
				- "token"
			}
			- " values are the "
			a href="#cross-origin-opener-policy-value" id="the-coop-headers:cross-origin-opener-policy-value" {
				- "opener policy values"
			}
			- ". The token may also have\n  attached "
			a href="https://httpwg.org/specs/rfc8941.html#param" id="the-coop-headers:http-structured-header-parameters" data-x-internal="http-structured-header-parameters" {
				- "parameters"
			}
			- "; of these, the \""
			dfn id="coop-report-to" {
				code {
					- "report-to"
				}
			}
			- "\" parameter can have a "
			a id="the-coop-headers:valid-url-string" href="https://url.spec.whatwg.org/#valid-url-string" data-x-internal="valid-url-string" {
				- "valid URL\n  string"
			}
			- " identifying an appropriate reporting endpoint. "
			a href="#refsREPORTING" {
				- "[REPORTING]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "Per the processing model described below, user agents will ignore this header if it contains an invalid value. Likewise, user\n  agents will ignore this header if the value cannot be parsed as a "
			a href="https://httpwg.org/specs/rfc8941.html#token" id="the-coop-headers:http-structured-header-token-3" data-x-internal="http-structured-header-token" {
				- "token"
			}
			- "."
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "To "
			dfn id="obtain-coop" {
				- "obtain an opener policy"
			}
			- " given a "
			a href="https://fetch.spec.whatwg.org/#concept-response" id="the-coop-headers:concept-response" data-x-internal="concept-response" {
				- "response"
			}
			- " "
			var {
				- "response"
			}
			- " and an "
			a href="#environment" id="the-coop-headers:environment" {
				- "environment"
			}
			- "\n  "
			var {
				- "reservedEnvironment"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "policy"
					}
					- " be a new "
					a href="#cross-origin-opener-policy" id="the-coop-headers:cross-origin-opener-policy" {
						- "opener policy"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "reservedEnvironment"
					}
					- " is a "
					a href="#non-secure-context" id="the-coop-headers:non-secure-context" {
						- "non-secure context"
					}
					- ", then return\n   "
					var {
						- "policy"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "parsedItem"
					}
					- " be the result of "
					a id="the-coop-headers:getting-a-structured-field-value" href="https://fetch.spec.whatwg.org/#concept-header-list-get-structured-header" data-x-internal="getting-a-structured-field-value" {
						- "getting a structured field value"
					}
					- "\n   given `"
					code id="the-coop-headers:cross-origin-opener-policy-2" {
						a href="#cross-origin-opener-policy-2" {
							- "Cross-Origin-Opener-Policy"
						}
					}
					- "` and \""
					code {
						- "item"
					}
					- "\" from\n   "
					var {
						- "response"
					}
					- "'s "
					a href="https://fetch.spec.whatwg.org/#concept-response-header-list" id="the-coop-headers:concept-response-header-list" data-x-internal="concept-response-header-list" {
						- "header list"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "parsedItem"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[0] is \""
							code id="the-coop-headers:coop-same-origin" {
								a href="#coop-same-origin" {
									- "same-origin"
								}
							}
							- "\",\n      then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "coep"
									}
									- " be the result of "
									a href="#obtain-an-embedder-policy" id="the-coop-headers:obtain-an-embedder-policy" {
										- "obtaining a cross-origin embedder policy"
									}
									- " from "
									var {
										- "response"
									}
									- " and\n       "
									var {
										- "reservedEnvironment"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "coep"
									}
									- "'s "
									a href="#embedder-policy-value-2" id="the-coop-headers:embedder-policy-value-2" {
										- "value"
									}
									- " is\n       "
									a href="#compatible-with-cross-origin-isolation" id="the-coop-headers:compatible-with-cross-origin-isolation" {
										- "compatible with cross-origin isolation"
									}
									- ", then set "
									var {
										- "policy"
									}
									- "'s "
									a href="#coop-struct-value" id="the-coop-headers:coop-struct-value" {
										- "value"
									}
									- " to \""
									code id="the-coop-headers:coop-same-origin-plus-coep" {
										a href="#coop-same-origin-plus-coep" {
											- "same-origin-plus-COEP"
										}
									}
									- "\"."
								}
							}
							li {
								p {
									- "Otherwise, set "
									var {
										- "policy"
									}
									- "'s "
									a href="#coop-struct-value" id="the-coop-headers:coop-struct-value-2" {
										- "value"
									}
									- " to\n       \""
									code id="the-coop-headers:coop-same-origin-2" {
										a href="#coop-same-origin" {
											- "same-origin"
										}
									}
									- "\"."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[0] is \""
							code id="the-coop-headers:coop-same-origin-allow-popups" {
								a href="#coop-same-origin-allow-popups" {
									- "same-origin-allow-popups"
								}
							}
							- "\", then set\n     "
							var {
								- "policy"
							}
							- "'s "
							a href="#coop-struct-value" id="the-coop-headers:coop-struct-value-3" {
								- "value"
							}
							- " to \""
							code id="the-coop-headers:coop-same-origin-allow-popups-2" {
								a href="#coop-same-origin-allow-popups" {
									- "same-origin-allow-popups"
								}
							}
							- "\"."
						}
					}
					li {
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[0] is \""
							code id="the-coop-headers:coop-noopener-allow-popups" {
								a href="#coop-noopener-allow-popups" {
									- "noopener-allow-popups"
								}
							}
							- "\", then set\n     "
							var {
								- "policy"
							}
							- "'s "
							a href="#coop-struct-value" id="the-coop-headers:coop-struct-value-4" {
								- "value"
							}
							- " to \""
							code id="the-coop-headers:coop-noopener-allow-popups-2" {
								a href="#coop-noopener-allow-popups" {
									- "noopener-allow-popups"
								}
							}
							- "\"."
						}
					}
					li {
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[1][\""
							code id="the-coop-headers:coop-report-to" {
								a href="#coop-report-to" {
									- "report-to"
								}
							}
							- "\"] "
							a href="https://infra.spec.whatwg.org/#map-exists" id="the-coop-headers:map-exists" data-x-internal="map-exists" {
								- "exists"
							}
							- " and it is a string, then set "
							var {
								- "policy"
							}
							- "'s "
							a href="#coop-struct-report-endpoint" id="the-coop-headers:coop-struct-report-endpoint" {
								- "reporting endpoint"
							}
							- " to\n     "
							var {
								- "parsedItem"
							}
							- "[1][\""
							code id="the-coop-headers:coop-report-to-2" {
