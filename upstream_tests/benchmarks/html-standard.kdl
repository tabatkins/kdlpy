		- "\n\n  "
		p class="note" {
			- "In this state, the range and step constraints are enforced even during user input,\n  and there is no way to set the value to the empty string."
		}
		- "\n\n  "
		p {
			- "The "
			code id="range-state-(type=range):attr-input-min" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute, if specified, must have a value that is\n  a "
			a href="#valid-floating-point-number" id="range-state-(type=range):valid-floating-point-number-6" {
				- "valid floating-point number"
			}
			- ". The "
			a href="#concept-input-min-default" id="range-state-(type=range):concept-input-min-default" {
				- "default\n  minimum"
			}
			- " is 0. The "
			code id="range-state-(type=range):attr-input-max" {
				a href="#attr-input-max" {
					- "max"
				}
			}
			- " attribute, if specified, must\n  have a value that is a "
			a href="#valid-floating-point-number" id="range-state-(type=range):valid-floating-point-number-7" {
				- "valid floating-point number"
			}
			- ". The "
			a href="#concept-input-max-default" id="range-state-(type=range):concept-input-max-default" {
				- "default maximum"
			}
			- " is 100."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-input-step-scale" id="range-state-(type=range):concept-input-step-scale" {
				- "step scale factor"
			}
			- " is\n  1. The "
			a href="#concept-input-step-default" id="range-state-(type=range):concept-input-step-default" {
				- "default step"
			}
			- " is 1 (allowing only\n  integers, unless the "
			code id="range-state-(type=range):attr-input-min-2" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute has a non-integer\n  value)."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-string-number" id="range-state-(type=range):concept-input-value-string-number" {
					- "algorithm to convert a string to a\n  number"
				}
				- ", given a string "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": If applying the\n  "
			a href="#rules-for-parsing-floating-point-number-values" id="range-state-(type=range):rules-for-parsing-floating-point-number-values-2" {
				- "rules for parsing floating-point number values"
			}
			- " to "
			var {
				- "input"
			}
			- " results\n  in an error, then return an error; otherwise, return the resulting number."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-number-string" id="range-state-(type=range):concept-input-value-number-string" {
					- "algorithm to convert a number to a\n  string"
				}
				- ", given a number "
				var {
