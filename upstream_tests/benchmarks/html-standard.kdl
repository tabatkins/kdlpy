			dd {
				- "\n    "
				p {
					- "Returns a "
					code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap" {
						a href="#domstringmap" {
							- "DOMStringMap"
						}
					}
					- " object for the element's "
					code id="embedding-custom-non-visible-data-with-the-data-*-attributes:attr-data-*-2" {
						a href="#attr-data-*" {
							- "data-*"
