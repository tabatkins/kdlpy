						- "\n\n      "
						p class="note" {
							- "The user agent is "
							em {
								- "required"
							}
							- " to determine the duration of the\n      "
							a href="#media-resource" id="loading-the-media-resource:media-resource-16" {
								- "media resource"
							}
							- " and go through this step before playing."
						}
						- " \n     "
					}
					dt {
						- "Once the entire "
						a href="#media-resource" id="loading-the-media-resource:media-resource-17" {
							- "media resource"
						}
						- " has been fetched (but potentially before any of\n     it has been decoded)"
