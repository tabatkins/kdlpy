					- "."
				}
				- "\n\n    "
				div class="note" {
					- "\n     "
					p {
						- "This will be null in the case where "
						var {
							- "document"
						}
						- " is the "
						a href="#is-initial-about:blank" id="loading-documents:is-initial-about:blank" {
							- "initial "
							code {
								- "about:blank"
							}
						}
						- " "
						code id="loading-documents:document-4" {
							a href="#document" {
								- "Document"
							}
						}
						- " in a\n     "
						code id="loading-documents:frame" {
							a href="#frame" {
								- "frame"
							}
						}
						- " or "
						code id="loading-documents:the-iframe-element" {
							a href="#the-iframe-element" {
								- "iframe"
							}
						}
						- ", since at the point of "
						a href="#creating-a-new-browsing-context" id="loading-documents:creating-a-new-browsing-context" {
							- "browsing context creation"
						}
						- " which calls this algorithm,\n     the container relationship has not yet been established. (That happens in a subsequent step of\n     "
						a href="#create-a-new-child-navigable" id="loading-documents:create-a-new-child-navigable" {
							- "create a new child navigable"
						}
						- ".)"
					}
					- "\n\n     "
					p {
						- "The consequence of this is that the following steps do nothing, i.e., we do not fire an\n     asynchronous "
						code id="loading-documents:event-load" {
