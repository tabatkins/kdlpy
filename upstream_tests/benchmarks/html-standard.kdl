			- ", given an\n  "
			a href="#environment-settings-object" id="integration-with-the-javascript-agent-cluster-formalism:environment-settings-object" {
				- "environment settings object"
			}
			- " or null "
			var {
				- "outside settings"
			}
			- ", a boolean\n  "
			var {
				- "isTopLevel"
			}
			- ", and a boolean "
			var {
				- "canBlock"
			}
			- ", run these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "agentCluster"
					}
					- " be null.\n\n   "
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "isTopLevel"
					}
					- " is true, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "agentCluster"
							}
							- " to a new "
							a id="integration-with-the-javascript-agent-cluster-formalism:agent-cluster-10" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
								- "agent cluster"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Set "
							var {
								- "agentCluster"
							}
							- "'s "
							a href="#is-origin-keyed" id="integration-with-the-javascript-agent-cluster-formalism:is-origin-keyed-2" {
								- "is origin-keyed"
							}
							- " to true."
						}
						- "\n\n      "
						p class="note" {
							- "These workers can be considered to be origin-keyed. However, this is not\n      exposed through any APIs (in the way that "
							code id="integration-with-the-javascript-agent-cluster-formalism:dom-originagentcluster" {
								a href="#dom-originagentcluster" {
									- "originAgentCluster"
								}
							}
							- " exposes the origin-keyedness for\n      windows)."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a id="integration-with-the-javascript-agent-cluster-formalism:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "outside settings"
							}
							- " is not null."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "ownerAgent"
							}
							- " be "
							var {
								- "outside settings"
							}
							- "'s "
							a href="#environment-settings-object's-realm" id="integration-with-the-javascript-agent-cluster-formalism:environment-settings-object's-realm" {
								- "realm"
							}
							- "'s "
							a href="#realm's-agent" id="integration-with-the-javascript-agent-cluster-formalism:realm's-agent" {
								- "agent"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "agentCluster"
							}
							- " to the agent cluster which contains\n     "
							var {
								- "ownerAgent"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "agent"
					}
					- " be the result of "
					a href="#create-an-agent" id="integration-with-the-javascript-agent-cluster-formalism:create-an-agent-2" {
						- "creating an\n   agent"
					}
					- " given "
					var {
						- "canBlock"
					}
					- "."
				}
			}
			li {
				p {
					- "Add "
					var {
						- "agent"
					}
					- " to "
					var {
						- "agentCluster"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "agent"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="obtain-a-dedicated/shared-worker-agent" {
				- "obtain a dedicated/shared worker agent"
			}
			- ", given an "
			a href="#environment-settings-object" id="integration-with-the-javascript-agent-cluster-formalism:environment-settings-object-2" {
				- "environment settings\n  object"
			}
			- " "
			var {
				- "outside settings"
			}
			- " and a boolean "
			var {
				- "isShared"
			}
			- ", return the result of\n  "
			a href="#obtaining-a-worker/worklet-agent" id="integration-with-the-javascript-agent-cluster-formalism:obtaining-a-worker/worklet-agent-2" {
				- "obtaining a worker/worklet agent"
			}
			- " given "
			var {
				- "outside settings"
			}
			- ",\n  "
			var {
				- "isShared"
			}
			- ", and true."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="obtain-a-worklet-agent" {
				- "obtain a worklet agent"
			}
			- ", given an "
			a href="#environment-settings-object" id="integration-with-the-javascript-agent-cluster-formalism:environment-settings-object-3" {
				- "environment settings object"
			}
			- "\n  "
			var {
				- "outside settings"
			}
			- ", return the result of "
			a href="#obtaining-a-worker/worklet-agent" id="integration-with-the-javascript-agent-cluster-formalism:obtaining-a-worker/worklet-agent-3" {
				- "obtaining a worker/worklet agent"
			}
			- "\n  given "
			var {
				- "outside settings"
			}
			- ", false, and false."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="obtain-a-service-worker-agent" data-export="" {
				- "obtain a service worker agent"
			}
			- ", return the result of "
			a href="#obtaining-a-worker/worklet-agent" id="integration-with-the-javascript-agent-cluster-formalism:obtaining-a-worker/worklet-agent-4" {
				- "obtaining a\n  worker/worklet agent"
			}
			- " given null, true, and false."
		}
		- "\n\n  "
		hr
		- "\n\n  \n\n  "
		div id="can-share-memory-with" class="example" {
			- "\n   "
			p {
				- "The following pairs of global objects are each within the same "
				a id="integration-with-the-javascript-agent-cluster-formalism:agent-cluster-11" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
					- "agent cluster"
				}
				- ", and\n   thus can use "
				code id="integration-with-the-javascript-agent-cluster-formalism:sharedarraybuffer-2" {
					a data-x-internal="sharedarraybuffer" href="https://tc39.es/ecma262/#sec-sharedarraybuffer-objects" {
						- "SharedArrayBuffer"
					}
				}
				- " instances to share memory with each other:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window" {
							a href="#window" {
								- "Window"
							}
						}
						- " object and a dedicated worker that it created."
					}
				}
				li {
					p {
						- "A worker (of any type) and a dedicated worker it created."
					}
				}
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-2" {
							a href="#window" {
								- "Window"
							}
						}
						- " object "
						var {
							- "A"
						}
						- " and the "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-3" {
							a href="#window" {
								- "Window"
							}
						}
						- " object of an\n    "
						code id="integration-with-the-javascript-agent-cluster-formalism:the-iframe-element" {
							a href="#the-iframe-element" {
								- "iframe"
							}
						}
						- " element that "
						var {
							- "A"
						}
						- " created that could be "
						a href="#same-origin-domain" id="integration-with-the-javascript-agent-cluster-formalism:same-origin-domain" {
							- "same\n    origin-domain"
						}
						- " with "
						var {
							- "A"
						}
						- "."
					}
				}
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-4" {
							a href="#window" {
								- "Window"
							}
						}
						- " object and a "
						a href="#same-origin-domain" id="integration-with-the-javascript-agent-cluster-formalism:same-origin-domain-2" {
							- "same origin-domain"
						}
						- " "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-5" {
							a href="#window" {
								- "Window"
							}
						}
						- "\n    object that opened it."
					}
				}
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-6" {
							a href="#window" {
								- "Window"
							}
						}
						- " object and a worklet that it created."
					}
				}
			}
			- "\n\n   "
			p {
				- "The following pairs of global objects are "
				em {
					- "not"
				}
				- " within the same "
				a id="integration-with-the-javascript-agent-cluster-formalism:agent-cluster-12" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
					- "agent\n   cluster"
				}
				- ", and thus cannot share memory:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-7" {
							a href="#window" {
								- "Window"
							}
						}
						- " object and a shared worker it created."
					}
				}
				li {
					p {
						- "A worker (of any type) and a shared worker it created."
					}
				}
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-8" {
							a href="#window" {
								- "Window"
							}
						}
						- " object and a service worker it created."
					}
				}
				li {
					p {
						- "A "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-9" {
							a href="#window" {
								- "Window"
							}
						}
						- " object "
						var {
							- "A"
						}
						- " and the "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-10" {
							a href="#window" {
								- "Window"
							}
						}
						- " object of an\n    "
						code id="integration-with-the-javascript-agent-cluster-formalism:the-iframe-element-2" {
							a href="#the-iframe-element" {
								- "iframe"
							}
						}
						- " element that "
						var {
							- "A"
						}
						- " created that cannot be "
						a href="#same-origin-domain" id="integration-with-the-javascript-agent-cluster-formalism:same-origin-domain-3" {
							- "same\n    origin-domain"
						}
						- " with "
						var {
							- "A"
						}
						- "."
					}
				}
				li {
					p {
						- "Any two "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-11" {
							a href="#window" {
								- "Window"
							}
						}
						- " objects with no opener or ancestor relationship. This holds\n    even if the two "
						code id="integration-with-the-javascript-agent-cluster-formalism:window-12" {
							a href="#window" {
								- "Window"
							}
						}
						- " objects are "
						a href="#same-origin" id="integration-with-the-javascript-agent-cluster-formalism:same-origin" {
							- "same origin"
						}
						- "."
					}
				}
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		h4 id="realms-and-their-counterparts" {
			span class="secno" {
				- "8.1.3"
			}
			- " Realms and their counterparts"
			a href="#realms-and-their-counterparts" class="self-link"
		}
		- "\n\n  "
		p {
			- "The JavaScript specification introduces the "
			a id="realms-and-their-counterparts:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- " concept, representing a global\n  environment in which script is run. Each realm comes with an "
			a id="realms-and-their-counterparts:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- "\n  "
			a href="#global-object" id="realms-and-their-counterparts:global-object" {
				- "global object"
			}
			- "; much of this specification is devoted to defining that global object\n  and its properties."
		}
		- "\n\n  "
		p {
			- "For web specifications, it is often useful to associate values or algorithms with a\n  realm/global object pair. When the values are specific to a particular type of realm, they are\n  associated directly with the global object in question, e.g., in the definition of the\n  "
			code id="realms-and-their-counterparts:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " or "
			code id="realms-and-their-counterparts:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " interfaces. When the values have utility\n  across multiple realms, we use the "
			a href="#environment-settings-object" id="realms-and-their-counterparts:environment-settings-object" {
				- "environment settings object"
			}
			- " concept."
		}
		- "\n\n  "
		p {
			- "Finally, in some cases it is necessary to track associated values before a\n  realm/global object/environment settings object even comes into existence (for example, during\n  "
			a href="#navigate" id="realms-and-their-counterparts:navigate" {
				- "navigation"
			}
			- "). These values are tracked in the\n  "
			a href="#environment" id="realms-and-their-counterparts:environment" {
				- "environment"
			}
			- " concept."
		}
		- "\n\n  "
		h5 id="environments" {
			span class="secno" {
				- "8.1.3.1"
			}
			- " Environments"
			a href="#environments" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="environment" data-export="" {
				- "environment"
			}
			- " is an object that identifies the settings of a current or\n  potential execution environment (i.e., a "
			a href="#navigation-params" id="environments:navigation-params" {
				- "navigation\n  params"
			}
			- "'s "
			a href="#navigation-params-reserved-environment" id="environments:navigation-params-reserved-environment" {
				- "reserved environment"
			}
			- "\n  or a "
			a href="https://fetch.spec.whatwg.org/#concept-request" id="environments:concept-request" data-x-internal="concept-request" {
				- "request"
			}
			- "'s "
			a href="https://fetch.spec.whatwg.org/#concept-request-reserved-client" id="environments:concept-request-reserved-client" data-x-internal="concept-request-reserved-client" {
				- "reserved client"
			}
			- "). An "
			a href="#environment" id="environments:environment" {
				- "environment"
			}
			- " has\n  the following fields:"
		}
		- "\n\n  "
		dl {
			dt {
				- "An "
				dfn data-dfn-for="environment" id="concept-environment-id" data-export="" {
					- "id"
				}
			}
			dd {
				p {
					- "An opaque string that uniquely identifies this "
					a href="#environment" id="environments:environment-2" {
						- "environment"
					}
					- "."
				}
			}
			dt {
				- "A "
				dfn data-dfn-for="environment" id="concept-environment-creation-url" data-export="" {
					- "creation URL"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					a id="environments:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " that represents the location of the resource with which this\n    "
					a href="#environment" id="environments:environment-3" {
						- "environment"
					}
					- " is associated."
				}
				- "\n\n    "
				p class="note" {
					- "In the case of a "
					code id="environments:window" {
						a href="#window" {
							- "Window"
						}
					}
					- " "
					a href="#environment-settings-object" id="environments:environment-settings-object" {
						- "environment settings object"
					}
					- ",\n    this URL might be distinct from its "
					a href="#concept-settings-object-global" id="environments:concept-settings-object-global" {
						- "global\n    object"
					}
					- "'s "
					a href="#concept-document-window" id="environments:concept-document-window" {
						- "associated\n    "
						code {
							- "Document"
						}
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-url" id="environments:the-document's-address" data-x-internal="the-document's-address" {
						- "URL"
					}
					- ", due to\n    mechanisms such as "
					code id="environments:dom-history-pushstate" {
						a href="#dom-history-pushstate" {
							- "history.pushState()"
						}
					}
					- " which modify\n    the latter."
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="environment" id="concept-environment-top-level-creation-url" data-export="" {
					- "top-level creation URL"
				}
			}
			dd {
				p {
					- "Null or a "
					a id="environments:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " that represents the "
					a href="#concept-environment-creation-url" id="environments:concept-environment-creation-url" {
						- "creation URL"
					}
					- " of the \"top-level\"\n   "
					a href="#environment" id="environments:environment-4" {
						- "environment"
					}
					- ". It is null for workers and worklets."
				}
			}
			dt {
				- "A "
				dfn data-dfn-for="environment" id="concept-environment-top-level-origin" data-export="" {
					- "top-level origin"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					span class="XXX" {
						- "for now"
					}
					- " "
					a id="environments:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- " value, null,\n    or an "
					a href="#concept-origin" id="environments:concept-origin" {
						- "origin"
					}
					- ". For a \"top-level\" potential execution environment it is null (i.e.,\n    when there is no response yet); otherwise it is the \"top-level\" "
					a href="#environment" id="environments:environment-5" {
						- "environment"
					}
					- "'s "
					a href="#concept-settings-object-origin" id="environments:concept-settings-object-origin" {
						- "origin"
					}
					- ". For a dedicated worker or worklet it is\n    the "
					a href="#concept-environment-top-level-origin" id="environments:concept-environment-top-level-origin" {
						- "top-level origin"
					}
					- " of its creator. For a shared or service worker it is an\n    "
					a id="environments:implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- " value."
				}
				- "\n\n    "
				p class="note" {
					- "This is distinct from the "
					a href="#concept-environment-top-level-creation-url" id="environments:concept-environment-top-level-creation-url" {
						- "top-level creation URL"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-origin" id="environments:concept-url-origin" data-x-internal="concept-url-origin" {
						- "origin"
					}
					- " when sandboxing, workers, and worklets are\n    involved."
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="environment" id="concept-environment-target-browsing-context" data-export="" {
					- "target browsing context"
				}
			}
			dd {
				p {
					- "Null or a target "
					a href="#browsing-context" id="environments:browsing-context" {
						- "browsing context"
					}
					- " for a "
					a href="https://fetch.spec.whatwg.org/#navigation-request" id="environments:navigation-request" data-x-internal="navigation-request" {
						- "navigation request"
					}
					- "."
				}
			}
			dt {
				- "An "
				dfn data-dfn-for="environment" id="concept-environment-active-service-worker" data-export="" {
					- "active service worker"
				}
			}
			dd {
				p {
					- "Null or a "
					a href="https://w3c.github.io/ServiceWorker/#dfn-service-worker" id="environments:dfn-service-worker" data-x-internal="dfn-service-worker" {
						- "service worker"
					}
					- " that "
					a href="https://w3c.github.io/ServiceWorker/#dfn-control" id="environments:dfn-control" data-x-internal="dfn-control" {
						- "controls"
					}
					- " the "
					a href="#environment" id="environments:environment-6" {
						- "environment"
					}
					- "."
				}
			}
			dt {
				- "An "
				dfn data-dfn-for="environment" id="concept-environment-execution-ready-flag" data-export="" {
					- "execution ready flag"
				}
			}
			dd {
				p {
					- "A flag that indicates whether the environment setup is done. It is initially\n   unset."
				}
			}
		}
		- "\n\n  "
		p {
			- "Specifications may define "
			dfn id="environment-discarding-steps" data-export="" {
				- "environment discarding steps"
			}
			- " for environments. The\n  steps take an "
			a href="#environment" id="environments:environment-7" {
				- "environment"
			}
			- " as input."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#environment-discarding-steps" id="environments:environment-discarding-steps" {
				- "environment discarding\n  steps"
			}
			- " are run for only a select few environments: the ones that will\n  never become execution ready because, for example, they failed to load."
		}
		- "\n\n  "
		h5 id="environment-settings-objects" {
			span class="secno" {
				- "8.1.3.2"
			}
			- " Environment settings objects"
			a href="#environment-settings-objects" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="environment-settings-object" data-export="" {
				- "environment settings object"
			}
			- " is an "
			a href="#environment" id="environment-settings-objects:environment" {
				- "environment"
			}
			- " that\n  additionally specifies algorithms for:"
		}
		- "\n\n  "
		dl {
			dt {
				- "A "
				dfn data-dfn-for="environment settings object" id="realm-execution-context" data-export="" {
					- "realm execution\n   context"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					a id="environment-settings-objects:javascript-execution-context" href="https://tc39.es/ecma262/#sec-execution-contexts" data-x-internal="javascript-execution-context" {
						- "JavaScript execution context"
					}
					- " shared by all\n    "
					a href="#the-script-element" id="environment-settings-objects:the-script-element" {
						- "scripts"
					}
					- " that use this settings object, i.e., all scripts in a given\n    "
					a id="environment-settings-objects:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- ". When we "
					a href="#run-a-classic-script" id="environment-settings-objects:run-a-classic-script" {
						- "run a classic script"
					}
					- " or "
					a href="#run-a-module-script" id="environment-settings-objects:run-a-module-script" {
						- "run a module\n    script"
					}
					- ", this execution context becomes the top of the "
					a id="environment-settings-objects:javascript-execution-context-stack" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution context\n    stack"
					}
					- ", on top of which another execution context specific to the script in question is\n    pushed. (This setup ensures "
					a id="environment-settings-objects:source-text-module-record" href="https://tc39.es/ecma262/#sec-source-text-module-records" data-x-internal="source-text-module-record" {
						- "Source Text Module Record"
					}
					- "'s\n    "
					a href="https://tc39.es/ecma262/#sec-moduleevaluation" id="environment-settings-objects:js-evaluate" data-x-internal="js-evaluate" {
						- "Evaluate"
					}
					- " knows which realm to use.)"
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="environment\n   settings object" id="concept-settings-object-module-map" data-export="" {
					- "module map"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					a href="#module-map" id="environment-settings-objects:module-map" {
						- "module map"
					}
					- " that is used when importing JavaScript modules."
				}
				- "\n   "
			}
			dt {
				- "An "
				dfn data-dfn-for="environment settings object" id="api-base-url" data-export="" {
					- "API base URL"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					a id="environment-settings-objects:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " used by APIs called by scripts that use this "
					a href="#environment-settings-object" id="environment-settings-objects:environment-settings-object" {
						- "environment settings\n    object"
					}
					- " to "
					a href="#parse-a-url" id="environment-settings-objects:parse-a-url" {
						- "parse URLs"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "An "
				dfn data-dfn-for="environment\n   settings object" id="concept-settings-object-origin" data-export="" {
					- "origin"
				}
			}
			dd {
				- "\n    "
				p {
					- "An "
					a href="#concept-origin" id="environment-settings-objects:concept-origin" {
						- "origin"
					}
					- " used in security checks."
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="environment settings object" id="concept-settings-object-policy-container" data-export="" {
					- "policy container"
				}
			}
			dd {
				- "\n    "
				p {
					- "A "
					a href="#policy-container" id="environment-settings-objects:policy-container" {
						- "policy container"
					}
					- " containing policies used for security checks."
				}
				- "\n   "
			}
			dt {
				- "A "
				dfn data-dfn-for="environment settings object" id="concept-settings-object-cross-origin-isolated-capability" data-export="" {
					- "cross-origin isolated capability"
				}
			}
			dd {
				p {
					- "A boolean representing whether scripts that use this "
					a href="#environment-settings-object" id="environment-settings-objects:environment-settings-object-2" {
						- "environment settings\n   object"
					}
					- " are allowed to use APIs that require cross-origin isolation."
				}
			}
			dt {
				- "A "
				dfn data-dfn-for="environment settings object" id="concept-settings-object-time-origin" data-export="" {
					- "time origin"
				}
			}
			dd {
				- "A number used as the baseline for performance-related timestamps. "
				a href="#refsHRT" {
					- "[HRT]"
				}
			}
		}
		- "\n\n  "
		p {
			- "An "
			a href="#environment-settings-object" id="environment-settings-objects:environment-settings-object-3" {
				- "environment settings object"
			}
			- "'s "
			dfn data-dfn-for="environment settings\n  object" id="responsible-event-loop" data-export="" {
				- "responsible event loop"
			}
			- " is its "
			a href="#concept-settings-object-global" id="environment-settings-objects:concept-settings-object-global" {
				- "global\n  object"
			}
			- "'s "
			a href="#relevant-agent" id="environment-settings-objects:relevant-agent" {
				- "relevant agent"
			}
			- "'s "
			a href="#concept-agent-event-loop" id="environment-settings-objects:concept-agent-event-loop" {
				- "event\n  loop"
			}
			- "."
		}
		- "\n\n  "
		h5 id="realms-settings-objects-global-objects" {
			span class="secno" {
				- "8.1.3.3"
			}
			- " Realms, settings objects, and global objects"
			a href="#realms-settings-objects-global-objects" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="global-object" data-export="" {
				- "global object"
			}
			- " is a JavaScript object that is the [[GlobalObject]] field of\n  a "
			a id="realms-settings-objects-global-objects:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "In this specification, all "
			a href="https://tc39.es/ecma262/#sec-code-realms" id="realms-settings-objects-global-objects:realm-2" data-x-internal="realm" {
				- "realms"
			}
			- " are "
			a href="#creating-a-new-javascript-realm" id="realms-settings-objects-global-objects:creating-a-new-javascript-realm" {
				- "created"
			}
			- " with "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object" {
				- "global\n  objects"
			}
			- " that are either "
			code id="realms-settings-objects-global-objects:window" {
				a href="#window" {
					- "Window"
				}
			}
			- ", "
			code id="realms-settings-objects-global-objects:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- ", or\n  "
			code id="realms-settings-objects-global-objects:workletglobalscope" {
				a href="#workletglobalscope" {
					- "WorkletGlobalScope"
				}
			}
			- " objects."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-2" {
				- "global object"
			}
			- " has an "
			dfn data-dfn-for="global object" id="in-error-reporting-mode" {
				- "in error reporting mode"
			}
			- "\n  boolean, which is initially false."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-3" {
				- "global object"
			}
			- " has an "
			dfn id="outstanding-rejected-promises-weak-set" {
				- "outstanding rejected promises weak set"
			}
			- ", a\n  "
			a id="realms-settings-objects-global-objects:set" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
				- "set"
			}
			- " of "
			code id="realms-settings-objects-global-objects:idl-promise" {
				a data-x-internal="idl-promise" href="https://webidl.spec.whatwg.org/#idl-promise" {
					- "Promise"
				}
			}
			- " objects, initially empty. This set\n  must not create strong references to any of its members, and implementations are free to limit\n  its size in an "
			a id="realms-settings-objects-global-objects:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " manner, e.g., by removing old entries from it\n  when new ones are added."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-4" {
				- "global object"
			}
			- " has an "
			dfn id="about-to-be-notified-rejected-promises-list" {
				- "about-to-be-notified rejected promises list"
			}
			- ", a\n  "
			a id="realms-settings-objects-global-objects:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
				- "list"
			}
			- " of "
			code id="realms-settings-objects-global-objects:idl-promise-2" {
				a data-x-internal="idl-promise" href="https://webidl.spec.whatwg.org/#idl-promise" {
					- "Promise"
				}
			}
			- " objects, initially empty."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-5" {
				- "global object"
			}
			- " has an "
			dfn id="concept-global-import-map" {
				- "import map"
			}
			- ",\n  initially an "
			a href="#empty-import-map" id="realms-settings-objects-global-objects:empty-import-map" {
				- "empty import map"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "For now, only "
			code id="realms-settings-objects-global-objects:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-6" {
				- "global\n  objects"
			}
			- " have their "
			a href="#concept-global-import-map" id="realms-settings-objects-global-objects:concept-global-import-map" {
				- "import map"
			}
			- " modified\n  from the initial empty one. The "
			a href="#concept-global-import-map" id="realms-settings-objects-global-objects:concept-global-import-map-2" {
				- "import map"
			}
			- " is\n  only accessed for the resolution of a root "
			a href="#module-script" id="realms-settings-objects-global-objects:module-script" {
				- "module script"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-7" {
				- "global object"
			}
			- " has a "
			dfn id="resolved-module-set" {
				- "resolved module set"
			}
			- ", a "
			a id="realms-settings-objects-global-objects:set-2" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
				- "set"
			}
			- "\n  of "
			a href="#specifier-resolution-record" id="realms-settings-objects-global-objects:specifier-resolution-record" {
				- "specifier resolution records"
			}
			- ", initially\n  empty."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#resolved-module-set" id="realms-settings-objects-global-objects:resolved-module-set" {
				- "resolved module set"
			}
			- " ensures that module specifier resolution\n  returns the same result when called multiple times with the same (referrer, specifier) pair. It\n  does that by ensuring that "
			a href="#import-map" id="realms-settings-objects-global-objects:import-map" {
				- "import map"
			}
			- " rules that impact the specifier in its\n  referrer's scope cannot be defined after its initial resolution. For now, only "
			code id="realms-settings-objects-global-objects:window-3" {
				a href="#window" {
					- "Window"
				}
			}
			- "\n  "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-8" {
				- "global objects"
			}
			- " have their module set data structures modified\n  from the initial empty one."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "There is always a 1-to-1-to-1 mapping between "
			a href="https://tc39.es/ecma262/#sec-code-realms" id="realms-settings-objects-global-objects:realm-3" data-x-internal="realm" {
				- "realms"
			}
			- ", "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-9" {
				- "global objects"
			}
			- ", and "
			a href="#environment-settings-object" id="realms-settings-objects-global-objects:environment-settings-object" {
				- "environment settings objects"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					a id="realms-settings-objects-global-objects:realm-4" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- " has a [[HostDefined]] field, which contains "
					dfn data-dfn-for="realm" id="concept-realm-settings-object" data-lt="settings object" data-export="" {
						- "the realm's\n   settings object"
					}
					- "."
				}
			}
			li {
				p {
					- "A "
					a id="realms-settings-objects-global-objects:realm-5" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- " has a [[GlobalObject]] field, which contains "
					dfn data-dfn-for="realm" id="concept-realm-global" data-lt="global object" data-export="" {
						- "the realm's global\n   object"
					}
					- "."
				}
			}
			li {
				p {
					- "Each "
					a href="#global-object" id="realms-settings-objects-global-objects:global-object-10" {
						- "global object"
					}
					- " in this specification is created during the "
					a href="#creating-a-new-javascript-realm" id="realms-settings-objects-global-objects:creating-a-new-javascript-realm-2" {
						- "creation"
					}
					- " of a corresponding "
					a id="realms-settings-objects-global-objects:realm-6" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- ", known as\n   "
					dfn data-dfn-for="global object" id="concept-global-object-realm" data-lt="realm" data-export="" {
						- "the global\n   object's realm"
					}
					- "."
				}
			}
			li id="relevant-settings-object-for-a-global-object" {
				p {
					- "Each "
					a href="#global-object" id="realms-settings-objects-global-objects:global-object-11" {
						- "global object"
					}
					- " in this\n   specification is created alongside a corresponding "
					a href="#environment-settings-object" id="realms-settings-objects-global-objects:environment-settings-object-2" {
						- "environment settings object"
					}
					- ",\n   known as its "
					a href="#relevant-settings-object" id="realms-settings-objects-global-objects:relevant-settings-object" {
						- "relevant settings object"
					}
					- "."
				}
				- "\n\n   "
			}
			li {
				p {
					- "An "
					a href="#environment-settings-object" id="realms-settings-objects-global-objects:environment-settings-object-3" {
						- "environment settings object"
					}
					- "'s "
					a href="#realm-execution-context" id="realms-settings-objects-global-objects:realm-execution-context" {
						- "realm execution context"
					}
					- "'s\n   Realm component is "
					dfn data-dfn-for="environment settings object" id="environment-settings-object's-realm" data-lt="realm" data-export="" {
						- "the environment settings object's realm"
					}
					- "."
				}
			}
			li {
				p {
					- "An "
					a href="#environment-settings-object" id="realms-settings-objects-global-objects:environment-settings-object-4" {
						- "environment settings object"
					}
					- "'s "
					a href="#environment-settings-object's-realm" id="realms-settings-objects-global-objects:environment-settings-object's-realm" {
						- "realm"
					}
					- " then has a [[GlobalObject]] field, which contains "
					dfn data-dfn-for="environment settings\n   object" id="concept-settings-object-global" data-lt="global object" data-export="" {
						- "the environment settings object's global object"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="creating-a-new-javascript-realm" data-export="" {
				- "create a new\n  realm"
			}
			- " in an "
			a id="realms-settings-objects-global-objects:agent" href="https://tc39.es/ecma262/#sec-agents" data-x-internal="agent" {
				- "agent"
			}
			- " "
			var {
				- "agent"
			}
			- ", optionally with instructions to create a\n  global object or a global "
			b {
				- "this"
			}
			- " binding (or both), the following steps are taken:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Perform "
					a href="https://tc39.es/ecma262/#sec-initializehostdefinedrealm" id="realms-settings-objects-global-objects:js-initializehostdefinedrealm" data-x-internal="js-initializehostdefinedrealm" {
						- "InitializeHostDefinedRealm"
					}
					- "()\n   with the provided customizations for creating the global object and the global "
					b {
						- "this"
					}
					- "\n   binding."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "realm execution context"
					}
					- " be the "
					a id="realms-settings-objects-global-objects:running-javascript-execution-context" href="https://tc39.es/ecma262/#running-execution-context" data-x-internal="running-javascript-execution-context" {
						- "running JavaScript execution\n    context"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This is the "
					a id="realms-settings-objects-global-objects:javascript-execution-context" href="https://tc39.es/ecma262/#sec-execution-contexts" data-x-internal="javascript-execution-context" {
						- "JavaScript execution context"
					}
					- " created in the previous\n    step."
				}
				- "\n   "
			}
			li {
				p {
					- "Remove "
					var {
						- "realm execution context"
					}
					- " from the "
					a id="realms-settings-objects-global-objects:javascript-execution-context-stack" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution context\n   stack"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "realm"
					}
					- " be "
					var {
						- "realm execution context"
					}
					- "'s Realm component."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "agent"
					}
					- "'s "
					a id="realms-settings-objects-global-objects:agent-cluster" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
						- "agent cluster"
					}
					- "'s "
					a href="#agent-cluster-cross-origin-isolation" id="realms-settings-objects-global-objects:agent-cluster-cross-origin-isolation" {
						- "cross-origin isolation mode"
					}
					- " is \""
					code id="realms-settings-objects-global-objects:cross-origin-isolation-none" {
						a href="#cross-origin-isolation-none" {
							- "none"
						}
					}
					- "\", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "global"
							}
							- " be "
							var {
								- "realm"
							}
							- "'s "
							a href="#concept-realm-global" id="realms-settings-objects-global-objects:concept-realm-global" {
								- "global\n     object"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "status"
							}
							- " be ! "
							var {
								- "global"
							}
							- ".[[Delete]](\""
							code {
								- "SharedArrayBuffer"
							}
							- "\")."
						}
					}
					li {
						p {
							a id="realms-settings-objects-global-objects:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "status"
							}
							- " is true."
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "This is done for compatibility with web content and there is some hope that this\n    can be removed in the future. Web developers can still get at the constructor through\n    "
					code class="js" {
						- "new WebAssembly.Memory({ shared:true, initial:0, maximum:0\n    }).buffer.constructor"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "realm execution context"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When defining algorithm steps throughout this specification, it is often important to indicate\n  what "
			a id="realms-settings-objects-global-objects:realm-7" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- " is to be used—or, equivalently, what "
			a href="#global-object" id="realms-settings-objects-global-objects:global-object-12" {
				- "global object"
			}
			- " or\n  "
			a href="#environment-settings-object" id="realms-settings-objects-global-objects:environment-settings-object-5" {
				- "environment settings object"
			}
			- " is to be used. In general, there are at least four\n  possibilities:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="concept-entry-everything" {
					- "Entry"
				}
			}
			dd {
				- "This corresponds to the script that initiated the currently running script action: i.e.,\n    the function or script that the user agent called into when it called into author code."
			}
			dt {
				dfn id="concept-incumbent-everything" {
					- "Incumbent"
				}
			}
			dd {
				- "This corresponds to the most-recently-entered author function or script on the stack, or the\n    author function or script that originally scheduled the currently-running callback."
			}
			dt {
				dfn id="concept-current-everything" {
					- "Current"
				}
			}
			dd {
				- "This corresponds to the currently-running function object, including built-in user-agent\n    functions which might not be implemented as JavaScript. (It is derived from the "
				a id="realms-settings-objects-global-objects:current-realm" href="https://tc39.es/ecma262/#current-realm" data-x-internal="current-realm" {
					- "current\n    realm"
				}
				- ".)"
			}
			dt {
				dfn id="concept-relevant-everything" {
					- "Relevant"
				}
			}
			dd {
				- "Every "
				a id="realms-settings-objects-global-objects:platform-object" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- " has a "
				a href="#concept-relevant-realm" id="realms-settings-objects-global-objects:concept-relevant-realm" {
					- "relevant\n    realm"
				}
				- ", which is roughly the "
				a id="realms-settings-objects-global-objects:realm-8" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
					- "realm"
				}
				- " in which it was created. When writing\n    algorithms, the most prominent "
				a id="realms-settings-objects-global-objects:platform-object-2" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- " whose "
				a href="#concept-relevant-realm" id="realms-settings-objects-global-objects:concept-relevant-realm-2" {
					- "relevant realm"
				}
				- " might be important is the "
				b {
					- "this"
				}
				- "\n    value of the currently-running function object. In some cases, there can be other important\n    "
				a href="#concept-relevant-realm" id="realms-settings-objects-global-objects:concept-relevant-realm-3" {
					- "relevant realms"
				}
				- ", such as those of any\n    arguments."
			}
		}
		- "\n\n  "
		p {
			- "Note how the "
			a href="#concept-entry-everything" id="realms-settings-objects-global-objects:concept-entry-everything" {
				- "entry"
			}
			- ", "
			a href="#concept-incumbent-everything" id="realms-settings-objects-global-objects:concept-incumbent-everything" {
				- "incumbent"
			}
			- ", and "
			a href="#concept-current-everything" id="realms-settings-objects-global-objects:concept-current-everything" {
				- "current"
			}
			- " concepts are usable without qualification,\n  whereas the "
			a href="#concept-relevant-everything" id="realms-settings-objects-global-objects:concept-relevant-everything" {
				- "relevant"
			}
			- " concept must be applied to\n  a particular "
			a id="realms-settings-objects-global-objects:platform-object-3" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
				- "platform object"
			}
			- "."
		}
		- "\n\n  "
		p class="warning" {
			- "The "
			a href="#concept-incumbent-everything" id="realms-settings-objects-global-objects:concept-incumbent-everything-2" {
				- "incumbent"
			}
			- " and "
			a href="#concept-entry-everything" id="realms-settings-objects-global-objects:concept-entry-everything-2" {
				- "entry"
			}
			- " concepts should not be used by new specifications,\n  as they are excessively complicated and unintuitive to work with. We are working to remove almost\n  all existing uses from the platform: see "
			a href="https://github.com/whatwg/html/issues/1430" {
				- "issue #1430"
			}
			- " for "
			a href="#concept-incumbent-everything" id="realms-settings-objects-global-objects:concept-incumbent-everything-3" {
				- "incumbent"
			}
			- ", and "
			a href="https://github.com/whatwg/html/issues/1431" {
				- "issue #1431"
			}
			- " for "
			a href="#concept-entry-everything" id="realms-settings-objects-global-objects:concept-entry-everything-3" {
				- "entry"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "In general, web platform specifications should use the "
			a href="#concept-relevant-everything" id="realms-settings-objects-global-objects:concept-relevant-everything-2" {
				- "relevant"
			}
			- " concept, applied to the object being operated\n  on (usually the "
			b {
				- "this"
			}
			- " value of the current method). This mismatches the JavaScript\n  specification, where "
			a href="#concept-current-everything" id="realms-settings-objects-global-objects:concept-current-everything-2" {
				- "current"
			}
			- " is generally used as\n  the default (e.g., in determining the "
			a id="realms-settings-objects-global-objects:realm-9" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- " whose "
			code {
				- "Array"
			}
			- "\n  constructor should be used to construct the result in "
			code {
				- "Array.prototype.map"
			}
			- ").\n  But this inconsistency is so embedded in the platform that we have to accept it going forward."
		}
		- "\n\n  "
