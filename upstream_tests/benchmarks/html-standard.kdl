				}
			}
			- "\n\n   "
			p {
				- "In this example, the canvas will display a text using "
				code {
					- "myfont.ttf"
				}
				- ".\n   Notice that the font is only loaded inside the worker, and not in the document context."
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasTextDrawingStyles" id="dom-context-2d-font" data-dfn-type="attribute" {
				code {
					- "font"
				}
			}
			- " IDL attribute, on setting, must be "
			a href="https://drafts.csswg.org/css-syntax/#parse-grammar" id="text-styles:parse-something-according-to-a-css-grammar" data-x-internal="parse-something-according-to-a-css-grammar" {
				- "parsed as a CSS <'font'> value"
			}
			- " (but\n  without supporting property-independent style sheet syntax like 'inherit'), and the resulting font\n  must be assigned to the context, with the "
			a id="text-styles:'line-height'" href="https://drafts.csswg.org/css2/#propdef-line-height" data-x-internal="'line-height'" {
				- "'line-height'"
			}
			- " component forced to 'normal',\n  with the "
			a id="text-styles:'font-size'" href="https://drafts.csswg.org/css-fonts/#font-size-prop" data-x-internal="'font-size'" {
				- "'font-size'"
			}
			- " component converted to "
			a href="https://drafts.csswg.org/css-values/#px" id="text-styles:'px'" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- ",\n  and with system fonts being computed to explicit values. If the new value is syntactically\n  incorrect (including using property-independent style sheet syntax like 'inherit' or 'initial'),\n  then it must be ignored, without assigning a new font value. "
			a href="#refsCSS" {
				- "[CSS]"
			}
		}
		- "\n\n  "
		p {
			- "Font family names must be interpreted in the context of the "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-4" {
				- "font style source\n  object"
			}
			- " when the font is to be used; any fonts embedded using "
			code {
				- "@font-face"
			}
			- " or loaded using "
			code id="text-styles:fontface" {
				a href="#fontface" {
					- "FontFace"
				}
			}
			- " objects that are visible to the\n  "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-5" {
				- "font style source object"
			}
			- " must therefore be available once they are loaded. (Each "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-6" {
				- "font style source\n  object"
			}
			- " has a "
			a id="text-styles:font-source-2" href="https://drafts.csswg.org/css-font-loading/#font-source" data-x-internal="font-source" {
				- "font source"
			}
			- ", which determines what fonts are available.) If a font\n  is used before it is fully loaded, or if the "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-7" {
				- "font style source object"
			}
			- " does not have\n  that font in scope at the time the font is to be used, then it must be treated as if it was an\n  unknown font, falling back to another as described by the relevant CSS specifications.\n  "
			a href="#refsCSSFONTS" {
				- "[CSSFONTS]"
			}
			- " "
			a href="#refsCSSFONTLOAD" {
				- "[CSSFONTLOAD]"
			}
		}
		- "\n\n  "
		p {
			- "On getting, the "
			code id="text-styles:dom-context-2d-font-2" {
				a href="#dom-context-2d-font" {
					- "font"
				}
			}
			- " attribute must return the "
			a href="https://drafts.csswg.org/cssom/#serialize-a-css-value" id="text-styles:serializing-a-css-value" data-x-internal="serializing-a-css-value" {
				- "serialized form"
			}
			- " of the current font of the context (with\n  no "
			a id="text-styles:'line-height'-2" href="https://drafts.csswg.org/css2/#propdef-line-height" data-x-internal="'line-height'" {
				- "'line-height'"
			}
			- " component). "
			a href="#refsCSSOM" {
				- "[CSSOM]"
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For example, after the following statement:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					- "context"
					c- p="" {
						- "."
					}
					- "font "
					c- o="" {
						- "="
					}
					- " "
					c- t="" {
						- "'italic 400 12px/2 Unknown Font, sans-serif'"
					}
					c- p="" {
						- ";"
					}
				}
			}
			- "\n\n   "
			p {
				- "...the expression "
				code {
					- "context.font"
				}
				- " would evaluate to the string \""
				code {
					- "italic 12px \"Unknown Font\", sans-serif"
				}
				- "\". The \"400\"\n   font-weight doesn't appear because that is the default value. The line-height doesn't appear\n   because it is forced to \"normal\", the default value."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "When the object implementing the "
			code id="text-styles:canvastextdrawingstyles-3" {
				a href="#canvastextdrawingstyles" {
					- "CanvasTextDrawingStyles"
				}
			}
			- " interface is created, the\n  font of the context must be set to 10px sans-serif. When the "
			a id="text-styles:'font-size'-2" href="https://drafts.csswg.org/css-fonts/#font-size-prop" data-x-internal="'font-size'" {
				- "'font-size'"
			}
			- " component is\n  set to lengths using percentages, "
			a id="text-styles:'em'" href="https://drafts.csswg.org/css-values/#em" data-x-internal="'em'" {
				- "'em'"
			}
			- " or "
			a id="text-styles:'ex'" href="https://drafts.csswg.org/css-values/#ex" data-x-internal="'ex'" {
				- "'ex'"
			}
			- " units, or the 'larger' or\n  'smaller' keywords, these must be interpreted relative to the "
			a id="text-styles:computed-value" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- " of the\n  "
			a id="text-styles:'font-size'-3" href="https://drafts.csswg.org/css-fonts/#font-size-prop" data-x-internal="'font-size'" {
				- "'font-size'"
			}
			- " property of the "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-8" {
				- "font style source object"
			}
			- " at the time that\n  the attribute is set, if it is an element. When the "
			a id="text-styles:'font-weight'" href="https://drafts.csswg.org/css-fonts/#font-weight-prop" data-x-internal="'font-weight'" {
				- "'font-weight'"
			}
			- " component is set to\n  the relative values 'bolder' and 'lighter', these must be interpreted relative to the\n  "
			a id="text-styles:computed-value-2" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- " of the "
			a id="text-styles:'font-weight'-2" href="https://drafts.csswg.org/css-fonts/#font-weight-prop" data-x-internal="'font-weight'" {
				- "'font-weight'"
			}
			- " property of the "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-9" {
				- "font style\n  source object"
			}
			- " at the time that the attribute is set, if it is an element. If the "
			a href="https://drafts.csswg.org/css-cascade/#computed-value" id="text-styles:computed-value-3" data-x-internal="computed-value" {
				- "computed values"
			}
			- " are undefined for a particular case (e.g. because\n  the "
			a href="#font-style-source-object" id="text-styles:font-style-source-object-10" {
				- "font style source object"
			}
			- " is not an element or is not "
			a href="#being-rendered" id="text-styles:being-rendered" {
				- "being\n  rendered"
			}
			- "), then the relative keywords must be interpreted relative to the normal-weight\n  10px sans-serif default."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasTextDrawingStyles" id="dom-context-2d-textalign" data-dfn-type="attribute" {
				code {
					- "textAlign"
				}
			}
			- " IDL attribute, on getting, must return\n  the current value. On setting, the current value must be changed to the new value. When the object\n  implementing the "
			code id="text-styles:canvastextdrawingstyles-4" {
				a href="#canvastextdrawingstyles" {
					- "CanvasTextDrawingStyles"
				}
			}
			- " interface is created, the "
			code id="text-styles:dom-context-2d-textalign-2" {
				a href="#dom-context-2d-textalign" {
					- "textAlign"
				}
			}
			- " attribute must initially have the value "
			code id="text-styles:dom-context-2d-textalign-start" {
				a href="#dom-context-2d-textalign-start" {
					- "start"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasTextDrawingStyles" id="dom-context-2d-textbaseline" data-dfn-type="attribute" {
				code {
					- "textBaseline"
				}
			}
			- " IDL attribute, on getting, must\n  return the current value. On setting, the current value must be changed to the new value. When the\n  object implementing the "
			code id="text-styles:canvastextdrawingstyles-5" {
				a href="#canvastextdrawingstyles" {
					- "CanvasTextDrawingStyles"
				}
			}
			- " interface is created, the "
			code id="text-styles:dom-context-2d-textbaseline-2" {
				a href="#dom-context-2d-textbaseline" {
					- "textBaseline"
				}
			}
			- " attribute must initially have the value\n  "
			code id="text-styles:dom-context-2d-textbaseline-alphabetic-2" {
				a href="#dom-context-2d-textbaseline-alphabetic" {
					- "alphabetic"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasTextDrawingStyles" id="dom-context-2d-direction" data-dfn-type="attribute" {
				code {
					- "direction"
				}
			}
			- " IDL attribute, on getting, must return\n  the current value. On setting, the current value must be changed to the new value. When the object\n  implementing the "
			code id="text-styles:canvastextdrawingstyles-6" {
				a href="#canvastextdrawingstyles" {
					- "CanvasTextDrawingStyles"
				}
			}
			- " interface is created, the "
			code id="text-styles:dom-context-2d-direction-2" {
				a href="#dom-context-2d-direction" {
					- "direction"
				}
			}
			- " attribute must initially have the value \""
			code id="text-styles:dom-context-2d-direction-inherit-2" {
				a href="#dom-context-2d-direction-inherit" {
					- "inherit"
				}
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "Objects that implement the "
			code id="text-styles:canvastextdrawingstyles-7" {
				a href="#canvastextdrawingstyles" {
					- "CanvasTextDrawingStyles"
				}
			}
			- " interface have attributes that\n  control the spacing between letters and words. Such objects have associated "
			dfn id="concept-canvastextdrawingstyles-letter-spacing" {
				- "letter spacing"
			}
			- " and "
			dfn id="concept-canvastextdrawingstyles-word-spacing" {
				- "word spacing"
			}
			- " values, which are CSS\n  "
			a id="text-styles:length-2-3" href="https://drafts.csswg.org/css-values/#lengths" data-x-internal="length-2" {
				- "<length>"
			}
			- " values. Initially, both must be the result of "
			a href="https://drafts.csswg.org/css-syntax/#parse-grammar" id="text-styles:parse-something-according-to-a-css-grammar-2" data-x-internal="parse-something-according-to-a-css-grammar" {
				- "parsing"
			}
			- " \""
			code {
				- "0px"
			}
			- "\" as a CSS\n  "
			a id="text-styles:length-2-4" href="https://drafts.csswg.org/css-values/#lengths" data-x-internal="length-2" {
				- "<length>"
			}
			- "."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in one engine only." class="less-than-two-engines-flag" {
					- "⚠"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/letterSpacing" title="The CanvasRenderingContext2D.letterSpacing property of the Canvas API specifies the spacing between letters when drawing text." {
						- "CanvasRenderingContext2D/letterSpacing"
					}
				}
				p class="less-than-two-engines-text" {
					- "Support in one engine only."
				}
				div class="support" {
					span class="firefox no" {
						span {
							- "Firefox"
						}
						span {
							- "No"
						}
