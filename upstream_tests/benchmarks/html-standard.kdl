			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-hidden-attribute:attr-hidden-10" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute must not be used to hide content that\n  could legitimately be shown in another presentation. For example, it is incorrect to use "
			code id="the-hidden-attribute:attr-hidden-11" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " to hide panels in a tabbed dialog, because the tabbed interface\n  is merely a kind of overflow presentation — one could equally well just show all the form\n  controls in one big page with a scrollbar. It is similarly incorrect to use this attribute to hide\n  content just from one presentation — if something is marked "
			code id="the-hidden-attribute:attr-hidden-12" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- ", it is hidden from all presentations, including, for instance,\n  screen readers."
		}
		- "\n\n  \n  \n\n  "
		p {
			- "Elements that are not themselves "
			code id="the-hidden-attribute:attr-hidden-13" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " must not\n  "
			a href="#hyperlink" id="the-hidden-attribute:hyperlink" {
				- "hyperlink"
			}
			- " to elements that are "
			code id="the-hidden-attribute:attr-hidden-14" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- ". The "
			code {
				- "for"
			}
			- " attributes of "
			code id="the-hidden-attribute:the-label-element" {
				a href="#the-label-element" {
					- "label"
				}
			}
			- " and "
			code id="the-hidden-attribute:the-output-element" {
				a href="#the-output-element" {
					- "output"
				}
			}
			- " elements that are not\n  themselves "
			code id="the-hidden-attribute:attr-hidden-15" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " must similarly not refer to elements that are\n  "
			code id="the-hidden-attribute:attr-hidden-16" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- ". In both cases, such references would cause user\n  confusion."
		}
		- "\n\n  "
		p {
