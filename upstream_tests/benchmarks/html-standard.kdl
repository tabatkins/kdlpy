			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-inselectintable:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the\n  token as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A start tag whose tag name is one of: \"caption\", \"table\", \"tbody\", \"tfoot\", \"thead\", \"tr\",\n   \"td\", \"th\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inselectintable:parse-errors" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    \n    "
				p {
					- "Pop elements from the "
					a href="#stack-of-open-elements" id="parsing-main-inselectintable:stack-of-open-elements" {
						- "stack of open elements"
					}
					- " until a "
					code id="parsing-main-inselectintable:the-select-element" {
						a href="#the-select-element" {
							- "select"
						}
					}
					- " element\n    has been popped from the stack."
				}
				- "\n\n    "
				p {
					a href="#reset-the-insertion-mode-appropriately" id="parsing-main-inselectintable:reset-the-insertion-mode-appropriately" {
						- "Reset the insertion mode appropriately"
					}
					- "."
				}
				- "\n    \n\n    "
				p {
					- "Reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"caption\", \"table\", \"tbody\", \"tfoot\", \"thead\", \"tr\",\n   \"td\", \"th\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inselectintable:parse-errors-2" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inselectintable:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-table-scope" id="parsing-main-inselectintable:has-an-element-in-table-scope" {
						- "have an element in table scope"
					}
					- " that is an "
					a href="#html-elements" id="parsing-main-inselectintable:html-elements" {
						- "HTML\n    element"
					}
					- " with the same tag name as that of the token, then ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    \n    "
				p {
					- "Pop elements from the "
					a href="#stack-of-open-elements" id="parsing-main-inselectintable:stack-of-open-elements-3" {
						- "stack of open elements"
					}
					- " until a "
					code id="parsing-main-inselectintable:the-select-element-2" {
						a href="#the-select-element" {
							- "select"
						}
					}
					- " element\n    has been popped from the stack."
				}
				- "\n\n    "
				p {
					a href="#reset-the-insertion-mode-appropriately" id="parsing-main-inselectintable:reset-the-insertion-mode-appropriately-2" {
						- "Reset the insertion mode appropriately"
					}
					- "."
				}
				- "\n    \n\n    "
				p {
					- "Reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "Anything else"
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-inselectintable:using-the-rules-for" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inselect" id="parsing-main-inselectintable:parsing-main-inselect" {
						- "in select"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-inselectintable:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n\n\n  "
		h6 id="parsing-main-intemplate" {
			span class="secno" {
				- "13.2.6.4.18"
			}
			- " The \""
			dfn {
				- "in template"
			}
			- "\" insertion mode"
			a href="#parsing-main-intemplate" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-intemplate" id="parsing-main-intemplate:parsing-main-intemplate" {
				- "in\n  template"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token"
			}
			dt {
				- "A comment token"
			}
			dt {
				- "A DOCTYPE token"
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-intemplate:using-the-rules-for" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inbody" id="parsing-main-intemplate:parsing-main-inbody" {
						- "in body"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"base\", \"basefont\", \"bgsound\", \"link\", \"meta\", \"noframes\", \"script\", \"style\", \"template\", \"title\""
			}
			dt {
				- "An end tag whose tag name is \"template\""
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-intemplate:using-the-rules-for-2" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inhead" id="parsing-main-intemplate:parsing-main-inhead" {
						- "in head"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-3" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"caption\", \"colgroup\", \"tbody\", \"tfoot\", \"thead\""
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-intable" id="parsing-main-intemplate:parsing-main-intable" {
						- "in table"
					}
					- "\" onto the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-2" {
						- "stack of\n    template insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-2" {
						- "current template insertion\n    mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-4" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intable" id="parsing-main-intemplate:parsing-main-intable-2" {
						- "in\n    table"
					}
					- "\", and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"col\""
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-3" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-3" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-incolgroup" id="parsing-main-intemplate:parsing-main-incolgroup" {
						- "in column group"
					}
					- "\" onto the\n    "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-4" {
						- "stack of template insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-4" {
						- "current template\n    insertion mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-5" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-incolgroup" id="parsing-main-intemplate:parsing-main-incolgroup-2" {
						- "in\n    column group"
					}
					- "\", and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"tr\""
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-5" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-5" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-intbody" id="parsing-main-intemplate:parsing-main-intbody" {
						- "in table body"
					}
					- "\" onto the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-6" {
						- "stack\n    of template insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-6" {
						- "current template insertion\n    mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-6" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intbody" id="parsing-main-intemplate:parsing-main-intbody-2" {
						- "in\n    table body"
					}
					- "\", and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"td\", \"th\""
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-7" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-7" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-intr" id="parsing-main-intemplate:parsing-main-intr" {
						- "in row"
					}
					- "\" onto the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-8" {
						- "stack of template\n    insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-8" {
						- "current template insertion mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-7" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intr" id="parsing-main-intemplate:parsing-main-intr-2" {
						- "in\n    row"
					}
					- "\", and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "Any other start tag"
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-9" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-9" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Push \""
					a href="#parsing-main-inbody" id="parsing-main-intemplate:parsing-main-inbody-2" {
						- "in body"
					}
					- "\" onto the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-10" {
						- "stack of template\n    insertion modes"
					}
					- " so that it is the new "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-10" {
						- "current template insertion mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intemplate:insertion-mode-8" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inbody" id="parsing-main-intemplate:parsing-main-inbody-3" {
						- "in\n    body"
					}
					- "\", and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "Any other end tag"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-intemplate:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "An end-of-file token"
			}
			dd {
				- "\n    "
				p {
					- "If there is no "
					code id="parsing-main-intemplate:the-template-element" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the "
					a href="#stack-of-open-elements" id="parsing-main-intemplate:stack-of-open-elements" {
						- "stack of open elements"
					}
					- ", then\n    "
					a href="#stop-parsing" id="parsing-main-intemplate:stop-parsing" {
						- "stop parsing"
					}
					- ". ("
					a href="#fragment-case" id="parsing-main-intemplate:fragment-case" {
						- "fragment case"
					}
					- ")"
				}
				- "\n\n    "
				p {
					- "Otherwise, this is a "
					a href="#parse-errors" id="parsing-main-intemplate:parse-errors-2" {
						- "parse error"
					}
					- "."
				}
				- "\n\n    \n    "
				p {
					- "Pop elements from the "
					a href="#stack-of-open-elements" id="parsing-main-intemplate:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- " until a "
					code id="parsing-main-intemplate:the-template-element-2" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- "\n    element has been popped from the stack."
				}
				- "\n\n    "
				p {
					a href="#clear-the-list-of-active-formatting-elements-up-to-the-last-marker" id="parsing-main-intemplate:clear-the-list-of-active-formatting-elements-up-to-the-last-marker" {
						- "Clear the list of active formatting elements up to the last marker"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id="parsing-main-intemplate:current-template-insertion-mode-11" {
						- "current template insertion mode"
					}
					- " off the "
					a href="#stack-of-template-insertion-modes" id="parsing-main-intemplate:stack-of-template-insertion-modes-11" {
						- "stack of template\n    insertion modes"
					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#reset-the-insertion-mode-appropriately" id="parsing-main-intemplate:reset-the-insertion-mode-appropriately" {
						- "Reset the insertion mode appropriately"
					}
					- "."
				}
				- "\n    \n\n    "
				p {
					- "Reprocess the token."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="parsing-main-afterbody" {
			span class="secno" {
				- "13.2.6.4.19"
			}
			- " The \""
			dfn {
				- "after body"
			}
			- "\" insertion mode"
			a href="#parsing-main-afterbody" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-afterbody" id="parsing-main-afterbody:parsing-main-afterbody" {
				- "after body"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-afterbody:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C\n   FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-afterbody:using-the-rules-for" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inbody" id="parsing-main-afterbody:parsing-main-inbody" {
						- "in body"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-afterbody:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "A comment token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-comment" id="parsing-main-afterbody:insert-a-comment" {
						- "Insert a comment"
					}
					- " as the last child of the first element in the "
					a href="#stack-of-open-elements" id="parsing-main-afterbody:stack-of-open-elements" {
						- "stack of\n    open elements"
					}
					- " (the "
					code id="parsing-main-afterbody:the-html-element" {
						a href="#the-html-element" {
							- "html"
						}
					}
					- " element)."
				}
				- "\n   "
			}
			dt {
				- "A DOCTYPE token"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-afterbody:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"html\""
			}
			dd {
				- "\n    "
				p {
					- "Process the token "
					a href="#using-the-rules-for" id="parsing-main-afterbody:using-the-rules-for-2" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inbody" id="parsing-main-afterbody:parsing-main-inbody-2" {
						- "in body"
					}
					- "\" "
					a href="#insertion-mode" id="parsing-main-afterbody:insertion-mode-3" {
						- "insertion mode"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"html\""
			}
			dd {
				- "\n    "
				p {
					- "If the parser was created as part of the "
					a href="#html-fragment-parsing-algorithm" id="parsing-main-afterbody:html-fragment-parsing-algorithm" {
						- "HTML fragment parsing algorithm"
					}
					- ", this\n    is a "
					a href="#parse-errors" id="parsing-main-afterbody:parse-errors-2" {
						- "parse error"
					}
					- "; ignore the token. ("
					a href="#fragment-case" id="parsing-main-afterbody:fragment-case" {
						- "fragment case"
					}
					- ")"
				}
				- "\n\n    "
				p {
					- "Otherwise, switch the "
					a href="#insertion-mode" id="parsing-main-afterbody:insertion-mode-4" {
						- "insertion mode"
					}
					- " to \""
					a href="#the-after-after-body-insertion-mode" id="parsing-main-afterbody:the-after-after-body-insertion-mode" {
						- "after after body"
					}
					- "\"."
				}
				- "\n   "
			}
			dt {
				- "An end-of-file token"
			}
			dd {
				- "\n    "
