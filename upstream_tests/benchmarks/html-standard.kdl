		div class="example" {
			- "\n\n   "
			p {
				- "For radio buttons, the "
				code id="the-required-attribute:attr-input-required-2" {
					a href="#attr-input-required" {
						- "required"
					}
				}
				- " attribute is\n   satisfied if any of the radio buttons in the "
				a href="#radio-button-group" id="the-required-attribute:radio-button-group" {
					- "group"
				}
				- " is\n   selected. Thus, in the following example, any of the radio buttons can be checked, not just the\n   one marked as required:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "fieldset"
