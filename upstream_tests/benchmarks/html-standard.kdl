									}
									c- o="" {
										- "="
									}
									c- s="" {
										- "\"bar\""
									}
									- " =\""
									c- e="" {
										- "baz"
									}
									- "\""
									c- p="" {
										- ">"
									}
								}
							}
							- "\n\n       "
							p {
								- "Due to a forgotten attribute name the parser treats this markup as a "
								code id="parse-errors:the-div-element-4" {
									a href="#the-div-element" {
										- "div"
									}
								}
								- "\n       element with two attributes: a \""
								code {
									- "foo"
								}
								- "\" attribute with a \""
								code {
									- "bar"
								}
								- "\" value and a \""
								code {
									- "=\"baz\""
								}
								- "\" attribute with an empty\n       value."
							}
							- "\n      "
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-null-character" {
							- "unexpected-null-character"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a U+0000 NULL "
							a id="parse-errors:code-point-26" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " in the\n     "
							a href="#input-stream" id="parse-errors:input-stream-11" {
								- "input stream"
							}
							- " in certain positions. In general, such code points are either\n     ignored or, for security reasons, replaced with a U+FFFD REPLACEMENT CHARACTER."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-question-mark-instead-of-tag-name" {
							- "unexpected-question-mark-instead-of-tag-name"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters a U+003F (?) "
							a id="parse-errors:code-point-27" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " where first\n      code point of a "
							a href="#syntax-start-tag" id="parse-errors:syntax-start-tag-5" {
								- "start tag"
							}
							- " name is expected. The U+003F\n      (?) and all content that follows up to a U+003E (>) code point (if present) or to the end of\n      the "
							a href="#input-stream" id="parse-errors:input-stream-12" {
								- "input stream"
							}
							- " is treated as a comment."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "For example, consider the following markup:"
							}
							- "\n\n       "
							pre {
								code class="html" {
									c- cp="" {
										- "<?xml-stylesheet type=\"text/css\" href=\"style.css\"?>"
									}
								}
							}
							- "\n\n       "
							p {
								- "This will be parsed into:"
							}
							- "\n\n       "
							ul class="domTree" {
								li class="t8" {
									code id="parse-errors:comment-2-2" {
										a data-x-internal="comment-2" href="https://dom.spec.whatwg.org/#interface-comment" {
											- "#comment"
										}
									}
									- ": "
									span {
										- "?xml-stylesheet type=\"text/css\" href=\"style.css\"?"
									}
								}
								li class="t1" {
									code id="parse-errors:the-html-element-3" {
										a href="#the-html-element" {
											- "html"
										}
									}
									ul {
										li class="t1" {
											code id="parse-errors:the-head-element-3" {
												a href="#the-head-element" {
													- "head"
												}
											}
										}
										li class="t1" {
											code id="parse-errors:the-body-element-3" {
												a href="#the-body-element" {
													- "body"
												}
											}
										}
									}
								}
							}
							- "\n      "
						}
						- "\n\n      "
						p class="note" {
							- "The common reason for this error is an XML processing instruction (e.g., "
							code {
								- "<?xml-stylesheet type=\"text/css\" href=\"style.css\"?>"
							}
							- ") or an XML declaration\n      (e.g., "
							code {
								- "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
							}
							- ") being used in\n      HTML."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-solidus-in-tag" {
							- "unexpected-solidus-in-tag"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a U+002F (/) "
							a id="parse-errors:code-point-28" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " that is\n     not a part of a quoted "
							a href="#syntax-attributes" id="parse-errors:syntax-attributes-5" {
								- "attribute"
							}
							- " value and not\n     immediately followed by a U+003E (>) code point in a tag (e.g., "
							code {
								- "<div /\n     id=\"foo\">"
							}
							- "). In this case the parser behaves as if it encountered "
							a id="parse-errors:space-characters-9" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII\n     whitespace"
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unknown-named-character-reference" {
							- "unknown-named-character-reference"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters an "
							a href="#syntax-ambiguous-ampersand" id="parse-errors:syntax-ambiguous-ampersand" {
								- "ambiguous ampersand"
							}
							- ". In this case the parser doesn't\n     resolve the "
							a href="#syntax-charref" id="parse-errors:syntax-charref-8" {
								- "character reference"
							}
							- "."
						}
						- "\n\n  "
					}
				}
			}
