					}
					td colspan="3" {
						a href="#hyperlink" id="linkTypes:hyperlink-5" {
							- "Hyperlink"
						}
					}
					td class="no" {
						- " · "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Provides a link to context-sensitive help."
					}
				}
				tr {
					td {
						code id="linkTypes:rel-icon" {
							a href="#rel-icon" {
								- "icon"
							}
						}
					}
					td {
						a href="#external-resource-link" id="linkTypes:external-resource-link-2" {
							- "External Resource"
