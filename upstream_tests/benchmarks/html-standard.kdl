		- "\n\n\n  "
		h5 id="using-the-accesskey-attribute-to-define-a-command-on-other-elements" {
			span class="secno" {
				- "4.11.3.7"
			}
			- " "
			dfn {
				- "Using the "
				code {
					- "accesskey"
				}
				- "\n  attribute to define a command on other elements"
			}
			a href="#using-the-accesskey-attribute-to-define-a-command-on-other-elements" class="self-link"
		}
		- "\n\n  "
		p {
			- "An element that has an "
			a href="#assigned-access-key" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:assigned-access-key" {
				- "assigned access key"
			}
			- " "
			a href="#concept-command" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:concept-command" {
				- "defines a\n  command"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "If one of the earlier sections that define elements that "
			a href="#concept-command" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:concept-command-2" {
				- "define\n  commands"
			}
			- " define that this element "
			a href="#concept-command" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:concept-command-3" {
				- "defines a command"
			}
			- ",\n  then that section applies to this element, and this section does not. Otherwise, this section\n  applies to that element."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#command-facet-label" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-label" {
				- "Label"
			}
			- " of the command depends on the element. If\n  the element is a "
			a href="#labeled-control" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:labeled-control" {
				- "labeled control"
			}
			- ", the "
			a id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:descendant-text-content" href="https://dom.spec.whatwg.org/#concept-descendant-text-content" data-x-internal="descendant-text-content" {
				- "descendant text content"
			}
			- " of the\n  first "
			code id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:the-label-element" {
				a href="#the-label-element" {
					- "label"
				}
			}
			- " element in "
			a id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
				- "tree order"
			}
			- " whose "
			a href="#labeled-control" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:labeled-control-2" {
				- "labeled control"
			}
			- " is\n  the element in question is the "
			a href="#command-facet-label" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-label-2" {
				- "Label"
			}
			- " (in JavaScript\n  terms, this is given by "
			code {
				var {
					- "element"
				}
				- ".labels[0].textContent"
			}
			- ").\n  Otherwise, the "
			a href="#command-facet-label" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-label-3" {
				- "Label"
			}
			- " is the element's "
			a id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:descendant-text-content-2" href="https://dom.spec.whatwg.org/#concept-descendant-text-content" data-x-internal="descendant-text-content" {
				- "descendant\n  text content"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#command-facet-accesskey" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-accesskey" {
				- "Access Key"
			}
			- " of the command is the element's\n  "
			a href="#assigned-access-key" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:assigned-access-key-2" {
				- "assigned access key"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#command-facet-hiddenstate" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-hiddenstate" {
				- "Hidden State"
			}
			- " of the command is true (hidden)\n  if the element has a "
			code id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:attr-hidden" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute, and false otherwise."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#command-facet-disabledstate" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-disabledstate" {
				- "Disabled State"
			}
			- " of the command is true if\n  the element or one of its ancestors is "
			a href="#inert" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:inert" {
				- "inert"
			}
			- ", and false otherwise."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#command-facet-action" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:command-facet-action" {
				- "Action"
			}
			- " of the command is to run the following\n  steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "Run the "
				a href="#focusing-steps" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:focusing-steps" {
					- "focusing steps"
				}
				- " for the element."
			}
			li {
				a href="#fire-a-click-event" id="using-the-accesskey-attribute-to-define-a-command-on-other-elements:fire-a-click-event" {
					- "Fire a "
					code {
						- "click"
					}
					- " event"
				}
				- " at the element."
			}
		}
		- "\n\n  \n\n\n  "
