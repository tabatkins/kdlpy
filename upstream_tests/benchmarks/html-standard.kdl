				a href="#attr-draggable" {
					- "draggable"
				}
			}
			- " content attribute must be set to the literal\n  value \""
			code {
				- "false"
			}
			- "\". If the "
			code id="the-draggable-attribute:dom-draggable-7" {
				a href="#dom-draggable" {
					- "draggable"
				}
			}
			- " IDL\n  attribute is set to the value true, the "
