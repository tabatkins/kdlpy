				- "represents"
			}
			- " a one line plain text edit control for\n  the element's "
			a href="#concept-fe-value" id="password-state-(type=password):concept-fe-value" {
				- "value"
			}
			- ". The user agent should obscure the value\n  so that people other than the user cannot see it."
		}
		- "\n\n  \n\n  "
