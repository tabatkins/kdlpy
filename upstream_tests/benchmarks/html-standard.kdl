							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="input,textarea" id="attr-fe-dirname" data-dfn-type="element-attr" {
				code {
					- "dirname"
				}
			}
			- "\n  attribute on a form control element enables the submission of "
			a href="#the-directionality" id="submitting-element-directionality:-the-dirname-attribute:the-directionality" {
				- "the directionality"
			}
			- " of\n  the element, and gives the name of the control that contains this value during "
			a href="#form-submission-2" id="submitting-element-directionality:-the-dirname-attribute:form-submission-2" {
				- "form\n  submission"
			}
			- ". If such an attribute is specified, its value must not be the empty string."
		}
		- "\n\n  "
		div class="example" {
