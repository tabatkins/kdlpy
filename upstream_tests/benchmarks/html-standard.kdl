		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- " Keyword\n     "
					}
					th {
						- " Description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-enter" data-dfn-type="attr-value" {
							code {
								- "enter"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should present a cue for the operation 'enter', typically\n     inserting a new line.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-done" data-dfn-type="attr-value" {
							code {
								- "done"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should present a cue for the operation 'done', typically\n     meaning there is nothing more to input and the input method editor (IME)\n     will be closed.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-go" data-dfn-type="attr-value" {
							code {
								- "go"
							}
						}
						- "\n\n     "
					}
					td {
						- " The user agent should present a cue for the operation 'go', typically\n     meaning to take the user to the target of the text they typed.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-next" data-dfn-type="attr-value" {
							code {
								- "next"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should present a cue for the operation 'next', typically\n     taking the user to the next field that will accept text.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-previous" data-dfn-type="attr-value" {
							code {
