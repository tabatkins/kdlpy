		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLOrSVGElement" id="dom-dataset" data-dfn-type="attribute" {
				code {
					- "dataset"
				}
			}
			- " IDL\n  attribute provides convenient accessors for all the "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:attr-data-*-3" {
				a href="#attr-data-*" {
					- "data-*"
				}
			}
			- "\n  attributes on an element. On getting, the "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:dom-dataset" {
				a href="#dom-dataset" {
					- "dataset"
				}
			}
			- " IDL attribute\n  must return a "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap-2" {
				a href="#domstringmap" {
					- "DOMStringMap"
				}
			}
			- " whose associated element is this element."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap-3" {
				a href="#domstringmap" {
					- "DOMStringMap"
				}
			}
			- " interface is used for the "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:dom-dataset-2" {
				a href="#dom-dataset" {
					- "dataset"
				}
			}
			- " attribute. Each "
			code id="embedding-custom-non-visible-data-with-the-data-*-attributes:domstringmap-4" {
				a href="#domstringmap" {
					- "DOMStringMap"
				}
			}
			- " has an "
