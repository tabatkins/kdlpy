				a href="#dom-context-2d-stroketext" {
					- "strokeText()"
				}
			}
			- " can spill out of the box given by the\n  font size and the width returned by "
			code id="drawing-text-to-the-bitmap:dom-context-2d-measuretext" {
				a href="#dom-context-2d-measuretext" {
					- "measureText()"
