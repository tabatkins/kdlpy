			}
			- " a summary, caption, or legend for the\n  rest of the contents of the "
			code id="the-summary-element:the-summary-element-2" {
				a href="#the-summary-element" {
					- "summary"
				}
			}
			- " element's parent "
			code id="the-summary-element:the-details-element-2" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- "\n  element, if any."
