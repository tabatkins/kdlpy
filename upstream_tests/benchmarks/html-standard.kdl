										- "default playback start position"
									}
									- " is\n       greater than zero, then "
									a href="#dom-media-seek" id="loading-the-media-resource:dom-media-seek" {
										- "seek"
									}
									- " to that time, and let "
									var {
										- "jumped"
									}
									- " be true."
								}
							}
							li {
								p {
									- "Let the "
									a href="#media-element" id="loading-the-media-resource:media-element-61" {
										- "media element"
									}
									- "'s "
									a href="#default-playback-start-position" id="loading-the-media-resource:default-playback-start-position-2" {
										- "default playback\n       start position"
									}
									- " be zero."
								}
							}
							li {
								p {
									- "Let the "
									var {
										- "initial playback position"
									}
									- " be zero."
								}
							}
							li {
								- "\n        "
								p {
									- "If either the "
									a href="#media-resource" id="loading-the-media-resource:media-resource-14" {
										- "media resource"
									}
									- " or the "
									a id="loading-the-media-resource:url-3" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
										- "URL"
									}
									- " of the "
									var {
										- "current\n        media resource"
									}
									- " indicate a particular start time, then set the "
									var {
										- "initial playback\n        position"
									}
