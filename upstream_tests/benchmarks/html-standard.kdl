			}
		}
		p {
			- "The "
			dfn data-dfn-for="ElementInternals" id="dom-elementinternals-reportvalidity" data-dfn-type="method" {
				code {
					- "reportValidity()"
				}
			}
			- " method of the\n  "
			code id="the-constraint-validation-api:elementinternals-5" {
				a href="#elementinternals" {
					- "ElementInternals"
				}
			}
			- " interface must run these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "element"
					}
					- " be this "
					code id="the-constraint-validation-api:elementinternals-6" {
						a href="#elementinternals" {
							- "ElementInternals"
						}
					}
					- "'s "
					a href="#internals-target" id="the-constraint-validation-api:internals-target-6" {
						- "target element"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is not a "
					a href="#form-associated-custom-element" id="the-constraint-validation-api:form-associated-custom-element-4" {
						- "form-associated custom element"
					}
					- ", then throw a\n   "
					a id="the-constraint-validation-api:notsupportederror-4" href="https://webidl.spec.whatwg.org/#notsupportederror" data-x-internal="notsupportederror" {
						- "\""
						code {
							- "NotSupportedError"
						}
						- "\""
					}
					- " "
					code id="the-constraint-validation-api:domexception-4" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Run the "
					a href="#report-validity-steps" id="the-constraint-validation-api:report-validity-steps-2" {
						- "report validity steps"
					}
					- " on "
					var {
						- "element"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLObjectElement,HTMLInputElement,HTMLButtonElement,HTMLSelectElement,HTMLTextAreaElement,HTMLOutputElement,HTMLFieldSetElement" id="dom-cva-validationmessage" data-dfn-type="attribute" {
				code {
					- "validationMessage"
				}
			}
			- " attribute's getter must run\n  these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If this element is not a "
					a href="#candidate-for-constraint-validation" id="the-constraint-validation-api:candidate-for-constraint-validation-5" {
						- "candidate for constraint validation"
					}
					- " or if this\n   element "
					a href="#concept-fv-valid" id="the-constraint-validation-api:concept-fv-valid-3" {
						- "satisfies its constraints"
					}
					- ", then return the empty\n   string."
				}
			}
			li {
				p {
					- "Return a suitably localized message that the user agent would show the user if this were\n   the only form control with a validity constraint problem. If the user agent would not actually\n   show a textual message in such a situation (e.g., it would show a graphical cue instead), then\n   return a suitably localized message that expresses (one or more of) the validity constraint(s)\n   that the control does not satisfy. If the element is a "
					a href="#candidate-for-constraint-validation" id="the-constraint-validation-api:candidate-for-constraint-validation-6" {
						- "candidate for constraint\n   validation"
					}
					- " and is "
					a href="#suffering-from-a-custom-error" id="the-constraint-validation-api:suffering-from-a-custom-error-2" {
						- "suffering from a custom error"
					}
					- ", then the\n   "
					a href="#custom-validity-error-message" id="the-constraint-validation-api:custom-validity-error-message-2" {
						- "custom validity error message"
					}
					- " should be present in the return value."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h5 id="security-forms" {
			span class="secno" {
				- "4.10.20.4"
			}
			- " Security"
			a href="#security-forms" class="self-link"
		}
		- "\n\n  "
		p id="security-0" {
			- "Servers should not rely on client-side validation. Client-side validation can\n  be intentionally bypassed by hostile users, and unintentionally bypassed by users of older user\n  agents or automated tools that do not implement these features. The constraint validation features\n  are only intended to improve the user experience, not to provide any kind of security\n  mechanism."
		}
		- "\n\n\n\n\n  "
		h4 id="form-submission-2" {
			span class="secno" {
				- "4.10.21"
			}
			- " "
			dfn id="form-submission" {
				- "Form submission"
			}
			a href="#form-submission-2" class="self-link"
		}
		- "\n\n  \n\n  "
		h5 id="introduction-5" {
			span class="secno" {
				- "4.10.21.1"
			}
			- " Introduction"
			a href="#introduction-5" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "When a form is submitted, the data in the form is converted into the structure specified by the\n  "
			a href="#concept-fs-enctype" id="introduction-5:concept-fs-enctype" {
				- "enctype"
			}
			- ", and then sent to the destination specified by the\n  "
			a href="#concept-fs-action" id="introduction-5:concept-fs-action" {
				- "action"
			}
			- " using the given "
			a href="#concept-fs-method" id="introduction-5:concept-fs-method" {
				- "method"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "For example, take the following form:"
		}
		- "\n\n  "
		pre {
			code class="html" {
				c- p="" {
					- "<"
				}
				c- f="" {
					- "form"
				}
				- " "
				c- e="" {
					- "action"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"/find.cgi\""
				}
				- " "
				c- e="" {
					- "method"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "get"
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "text"
				}
				- " "
