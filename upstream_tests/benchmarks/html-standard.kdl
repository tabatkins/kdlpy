					}
					- ". Enable "
					a href="#foster-parent" id="parsing-main-intable:foster-parent" {
						- "foster parenting"
					}
					- ", process\n    the token "
					a href="#using-the-rules-for" id="parsing-main-intable:using-the-rules-for-3" {
						- "using the rules for"
					}
					- " the \""
					a href="#parsing-main-inbody" id="parsing-main-intable:parsing-main-inbody-2" {
						- "in\n    body"
