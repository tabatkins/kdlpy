				}
				- " "
				c- p="" {
					- "..."
				}
				- " "
				c- p="" {
					- "};"
				}
			}
		}
		- "\n\n  "
		p {
			- "You can also use the "
			code id="communicating-with-a-dedicated-worker:dom-eventtarget-addeventlistener" {
				a data-x-internal="dom-eventtarget-addeventlistener" href="https://dom.spec.whatwg.org/#dom-eventtarget-addeventlistener" {
					- "addEventListener()"
				}
			}
			- "\n  method."
		}
		- "\n\n  "
		p class="note" {
			- "The implicit "
			code id="communicating-with-a-dedicated-worker:messageport-2" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " used by dedicated workers has its "
			a href="#port-message-queue" id="communicating-with-a-dedicated-worker:port-message-queue" {
				- "port\n  message queue"
			}
			- " implicitly enabled when it is created, so there is no equivalent to the\n  "
			code id="communicating-with-a-dedicated-worker:messageport-3" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " interface's "
			code id="communicating-with-a-dedicated-worker:dom-messageport-start" {
				a href="#dom-messageport-start" {
					- "start()"
				}
			}
			- " method on\n  the "
			code id="communicating-with-a-dedicated-worker:worker-2" {
				a href="#worker" {
					- "Worker"
				}
			}
			- " interface."
		}
		- "\n\n  "
		p {
			- "To "
			em {
				- "send"
			}
			- " data to a worker, use the "
			code id="communicating-with-a-dedicated-worker:dom-worker-postmessage" {
				a href="#dom-worker-postmessage" {
					- "postMessage()"
				}
			}
			- " method. Structured data can be sent over this\n  communication channel. To send "
			code id="communicating-with-a-dedicated-worker:idl-arraybuffer" {
