					}
					- " interface for the line styles, and "
					a id="drawing-text-to-the-bitmap:this-4" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-canvasfillstrokestyles-fill-style" id="drawing-text-to-the-bitmap:concept-canvasfillstrokestyles-fill-style-2" {
						- "fill style"
					}
					- " must be ignored."
				}
				- "\n\n    "
				p {
					- "These shapes are painted without affecting the current path, and are subject to "
					a href="#shadows" id="drawing-text-to-the-bitmap:shadows" {
						- "shadow effects"
					}
					- ", "
					a href="#concept-canvas-global-alpha" id="drawing-text-to-the-bitmap:concept-canvas-global-alpha" {
						- "global\n    alpha"
					}
					- ", the "
					a href="#clipping-region" id="drawing-text-to-the-bitmap:clipping-region" {
						- "clipping region"
					}
					- ", and the "
					a href="#current-compositing-and-blending-operator" id="drawing-text-to-the-bitmap:current-compositing-and-blending-operator" {
						- "current compositing and blending\n    operator"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "\n  "
			a id="drawing-text-to-the-bitmap:tracking-vector" title="There is a tracking vector here." href="https://infra.spec.whatwg.org/#tracking-vector" class="tracking-vector" data-x-internal="tracking-vector" {
				img width="46" alt="(This is a tracking vector.)" crossorigin="" src="https://resources.whatwg.org/tracking-vector.svg" height="64"
			}
			- "\n  The "
			dfn data-dfn-for="CanvasText" id="dom-context-2d-measuretext" data-dfn-type="method" {
				code {
					- "measureText("
					var {
						- "text"
					}
					- ")"
				}
			}
			- " method steps are to\n  run the "
			a href="#text-preparation-algorithm" id="drawing-text-to-the-bitmap:text-preparation-algorithm-2" {
				- "text preparation algorithm"
			}
			- ", passing it "
			var {
				- "text"
			}
			- " and the object\n  implementing the "
			code id="drawing-text-to-the-bitmap:canvastext-4" {
				a href="#canvastext" {
					- "CanvasText"
				}
			}
			- " interface, and then using the returned "
			a id="drawing-text-to-the-bitmap:inline-box" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
				- "inline\n  box"
			}
			- " must return a new "
			code id="drawing-text-to-the-bitmap:textmetrics-2" {
				a href="#textmetrics" {
					- "TextMetrics"
				}
			}
			- " object with members behaving as described in\n  the following list: "
			a href="#refsCSS" {
				- "[CSS]"
			}
		}
		- "\n\n  \n\n  "
		dl {
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-width" data-dfn-type="attribute" {
					code {
						- "width"
					}
				}
				- "\n   attribute"
			}
			dd {
				p {
					- "The width of that "
					a id="drawing-text-to-the-bitmap:inline-box-2" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
						- "inline box"
					}
					- ", in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-4" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- ". (The\n   text's advance width.)"
				}
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-actualboundingboxleft" data-dfn-type="attribute" {
					code {
						- "actualBoundingBoxLeft"
					}
				}
				- " attribute"
			}
			dd {
				- "\n    "
				p {
					- "The distance parallel to the baseline from the alignment point given by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textalign-2" {
						a href="#dom-context-2d-textalign" {
							- "textAlign"
						}
					}
					- " attribute to the left side of the bounding\n    rectangle of the given text, in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-5" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "; positive numbers\n    indicating a distance going left from the given alignment point.\n\n    "
				}
				p class="note" {
					- "The sum of this value and the next ("
					code id="drawing-text-to-the-bitmap:dom-textmetrics-actualboundingboxright" {
						a href="#dom-textmetrics-actualboundingboxright" {
							- "actualBoundingBoxRight"
						}
					}
					- ") can be wider than\n    the width of the "
					a id="drawing-text-to-the-bitmap:inline-box-3" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
						- "inline box"
					}
					- " ("
					code id="drawing-text-to-the-bitmap:dom-textmetrics-width" {
						a href="#dom-textmetrics-width" {
							- "width"
						}
					}
					- "), in\n    particular with slanted fonts where characters overhang their advance width."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-actualboundingboxright" data-dfn-type="attribute" {
					code {
						- "actualBoundingBoxRight"
					}
				}
				- " attribute"
			}
			dd {
				- "\n    "
				p {
					- "The distance parallel to the baseline from the alignment point given by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textalign-3" {
						a href="#dom-context-2d-textalign" {
							- "textAlign"
						}
					}
					- " attribute to the right side of the bounding\n    rectangle of the given text, in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-6" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "; positive numbers\n    indicating a distance going right from the given alignment point."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-fontboundingboxascent" data-dfn-type="attribute" {
					code {
						- "fontBoundingBoxAscent"
					}
				}
				- " attribute"
			}
			dd {
				- "\n    "
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-2" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the "
					a id="drawing-text-to-the-bitmap:ascent-metric" href="https://drafts.csswg.org/css-inline/#ascent-metric" data-x-internal="ascent-metric" {
						- "ascent\n    metric"
					}
					- " of the "
					a id="drawing-text-to-the-bitmap:first-available-font" href="https://drafts.csswg.org/css-fonts/#first-available-font" data-x-internal="first-available-font" {
						- "first available font"
					}
					- ", in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-7" data-x-internal="'px'" {
						- "CSS\n    pixels"
					}
					- "; positive numbers indicating a distance going up from the given baseline."
				}
				- "\n\n    "
				p class="note" {
					- "This value and the next are useful when rendering a background that have to have\n    a consistent height even if the exact text being rendered changes. The "
					code id="drawing-text-to-the-bitmap:dom-textmetrics-actualboundingboxascent" {
						a href="#dom-textmetrics-actualboundingboxascent" {
							- "actualBoundingBoxAscent"
						}
					}
					- " attribute (and\n    its corresponding attribute for the descent) are useful when drawing a bounding box around\n    specific text."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-fontboundingboxdescent" data-dfn-type="attribute" {
					code {
						- "fontBoundingBoxDescent"
					}
				}
				- " attribute"
			}
			dd {
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-3" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the "
					a id="drawing-text-to-the-bitmap:descent-metric" href="https://drafts.csswg.org/css-inline/#descent-metric" data-x-internal="descent-metric" {
						- "descent\n   metric"
					}
					- " of the "
					a id="drawing-text-to-the-bitmap:first-available-font-2" href="https://drafts.csswg.org/css-fonts/#first-available-font" data-x-internal="first-available-font" {
						- "first available font"
					}
					- ", in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-8" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- ";\n   positive numbers indicating a distance going down from the given baseline."
				}
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-actualboundingboxascent" data-dfn-type="attribute" {
					code {
						- "actualBoundingBoxAscent"
					}
				}
				- " attribute"
			}
			dd {
				- "\n    "
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-4" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the top of the bounding\n    rectangle of the given text, in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-9" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "; positive numbers\n    indicating a distance going up from the given baseline.\n\n    "
				}
				p class="note" {
					- "This number can vary greatly based on the input text, even if the first font\n    specified covers all the characters in the input. For example, the "
					code id="drawing-text-to-the-bitmap:dom-textmetrics-actualboundingboxascent-2" {
						a href="#dom-textmetrics-actualboundingboxascent" {
							- "actualBoundingBoxAscent"
						}
					}
					- " of a lowercase\n    \"o\" from an "
					a id="drawing-text-to-the-bitmap:alphabetic-baseline" href="https://drafts.csswg.org/css-inline/#alphabetic-baseline" data-x-internal="alphabetic-baseline" {
						- "alphabetic baseline"
					}
					- " would be less than that of an uppercase \"F\". The\n    value can easily be negative; for example, the distance from the top of the em box ("
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-5" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " value \""
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-top" {
						a href="#dom-context-2d-textbaseline-top" {
							- "top"
						}
					}
					- "\") to the top of the bounding rectangle when\n    the given text is just a single comma \""
					code {
						- ","
					}
					- "\" would likely (unless the font is\n    quite unusual) be negative."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-actualboundingboxdescent" data-dfn-type="attribute" {
					code {
						- "actualBoundingBoxDescent"
					}
				}
				- " attribute"
			}
			dd {
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-6" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the bottom of the bounding\n   rectangle of the given text, in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-10" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "; positive numbers\n   indicating a distance going down from the given baseline."
				}
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-emheightascent" data-dfn-type="attribute" {
					code {
						- "emHeightAscent"
					}
				}
				- " attribute"
			}
			dd {
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-7" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the "
					a id="drawing-text-to-the-bitmap:em-over-baseline" href="https://drafts.csswg.org/css-inline/#em-over-baseline" data-x-internal="em-over-baseline" {
						- "em-over\n   baseline"
					}
					- " in the "
					a id="drawing-text-to-the-bitmap:inline-box-4" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
						- "inline box"
					}
					- ", in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-11" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- ";\n   positive numbers indicating that the given baseline is below the "
					a id="drawing-text-to-the-bitmap:em-over-baseline-2" href="https://drafts.csswg.org/css-inline/#em-over-baseline" data-x-internal="em-over-baseline" {
						- "em-over baseline"
					}
					- "\n   (so this value will usually be positive). Zero if the given baseline is the "
					a id="drawing-text-to-the-bitmap:em-over-baseline-3" href="https://drafts.csswg.org/css-inline/#em-over-baseline" data-x-internal="em-over-baseline" {
						- "em-over\n   baseline"
					}
					- "; half the font size if the given baseline is halfway between the "
					a id="drawing-text-to-the-bitmap:em-over-baseline-4" href="https://drafts.csswg.org/css-inline/#em-over-baseline" data-x-internal="em-over-baseline" {
						- "em-over\n   baseline"
					}
					- " and the "
					a id="drawing-text-to-the-bitmap:em-under-baseline" href="https://drafts.csswg.org/css-inline/#em-under-baseline" data-x-internal="em-under-baseline" {
						- "em-under baseline"
					}
					- "."
				}
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-emheightdescent" data-dfn-type="attribute" {
					code {
						- "emHeightDescent"
					}
				}
				- " attribute"
			}
			dd {
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-8" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the "
					a id="drawing-text-to-the-bitmap:em-under-baseline-2" href="https://drafts.csswg.org/css-inline/#em-under-baseline" data-x-internal="em-under-baseline" {
						- "em-under\n   baseline"
					}
					- " in the "
					a id="drawing-text-to-the-bitmap:inline-box-5" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
						- "inline box"
					}
					- ", in "
					a href="https://drafts.csswg.org/css-values/#px" id="drawing-text-to-the-bitmap:'px'-12" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- ";\n   positive numbers indicating that the given baseline is above the "
					a id="drawing-text-to-the-bitmap:em-under-baseline-3" href="https://drafts.csswg.org/css-inline/#em-under-baseline" data-x-internal="em-under-baseline" {
						- "em-under baseline"
					}
					- ".\n   (Zero if the given baseline is the "
					a id="drawing-text-to-the-bitmap:em-under-baseline-4" href="https://drafts.csswg.org/css-inline/#em-under-baseline" data-x-internal="em-under-baseline" {
						- "em-under baseline"
					}
					- ".)"
				}
			}
			dt {
				dfn data-dfn-for="TextMetrics" id="dom-textmetrics-hangingbaseline" data-dfn-type="attribute" {
