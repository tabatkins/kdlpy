		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-dir" data-dfn-type="element-attr" {
				code {
					- "dir"
				}
			}
			- " attribute\n  is an "
			a href="#enumerated-attribute" id="the-dir-attribute:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/dir" id="attr-dir-ltr" data-dfn-type="attr-value" {
							code {
								- "ltr"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dir-ltr-state" {
							- "ltr"
						}
						- "\n     "
					}
					td {
						- "The contents of the element are explicitly directionally isolated left-to-right text.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/dir" id="attr-dir-rtl" data-dfn-type="attr-value" {
							code {
								- "rtl"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dir-rtl-state" {
							- "rtl"
						}
						- "\n     "
					}
					td {
						- "The contents of the element are explicitly directionally isolated right-to-left text.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/dir" id="attr-dir-auto" data-dfn-type="attr-value" {
							code {
								- "auto"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dir-auto-state" {
							- "auto"
						}
						- "\n     "
					}
					td {
						- "The contents of the element are explicitly directionally isolated text, but the direction\n     is to be determined programmatically using the contents of the element (as described\n     below).\n  "
					}
				}
			}
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "The heuristic used by the "
				a href="#attr-dir-auto-state" id="the-dir-attribute:attr-dir-auto-state" {
					- "auto"
				}
				- " state is very crude\n   (it just looks at the first character with a strong directionality, in a manner analogous to the\n   Paragraph Level determination in the bidirectional algorithm). Authors are urged to only use this\n   value as a last resort when the direction of the text is truly unknown and no better server-side\n   heuristic can be applied. "
				a href="#refsBIDI" {
					- "[BIDI]"
				}
			}
			- "\n\n   "
			p {
				- "For "
				code id="the-dir-attribute:the-textarea-element" {
					a href="#the-textarea-element" {
						- "textarea"
					}
				}
				- " and "
				code id="the-dir-attribute:the-pre-element" {
					a href="#the-pre-element" {
						- "pre"
					}
				}
				- " elements, the heuristic is applied on a\n   per-paragraph level."
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="the-dir-attribute:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="the-dir-attribute:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both the "
			dfn id="attr-dir-undefined-state" {
				- "undefined"
			}
			- " state."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn id="the-directionality" {
				- "directionality"
			}
			- " of an element (any element, not just\n  an "
			a href="#html-elements" id="the-dir-attribute:html-elements" {
				- "HTML element"
			}
			- ") is either '"
			dfn id="concept-ltr" {
				- "ltr"
			}
			- "' or '"
			dfn id="concept-rtl" {
				- "rtl"
			}
			- "'. To compute the "
			a href="#the-directionality" id="the-dir-attribute:the-directionality" {
				- "directionality"
			}
			- " given an element "
			var {
				- "element"
			}
			- ", switch on\n  "
			var {
				- "element"
			}
			- "'s "
			code id="the-dir-attribute:attr-dir-2" {
				a href="#attr-dir" {
					- "dir"
				}
			}
			- " attribute state:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				a href="#attr-dir-ltr-state" id="the-dir-attribute:attr-dir-ltr-state" {
					- "ltr"
				}
			}
			dd {
				p {
					- "Return '"
					a href="#concept-ltr" id="the-dir-attribute:concept-ltr" {
						- "ltr"
					}
					- "'."
				}
			}
			dt {
				a href="#attr-dir-rtl-state" id="the-dir-attribute:attr-dir-rtl-state" {
					- "rtl"
				}
			}
			dd {
				p {
					- "Return '"
					a href="#concept-rtl" id="the-dir-attribute:concept-rtl" {
						- "rtl"
					}
					- "'."
				}
			}
			dt {
				a href="#attr-dir-auto-state" id="the-dir-attribute:attr-dir-auto-state-2" {
					- "auto"
				}
			}
			dd {
				- "\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "result"
							}
							- " be the "
							a href="#auto-directionality" id="the-dir-attribute:auto-directionality" {
								- "auto directionality"
							}
							- " of\n     "
							var {
								- "element"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "result"
							}
							- " is null, then return '"
							a href="#concept-ltr" id="the-dir-attribute:concept-ltr-2" {
								- "ltr"
							}
							- "'."
						}
					}
					li {
						p {
							- "Return "
							var {
								- "result"
							}
							- "."
						}
					}
				}
				- "\n   "
