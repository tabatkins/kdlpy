		- "\n\n  "
		h5 id="integration-with-javascript-jobs" {
			span class="secno" {
				- "8.1.6.6"
			}
			- " Job-related host hooks"
			a href="#integration-with-javascript-jobs" class="self-link"
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in one engine only." class="less-than-two-engines-flag" {
					- "⚠"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise#Incumbent_settings_object_tracking" title="The Promise object represents the eventual completion (or failure) of an asynchronous operation and its resulting value." {
						- "Reference/Global_Objects/Promise#Incumbent_settings_object_tracking"
					}
				}
				p class="less-than-two-engines-text" {
					- "Support in one engine only."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "50+"
						}
					}
					span class="safari no" {
						span {
							- "Safari"
						}
						span {
							- "No"
						}
					}
					span class="chrome no" {
						span {
							- "Chrome"
						}
						span {
							- "No"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink no" {
						span {
							- "Edge"
						}
						span {
							- "No"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The JavaScript specification defines Jobs to be scheduled and run later by the host, as well as\n  "
			a href="https://tc39.es/ecma262/#sec-jobcallback-records" id="integration-with-javascript-jobs:jobcallback-record" data-x-internal="jobcallback-record" {
				- "JobCallback Records"
			}
			- " which encapsulate JavaScript\n  functions that are called as part of jobs. The JavaScript specification contains a number of\n  "
			a id="integration-with-javascript-jobs:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " abstract operations that lets the host define how jobs are\n  scheduled and how JobCallbacks are handled. HTML uses these abstract operations to "
			span id="incumbent-settings-object-tracking-in-promises" {
				- "track the "
				a href="#incumbent-settings-object" id="integration-with-javascript-jobs:incumbent-settings-object" {
					- "incumbent settings\n  object"
				}
				- " in promises and "
				code id="integration-with-javascript-jobs:finalizationregistry" {
					a data-x-internal="finalizationregistry" href="https://tc39.es/ecma262/#sec-finalization-registry-objects" {
						- "FinalizationRegistry"
					}
				}
				- " callbacks"
			}
			- " by saving and\n  restoring the "
			a href="#incumbent-settings-object" id="integration-with-javascript-jobs:incumbent-settings-object-2" {
				- "incumbent settings object"
			}
			- " and a "
			a id="integration-with-javascript-jobs:javascript-execution-context" href="https://tc39.es/ecma262/#sec-execution-contexts" data-x-internal="javascript-execution-context" {
				- "JavaScript execution\n  context"
			}
			- " for the "
			a href="#active-script" id="integration-with-javascript-jobs:active-script" {
				- "active script"
			}
			- " in JobCallbacks. This section defines them for\n  user agent hosts."
		}
		- "\n\n  "
		h6 id="hostcalljobcallback" {
			span class="secno" {
				- "8.1.6.6.1"
			}
			- " "
			dfn {
				- "HostCallJobCallback"
			}
			- "("
			var {
				- "callback"
			}
			- ", "
			var {
				- "V"
			}
			- ",\n  "
			var {
				- "argumentsList"
			}
			- ")"
			a href="#hostcalljobcallback" class="self-link"
		}
		- "\n\n  "
		p {
			- "JavaScript contains an "
			a id="hostcalljobcallback:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " "
			a href="https://tc39.es/ecma262/#sec-hostcalljobcallback" id="hostcalljobcallback:js-hostcalljobcallback" data-x-internal="js-hostcalljobcallback" {
				- "HostCallJobCallback"
			}
			- "("
			var {
				- "callback"
			}
			- ", "
			var {
				- "V"
			}
			- ",\n  "
			var {
				- "argumentsList"
			}
			- ") abstract operation to let hosts restore state when invoking JavaScript\n  callbacks from inside tasks. User agents must use the following implementation:\n  "
			a href="#refsJAVASCRIPT" {
				- "[JAVASCRIPT]"
			}
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "incumbent settings"
					}
					- " be\n   "
					var {
						- "callback"
					}
					- ".[[HostDefined]].[[IncumbentSettings]]."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "script execution context"
					}
					- " be\n   "
					var {
						- "callback"
					}
					- ".[[HostDefined]].[[ActiveScriptContext]]."
				}
			}
			li {
				- "\n    "
				p {
					a href="#prepare-to-run-a-callback" id="hostcalljobcallback:prepare-to-run-a-callback" {
						- "Prepare to run a callback"
					}
					- " with "
					var {
						- "incumbent settings"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This affects the "
					a href="#concept-incumbent-everything" id="hostcalljobcallback:concept-incumbent-everything" {
						- "incumbent"
					}
					- "\n    concept while the callback runs."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "script execution context"
					}
					- " is not null, then "
					a href="https://infra.spec.whatwg.org/#stack-push" id="hostcalljobcallback:stack-push" data-x-internal="stack-push" {
						- "push"
					}
					- " "
					var {
						- "script execution context"
					}
					- " onto the "
					a id="hostcalljobcallback:javascript-execution-context-stack" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution\n    context stack"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This affects the "
					a href="#active-script" id="hostcalljobcallback:active-script" {
						- "active script"
					}
					- " while the callback runs."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be "
					a id="hostcalljobcallback:call" href="https://tc39.es/ecma262/#sec-call" data-x-internal="call" {
						- "Call"
					}
					- "("
					var {
						- "callback"
					}
					- ".[[Callback]], "
					var {
						- "V"
					}
					- ",\n   "
					var {
						- "argumentsList"
					}
					- ")."
				}
			}
			li {
				p {
					- "If "
					var {
						- "script execution context"
					}
					- " is not null, then "
					a href="https://infra.spec.whatwg.org/#stack-pop" id="hostcalljobcallback:stack-pop" data-x-internal="stack-pop" {
						- "pop"
					}
					- " "
					var {
						- "script execution context"
					}
					- " from the "
					a id="hostcalljobcallback:javascript-execution-context-stack-2" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution context\n   stack"
					}
					- "."
				}
			}
			li {
				p {
					a href="#clean-up-after-running-a-callback" id="hostcalljobcallback:clean-up-after-running-a-callback" {
						- "Clean up after running a callback"
					}
					- " with "
					var {
						- "incumbent\n   settings"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "result"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		h6 id="hostenqueuefinalizationregistrycleanupjob" {
			span class="secno" {
				- "8.1.6.6.2"
			}
			- " "
			dfn {
				- "HostEnqueueFinalizationRegistryCleanupJob"
			}
			- "("
			var {
				- "finalizationRegistry"
			}
			- ")"
			a href="#hostenqueuefinalizationregistrycleanupjob" class="self-link"
		}
		- "\n\n  "
		p {
			- "JavaScript has the ability to register objects with "
			code id="hostenqueuefinalizationregistrycleanupjob:finalizationregistry" {
				a data-x-internal="finalizationregistry" href="https://tc39.es/ecma262/#sec-finalization-registry-objects" {
					- "FinalizationRegistry"
				}
			}
			- " objects,\n  in order to schedule a cleanup action if they are found to be garbage collected. The JavaScript\n  specification contains an "
			a id="hostenqueuefinalizationregistrycleanupjob:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " "
			a href="https://tc39.es/ecma262/#sec-host-cleanup-finalization-registry" id="hostenqueuefinalizationregistrycleanupjob:js-hostenqueuefinalizationregistrycleanupjob" data-x-internal="js-hostenqueuefinalizationregistrycleanupjob" {
				- "HostEnqueueFinalizationRegistryCleanupJob"
			}
			- "("
			var {
				- "finalizationRegistry"
			}
			- ")\n  abstract operation to schedule the cleanup action."
		}
		- "\n\n  "
		p class="note" {
			- "The timing and occurrence of cleanup work is "
			a id="hostenqueuefinalizationregistrycleanupjob:implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- "\n  in the JavaScript specification. User agents might differ in when and whether an object is garbage\n  collected, affecting both whether the return value of the "
			code id="hostenqueuefinalizationregistrycleanupjob:weakref.prototype.deref()" {
				a data-x-internal="weakref.prototype.deref()" href="https://tc39.es/ecma262/#sec-weak-ref.prototype.deref" {
					- "WeakRef.prototype.deref()"
				}
			}
			- "\n  method is undefined, and whether "
			code id="hostenqueuefinalizationregistrycleanupjob:finalizationregistry-2" {
				a data-x-internal="finalizationregistry" href="https://tc39.es/ecma262/#sec-finalization-registry-objects" {
					- "FinalizationRegistry"
				}
			}
			- " cleanup callbacks occur. There\n  are well-known cases in popular web browsers where objects are not accessible to JavaScript, but\n  they remain retained by the garbage collector indefinitely. HTML clears kept-alive\n  "
			code id="hostenqueuefinalizationregistrycleanupjob:weakref" {
				a data-x-internal="weakref" href="https://tc39.es/ecma262/#sec-weak-ref-objects" {
					- "WeakRef"
				}
			}
			- " objects in the "
			a href="#perform-a-microtask-checkpoint" id="hostenqueuefinalizationregistrycleanupjob:perform-a-microtask-checkpoint" {
				- "perform a microtask checkpoint"
			}
			- " algorithm. Authors\n  would be best off not depending on the timing details of garbage collection implementations."
		}
		- "\n\n  "
		p {
			- "Cleanup actions do not take place interspersed with synchronous JavaScript execution, but\n  rather happen in queued "
			a href="#concept-task" id="hostenqueuefinalizationregistrycleanupjob:concept-task" {
				- "tasks"
			}
			- ". User agents must use the\n  following implementation: "
			a href="#refsJAVASCRIPT" {
				- "[JAVASCRIPT]"
			}
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "global"
					}
					- " be "
					var {
						- "finalizationRegistry"
					}
					- ".[[Realm]]'s "
					a href="#global-object" id="hostenqueuefinalizationregistrycleanupjob:global-object" {
						- "global\n   object"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="#queue-a-global-task" id="hostenqueuefinalizationregistrycleanupjob:queue-a-global-task" {
						- "Queue a global task"
					}
					- " on the "
					dfn id="javascript-engine-task-source" {
						- "JavaScript engine task source"
					}
					- " given\n    "
					var {
						- "global"
					}
					- " to perform the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "entry"
							}
							- " be\n     "
							var {
								- "finalizationRegistry"
							}
							- ".[[CleanupCallback]].[[Callback]].[[Realm]]'s "
							a href="#concept-realm-settings-object" id="hostenqueuefinalizationregistrycleanupjob:concept-realm-settings-object" {
								- "environment settings object"
							}
							- "."
						}
					}
					li {
						p {
							a href="#check-if-we-can-run-script" id="hostenqueuefinalizationregistrycleanupjob:check-if-we-can-run-script" {
								- "Check if we can run script"
							}
							- " with "
							var {
								- "entry"
							}
							- ". If this returns \"do not\n     run\", then return."
						}
					}
					li {
						- "\n      "
						p {
							a href="#prepare-to-run-script" id="hostenqueuefinalizationregistrycleanupjob:prepare-to-run-script" {
								- "Prepare to run script"
							}
							- " with "
							var {
								- "entry"
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "This affects the "
							a href="#concept-entry-everything" id="hostenqueuefinalizationregistrycleanupjob:concept-entry-everything" {
								- "entry"
							}
							- " concept\n      while the cleanup callback runs."
						}
						- "\n     "
					}
					li {
						p {
							- "Let "
							var {
								- "result"
							}
							- " be the result of performing\n     "
							a id="hostenqueuefinalizationregistrycleanupjob:cleanupfinalizationregistry" href="https://tc39.es/ecma262/#sec-cleanup-finalization-registry" data-x-internal="cleanupfinalizationregistry" {
								- "CleanupFinalizationRegistry"
							}
							- "("
							var {
								- "finalizationRegistry"
							}
							- ")."
						}
					}
					li {
						p {
							a href="#clean-up-after-running-script" id="hostenqueuefinalizationregistrycleanupjob:clean-up-after-running-script" {
								- "Clean up after running script"
							}
							- " with "
							var {
								- "entry"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "result"
							}
							- " is an "
							a href="https://tc39.es/ecma262/#sec-completion-record-specification-type" id="hostenqueuefinalizationregistrycleanupjob:completion-record" data-x-internal="completion-record" {
								- "abrupt completion"
							}
							- ",\n     then "
							a href="#report-an-exception" id="hostenqueuefinalizationregistrycleanupjob:report-an-exception" {
								- "report an exception"
							}
							- " given by "
							var {
								- "result"
							}
							- ".[[Value]] for\n     "
							var {
								- "global"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		h6 id="hostenqueuegenericjob" {
			span class="secno" {
				- "8.1.6.6.3"
			}
			- " "
