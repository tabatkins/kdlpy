					}
					- "'s "
					code id="2dcontext:attr-canvas-width-3" {
						a href="#attr-canvas-width" {
							- "width"
						}
					}
					- " content attribute to the shortest possible string\n   representing "
					var {
						- "width"
					}
					- " as a "
					a href="#valid-non-negative-integer" id="2dcontext:valid-non-negative-integer" {
						- "valid non-negative integer"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					a href="#obtain-numeric-values" id="2dcontext:obtain-numeric-values-3" {
						- "the numeric value"
					}
					- " of\n   "
					var {
						- "canvas"
					}
					- "'s "
					code id="2dcontext:attr-canvas-height-2" {
						a href="#attr-canvas-height" {
							- "height"
						}
					}
					- " content\n   attribute differs from "
					var {
						- "height"
					}
					- ", then set "
					var {
						- "canvas"
					}
					- "'s "
					code id="2dcontext:attr-canvas-height-3" {
						a href="#attr-canvas-height" {
							- "height"
						}
					}
					- " content attribute to the shortest possible string\n   representing "
					var {
						- "height"
					}
					- " as a "
					a href="#valid-non-negative-integer" id="2dcontext:valid-non-negative-integer-2" {
						- "valid non-negative integer"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Only one square appears to be drawn in the following example:"
			}
			- "\n   "
			pre {
				code class="js" {
					c- c1="" {
						- "// canvas is a reference to a <canvas> element"
					}
					- "\n"
					c- a="" {
						- "var"
					}
					- " context "
					c- o="" {
						- "="
					}
					- " canvas"
					c- p="" {
						- "."
					}
					- "getContext"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'2d'"
					}
					c- p="" {
						- ");"
					}
					- "\ncontext"
					c- p="" {
						- "."
					}
					- "fillRect"
					c- p="" {
						- "("
					}
					c- mf="" {
