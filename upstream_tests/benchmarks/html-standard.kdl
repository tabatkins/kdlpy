			}
			- " element "
			a href="#represents" id="the-output-element:represents" {
				- "represents"
			}
			- " the result of a calculation performed\n  by the application, or the result of a user action."
		}
		- "\n\n  "
		p class="note" {
			- "This element can be contrasted with the "
			code id="the-output-element:the-samp-element" {
				a href="#the-samp-element" {
					- "samp"
				}
			}
			- " element, which is the\n  appropriate element for quoting the output of other programs run previously."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
