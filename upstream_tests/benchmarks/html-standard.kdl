					- "Document"
				}
			}
			- " is in "
			a id="images-3:quirks-mode-2" href="https://dom.spec.whatwg.org/#concept-document-quirks" data-x-internal="quirks-mode" {
				- "quirks\n  mode"
			}
			- ":"
		}
