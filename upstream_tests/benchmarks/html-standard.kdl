		- "\n\n  \n\n  "
		p {
			- "The "
			code id="attributes-common-to-td-and-th-elements:attr-tdth-colspan" {
				a href="#attr-tdth-colspan" {
					- "colspan"
				}
			}
			- ", "
			code id="attributes-common-to-td-and-th-elements:attr-tdth-rowspan" {
