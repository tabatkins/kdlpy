						code {
							- "-//IETF//DTD HTML 2.0//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML 2.1E//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML 3.0//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML 3.2 Final//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML 3.2//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML 3//"
						}
						- "\" "
					}
					li {
						- " The public identifier starts with: \""
						code {
							- "-//IETF//DTD HTML Level 0//"
						}
						- "\" "
					}
					li {
