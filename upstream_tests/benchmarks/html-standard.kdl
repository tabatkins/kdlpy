		hr
		- "\n\n  "
		p {
			- "When the steps below require the user agent to "
			dfn id="insert-a-comment" {
				- "insert a comment"
			}
			- " while processing a\n  comment token, optionally with an explicitly insertion position "
			var {
				- "position"
			}
			- ", the\n  user agent must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "data"
					}
					- " be the data given in the comment token being\n   processed."
				}
			}
			li {
				p {
					- "If "
					var {
						- "position"
					}
					- " was specified, then let the "
					var {
						- "adjusted\n   insertion location"
					}
					- " be "
					var {
						- "position"
					}
					- ". Otherwise, let "
					var {
						- "adjusted\n   insertion location"
					}
					- " be the "
					a href="#appropriate-place-for-inserting-a-node" id="creating-and-inserting-nodes:appropriate-place-for-inserting-a-node-4" {
						- "appropriate place for inserting a node"
					}
					- "."
				}
			}
			li {
				p {
					- "Create a "
					code id="creating-and-inserting-nodes:comment-2" {
						a data-x-internal="comment-2" href="https://dom.spec.whatwg.org/#interface-comment" {
							- "Comment"
						}
					}
					- " node whose "
					code {
						- "data"
					}
					- " attribute is set to\n   "
					var {
						- "data"
					}
					- " and whose "
					a id="creating-and-inserting-nodes:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- " is\n   the same as that of the node in which the "
					var {
						- "adjusted insertion location"
					}
					- " finds\n   itself."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Insert the newly created node at the "
					var {
						- "adjusted insertion\n   location"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		h5 id="parsing-elements-that-contain-only-text" {
			span class="secno" {
				- "13.2.6.2"
			}
			- " Parsing elements that contain only text"
			a href="#parsing-elements-that-contain-only-text" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="generic-raw-text-element-parsing-algorithm" {
				- "generic raw text element parsing algorithm"
			}
			- " and the "
			dfn id="generic-rcdata-element-parsing-algorithm" {
				- "generic RCDATA element\n  parsing algorithm"
			}
			- " consist of the following steps. These algorithms are always invoked in\n  response to a start tag token."
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="#insert-an-html-element" id="parsing-elements-that-contain-only-text:insert-an-html-element" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
			}
			li {
				p {
					- "If the algorithm that was invoked is the "
					a href="#generic-raw-text-element-parsing-algorithm" id="parsing-elements-that-contain-only-text:generic-raw-text-element-parsing-algorithm" {
						- "generic raw text element parsing\n   algorithm"
					}
					- ", switch the tokenizer to the "
					a href="#rawtext-state" id="parsing-elements-that-contain-only-text:rawtext-state" {
						- "RAWTEXT state"
					}
					- "; otherwise the algorithm\n   invoked was the "
					a href="#generic-rcdata-element-parsing-algorithm" id="parsing-elements-that-contain-only-text:generic-rcdata-element-parsing-algorithm" {
						- "generic RCDATA element parsing algorithm"
					}
					- ", switch the tokenizer to\n   the "
					a href="#rcdata-state" id="parsing-elements-that-contain-only-text:rcdata-state" {
						- "RCDATA state"
					}
					- "."
				}
			}
			li {
				p {
					- "Let the "
					a href="#original-insertion-mode" id="parsing-elements-that-contain-only-text:original-insertion-mode" {
						- "original insertion mode"
					}
					- " be the current "
					a href="#insertion-mode" id="parsing-elements-that-contain-only-text:insertion-mode" {
						- "insertion\n   mode"
					}
					- "."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Then, switch the "
					a href="#insertion-mode" id="parsing-elements-that-contain-only-text:insertion-mode-2" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-incdata" id="parsing-elements-that-contain-only-text:parsing-main-incdata" {
						- "text"
					}
					- "\"."
				}
			}
		}
		- "\n\n\n  "
		h5 id="closing-elements-that-have-implied-end-tags" {
			span class="secno" {
				- "13.2.6.3"
			}
			- " Closing elements that have implied end tags"
			a href="#closing-elements-that-have-implied-end-tags" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="generate-implied-end-tags" {
				- "generate implied end tags"
			}
			- ", then, while the\n  "
			a href="#current-node" id="closing-elements-that-have-implied-end-tags:current-node" {
				- "current node"
			}
			- " is a "
			code id="closing-elements-that-have-implied-end-tags:the-dd-element" {
				a href="#the-dd-element" {
					- "dd"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-dt-element" {
				a href="#the-dt-element" {
					- "dt"
				}
			}
			- " element, an\n  "
			code id="closing-elements-that-have-implied-end-tags:the-li-element" {
				a href="#the-li-element" {
					- "li"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-optgroup-element" {
				a href="#the-optgroup-element" {
					- "optgroup"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-option-element" {
				a href="#the-option-element" {
					- "option"
				}
			}
			- " element, a\n  "
			code id="closing-elements-that-have-implied-end-tags:the-p-element" {
				a href="#the-p-element" {
					- "p"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:rb" {
				a href="#rb" {
					- "rb"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-rp-element" {
				a href="#the-rp-element" {
					- "rp"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-rt-element" {
				a href="#the-rt-element" {
					- "rt"
				}
			}
			- "\n  element, or an "
			code id="closing-elements-that-have-implied-end-tags:rtc" {
				a href="#rtc" {
					- "rtc"
				}
			}
			- " element, the UA must pop the "
			a href="#current-node" id="closing-elements-that-have-implied-end-tags:current-node-2" {
				- "current node"
			}
			- " off the\n  "
			a href="#stack-of-open-elements" id="closing-elements-that-have-implied-end-tags:stack-of-open-elements" {
				- "stack of open elements"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "If a step requires the UA to generate implied end tags but lists an element to exclude from the\n  process, then the UA must perform the above steps as if that element was not in the above\n  list."
		}
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="generate-all-implied-end-tags-thoroughly" {
				- "generate all implied end tags thoroughly"
			}
			- ",\n  then, while the "
			a href="#current-node" id="closing-elements-that-have-implied-end-tags:current-node-3" {
				- "current node"
			}
			- " is a "
			code id="closing-elements-that-have-implied-end-tags:the-caption-element" {
				a href="#the-caption-element" {
					- "caption"
				}
			}
			- " element, a\n  "
			code id="closing-elements-that-have-implied-end-tags:the-colgroup-element" {
				a href="#the-colgroup-element" {
					- "colgroup"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-dd-element-2" {
				a href="#the-dd-element" {
					- "dd"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-dt-element-2" {
				a href="#the-dt-element" {
					- "dt"
				}
			}
			- " element, an\n  "
			code id="closing-elements-that-have-implied-end-tags:the-li-element-2" {
				a href="#the-li-element" {
					- "li"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-optgroup-element-2" {
				a href="#the-optgroup-element" {
					- "optgroup"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-option-element-2" {
				a href="#the-option-element" {
					- "option"
				}
			}
			- " element, a\n  "
			code id="closing-elements-that-have-implied-end-tags:the-p-element-2" {
				a href="#the-p-element" {
					- "p"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:rb-2" {
				a href="#rb" {
					- "rb"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-rp-element-2" {
				a href="#the-rp-element" {
					- "rp"
				}
			}
			- " element, an "
			code id="closing-elements-that-have-implied-end-tags:the-rt-element-2" {
				a href="#the-rt-element" {
					- "rt"
				}
			}
			- "\n  element, an "
			code id="closing-elements-that-have-implied-end-tags:rtc-2" {
				a href="#rtc" {
					- "rtc"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-tbody-element" {
				a href="#the-tbody-element" {
					- "tbody"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-td-element" {
				a href="#the-td-element" {
					- "td"
				}
			}
			- " element, a\n  "
			code id="closing-elements-that-have-implied-end-tags:the-tfoot-element" {
				a href="#the-tfoot-element" {
					- "tfoot"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-th-element" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- " element, a "
			code id="closing-elements-that-have-implied-end-tags:the-thead-element" {
				a href="#the-thead-element" {
					- "thead"
				}
			}
			- " element, or a\n  "
			code id="closing-elements-that-have-implied-end-tags:the-tr-element" {
				a href="#the-tr-element" {
					- "tr"
				}
			}
