				a href="#the-input-element" {
					- "input"
				}
			}
			- " element whose "
			code id="the-input-element-as-a-range-control:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#range-state-(type=range)" id="the-input-element-as-a-range-control:range-state-(type=range)" {
