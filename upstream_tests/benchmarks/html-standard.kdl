		p {
			- "When the steps below require the user agent to "
			dfn id="adjust-foreign-attributes" {
				- "adjust foreign attributes"
			}
			- " for a\n  token, then, if any of the attributes on the token match the strings given in the first column of\n  the following table, let the attribute be a namespaced attribute, with the prefix being the string\n  given in the corresponding cell in the second column, the local name being the string given in the\n  corresponding cell in the third column, and the namespace being the namespace given in the\n  corresponding cell in the fourth column. (This fixes the use of namespaced attributes, in\n  particular "
			a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="creating-and-inserting-nodes:attr-xml-lang" data-x-internal="attr-xml-lang" {
				code {
					- "lang"
				}
				- " attributes in the "
				span {
					- "XML\n  namespace"
				}
			}
			- ".)"
		}
		- "\n\n  "
