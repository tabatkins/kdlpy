						p {
							- "Otherwise, set "
							var {
								- "node"
							}
							- " to the previous entry in the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-28" {
								- "stack of open\n     elements"
							}
							- " and return to the step labeled "
							i {
								- "loop"
							}
							- "."
						}
					}
					li {
						p {
							i {
								- "Done"
							}
							- ": If the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-29" {
								- "stack of open elements"
							}
							- " "
							a href="#has-an-element-in-button-scope" id="parsing-main-inbody:has-an-element-in-button-scope-6" {
								- "has a "
								code {
									- "p"
								}
								- " element in button scope"
							}
							- ", then "
							a href="#close-a-p-element" id="parsing-main-inbody:close-a-p-element-6" {
								- "close a\n     "
								code {
									- "p"
								}
								- " element"
							}
							- "."
						}
					}
					li {
						p {
							- "Finally, "
							a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-7" {
								- "insert an HTML element"
							}
							- " for the token."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"plaintext\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-30" {
						- "stack of open elements"
					}
					- " "
					a href="#has-an-element-in-button-scope" id="parsing-main-inbody:has-an-element-in-button-scope-7" {
						- "has a\n    "
						code {
							- "p"
						}
						- " element in button scope"
