		- "\n\n  "
		ul {
			li {
				p {
					- "If the number is 0x00, then this is a "
					a href="#parse-error-null-character-reference" id="numeric-character-reference-end-state:parse-error-null-character-reference" {
						- "null-character-reference"
					}
					- " "
