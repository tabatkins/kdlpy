		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="date-state-(type=date):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="date-state-(type=date):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#date-state-(type=date)" id="date-state-(type=date):date-state-(type=date)" {
				- "Date"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="date-state-(type=date):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="date-state-(type=date):represents" {
				- "represents"
			}
			- " a control for setting the element's\n  "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value" {
				- "value"
			}
			- " to a string representing a specific "
			a href="#concept-date" id="date-state-(type=date):concept-date" {
				- "date"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "If the element is "
			i id="date-state-(type=date):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the "
			a href="#concept-date" id="date-state-(type=date):concept-date-2" {
				- "date"
			}
			- " represented by its "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-2" {
				- "value"
			}
			- ", as obtained by "
			a href="#parse-a-date-string" id="date-state-(type=date):parse-a-date-string" {
				- "parsing a\n  date"
			}
			- " from it. User agents must not allow the user to set the "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-3" {
				- "value"
			}
			- " to a non-empty string that is not a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string" {
				- "valid date\n  string"
			}
			- ". If the user agent provides a user interface for selecting a "
			a href="#concept-date" id="date-state-(type=date):concept-date-3" {
				- "date"
			}
			- ", then the "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-4" {
				- "value"
			}
			- " must be set\n  to a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-2" {
				- "valid date string"
			}
			- " representing the user's selection. User agents should allow\n  the user to set the "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-5" {
				- "value"
			}
			- " to the empty string."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the user interface describes input that the user\n  agent cannot convert to a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-3" {
				- "valid date string"
			}
			- ", the control is "
			a href="#suffering-from-bad-input" id="date-state-(type=date):suffering-from-bad-input" {
				- "suffering from bad\n  input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "See the "
			a href="#input-author-notes" {
				- "introduction section"
			}
			- " for a discussion of\n  the difference between the input format and submission format for date, time, and number form\n  controls, and the "
			a href="#input-impl-notes" {
				- "implementation notes"
			}
			- "\n  regarding localization of form controls."
		}
		- "\n\n  "
		p {
			- "The "
			code id="date-state-(type=date):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not empty, must\n  have a value that is a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-4" {
				- "valid date string"
			}
			- "."
		}
		- " \n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="date-state-(type=date):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": If the "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-6" {
				- "value"
			}
			- " of the element is not a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-5" {
				- "valid date string"
			}
			- ", then\n  set it to the empty string instead."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="date-state-(type=date):attr-input-min" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute, if specified, must have a value that is\n  a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-6" {
				- "valid date string"
			}
			- ". The "
			code id="date-state-(type=date):attr-input-max" {
				a href="#attr-input-max" {
					- "max"
				}
			}
			- " attribute, if\n  specified, must have a value that is a "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-7" {
				- "valid date string"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="date-state-(type=date):attr-input-step" {
				a href="#attr-input-step" {
					- "step"
				}
			}
			- " attribute is expressed in days. The "
			a href="#concept-input-step-scale" id="date-state-(type=date):concept-input-step-scale" {
				- "step scale factor"
			}
			- " is 86,400,000\n  (which converts the days to milliseconds, as used in the other algorithms). The "
			a href="#concept-input-step-default" id="date-state-(type=date):concept-input-step-default" {
				- "default step"
			}
			- " is 1 day."
		}
		- "\n\n  \n\n  "
		p {
			- "When the element is "
			a href="#suffering-from-a-step-mismatch" id="date-state-(type=date):suffering-from-a-step-mismatch" {
				- "suffering from a step mismatch"
			}
			- ", the user agent may round the\n  element's "
			a href="#concept-fe-value" id="date-state-(type=date):concept-fe-value-7" {
				- "value"
			}
			- " to the nearest "
			a href="#concept-date" id="date-state-(type=date):concept-date-4" {
				- "date"
			}
			- " for which the element would not "
			a href="#suffering-from-a-step-mismatch" id="date-state-(type=date):suffering-from-a-step-mismatch-2" {
				- "suffer from a step mismatch"
			}
			- "."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-string-number" id="date-state-(type=date):concept-input-value-string-number" {
					- "algorithm to convert a string to a\n  number"
				}
				- ", given a string "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": If "
			a href="#parse-a-date-string" id="date-state-(type=date):parse-a-date-string-2" {
				- "parsing a date"
			}
			- " from "
			var {
				- "input"
			}
			- " results in an\n  error, then return an error; otherwise, return the number of milliseconds elapsed from midnight\n  UTC on the morning of 1970-01-01 (the time represented by the value \""
			code {
				- "1970-01-01T00:00:00.0Z"
			}
			- "\") to midnight UTC on the morning of the parsed "
			a href="#concept-date" id="date-state-(type=date):concept-date-5" {
				- "date"
			}
			- ", ignoring leap seconds."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-number-string" id="date-state-(type=date):concept-input-value-number-string" {
					- "algorithm to convert a number to a\n  string"
				}
				- ", given a number "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": Return a\n  "
			a href="#valid-date-string" id="date-state-(type=date):valid-date-string-8" {
				- "valid date string"
			}
			- " that represents the "
			a href="#concept-date" id="date-state-(type=date):concept-date-6" {
				- "date"
			}
			- " that, in\n  UTC, is current "
			var {
				- "input"
			}
			- " milliseconds after midnight UTC on the morning of\n  1970-01-01 (the time represented by the value \""
			code {
				- "1970-01-01T00:00:00.0Z"
			}
			- "\")."
		}
		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-string-date" id="date-state-(type=date):concept-input-value-string-date" {
					- "algorithm to convert a string to a\n  "
					code {
						- "Date"
					}
					- " object"
				}
				- ", given a string "
				var {
					- "input"
				}
