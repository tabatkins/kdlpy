				}
			}
			- " attributes of all the elements "
			a id="the-htmlallcollection-interface:represented-by-the-collection-2" href="https://dom.spec.whatwg.org/#represented-by-the-collection" data-x-internal="represented-by-the-collection" {
				- "represented by the\n  collection"
			}
