					}
				}
			}
			- "\n  "
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasRenderingContext2D" id="dom-context-2d-canvas" data-dfn-type="attribute" {
				code {
					- "canvas"
				}
			}
			- " attribute must return the value it was\n  initialized to when the object was created."
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			code id="2dcontext:predefinedcolorspace-5" {
				a href="#predefinedcolorspace" {
					- "PredefinedColorSpace"
				}
			}
			- " enumeration is used to specify the "
			a href="#concept-canvas-color-space" id="2dcontext:concept-canvas-color-space-6" {
				- "color space"
			}
			- " of the canvas's backing store."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="PredefinedColorSpace" id="dom-predefinedcolorspace-srgb" data-dfn-type="enum-value" {
				code {
					- "srgb"
				}
			}
			- "\" value indicates the "
			a id="2dcontext:'srgb'" href="https://drafts.csswg.org/css-color/#valdef-color-srgb" data-x-internal="'srgb'" {
				- "'srgb'"
			}
			- "\n  color space."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="PredefinedColorSpace" id="dom-predefinedcolorspace-display-p3" data-dfn-type="enum-value" {
				code {
					- "display-p3"
				}
			}
			- "\" value indicates the\n  "
			a id="2dcontext:'display-p3'" href="https://drafts.csswg.org/css-color/#valdef-color-display-p3" data-x-internal="'display-p3'" {
				- "'display-p3'"
			}
			- " color space."
		}
		- "\n\n  "
		p class="note" {
			- "The algorithm for converting between color spaces can be found in the\n  "
			a id="2dcontext:converting-colors" href="https://drafts.csswg.org/css-color/#color-conversion" data-x-internal="converting-colors" {
				- "Converting Colors"
			}
			- " section of "
			cite {
				- "CSS Color"
			}
			- ". "
			a href="#refsCSSCOLOR" {
				- "[CSSCOLOR]"
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			code id="2dcontext:canvasfillrule-7" {
				a href="#canvasfillrule" {
					- "CanvasFillRule"
				}
			}
			- " enumeration is used to select the "
			dfn id="fill-rule" {
				- "fill rule"
			}
			- "\n  algorithm by which to determine if a point is inside or outside a path."
		}
		- "\n\n  "
		p {
			- "The value \""
			dfn data-dfn-for="CanvasFillRule" id="dom-context-2d-fillrule-nonzero" data-dfn-type="enum-value" {
				code {
					- "nonzero"
				}
			}
			- "\" value indicates the nonzero winding\n  rule, wherein\n\n     a point is considered to be outside a shape if the number of times a half-infinite straight\n     line drawn from that point crosses the shape's path going in one direction is equal to the\n     number of times it crosses the path going in the other direction.\n\n  "
		}
		- "\n\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="CanvasFillRule" id="dom-context-2d-fillrule-evenodd" data-dfn-type="enum-value" {
				code {
					- "evenodd"
				}
			}
			- "\" value indicates the even-odd rule,\n  wherein\n\n     a point is considered to be outside a shape if the number of times a half-infinite straight\n     line drawn from that point crosses the shape's path is even.\n\n  "
		}
		- "\n\n  "
		p {
			- "If a point is not outside a shape, it is inside the shape."
		}
		- "\n\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			code id="2dcontext:imagesmoothingquality-2" {
				a href="#imagesmoothingquality" {
					- "ImageSmoothingQuality"
				}
			}
			- " enumeration is used to express a preference for the\n  interpolation quality to use when smoothing images."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ImageSmoothingQuality" id="dom-context-2d-imagesmoothingquality-low" data-dfn-type="enum-value" {
				code {
					- "low"
				}
			}
			- "\" value indicates a preference\n  for a low level of image interpolation quality. Low-quality image interpolation may be more\n  computationally efficient than higher settings."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ImageSmoothingQuality" id="dom-context-2d-imagesmoothingquality-medium" data-dfn-type="enum-value" {
				code {
					- "medium"
				}
			}
			- "\" value indicates a\n  preference for a medium level of image interpolation quality."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ImageSmoothingQuality" id="dom-context-2d-imagesmoothingquality-high" data-dfn-type="enum-value" {
				code {
					- "high"
				}
			}
			- "\" value indicates a preference\n  for a high level of image interpolation quality. High-quality image interpolation may be more\n  computationally expensive than lower settings."
		}
		- "\n\n  "
		p class="note" {
			- "Bilinear scaling is an example of a relatively fast, lower-quality image-smoothing\n  algorithm. Bicubic or Lanczos scaling are examples of image-smoothing algorithms that produce\n  higher-quality output. This specification does not mandate that specific interpolation algorithms\n  be used."
		}
		- "\n\n\n  "
		h6 id="implementation-notes" {
			span class="secno" {
				- "4.12.5.1.1"
			}
			- " Implementation notes"
			a href="#implementation-notes" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "The "
			a href="#output-bitmap" id="implementation-notes:output-bitmap" {
				- "output bitmap"
			}
			- ", when it is not directly displayed by the user agent,\n  implementations can, instead of updating this bitmap, merely remember the sequence of drawing\n  operations that have been applied to it until such time as the bitmap's actual data is needed\n  (for example because of a call to "
			code id="implementation-notes:dom-context-2d-drawimage" {
				a href="#dom-context-2d-drawimage" {
					- "drawImage()"
				}
			}
			- ", or\n  the "
			code id="implementation-notes:dom-createimagebitmap" {
				a href="#dom-createimagebitmap" {
					- "createImageBitmap()"
				}
			}
			- " factory method). In many\n  cases, this will be more memory efficient."
		}
		- "\n\n  "
		p {
			- "The bitmap of a "
			code id="implementation-notes:the-canvas-element" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element is the one bitmap that's pretty much always going\n  to be needed in practice. The "
			a href="#output-bitmap" id="implementation-notes:output-bitmap-2" {
				- "output bitmap"
			}
			- " of a rendering context, when it has one,\n  is always just an alias to a "
			code id="implementation-notes:the-canvas-element-2" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element's bitmap."
		}
		- "\n\n  "
		p {
			- "Additional bitmaps are sometimes needed, e.g. to enable fast drawing when the canvas is being\n  painted at a different size than its "
			a href="https://drafts.csswg.org/css-images/#natural-dimensions" id="implementation-notes:natural-dimensions" data-x-internal="natural-dimensions" {
				- "natural size"
			}
			- ",\n  or to enable double buffering so that graphics updates, like page scrolling for example, can be\n  processed concurrently while canvas draw commands are being executed."
		}
		- "\n\n  "
		h6 id="the-canvas-state" {
			span class="secno" {
				- "4.12.5.1.2"
			}
			- " The canvas state"
			a href="#the-canvas-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Objects that implement the "
			code id="the-canvas-state:canvasstate" {
				a href="#canvasstate" {
					- "CanvasState"
				}
			}
			- " interface maintain a stack of drawing\n  states. "
			dfn id="drawing-state" {
				- "Drawing states"
			}
			- " consist of:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The current "
					a href="#transformations" id="the-canvas-state:transformations" {
						- "transformation\n   matrix"
					}
					- "."
				}
			}
			li {
				p {
					- "The current "
					a href="#clipping-region" id="the-canvas-state:clipping-region" {
						- "clipping region"
					}
					- "."
				}
			}
			li {
				p {
					- "The current "
					a href="#concept-canvastextdrawingstyles-letter-spacing" id="the-canvas-state:concept-canvastextdrawingstyles-letter-spacing" {
						- "letter\n   spacing"
					}
					- ", "
					a href="#concept-canvastextdrawingstyles-word-spacing" id="the-canvas-state:concept-canvastextdrawingstyles-word-spacing" {
						- "word spacing"
					}
					- ",\n   "
					a href="#concept-canvasfillstrokestyles-fill-style" id="the-canvas-state:concept-canvasfillstrokestyles-fill-style" {
						- "fill style"
					}
					- ", "
					a href="#concept-canvasfillstrokestyles-stroke-style" id="the-canvas-state:concept-canvasfillstrokestyles-stroke-style" {
						- "stroke style"
					}
					- ", "
					a href="#concept-canvas-current-filter" id="the-canvas-state:concept-canvas-current-filter" {
						- "filter"
					}
					- ", "
					a href="#concept-canvas-global-alpha" id="the-canvas-state:concept-canvas-global-alpha" {
						- "global alpha"
					}
					- ", "
					a href="#current-compositing-and-blending-operator" id="the-canvas-state:current-compositing-and-blending-operator" {
						- "compositing and blending operator"
					}
					- ", and "
					a href="#concept-canvasshadowstyles-shadow-color" id="the-canvas-state:concept-canvasshadowstyles-shadow-color" {
						- "shadow color"
					}
					- "."
				}
			}
			li {
				p {
					- "The current values of the following attributes: "
					code id="the-canvas-state:dom-context-2d-linewidth" {
						a href="#dom-context-2d-linewidth" {
							- "lineWidth"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-linecap" {
						a href="#dom-context-2d-linecap" {
							- "lineCap"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-linejoin" {
						a href="#dom-context-2d-linejoin" {
							- "lineJoin"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-miterlimit" {
						a href="#dom-context-2d-miterlimit" {
							- "miterLimit"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-linedashoffset" {
						a href="#dom-context-2d-linedashoffset" {
							- "lineDashOffset"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-shadowoffsetx" {
						a href="#dom-context-2d-shadowoffsetx" {
							- "shadowOffsetX"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-shadowoffsety" {
						a href="#dom-context-2d-shadowoffsety" {
							- "shadowOffsetY"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-shadowblur" {
						a href="#dom-context-2d-shadowblur" {
							- "shadowBlur"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-font" {
						a href="#dom-context-2d-font" {
							- "font"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-textalign" {
						a href="#dom-context-2d-textalign" {
							- "textAlign"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-textbaseline" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-direction" {
						a href="#dom-context-2d-direction" {
							- "direction"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-fontkerning" {
						a href="#dom-context-2d-fontkerning" {
							- "fontKerning"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-fontstretch" {
						a href="#dom-context-2d-fontstretch" {
							- "fontStretch"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-fontvariantcaps" {
						a href="#dom-context-2d-fontvariantcaps" {
							- "fontVariantCaps"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-textrendering" {
						a href="#dom-context-2d-textrendering" {
							- "textRendering"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-imagesmoothingenabled" {
						a href="#dom-context-2d-imagesmoothingenabled" {
							- "imageSmoothingEnabled"
						}
					}
					- ", "
					code id="the-canvas-state:dom-context-2d-imagesmoothingquality" {
						a href="#dom-context-2d-imagesmoothingquality" {
							- "imageSmoothingQuality"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "The current "
					a href="#dash-list" id="the-canvas-state:dash-list" {
						- "dash list"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The rendering context's bitmaps are not part of the drawing state, as they\n  depend on whether and how the rendering context is bound to a "
			code id="the-canvas-state:the-canvas-element" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element."
		}
		- "\n\n  "
		p {
			- "Objects that implement the "
			code id="the-canvas-state:canvasstate-2" {
				a href="#canvasstate" {
					- "CanvasState"
				}
			}
			- " mixin have a "
			dfn id="concept-canvas-context-lost" {
				- "context lost"
			}
			- " boolean, that is initialized to false\n  when the object is created. The "
			a href="#concept-canvas-context-lost" id="the-canvas-state:concept-canvas-context-lost" {
				- "context lost"
			}
			- "\n  value is updated in the "
			a href="#context-lost-steps" id="the-canvas-state:context-lost-steps" {
				- "context lost steps"
			}
			- "."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "context"
					}
					- "."
					a href="#dom-context-2d-save" id="dom-context-2d-save-dev" {
						- "save"
					}
					- "()"
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						b title="Support in all current engines." class="all-engines-flag" {
							- "✔"
						}
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/save" title="The CanvasRenderingContext2D.save() method of the Canvas 2D API saves the entire state of the canvas by pushing the current state onto a stack." {
								- "CanvasRenderingContext2D/save"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "1.5+"
								}
							}
							span class="safari yes" {
								span {
									- "Safari"
								}
								span {
									- "2+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "1+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "12.1+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
