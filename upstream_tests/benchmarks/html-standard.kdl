										- "until end"
									}
									- "\") tuple, be the byte range required to satisfy\n       missing data in "
									a href="#media-data" id="loading-the-media-resource:media-data" {
										- "media data"
									}
									- ". This value is "
									a id="loading-the-media-resource:implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
										- "implementation-defined"
									}
									- "\n       and may rely on codec, network conditions or other heuristics. The user-agent may determine\n       to fetch the resource in full, in which case "
									var {
										- "byteRange"
									}
									- " would be\n       \""
									code {
										- "entire resource"
									}
									- "\", to fetch from a byte offset until the end,\n       in which case "
									var {
										- "byteRange"
									}
									- " would be\n       (number, \""
									code {
										- "until end"
									}
									- "\"), or to fetch a range between two byte offsets,\n       im which case "
									var {
										- "byteRange"
									}
									- " would be a (number, number) tuple representing the two\n       offsets."
								}
							}
							li {
								- "\n        "
								p {
									- "If "
									var {
										- "byteRange"
									}
									- " is not \""
									code {
										- "entire resource"
									}
