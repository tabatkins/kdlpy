			}
			dd {
				- "An error of some description occurred while decoding the "
				a href="#media-resource" id="error-codes:media-resource-3" {
					- "media resource"
				}
				- ", after\n   the resource was established to be usable."
			}
			dt {
				dfn data-dfn-for="MediaError" id="dom-mediaerror-media_err_src_not_supported" data-dfn-type="const" {
					code {
						- "MEDIA_ERR_SRC_NOT_SUPPORTED"
					}
				}
