		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMeterElement" id="dom-meter-value" data-dfn-type="attribute" {
				code {
					- "value"
				}
			}
			- " IDL\n  attribute, on getting, must return the "
			a href="#concept-meter-actual" id="the-meter-element:concept-meter-actual" {
				- "actual value"
			}
			- ". On\n  setting, the given value must be converted to the "
			a href="#best-representation-of-the-number-as-a-floating-point-number" id="the-meter-element:best-representation-of-the-number-as-a-floating-point-number" {
				- "best representation of the number as a\n  floating-point number"
			}
			- " and then the "
			code id="the-meter-element:attr-meter-value-8" {
				a href="#attr-meter-value" {
					- "value"
				}
			}
			- " content\n  attribute must be set to that string."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMeterElement" id="dom-meter-min" data-dfn-type="attribute" {
				code {
					- "min"
				}
			}
			- " IDL\n  attribute, on getting, must return the "
			a href="#concept-meter-minimum" id="the-meter-element:concept-meter-minimum" {
				- "minimum value"
			}
			- ".\n  On setting, the given value must be converted to the "
			a href="#best-representation-of-the-number-as-a-floating-point-number" id="the-meter-element:best-representation-of-the-number-as-a-floating-point-number-2" {
				- "best representation of the number as a\n  floating-point number"
			}
			- " and then the "
