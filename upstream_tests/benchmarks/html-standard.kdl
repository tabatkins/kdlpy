					a href="#she-other" id="persisted-user-state-restoration:she-other-2" {
						- "persisted user state"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This can even include updating the "
					code id="persisted-user-state-restoration:attr-dir" {
