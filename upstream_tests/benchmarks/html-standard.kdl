					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "If the "
					var {
						- "time present"
					}
					- " flag is true, then "
					a href="#parse-a-time-component" id="vaguer-moments-in-time:parse-a-time-component" {
						- "parse a time\n   component"
					}
					- " to obtain "
