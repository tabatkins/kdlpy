					- "navigate"
				}
			}
			- " event"
			a href="#the-navigate-event" class="self-link"
		}
		- "\n\n  "
		p {
			- "A major feature of the navigation API is the "
			code id="the-navigate-event:event-navigate-2" {
				a href="#event-navigate" {
					- "navigate"
				}
			}
			- "\n  event. This event is fired on any navigation (in the "
			a href="#navigationtype" id="the-navigate-event:navigationtype" {
				- "broad sense of\n  the word"
			}
			- "), allowing web developers to monitor such outgoing navigations. In many cases, the\n  event is "
			code id="the-navigate-event:dom-event-cancelable" {
				a data-x-internal="dom-event-cancelable" href="https://dom.spec.whatwg.org/#dom-event-cancelable" {
					- "cancelable"
				}
			}
			- ", which allows preventing the\n  navigation from happening. And in others, the navigation can be intercepted and replaced with a\n  same-document navigation by using the "
			code id="the-navigate-event:dom-navigateevent-intercept" {
				a href="#dom-navigateevent-intercept" {
					- "intercept()"
				}
			}
			- " method of the "
			code id="the-navigate-event:navigateevent" {
				a href="#navigateevent" {
					- "NavigateEvent"
				}
			}
			- "\n  class."
		}
