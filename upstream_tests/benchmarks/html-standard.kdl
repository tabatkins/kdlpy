						- "Attempts to preserve the selection. This is the default."
					}
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "All "
			code id="textFieldSelection:the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " elements to which these APIs "
			a href="#concept-input-apply" id="textFieldSelection:concept-input-apply" {
				- "apply"
			}
			- ", and all "
			code id="textFieldSelection:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements, have either a\n  "
			dfn id="concept-textarea/input-selection" {
				- "selection"
			}
			- " or a "
			dfn id="concept-textarea/input-cursor" {
				- "text entry cursor position"
			}
			- " at all times (even for\n  elements that are not "
			a href="#being-rendered" id="textFieldSelection:being-rendered" {
				- "being rendered"
			}
			- "), measured in offsets into the "
			a href="https://infra.spec.whatwg.org/#code-unit" id="textFieldSelection:code-unit" data-x-internal="code-unit" {
				- "code units"
			}
			- " of the control's "
			a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value" {
				- "relevant value"
			}
			- ". The initial state must\n  consist of a "
			a href="#concept-textarea/input-cursor" id="textFieldSelection:concept-textarea/input-cursor" {
				- "text entry cursor"
			}
			- " at the\n  beginning of the control."
		}
		- "\n  \n\n  "
		p {
			- "For "
			code id="textFieldSelection:the-input-element-3" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " elements, these APIs must operate on the element's "
			a href="#concept-fe-value" id="textFieldSelection:concept-fe-value" {
				- "value"
			}
			- ". For "
			code id="textFieldSelection:the-textarea-element-3" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements, these APIs must\n  operate on the element's "
			a href="#concept-fe-api-value" id="textFieldSelection:concept-fe-api-value" {
				- "API value"
			}
			- ". In the below\n  algorithms, we call the value string being operated on the "
			dfn id="concept-textarea/input-relevant-value" {
				- "relevant value"
			}
			- "."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The use of "
				a href="#concept-fe-api-value" id="textFieldSelection:concept-fe-api-value-2" {
					- "API value"
				}
				- " instead of "
				a href="#concept-textarea-raw-value" id="textFieldSelection:concept-textarea-raw-value" {
					- "raw value"
				}
				- " for "
				code id="textFieldSelection:the-textarea-element-4" {
					a href="#the-textarea-element" {
						- "textarea"
					}
				}
				- " elements means\n   that U+000D (CR) characters are normalized away. For example,\n\n   "
			}
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "textarea"
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"demo\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "textarea"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n demo"
					c- p="" {
						- "."
					}
					- "value "
					c- o="" {
						- "="
					}
					- " "
					c- u="" {
						- "\"A\\r\\nB\""
					}
					c- p="" {
						- ";"
					}
					- "\n demo"
					c- p="" {
						- "."
					}
					- "setRangeText"
					c- p="" {
						- "("
					}
					c- u="" {
						- "\"replaced\""
					}
					c- p="" {
						- ","
					}
					- " "
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ","
					}
					- " "
					c- mf="" {
						- "2"
					}
					c- p="" {
						- ");"
					}
					- "\n assert"
					c- p="" {
						- "("
					}
					- "demo"
					c- p="" {
						- "."
					}
					- "value "
					c- o="" {
						- "==="
					}
					- " "
					c- u="" {
						- "\"replacedB\""
					}
					c- p="" {
						- ");"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "If we had operated on the "
				a href="#concept-textarea-raw-value" id="textFieldSelection:concept-textarea-raw-value-2" {
					- "raw value"
				}
				- " of \""
				code {
					- "A\\r\\nB"
				}
				- "\", then we would have replaced the characters \""
				code {
					- "A\\r"
				}
				- "\", ending up with a result of \""
				code {
					- "replaced\\nB"
				}
				- "\". But since\n   we used the "
				a href="#concept-fe-api-value" id="textFieldSelection:concept-fe-api-value-3" {
					- "API value"
				}
				- " of \""
				code {
					- "A\\nB"
				}
				- "\", we replaced the characters \""
				code {
					- "A\\n"
				}
				- "\", giving \""
				code {
					- "replacedB"
				}
				- "\"."
			}
			- "\n  "
		}
		- "\n\n  "
		p class="note" {
			- "Characters with no visible rendering, such as U+200D ZERO WIDTH JOINER, still\n  count as characters. Thus, for instance, the selection can include just an invisible character,\n  and the text insertion cursor can be placed to one side or another of such a character."
		}
		- "\n\n  "
		p {
			- "Whenever the "
			a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-2" {
				- "relevant value"
			}
			- " changes\n  for an element to which these APIs apply, run these steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the element has a "
					a href="#concept-textarea/input-selection" id="textFieldSelection:concept-textarea/input-selection" {
						- "selection"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the start of the selection is now past the end of the "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-3" {
								- "relevant value"
							}
							- ", set it to the end of the\n     "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-4" {
								- "relevant value"
							}
							- "."
						}
					}
					li {
						p {
							- "If the end of the selection is now past the end of the "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-5" {
								- "relevant value"
							}
							- ", set it to the end of the\n     "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-6" {
								- "relevant value"
							}
							- "."
						}
					}
					li {
						p {
							- "If the user agent does not support empty selection, and both the start and end of the\n     selection are now pointing to the end of the "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-7" {
								- "relevant value"
							}
							- ", then instead set the\n     element's "
							a href="#concept-textarea/input-cursor" id="textFieldSelection:concept-textarea/input-cursor-2" {
								- "text entry cursor position"
							}
							- " to the\n     end of the "
							a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-8" {
								- "relevant value"
							}
							- ", removing\n     any selection."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Otherwise, the element must have a "
					a href="#concept-textarea/input-cursor" id="textFieldSelection:concept-textarea/input-cursor-3" {
						- "text entry\n   cursor position"
					}
					- " position. If it is now past the end of the "
					a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-9" {
						- "relevant value"
					}
					- ", set it to the end of the\n   "
					a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-10" {
						- "relevant value"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "In some cases where the "
			a href="#concept-textarea/input-relevant-value" id="textFieldSelection:concept-textarea/input-relevant-value-11" {
				- "relevant value"
			}
			- " changes, other parts of the\n  specification will also modify the "
			a href="#concept-textarea/input-cursor" id="textFieldSelection:concept-textarea/input-cursor-4" {
				- "text entry cursor\n  position"
			}
			- ", beyond just the clamping steps above. For example, see the "
			code id="textFieldSelection:dom-textarea-value" {
				a href="#dom-textarea-value" {
					- "value"
				}
			}
			- " setter for "
			code id="textFieldSelection:the-textarea-element-5" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Where possible, user interface features for changing the "
			a href="#concept-textarea/input-selection" id="textFieldSelection:concept-textarea/input-selection-2" {
				- "text selection"
			}
			- " in "
			code id="textFieldSelection:the-input-element-4" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " and\n  "
			code id="textFieldSelection:the-textarea-element-6" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements must be implemented using the "
			a href="#set-the-selection-range" id="textFieldSelection:set-the-selection-range" {
				- "set the selection range"
			}
			- "\n  algorithm so that, e.g., all the same events fire."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-textarea/input-selection" id="textFieldSelection:concept-textarea/input-selection-3" {
				- "selections"
			}
			- " of "
			code id="textFieldSelection:the-input-element-5" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " and\n  "
			code id="textFieldSelection:the-textarea-element-7" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements have a "
