			}
			- " (default false) is the following steps.\n  They return a list of zero or more nodes."
		}
		- "\n\n  "
		p class="note" {
			- "Parts marked "
			dfn id="fragment-case" {
				- "fragment case"
			}
			- " in algorithms in the "
			a href="#html-parser" id="parsing-html-fragments:html-parser" {
				- "HTML\n  parser"
			}
			- " section are parts that only occur if the parser was created for the purposes of this\n  algorithm. The algorithms have been annotated with such markings for informational purposes only;\n  such markings have no normative weight. If it is possible for a condition described as a\n  "
			a href="#fragment-case" id="parsing-html-fragments:fragment-case" {
				- "fragment case"
			}
			- " to occur even when the parser wasn't created for the purposes of\n  handling this algorithm, then that is an error in the specification."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "document"
					}
					- " be a "
