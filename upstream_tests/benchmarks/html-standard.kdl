			}
			- " is its "
			a href="#node-navigable" id="the-notrestoredreasons-interface:node-navigable-4" {
				- "node navigable"
			}
			- "'s\n  "
			a href="#nav-active-history-entry" id="the-notrestoredreasons-interface:nav-active-history-entry" {
				- "active session history entry"
			}
			- "'s "
