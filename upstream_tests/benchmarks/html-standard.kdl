						- "top-level origin"
					}
					- ", "
					a href="#concept-environment-target-browsing-context" id="script-settings-for-worklets:concept-environment-target-browsing-context" {
						- "target browsing context"
					}
					- " to null, and\n   "
					a href="#concept-environment-active-service-worker" id="script-settings-for-worklets:concept-environment-active-service-worker" {
						- "active service worker"
					}
					- " to\n   null."
