					}
					- "fillText"
					c- p="" {
						- "("
					}
					c- u="" {
						- "\"hello\""
					}
					c- p="" {
						- ","
					}
					- " "
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ","
					}
					- " "
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ");"
					}
					- "\n  "
					c- p="" {
						- "});"
					}
					- "\n"
					c- p="" {
