			a href="#external-resource-link" id="processing-the-type-attribute:external-resource-link" {
				- "external\n  resource link"
			}
			- " type has a default type defined, then the user agent must assume that the\n  resource is of that type. If the UA does not support the given "
			a id="processing-the-type-attribute:mime-type" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
				- "MIME type"
			}
