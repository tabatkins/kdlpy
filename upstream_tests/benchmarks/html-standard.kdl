			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-16" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object is a rendering context for drawing to\n  the "
			a href="#offscreencanvas-bitmap" id="the-offscreen-2d-rendering-context:offscreencanvas-bitmap" {
				- "bitmap"
			}
			- " of an "
			code id="the-offscreen-2d-rendering-context:offscreencanvas-2" {
				a href="#offscreencanvas" {
					- "OffscreenCanvas"
				}
			}
			- " object.\n  It is similar to the "
			code id="the-offscreen-2d-rendering-context:canvasrenderingcontext2d" {
				a href="#canvasrenderingcontext2d" {
					- "CanvasRenderingContext2D"
				}
			}
			- " object, with the following\n  differences:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "there is no support for "
					a href="#canvasuserinterface" id="the-offscreen-2d-rendering-context:canvasuserinterface" {
						- "user interface"
					}
					- "\n   features;"
				}
			}
			li {
				p {
					- "its "
					code id="the-offscreen-2d-rendering-context:offscreencontext2d-canvas-2" {
						a href="#offscreencontext2d-canvas" {
							- "canvas"
						}
					}
					- " attribute refers to an\n   "
					code id="the-offscreen-2d-rendering-context:offscreencanvas-3" {
						a href="#offscreencanvas" {
							- "OffscreenCanvas"
						}
					}
					- " object rather than a "
					code id="the-offscreen-2d-rendering-context:the-canvas-element" {
						a href="#the-canvas-element" {
							- "canvas"
						}
					}
					- " element;"
				}
			}
		}
		- "\n\n  "
		p {
			- "An "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-17" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object has a "
			dfn id="offscreencontext2d-bitmap" {
				- "bitmap"
			}
			- " that is initialized when the object is\n  created."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#offscreencontext2d-bitmap" id="the-offscreen-2d-rendering-context:offscreencontext2d-bitmap" {
				- "bitmap"
			}
			- " has an "
			dfn id="offscreencontext2d-origin-clean" {
				- "origin-clean"
			}
			- " flag, which can be set to true or\n  false. Initially, when one of these bitmaps is created, its "
			a href="#offscreencontext2d-origin-clean" id="the-offscreen-2d-rendering-context:offscreencontext2d-origin-clean" {
				- "origin-clean"
			}
			- " flag must be set to true."
		}
		- "\n\n  "
		p {
			- "An "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-18" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object also has an "
			dfn id="offscreencontext2d-alpha" {
				- "alpha"
			}
			- " flag, which can be set to true or false. Initially,\n  when the context is created, its alpha flag must be set to true. When an\n  "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-19" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object has its "
			a href="#offscreencontext2d-alpha" id="the-offscreen-2d-rendering-context:offscreencontext2d-alpha" {
				- "alpha"
			}
			- " flag set to false, then its alpha channel must be\n  fixed to 1.0 (fully opaque) for all pixels, and attempts to change the alpha component of any pixel\n  must be silently ignored."
		}
		- "\n\n  "
		p {
			- "An "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-20" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object also has a "
			dfn id="offscreencontext2d-color-space" {
				- "color space"
			}
			- " setting of type\n  "
			code id="the-offscreen-2d-rendering-context:predefinedcolorspace" {
				a href="#predefinedcolorspace" {
					- "PredefinedColorSpace"
				}
			}
			- ". The color space for the context's "
			a href="#offscreencontext2d-bitmap" id="the-offscreen-2d-rendering-context:offscreencontext2d-bitmap-2" {
				- "bitmap"
			}
			- " is set to the context's "
			a href="#offscreencontext2d-color-space" id="the-offscreen-2d-rendering-context:offscreencontext2d-color-space" {
				- "color space"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-21" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object has an "
			dfn id="associated-offscreencanvas-object" {
				- "associated\n  "
				code {
					- "OffscreenCanvas"
				}
				- " object"
			}
			- ", which is the "
			code id="the-offscreen-2d-rendering-context:offscreencanvas-4" {
				a href="#offscreencanvas" {
					- "OffscreenCanvas"
				}
			}
			- " object\n  from which the "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-22" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- " object was created.\n\n  "
		}
		dl class="domintro" {
			dt {
				code {
					var {
						- "offscreenCanvas"
					}
					- " = "
					var {
						- "offscreenCanvasRenderingContext2D"
					}
					- "."
					a href="#offscreencontext2d-canvas" id="offscreencontext2d-canvas-dev" {
						- "canvas"
					}
				}
			}
			dd {
				p {
					- "Returns the "
					a href="#associated-offscreencanvas-object" id="the-offscreen-2d-rendering-context:associated-offscreencanvas-object" {
						- "associated "
						code {
							- "OffscreenCanvas"
						}
						- " object"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn id="offscreen-2d-context-creation-algorithm" {
				- "offscreen 2D context creation algorithm"
			}
			- ", which is passed a\n  "
			var {
				- "target"
			}
			- " (an "
			code id="the-offscreen-2d-rendering-context:offscreencanvas-5" {
				a href="#offscreencanvas" {
					- "OffscreenCanvas"
				}
			}
			- " object) and optionally some arguments,\n  consists of running the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the algorithm was passed some arguments, let "
					var {
						- "arg"
					}
					- " be the first such\n   argument. Otherwise, let "
					var {
						- "arg"
					}
					- " be undefined."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "settings"
					}
					- " be the result of "
					a href="https://webidl.spec.whatwg.org/#es-type-mapping" id="the-offscreen-2d-rendering-context:concept-idl-convert" data-x-internal="concept-idl-convert" {
						- "converting"
					}
					- " "
					var {
						- "arg"
					}
					- " to the dictionary type\n   "
					code id="the-offscreen-2d-rendering-context:canvasrenderingcontext2dsettings" {
						a href="#canvasrenderingcontext2dsettings" {
							- "CanvasRenderingContext2DSettings"
						}
					}
					- ". (This can throw an exception.)."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "context"
					}
					- " be a new "
					code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-23" {
						a href="#offscreencanvasrenderingcontext2d" {
							- "OffscreenCanvasRenderingContext2D"
						}
					}
					- "\n   object."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "context"
					}
					- "'s "
					a href="#associated-offscreencanvas-object" id="the-offscreen-2d-rendering-context:associated-offscreencanvas-object-2" {
						- "associated "
						code {
							- "OffscreenCanvas"
						}
						- " object"
					}
					- " to\n   "
					var {
						- "target"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "settings"
					}
					- "[\""
					code id="the-offscreen-2d-rendering-context:dom-canvasrenderingcontext2dsettings-alpha" {
						a href="#dom-canvasrenderingcontext2dsettings-alpha" {
							- "alpha"
						}
					}
					- "\"] is false, then set\n   "
					var {
						- "context"
					}
					- "'s "
					a href="#offscreencontext2d-alpha" id="the-offscreen-2d-rendering-context:offscreencontext2d-alpha-2" {
						- "alpha"
					}
					- " flag to false."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "context"
					}
					- "'s "
					a href="#offscreencontext2d-color-space" id="the-offscreen-2d-rendering-context:offscreencontext2d-color-space-2" {
						- "color space"
					}
					- "\n   to "
					var {
						- "settings"
					}
					- "[\""
					code id="the-offscreen-2d-rendering-context:dom-canvasrenderingcontext2dsettings-colorspace" {
						a href="#dom-canvasrenderingcontext2dsettings-colorspace" {
							- "colorSpace"
						}
					}
					- "\"]."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "context"
					}
					- "'s "
					a href="#offscreencontext2d-bitmap" id="the-offscreen-2d-rendering-context:offscreencontext2d-bitmap-3" {
						- "bitmap"
					}
					- " to a newly\n   created bitmap with the dimensions specified by the "
					code id="the-offscreen-2d-rendering-context:dom-offscreencanvas-width" {
						a href="#dom-offscreencanvas-width" {
							- "width"
						}
					}
					- " and "
					code id="the-offscreen-2d-rendering-context:dom-offscreencanvas-height" {
						a href="#dom-offscreencanvas-height" {
							- "height"
						}
					}
					- " attributes of "
					var {
						- "target"
					}
					- ", and set\n   "
					var {
						- "target"
					}
					- "'s bitmap to the same bitmap (so that they are shared)."
				}
			}
			li {
				p {
					- "If "
					var {
						- "context"
					}
					- "'s "
					a href="#offscreencontext2d-alpha" id="the-offscreen-2d-rendering-context:offscreencontext2d-alpha-3" {
						- "alpha"
					}
					- " flag is set\n   to true, initialize all the pixels of "
					var {
						- "context"
					}
					- "'s "
					a href="#offscreencontext2d-bitmap" id="the-offscreen-2d-rendering-context:offscreencontext2d-bitmap-4" {
						- "bitmap"
					}
					- " to "
					a id="the-offscreen-2d-rendering-context:transparent-black" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
						- "transparent black"
					}
					- ". Otherwise,\n   initialize the pixels to "
					a id="the-offscreen-2d-rendering-context:opaque-black" href="https://drafts.csswg.org/css-color/#opaque-black" data-x-internal="opaque-black" {
						- "opaque black"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "context"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "Implementations are encouraged to short-circuit the graphics update steps of\n  the "
			a href="#window-event-loop" id="the-offscreen-2d-rendering-context:window-event-loop" {
				- "window event loop"
			}
			- " for the purposes of updating the contents of a "
			a href="#offscreencanvas-placeholder" id="the-offscreen-2d-rendering-context:offscreencanvas-placeholder" {
				- "placeholder "
				code {
					- "canvas"
				}
				- " element"
			}
			- " to the\n  display. This could mean, for example, that the bitmap contents are copied directly to a graphics\n  buffer that is mapped to the physical display location of the "
			a href="#offscreencanvas-placeholder" id="the-offscreen-2d-rendering-context:offscreencanvas-placeholder-2" {
				- "placeholder "
				code {
					- "canvas"
				}
				- " element"
			}
			- ". This or\n  similar short-circuiting approaches can significantly reduce display latency, especially in cases\n  where the "
			code id="the-offscreen-2d-rendering-context:offscreencanvas-6" {
				a href="#offscreencanvas" {
					- "OffscreenCanvas"
				}
			}
			- " is updated from a\n  "
			a href="#worker-event-loop-2" id="the-offscreen-2d-rendering-context:worker-event-loop-2" {
				- "worker event loop"
			}
			- " and the "
			a href="#window-event-loop" id="the-offscreen-2d-rendering-context:window-event-loop-2" {
				- "window event loop"
			}
			- " of the "
			a href="#offscreencanvas-placeholder" id="the-offscreen-2d-rendering-context:offscreencanvas-placeholder-3" {
				- "placeholder "
				code {
					- "canvas"
				}
				- " element"
			}
			- " is busy.\n  However, such shortcuts cannot have any script-observable side-effects. This means that the\n  committed bitmap still needs to be sent to the "
			a href="#offscreencanvas-placeholder" id="the-offscreen-2d-rendering-context:offscreencanvas-placeholder-4" {
				- "placeholder "
				code {
					- "canvas"
				}
				- " element"
			}
			- ", in case the\n  element is used as a "
			code id="the-offscreen-2d-rendering-context:canvasimagesource" {
				a href="#canvasimagesource" {
					- "CanvasImageSource"
				}
			}
			- ", as an "
			code id="the-offscreen-2d-rendering-context:imagebitmapsource" {
				a href="#imagebitmapsource" {
					- "ImageBitmapSource"
				}
			}
			- ", or in\n  case "
			code id="the-offscreen-2d-rendering-context:dom-canvas-todataurl" {
				a href="#dom-canvas-todataurl" {
					- "toDataURL()"
				}
			}
			- " or "
			code id="the-offscreen-2d-rendering-context:dom-canvas-toblob" {
				a href="#dom-canvas-toblob" {
					- "toBlob()"
				}
			}
			- " are called on it."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="OffscreenCanvas" id="offscreencontext2d-canvas" data-dfn-type="attribute" {
				code {
					- "canvas"
				}
			}
			- " attribute, on getting, must return this\n  "
			code id="the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-24" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- "'s "
			a href="#associated-offscreencanvas-object" id="the-offscreen-2d-rendering-context:associated-offscreencanvas-object-3" {
				- "associated "
				code {
					- "OffscreenCanvas"
				}
				- "\n  object"
			}
			- ".\n\n  "
		}
		- "\n\n  \n\n  "
		h5 id="colour-spaces-and-colour-correction" {
			span class="secno" {
				- "4.12.5.4"
			}
			- " Color spaces and color space\n  conversion"
			a href="#colour-spaces-and-colour-correction" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="colour-spaces-and-colour-correction:the-canvas-element" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " APIs provide mechanisms for specifying the color space of the canvas's\n  backing store. The default backing store color space for all canvas APIs is\n  "
			a id="colour-spaces-and-colour-correction:'srgb'" href="https://drafts.csswg.org/css-color/#valdef-color-srgb" data-x-internal="'srgb'" {
				- "'srgb'"
			}
			- "."
		}
		- "\n\n  "
		p {
			a href="https://drafts.csswg.org/css-color/#color-conversion" id="colour-spaces-and-colour-correction:converting-colors" data-x-internal="converting-colors" {
				- "Color space conversion"
			}
			- " must be applied to the canvas's\n  backing store when rendering the canvas to the output device. This color space conversion must be\n  identical to the color space conversion that would be applied to an "
			code id="colour-spaces-and-colour-correction:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element with\n  a color profile that specifies the same "
			a href="#concept-canvas-color-space" id="colour-spaces-and-colour-correction:concept-canvas-color-space" {
				- "color\n  space"
			}
			- " as the canvas's backing store."
		}
		- "\n\n  "
		p {
			- "When drawing content to a 2D context, all inputs must be "
			a href="https://drafts.csswg.org/css-color/#color-conversion" id="colour-spaces-and-colour-correction:converting-colors-2" data-x-internal="converting-colors" {
				- "converted"
			}
			- " to the "
			a href="#concept-canvas-color-space" id="colour-spaces-and-colour-correction:concept-canvas-color-space-2" {
				- "context's color\n  space"
			}
			- " before drawing. Interpolation of gradient color stops must be performed on color\n  values after conversion to the "
			a href="#concept-canvas-color-space" id="colour-spaces-and-colour-correction:concept-canvas-color-space-3" {
				- "context's color\n  space"
			}
			- ". Alpha blending must be performed on values after conversion to the "
			a href="#concept-canvas-color-space" id="colour-spaces-and-colour-correction:concept-canvas-color-space-4" {
				- "context's color space"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "There do not exist any inputs to a 2D context for which the color space is\n  undefined. The color space for CSS colors is defined in "
			cite {
				- "CSS Color"
			}
			- ". The color space\n  for images that specify no color profile information is assumed to be "
			a id="colour-spaces-and-colour-correction:'srgb'-2" href="https://drafts.csswg.org/css-color/#valdef-color-srgb" data-x-internal="'srgb'" {
				- "'srgb'"
			}
			- ", as\n  specified in the "
			a href="https://drafts.csswg.org/css-color/#untagged" {
				- "Color Spaces of Untagged\n  Colors"
			}
			- " section of "
			cite {
				- "CSS Color"
			}
			- ". "
			a href="#refsCSSCOLOR" {
				- "[CSSCOLOR]"
			}
		}
		- "\n\n  \n\n\n\n  "
		h5 id="serialising-bitmaps-to-a-file" {
			span class="secno" {
				- "4.12.5.5"
			}
			- " Serializing bitmaps to a file"
			a href="#serialising-bitmaps-to-a-file" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			- "When a user agent is to create "
			dfn id="a-serialisation-of-the-bitmap-as-a-file" {
				- "a\n  serialization of the bitmap as a file"
			}
			- ", given a "
			var {
				- "type"
			}
			- " and an optional\n  "
			var {
				- "quality"
			}
			- ", it must create an image file in the format given by "
			var {
				- "type"
			}
			- ". If an\n  error occurs during the creation of the image file (e.g. an internal encoder error), then the\n  result of the serialization is null. "
			a href="#refsPNG" {
				- "[PNG]"
			}
		}
		- "\n\n  "
		p {
			- "The image file's pixel data must be the bitmap's pixel data scaled to one image pixel per\n  coordinate space unit, and if the file format used supports encoding resolution metadata, the\n  resolution must be given as 96dpi (one image pixel per "
			a href="https://drafts.csswg.org/css-values/#px" id="serialising-bitmaps-to-a-file:'px'" data-x-internal="'px'" {
				- "CSS pixel"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "If "
			var {
				- "type"
			}
			- " is supplied, then it must be interpreted as a "
			a href="https://mimesniff.spec.whatwg.org/#mime-type" id="serialising-bitmaps-to-a-file:mime-type" data-x-internal="mime-type" {
				- "MIME\n  type"
			}
			- " giving the format to use. If the type has any parameters, then it must be treated as\n  not supported."
		}
		- "\n\n  "
		p class="example" {
			- "For example, the value \""
			code id="serialising-bitmaps-to-a-file:image/png" {
				a href="#image/png" {
					- "image/png"
				}
			}
			- "\" would mean to generate a PNG\n  image, the value \""
			code id="serialising-bitmaps-to-a-file:image/jpeg" {
				a href="#image/jpeg" {
					- "image/jpeg"
				}
			}
			- "\" would mean to generate a JPEG image, and the value\n  \""
			code id="serialising-bitmaps-to-a-file:image/svg+xml" {
				a href="#image/svg+xml" {
					- "image/svg+xml"
				}
			}
			- "\" would mean to generate an SVG image (which would require that the\n  user agent track how the bitmap was generated, an unlikely, though potentially awesome,\n  feature)."
		}
		- "\n\n  "
		p {
			- "User agents must support PNG (\""
			code id="serialising-bitmaps-to-a-file:image/png-2" {
				a href="#image/png" {
					- "image/png"
				}
			}
			- "\"). User agents may support other types.\n  If the user agent does not support the requested type, then it must create the file using the PNG\n  format. "
			a href="#refsPNG" {
				- "[PNG]"
			}
		}
		- "\n\n  "
		p {
			- "User agents must "
			a href="https://infra.spec.whatwg.org/#ascii-lowercase" id="serialising-bitmaps-to-a-file:converted-to-ascii-lowercase" data-x-internal="converted-to-ascii-lowercase" {
				- "convert the provided type to ASCII\n  lowercase"
			}
			- " before establishing if they support that type."
		}
		- "\n\n  "
		p {
			- "For image types that do not support an alpha channel, the serialized image must be the bitmap\n  image composited onto an "
			a id="serialising-bitmaps-to-a-file:opaque-black" href="https://drafts.csswg.org/css-color/#opaque-black" data-x-internal="opaque-black" {
				- "opaque black"
			}
			- " background using the "
			a href="https://drafts.fxtf.org/compositing/#porterduffcompositingoperators_srcover" id="serialising-bitmaps-to-a-file:gcop-source-over" data-x-internal="gcop-source-over" {
				- "source-over"
			}
			- " compositing operator."
		}
		- "\n\n  "
		p {
			- "For image types that support color profiles, the serialized image must include a color profile\n  indicating the color space of the underlying bitmap. For image types that do not support color\n  profiles, the serialized image must be "
			a href="https://drafts.csswg.org/css-color/#color-conversion" id="serialising-bitmaps-to-a-file:converting-colors" data-x-internal="converting-colors" {
				- "converted"
			}
			- " to the\n  "
			a id="serialising-bitmaps-to-a-file:'srgb'" href="https://drafts.csswg.org/css-color/#valdef-color-srgb" data-x-internal="'srgb'" {
				- "'srgb'"
			}
			- " color space using "
			a id="serialising-bitmaps-to-a-file:'relative-colorimetric'" href="https://drafts.csswg.org/css-color-5/#valdef-color-profile-rendering-intent-relative-colorimetric" data-x-internal="'relative-colorimetric'" {
				- "'relative-colorimetric'"
			}
			- " rendering intent."
		}
		- "\n\n  "
		p class="note" {
			- "Thus, in the 2D context, calling the "
			code id="serialising-bitmaps-to-a-file:dom-context-2d-drawimage" {
				a href="#dom-context-2d-drawimage" {
					- "drawImage()"
				}
			}
			- " method to render the output of the "
			code id="serialising-bitmaps-to-a-file:dom-canvas-todataurl" {
				a href="#dom-canvas-todataurl" {
					- "toDataURL()"
				}
			}
			- " or "
			code id="serialising-bitmaps-to-a-file:dom-canvas-toblob" {
				a href="#dom-canvas-toblob" {
					- "toBlob()"
				}
			}
			- " method to the canvas, given the appropriate dimensions,\n  has no visible effect beyond, at most, clipping colors of the canvas to a more narrow gamut."
		}
		- "\n\n  "
		p {
			- "If "
			var {
				- "type"
			}
			- " is an image format that supports variable quality (such as\n  \""
			code id="serialising-bitmaps-to-a-file:image/jpeg-2" {
				a href="#image/jpeg" {
					- "image/jpeg"
				}
			}
			- "\"), "
			var {
				- "quality"
			}
			- " is given, and "
			var {
				- "type"
			}
			- " is not\n  \""
			code id="serialising-bitmaps-to-a-file:image/png-3" {
				a href="#image/png" {
					- "image/png"
				}
			}
			- "\", then, if "
			var {
				- "quality"
			}
			- " "
			a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-number-type" id="serialising-bitmaps-to-a-file:js-number" data-x-internal="js-number" {
				- "is a Number"
			}
			- "\n  in the range 0.0 to 1.0 inclusive, the user agent must treat "
			var {
				- "quality"
			}
			- " as the desired\n  quality level. Otherwise, the user agent must use its default quality value, as if the\n  "
			var {
				- "quality"
			}
			- " argument had not been given."
		}
		- "\n\n  "
		p class="note" {
			- "The use of type-testing here, instead of simply declaring "
			var {
				- "quality"
			}
			- " as\n  a Web IDL "
			code {
				- "double"
			}
			- ", is a historical artifact."
		}
		- "\n\n  "
		p class="note" {
			- "Different implementations can have slightly different interpretations of\n  \"quality\". When the quality is not specified, an implementation-specific default is used that\n  represents a reasonable compromise between compression ratio, image quality, and encoding\n  time."
		}
		- "\n\n  \n\n\n  \n\n  "
		h5 id="security-with-canvas-elements" {
			span class="secno" {
				- "4.12.5.6"
			}
			- " Security with "
			code id="security-with-canvas-elements:the-canvas-element" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " elements"
			a href="#security-with-canvas-elements" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			strong {
				- "Information leakage"
			}
			- " can occur if scripts from one "
			a href="#concept-origin" id="security-with-canvas-elements:concept-origin" {
				- "origin"
			}
			- " can\n  access information (e.g. read pixels) from images from another origin (one that isn't the "
			a href="#same-origin" id="security-with-canvas-elements:same-origin" {
				- "same"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "To mitigate this, bitmaps used with "
			code id="security-with-canvas-elements:the-canvas-element-2" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " elements, "
			code id="security-with-canvas-elements:offscreencanvas" {
				a href="#offscreencanvas" {
					- "OffscreenCanvas"
				}
			}
			- "\n  objects, and "
			code id="security-with-canvas-elements:imagebitmap" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " objects are defined to have a flag indicating whether they\n  are "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean" {
				- "origin-clean"
			}
			- ". All bitmaps start with their\n  "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-2" {
				- "origin-clean"
			}
			- " set to true. The flag is set to\n  false when cross-origin images are used."
		}
		- "\n\n  "
		p {
			- "The "
			code id="security-with-canvas-elements:dom-canvas-todataurl" {
				a href="#dom-canvas-todataurl" {
					- "toDataURL()"
				}
			}
			- ", "
			code id="security-with-canvas-elements:dom-canvas-toblob" {
				a href="#dom-canvas-toblob" {
					- "toBlob()"
				}
			}
			- ", and "
			code id="security-with-canvas-elements:dom-context-2d-getimagedata" {
				a href="#dom-context-2d-getimagedata" {
					- "getImageData()"
				}
			}
			- " methods check the flag and will\n  throw a "
			a id="security-with-canvas-elements:securityerror" href="https://webidl.spec.whatwg.org/#securityerror" data-x-internal="securityerror" {
				- "\""
				code {
					- "SecurityError"
				}
				- "\""
			}
			- " "
			code id="security-with-canvas-elements:domexception" {
				a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
					- "DOMException"
				}
			}
			- " rather than leak\n  cross-origin data."
		}
		- "\n\n  "
		p {
			- "The value of the "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-3" {
				- "origin-clean"
			}
			- " flag is\n  propagated from a source's bitmap to a new "
			code id="security-with-canvas-elements:imagebitmap-2" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " object by "
			code id="security-with-canvas-elements:dom-createimagebitmap" {
				a href="#dom-createimagebitmap" {
					- "createImageBitmap()"
				}
			}
			- ". Conversely, a destination "
			code id="security-with-canvas-elements:the-canvas-element-3" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element's bitmap will have its "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-4" {
				- "origin-clean"
			}
			- " flags set to false by "
			code id="security-with-canvas-elements:dom-context-2d-drawimage" {
				a href="#dom-context-2d-drawimage" {
					- "drawImage"
				}
			}
			- " if the source image is an\n  "
			code id="security-with-canvas-elements:imagebitmap-3" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " object whose bitmap has its "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-5" {
				- "origin-clean"
			}
			- " flag set to false."
		}
		- "\n\n  "
		p {
			- "The flag can be reset in certain situations; for example, when changing the value of the\n  "
			code id="security-with-canvas-elements:attr-canvas-width" {
				a href="#attr-canvas-width" {
					- "width"
				}
			}
			- " or the "
			code id="security-with-canvas-elements:attr-canvas-height" {
				a href="#attr-canvas-height" {
					- "height"
				}
			}
			- " content attribute of the "
			code id="security-with-canvas-elements:the-canvas-element-4" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element\n  to which a "
			code id="security-with-canvas-elements:canvasrenderingcontext2d" {
				a href="#canvasrenderingcontext2d" {
					- "CanvasRenderingContext2D"
				}
			}
			- " is bound, the bitmap is\n  cleared and its "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-6" {
				- "origin-clean"
			}
			- " flag is reset."
		}
		- "\n\n  "
		p {
			- "When using an "
			code id="security-with-canvas-elements:imagebitmaprenderingcontext" {
				a href="#imagebitmaprenderingcontext" {
					- "ImageBitmapRenderingContext"
				}
			}
			- ", the value of the "
			a href="#concept-canvas-origin-clean" id="security-with-canvas-elements:concept-canvas-origin-clean-7" {
				- "origin-clean"
			}
			- " flag is propagated from\n  "
			code id="security-with-canvas-elements:imagebitmap-4" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " objects when they are transferred to the "
			code id="security-with-canvas-elements:the-canvas-element-5" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- "\n  via "
			a href="#dom-imagebitmaprenderingcontext-transferfromimagebitmap" id="security-with-canvas-elements:dom-imagebitmaprenderingcontext-transferfromimagebitmap" {
				- "transferFromImageBitmap()"
			}
			- "."
		}
		- "\n\n  \n\n  "
		h5 id="premultiplied-alpha-and-the-2d-rendering-context" {
			span class="secno" {
				- "4.12.5.7"
			}
			- " Premultiplied alpha and the 2D rendering context"
			a href="#premultiplied-alpha-and-the-2d-rendering-context" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="concept-premultiplied-alpha" {
				- "Premultiplied alpha"
			}
			- " refers to one way of\n  representing transparency in an image, the other being non-premultiplied alpha."
		}
		- "\n\n  "
		p {
			- "Under non-premultiplied alpha, the red, green, and blue channels of a pixel represent that\n  pixel's color, and its alpha channel represents that pixel's opacity."
		}
		- "\n\n  "
		p {
			- "Under premultiplied alpha, however, the red, green, and blue channels of a pixel represent the\n  amounts of color that the pixel adds to the image, and its alpha channel represents the amount\n  that the pixel obscures whatever is behind it."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "For instance, assuming the color channels range from 0 (off) to 255 (full intensity), these\n   example colors are represented in the following ways:"
			}
			- "\n\n   "
			table {
				thead {
					tr {
						th {
							- "CSS color representation\n      "
						}
						th {
							- "Premultiplied representation\n      "
						}
						th {
							- "Non-premultiplied representation\n      "
						}
						th {
							- "Description of color\n      "
						}
						th {
							- "Image of color blended above other content\n    "
						}
					}
				}
				tbody {
					tr {
						td {
							- "rgba(255, 127, 0, 1)\n      "
						}
						td {
							- "255, 127, 0, 255\n      "
						}
						td {
							- "255, 127, 0, 255\n      "
						}
						td {
							- "Completely-opaque orange\n      "
						}
						td {
							img src="images/premultiplied-example-1.png" width="96" alt="An opaque orange circle sits atop a background" height="96"
							- "\n     "
						}
					}
					tr {
						td {
							- "rgba(255, 255, 0, 0.5)\n      "
						}
						td {
							- "127, 127, 0, 127\n      "
						}
						td {
							- "255, 255, 0, 127\n      "
						}
						td {
							- "Halfway-opaque yellow\n      "
						}
						td {
							img src="images/premultiplied-example-2.png" width="96" alt="A yellow circle, halfway transparent, sits atop a background" height="96"
							- "\n     "
						}
					}
					tr {
						td {
							- "Unrepresentable\n      "
						}
						td {
							- "255, 127, 0, 127\n      "
						}
						td {
							- "Unrepresentable\n      "
						}
						td {
							- "Additive halfway-opaque orange\n      "
						}
						td {
							img src="images/premultiplied-example-3.png" width="96" alt="An orange circle somewhat brightens the background that it sits atop" height="96"
							- "\n     "
						}
					}
					tr {
						td {
							- "Unrepresentable\n      "
						}
						td {
							- "255, 127, 0, 0\n      "
						}
						td {
							- "Unrepresentable\n      "
						}
						td {
							- "Additive fully-transparent orange\n      "
						}
						td {
							img src="images/premultiplied-example-4.png" width="96" alt="An orange circle completely brightens the background that it sits atop" height="96"
							- "\n     "
						}
					}
					tr {
						td {
							- "rgba(255, 127, 0, 0)\n      "
						}
						td {
							- "0, 0, 0, 0\n      "
						}
						td {
							- "255, 127, 0, 0\n      "
						}
						td {
							- "Fully-transparent (\"invisible\") orange\n      "
						}
						td {
							img src="images/premultiplied-example-5.png" width="96" alt="An empty background with nothing atop it" height="96"
							- "\n     "
						}
					}
					tr {
						td {
							- "rgba(0, 127, 255, 0)\n      "
						}
						td {
							- "0, 0, 0, 0\n      "
						}
						td {
							- "255, 127, 0, 0\n      "
						}
						td {
							- "Fully-transparent (\"invisible\") turquoise\n      "
						}
						td {
							img src="images/premultiplied-example-5.png" width="96" alt="An empty background with nothing atop it" height="96"
							- "\n   "
						}
					}
				}
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			dfn id="convert-to-premultiplied" {
				- "Converting a color value from a non-premultiplied\n  representation to a premultiplied one"
			}
			- " involves multiplying the color's red, green, and\n  blue channels by its alpha channel (remapping the range of the alpha channel such that \"fully\n  transparent\" is 0, and \"fully opaque\" is 1)."
		}
		- "\n\n  "
		p {
			dfn id="convert-from-premultiplied" {
				- "Converting a color value from a premultiplied\n  representation to a non-premultiplied one"
			}
			- " involves the inverse: dividing the color's red,\n  green, and blue channels by its alpha channel."
		}
		- "\n\n  "
		p {
			- "As certain colors can only be represented under premultiplied alpha (for instance, additive\n  colors), and others can only be represented under non-premultiplied alpha (for instance,\n  \"invisible\" colors which hold certain red, green, and blue values even with no opacity); and\n  division and multiplication on 8-bit integers (which is how canvas's colors are currently stored)\n  entails a loss of precision, converting between premultiplied and non-premultiplied alpha is a\n  lossy operation on colors that are not fully opaque."
		}
		- "\n\n  "
		p {
			- "A "
			code id="premultiplied-alpha-and-the-2d-rendering-context:canvasrenderingcontext2d" {
				a href="#canvasrenderingcontext2d" {
					- "CanvasRenderingContext2D"
				}
			}
			- "'s "
			a href="#output-bitmap" id="premultiplied-alpha-and-the-2d-rendering-context:output-bitmap" {
				- "output bitmap"
			}
			- " and an\n  "
			code id="premultiplied-alpha-and-the-2d-rendering-context:offscreencanvasrenderingcontext2d" {
				a href="#offscreencanvasrenderingcontext2d" {
					- "OffscreenCanvasRenderingContext2D"
				}
			}
			- "'s "
			a href="#offscreencontext2d-bitmap" id="premultiplied-alpha-and-the-2d-rendering-context:offscreencontext2d-bitmap" {
				- "bitmap"
			}
			- " must use premultiplied alpha to represent transparent colors."
		}
		- "\n\n  "
		p class="note" {
			- "It is important for canvas bitmaps to represent colors using premultiplied alpha\n  because it affects the range of representable colors. While additive colors cannot currently be\n  drawn onto canvases directly because CSS colors are non-premultiplied and cannot represent them,\n  it is still possible to, for instance, draw additive colors onto a WebGL canvas and then draw that\n  WebGL canvas onto a 2D canvas via "
			code id="premultiplied-alpha-and-the-2d-rendering-context:dom-context-2d-drawimage" {
				a href="#dom-context-2d-drawimage" {
					- "drawImage()"
				}
			}
			- "."
		}
		- "\n\n  "
		h3 id="custom-elements" {
			span class="secno" {
				- "4.13"
			}
			- " Custom elements"
			a href="#custom-elements" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/Web_Components/Using_custom_elements" title="One of the key features of the Web Components standard is the ability to create custom elements that encapsulate your functionality on an HTML page, rather than having to make do with a long, nested batch of elements that together provide a custom page feature. This article introduces the use of the Custom Elements API." {
						- "Using_custom_elements"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
