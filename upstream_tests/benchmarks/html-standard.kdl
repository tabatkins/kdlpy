					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "Should We wish to exercise this option, you agree to surrender your immortal soul,\n    and any claim you may have on it, within 5 (five) working days of receiving written\n    notification from  this site or one of its duly authorized minions."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n    "
					c- c="" {
						- "<!-- ... etc., with many more <p> elements ... -->"
					}
					- "\n  "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "div"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "form"
					}
					- " "
					c- e="" {
						- "method"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"dialog\""
					}
					c- p="" {
						- ">"
					}
					- "\n    "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "button"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"submit\""
					}
					- " "
					c- e="" {
						- "value"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"agree\""
					}
					c- p="" {
						- ">"
					}
					- "Agree"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "button"
					}
					c- p="" {
						- ">"
					}
					- "\n    "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "button"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"submit\""
					}
					- " "
					c- e="" {
						- "value"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"disagree\""
					}
					c- p="" {
						- ">"
					}
					- "Disagree"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "button"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "form"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "dialog"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "Note how the "
				a href="#dialog-focusing-steps" id="the-dialog-element:dialog-focusing-steps-2" {
					- "dialog focusing steps"
				}
				- " would have picked the scrollable\n   "
				code id="the-dialog-element:the-div-element" {
					a href="#the-div-element" {
						- "div"
					}
				}
				- " element by default, but similarly to the previous example, we have placed "
				code id="the-dialog-element:attr-fe-autofocus-4" {
					a href="#attr-fe-autofocus" {
						- "autofocus"
					}
				}
				- " on the "
				code id="the-dialog-element:the-div-element-2" {
					a href="#the-div-element" {
						- "div"
					}
				}
				- " so as to be more explicit and\n   robust against future changes."
			}
			- "\n\n   "
			p {
				- "In contrast, if the "
				code id="the-dialog-element:the-p-element" {
					a href="#the-p-element" {
						- "p"
					}
				}
				- " elements expressing the terms of service did not have such\n   a wrapper "
				code id="the-dialog-element:the-div-element-3" {
					a href="#the-div-element" {
						- "div"
					}
				}
				- " element, then the "
				code id="the-dialog-element:the-dialog-element-5" {
					a href="#the-dialog-element" {
						- "dialog"
					}
				}
				- " itself would become scrollable,\n   violating the above advice. Furthermore, in the absence of any "
				code id="the-dialog-element:attr-fe-autofocus-5" {
					a href="#attr-fe-autofocus" {
						- "autofocus"
					}
				}
				- " attribute, such a markup pattern would have violated\n   the above advice and tripped up the "
				a href="#dialog-focusing-steps" id="the-dialog-element:dialog-focusing-steps-3" {
					- "dialog focusing steps"
				}
				- "'s default behavior, and\n   caused focus to jump to the Agree "
				code id="the-dialog-element:the-button-element" {
					a href="#the-button-element" {
						- "button"
					}
				}
				- ", which is a bad user experience."
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="dialog" id="attr-dialog-open" data-dfn-type="element-attr" {
				code {
					- "open"
				}
			}
			- " attribute\n  is a "
			a href="#boolean-attribute" id="the-dialog-element:boolean-attribute" {
				- "boolean attribute"
			}
			- ". When specified, it indicates that the "
			code id="the-dialog-element:the-dialog-element-6" {
				a href="#the-dialog-element" {
					- "dialog"
				}
			}
			- "\n  element is active and that the user can interact with it."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="dialog" id="attr-dialog-closedby" data-dfn-type="element-attr" {
				code {
					- "closedby"
				}
			}
			- "\n  content attribute is an "
			a href="#enumerated-attribute" id="the-dialog-element:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following keywords and\n  states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="dialog/closedby" id="attr-dialog-closedby-any" data-dfn-type="attr-value" {
							code {
								- "any"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dialog-closedby-any-state" {
							- "Any"
						}
						- "\n     "
					}
					td {
						a href="#close-request" id="the-dialog-element:close-request" {
							- "Close requests"
						}
						- " or clicks outside close the dialog.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="dialog/closedby" id="attr-dialog-closedby-closerequest" data-dfn-type="attr-value" {
							code {
								- "closerequest"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dialog-closedby-closerequest-state" {
							- "Close Request"
						}
						- "\n     "
					}
					td {
						a href="#close-request" id="the-dialog-element:close-request-2" {
							- "Close requests"
						}
						- " close the dialog.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="dialog/closedby" id="attr-dialog-closedby-none" data-dfn-type="attr-value" {
							code {
								- "none"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-dialog-closedby-none-state" {
							- "None"
						}
						- "\n     "
					}
					td {
						- "No user actions automatically close the dialog.\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-dialog-element:attr-dialog-closedby-2" {
				a href="#attr-dialog-closedby" {
					- "closedby"
				}
			}
			- " attribute's "
			i id="the-dialog-element:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " and "
			i id="the-dialog-element:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value\n  default"
				}
			}
			- " are both the "
			dfn id="attr-dialog-closedby-auto-state" {
				- "Auto"
			}
			- " state."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#attr-dialog-closedby-auto-state" id="the-dialog-element:attr-dialog-closedby-auto-state" {
				- "Auto"
			}
			- " state behaves as\n  "
			a href="#attr-dialog-closedby-closerequest-state" id="the-dialog-element:attr-dialog-closedby-closerequest-state" {
				- "Close Request"
			}
			- " state when the\n  "
			code id="the-dialog-element:the-dialog-element-7" {
				a href="#the-dialog-element" {
					- "dialog"
				}
			}
			- " was shown using its "
			code id="the-dialog-element:dom-dialog-showmodal-2" {
				a href="#dom-dialog-showmodal" {
					- "showModal()"
				}
			}
			- "\n  method; otherwise the "
			a href="#attr-dialog-closedby-none-state" id="the-dialog-element:attr-dialog-closedby-none-state" {
				- "None"
			}
			- " state."
		}
		- "\n\n  \n\n  "
		p {
			- "A "
			code id="the-dialog-element:the-dialog-element-8" {
				a href="#the-dialog-element" {
					- "dialog"
				}
			}
			- " element without an "
			code id="the-dialog-element:attr-dialog-open-2" {
				a href="#attr-dialog-open" {
					- "open"
				}
			}
			- " attribute\n  specified should not be shown to the user. This requirement may be implemented indirectly through\n  the style layer. For example, user agents that "
			a href="#renderingUA" {
				- "support the suggested\n  default rendering"
			}
			- " implement this requirement using the CSS rules described in the "
			a href="#rendering" {
				- "Rendering section"
			}
			- "."
		}
		- "\n\n  \n\n  "
		div id="note-dialog-remove-open-attribute" class="note" {
			- "\n   "
			p {
				- "Removing the "
				code id="the-dialog-element:attr-dialog-open-3" {
					a href="#attr-dialog-open" {
						- "open"
					}
				}
				- " attribute will usually hide the\n   dialog. However, doing so has a number of strange additional consequences:\n\n   "
			}
			ul {
				li {
					p {
						- "The "
						code id="the-dialog-element:event-close" {
							a href="#event-close" {
								- "close"
							}
						}
						- " event will not be fired."
					}
				}
				li {
					p {
						- "The "
						code id="the-dialog-element:dom-dialog-close-2" {
							a href="#dom-dialog-close" {
								- "close()"
							}
						}
						- " method, and any "
						a href="#close-request" id="the-dialog-element:close-request-3" {
							- "close requests"
						}
						- ", will no longer be able to close the dialog."
					}
				}
				li {
					p {
						- "If the dialog was shown using its "
						code id="the-dialog-element:dom-dialog-showmodal-3" {
							a href="#dom-dialog-showmodal" {
								- "showModal()"
							}
						}
						- "\n    method, the "
						code id="the-dialog-element:document" {
							a href="#document" {
								- "Document"
							}
						}
						- " will still be "
						a href="#blocked-by-a-modal-dialog" id="the-dialog-element:blocked-by-a-modal-dialog" {
							- "blocked"
						}
						- "."
					}
				}
			}
			- "\n\n   "
			p {
				- "For these reasons, it is generally better to never remove the "
				code id="the-dialog-element:attr-dialog-open-4" {
					a href="#attr-dialog-open" {
						- "open"
					}
