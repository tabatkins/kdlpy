					- "caption"
				}
			}
			- " elements."
		}
		- "\n\n  "
		p {
			- "In addition, each element in the "
			a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements" {
				- "list of active formatting elements"
			}
			- " is associated\n  with the token for which it was created, so that further elements can be created for that token if\n  necessary."
		}
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="push-onto-the-list-of-active-formatting-elements" {
				- "push onto the list of active formatting\n  elements"
			}
			- " an element "
			var {
				- "element"
			}
			- ", the UA must perform the following\n  steps:"
		}
		- "\n\n  "
		ol id="noah" {
			li {
				p {
					- "If there are already three elements in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-2" {
						- "list of active formatting elements"
					}
					- "\n   after the last "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-2" {
						- "marker"
					}
					- ", if any, or anywhere in the\n   list if there are no "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-3" {
						- "markers"
					}
					- ", that have the same tag\n   name, namespace, and attributes as "
					var {
						- "element"
					}
					- ", then remove the earliest such\n   element from the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-3" {
						- "list of active formatting elements"
					}
					- ". For these purposes, the\n   attributes must be compared as they were when the elements were created by the parser; two\n   elements have the same attributes if all their parsed attributes can be paired such that the two\n   attributes in each pair have identical names, namespaces, and values (the order of the attributes\n   does not matter)."
				}
				- "\n\n   "
				p class="note" {
					- "This is the Noah's Ark clause. But with three per family instead of two."
				}
			}
			li {
				p {
					- "Add "
					var {
						- "element"
					}
					- " to the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-4" {
						- "list of active formatting\n   elements"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="reconstruct-the-active-formatting-elements" {
				- "reconstruct the active formatting elements"
			}
			- ",\n  the UA must perform the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If there are no entries in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-5" {
						- "list of active formatting elements"
					}
					- ", then there\n   is nothing to reconstruct; stop this algorithm."
				}
			}
			li {
				p {
					- "If the last (most recently added) entry in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-6" {
						- "list of active formatting\n   elements"
					}
					- " is a "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-4" {
						- "marker"
					}
					- ", or if it is an element\n   that is in the "
					a href="#stack-of-open-elements" id="the-list-of-active-formatting-elements:stack-of-open-elements" {
						- "stack of open elements"
					}
					- ", then there is nothing to reconstruct; stop\n   this algorithm."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "entry"
					}
					- " be the last (most recently added) element in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-7" {
						- "list\n   of active formatting elements"
					}
					- "."
				}
			}
			li {
				p {
					i {
						- "Rewind"
					}
					- ": If there are no entries before "
					var {
						- "entry"
					}
					- " in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-8" {
						- "list\n   of active formatting elements"
					}
					- ", then jump to the step labeled "
					i {
						- "create"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "entry"
					}
					- " be the entry one earlier than "
					var {
						- "entry"
					}
					- " in\n   the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-9" {
						- "list of active formatting elements"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "entry"
					}
					- " is neither a "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-5" {
						- "marker"
					}
					- " nor an element that is also in the "
					a href="#stack-of-open-elements" id="the-list-of-active-formatting-elements:stack-of-open-elements-2" {
						- "stack of\n   open elements"
					}
					- ", go to the step labeled "
					i {
						- "rewind"
					}
					- "."
				}
			}
			li {
				p {
					i {
						- "Advance"
					}
					- ": Let "
					var {
						- "entry"
					}
					- " be the element one later than "
					var {
						- "entry"
					}
					- " in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-10" {
						- "list of active formatting elements"
					}
					- "."
				}
			}
			li {
				p {
					i {
						- "Create"
					}
					- ": "
					a href="#insert-an-html-element" id="the-list-of-active-formatting-elements:insert-an-html-element" {
						- "Insert an HTML element"
					}
					- " for the token for which the element\n   "
					var {
						- "entry"
					}
					- " was created, to obtain "
					var {
						- "new element"
					}
					- "."
				}
			}
			li {
				p {
					- "Replace the entry for "
					var {
						- "entry"
					}
					- " in the list with an entry for "
					var {
						- "new element"
					}
					- "."
				}
			}
			li {
				p {
					- "If the entry for "
					var {
						- "new element"
					}
					- " in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-11" {
						- "list of active formatting\n   elements"
					}
					- " is not the last entry in the list, return to the step labeled\n   "
					i {
						- "advance"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "This has the effect of reopening all the formatting elements that were opened in the current\n  body, cell, or caption (whichever is youngest) that haven't been explicitly closed."
		}
		- "\n\n  "
		p class="note" {
			- "The way this specification is written, the "
			a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-12" {
				- "list of active formatting\n  elements"
			}
			- " always consists of elements in chronological order with the least recently added\n  element first and the most recently added element last (except for while steps 7 to 10 of the\n  above algorithm are being executed, of course)."
		}
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="clear-the-list-of-active-formatting-elements-up-to-the-last-marker" {
				- "clear the list of active formatting elements up to\n  the last marker"
			}
			- ", the UA must perform the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "entry"
					}
					- " be the last (most recently added) entry in the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-13" {
						- "list of\n   active formatting elements"
					}
					- "."
				}
			}
			li {
				p {
					- "Remove "
					var {
						- "entry"
					}
					- " from the "
					a href="#list-of-active-formatting-elements" id="the-list-of-active-formatting-elements:list-of-active-formatting-elements-14" {
						- "list of active formatting\n   elements"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "entry"
					}
					- " was a "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-6" {
						- "marker"
					}
					- ",\n   then stop the algorithm at this point. The list has been cleared up to the last "
					a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker-7" {
						- "marker"
					}
					- "."
				}
			}
			li {
				p {
					- "Go to step 1."
				}
			}
		}
		- "\n\n\n  "
		h5 id="the-element-pointers" {
			span class="secno" {
				- "13.2.4.4"
			}
			- " The element pointers"
			a href="#the-element-pointers" class="self-link"
		}
		- "\n\n  "
		p {
			- "Initially, the "
			dfn id="head-element-pointer" {
				code {
					- "head"
				}
				- " element pointer"
			}
			- " and the "
			dfn id="form-element-pointer" {
				code {
					- "form"
				}
				- " element pointer"
			}
			- " are both null."
		}
		- "\n\n  "
		p {
			- "Once a "
			code id="the-element-pointers:the-head-element" {
				a href="#the-head-element" {
					- "head"
				}
			}
			- " element has been parsed (whether implicitly or explicitly) the\n  "
			a href="#head-element-pointer" id="the-element-pointers:head-element-pointer" {
				code {
					- "head"
				}
				- " element pointer"
			}
			- " gets set to point to this node."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#form-element-pointer" id="the-element-pointers:form-element-pointer" {
				code {
					- "form"
				}
				- " element pointer"
			}
			- " points to the last\n  "
			code id="the-element-pointers:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element that was opened and whose end tag has not yet been seen. It is used to\n  make form controls associate with forms in the face of dramatically bad markup, for historical\n  reasons. It is ignored inside "
			code id="the-element-pointers:the-template-element" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " elements."
		}
		- "\n\n\n  "
		h5 id="other-parsing-state-flags" {
			span class="secno" {
				- "13.2.4.5"
			}
			- " Other parsing state flags"
			a href="#other-parsing-state-flags" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="scripting-flag" {
				- "scripting flag"
			}
			- " is set to \"enabled\" if "
			a href="#concept-n-script" id="other-parsing-state-flags:concept-n-script" {
				- "scripting\n  was enabled"
			}
			- " for the "
			code id="other-parsing-state-flags:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " with which the parser is associated when the\n  parser was created, and \"disabled\" otherwise."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#scripting-flag" id="other-parsing-state-flags:scripting-flag" {
				- "scripting flag"
			}
			- " can be enabled even when the parser was created as\n  part of the "
			a href="#html-fragment-parsing-algorithm" id="other-parsing-state-flags:html-fragment-parsing-algorithm" {
				- "HTML fragment parsing algorithm"
			}
			- ", even though "
			code id="other-parsing-state-flags:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements\n  don't execute in that case."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="frameset-ok-flag" {
				- "frameset-ok flag"
			}
			- " is set to \"ok\" when the parser is created. It is set to \"not\n  ok\" after certain tokens are seen."
		}
		- "\n\n  \n\n\n  \n\n  "
		h4 id="tokenization" {
			span class="secno" {
				- "13.2.5"
			}
			- " "
			dfn {
				- "Tokenization"
			}
			a href="#tokenization" class="self-link"
		}
		- "\n\n  "
		p {
			- "Implementations must act as if they used the following state machine to tokenize HTML. The\n  state machine must start in the "
			a href="#data-state" id="tokenization:data-state" {
				- "data state"
			}
			- ". Most states consume a single character,\n  which may have various side-effects, and either switches the state machine to a new state to\n  "
			a href="#reconsume" id="tokenization:reconsume" {
				- "reconsume"
			}
			- " the "
			a href="#current-input-character" id="tokenization:current-input-character" {
				- "current input character"
			}
			- ", or switches it to a new state to\n  consume the "
			a href="#next-input-character" id="tokenization:next-input-character" {
				- "next character"
			}
			- ", or stays in the same state\n  to consume the next character. Some states have more complicated behavior and can consume several\n  characters before switching to another state. In some cases, the tokenizer state is also changed\n  by the tree construction stage."
		}
		- "\n\n  "
		p {
			- "When a state says to "
			dfn id="reconsume" {
				- "reconsume"
			}
			- " a matched character in a specified state, that means\n  to switch to that state, but when it attempts to consume the "
			a href="#next-input-character" id="tokenization:next-input-character-2" {
				- "next input character"
			}
			- ",\n  provide it with the "
			a href="#current-input-character" id="tokenization:current-input-character-2" {
				- "current input character"
			}
			- " instead."
		}
		- "\n\n  "
		p {
			- "The exact behavior of certain states depends on the "
			a href="#insertion-mode" id="tokenization:insertion-mode" {
				- "insertion mode"
			}
			- " and the\n  "
			a href="#stack-of-open-elements" id="tokenization:stack-of-open-elements" {
				- "stack of open elements"
			}
			- ". Certain states also use a "
			dfn id="temporary-buffer" {
				var {
					- "temporary buffer"
				}
			}
			- " to track progress, and the "
			a href="#character-reference-state" id="tokenization:character-reference-state" {
				- "character reference\n  state"
			}
			- " uses a "
			dfn id="return-state" {
				var {
					- "return state"
				}
			}
			- " to return to the\n  state it was invoked from."
		}
		- "\n\n  "
		p {
			- "The output of the tokenization step is a series of zero or more of the following tokens:\n  DOCTYPE, start tag, end tag, comment, character, end-of-file. DOCTYPE tokens have a name, a public\n  identifier, a system identifier, and a "
			dfn id="force-quirks-flag" {
				i {
					- "force-quirks flag"
				}
			}
			- ". When a DOCTYPE token\n  is created, its name, public identifier, and system identifier must be marked as missing (which is\n  a distinct state from the empty string), and the "
			i id="tokenization:force-quirks-flag" {
				a href="#force-quirks-flag" {
					- "force-quirks flag"
				}
			}
			- " must be set to\n  "
			i {
				- "off"
			}
			- " (its other state is "
			i {
				- "on"
			}
			- "). Start and end tag tokens have a tag name, a "
			dfn id="self-closing-flag" {
				- "self-closing flag"
			}
			- ", and a list of attributes, each of which has a\n  name and a value. When a start or end tag token is created, its "
			i id="tokenization:self-closing-flag" {
				a href="#self-closing-flag" {
					- "self-closing flag"
				}
			}
			- " must be unset (its other state is that it be set), and its attributes\n  list must be empty. Comment and character tokens have data."
		}
		- "\n\n  "
		p {
			- "When a token is emitted, it must immediately be handled by the "
			a href="#tree-construction" id="tokenization:tree-construction" {
				- "tree construction"
			}
			- "\n  stage. The tree construction stage can affect the state of the tokenization stage, and can insert\n  additional characters into the stream. (For example, the "
			code id="tokenization:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element can result in\n  scripts executing and using the "
			a href="#dynamic-markup-insertion" id="tokenization:dynamic-markup-insertion" {
				- "dynamic markup insertion"
			}
			- " APIs to insert characters\n  into the stream being tokenized.)"
		}
		- "\n\n  "
		p class="note" {
			- "Creating a token and emitting it are distinct actions. It is possible for a token\n  to be created but implicitly abandoned (never emitted), e.g. if the file ends unexpectedly while\n  processing the characters that are being parsed into a start tag token."
		}
		- "\n\n  "
		p {
			- "When a start tag token is emitted with its "
			i id="tokenization:self-closing-flag-2" {
				a href="#self-closing-flag" {
					- "self-closing flag"
				}
			}
			- " set, if the flag is not\n  "
			dfn id="acknowledge-self-closing-flag" {
				- "acknowledged"
			}
			- " when it is processed by the tree\n  construction stage, that is a "
			a href="#parse-error-non-void-html-element-start-tag-with-trailing-solidus" id="tokenization:parse-error-non-void-html-element-start-tag-with-trailing-solidus" {
				- "non-void-html-element-start-tag-with-trailing-solidus"
			}
			- "\n  "
			a href="#parse-errors" id="tokenization:parse-errors" {
				- "parse error"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an end tag token is emitted with attributes, that is an "
			a href="#parse-error-end-tag-with-attributes" id="tokenization:parse-error-end-tag-with-attributes" {
				- "end-tag-with-attributes"
			}
			- " "
			a href="#parse-errors" id="tokenization:parse-errors-2" {
				- "parse\n  error"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an end tag token is emitted with its "
			i id="tokenization:self-closing-flag-3" {
				a href="#self-closing-flag" {
					- "self-closing flag"
				}
			}
			- "\n  set, that is an "
			a href="#parse-error-end-tag-with-trailing-solidus" id="tokenization:parse-error-end-tag-with-trailing-solidus" {
				- "end-tag-with-trailing-solidus"
			}
			- "\n  "
			a href="#parse-errors" id="tokenization:parse-errors-3" {
				- "parse error"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="appropriate-end-tag-token" {
				- "appropriate end tag token"
			}
			- " is an end tag token whose tag name matches the tag name\n  of the last start tag to have been emitted from this tokenizer, if any. If no start tag has been\n  emitted from this tokenizer, then no end tag token is appropriate."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#syntax-charref" id="tokenization:syntax-charref" {
				- "character reference"
			}
			- " is said to be "
			dfn id="charref-in-attribute" {
				- "consumed as part of an attribute"
			}
			- " if the "
			var id="tokenization:return-state" {
				a href="#return-state" {
					- "return state"
				}
			}
			- " is either "
			a href="#attribute-value-(double-quoted)-state" id="tokenization:attribute-value-(double-quoted)-state" {
				- "attribute value (double-quoted) state"
			}
			- ",\n  "
			a href="#attribute-value-(single-quoted)-state" id="tokenization:attribute-value-(single-quoted)-state" {
				- "attribute value (single-quoted) state"
			}
			- ", or "
			a href="#attribute-value-(unquoted)-state" id="tokenization:attribute-value-(unquoted)-state" {
				- "attribute value (unquoted)\n  state"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When a state says to "
			dfn id="flush-code-points-consumed-as-a-character-reference" {
				- "flush code points consumed as a character reference"
			}
			- ", it means\n  that for each "
			a id="tokenization:code-point" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
				- "code point"
			}
			- " in the "
			var id="tokenization:temporary-buffer" {
				a href="#temporary-buffer" {
					- "temporary\n  buffer"
				}
			}
			- " (in the order they were added to the buffer) user agent must append the code point\n  from the buffer to the current attribute's value if the character reference was "
			a href="#charref-in-attribute" id="tokenization:charref-in-attribute" {
				- "consumed as part of an attribute"
			}
			- ", or emit the code point as a\n  character token otherwise."
		}
		- "\n\n  "
		p id="check-parser-pause-flag" {
			- "Before each step of the tokenizer, the user agent must first check\n  the "
			a href="#parser-pause-flag" id="tokenization:parser-pause-flag" {
				- "parser pause flag"
			}
			- ". If it is true, then the tokenizer must abort the processing of\n  any nested invocations of the tokenizer, yielding control back to the caller."
		}
		- "\n\n  "
		p {
			- "The tokenizer state machine consists of the states defined in the following subsections."
		}
		- "\n\n\n  \n\n\n  "
		h5 id="data-state" {
			span class="secno" {
				- "13.2.5.1"
			}
			- " "
			dfn {
				- "Data state"
			}
			a href="#data-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="data-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
