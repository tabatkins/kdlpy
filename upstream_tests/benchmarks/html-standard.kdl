		}
		- "\n\n\n  "
		h5 id="event-loop-processing-model" data-dfn-type="dfn" data-lt="event loop processing model" {
			span class="secno" {
				- "8.1.7.3"
			}
			- " "
			span id="processing-model-8"
			- "Processing model"
			a href="#event-loop-processing-model" class="self-link"
