		- "\n\n  "
		h4 id="server-sent-events-intro" {
			span class="secno" {
				- "9.2.1"
			}
			- " Introduction"
			a href="#server-sent-events-intro" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "To enable servers to push data to web pages over HTTP or using dedicated server-push protocols,\n  this specification introduces the "
			code id="server-sent-events-intro:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " interface."
		}
		- "\n\n  "
		p {
			- "Using this API consists of creating an "
			code id="server-sent-events-intro:eventsource-2" {
				a href="#eventsource" {
