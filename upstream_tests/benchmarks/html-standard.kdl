			- " element is an "
			a id="the-select-element-2:element-with-default-preferred-size" href="https://drafts.csswg.org/css-ui/#element-with-default-preferred-size" data-x-internal="element-with-default-preferred-size" {
				- "element with default preferred size"
			}
			- ", and\n  user agents are expected to apply the "
			a id="the-select-element-2:'field-sizing'" href="https://drafts.csswg.org/css-ui/#field-sizing" data-x-internal="'field-sizing'" {
				- "'field-sizing'"
			}
			- " CSS property to\n  "
