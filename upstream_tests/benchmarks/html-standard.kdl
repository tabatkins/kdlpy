			}
			- "\n  "
			var {
				- "navigationParams"
			}
			- " and a string "
			var {
				- "type"
			}
			- ", user agents must follow the\n  requirements defined in "
			cite {
				- "XML"
			}
			- " and "
			cite {
				- "Namespaces in XML"
			}
			- ", "
			cite {
				- "XML Media\n  Types"
			}
			- ", "
			cite {
				- "DOM"
			}
			- ", and other relevant specifications to "
			a href="#initialise-the-document-object" id="read-xml:initialise-the-document-object" {
				- "create and initialize a "
				code {
					- "Document"
