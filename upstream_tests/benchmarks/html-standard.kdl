						- "cite"
					}
				}
				- ";\n  ["
				a href="#cereactions" id="attributes-common-to-ins-and-del-elements:cereactions-2" {
					c- g="" {
						- "CEReactions"
					}
				}
				- "] "
				c- b="" {
					- "attribute"
