			- "\n\n   "
			p {
				- "On one user agent, the button's label might become \""
				samp {
					- "Compose (⌘N)"
				}
				- "\". On\n   another, it might become \""
				samp {
					- "Compose (Alt+⇧+1)"
				}
				- "\". If the user agent doesn't\n   assign a key, it will be just \""
				samp {
					- "Compose"
				}
				- "\". The exact string depends on what the\n   "
				a href="#assigned-access-key" id="the-accesskey-attribute:assigned-access-key" {
					- "assigned access key"
				}
				- " is, and on how the user agent represents that key\n   combination."
			}
			- "\n\n  "
