							td {
								- "zh-Hans, zh-CN, zh-SG\n       "
							}
							td {
								- "Chinese, Simplified\n       "
							}
							td {
								a id="determining-the-character-encoding:gbk" href="https://encoding.spec.whatwg.org/#gbk" data-x-internal="gbk" {
									- "GBK"
								}
								- " \n\n      "
							}
						}
						tr {
							td {
								- "zh-Hant, zh-HK, zh-MO, zh-TW\n       "
							}
							td {
								- "Chinese, Traditional\n       "
							}
							td {
								a id="determining-the-character-encoding:big5" href="https://encoding.spec.whatwg.org/#big5" data-x-internal="big5" {
									- "Big5"
								}
								- " \n\n      \n\n      "
