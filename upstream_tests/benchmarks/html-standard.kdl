				}
			}
			- " has a "
			dfn id="completely-loaded-time" {
				- "completely loaded time"
			}
			- " (a time or null), which is\n  initially null."
		}
		- "\n\n  "
		p {
			- "A "
			code id="loading-documents:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " is considered "
			dfn id="completely-loaded" {
				- "completely loaded"
			}
			- " if its "
			a href="#completely-loaded-time" id="loading-documents:completely-loaded-time" {
				- "completely\n  loaded time"
			}
			- " is non-null.\n\n  "
		}
		p {
			- "To "
			dfn id="completely-finish-loading" {
				- "completely finish loading"
			}
			- " a "
			code id="loading-documents:document-3" {
