						- "host"
					}
					- "'s "
					a id="sites:registrable-domain" href="https://url.spec.whatwg.org/#host-registrable-domain" data-x-internal="registrable-domain" {
						- "registrable\n   domain"
					}
					- " is null, then return ("
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-scheme" id="sites:concept-origin-scheme" {
						- "scheme"
					}
					- ", "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-host" id="sites:concept-origin-host-2" {
						- "host"
					}
					- ")."
				}
			}
			li {
				p {
					- "Return ("
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-scheme" id="sites:concept-origin-scheme-2" {
						- "scheme"
					}
					- ",\n   "
					var {
