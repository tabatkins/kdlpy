						}
						span {
							- "No"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink no" {
						span {
							- "Edge"
						}
						span {
							- "No"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
