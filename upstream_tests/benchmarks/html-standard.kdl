		- "\n\n  "
		p {
			- "Authors can use the "
			code id="the-i-element:classes" {
				a href="#classes" {
					- "class"
				}
			}
			- " attribute on the "
			code id="the-i-element:the-i-element-4" {
				a href="#the-i-element" {
					- "i"
				}
			}
			- "\n  element to identify why the element is being used, so that if the style of a particular use (e.g.\n  dream sequences as opposed to taxonomic terms) is to be changed at a later date, the author\n  doesn't have to go through the entire document (or series of related documents) annotating each\n  use."
		}
		- "\n\n  "
		p {
			- "Authors are encouraged to consider whether other elements might be more applicable than the\n  "
			code id="the-i-element:the-i-element-5" {
