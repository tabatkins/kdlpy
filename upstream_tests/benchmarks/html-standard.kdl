							a href="#the-a-element" {
								- "a"
							}
						}
						- " and "
						code id="linkTypes:the-area-element-2" {
							a href="#the-area-element" {
								- "area"
							}
						}
					}
					th {
						code id="linkTypes:the-form-element-2" {
							a href="#the-form-element" {
								- "form"
							}
						}
					}
				}
			}
			tbody {
				tr {
					td {
						code id="linkTypes:rel-alternate" {
							a href="#rel-alternate" {
								- "alternate"
							}
						}
					}
					td colspan="2" {
						a href="#hyperlink" id="linkTypes:hyperlink" {
							- "Hyperlink"
						}
					}
					td {
						em {
							- "not allowed"
						}
					}
					td class="no" {
						- " · "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Gives alternate representations of the current document."
					}
				}
				tr {
					td {
						code id="linkTypes:link-type-canonical" {
							a href="#link-type-canonical" {
								- "canonical"
							}
						}
					}
					td {
						a href="#hyperlink" id="linkTypes:hyperlink-2" {
							- "Hyperlink"
						}
					}
					td colspan="2" {
						em {
							- "not allowed"
						}
					}
					td class="no" {
						- " · "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Gives the preferred URL for the current document."
					}
				}
				tr {
					td {
						code id="linkTypes:link-type-author" {
							a href="#link-type-author" {
								- "author"
							}
						}
					}
					td colspan="2" {
						a href="#hyperlink" id="linkTypes:hyperlink-3" {
							- "Hyperlink"
						}
					}
					td {
						em {
							- "not allowed"
						}
					}
					td class="no" {
						- " · "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Gives a link to the author of the current document or article."
					}
				}
				tr {
					td {
						code id="linkTypes:link-type-bookmark" {
							a href="#link-type-bookmark" {
								- "bookmark"
							}
						}
					}
					td {
						em {
							- "not allowed"
						}
					}
					td {
						a href="#hyperlink" id="linkTypes:hyperlink-4" {
							- "Hyperlink"
						}
					}
					td {
						em {
							- "not allowed"
						}
					}
					td class="no" {
						- " · "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Gives the permalink for the nearest ancestor section."
					}
				}
				tr {
					td {
						code id="linkTypes:link-type-dns-prefetch-2" {
							a href="#link-type-dns-prefetch" {
								- "dns-prefetch"
							}
						}
					}
					td {
						a href="#external-resource-link" id="linkTypes:external-resource-link" {
							- "External Resource"
						}
					}
					td colspan="2" {
						em {
							- "not allowed"
						}
					}
					td class="yes" {
						- " Yes "
					}
					td class="no" {
						- " · "
					}
					td {
						- "Specifies that the user agent should preemptively perform DNS resolution for the target resource's "
						a href="#concept-origin" id="linkTypes:concept-origin" {
							- "origin"
						}
						- "."
					}
				}
				tr {
					td {
						code id="linkTypes:link-type-expect" {
