						- "hanging\n   baseline"
					}
					- " of the "
					a id="drawing-text-to-the-bitmap:inline-box-6" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
						- "inline box"
					}
					- ", in "
