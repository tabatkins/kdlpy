			- ".\n  The "
			a id="the-select-element-2:inline-size-2" href="https://drafts.csswg.org/css-writing-modes/#inline-size" data-x-internal="inline-size" {
				- "inline size"
			}
			- " of its "
			a id="the-select-element-2:intrinsic-size-3" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " is the\n  "
			a href="#width-of-the-select's-labels" id="the-select-element-2:width-of-the-select's-labels-2" {
				- "width of the "
				code {
					- "select"
				}
				- "'s labels"
			}
			- ". If the "
			a id="the-select-element-2:'field-sizing'-3" href="https://drafts.csswg.org/css-ui/#field-sizing" data-x-internal="'field-sizing'" {
				- "'field-sizing'"
			}
			- "\n  property on the element has a "
			a id="the-select-element-2:computed-value-2" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- " of\n  "
			a href="https://drafts.csswg.org/css-ui/#valdef-field-sizing-content" id="the-select-element-2:field-sizing-content-2" data-x-internal="field-sizing-content" {
				- "'content'"
			}
			- ", the "
