			li {
				p {
					- "Perform ! "
					var {
						- "location"
					}
					- ".[[DefineOwnProperty]](\""
					code {
						- "valueOf"
					}
					- "\", {\n   [[Value]]: "
					var {
						- "valueOf"
					}
					- ",\n   [[Writable]]: false,\n   [[Enumerable]]: false,\n   [[Configurable]]: false })."
				}
			}
			li {
				p {
					- "Perform ! "
					var {
						- "location"
					}
					- ".[[DefineOwnProperty]]("
					a href="#symbol.toprimitive" id="the-location-interface:symbol.toprimitive" {
						- "%Symbol.toPrimitive%"
					}
					- ", {\n   [[Value]]: undefined,\n   [[Writable]]: false,\n   [[Enumerable]]: false,\n   [[Configurable]]: false })."
				}
			}
			li {
				p {
					- "Set the value of the "
					a href="#defaultproperties" id="the-location-interface:defaultproperties" {
						- "[[DefaultProperties]]"
					}
					- " internal slot of\n   "
					var {
						- "location"
					}
					- " to "
					var {
						- "location"
					}
					- ".[[OwnPropertyKeys]]()."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "location"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The addition of "
			code {
				- "valueOf"
			}
			- " and "
			a href="#symbol.toprimitive" id="the-location-interface:symbol.toprimitive-2" {
				- "%Symbol.toPrimitive%"
			}
			- " own\n  data properties, as well as the fact that all of "
			code id="the-location-interface:location-6" {
