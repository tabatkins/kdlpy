		}
		- "\n\n  "
		p {
			- "On setting, if the new value isn't equal to what the attribute would currently return, the new\n  value must be processed as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the new value is \""
				code id="text-track-api:dom-texttrack-disabled-3" {
					a href="#dom-texttrack-disabled" {
