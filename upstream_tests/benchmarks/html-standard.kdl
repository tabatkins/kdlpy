					}
					- " set, then return true."
				}
			}
			li {
				p {
					- "If "
					var {
						- "window"
					}
					- "'s "
					a href="#relevant-settings-object" id="simple-dialogs:relevant-settings-object" {
						- "relevant settings object"
					}
					- "'s "
					a href="#concept-settings-object-origin" id="simple-dialogs:concept-settings-object-origin" {
						- "origin"
					}
