					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
						- ");"
					}
					- "\ncanvas"
					c- p="" {
						- "."
					}
					- "setAttribute"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'width'"
					}
					c- p="" {
						- ","
					}
					- " "
					c- t="" {
						- "'300'"
					}
					c- p="" {
						- ");"
					}
					- " "
					c- c1="" {
						- "// clears the canvas"
					}
					- "\ncontext"
					c- p="" {
						- "."
					}
					- "fillRect"
					c- p="" {
						- "("
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "100"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
						- ");"
					}
					- "\ncanvas"
					c- p="" {
						- "."
					}
					- "width "
					c- o="" {
						- "="
					}
					- " canvas"
					c- p="" {
						- "."
					}
					- "width"
					c- p="" {
						- ";"
					}
					- " "
					c- c1="" {
						- "// clears the canvas"
					}
					- "\ncontext"
					c- p="" {
						- "."
					}
					- "fillRect"
					c- p="" {
						- "("
					}
					c- mf="" {
						- "100"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
						- ","
					}
					c- mf="" {
						- "50"
					}
					c- p="" {
