		}
		- "\n\n  "
		p {
			- "In this example, the \""
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:attr-fe-autocomplete-section" {
				a href="#attr-fe-autocomplete-section" {
					- "section-*"
				}
			}
			- "\" keywords in\n  the "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:attr-fe-autocomplete-6" {
				a href="#attr-fe-autocomplete" {
					- "autocomplete"
				}
			}
			- " attributes' values tell the user agent\n  that the two fields expect "
			em {
				- "different"
			}
			- " names. Without them, the user agent could\n  automatically fill the second field with the value given in the first field when the user gave a\n  value to the first field."
		}
		- "\n\n  "
		p class="note" {
			- "The \""
			code {
				- "-jp"
			}
			- "\" and \""
			code {
				- "-en"
			}
			- "\" parts of the\n  keywords are opaque to the user agent; the user agent cannot guess, from those, that the two names\n  are expected to be in Japanese and English respectively."
		}
		- "\n\n  "
		p {
			- "Separate from the choices regarding "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:attr-input-type-3" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " and "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:attr-fe-autocomplete-7" {
				a href="#attr-fe-autocomplete" {
					- "autocomplete"
				}
			}
			- ", the "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:attr-inputmode-2" {
				a href="#attr-inputmode" {
					- "inputmode"
				}
			}
			- " attribute decides what kind of input modality (e.g.,\n  virtual keyboard) to use, when the control is a text control."
		}
		- "\n\n  "
		p {
			- "Consider credit card numbers. The appropriate input type is "
			em {
				- "not"
			}
			- " "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:number-state-(type=number)" {
				a href="#number-state-(type=number)" {
					- "<input type=number>"
				}
			}
			- ", "
			a href="#when-number-is-not-appropriate" {
				- "as explained below"
			}
			- "; it is instead "
			code id="the-difference-between-the-field-type,-the-autofill-field-name,-and-the-input-modality:text-(type=text)-state-and-search-state-(type=search)-3" {
				a href="#text-(type=text)-state-and-search-state-(type=search)" {
					- "<input type=text>"
				}
			}
			- ". To encourage the user agent to use a\n  numeric input modality anyway (e.g., a virtual keyboard displaying only digits), the page would\n  use"
		}
		- "\n\n  "
		pre {
			code class="html" {
				c- p="" {
					- "<"
				}
				c- f="" {
					- "p"
				}
				c- p="" {
					- "><"
				}
				c- f="" {
					- "label"
				}
				c- p="" {
					- ">"
				}
				- "Credit card number:\n                "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "name"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"cc\""
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"text\""
				}
				- " "
				c- e="" {
					- "inputmode"
				}
				c- o="" {
					- "="
				}
				c- s="" {
