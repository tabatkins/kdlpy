									- "reporting"
								}
								- "\""
							}
						}
						tr {
							td {
								- "effectivePolicy"
							}
							td {
								var {
									- "coop"
								}
								- "'s "
								a href="#coop-struct-report-only-value" id="coop-reporting:coop-struct-report-only-value-9" {
									- "report-only\n       value"
								}
							}
						}
						tr {
							td {
								- "property"
							}
							td {
								var {
									- "propertyName"
								}
							}
						}
						tr {
							td {
								- "otherURL"
							}
							td {
								- "If "
								var {
									- "coopOrigin"
								}
								- " and "
								var {
									- "otherOrigin"
								}
								- " are "
								a href="#same-origin" id="coop-reporting:same-origin-12" {
									- "same origin"
								}
								- ", this\n       is the "
								a href="#sanitize-url-report" id="coop-reporting:sanitize-url-report-10" {
									- "sanitization"
								}
								- " of "
								var {
									- "otherURL"
								}
								- ", null\n       otherwise."
							}
						}
						tr {
							td {
								- "type"
							}
							td {
								code {
									- "access-to-opener"
								}
							}
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					a href="https://w3c.github.io/reporting/#queue-report" id="coop-reporting:queue-a-report-8" data-x-internal="queue-a-report" {
						- "Queue"
					}
					- " "
					var {
						- "body"
					}
					- " as \""
					code {
						- "coop"
					}
					- "\"\n   for "
					var {
						- "coop"
					}
					- "'s "
					a href="#coop-struct-report-endpoint" id="coop-reporting:coop-struct-report-endpoint-14" {
						- "reporting endpoint"
					}
					- " with\n   "
					var {
						- "coopURL"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h4 id="coep" {
			span class="secno" {
				- "7.1.4"
			}
			- " Cross-origin embedder policies"
			a href="#coep" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Cross-Origin-Embedder-Policy" title="The HTTP Cross-Origin-Embedder-Policy (COEP) response header configures embedding cross-origin resources into the document." {
						- "Headers/Cross-Origin-Embedder-Policy"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "79+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "15.2+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "83+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "83+"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android yes" {
						span {
							- "WebView Android"
						}
						span {
							- "86+"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="embedder-policy-value" data-export="" {
				- "embedder policy value"
			}
			- " is one of three strings that controls the fetching\n  of cross-origin resources without explicit permission from resource owners."
		}
		- "\n\n  "
		dl {
			dt {
				- "\""
				dfn data-dfn-for="embedder policy value" id="coep-unsafe-none" data-export="" {
					code {
						- "unsafe-none"
					}
				}
				- "\""
			}
			dd {
				p {
					- "This is the default value. When this value is used, cross-origin resources can be fetched\n   without giving explicit permission through the "
					a id="coep:cors-protocol" href="https://fetch.spec.whatwg.org/#http-cors-protocol" data-x-internal="cors-protocol" {
						- "CORS protocol"
					}
					- " or the\n   `"
					code id="coep:cross-origin-resource-policy" {
						a data-x-internal="cross-origin-resource-policy" href="https://fetch.spec.whatwg.org/#http-cross-origin-resource-policy" {
							- "Cross-Origin-Resource-Policy"
						}
					}
					- "` header."
				}
			}
			dt {
				- "\""
				dfn data-dfn-for="embedder policy value" id="coep-require-corp" data-export="" {
					code {
						- "require-corp"
					}
				}
				- "\""
			}
			dd {
				p {
					- "When this value is used, fetching cross-origin resources requires the server's\n   explicit permission through the "
					a id="coep:cors-protocol-2" href="https://fetch.spec.whatwg.org/#http-cors-protocol" data-x-internal="cors-protocol" {
						- "CORS protocol"
					}
					- " or the\n   `"
					code id="coep:cross-origin-resource-policy-2" {
						a data-x-internal="cross-origin-resource-policy" href="https://fetch.spec.whatwg.org/#http-cross-origin-resource-policy" {
							- "Cross-Origin-Resource-Policy"
						}
					}
					- "` header."
				}
			}
			dt {
				- "\""
				dfn data-dfn-for="embedder policy value" id="coep-credentialless" data-export="" {
					code {
						- "credentialless"
					}
				}
				- "\""
			}
			dd {
				p {
					- "When this value is used, fetching cross-origin no-CORS resources omits credentials. In\n   exchange, an explicit `"
					code id="coep:cross-origin-resource-policy-3" {
						a data-x-internal="cross-origin-resource-policy" href="https://fetch.spec.whatwg.org/#http-cross-origin-resource-policy" {
							- "Cross-Origin-Resource-Policy"
						}
					}
					- "` header is not required. Other\n   requests sent with credentials require the server's explicit permission through the "
					a id="coep:cors-protocol-3" href="https://fetch.spec.whatwg.org/#http-cors-protocol" data-x-internal="cors-protocol" {
						- "CORS\n   protocol"
					}
					- " or the `"
					code id="coep:cross-origin-resource-policy-4" {
						a data-x-internal="cross-origin-resource-policy" href="https://fetch.spec.whatwg.org/#http-cross-origin-resource-policy" {
							- "Cross-Origin-Resource-Policy"
						}
					}
					- "` header."
				}
			}
		}
		- "\n\n  "
		div class="warning" {
			- "\n   "
			p {
				- "Before supporting \""
				code id="coep:coep-credentialless" {
					a href="#coep-credentialless" {
						- "credentialless"
					}
				}
				- "\", implementers are\n   strongly encouraged to support both:\n\n   "
			}
			ul class="brief" {
				li {
					a href="https://wicg.github.io/private-network-access/" {
						- "Private Network Access"
					}
				}
				li {
					a href="https://github.com/annevk/orb" {
						- "Opaque Response Blocking"
					}
				}
			}
			- "\n\n   "
			p {
				- "Otherwise, it would allow attackers to leverage the client's network position to read non\n   public resources, using the "
				a href="#concept-settings-object-cross-origin-isolated-capability" id="coep:concept-settings-object-cross-origin-isolated-capability" {
					- "cross-origin isolated\n   capability"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			- "An "
			a href="#embedder-policy-value" id="coep:embedder-policy-value" {
				- "embedder policy value"
			}
			- " is "
			dfn id="compatible-with-cross-origin-isolation" {
				- "compatible with cross-origin isolation"
			}
			- " if\n  it is \""
			code id="coep:coep-credentialless-2" {
				a href="#coep-credentialless" {
					- "credentialless"
				}
			}
			- "\" or \""
			code id="coep:coep-require-corp" {
				a href="#coep-require-corp" {
					- "require-corp"
				}
			}
			- "\"."
		}
		- "\n\n  \n\n  "
		p {
			- "An "
			dfn id="embedder-policy" data-export="" {
				- "embedder policy"
			}
			- " consists of:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					dfn data-dfn-for="embedder policy" id="embedder-policy-value-2" data-export="" {
						- "value"
					}
					- ", which is an "
					a href="#embedder-policy-value" id="coep:embedder-policy-value-2" {
						- "embedder policy value"
					}
					- ", initially \""
					code id="coep:coep-unsafe-none" {
						a href="#coep-unsafe-none" {
							- "unsafe-none"
						}
					}
					- "\"."
				}
			}
			li {
				p {
					- "A "
					dfn data-dfn-for="embedder policy" id="embedder-policy-reporting-endpoint" data-export="" {
						- "reporting endpoint"
					}
					- " string, initially the empty string."
				}
			}
			li {
				p {
					- "A "
					dfn data-dfn-for="embedder policy" id="embedder-policy-report-only-value" data-export="" {
						- "report only value"
					}
					- ", which is an "
					a href="#embedder-policy-value" id="coep:embedder-policy-value-3" {
						- "embedder policy value"
					}
					- ", initially\n   \""
					code id="coep:coep-unsafe-none-2" {
						a href="#coep-unsafe-none" {
							- "unsafe-none"
						}
					}
					- "\"."
				}
			}
			li {
				p {
					- "A "
					dfn data-dfn-for="embedder\n   policy" id="embedder-policy-report-only-reporting-endpoint" data-export="" {
						- "report only reporting endpoint"
					}
					- " string, initially the empty\n   string."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="coep-report-type" data-export="" {
				- "\""
				code {
					- "coep"
				}
				- "\" report type"
			}
			- " is a "
			a id="coep:report-type" href="https://w3c.github.io/reporting/#report-type" data-x-internal="report-type" {
				- "report type"
			}
			- " whose value\n  is \""
			code {
				- "coep"
			}
			- "\". It is "
			a id="coep:visible-to-reportingobservers" href="https://w3c.github.io/reporting/#visible-to-reportingobservers" data-x-internal="visible-to-reportingobservers" {
				- "visible to\n  "
				code {
					- "ReportingObserver"
				}
				- "s"
			}
			- "."
		}
		- "\n\n  \n\n\n  "
		h5 id="the-coep-headers" {
			span class="secno" {
				- "7.1.4.1"
			}
			- " The headers"
			a href="#the-coep-headers" class="self-link"
		}
		- "\n\n  "
		p {
			- "The `"
			dfn id="cross-origin-embedder-policy" data-dfn-type="http-header" {
				code {
					- "Cross-Origin-Embedder-Policy"
				}
			}
			- "` and\n  `"
			dfn id="cross-origin-embedder-policy-report-only" data-dfn-type="http-header" {
				code {
					- "Cross-Origin-Embedder-Policy-Report-Only"
				}
			}
			- "` HTTP response\n  headers allow a server to declare an "
			a href="#embedder-policy" id="the-coep-headers:embedder-policy" {
				- "embedder policy"
			}
			- " for an "
			a href="#environment-settings-object" id="the-coep-headers:environment-settings-object" {
				- "environment\n  settings object"
			}
			- ". These headers are "
			a href="https://httpwg.org/specs/rfc8941.html" id="the-coep-headers:http-structured-header" data-x-internal="http-structured-header" {
				- "structured\n  headers"
			}
			- " whose values must be "
			a href="https://httpwg.org/specs/rfc8941.html#token" id="the-coep-headers:http-structured-header-token" data-x-internal="http-structured-header-token" {
				- "token"
			}
			- ".\n  "
			a href="#refsSTRUCTURED-FIELDS" {
				- "[STRUCTURED-FIELDS]"
			}
			- "\n\n  "
		}
		p {
			- "The valid "
			a href="https://httpwg.org/specs/rfc8941.html#token" id="the-coep-headers:http-structured-header-token-2" data-x-internal="http-structured-header-token" {
				- "token"
			}
			- " values are the "
			a href="#embedder-policy-value" id="the-coep-headers:embedder-policy-value" {
				- "embedder policy values"
			}
			- ". The token may also have attached "
			a href="https://httpwg.org/specs/rfc8941.html#param" id="the-coep-headers:http-structured-header-parameters" data-x-internal="http-structured-header-parameters" {
				- "parameters"
			}
			- "; of these, the \""
			dfn id="coep-report-to" {
				code {
					- "report-to"
				}
			}
			- "\" parameter can have a "
			a id="the-coep-headers:valid-url-string" href="https://url.spec.whatwg.org/#valid-url-string" data-x-internal="valid-url-string" {
				- "valid URL\n  string"
			}
			- " identifying an appropriate reporting endpoint. "
			a href="#refsREPORTING" {
				- "[REPORTING]"
			}
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "The "
				a href="#obtain-an-embedder-policy" id="the-coep-headers:obtain-an-embedder-policy" {
					- "processing model"
				}
				- " fails open (by defaulting\n   to \""
				code id="the-coep-headers:coep-unsafe-none" {
					a href="#coep-unsafe-none" {
						- "unsafe-none"
					}
				}
				- "\") in the presence of a header that cannot\n   be parsed as a token. This includes inadvertent lists created by combining multiple instances of\n   the `"
				code id="the-coep-headers:cross-origin-embedder-policy" {
					a href="#cross-origin-embedder-policy" {
						- "Cross-Origin-Embedder-Policy"
					}
				}
				- "` header present in a given response:"
			}
			- "\n\n   "
			table class="data" {
				thead {
					tr {
						th {
							- "`"
							code id="the-coep-headers:cross-origin-embedder-policy-2" {
								a href="#cross-origin-embedder-policy" {
									- "Cross-Origin-Embedder-Policy"
								}
							}
							- "`"
						}
						th {
							- "Final "
							a href="#embedder-policy-value" id="the-coep-headers:embedder-policy-value-2" {
								- "embedder policy value"
							}
						}
					}
				}
				tbody {
					tr {
						td {
							em {
								- "No header delivered"
							}
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-2" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "require-corp"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-require-corp" {
								a href="#coep-require-corp" {
									- "require-corp"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "unknown-value"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-3" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "require-corp, unknown-value"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-4" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "unknown-value, unknown-value"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-5" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "unknown-value, require-corp"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-6" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
					tr {
						td {
							- "`"
							code {
								- "require-corp, require-corp"
							}
							- "`"
						}
						td {
							- "\""
							code id="the-coep-headers:coep-unsafe-none-7" {
								a href="#coep-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\""
						}
					}
				}
			}
			- "\n\n   "
			p {
				- "(The same applies to `"
				code id="the-coep-headers:cross-origin-embedder-policy-report-only" {
					a href="#cross-origin-embedder-policy-report-only" {
						- "Cross-Origin-Embedder-Policy-Report-Only"
					}
				}
				- "`.)"
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "To "
			dfn id="obtain-an-embedder-policy" data-export="" {
				- "obtain an embedder policy"
			}
			- " from a "
			a href="https://fetch.spec.whatwg.org/#concept-response" id="the-coep-headers:concept-response" data-x-internal="concept-response" {
				- "response"
			}
			- " "
			var {
				- "response"
			}
			- " and an "
			a href="#environment" id="the-coep-headers:environment" {
				- "environment"
			}
			- "\n  "
			var {
				- "environment"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "policy"
					}
					- " be a new "
					a href="#embedder-policy" id="the-coep-headers:embedder-policy-2" {
						- "embedder policy"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "environment"
					}
					- " is a "
					a href="#non-secure-context" id="the-coep-headers:non-secure-context" {
						- "non-secure context"
					}
					- ", then return\n   "
					var {
						- "policy"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "parsedItem"
					}
					- " be the result of "
					a id="the-coep-headers:getting-a-structured-field-value" href="https://fetch.spec.whatwg.org/#concept-header-list-get-structured-header" data-x-internal="getting-a-structured-field-value" {
						- "getting a structured field value"
					}
					- "\n   with `"
