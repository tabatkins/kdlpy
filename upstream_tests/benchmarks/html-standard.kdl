		- "\n\n  "
		p {
			- "To "
			dfn id="show-the-picker,-if-applicable" {
				- "show the picker, if applicable"
			}
			- " for an "
			code id="common-input-element-apis:the-input-element-11" {
				a href="#the-input-element" {
					- "input"
