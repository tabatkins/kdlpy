		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="terminate-a-worker" data-export="" {
				- "terminate a worker"
			}
			- " it must run the following steps\n  "
			a href="#in-parallel" id="worker-processing-model:in-parallel" {
				- "in parallel"
			}
			- " with the worker's main loop (the \""
			a href="#run-a-worker" id="worker-processing-model:run-a-worker" {
				- "run a worker"
			}
			- "\" processing\n  model defined above):"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set the worker's "
					code id="worker-processing-model:workerglobalscope" {
						a href="#workerglobalscope" {
							- "WorkerGlobalScope"
						}
					}
					- " object's "
					a href="#dom-workerglobalscope-closing" id="worker-processing-model:dom-workerglobalscope-closing-5" {
						- "closing"
					}
					- " flag to true."
				}
			}
			li {
				p {
					- "If there are any "
					a href="#concept-task" id="worker-processing-model:concept-task-2" {
						- "tasks"
					}
					- " queued in the\n   "
					code id="worker-processing-model:workerglobalscope-2" {
						a href="#workerglobalscope" {
							- "WorkerGlobalScope"
						}
					}
					- " object's "
					a href="#relevant-agent" id="worker-processing-model:relevant-agent" {
						- "relevant agent"
					}
					- "'s "
					a href="#concept-agent-event-loop" id="worker-processing-model:concept-agent-event-loop" {
						- "event loop"
					}
					- "'s "
					a href="#task-queue" id="worker-processing-model:task-queue" {
						- "task\n   queues"
					}
					- ", discard them without processing them."
				}
			}
			li {
				p {
					a href="#abort-a-running-script" id="worker-processing-model:abort-a-running-script-3" {
						- "Abort the script"
					}
					- " currently running in the\n   worker."
				}
			}
			li {
				p {
					- "If the worker's "
					code id="worker-processing-model:workerglobalscope-3" {
						a href="#workerglobalscope" {
							- "WorkerGlobalScope"
						}
					}
					- " object is actually a\n   "
					code id="worker-processing-model:dedicatedworkerglobalscope-3" {
						a href="#dedicatedworkerglobalscope" {
							- "DedicatedWorkerGlobalScope"
						}
					}
					- " object (i.e. the worker is a dedicated worker), then\n   empty the "
					a href="#port-message-queue" id="worker-processing-model:port-message-queue-3" {
						- "port message queue"
					}
					- " of the port that the worker's implicit port is\n   entangled with."
				}
			}
		}
		- "\n\n  "
		p {
			- "User agents may invoke the "
			a href="#terminate-a-worker" id="worker-processing-model:terminate-a-worker-3" {
				- "terminate a worker"
			}
			- " algorithm when a worker stops being\n  an "
			a href="#active-needed-worker" id="worker-processing-model:active-needed-worker" {
				- "active needed worker"
			}
			- " and the worker continues executing even after its "
			a href="#dom-workerglobalscope-closing" id="worker-processing-model:dom-workerglobalscope-closing-6" {
				- "closing"
			}
			- " flag was set to true."
		}
		- "\n\n  \n\n\n  "
		h4 id="runtime-script-errors-2" {
			span class="secno" {
				- "10.2.5"
			}
			- " Runtime script errors"
			a href="#runtime-script-errors-2" class="self-link"
		}
		- "\n\n  "
		p {
			- "Whenever an uncaught runtime script error occurs in one of the worker's scripts, if the error\n  did not occur while handling a previous script error, the user agent will "
			a href="#report-an-exception" id="runtime-script-errors-2:report-an-exception" {
				- "report"
			}
			- " it for the worker's "
			code id="runtime-script-errors-2:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object."
		}
		- "\n\n\n  "
		h4 id="creating-workers" {
			span class="secno" {
				- "10.2.6"
			}
			- " Creating workers"
			a href="#creating-workers" class="self-link"
		}
		- "\n\n  "
		h5 id="the-abstractworker-mixin" {
			span class="secno" {
				- "10.2.6.1"
			}
			- " "
			span id="the-abstractworker-abstract-interface"
			- "The\n  "
			code id="the-abstractworker-mixin:abstractworker" {
				a href="#abstractworker" {
					- "AbstractWorker"
				}
			}
			- " mixin"
			a href="#the-abstractworker-mixin" class="self-link"
		}
		- "\n  \n\n  "
		pre {
			code class="idl" {
				c- b="" {
					- "interface"
				}
				- " "
				c- b="" {
					- "mixin"
				}
				- " "
				dfn id="abstractworker" data-dfn-type="interface" {
					c- g="" {
						- "AbstractWorker"
					}
				}
				- " {\n  "
				c- b="" {
					- "attribute"
				}
				- " "
				a href="#eventhandler" id="the-abstractworker-mixin:eventhandler" {
					c- n="" {
						- "EventHandler"
					}
				}
				- " "
				a href="#handler-abstractworker-onerror" id="the-abstractworker-mixin:handler-abstractworker-onerror" {
					c- g="" {
						- "onerror"
					}
				}
				- ";\n};"
			}
		}
		- "\n\n  "
		p {
			- "The following are the "
			a href="#event-handlers" id="the-abstractworker-mixin:event-handlers" {
				- "event handlers"
			}
			- " (and their corresponding "
			a href="#event-handler-event-type" id="the-abstractworker-mixin:event-handler-event-type" {
				- "event handler event types"
			}
			- ") that must be supported,\n  as "
			a href="#event-handler-idl-attributes" id="the-abstractworker-mixin:event-handler-idl-attributes" {
				- "event handler IDL attributes"
			}
			- ", by objects implementing the\n  "
			code id="the-abstractworker-mixin:abstractworker-2" {
				a href="#abstractworker" {
					- "AbstractWorker"
				}
			}
			- " interface:"
		}
		- "\n\n  "
		table {
			thead {
