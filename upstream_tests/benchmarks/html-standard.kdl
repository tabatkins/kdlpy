				}
			}
			li {
				p {
					- "If "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-domain" id="origin:concept-origin-domain-2" {
						- "domain"
					}
					- " is non-null,\n   then return "
					var {
						- "origin"
					}
					- "'s "
