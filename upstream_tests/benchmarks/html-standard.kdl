		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-addtexttrack" data-dfn-type="method" {
				code {
					- "addTextTrack("
					var {
						- "kind"
					}
					- ", "
					var {
						- "label"
					}
					- ",\n  "
					var {
						- "language"
					}
					- ")"
				}
			}
			- " method of "
			a href="#media-element" id="text-track-api:media-element-7" {
				- "media elements"
			}
			- ",\n  when invoked, must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Create a new "
