			code id="the-before-html-insertion-mode:document-6" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  object, e.g. by scripts; nothing in particular happens in such cases, content continues being\n  appended to the nodes as described in the next section."
		}
		- "\n\n\n  "
		h6 id="the-before-head-insertion-mode" {
