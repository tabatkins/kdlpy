									var {
										- "current node"
									}
									- "'s "
									code {
										- "target"
									}
									- " IDL attribute, followed by a single U+0020 SPACE character, followed\n        by the value of "
									var {
										- "current node"
									}
									- "'s "
									a href="https://dom.spec.whatwg.org/#concept-cd-data" id="serialising-html-fragments:concept-cd-data-4" data-x-internal="concept-cd-data" {
										- "data"
									}
									- ",\n        followed by a single U+003E GREATER-THAN SIGN character (>)."
								}
								- "\n       "
							}
							dt {
								- "If "
								var {
									- "current node"
								}
								- " is a "
								code id="serialising-html-fragments:documenttype" {
									a data-x-internal="documenttype" href="https://dom.spec.whatwg.org/#interface-documenttype" {
										- "DocumentType"
									}
								}
							}
							dd {
								- "\n        "
								p {
									- "Append \""
									code {
										- "<!DOCTYPE"
									}
									- "\" (U+003C LESS-THAN SIGN, U+0021\n        EXCLAMATION MARK, U+0044 LATIN CAPITAL LETTER D, U+004F LATIN CAPITAL LETTER O, U+0043 LATIN\n        CAPITAL LETTER C, U+0054 LATIN CAPITAL LETTER T, U+0059 LATIN CAPITAL LETTER Y, U+0050 LATIN\n        CAPITAL LETTER P, U+0045 LATIN CAPITAL LETTER E), followed by a space (U+0020 SPACE),\n        followed by the value of "
									var {
										- "current node"
									}
									- "'s "
									a href="https://dom.spec.whatwg.org/#concept-doctype-name" id="serialising-html-fragments:concept-doctype-name" data-x-internal="concept-doctype-name" {
										- "name"
									}
									- ", followed by \""
