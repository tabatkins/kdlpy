		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn id="concept-canvas-global-alpha" {
				- "global alpha"
			}
			- " value gives an alpha value\n  that is applied to shapes and images before they are composited onto the "
			a href="#output-bitmap" id="compositing:output-bitmap" {
				- "output bitmap"
			}
			- ".\n  The value ranges from 0.0 (fully transparent) to 1.0 (no additional transparency). It must\n  initially have the value 1.0."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasCompositing" id="dom-context-2d-globalalpha" data-dfn-type="attribute" {
				code {
					- "globalAlpha"
				}
			}
			- " getter steps are to return\n  "
			a id="compositing:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "'s "
			a href="#concept-canvas-global-alpha" id="compositing:concept-canvas-global-alpha-4" {
				- "global alpha"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="compositing:dom-context-2d-globalalpha" {
				a href="#dom-context-2d-globalalpha" {
					- "globalAlpha"
				}
			}
			- " setter steps are:\n\n  "
		}
		ol {
			li {
				p {
					- "If the given value is either infinite, NaN, or not in the range 0.0 to 1.0, then\n   return."
				}
			}
			li {
				p {
					- "Otherwise, set "
					a id="compositing:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-canvas-global-alpha" id="compositing:concept-canvas-global-alpha-5" {
						- "global\n   alpha"
					}
					- " to the given value."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="current-compositing-and-blending-operator" {
				- "current compositing and blending operator"
			}
			- " value controls how shapes and images\n  are drawn onto the "
			a href="#output-bitmap" id="compositing:output-bitmap-2" {
				- "output bitmap"
			}
			- ", once they have had the "
			a href="#concept-canvas-global-alpha" id="compositing:concept-canvas-global-alpha-6" {
				- "global alpha"
			}
			- " and the "
			a href="#current-transformation-matrix" id="compositing:current-transformation-matrix" {
				- "current transformation\n  matrix"
			}
			- " applied. Initially, it must be set to \""
			code id="compositing:gcop-source-over" {
				a data-x-internal="gcop-source-over" href="https://drafts.fxtf.org/compositing/#porterduffcompositingoperators_srcover" {
					- "source-over"
				}
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasCompositing" id="dom-context-2d-globalcompositeoperation" data-dfn-type="attribute" {
				code {
					- "globalCompositeOperation"
				}
			}
			- " getter\n  steps are to return "
			a id="compositing:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
