		- "\n\n  "
		p {
			- "Authors must not use elements, attributes, or attribute values that are not permitted by this\n  specification or "
			a href="#other-applicable-specifications" id="semantics-2:other-applicable-specifications" {
				- "other applicable specifications"
			}
			- ", as doing so makes it significantly\n  harder for the language to be extended in the future."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In the next example, there is a non-conforming attribute value (\"carpet\") and a non-conforming\n   attribute (\"texture\"), which is not permitted by this specification:"
			}
			- "\n\n   "
			pre class="bad" {
				code class="html" {
