					c- n="" {
						- "NavigationFocusReset"
					}
				}
				- " "
				dfn data-dfn-for="NavigationInterceptOptions" id="dom-navigationinterceptoptions-focusreset" data-dfn-type="dict-member" {
					c- g="" {
						- "focusReset"
					}
				}
				- ";\n  "
				a href="#navigationscrollbehavior" id="the-navigateevent-interface:navigationscrollbehavior" {
					c- n="" {
						- "NavigationScrollBehavior"
					}
				}
				- " "
				dfn data-dfn-for="NavigationInterceptOptions" id="dom-navigationinterceptoptions-scroll" data-dfn-type="dict-member" {
					c- g="" {
						- "scroll"
					}
				}
				- ";\n};\n\n"
				c- b="" {
					- "enum"
				}
				- " "
				dfn id="navigationfocusreset" data-dfn-type="enum" {
					c- g="" {
						- "NavigationFocusReset"
					}
				}
				- " {\n  "
