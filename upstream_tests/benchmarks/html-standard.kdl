		}
		- "\n\n  \n\n  "
		h5 id="definitions" {
			span class="secno" {
				- "4.10.20.1"
			}
			- " Definitions"
			a href="#definitions" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#category-submit" id="definitions:category-submit" {
				- "submittable element"
			}
			- " is a "
			dfn id="candidate-for-constraint-validation" {
				- "candidate for constraint\n  validation"
			}
			- " except when a condition has "
			dfn id="barred-from-constraint-validation" {
				- "barred\n  the element from constraint validation"
			}
			- ". (For example, an element is "
			a href="#barred-from-constraint-validation" id="definitions:barred-from-constraint-validation" {
				- "barred from\n  constraint validation"
			}
			- " if it has a "
			code id="definitions:the-datalist-element" {
				a href="#the-datalist-element" {
					- "datalist"
				}
			}
			- " element ancestor.)"
		}
		- "\n\n  "
		p {
			- "An element can have a "
			dfn id="custom-validity-error-message" {
				- "custom validity error message"
			}
			- " defined. Initially, an element\n  must have its "
			a href="#custom-validity-error-message" id="definitions:custom-validity-error-message" {
				- "custom validity error message"
			}
			- " set to the empty string. When its value\n  is not the empty string, the element is "
			a href="#suffering-from-a-custom-error" id="definitions:suffering-from-a-custom-error" {
				- "suffering from a custom error"
			}
			- ". It can be set\n  using the "
			code id="definitions:dom-cva-setcustomvalidity" {
				a href="#dom-cva-setcustomvalidity" {
					- "setCustomValidity()"
				}
			}
			- " method, except for\n  "
			a href="#form-associated-custom-element" id="definitions:form-associated-custom-element" {
				- "form-associated custom elements"
			}
			- ". "
			a href="#form-associated-custom-element" id="definitions:form-associated-custom-element-2" {
				- "Form-associated custom elements"
			}
			- " can have a\n  "
			a href="#custom-validity-error-message" id="definitions:custom-validity-error-message-2" {
				- "custom validity error message"
			}
			- " set via their "
			code id="definitions:elementinternals" {
				a href="#elementinternals" {
					- "ElementInternals"
				}
			}
			- " object's\n  "
