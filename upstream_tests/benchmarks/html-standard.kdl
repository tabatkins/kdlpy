								ol {
									li {
										p {
											a href="#insert-an-element-at-the-adjusted-insertion-location" id="parsing-main-inhead:insert-an-element-at-the-adjusted-insertion-location-2" {
												- "Insert an element at the adjusted insertion location"
											}
											- " with\n         "
											var {
												- "template"
											}
											- "."
										}
									}
									li {
										p {
											- "The user agent may report an error to the developer console."
										}
									}
									li {
										p {
											- "Return."
										}
									}
								}
								- "\n       "
							}
							li {
								p {
									- "Let "
									var {
										- "shadow"
									}
									- " be "
									var {
										- "declarative shadow host element"
									}
									- "'s\n       "
