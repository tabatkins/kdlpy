									- "report-to"
								}
							}
							- "\"]."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Set "
					var {
						- "parsedItem"
					}
					- " to the result of "
					a id="the-coop-headers:getting-a-structured-field-value-2" href="https://fetch.spec.whatwg.org/#concept-header-list-get-structured-header" data-x-internal="getting-a-structured-field-value" {
						- "getting a structured field value"
					}
					- "\n   given `"
					code id="the-coop-headers:cross-origin-opener-policy-report-only" {
						a href="#cross-origin-opener-policy-report-only" {
							- "Cross-Origin-Opener-Policy-Report-Only"
						}
					}
					- "` and \""
					code {
						- "item"
					}
					- "\"\n   from "
					var {
						- "response"
					}
					- "'s "
					a href="https://fetch.spec.whatwg.org/#concept-response-header-list" id="the-coop-headers:concept-response-header-list-2" data-x-internal="concept-response-header-list" {
						- "header\n   list"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "parsedItem"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[0] is \""
							code id="the-coop-headers:coop-same-origin-3" {
								a href="#coop-same-origin" {
									- "same-origin"
								}
							}
							- "\",\n      then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "coep"
									}
									- " be the result of "
									a href="#obtain-an-embedder-policy" id="the-coop-headers:obtain-an-embedder-policy-2" {
										- "obtaining a cross-origin embedder policy"
									}
									- " from "
									var {
										- "response"
									}
									- " and\n       "
									var {
										- "reservedEnvironment"
									}
									- "."
								}
							}
							li {
								- "\n        "
								p {
									- "If "
									var {
										- "coep"
									}
									- "'s "
									a href="#embedder-policy-value-2" id="the-coop-headers:embedder-policy-value-2-2" {
										- "value"
									}
									- " is\n        "
									a href="#compatible-with-cross-origin-isolation" id="the-coop-headers:compatible-with-cross-origin-isolation-2" {
										- "compatible with cross-origin isolation"
									}
									- " or "
									var {
										- "coep"
									}
									- "'s "
									a href="#embedder-policy-report-only-value" id="the-coop-headers:embedder-policy-report-only-value" {
										- "report-only value"
									}
									- " is "
									a href="#compatible-with-cross-origin-isolation" id="the-coop-headers:compatible-with-cross-origin-isolation-3" {
										- "compatible\n        with cross-origin isolation"
									}
									- ", then set "
									var {
										- "policy"
									}
									- "'s "
									a href="#coop-struct-report-only-value" id="the-coop-headers:coop-struct-report-only-value" {
										- "report-only value"
									}
									- " to \""
									code id="the-coop-headers:coop-same-origin-plus-coep-2" {
										a href="#coop-same-origin-plus-coep" {
											- "same-origin-plus-COEP"
										}
									}
									- "\"."
								}
								- "\n\n        "
								p class="note" {
									- "Report only COOP also considers report-only COEP to assign the special\n        \""
									code id="the-coop-headers:coop-same-origin-plus-coep-3" {
										a href="#coop-same-origin-plus-coep" {
											- "same-origin-plus-COEP"
										}
									}
									- "\" value. This allows\n        developers more freedom in the order of deployment of COOP and COEP."
								}
								- "\n       "
							}
							li {
								p {
									- "Otherwise, set "
									var {
										- "policy"
									}
									- "'s "
									a href="#coop-struct-report-only-value" id="the-coop-headers:coop-struct-report-only-value-2" {
										- "report-only value"
									}
									- " to \""
									code id="the-coop-headers:coop-same-origin-4" {
										a href="#coop-same-origin" {
											- "same-origin"
										}
									}
									- "\"."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[0] is \""
							code id="the-coop-headers:coop-same-origin-allow-popups-3" {
								a href="#coop-same-origin-allow-popups" {
									- "same-origin-allow-popups"
								}
							}
							- "\", then set\n     "
							var {
								- "policy"
							}
							- "'s "
							a href="#coop-struct-report-only-value" id="the-coop-headers:coop-struct-report-only-value-3" {
								- "report-only value"
							}
							- " to\n     \""
							code id="the-coop-headers:coop-same-origin-allow-popups-4" {
								a href="#coop-same-origin-allow-popups" {
									- "same-origin-allow-popups"
								}
							}
							- "\"."
						}
					}
					li {
						p {
							- "If "
							var {
								- "parsedItem"
							}
							- "[1][\""
							code id="the-coop-headers:coop-report-to-3" {
								a href="#coop-report-to" {
									- "report-to"
								}
							}
							- "\"] "
							a href="https://infra.spec.whatwg.org/#map-exists" id="the-coop-headers:map-exists-2" data-x-internal="map-exists" {
								- "exists"
							}
							- " and it is a string, then set "
							var {
								- "policy"
							}
							- "'s "
							a href="#coop-struct-report-only-endpoint" id="the-coop-headers:coop-struct-report-only-endpoint" {
								- "report-only reporting endpoint"
							}
							- " to\n     "
							var {
								- "parsedItem"
							}
							- "[1][\""
							code id="the-coop-headers:coop-report-to-4" {
								a href="#coop-report-to" {
									- "report-to"
								}
							}
							- "\"]."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "policy"
					}
					- "."
				}
			}
		}
		- "\n\n\n  "
		h5 id="browsing-context-group-switches-due-to-cross-origin-opener-policy" {
			span class="secno" {
				- "7.1.3.2"
			}
			- " Browsing context group\n  switches due to opener policy"
			a href="#browsing-context-group-switches-due-to-cross-origin-opener-policy" class="self-link"
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="check-browsing-context-group-switch-coop-value-popup" {
				- "check if popup COOP\n  values require a browsing context group switch"
			}
			- ", given two "
			a href="#concept-origin" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-origin" {
				- "origins"
			}
			- " "
			var {
				- "responseOrigin"
			}
			- " and\n  "
			var {
				- "activeDocumentNavigationOrigin"
			}
			- ", and two "
			a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value" {
				- "opener policy\n  values"
			}
			- " "
			var {
				- "responseCOOPValue"
			}
			- " and "
			var {
				- "activeDocumentCOOPValue"
			}
			- ":"
		}
		- "\n  "
		ol {
			li {
				p {
					var {
						- "responseCOOPValue"
					}
					- " is \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-noopener-allow-popups" {
						a href="#coop-noopener-allow-popups" {
							- "noopener-allow-popups"
						}
					}
					- "\", then return true."
				}
			}
			li {
				- "\n    "
				p {
					- "If all of the following are true:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							var {
								- "activeDocumentCOOPValue"
							}
							- "'s "
							a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-2" {
								- "value"
							}
							- " is\n     \""
							code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-same-origin-allow-popups" {
								a href="#coop-same-origin-allow-popups" {
									- "same-origin-allow-popups"
								}
							}
							- "\" or\n     \""
							code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-noopener-allow-popups-2" {
								a href="#coop-noopener-allow-popups" {
									- "noopener-allow-popups"
								}
							}
							- "\"; and"
						}
					}
					li {
						p {
							var {
								- "responseCOOPValue"
							}
							- " is \""
							code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-unsafe-none" {
								a href="#coop-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\","
						}
					}
				}
				- "\n\n    "
				p {
					- "then return false."
				}
				- "\n   "
			}
			li {
				p {
					- "If the result of "
					a href="#matching-coop" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:matching-coop" {
						- "matching"
					}
					- "\n   "
					var {
						- "activeDocumentCOOPValue"
					}
					- ", "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ",\n   "
					var {
						- "responseCOOPValue"
					}
					- ", and "
					var {
						- "responseOrigin"
					}
					- " is true, then return false."
				}
			}
			li {
				p {
					- "Return true."
				}
				- "\n  "
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="check-browsing-context-group-switch-coop-value" {
				- "check if COOP values require a\n  browsing context group switch"
			}
			- ", given a boolean "
			var {
				- "isInitialAboutBlank"
			}
			- ", two "
			a href="#concept-origin" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-origin-2" {
				- "origins"
			}
			- " "
			var {
				- "responseOrigin"
			}
			- " and\n  "
			var {
				- "activeDocumentNavigationOrigin"
			}
			- ", and two "
			a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-3" {
				- "opener policy\n  values"
			}
			- " "
			var {
				- "responseCOOPValue"
			}
			- " and "
			var {
				- "activeDocumentCOOPValue"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "isInitialAboutBlank"
					}
					- " is true, then return the result of "
					a href="#check-browsing-context-group-switch-coop-value-popup" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:check-browsing-context-group-switch-coop-value-popup" {
						- "checking if popup COOP values\n   requires a browsing context group switch"
					}
					- " with "
					var {
						- "responseOrigin"
					}
					- ",\n   "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ", "
					var {
						- "responseCOOPValue"
					}
					- ", and\n   "
					var {
						- "activeDocumentCOOPValue"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p class="note" {
					- "Here we are dealing with a non-popup navigation."
				}
				- "\n\n    "
				p {
					- "If the result of "
					a href="#matching-coop" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:matching-coop-2" {
						- "matching"
					}
					- "\n    "
					var {
						- "activeDocumentCOOPValue"
					}
					- ", "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ",\n    "
					var {
						- "responseCOOPValue"
					}
					- ", and "
					var {
						- "responseOrigin"
					}
					- " is true, then return false."
				}
				- "\n   "
			}
			li {
				p {
					- "Return true."
				}
				- "\n  "
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="check-bcg-switch-navigation-report-only" {
				- "check if enforcing report-only COOP\n  would require a browsing context group switch"
			}
			- ", given a boolean\n  "
			var {
				- "isInitialAboutBlank"
			}
			- ", two "
			a href="#concept-origin" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-origin-3" {
				- "origins"
			}
			- "\n  "
			var {
				- "responseOrigin"
			}
			- ", "
			var {
				- "activeDocumentNavigationOrigin"
			}
			- ", and two "
			a href="#cross-origin-opener-policy" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:cross-origin-opener-policy" {
				- "opener policies"
			}
			- " "
			var {
				- "responseCOOP"
			}
			- " and "
			var {
				- "activeDocumentCOOP"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the result of "
					a href="#check-browsing-context-group-switch-coop-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:check-browsing-context-group-switch-coop-value" {
						- "checking if\n    COOP values require a browsing context group switch"
					}
					- " given\n    "
					var {
						- "isInitialAboutBlank"
					}
					- ", "
					var {
						- "responseOrigin"
					}
					- ",\n    "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ", "
					var {
						- "responseCOOP"
					}
					- "'s "
					a href="#coop-struct-report-only-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-report-only-value" {
						- "report-only value"
					}
					- " and\n    "
					var {
						- "activeDocumentCOOPReportOnly"
					}
					- "'s "
					a href="#coop-struct-report-only-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-report-only-value-2" {
						- "report-only value"
					}
					- " is false, then return\n    false."
				}
				- "\n\n    "
				p class="note" {
					- "Matching report-only policies allows a website to specify the same report-only\n    opener policy on all its pages and not receive violation reports for navigations between these\n    pages."
				}
				- "\n   "
			}
			li {
				p {
					- "If the result of "
					a href="#check-browsing-context-group-switch-coop-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:check-browsing-context-group-switch-coop-value-2" {
						- "checking\n   if COOP values require a browsing context group switch"
					}
					- " given\n   "
					var {
						- "isInitialAboutBlank"
					}
					- ", "
					var {
						- "responseOrigin"
					}
					- ",\n   "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ", "
					var {
						- "responseCOOP"
					}
					- "'s "
					a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-4" {
						- "value"
					}
					- " and "
					var {
						- "activeDocumentCOOPReportOnly"
					}
					- "'s "
					a href="#coop-struct-report-only-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-report-only-value-3" {
						- "report-only value"
					}
					- " is true, then return\n   true."
				}
			}
			li {
				p {
					- "If the result of "
					a href="#check-browsing-context-group-switch-coop-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:check-browsing-context-group-switch-coop-value-3" {
						- "checking\n   if COOP values require a browsing context group switch"
					}
					- " given\n   "
					var {
						- "isInitialAboutBlank"
					}
					- ", "
					var {
						- "responseOrigin"
					}
					- ",\n   "
					var {
						- "activeDocumentNavigationOrigin"
					}
					- ", "
					var {
						- "responseCOOP"
					}
					- "'s "
					a href="#coop-struct-report-only-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-report-only-value-4" {
						- "report-only value"
					}
					- " and\n   "
					var {
						- "activeDocumentCOOPReportOnly"
					}
					- "'s "
					a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-5" {
						- "value"
					}
					- " is true,\n   then return true."
				}
			}
			li {
				p {
					- "Return false."
				}
			}
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="coop-enforcement-result" {
				- "opener policy enforcement result"
