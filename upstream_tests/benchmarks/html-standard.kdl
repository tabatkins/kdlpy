			a href="#concept-import-map-scopes" id="import-map-processing-model:concept-import-map-scopes" {
				- "scopes"
			}
			- " both being empty maps."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="specifier-resolution-record" {
				- "specifier resolution record"
			}
