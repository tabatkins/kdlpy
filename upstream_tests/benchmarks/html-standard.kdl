					a id="child-navigables:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- "'s "
					a href="#concept-document-bc" id="child-navigables:concept-document-bc" {
						- "browsing context"
					}
					- "'s "
					a href="#bc-tlbc" id="child-navigables:bc-tlbc" {
						- "top-level browsing\n   context"
					}
					- "'s "
					a href="#tlbc-group" id="child-navigables:tlbc-group" {
						- "group"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "browsingContext"
					}
					- " and "
					var {
						- "document"
					}
					- " be the result of "
					a href="#creating-a-new-browsing-context" id="child-navigables:creating-a-new-browsing-context" {
						- "creating a\n   new browsing context and document"
					}
					- " given "
					var {
						- "element"
					}
					- "'s "
					a id="child-navigables:node-document-4" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- ",\n   "
					var {
						- "element"
					}
					- ", and "
					var {
						- "group"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "targetName"
					}
					- " be null."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " has a "
					code {
						- "name"
					}
					- " content attribute, then set\n   "
					var {
						- "targetName"
					}
					- " to the value of that attribute."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "documentState"
					}
					- " be a new "
					a href="#document-state-2" id="child-navigables:document-state-2" {
						- "document state"
					}
					- ", with"
				}
				- "\n\n    "
				dl class="props" {
					dt {
						a href="#document-state-document" id="child-navigables:document-state-document" {
							- "document"
						}
					}
					dd {
						var {
							- "document"
						}
					}
					dt {
						a href="#document-state-initiator-origin" id="child-navigables:document-state-initiator-origin" {
							- "initiator origin"
						}
					}
					dd {
						var {
							- "document"
						}
						- "'s "
						a href="https://dom.spec.whatwg.org/#concept-document-origin" id="child-navigables:concept-document-origin-3" data-x-internal="concept-document-origin" {
							- "origin"
						}
					}
					dt {
						a href="#document-state-origin" id="child-navigables:document-state-origin" {
							- "origin"
						}
					}
					dd {
						var {
							- "document"
						}
						- "'s "
						a href="https://dom.spec.whatwg.org/#concept-document-origin" id="child-navigables:concept-document-origin-4" data-x-internal="concept-document-origin" {
							- "origin"
						}
					}
					dt {
						a href="#document-state-nav-target-name" id="child-navigables:document-state-nav-target-name" {
							- "navigable target name"
						}
					}
					dd {
						var {
							- "targetName"
						}
					}
					dt {
						a href="#document-state-about-base-url" id="child-navigables:document-state-about-base-url" {
							- "about base URL"
						}
					}
					dd {
						var {
							- "document"
						}
						- "'s "
						a href="#concept-document-about-base-url" id="child-navigables:concept-document-about-base-url" {
							- "about base\n     URL"
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "navigable"
					}
					- " be a new "
					a href="#navigable" id="child-navigables:navigable-7" {
						- "navigable"
					}
					- "."
				}
			}
			li {
				p {
					a href="#initialize-the-navigable" id="child-navigables:initialize-the-navigable" {
						- "Initialize the navigable"
					}
					- " "
					var {
						- "navigable"
					}
					- " given "
					var {
						- "documentState"
					}
					- "\n   and "
					var {
						- "parentNavigable"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "element"
					}
					- "'s "
					a href="#content-navigable" id="child-navigables:content-navigable-7" {
						- "content navigable"
					}
					- " to "
					var {
						- "navigable"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "historyEntry"
					}
					- " be "
					var {
						- "navigable"
					}
					- "'s "
					a href="#nav-active-history-entry" id="child-navigables:nav-active-history-entry" {
						- "active session history entry"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "traversable"
					}
					- " be "
					var {
						- "parentNavigable"
					}
					- "'s "
					a href="#nav-traversable" id="child-navigables:nav-traversable" {
						- "traversable navigable"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="#tn-append-session-history-traversal-steps" id="child-navigables:tn-append-session-history-traversal-steps" {
						- "Append the following session\n    history traversal steps"
					}
					- " to "
					var {
						- "traversable"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "parentDocState"
							}
							- " be "
							var {
								- "parentNavigable"
							}
							- "'s "
							a href="#nav-active-history-entry" id="child-navigables:nav-active-history-entry-2" {
								- "active session history entry"
							}
							- "'s "
							a href="#she-document-state" id="child-navigables:she-document-state" {
								- "document state"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "parentNavigableEntries"
							}
							- " be the result of "
							a href="#getting-session-history-entries" id="child-navigables:getting-session-history-entries" {
								- "getting session history\n     entries"
							}
							- " for "
							var {
								- "parentNavigable"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "targetStepSHE"
							}
							- " be the first "
							a href="#session-history-entry" id="child-navigables:session-history-entry" {
								- "session history entry"
							}
							- " in\n     "
							var {
								- "parentNavigableEntries"
							}
							- " whose "
							a href="#she-document-state" id="child-navigables:she-document-state-2" {
								- "document\n     state"
							}
							- " equals "
							var {
								- "parentDocState"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "historyEntry"
							}
							- "'s "
							a href="#she-step" id="child-navigables:she-step" {
								- "step"
							}
							- " to\n     "
							var {
								- "targetStepSHE"
							}
							- "'s "
							a href="#she-step" id="child-navigables:she-step-2" {
								- "step"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "nestedHistory"
							}
							- " be a new "
							a href="#nested-history" id="child-navigables:nested-history" {
								- "nested history"
							}
							- " whose "
							a href="#nested-history-id" id="child-navigables:nested-history-id" {
								- "id"
							}
							- " is "
							var {
								- "navigable"
							}
							- "'s "
							a href="#nav-id" id="child-navigables:nav-id" {
								- "id"
							}
							- "\n     and "
							a href="#nested-history-entries" id="child-navigables:nested-history-entries" {
								- "entries list"
							}
							- " is « "
							var {
								- "historyEntry"
							}
							- "\n     »."
						}
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-append" id="child-navigables:list-append" data-x-internal="list-append" {
								- "Append"
							}
							- " "
							var {
								- "nestedHistory"
							}
							- " to\n     "
							var {
								- "parentDocState"
							}
							- "'s "
							a href="#document-state-nested-histories" id="child-navigables:document-state-nested-histories" {
								- "nested\n     histories"
							}
							- "."
						}
					}
					li {
						p {
							a href="#update-for-navigable-creation/destruction" id="child-navigables:update-for-navigable-creation/destruction" {
								- "Update for navigable creation/destruction"
							}
							- " given\n     "
							var {
								- "traversable"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Invoke "
					a id="child-navigables:webdriver-bidi-navigable-created" href="https://w3c.github.io/webdriver-bidi/#webdriver-bidi-navigable-created" data-x-internal="webdriver-bidi-navigable-created" {
						- "WebDriver BiDi navigable created"
					}
					- " with "
					var {
						- "traversable"
					}
					- "."
				}
			}
		}
		- "\n\n\n  "
		h5 id="jake-diagrams" {
			span class="secno" {
				- "7.3.1.4"
			}
			- " Jake diagrams"
			a href="#jake-diagrams" class="self-link"
		}
		- "\n\n  "
		p {
			- "A useful method for visualizing sequences of documents, and in particular "
			a href="#navigable" id="jake-diagrams:navigable" {
				- "navigables"
			}
			- " and their "
			a href="#session-history-entry" id="jake-diagrams:session-history-entry" {
				- "session\n  history entries"
			}
			- ", is the "
			dfn id="jake-diagram" {
				- "Jake diagram"
			}
			- ". A typical Jake diagram is the\n  following:"
		}
		- "\n\n  \n  "
		table class="jake-diagram" {
			thead {
				tr {
					td
					th class="step" {
						- "0"
					}
					th class="step current" {
						- "1"
					}
					th class="step" {
						- "2"
					}
					th class="step" {
						- "3"
					}
					th class="step" {
						- "4"
					}
				}
			}
			tbody {
				tr {
					th {
						code {
							- "top"
						}
					}
					td colspan="3" class="doc-0 current next-is-same-doc" {
						- "/t-a"
					}
					td colspan="1" class="doc-0 prev-is-same-doc" {
						- "/t-a#foo"
					}
					td colspan="1" class="doc-1" {
						- "/t-b"
					}
				}
				tr {
					th {
						code {
							- "frames[0]"
						}
					}
					td colspan="1" class="doc-2" {
						- "/i-0-a"
					}
					td colspan="3" class="doc-3 current" {
						- "/i-0-b"
					}
				}
				tr {
					th {
						code {
							- "frames[1]"
						}
					}
					td colspan="2" class="doc-4 current" {
						- "/i-1-a"
					}
					td colspan="2" class="doc-5" {
						- "/i-1-b"
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "Here, each numbered column denotes a possible value for the traversable's "
			a href="#tn-current-session-history-step" id="jake-diagrams:tn-current-session-history-step" {
				- "session history step"
			}
			- ". Each labeled row depicts a\n  "
			a href="#navigable" id="jake-diagrams:navigable-2" {
				- "navigable"
			}
			- ", as it transitions between different URLs and documents. The first,\n  labeled "
			code {
				- "top"
			}
			- ", being the "
			a href="#top-level-traversable" id="jake-diagrams:top-level-traversable" {
				- "top-level traversable"
			}
			- ", and the others\n  being "
			a href="#child-navigable" id="jake-diagrams:child-navigable" {
				- "child navigables"
			}
			- ". The documents are given by the\n  background color of each cell, with a new background color indicating a new document in that\n  "
			a href="#navigable" id="jake-diagrams:navigable-3" {
				- "navigable"
			}
			- ". The URLs are given by the text content of the cells; usually they are\n  given as "
			a href="https://url.spec.whatwg.org/#syntax-url-relative" id="jake-diagrams:relative-url" data-x-internal="relative-url" {
				- "relative URLs"
			}
			- " for brevity, unless a cross-origin case\n  is specifically under investigation. A given navigable might not exist at a given step, in which\n  case the corresponding cells are empty. The bold-italic step number depicts the "
			a href="#tn-current-session-history-step" id="jake-diagrams:tn-current-session-history-step-2" {
				- "current session history step"
			}
			- " of the traversable,\n  and all cells with bold-italic URLs represent the "
			a href="#nav-current-history-entry" id="jake-diagrams:nav-current-history-entry" {
				- "current session history entry"
			}
			- " for that row's\n  navigable."
		}
		- "\n\n  "
		p {
			- "Thus, the above Jake diagram depicts the following sequence of events:"
		}
		- "\n\n  "
		ol start="0" {
			li {
				p {
					- "A "
					a href="#top-level-traversable" id="jake-diagrams:top-level-traversable-2" {
						- "top-level traversable"
					}
					- " is created, starting a the URL "
					code {
						- "/t-a"
					}
					- ", with two "
					a href="#child-navigable" id="jake-diagrams:child-navigable-2" {
						- "child navigables"
					}
					- "\n   starting at "
					code {
						- "/i-0-a"
					}
					- " and "
					code {
						- "/i-1-a"
					}
					- "\n   respectively."
				}
			}
			li {
				p {
					- "The first child navigable is "
					a href="#navigate" id="jake-diagrams:navigate" {
						- "navigated"
					}
					- " to another\n   document, with URL "
					code {
						- "/i-0-b"
					}
					- "."
				}
			}
			li {
				p {
					- "The second child navigable is "
					a href="#navigate" id="jake-diagrams:navigate-2" {
						- "navigated"
					}
					- " to another\n   document, with URL "
					code {
						- "/i-1-b"
					}
					- "."
				}
			}
			li {
				p {
					- "The top-level traversable is "
					a href="#navigate" id="jake-diagrams:navigate-3" {
						- "navigated"
					}
					- " to the\n   "
					em {
						- "same"
					}
					- " document, updating its URL to "
					code {
						- "/t-a#foo"
					}
					- "."
				}
			}
			li {
				p {
					- "The top-level traversable is "
					a href="#navigate" id="jake-diagrams:navigate-4" {
						- "navigated"
					}
					- " to another\n   document, with URL "
					code {
						- "/t-b"
					}
					- ". (Notice how this document, of course, does not\n   carry over the old document's child navigables.)"
				}
			}
			li {
				p {
					- "The traversable was "
					a href="#traverse-the-history-by-a-delta" id="jake-diagrams:traverse-the-history-by-a-delta" {
						- "traversed by a\n   delta"
					}
					- " of −3, back to step 1."
				}
			}
		}
		- "\n\n  "
		p {
			a href="#jake-diagram" id="jake-diagrams:jake-diagram" {
				- "Jake diagrams"
			}
			- " are a powerful tool for visualizing the\n  interactions of multiple navigables, navigations, and traversals. They cannot capture every\n  possible interaction — for example, they only work with a single level of nesting —\n  but we will have ocassion to use them to illustrate several complex situations throughout this\n  standard."
		}
		- "\n\n  "
		p class="note" {
			a href="#jake-diagram" id="jake-diagrams:jake-diagram-2" {
				- "Jake diagrams"
			}
			- " are named after their creator,\n  the inimitable Jake Archibald."
		}
		- "\n\n\n  "
		h5 id="related-navigable-collections" {
			span class="secno" {
				- "7.3.1.5"
			}
			- " Related navigable collections"
			a href="#related-navigable-collections" class="self-link"
		}
		- "\n\n  "
		p {
			- "It is often helpful in this standard's algorithms to look at collections of "
			a href="#navigable" id="related-navigable-collections:navigable" {
				- "navigables"
			}
			- " starting at a given "
			code id="related-navigable-collections:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ". This section\n  contains a curated set of algorithms for collecting those navigables."
		}
		- "\n\n  "
		p class="note" {
			- "The return values of these algorithms are ordered so that parents appears before\n  their children. Callers rely on this ordering."
		}
		- "\n\n  "
		p class="note" {
			- "Starting with a "
			code id="related-navigable-collections:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- ", rather than a "
			a href="#navigable" id="related-navigable-collections:navigable-2" {
				- "navigable"
			}
			- ", is\n  generally better because it makes the caller cognizant of whether they are starting with a\n  "
			a href="#fully-active" id="related-navigable-collections:fully-active" {
				- "fully active"
			}
			- " "
			code id="related-navigable-collections:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- " or not. Although non-"
			a href="#fully-active" id="related-navigable-collections:fully-active-2" {
				- "fully active"
			}
			- "\n  "
			code id="related-navigable-collections:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- "s do have ancestor and descendant navigables, they often behave as if they\n  don't (e.g., in the "
			code id="related-navigable-collections:dom-parent" {
				a href="#dom-parent" {
					- "window.parent"
				}
			}
			- " getter)."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="Document" id="ancestor-navigables" data-export="" {
				- "ancestor navigables"
			}
			- " of a "
			code id="related-navigable-collections:document-5" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  "
			var {
				- "document"
			}
			- " are given by these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "navigable"
					}
					- " be "
					var {
						- "document"
					}
					- "'s "
					a href="#node-navigable" id="related-navigable-collections:node-navigable" {
						- "node navigable"
					}
					- "'s "
					a href="#nav-parent" id="related-navigable-collections:nav-parent" {
						- "parent"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "ancestors"
					}
					- " be an empty list."
				}
				- "\n\n   "
			}
			li {
				- "\n    "
				p {
					- "While "
					var {
						- "navigable"
					}
					- " is not null:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-prepend" id="related-navigable-collections:list-prepend" data-x-internal="list-prepend" {
								- "Prepend"
							}
							- " "
							var {
								- "navigable"
							}
							- " to\n     "
							var {
								- "ancestors"
							}
							- "."
						}
					}
