		- "\n\n  \n\n\n  "
		h5 id="ongoing-navigation-tracking" {
			span class="secno" {
				- "7.2.6.8"
			}
			- " Ongoing navigation tracking"
			a href="#ongoing-navigation-tracking" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			- "During any given navigation (in the "
			a href="#navigationtype" id="ongoing-navigation-tracking:navigationtype" {
				- "broad sense of the\n  word"
			}
			- "), the "
			code id="ongoing-navigation-tracking:navigation" {
				a href="#navigation" {
					- "Navigation"
				}
			}
			- " object needs to keep track of the following:"
		}
		- "\n\n  "
		table {
			caption {
				- "For all navigations"
			}
			thead {
				tr {
					th {
						- "State\n     "
					}
					th {
						- "Duration\n     "
					}
					th {
						- "Explanation\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "The "
						code id="ongoing-navigation-tracking:navigateevent" {
							a href="#navigateevent" {
								- "NavigateEvent"
							}
						}
						- "\n     "
					}
					td {
						- "For the duration of event firing\n     "
					}
					td {
						- "So that if the navigation is canceled while the event is firing, we can "
						a href="https://dom.spec.whatwg.org/#canceled-flag" id="ongoing-navigation-tracking:canceled-flag" data-x-internal="canceled-flag" {
							- "cancel"
						}
						- " the event\n    "
					}
				}
				tr {
					td {
						- "The event's "
						a href="#concept-navigateevent-abort-controller" id="ongoing-navigation-tracking:concept-navigateevent-abort-controller" {
							- "abort controller"
						}
						- "\n     "
					}
					td {
						- "Until all promises returned from handlers passed to "
						code id="ongoing-navigation-tracking:dom-navigateevent-intercept" {
							a href="#dom-navigateevent-intercept" {
								- "intercept()"
							}
						}
						- " have settled\n     "
					}
					td {
						- "So that if the navigation is canceled, we can "
						a id="ongoing-navigation-tracking:signal-abort" href="https://dom.spec.whatwg.org/#abortcontroller-signal-abort" data-x-internal="signal-abort" {
							- "signal abort"
						}
						- "\n    "
					}
				}
				tr {
					td {
						- "Whether a new element was "
						a href="#focusing-steps" id="ongoing-navigation-tracking:focusing-steps" {
							- "focused"
						}
						- "\n     "
					}
					td {
						- "Until all promises returned from handlers passed to "
						code id="ongoing-navigation-tracking:dom-navigateevent-intercept-2" {
							a href="#dom-navigateevent-intercept" {
								- "intercept()"
							}
						}
						- " have settled\n     "
					}
					td {
						- "So that if one was, focus is not "
						a href="#potentially-reset-the-focus" id="ongoing-navigation-tracking:potentially-reset-the-focus" {
							- "reset"
						}
						- "\n    "
					}
				}
				tr {
					td {
						- "The "
						code id="ongoing-navigation-tracking:navigationhistoryentry" {
							a href="#navigationhistoryentry" {
								- "NavigationHistoryEntry"
							}
						}
						- " being navigated to\n     "
					}
					td {
						- "From when it is determined, until all promises returned from handlers passed to "
						code id="ongoing-navigation-tracking:dom-navigateevent-intercept-3" {
							a href="#dom-navigateevent-intercept" {
								- "intercept()"
							}
						}
						- " have settled\n     "
					}
					td {
						- "So that we know what to resolve any "
						code id="ongoing-navigation-tracking:dom-navigationresult-committed" {
							a href="#dom-navigationresult-committed" {
								- "committed"
							}
						}
						- " and "
						code id="ongoing-navigation-tracking:dom-navigationresult-finished" {
							a href="#dom-navigationresult-finished" {
								- "finished"
							}
						}
						- " promises with\n    "
					}
				}
				tr {
					td {
						- "Any "
						code id="ongoing-navigation-tracking:dom-navigationresult-finished-2" {
							a href="#dom-navigationresult-finished" {
								- "finished"
							}
						}
						- " promise that was returned\n     "
					}
					td {
						- "Until all promises returned from handlers passed to "
						code id="ongoing-navigation-tracking:dom-navigateevent-intercept-4" {
							a href="#dom-navigateevent-intercept" {
								- "intercept()"
							}
						}
						- " have settled\n     "
					}
					td {
						- "So that we can resolve or reject it appropriately\n  "
					}
				}
			}
		}
		- "\n\n  "
		table {
			caption {
				- "For non-\""
				code id="ongoing-navigation-tracking:dom-navigationtype-traverse" {
					a href="#dom-navigationtype-traverse" {
						- "traverse"
					}
				}
				- "\" navigations"
			}
			thead {
				tr {
					th {
						- "State\n     "
					}
					th {
						- "Duration\n     "
					}
					th {
						- "Explanation\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "Any "
						code id="ongoing-navigation-tracking:dom-navigationnavigateoptions-state" {
							a href="#dom-navigationnavigateoptions-state" {
								- "state"
							}
						}
						- "\n     "
					}
