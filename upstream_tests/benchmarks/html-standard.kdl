				a href="#parse-errors" id="after-doctype-system-identifier-state:parse-errors" {
					- "parse\n   error"
				}
				- ". Set the current DOCTYPE token's "
				i id="after-doctype-system-identifier-state:force-quirks-flag" {
					a href="#force-quirks-flag" {
						- "force-quirks flag"
					}
				}
				- " to\n   "
				i {
					- "on"
				}
				- ". Emit the current DOCTYPE token. Emit an end-of-file token."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "This is an "
				a href="#parse-error-unexpected-character-after-doctype-system-identifier" id="after-doctype-system-identifier-state:parse-error-unexpected-character-after-doctype-system-identifier" {
					- "unexpected-character-after-doctype-system-identifier"
				}
				- "\n   "
				a href="#parse-errors" id="after-doctype-system-identifier-state:parse-errors-2" {
					- "parse error"
				}
				- ". "
				a href="#reconsume" id="after-doctype-system-identifier-state:reconsume" {
					- "Reconsume"
				}
				- " in the "
				a href="#bogus-doctype-state" id="after-doctype-system-identifier-state:bogus-doctype-state" {
					- "bogus DOCTYPE state"
				}
				- ". (This\n   does "
				em {
					- "not"
				}
				- " set the current DOCTYPE token's "
				i id="after-doctype-system-identifier-state:force-quirks-flag-2" {
					a href="#force-quirks-flag" {
						- "force-quirks flag"
					}
				}
				- " to\n   "
				i {
					- "on"
				}
				- ".)"
			}
		}
		- "\n\n\n  "
		h5 id="bogus-doctype-state" {
			span class="secno" {
				- "13.2.5.68"
			}
			- " "
			dfn {
				- "Bogus DOCTYPE state"
			}
			a href="#bogus-doctype-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="bogus-doctype-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "U+003E GREATER-THAN SIGN (>)"
			}
			dd {
				- "Switch to the "
				a href="#data-state" id="bogus-doctype-state:data-state" {
					- "data state"
				}
				- ". Emit the DOCTYPE token."
			}
			dt {
				- "U+0000 NULL"
			}
			dd {
				- "This is an "
				a href="#parse-error-unexpected-null-character" id="bogus-doctype-state:parse-error-unexpected-null-character" {
					- "unexpected-null-character"
				}
				- " "
				a href="#parse-errors" id="bogus-doctype-state:parse-errors" {
					- "parse\n   error"
				}
				- ". Ignore the character."
			}
			dt {
				- "EOF"
			}
			dd {
				- "Emit the DOCTYPE token. Emit an end-of-file token."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "Ignore the character."
			}
		}
		- "\n\n\n  "
		h5 id="cdata-section-state" {
			span class="secno" {
				- "13.2.5.69"
			}
			- " "
			dfn {
				- "CDATA section state"
			}
			a href="#cdata-section-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="cdata-section-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "U+005D RIGHT SQUARE BRACKET (])"
			}
			dd {
				- "Switch to the "
				a href="#cdata-section-bracket-state" id="cdata-section-state:cdata-section-bracket-state" {
					- "CDATA section bracket state"
				}
				- "."
			}
			dt {
				- "EOF"
			}
			dd {
				- "This is an "
				a href="#parse-error-eof-in-cdata" id="cdata-section-state:parse-error-eof-in-cdata" {
					- "eof-in-cdata"
				}
				- " "
				a href="#parse-errors" id="cdata-section-state:parse-errors" {
					- "parse\n    error"
				}
				- ". Emit an end-of-file token."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "Emit the "
				a href="#current-input-character" id="cdata-section-state:current-input-character" {
					- "current input character"
				}
				- " as a character token."
			}
		}
		- "\n\n  "
		p class="note" {
			- "U+0000 NULL characters are handled in the tree construction stage, as part of the\n  "
			a href="#parsing-main-inforeign" id="cdata-section-state:parsing-main-inforeign" {
				- "in foreign content"
			}
			- " insertion mode, which\n  is the only place where CDATA sections can appear."
		}
		- "\n\n  "
		h5 id="cdata-section-bracket-state" {
			span class="secno" {
				- "13.2.5.70"
			}
			- " "
			dfn {
				- "CDATA section bracket state"
			}
			a href="#cdata-section-bracket-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="cdata-section-bracket-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "U+005D RIGHT SQUARE BRACKET (])"
			}
			dd {
				- "Switch to the "
				a href="#cdata-section-end-state" id="cdata-section-bracket-state:cdata-section-end-state" {
					- "CDATA section end state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "Emit a U+005D RIGHT SQUARE BRACKET character token. "
				a href="#reconsume" id="cdata-section-bracket-state:reconsume" {
					- "Reconsume"
				}
				- " in the\n    "
				a href="#cdata-section-state" id="cdata-section-bracket-state:cdata-section-state" {
					- "CDATA section state"
				}
				- "."
			}
		}
		- "\n\n\n  "
		h5 id="cdata-section-end-state" {
			span class="secno" {
				- "13.2.5.71"
			}
			- " "
			dfn {
				- "CDATA section end state"
			}
			a href="#cdata-section-end-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="cdata-section-end-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "U+005D RIGHT SQUARE BRACKET (])"
			}
			dd {
				- "Emit a U+005D RIGHT SQUARE BRACKET character token."
			}
			dt {
				- "U+003E GREATER-THAN SIGN (>)"
			}
			dd {
				- "Switch to the "
				a href="#data-state" id="cdata-section-end-state:data-state" {
					- "data state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "Emit two U+005D RIGHT SQUARE BRACKET character tokens. "
				a href="#reconsume" id="cdata-section-end-state:reconsume" {
					- "Reconsume"
				}
				- " in the\n    "
				a href="#cdata-section-state" id="cdata-section-end-state:cdata-section-state" {
					- "CDATA section state"
				}
				- "."
			}
		}
		- "\n\n\n\n  "
		h5 id="character-reference-state" {
			span class="secno" {
				- "13.2.5.72"
			}
			- " "
			dfn {
				- "Character reference state"
			}
			a href="#character-reference-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Set the "
			var id="character-reference-state:temporary-buffer" {
				a href="#temporary-buffer" {
					- "temporary buffer"
				}
			}
			- " to the empty string. Append\n   a U+0026 AMPERSAND (&) character to the "
			var id="character-reference-state:temporary-buffer-2" {
				a href="#temporary-buffer" {
					- "temporary\n   buffer"
				}
			}
			- ". Consume the "
			a href="#next-input-character" id="character-reference-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				a href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id="character-reference-state:alphanumeric-ascii-characters" data-x-internal="alphanumeric-ascii-characters" {
					- "ASCII alphanumeric"
				}
			}
			dd {
				a href="#reconsume" id="character-reference-state:reconsume" {
					- "Reconsume"
				}
				- " in the "
				a href="#named-character-reference-state" id="character-reference-state:named-character-reference-state" {
					- "named character reference state"
				}
				- "."
			}
			dt {
				- "U+0023 NUMBER SIGN (#)"
			}
			dd {
				- "Append the "
				a href="#current-input-character" id="character-reference-state:current-input-character" {
					- "current input character"
				}
				- " to the\n   "
				var id="character-reference-state:temporary-buffer-3" {
					a href="#temporary-buffer" {
						- "temporary buffer"
					}
				}
				- ". Switch to the "
				a href="#numeric-character-reference-state" id="character-reference-state:numeric-character-reference-state" {
					- "numeric character\n   reference state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
			dd {
				a href="#flush-code-points-consumed-as-a-character-reference" id="character-reference-state:flush-code-points-consumed-as-a-character-reference" {
					- "Flush code points consumed as a character reference"
				}
				- ". "
				a href="#reconsume" id="character-reference-state:reconsume-2" {
					- "Reconsume"
				}
				- " in\n   the "
				var id="character-reference-state:return-state" {
					a href="#return-state" {
						- "return state"
					}
				}
				- "."
			}
		}
		- "\n\n\n  "
		h5 id="named-character-reference-state" {
			span class="secno" {
				- "13.2.5.73"
			}
			- " "
			dfn {
				- "Named character reference state"
			}
			a href="#named-character-reference-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the maximum number of characters possible, where the consumed characters are one of the\n  identifiers in the first column of the "
			a href="#named-character-references" id="named-character-reference-state:named-character-references" {
				- "named character references"
			}
			- " table. Append each\n  character to the "
			var id="named-character-reference-state:temporary-buffer" {
				a href="#temporary-buffer" {
					- "temporary buffer"
				}
			}
			- " when it's consumed."
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If there is a match"
			}
			dd {
				- "\n    "
				p {
					- "If the character reference was "
					a href="#charref-in-attribute" id="named-character-reference-state:charref-in-attribute" {
						- "consumed as part of an\n    attribute"
					}
					- ", and the last character matched is not a U+003B SEMICOLON character (;), and\n    the "
					a href="#next-input-character" id="named-character-reference-state:next-input-character" {
						- "next input character"
					}
					- " is either a U+003D EQUALS SIGN character (=) or an\n    "
					a id="named-character-reference-state:alphanumeric-ascii-characters" href="https://infra.spec.whatwg.org/#ascii-alphanumeric" data-x-internal="alphanumeric-ascii-characters" {
						- "ASCII alphanumeric"
					}
					- ", then, for historical reasons, "
					a href="#flush-code-points-consumed-as-a-character-reference" id="named-character-reference-state:flush-code-points-consumed-as-a-character-reference" {
						- "flush code points consumed\n    as a character reference"
					}
					- " and switch to the "
					var id="named-character-reference-state:return-state" {
						a href="#return-state" {
							- "return state"
						}
					}
					- ".\n    "
				}
				- "\n    \n\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the last character matched is not a U+003B SEMICOLON character (;), then this is a\n     "
							a href="#parse-error-missing-semicolon-after-character-reference" id="named-character-reference-state:parse-error-missing-semicolon-after-character-reference" {
								- "missing-semicolon-after-character-reference"
							}
							- "\n     "
							a href="#parse-errors" id="named-character-reference-state:parse-errors" {
								- "parse error"
							}
							- "."
						}
					}
					li {
						p {
							- "Set the "
							var id="named-character-reference-state:temporary-buffer-2" {
								a href="#temporary-buffer" {
									- "temporary buffer"
								}
							}
							- " to the empty string.\n     Append one or two characters corresponding to the character reference name (as given by the\n     second column of the "
							a href="#named-character-references" id="named-character-reference-state:named-character-references-2" {
								- "named character references"
							}
							- " table) to the "
							var id="named-character-reference-state:temporary-buffer-3" {
								a href="#temporary-buffer" {
									- "temporary buffer"
								}
							}
							- "."
						}
					}
					li {
						a href="#flush-code-points-consumed-as-a-character-reference" id="named-character-reference-state:flush-code-points-consumed-as-a-character-reference-2" {
							- "Flush code points consumed as a character reference"
						}
						- ". Switch to the "
						var id="named-character-reference-state:return-state-2" {
							a href="#return-state" {
								- "return state"
							}
						}
						- "."
					}
				}
				- "\n   "
			}
			dt {
				- "Otherwise"
			}
			dd {
				a href="#flush-code-points-consumed-as-a-character-reference" id="named-character-reference-state:flush-code-points-consumed-as-a-character-reference-3" {
					- "Flush code points consumed as a character reference"
				}
				- ". Switch to the\n   "
				a href="#ambiguous-ampersand-state" id="named-character-reference-state:ambiguous-ampersand-state" {
					- "ambiguous ampersand state"
				}
				- "."
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n    "
			p {
				- "If the markup contains (not in an attribute) the string "
				code {
					- "I'm &notit; I\n    tell you"
				}
				- ", the character reference is parsed as \"not\", as in, "
				code {
					- "I'm ¬it;\n    I tell you"
				}
				- " (and this is a parse error). But if the markup was "
				code {
					- "I'm\n    &notin; I tell you"
				}
				- ", the character reference would be parsed as \"notin;\", resulting\n    in "
				code {
					- "I'm ∉ I tell you"
				}
				- " (and no parse error)."
			}
			- "\n\n    "
			p {
				- "However, if the markup contains the string "
				code {
					- "I'm &notit; I tell you"
				}
				- "\n    in an attribute, no character reference is parsed and string remains intact (and there is no\n    parse error)."
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h5 id="ambiguous-ampersand-state" {
			span class="secno" {
				- "13.2.5.74"
			}
			- " "
			dfn {
				- "Ambiguous ampersand state"
			}
			a href="#ambiguous-ampersand-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="ambiguous-ampersand-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				a href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id="ambiguous-ampersand-state:alphanumeric-ascii-characters" data-x-internal="alphanumeric-ascii-characters" {
					- "ASCII alphanumeric"
				}
			}
			dd {
				- "If the character reference was "
				a href="#charref-in-attribute" id="ambiguous-ampersand-state:charref-in-attribute" {
					- "consumed as part of an\n    attribute"
				}
				- ", then append the "
				a href="#current-input-character" id="ambiguous-ampersand-state:current-input-character" {
					- "current input character"
				}
				- " to the current\n    attribute's value. Otherwise, emit the "
				a href="#current-input-character" id="ambiguous-ampersand-state:current-input-character-2" {
					- "current input character"
				}
				- " as a character\n    token."
			}
			dt {
				- "U+003B SEMICOLON (;)"
			}
			dd {
				- "This is an "
				a href="#parse-error-unknown-named-character-reference" id="ambiguous-ampersand-state:parse-error-unknown-named-character-reference" {
					- "unknown-named-character-reference"
				}
				- "\n    "
				a href="#parse-errors" id="ambiguous-ampersand-state:parse-errors" {
					- "parse error"
				}
				- ". "
				a href="#reconsume" id="ambiguous-ampersand-state:reconsume" {
					- "Reconsume"
				}
				- " in the "
				var id="ambiguous-ampersand-state:return-state" {
					a href="#return-state" {
						- "return\n    state"
					}
				}
				- ".\n\n    "
			}
			dt {
				- "Anything else"
			}
			dd {
				a href="#reconsume" id="ambiguous-ampersand-state:reconsume-2" {
					- "Reconsume"
				}
				- " in the "
				var id="ambiguous-ampersand-state:return-state-2" {
					a href="#return-state" {
						- "return state"
					}
				}
				- "."
			}
		}
		- "\n\n  "
		h5 id="numeric-character-reference-state" {
			span class="secno" {
				- "13.2.5.75"
			}
			- " "
			dfn {
				- "Numeric character reference state"
			}
			a href="#numeric-character-reference-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Set the "
			dfn id="character-reference-code" {
				var {
					- "character reference code"
				}
			}
			- " to\n  zero (0)."
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="numeric-character-reference-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "U+0078 LATIN SMALL LETTER X"
			}
			dt {
				- "U+0058 LATIN CAPITAL LETTER X"
			}
			dd {
				- "Append the "
				a href="#current-input-character" id="numeric-character-reference-state:current-input-character" {
					- "current input character"
				}
				- " to the "
				var id="numeric-character-reference-state:temporary-buffer" {
					a href="#temporary-buffer" {
						- "temporary buffer"
					}
				}
				- ". Switch to the "
				a href="#hexadecimal-character-reference-start-state" id="numeric-character-reference-state:hexadecimal-character-reference-start-state" {
					- "hexadecimal character reference start\n    state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
			dd {
				a href="#reconsume" id="numeric-character-reference-state:reconsume" {
					- "Reconsume"
				}
				- " in the "
				a href="#decimal-character-reference-start-state" id="numeric-character-reference-state:decimal-character-reference-start-state" {
					- "decimal character reference start state"
				}
				- "."
			}
		}
		- "\n\n\n  "
		h5 id="hexadecimal-character-reference-start-state" {
			span class="secno" {
				- "13.2.5.76"
			}
			- " "
			dfn {
				- "Hexadecimal character reference start state"
			}
			a href="#hexadecimal-character-reference-start-state" class="self-link"
		}
		- "\n\n  "
		p {
			- "Consume the "
			a href="#next-input-character" id="hexadecimal-character-reference-start-state:next-input-character" {
				- "next input character"
			}
			- ":"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				a href="https://infra.spec.whatwg.org/#ascii-hex-digit" id="hexadecimal-character-reference-start-state:ascii-hex-digits" data-x-internal="ascii-hex-digits" {
					- "ASCII hex digit"
				}
			}
			dd {
				a href="#reconsume" id="hexadecimal-character-reference-start-state:reconsume" {
					- "Reconsume"
				}
				- " in the "
				a href="#hexadecimal-character-reference-state" id="hexadecimal-character-reference-start-state:hexadecimal-character-reference-state" {
					- "hexadecimal character reference state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
