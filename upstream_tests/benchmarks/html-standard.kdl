							- "Document"
						}
					}
					- " object."
				}
				- "\n   "
			}
			dt {
				- "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C\n   FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
			}
