						- "isPopover"
					}
					- " is true, then "
					a href="https://infra.spec.whatwg.org/#map-set" id="the-popover-attribute:map-set-2" data-x-internal="map-set" {
						- "set"
					}
					- "\n   "
					var {
						- "popoverPositions"
					}
					- "["
					var {
						- "newPopoverOrTopLayerElement"
					}
					- "] to "
					var {
						- "index"
					}
					- "."
				}
			}
			li {
				p {
					- "Increment "
					var {
						- "index"
					}
					- " by 1."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "topmostPopoverAncestor"
					}
					- " be null."
