										- "\n\n          "
										p class="note" {
											- "For attributes on "
											a href="#html-elements" id="serialising-html-fragments:html-elements-2" {
												- "HTML elements"
											}
											- " set by the "
											a href="#html-parser" id="serialising-html-fragments:html-parser-2" {
												- "HTML\n          parser"
											}
											- " or by "
											code id="serialising-html-fragments:dom-element-setattribute" {
												a data-x-internal="dom-element-setattribute" href="https://dom.spec.whatwg.org/#dom-element-setattribute" {
													- "setAttribute()"
												}
											}
											- ", the\n          local name will be lowercase."
										}
										- "\n         "
									}
