		- "\n\n  \n\n\n\n\n  "
		h4 id="downloading-resources" {
			span class="secno" {
				- "4.6.5"
			}
			- " Downloading resources"
			a href="#downloading-resources" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
