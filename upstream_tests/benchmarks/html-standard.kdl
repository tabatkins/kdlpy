											}
											- " it for "
											var {
												- "reaction"
											}
											- "'s "
											a href="#custom-element-definition" id="custom-element-reactions:custom-element-definition-5" {
												- "custom element\n          definition"
											}
											- "'s "
											a href="#concept-custom-element-definition-constructor" id="custom-element-reactions:concept-custom-element-definition-constructor" {
												- "constructor"
											}
											- "'s corresponding\n          JavaScript object's "
											a id="custom-element-reactions:associated-realm" href="https://webidl.spec.whatwg.org/#dfn-associated-realm" data-x-internal="associated-realm" {
												- "associated realm"
											}
											- "'s "
											a href="#concept-realm-global" id="custom-element-reactions:concept-realm-global" {
												- "global object"
											}
											- "."
										}
										- "\n         "
									}
									dt {
										a href="#callback-reaction" id="custom-element-reactions:callback-reaction-2" {
											- "callback reaction"
										}
									}
									dd {
										- "\n          "
										p {
											a href="https://webidl.spec.whatwg.org/#invoke-a-callback-function" id="custom-element-reactions:es-invoking-callback-functions" data-x-internal="es-invoking-callback-functions" {
												- "Invoke"
											}
											- " "
											var {
												- "reaction"
											}
											- "'s\n          callback function with "
											var {
												- "reaction"
											}
