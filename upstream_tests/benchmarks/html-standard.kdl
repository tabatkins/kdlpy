		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "A"
					}
					- " and "
					var {
						- "B"
					}
					- " are the same "
					a href="#concept-origin-opaque" id="origin:concept-origin-opaque-4" {
