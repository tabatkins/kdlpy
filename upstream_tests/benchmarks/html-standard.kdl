				- "\n\n   "
			}
			li {
				p {
					- "If "
					var {
						- "position"
					}
					- " is "
					em {
						- "not"
					}
					- " beyond the end of "
					var {
						- "input"
					}
					- ", then fail."
				}
			}
			li {
				- "\n    "
				p {
					- "If the "
					var {
						- "date present"
					}
					- " flag is true and the "
					var {
						- "time present"
					}
					- "\n    flag is false, then let "
					var {
						- "date"
					}
					- " be the date with year "
					var {
						- "year"
					}
					- ",\n    month "
					var {
						- "month"
					}
					- ", and day "
					var {
