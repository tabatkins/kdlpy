						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "11"
						}
					}
					hr
					span class="firefox_android yes" {
						span {
							- "Firefox Android"
						}
						span {
							- "4+"
						}
					}
					span class="safari_ios no" {
						span {
							- "Safari iOS"
						}
						span {
							- "No"
						}
					}
					span class="chrome_android yes" {
						span {
							- "Chrome Android"
						}
						span {
							- "18+"
						}
					}
					span class="webview_android yes" {
						span {
