								- "viewport"
							}
							- " size."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The users' screen pixel density might be different from one another."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "A mobile phone's screen might have three times as many physical pixels per inch\n      compared to another mobile phone's screen, regardless of their physical screen size."
							}
							- "\n\n       "
							svg font-size="2.5" role="img" viewBox="0 0 56 27" font-family="sans-serif" height="170" aria-label="One phone has big pixels, the other has small pixels." {
								- "\n        "
								defs {
									- "\n         "
									pattern id="img-intro-pixel" width="3" patternUnits="userSpaceOnUse" stroke-linecap="round" x="0" y="0" height="3" {
										- "\n          "
										rect fill="black" width="3" x="0" height="3" y="0"
										- "\n          "
										line y2="2.5" stroke="red" x1="0.5" x2="0.5" y1="0.5"
										- "\n          "
										line y2="2.5" stroke="lime" x1="1.5" x2="1.5" y1="0.5"
										- "\n          "
										line y2="2.5" stroke="blue" x1="2.5" x2="2.5" y1="0.5"
										- "\n         "
									}
									- "\n        "
								}
								- "\n        \n        "
								rect width="6" fill="white" stroke="black" x="6" height="12" y="8" rx="1"
								- "\n        "
								rect width="6" fill="white" stroke="black" x="36" height="12" y="8" rx="1"
								- "\n        \n        "
								line y2="24" stroke-width="3" stroke="brown" x1="15" y1="16" x2="22"
								- "\n        "
								circle cx="10" cy="10" fill="url(#img-intro-pixel)" stroke="black" r="8"
								- "\n        "
								line y2="24" stroke-width="3" stroke="brown" x1="45" y1="16" x2="52"
								- "\n        "
								circle cx="120" transform="scale(0.333333)" cy="30" r="24" stroke-width="3" fill="url(#img-intro-pixel)" stroke="black"
								- "\n        \n        "
								text x="20" y="10" dominant-baseline="middle" {
									- "1x"
								}
								- "\n        "
								text x="50" y="10" dominant-baseline="middle" {
									- "3x"
								}
								- "\n       "
							}
							- "\n      "
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The users' zoom level might be different from one another, or might change for a single\n      user over time."
						}
						- "\n\n      "
						p class="example" {
							- "A user might zoom in to a particular image to be able to get a more\n      detailed look."
						}
						- "\n\n      "
						p {
							- "The zoom level and the screen pixel density (the previous point) can both affect the number\n      of physical screen pixels per "
							a href="https://drafts.csswg.org/css-values/#px" id="introduction-3:'px'" data-x-internal="'px'" {
								- "CSS pixel"
							}
							- ". This ratio is usually\n      referred to as "
							dfn id="device-pixel-ratio" {
								- "device-pixel-ratio"
							}
							- "."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The users' screen orientation might be different from one another, or might change for a\n      single user over time."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "A tablet can be held upright or rotated 90 degrees, so that the screen is either\n       \"portrait\" or \"landscape\"."
							}
							- "\n\n       "
							svg font-size="2.5" role="img" viewBox="0 0 60 32" font-family="sans-serif" height="200" aria-label="The tablet has two orientations." {
								- "\n        \n        "
								rect width="14" fill="white" stroke="black" x="6" height="20" y="5" rx="1"
								- "\n        "
								line y2="24" stroke-width="1.1" stroke="black" x1="6" y1="24" x2="20"
								- "\n        "
								text text-anchor="middle" x="13" y="14.5" dominant-baseline="middle" {
									- "Portrait"
								}
								- "\n        "
								rect width="20" fill="white" stroke="black" x="30" height="14" y="11" rx="1"
								- "\n        "
								line y2="11" stroke-width="1.1" stroke="black" x1="31" y1="25" x2="31"
								- "\n        "
								text text-anchor="middle" x="40.5" y="18" dominant-baseline="middle" {
									- "Landscape"
								}
								- "\n       "
							}
							- "\n      "
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The users' network speed, network latency and bandwidth cost might be different from one\n      another, or might change for a single user over time."
						}
						- "\n\n      "
						p class="example" {
							- "A user might be on a fast, low-latency and constant-cost connection while\n      at work, on a slow, low-latency and constant-cost connection while at home, and on a\n      variable-speed, high-latency and variable-cost connection anywhere else."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Authors might want to show the same image content but with different rendered size depending\n    on, usually, the width of the "
					a id="introduction-3:viewport-2" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
						- "viewport"
					}
					- ". This is usually referred to as\n    "
					dfn id="viewport-based-selection" {
						- "viewport-based selection"
					}
					- "."
				}
				- "\n\n    "
				div class="example" {
					- "\n     "
					p {
						- "A web page might have a banner at the top that always spans the entire "
						a id="introduction-3:viewport-3" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- "\n     width. In this case, the rendered size of the image depends on the physical size of the screen\n     (assuming a maximised browser window)."
					}
					- "\n\n     "
					svg viewBox="0 0 52 25.6" height="160" aria-label="The upright-held phone shows a\n     small wolf at the top, and the tablet shows the same image but it is bigger." role="img" {
						- "\n      \n\n      \n      "
						rect width="6" fill="white" stroke="black" x="6" height="12" y="8" rx="1"
						- "\n      "
						rect fill="#716966" x="7" width="4" height="2" y="9"
						- "\n      "
						image xlink:href="/images/wolf.jpg" width="4" x="7" y="9" height="2"
						- "\n\n      \n      "
						rect width="20" fill="white" stroke="black" x="25" height="14" y="6" rx="1"
						- "\n      "
						line y2="6" stroke-width="1.1" stroke="black" x1="26" y1="20" x2="26"
						- "\n      "
						rect fill="#716966" x="27" width="17" height="8.5" y="7"
						- "\n      "
						image xlink:href="/images/wolf.jpg" width="17" x="27" y="7" height="8.5"
						- "\n\n     "
					}
					- "\n    "
				}
				- "\n\n    "
				div class="example" {
					- "\n     "
					p {
						- "Another web page might have images in columns, with a single column for screens with a small\n     physical size, two columns for screens with medium physical size, and three columns for screens\n     with big physical size, with the images varying in rendered size in each case to fill up the\n     "
						a id="introduction-3:viewport-4" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- ". In this case, the rendered size of an image might be "
						em {
							- "bigger"
						}
						- " in\n     the one-column layout compared to the two-column layout, despite the screen being smaller."
					}
					- "\n\n     "
					svg font-size="2.5" role="img" viewBox="0 0 115 32" font-family="sans-serif" height="200" aria-label="The rotated phone shows a top part of an image of a kettlebell swing; the\n     upright-held tablet shows a bit smaller images in two columns; the laptop shows images in three\n     columns." {
						- "\n      \n\n      \n      "
						rect width="12" fill="white" stroke="black" x="6" height="6" y="24" rx="1"
						- "\n      "
						rect fill="#987b5a" width="10" x="7" height="4.5" y="25"
						- "\n      "
						image xlink:href="/images/kettlebell.jpg" preserveAspectRatio="xMinYMin slice" width="10" x="7" y="25" height="4.5"
						- "\n      "
						text text-anchor="middle" x="12" y="21" {
							- "Narrow, 1 column"
						}
						- "\n\n      \n      "
						rect width="14" fill="white" stroke="black" x="32" height="20" y="10" rx="1"
						- "\n      "
						line y2="29" stroke-width="1.1" stroke="black" x1="32" y1="29" x2="46"
						- "\n      "
						rect fill="#987b5a" width="5.5" x="33" height="5.5" y="11"
						- "\n      "
						image xlink:href="/images/kettlebell.jpg" width="5.5" x="33" y="11" height="5.5"
						- "\n      "
						rect fill="burlywood" width="5.5" x="39.5" height="5.5" y="11"
						- "\n      "
						rect fill="silver" width="5.5" x="33" height="5.5" y="17.5"
						- "\n      "
						text text-anchor="middle" x="39" y="7" {
							- "Medium, 2 columns"
						}
						- "\n\n      \n      "
						rect width="40" stroke-width="2" fill="white" stroke="black" x="65" height="26" y="2" rx="2"
						- "\n      "
						line y2="30" stroke-linecap="round" stroke-width="2" stroke="black" x1="61" y1="30" x2="109"
						- "\n      "
						rect fill="#987b5a" width="10" x="67" height="10" y="4"
						- "\n      "
						image xlink:href="/images/kettlebell.jpg" width="10" x="67" y="4" height="10"
						- "\n      "
						rect fill="burlywood" width="10" x="80" height="10" y="4"
						- "\n      "
						rect fill="silver" width="10" x="93" height="10" y="4"
						- "\n      "
						text text-anchor="middle" x="85" y="25" {
							- "Wide, 3 columns"
						}
						- "\n     "
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Authors might want to show different image content depending on the rendered size of the\n    image. This is usually referred to as "
					dfn id="art-direction" {
						- "art direction"
					}
					- "."
				}
				- "\n\n    "
				div class="example" {
					- "\n     "
					p {
						- "When a web page is viewed on a screen with a large physical size (assuming a maximised\n     browser window), the author might wish to include some less relevant parts surrounding the\n     critical part of the image. When the same web page is viewed on a screen with a small physical\n     size, the author might wish to show only the critical part of the image."
					}
					- "\n\n     "
					svg viewBox="0 0 52 25.6" height="160" aria-label="The upright-held phone shows a\n     cropped image of a wolf; the rotated tablet shows the uncropped image." role="img" {
						- "\n      \n\n      \n      "
						rect width="6" fill="white" stroke="black" x="6" height="12" y="8" rx="1"
						- "\n      "
						rect fill="#716966" x="7" width="4" height="6" y="9"
						- "\n      "
						image xlink:href="/images/wolf.jpg" preserveAspectRatio="xMidYMid slice" width="4" x="7" y="9" height="6"
						- "\n\n      \n      "
						rect width="20" fill="white" stroke="black" x="25" height="14" y="6" rx="1"
						- "\n      "
						line y2="6" stroke-width="1.1" stroke="black" x1="26" y1="20" x2="26"
						- "\n      "
						rect fill="#716966" x="27" width="17" height="8.5" y="7"
						- "\n      "
						image xlink:href="/images/wolf.jpg" width="17" x="27" y="7" height="8.5"
						- "\n\n     "
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Authors might want to show the same image content but using different image formats,\n    depending on which image formats the user agent supports. This is usually referred to as\n    "
					dfn id="image-format-based-selection" {
						- "image format-based selection"
					}
					- "."
				}
				- "\n\n    "
				p class="example" {
					- "A web page might have some images in the JPEG, WebP and JPEG XR image\n    formats, with the latter two having better compression abilities compared to JPEG. Since\n    different user agents can support different image formats, with some formats offering better\n    compression ratios, the author would like to serve the better formats to user agents that\n    support them, while providing JPEG fallback for user agents that don't."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The above situations are not mutually exclusive. For example, it is reasonable to combine\n  different resources for different "
			a href="#device-pixel-ratio" id="introduction-3:device-pixel-ratio" {
				- "device-pixel-ratio"
			}
			- " with different resources for\n  "
			a href="#art-direction" id="introduction-3:art-direction" {
				- "art direction"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "While it is possible to solve these problems using scripting, doing so introduces some other\n  problems:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "Some user agents aggressively download images specified in the HTML markup, before scripts\n   have had a chance to run, so that web pages complete loading sooner. If a script changes which\n   image to download, the user agent will potentially start two separate downloads, which can\n   instead cause worse page loading performance."
				}
			}
			li {
				p {
					- "If the author avoids specifying any image in the HTML markup and instead instantiates a\n   single download from script, that avoids the double download problem above but then no image will\n   be downloaded at all for users with scripting disabled and the aggressive image downloading\n   optimization will also be disabled."
				}
			}
		}
		- "\n\n  "
		p {
			- "With this in mind, this specification introduces a number of features to address the above\n  problems in a declarative manner."
		}
		- "\n\n  "
		dl {
			dt {
				a href="#device-pixel-ratio" id="introduction-3:device-pixel-ratio-2" {
					- "Device-pixel-ratio"
				}
				- "-based selection when the rendered size of the image is\n   fixed"
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="introduction-3:attr-img-src-2" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- " and "
					code id="introduction-3:attr-img-srcset" {
						a href="#attr-img-srcset" {
							- "srcset"
						}
					}
					- "\n    attributes on the "
					code id="introduction-3:the-img-element-2" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element can be used, using the "
					code {
						- "x"
					}
					- "\n    descriptor, to provide multiple images that only vary in their size (the smaller image is a\n    scaled-down version of the bigger image)."
				}
				- "\n\n    "
				p class="note" {
					- "The "
					code {
						- "x"
					}
					- " descriptor is not appropriate when the rendered\n    size of the image depends on the "
					a id="introduction-3:viewport-5" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
						- "viewport"
					}
					- " width\n    ("
					a href="#viewport-based-selection" id="introduction-3:viewport-based-selection" {
						- "viewport-based selection"
					}
					- "), but can be used together with\n    "
					a href="#art-direction" id="introduction-3:art-direction-2" {
						- "art direction"
					}
					- "."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n"
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "h2"
							}
							c- p="" {
								- ">"
							}
							- "From today's featured article"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "h2"
							}
							c- p="" {
								- ">"
							}
							- "\n"
							c- p="" {
								- "<"
							}
							c- f="" {
								- "img"
							}
							- " "
							strong {
								c- e="" {
									- "src"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "\"/uploads/100-marie-lloyd.jpg\""
								}
							}
							- "\n     "
							strong {
								c- e="" {
									- "srcset"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "\"/uploads/150-marie-lloyd.jpg 1.5x, /uploads/200-marie-lloyd.jpg 2x\""
								}
							}
							- "\n     "
							c- e="" {
								- "alt"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"\""
							}
							- " "
							c- e="" {
								- "width"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"100\""
							}
							- " "
							c- e="" {
								- "height"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"150\""
							}
							c- p="" {
								- ">"
							}
							- "\n"
							c- p="" {
								- "<"
							}
							c- f="" {
								- "p"
							}
							c- p="" {
								- "><"
							}
							c- f="" {
								- "b"
							}
							c- p="" {
								- "><"
							}
							c- f="" {
								- "a"
							}
							- " "
							c- e="" {
								- "href"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"/wiki/Marie_Lloyd\""
							}
							c- p="" {
								- ">"
							}
							- "Marie Lloyd"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "a"
							}
							c- p="" {
								- "></"
							}
							c- f="" {
								- "b"
							}
							c- p="" {
								- ">"
							}
							- " (1870–1922)\nwas an English "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "a"
							}
							- " "
							c- e="" {
								- "href"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"/wiki/Music_hall\""
							}
							c- p="" {
								- ">"
							}
							- "music hall"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "a"
							}
							c- p="" {
								- ">"
							}
							- " singer, ..."
						}
					}
					- "\n\n     "
					p {
						- "The user agent can choose any of the given resources depending on the user's screen's pixel\n     density, zoom level, and possibly other factors such as the user's network conditions."
					}
					- "\n\n     "
					p {
						- "For backwards compatibility with older user agents that don't yet understand the "
						code id="introduction-3:attr-img-srcset-2" {
							a href="#attr-img-srcset" {
								- "srcset"
							}
						}
						- " attribute, one of the URLs is specified in the\n     "
						code id="introduction-3:the-img-element-3" {
							a href="#the-img-element" {
								- "img"
							}
						}
						- " element's "
						code id="introduction-3:attr-img-src-3" {
							a href="#attr-img-src" {
								- "src"
							}
						}
						- " attribute. This will result\n     in something useful (though perhaps lower-resolution than the user would like) being displayed\n     even in older user agents. For new user agents, the "
						code id="introduction-3:attr-img-src-4" {
							a href="#attr-img-src" {
								- "src"
							}
						}
						- "\n     attribute participates in the resource selection, as if it was specified in "
						code id="introduction-3:attr-img-srcset-3" {
							a href="#attr-img-srcset" {
								- "srcset"
							}
						}
						- " with a "
						code {
							- "1x"
						}
						- " descriptor."
					}
					- "\n\n     "
					p {
						- "The image's rendered size is given in the "
						code id="introduction-3:attr-dim-width" {
							a href="#attr-dim-width" {
								- "width"
							}
						}
						- " and\n     "
						code id="introduction-3:attr-dim-height" {
							a href="#attr-dim-height" {
								- "height"
							}
						}
						- " attributes, which allows the user agent to\n     allocate space for the image before it is downloaded."
					}
					- "\n\n    "
				}
				- "\n   "
			}
			dt {
				a href="#viewport-based-selection" id="introduction-3:viewport-based-selection-2" {
					- "Viewport-based selection"
				}
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="introduction-3:attr-img-srcset-4" {
						a href="#attr-img-srcset" {
							- "srcset"
						}
					}
					- " and "
					code id="introduction-3:attr-img-sizes" {
						a href="#attr-img-sizes" {
							- "sizes"
						}
					}
					- " attributes can be used, using the "
					code {
						- "w"
					}
					- "\n    descriptor, to provide multiple images that only vary in their size (the smaller image is a\n    scaled-down version of the bigger image)."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In this example, a banner image takes up the entire "
						a id="introduction-3:viewport-6" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
