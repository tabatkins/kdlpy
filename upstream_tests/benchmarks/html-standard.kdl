			}
			dd {
				p {
					- "The distance from the horizontal line indicated by the "
					code id="drawing-text-to-the-bitmap:dom-context-2d-textbaseline-9" {
						a href="#dom-context-2d-textbaseline" {
							- "textBaseline"
						}
					}
					- " attribute to the "
