							- "dialog"
						}
					}
					- " element, then return\n   "
					var {
						- "element"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					code id="the-autofocus-attribute:attr-popover-2" {
						a href="#attr-popover" {
							- "popover"
						}
					}
					- " attribute is not in the\n   "
					a href="#attr-popover-none-state" id="the-autofocus-attribute:attr-popover-none-state" {
						- "no popover state"
					}
					- ", then return\n   "
					var {
						- "element"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "ancestor"
					}
					- " be "
					var {
						- "element"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "While "
					var {
						- "ancestor"
					}
					- " has a "
					a id="the-autofocus-attribute:parent-element" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
						- "parent element"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "ancestor"
							}
							- " to "
							var {
								- "ancestor"
							}
							- "'s "
							a id="the-autofocus-attribute:parent-element-2" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
								- "parent element"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "ancestor"
							}
							- " is a "
							code id="the-autofocus-attribute:the-dialog-element-3" {
								a href="#the-dialog-element" {
									- "dialog"
								}
							}
							- " element, then return\n     "
							var {
								- "ancestor"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "ancestor"
							}
							- "'s "
							code id="the-autofocus-attribute:attr-popover-3" {
								a href="#attr-popover" {
