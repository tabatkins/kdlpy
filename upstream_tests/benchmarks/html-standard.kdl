			}
			- ", which is an "
			a href="#htmldialogelement" id="the-dialog-element:htmldialogelement" {
				- "HTML dialog element"
			}
			- " or null, initially null."
		}
		- "\n\n  "
		p {
			- "Each "
			code id="the-dialog-element:the-dialog-element-25" {
				a href="#the-dialog-element" {
					- "dialog"
				}
			}
			- " element has a "
			dfn id="dialog-close-watcher" {
				- "close watcher"
			}
			- ",\n  which is a "
			a href="#close-watcher" id="the-dialog-element:close-watcher" {
				- "close watcher"
			}
			- " or null, initially null."
		}
		- "\n\n  "
