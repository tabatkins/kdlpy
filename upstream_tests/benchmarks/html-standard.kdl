		- "\n\n  "
		p {
			- "The "
			a href="#form-associated-element" id="categories:form-associated-element" {
				- "form-associated elements"
			}
			- " fall into several\n  subcategories:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="category-listed" {
					- "Listed elements"
				}
			}
			dd {
				- "\n    "
				p {
					- "Denotes elements that are listed in the "
					code id="categories:dom-form-elements" {
						a href="#dom-form-elements" {
							var {
								- "form"
							}
							- ".elements"
						}
					}
					- " and "
					code id="categories:dom-fieldset-elements" {
						a href="#dom-fieldset-elements" {
							var {
