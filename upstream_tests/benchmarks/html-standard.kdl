			var {
				- "maxWidth"
			}
			- ". It returns an array of glyph shapes, each positioned on a common coordinate\n  space, a "
			var {
				- "physical alignment"
			}
			- " whose value is one of "
			i {
				- "left"
			}
			- ", "
			i {
				- "right"
			}
			- ", and\n  "
			i {
				- "center"
			}
			- ", and an "
			a id="text-styles:inline-box" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
				- "inline box"
			}
			- ". (Most callers of this algorithm ignore the\n  "
			var {
				- "physical alignment"
			}
			- " and the "
			a id="text-styles:inline-box-2" href="https://drafts.csswg.org/css2/#inline-box" data-x-internal="inline-box" {
				- "inline box"
			}
			- ".)"
