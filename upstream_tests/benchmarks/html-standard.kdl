						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="reset-button-state-(type=reset):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="reset-button-state-(type=reset):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#reset-button-state-(type=reset)" id="reset-button-state-(type=reset):reset-button-state-(type=reset)" {
				- "Reset Button"
			}
			- " state, the rules in this section\n  apply."
		}
		- "\n\n  \n\n  "
		p {
			- "\n  "
			a id="reset-button-state-(type=reset):tracking-vector" title="There is a tracking vector here." href="https://infra.spec.whatwg.org/#tracking-vector" class="tracking-vector" data-x-internal="tracking-vector" {
				img width="46" alt="(This is a tracking vector.)" crossorigin="" src="https://resources.whatwg.org/tracking-vector.svg" height="64"
			}
			- "\n  The "
			code id="reset-button-state-(type=reset):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="reset-button-state-(type=reset):represents" {
				- "represents"
			}
			- " a button that, when activated, resets the\n  form. If the element has a "
			code id="reset-button-state-(type=reset):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute,\n  the button's label must be the value of that attribute; otherwise, it must be an\n  "
			a id="reset-button-state-(type=reset):implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " string that means \"Reset\" or some such. The element is\n  a "
			a href="#concept-button" id="reset-button-state-(type=reset):concept-button" {
				- "button"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "Since the default label is "
			a id="reset-button-state-(type=reset):implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- ", and the width of\n  the button typically depends on the button's label, the button's width can leak a few bits of\n  fingerprintable information. These bits are likely to be strongly correlated to the identity of\n  the user agent and the user's locale."
		}
		- "\n\n  \n\n  "
