			li {
				p {
					- "If "
					a id="relaxing-the-same-origin-restriction:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#active-sandboxing-flag-set" id="relaxing-the-same-origin-restriction:active-sandboxing-flag-set" {
						- "active sandboxing flag set"
					}
					- " has its "
					a href="#sandboxed-document.domain-browsing-context-flag" id="relaxing-the-same-origin-restriction:sandboxed-document.domain-browsing-context-flag" {
						- "sandboxed\n   "
						code {
							- "document.domain"
						}
						- " browsing context flag"
					}
					- " set, then\n   throw a "
					a id="relaxing-the-same-origin-restriction:securityerror-3" href="https://webidl.spec.whatwg.org/#securityerror" data-x-internal="securityerror" {
						- "\""
						code {
							- "SecurityError"
						}
						- "\""
					}
					- " "
					code id="relaxing-the-same-origin-restriction:domexception-2" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "effectiveDomain"
					}
					- " be "
					a id="relaxing-the-same-origin-restriction:this-4" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="relaxing-the-same-origin-restriction:concept-document-origin-2" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-effective-domain" id="relaxing-the-same-origin-restriction:concept-origin-effective-domain-2" {
						- "effective domain"
					}
					- ".\n\n   "
				}
			}
			li {
				p {
					- "If "
					var {
						- "effectiveDomain"
					}
					- " is null, then throw a\n   "
					a id="relaxing-the-same-origin-restriction:securityerror-4" href="https://webidl.spec.whatwg.org/#securityerror" data-x-internal="securityerror" {
						- "\""
						code {
							- "SecurityError"
						}
						- "\""
					}
					- " "
					code id="relaxing-the-same-origin-restriction:domexception-3" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If the given value "
					a href="#is-a-registrable-domain-suffix-of-or-is-equal-to" id="relaxing-the-same-origin-restriction:is-a-registrable-domain-suffix-of-or-is-equal-to" {
						- "is not\n   a registrable domain suffix of and is not equal to"
					}
					- " "
					var {
						- "effectiveDomain"
					}
					- ", then throw\n   a "
					a id="relaxing-the-same-origin-restriction:securityerror-5" href="https://webidl.spec.whatwg.org/#securityerror" data-x-internal="securityerror" {
						- "\""
						code {
							- "SecurityError"
						}
						- "\""
					}
					- " "
					code id="relaxing-the-same-origin-restriction:domexception-4" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					a id="relaxing-the-same-origin-restriction:surrounding-agent" href="https://tc39.es/ecma262/#surrounding-agent" data-x-internal="surrounding-agent" {
						- "surrounding agent"
					}
					- "'s "
					a id="relaxing-the-same-origin-restriction:agent-cluster" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
						- "agent cluster"
					}
					- "'s "
					a href="#is-origin-keyed" id="relaxing-the-same-origin-restriction:is-origin-keyed" {
						- "is\n   origin-keyed"
					}
					- " is true, then return."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "this"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="relaxing-the-same-origin-restriction:concept-document-origin-3" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-domain" id="relaxing-the-same-origin-restriction:concept-origin-domain-2" {
						- "domain"
					}
					- " to the result of "
					a href="https://url.spec.whatwg.org/#concept-host-parser" id="relaxing-the-same-origin-restriction:host-parser" data-x-internal="host-parser" {
						- "parsing"
					}
					- " the given value."
				}
			}
		}
		- "\n\n  "
		p {
			- "To determine if a "
			a id="relaxing-the-same-origin-restriction:scalar-value-string" href="https://infra.spec.whatwg.org/#scalar-value-string" data-x-internal="scalar-value-string" {
				- "scalar value string"
			}
			- " "
			var {
