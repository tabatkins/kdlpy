				a href="#attr-textarea-placeholder" {
					- "placeholder"
				}
			}
			- " attribute. User agents may take the\n  text caret size into account in the "
			a id="the-textarea-element-2:intrinsic-size-2" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- ". Otherwise, its\n  "
			a id="the-textarea-element-2:intrinsic-size-3" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " is computed from "
			a href="#textarea-effective-width" id="the-textarea-element-2:textarea-effective-width" {
				- "textarea effective width"
			}
			- " and\n  "
			a href="#textarea-effective-height" id="the-textarea-element-2:textarea-effective-height" {
				- "textarea effective height"
			}
			- " (as defined below)."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="textarea-effective-width" {
