		- "\n\n  "
		p {
			- "The Temporal proposal contains an "
			a id="hostsystemutcepochnanoseconds:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " "
			a href="https://tc39.es/proposal-temporal/#sec-hostsystemutcepochnanoseconds" id="hostsystemutcepochnanoseconds:js-hostsystemutcepochnanoseconds" data-x-internal="js-hostsystemutcepochnanoseconds" {
				- "HostSystemUTCEpochNanoseconds"
			}
			- " abstract operation.\n  User agents must use the following implementation: "
			a href="#refsJSTEMPORAL" {
				- "[JSTEMPORAL]"
			}
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "settingsObject"
					}
					- " be "
					var {
						- "global"
					}
					- "'s "
					a href="#relevant-settings-object" id="hostsystemutcepochnanoseconds:relevant-settings-object" {
						- "relevant settings\n   object"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "time"
					}
