					a href="#concept-agent-event-loop" id="integration-with-the-javascript-agent-formalism:concept-agent-event-loop" {
						- "event loop"
					}
					- " to a new\n   "
					a href="#event-loop" id="integration-with-the-javascript-agent-formalism:event-loop" {
						- "event loop"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "agent"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "For a "
			a id="integration-with-the-javascript-agent-formalism:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- " "
