				}
			}
			- " extended attribute have the following\n  "
			a id="html-element-constructors:overridden-constructor-steps" href="https://webidl.spec.whatwg.org/#overridden-constructor-steps" data-x-internal="overridden-constructor-steps" {
				- "overridden constructor steps"
			}
			- ":"
		}
