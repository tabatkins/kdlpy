			- "\n\n   "
			p {
				- "Some notable features gained by using a JavaScript module script include the ability to import\n   functions from other JavaScript modules, strict mode by default, and how top-level declarations\n   do not introduce new properties onto the "
				a href="#global-object" id="the-script-element:global-object" {
					- "global object"
				}
				- ". Also note that no matter\n   where this "
				code id="the-script-element:the-script-element-24" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element appears in the document, it will not be evaluated until\n   both document parsing has complete and its dependency ("
				code {
					- "dom-utils.mjs"
				}
				- ") has\n   been fetched and evaluated."
			}
			- "\n  "
		}
		- "\n\n  "
