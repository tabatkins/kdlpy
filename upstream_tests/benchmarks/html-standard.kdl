				- "node document"
			}
			- "'s "
			a href="#concept-document-bc" id="enabling-and-disabling-scripting:concept-document-bc" {
				- "browsing\n  context"
			}
			- " is non-null, and "
			a href="#concept-environment-script" id="enabling-and-disabling-scripting:concept-environment-script-2" {
				- "scripting is\n  enabled"
			}
			- " for "
			var {
				- "node"
			}
			- "'s "
			a href="#relevant-settings-object" id="enabling-and-disabling-scripting:relevant-settings-object" {
				- "relevant settings object"
			}
			- "."
		}
		- "\n\n  "
		p {
			dfn id="concept-n-noscript" {
				- "Scripting is disabled"
			}
			- " for a node when scripting is not\n  "
			a href="#concept-n-script" id="enabling-and-disabling-scripting:concept-n-script" {
				- "enabled"
			}
			- ", i.e., when its "
			a id="enabling-and-disabling-scripting:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node document"
			}
			- "'s "
			a href="#concept-document-bc" id="enabling-and-disabling-scripting:concept-document-bc-2" {
				- "browsing context"
			}
			- " is null or when "
			a href="#concept-environment-noscript" id="enabling-and-disabling-scripting:concept-environment-noscript" {
				- "scripting is disabled"
			}
			- " for its "
			a href="#relevant-settings-object" id="enabling-and-disabling-scripting:relevant-settings-object-2" {
				- "relevant settings\n  object"
			}
			- "."
		}
		- "\n\n  "
		h5 id="secure-contexts" {
			span class="secno" {
				- "8.1.3.5"
			}
			- " Secure contexts"
			a href="#secure-contexts" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			a href="#environment" id="secure-contexts:environment" {
				- "environment"
			}
			- " "
			var {
				- "environment"
			}
			- " is a "
			dfn id="secure-context" data-lt="secure context|Is\n  an environment settings object contextually secure?" data-export="" {
				- "secure context"
			}
			- " if the following\n  algorithm returns true:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "environment"
					}
					- " is an "
					a href="#environment-settings-object" id="secure-contexts:environment-settings-object" {
						- "environment settings object"
					}
					- ", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "global"
							}
							- " be "
							var {
								- "environment"
							}
							- "'s "
							a href="#concept-settings-object-global" id="secure-contexts:concept-settings-object-global" {
								- "global object"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "global"
							}
							- " is a "
							code id="secure-contexts:workerglobalscope" {
								a href="#workerglobalscope" {
									- "WorkerGlobalScope"
								}
							}
							- ", then:\n\n      "
						}
						ol {
							li {
								- "\n        "
								p {
									- "If "
									var {
										- "global"
									}
									- "'s "
									a href="#concept-WorkerGlobalScope-owner-set" id="secure-contexts:concept-WorkerGlobalScope-owner-set" {
										- "owner set"
									}
									- "[0]'s "
									a href="#relevant-settings-object" id="secure-contexts:relevant-settings-object" {
										- "relevant settings object"
									}
									- "\n        is a "
									a href="#secure-context" id="secure-contexts:secure-context" {
										- "secure context"
									}
									- ", then return true."
								}
								- "\n\n        "
								p class="note" {
									- "We only need to check the 0th item since they will necessarily all be\n        consistent."
								}
								- "\n       "
							}
							li {
								p {
									- "Return false."
								}
							}
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "global"
							}
							- " is a "
							code id="secure-contexts:workletglobalscope" {
								a href="#workletglobalscope" {
									- "WorkletGlobalScope"
								}
							}
							- ", then return true."
						}
						- "\n\n      "
						p class="note" {
							- "Worklets can only be created in secure contexts."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If the result of "
					a id="secure-contexts:is-url-potentially-trustworthy" href="https://w3c.github.io/webappsec-secure-contexts/#potentially-trustworthy-url" data-x-internal="is-url-potentially-trustworthy" {
						- "Is url potentially trustworthy?"
					}
					- " given\n   "
					var {
						- "environment"
					}
					- "'s "
					a href="#concept-environment-top-level-creation-url" id="secure-contexts:concept-environment-top-level-creation-url" {
						- "top-level creation URL"
					}
					- " is \""
					code {
						- "Potentially\n   Trustworthy"
					}
					- "\", then return true."
				}
			}
			li {
				p {
					- "Return false."
				}
			}
		}
		- "\n\n  "
		p {
			- "An "
			a href="#environment" id="secure-contexts:environment-2" {
				- "environment"
			}
			- " is a "
			dfn id="non-secure-context" data-export="" {
				- "non-secure context"
			}
			- " if it is not a\n  "
			a href="#secure-context" id="secure-contexts:secure-context-2" {
