						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-noncharacter-in-input-stream" {
							- "noncharacter-in-input-stream"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the "
							a href="#input-stream" id="parse-errors:input-stream-9" {
								- "input stream"
							}
							- " contains a "
							a id="parse-errors:noncharacter-2" href="https://infra.spec.whatwg.org/#noncharacter" data-x-internal="noncharacter" {
								- "noncharacter"
							}
							- ".\n     Such "
							a href="https://infra.spec.whatwg.org/#code-point" id="parse-errors:code-point-18" data-x-internal="code-point" {
								- "code points"
							}
							- " are parsed as-is and usually, where parsing\n     rules don't apply any additional restrictions, make their way into the DOM."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-non-void-html-element-start-tag-with-trailing-solidus" {
							- "non-void-html-element-start-tag-with-trailing-solidus"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters a "
							a href="#syntax-start-tag" id="parse-errors:syntax-start-tag-4" {
								- "start\n      tag"
							}
							- " for an element that is not in the list of "
							a href="#void-elements" id="parse-errors:void-elements" {
								- "void elements"
							}
							- " or is not a\n      part of foreign content (i.e., not an SVG or MathML element) that has a U+002F (/) "
							a id="parse-errors:code-point-19" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code\n      point"
							}
							- " right before the closing U+003E (>) code point. The parser behaves as if the\n      U+002F (/) is not present."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "For example, consider the following markup:"
							}
							- "\n\n       "
							pre {
								code class="html" {
									c- p="" {
										- "<"
									}
									c- f="" {
										- "div"
									}
									c- p="" {
										- "/><"
									}
									c- f="" {
										- "span"
									}
									c- p="" {
										- "></"
									}
									c- f="" {
										- "span"
									}
									c- p="" {
										- "><"
									}
									c- f="" {
										- "span"
									}
									c- p="" {
										- "></"
									}
									c- f="" {
										- "span"
									}
									c- p="" {
										- ">"
									}
								}
							}
							- "\n\n       "
							p {
								- "This will be parsed into:"
							}
							- "\n\n       "
							ul class="domTree" {
								li class="t1" {
									code id="parse-errors:the-html-element-2" {
										a href="#the-html-element" {
											- "html"
										}
									}
									ul {
										li class="t1" {
											code id="parse-errors:the-head-element-2" {
												a href="#the-head-element" {
													- "head"
												}
											}
										}
										li class="t1" {
											code id="parse-errors:the-body-element-2" {
												a href="#the-body-element" {
													- "body"
												}
											}
											ul {
												li class="t1" {
													code id="parse-errors:the-div-element" {
														a href="#the-div-element" {
															- "div"
														}
													}
													ul {
														li class="t1" {
															code id="parse-errors:the-span-element" {
																a href="#the-span-element" {
																	- "span"
																}
															}
														}
														li class="t1" {
															code id="parse-errors:the-span-element-2" {
																a href="#the-span-element" {
																	- "span"
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
							- "\n      "
						}
						- "\n\n      "
						p class="note" {
							- "The trailing U+002F (/) in a start tag name can be used only in foreign\n      content to specify self-closing tags. (Self-closing tags don't exist in HTML.) It is also\n      allowed for void elements, but doesn't have any effect in this case."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-null-character-reference" {
							- "null-character-reference"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a numeric "
							a href="#syntax-charref" id="parse-errors:syntax-charref-6" {
								- "character reference"
							}
							- " that references a U+0000 NULL "
							a id="parse-errors:code-point-20" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code\n     point"
							}
							- ". The parser resolves such character references to a U+FFFD REPLACEMENT\n     CHARACTER."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-surrogate-character-reference" {
							- "surrogate-character-reference"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a numeric "
							a href="#syntax-charref" id="parse-errors:syntax-charref-7" {
								- "character reference"
							}
							- " that references a "
							a id="parse-errors:surrogate" href="https://infra.spec.whatwg.org/#surrogate" data-x-internal="surrogate" {
								- "surrogate"
							}
							- ".\n     The parser resolves such character references to a U+FFFD REPLACEMENT CHARACTER."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-surrogate-in-input-stream" {
							- "surrogate-in-input-stream"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the "
							a href="#input-stream" id="parse-errors:input-stream-10" {
								- "input stream"
							}
							- " contains a "
							a href="https://infra.spec.whatwg.org/#surrogate" id="parse-errors:surrogate-2" data-x-internal="surrogate" {
								- "surrogate"
							}
							- ". Such "
							a href="https://infra.spec.whatwg.org/#code-point" id="parse-errors:code-point-21" data-x-internal="code-point" {
								- "code points"
							}
							- " are\n      parsed as-is and usually, where parsing rules don't apply any additional restrictions, make\n      their way into the DOM."
						}
						- "\n\n      "
						p class="note" {
							- "Surrogates can only find their way into the input stream via script APIs such\n      as "
							code id="parse-errors:dom-document-write" {
