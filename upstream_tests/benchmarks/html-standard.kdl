			li {
				- "\n    "
				p {
					- "If the "
					var {
						- "claimed type"
					}
					- " is known, then alter "
					var {
						- "filename"
					}
					- " to\n    add an "
					a href="#concept-extension" id="downloading-resources:concept-extension-5" {
						- "extension"
					}
					- " corresponding to "
					var {
						- "claimed\n    type"
