						}
						- " followed by a U+002F SOLIDUS character (/)\n     followed by a "
						a href="#valid-vevent-duration-string" id="vevent:valid-vevent-duration-string-2" {
							- "valid vevent duration string"
						}
						- "."
					}
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vevent:md-vevent-rdate" {
						a href="#md-vevent-rdate" {
							- "rdate"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item-21" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-22" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-rrule" {
					code {
						- "rrule"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives a rule for finding dates and times at which the event occurs."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-24" {
						- "value"
					}
					- " must be text that matches the RECUR\n    value type defined in "
					cite {
						- "iCalendar"
					}
					- ". "
					a href="#refsRFC5545" {
						- "[RFC5545]"
					}
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-rrule" {
						a href="#md-vevent-rrule" {
							- "rrule"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item-22" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-23" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-created" {
					code {
						- "created"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the date and time at which the event information was first created in a calendaring\n    system."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-25" {
						- "value"
					}
					- " must be text that is a "
					a href="#valid-global-date-and-time-string" id="vevent:valid-global-date-and-time-string-8" {
						- "valid\n    global date and time string"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-created" {
						a href="#md-vevent-created" {
							- "created"
						}
					}
					- " may be present\n    within each "
					a href="#concept-item" id="vevent:concept-item-23" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-24" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-last-modified" {
					code {
						- "last-modified"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the date and time at which the event information was last modified in a calendaring\n    system."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-26" {
						- "value"
					}
					- " must be text that is a "
					a href="#valid-global-date-and-time-string" id="vevent:valid-global-date-and-time-string-9" {
						- "valid\n    global date and time string"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-last-modified" {
						a href="#md-vevent-last-modified" {
							- "last-modified"
						}
					}
					- "\n    may be present within each "
					a href="#concept-item" id="vevent:concept-item-24" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-25" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-vevent-sequence" {
					code {
						- "sequence"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives a revision number for the event information."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vevent:concept-property-value-27" {
						- "value"
					}
					- " must be text that is a "
					a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer" {
						- "valid\n    non-negative integer"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="vevent:md-vevent-sequence" {
						a href="#md-vevent-sequence" {
							- "sequence"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vevent:concept-item-25" {
						- "item"
					}
					- " with the type "
					code id="vevent:md-vevent-26" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "A string is a "
			dfn id="valid-vevent-duration-string" {
				- "valid vevent duration string"
			}
			- " if it matches the following pattern:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "A U+0050 LATIN CAPITAL LETTER P character (P)."
				}
			}
			li {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "A "
							a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer-2" {
								- "valid non-negative integer"
							}
							- " followed by a U+0057 LATIN CAPITAL LETTER W\n     character (W). The integer represents a duration of that number of weeks."
						}
					}
					li {
						- "\n      "
						p {
							- "At least one, and possible both in this order, of the following:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "A "
									a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer-3" {
										- "valid non-negative integer"
									}
									- " followed by a U+0044 LATIN CAPITAL LETTER D\n       character (D). The integer represents a duration of that number of days."
								}
							}
							li {
								- "\n        "
								p {
									- "A U+0054 LATIN CAPITAL LETTER T character (T) followed by any one of the following, or\n        the first and second of the following in that order, or the second and third of the\n        following in that order, or all three of the following in this order:"
								}
								- "\n\n        "
								ol {
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer-4" {
												- "valid non-negative integer"
											}
											- " followed by a U+0048 LATIN CAPITAL LETTER\n         H character (H). The integer represents a duration of that number of hours."
										}
									}
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer-5" {
												- "valid non-negative integer"
											}
											- " followed by a U+004D LATIN CAPITAL LETTER\n         M character (M). The integer represents a duration of that number of minutes."
										}
									}
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id="vevent:valid-non-negative-integer-6" {
												- "valid non-negative integer"
											}
											- " followed by a U+0053 LATIN CAPITAL LETTER\n         S character (S). The integer represents a duration of that number of seconds."
										}
									}
								}
								- "\n      "
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h5 id="conversion-to-icalendar" {
			span class="secno" {
				- "5.3.2.1"
			}
			- " Conversion to iCalendar"
			a href="#conversion-to-icalendar" class="self-link"
		}
		- "\n\n  "
		p {
			- "Given a list of nodes "
			var {
				- "nodes"
			}
			- " in a "
			code id="conversion-to-icalendar:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ", a user agent must\n  run the following algorithm to "
			dfn id="extracting-vevent-data" {
				- "extract any vEvent data\n  represented by those nodes"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If none of the nodes in "
					var {
						- "nodes"
					}
					- " are "
					a href="#concept-item" id="conversion-to-icalendar:concept-item" {
						- "items"
					}
					- " with the type "
					code id="conversion-to-icalendar:md-vevent" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- ", then there is no\n   vEvent data. Abort the algorithm, returning nothing."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "output"
					}
					- " be an empty string."
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line" {
						- "Add an iCalendar line"
					}
					- " with the type \""
					code {
						- "BEGIN"
					}
					- "\" and the\n   value \""
					code {
						- "VCALENDAR"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-2" {
						- "Add an iCalendar line"
					}
					- " with the type \""
					code {
						- "PRODID"
					}
					- "\" and the\n   value equal to a user-agent-specific string representing the user agent to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-3" {
						- "Add an iCalendar line"
					}
					- " with the type \""
					code {
						- "VERSION"
					}
					- "\" and the\n   value \""
					code {
						- "2.0"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "For each node "
					var {
						- "node"
					}
					- " in "
					var {
						- "nodes"
					}
					- " that is an "
					a href="#concept-item" id="conversion-to-icalendar:concept-item-2" {
						- "item"
					}
					- " with the type "
					code id="conversion-to-icalendar:md-vevent-2" {
						a href="#md-vevent" {
							- "http://microformats.org/profile/hcalendar#vevent"
						}
					}
					- ", run the following\n    steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-4" {
								- "Add an iCalendar line"
							}
							- " with the type \""
							code {
								- "BEGIN"
							}
							- "\" and the\n     value \""
							code {
								- "VEVENT"
							}
							- "\" to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-5" {
								- "Add an iCalendar line"
							}
							- " with the type \""
							code {
								- "DTSTAMP"
							}
							- "\" and a\n     value consisting of an iCalendar DATE-TIME string representing the current date and time, with\n     the annotation \""
							code {
								- "VALUE=DATE-TIME"
							}
							- "\", to "
							var {
								- "output"
							}
							- ".\n     "
							a href="#refsRFC5545" {
								- "[RFC5545]"
							}
						}
					}
					li {
						- "\n      "
						p {
							- "For each element "
							var {
								- "element"
							}
							- " that is "
							a href="#the-properties-of-an-item" id="conversion-to-icalendar:the-properties-of-an-item" {
								- "a property of the item"
							}
							- " "
							var {
								- "node"
							}
							- ": for each name "
							var {
								- "name"
							}
							- " in "
							var {
								- "element"
							}
							- "'s "
							a href="#property-names" id="conversion-to-icalendar:property-names" {
								- "property names"
							}
							- ", run the\n      appropriate set of substeps from the following list:"
						}
						- "\n\n      "
						dl {
							dt {
								- "If the property's "
								a href="#concept-property-value" id="conversion-to-icalendar:concept-property-value" {
									- "value"
								}
								- " is an "
								a href="#concept-item" id="conversion-to-icalendar:concept-item-3" {
									- "item"
								}
							}
							dd {
								- "\n        "
								p {
									- "Skip the property."
								}
								- "\n       "
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-dtend" {
									a href="#md-vevent-dtend" {
										- "dtend"
									}
								}
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-dtstart" {
									a href="#md-vevent-dtstart" {
										- "dtstart"
									}
								}
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-exdate" {
									a href="#md-vevent-exdate" {
										- "exdate"
									}
								}
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-rdate" {
									a href="#md-vevent-rdate" {
										- "rdate"
									}
								}
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-created" {
									a href="#md-vevent-created" {
										- "created"
									}
								}
							}
							dt {
								- "If the property is "
								code id="conversion-to-icalendar:md-vevent-last-modified" {
									a href="#md-vevent-last-modified" {
										- "last-modified"
									}
								}
							}
							dd {
								- "\n        "
								p {
									- "Let "
									var {
										- "value"
									}
									- " be the result of stripping all U+002D HYPHEN-MINUS (-) and\n        U+003A COLON (:) characters from the property's "
									a href="#concept-property-value" id="conversion-to-icalendar:concept-property-value-2" {
										- "value"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "If the property's "
									a href="#concept-property-value" id="conversion-to-icalendar:concept-property-value-3" {
										- "value"
									}
									- " is a "
									a href="#valid-date-string" id="conversion-to-icalendar:valid-date-string" {
										- "valid date\n        string"
									}
									- " then "
									a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-6" {
										- "add an iCalendar line"
									}
									- " with the type "
									var {
										- "name"
									}
									- "\n        and the value "
									var {
										- "value"
									}
									- " to "
									var {
										- "output"
									}
									- ", with the annotation\n        \""
									code {
										- "VALUE=DATE"
									}
									- "\"."
								}
								- "\n\n        "
								p {
									- "Otherwise, if the property's "
									a href="#concept-property-value" id="conversion-to-icalendar:concept-property-value-4" {
										- "value"
									}
									- " is a\n        "
									a href="#valid-global-date-and-time-string" id="conversion-to-icalendar:valid-global-date-and-time-string" {
										- "valid global date and time string"
									}
									- " then "
									a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-7" {
										- "add an iCalendar line"
									}
									- " with\n        the type "
									var {
										- "name"
									}
									- " and the value "
									var {
										- "value"
									}
									- " to "
									var {
										- "output"
									}
									- ", with the annotation \""
									code {
										- "VALUE=DATE-TIME"
									}
									- "\"."
								}
								- "\n\n        "
								p {
									- "Otherwise, skip the property."
								}
								- "\n       "
							}
							dt {
								- "Otherwise"
							}
							dd {
								- "\n        "
								p {
									a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-8" {
										- "Add an iCalendar line"
									}
									- " with the type "
									var {
										- "name"
									}
									- " and the\n        property's "
									a href="#concept-property-value" id="conversion-to-icalendar:concept-property-value-5" {
										- "value"
									}
									- " to "
									var {
										- "output"
									}
									- "."
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					li {
						p {
							a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-9" {
								- "Add an iCalendar line"
							}
							- " with the type \""
							code {
								- "END"
							}
							- "\" and the\n     value \""
							code {
								- "VEVENT"
							}
							- "\" to "
							var {
								- "output"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					a href="#add-an-icalendar-line" id="conversion-to-icalendar:add-an-icalendar-line-10" {
						- "Add an iCalendar line"
					}
					- " with the type \""
					code {
						- "END"
					}
					- "\" and the value\n   \""
					code {
						- "VCALENDAR"
					}
					- "\" to "
					var {
						- "output"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the above algorithm says that the user agent is to "
			dfn id="add-an-icalendar-line" {
				- "add an iCalendar line"
			}
			- "\n  consisting of a type "
			var {
				- "type"
			}
			- ", a value "
			var {
				- "value"
			}
			- ", and optionally\n  an annotation, to a string "
			var {
				- "output"
			}
			- ", it must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "line"
					}
					- " be an empty string."
				}
			}
			li {
				p {
					- "Append "
					var {
						- "type"
					}
					- ", "
					a id="conversion-to-icalendar:converted-to-ascii-uppercase" href="https://infra.spec.whatwg.org/#ascii-uppercase" data-x-internal="converted-to-ascii-uppercase" {
						- "converted to ASCII uppercase"
					}
					- ", to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If there is an annotation:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Append a U+003B SEMICOLON character (;) to "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append the annotation to "
							var {
								- "line"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Append a U+003A COLON character (:) to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				p {
					- "Prefix every U+005C REVERSE SOLIDUS character (\\) in "
					var {
						- "value"
					}
					- " with\n   another U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+002C COMMA character (,) in "
					var {
						- "value"
					}
					- " with a U+005C REVERSE\n   SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+003B SEMICOLON character (;) in "
					var {
						- "value"
					}
					- " with a U+005C\n   REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Replace every U+000D CARRIAGE RETURN U+000A LINE FEED character pair (CRLF) in "
					var {
						- "value"
					}
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN SMALL\n   LETTER N character (n)."
				}
			}
			li {
				p {
					- "Replace every remaining U+000D CARRIAGE RETURN (CR) or U+000A LINE FEED (LF) character in\n   "
					var {
						- "value"
					}
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN\n   SMALL LETTER N character (n)."
				}
			}
			li {
				p {
					- "Append "
					var {
						- "value"
					}
					- " to "
					var {
						- "line"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "maximum length"
					}
					- " be 75."
				}
			}
			li {
				- "\n    "
				p {
					- "While "
					var {
						- "line"
					}
					- "'s "
					a id="conversion-to-icalendar:code-point-length" href="https://infra.spec.whatwg.org/#string-code-point-length" data-x-internal="code-point-length" {
						- "code point length"
					}
					- " is greater than "
					var {
						- "maximum\n    length"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Append the first "
							var {
								- "maximum length"
							}
							- " code points of "
							var {
								- "line"
							}
							- " to\n     "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Remove the first "
							var {
								- "maximum length"
							}
							- " code points from "
							var {
								- "line"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+000D CARRIAGE RETURN character (CR) to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+000A LINE FEED character (LF) to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Append a U+0020 SPACE character to "
							var {
								- "output"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "maximum length"
							}
							- " be 74."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Append (what remains of) "
					var {
						- "line"
					}
					- " to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "Append a U+000D CARRIAGE RETURN character (CR) to "
					var {
						- "output"
					}
					- "."
				}
			}
			li {
				p {
					- "Append a U+000A LINE FEED character (LF) to "
					var {
						- "output"
					}
					- "."
				}
			}
		}
