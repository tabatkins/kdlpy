					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/btoa" title="The btoa() method creates a Base64-encoded ASCII string from a binary string (i.e., a string in which each character in the string is treated as a byte of binary data)." {
								- "btoa"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
