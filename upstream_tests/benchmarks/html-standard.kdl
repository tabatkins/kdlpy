								span {
									- "Safari"
								}
								span {
									- "3+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "4+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "10.5+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "10+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios yes" {
								span {
									- "Safari iOS"
								}
								span {
									- "1+"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android yes" {
								span {
									- "WebView Android"
								}
								span {
									- "37+"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "11+"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Takes the input data, in the form of a Unicode string containing only characters in the range\n    U+0000 to U+00FF, each representing a binary byte with values 0x00 to 0xFF respectively, and\n    converts it to its base64 representation, which it returns."
				}
				- "\n\n    "
				p {
					- "Throws an "
					a id="atob:invalidcharactererror" href="https://webidl.spec.whatwg.org/#invalidcharactererror" data-x-internal="invalidcharactererror" {
						- "\""
						code {
							- "InvalidCharacterError"
						}
						- "\""
					}
					- " "
					code id="atob:domexception" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "\n    exception if the input string contains any out-of-range characters."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "result"
					}
					- " = self."
					a href="#dom-atob" id="dom-atob-dev" {
						- "atob"
					}
					- "("
					var {
						- "data"
					}
					- ")"
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						b title="Support in all current engines." class="all-engines-flag" {
							- "✔"
						}
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/atob" title="The atob() function decodes a string of data which has been encoded using Base64 encoding. You can use the btoa() method to encode and transmit data which may otherwise cause communication problems, then transmit it and use the atob() method to decode the data again. For example, you can encode, transmit, and decode control characters such as ASCII values 0 through 31." {
								- "atob"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "1+"
								}
							}
							span class="safari yes" {
								span {
									- "Safari"
								}
								span {
									- "3+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "4+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "10.5+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "10+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios yes" {
								span {
									- "Safari iOS"
								}
								span {
									- "1+"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android yes" {
								span {
									- "WebView Android"
								}
								span {
									- "37+"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "11+"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Takes the input data, in the form of a Unicode string containing base64-encoded binary data,\n    decodes it, and returns a string consisting of characters in the range U+0000 to U+00FF, each\n    representing a binary byte with values 0x00 to 0xFF respectively, corresponding to that binary\n    data."
				}
				- "\n\n    "
				p {
					- "Throws an "
					a id="atob:invalidcharactererror-2" href="https://webidl.spec.whatwg.org/#invalidcharactererror" data-x-internal="invalidcharactererror" {
						- "\""
						code {
							- "InvalidCharacterError"
						}
						- "\""
					}
					- " "
					code id="atob:domexception-2" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- " if the\n    input string is not valid base64 data."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="WindowOrWorkerGlobalScope" id="dom-btoa" data-dfn-type="method" {
				code id="dom-windowbase64-btoa" {
					- "btoa("
					var {
						- "data"
					}
					- ")"
				}
			}
			- " method must throw an\n  "
			a id="atob:invalidcharactererror-3" href="https://webidl.spec.whatwg.org/#invalidcharactererror" data-x-internal="invalidcharactererror" {
				- "\""
				code {
					- "InvalidCharacterError"
				}
				- "\""
			}
			- " "
			code id="atob:domexception-3" {
				a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
					- "DOMException"
				}
			}
			- " if "
			var {
				- "data"
			}
			- "\n  contains any character whose code point is greater than U+00FF. Otherwise, the user agent must\n  convert "
			var {
				- "data"
			}
			- " to a byte sequence whose "
			var {
				- "n"
			}
			- "th byte is the eight-bit\n  representation of the "
			var {
				- "n"
			}
			- "th code point of "
			var {
				- "data"
			}
			- ", and then must apply\n  "
			a id="atob:forgiving-base64-encode" href="https://infra.spec.whatwg.org/#forgiving-base64-encode" data-x-internal="forgiving-base64-encode" {
				- "forgiving-base64 encode"
			}
			- " to that byte sequence and return the result."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="WindowOrWorkerGlobalScope" id="dom-atob" data-dfn-type="method" {
				code id="dom-windowbase64-atob" {
					- "atob("
					var {
						- "data"
					}
					- ")"
				}
			}
			- " method steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "decodedData"
					}
					- " be the result of running "
					a id="atob:forgiving-base64-decode" href="https://infra.spec.whatwg.org/#forgiving-base64-decode" data-x-internal="forgiving-base64-decode" {
						- "forgiving-base64 decode"
					}
					- "\n   on "
					var {
						- "data"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "decodedData"
					}
					- " is failure, then throw an\n   "
					a id="atob:invalidcharactererror-4" href="https://webidl.spec.whatwg.org/#invalidcharactererror" data-x-internal="invalidcharactererror" {
						- "\""
						code {
							- "InvalidCharacterError"
						}
						- "\""
					}
					- " "
					code id="atob:domexception-4" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "decodedData"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h3 id="dynamic-markup-insertion" {
			span class="secno" {
				- "8.4"
			}
			- " "
			dfn {
				- "Dynamic markup insertion"
			}
			a href="#dynamic-markup-insertion" class="self-link"
		}
		- "\n\n  "
		p class="note" {
			- "APIs for dynamically inserting markup into the document interact with the parser,\n  and thus their behavior varies depending on whether they are used with "
			a id="dynamic-markup-insertion:html-documents" href="https://dom.spec.whatwg.org/#html-document" data-x-internal="html-documents" {
				- "HTML\n  documents"
			}
			- " (and the "
			a href="#html-parser" id="dynamic-markup-insertion:html-parser" {
				- "HTML parser"
			}
			- ") or "
			a id="dynamic-markup-insertion:xml-documents" href="https://dom.spec.whatwg.org/#xml-document" data-x-internal="xml-documents" {
				- "XML documents"
			}
			- " (and the\n  "
			a href="#xml-parser" id="dynamic-markup-insertion:xml-parser" {
				- "XML parser"
			}
			- ")."
		}
		- "\n\n  \n\n  "
		p {
			code id="dynamic-markup-insertion:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " objects have a "
			dfn id="throw-on-dynamic-markup-insertion-counter" {
				- "throw-on-dynamic-markup-insertion counter"
			}
			- ",\n  which is used in conjunction with the "
			a href="#create-an-element-for-the-token" id="dynamic-markup-insertion:create-an-element-for-the-token" {
				- "create an element for the token"
			}
			- " algorithm to\n  prevent "
			a href="#custom-element-constructor" id="dynamic-markup-insertion:custom-element-constructor" {
				- "custom element constructors"
			}
			- " from being\n  able to use "
			code id="dynamic-markup-insertion:dom-document-open" {
				a href="#dom-document-open" {
					- "document.open()"
				}
			}
			- ", "
			code id="dynamic-markup-insertion:dom-document-close" {
				a href="#dom-document-close" {
					- "document.close()"
				}
			}
			- ", and "
			code id="dynamic-markup-insertion:dom-document-write" {
				a href="#dom-document-write" {
					- "document.write()"
				}
			}
			- " when they are invoked by the parser.\n  Initially, the counter must be set to zero."
		}
		- "\n\n  \n\n\n\n  "
		h4 id="opening-the-input-stream" {
			span class="secno" {
