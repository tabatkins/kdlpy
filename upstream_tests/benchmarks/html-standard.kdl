							}
							td {
								- "0x2030 "
							}
							td {
								- "PER MILLE SIGN (‰)\n      "
							}
						}
						tr {
							td {
								- "0x8A "
							}
							td {
								- "0x0160 "
							}
							td {
								- "LATIN CAPITAL LETTER S WITH CARON (Š)\n      "
							}
						}
						tr {
							td {
								- "0x8B "
							}
