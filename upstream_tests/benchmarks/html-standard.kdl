						- "domain"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-host" id="origin:concept-origin-host" {
						- "host"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="ascii-serialisation-of-an-origin" data-lt="serialization of an\n  origin|ASCII serialization of an origin" data-export="" {
				- "serialization of an origin"
			}
			- " is the string obtained\n  by applying the following algorithm to the given "
			a href="#concept-origin" id="origin:concept-origin-4" {
				- "origin"
			}
			- " "
			var {
				- "origin"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "origin"
					}
					- " is an "
					a href="#concept-origin-opaque" id="origin:concept-origin-opaque-2" {
						- "opaque origin"
					}
					- ",\n   then return \""
					code {
						- "null"
					}
					- "\"."
				}
			}
			li {
				p {
					- "Otherwise, let "
					var {
						- "result"
					}
					- " be "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-scheme" id="origin:concept-origin-scheme" {
						- "scheme"
					}
					- "."
				}
			}
			li {
				p {
					- "Append \""
					code {
						- "://"
					}
					- "\" to "
					var {
						- "result"
					}
					- "."
				}
			}
			li {
				p {
					- "Append "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-host" id="origin:concept-origin-host-2" {
						- "host"
					}
					- ", "
					a href="https://url.spec.whatwg.org/#concept-host-serializer" id="origin:host-serializer" data-x-internal="host-serializer" {
						- "serialized"
					}
					- ", to "
					var {
						- "result"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-port" id="origin:concept-origin-port" {
						- "port"
					}
					- " is non-null, append\n   a U+003A COLON character (:), and "
					var {
						- "origin"
					}
					- "'s "
					a href="#concept-origin-port" id="origin:concept-origin-port-2" {
						- "port"
					}
					- ", "
					a href="https://url.spec.whatwg.org/#serialize-an-integer" id="origin:serialize-an-integer" data-x-internal="serialize-an-integer" {
						- "serialized"
					}
					- ",\n   to "
					var {
						- "result"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "result"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  "
		p class="example" {
			- "The "
			a href="#ascii-serialisation-of-an-origin" id="origin:ascii-serialisation-of-an-origin-2" {
				- "serialization"
			}
			- " of (\""
			code {
				- "https"
			}
			- "\", \""
			code {
				- "xn--maraa-rta.example"
			}
			- "\", null, null) is \""
			code {
				- "https://xn--maraa-rta.example"
			}
			- "\"."
		}
		- "\n\n  \n\n  "
		p id="unicode-serialisation-of-an-origin" class="note" {
			- "There used to also be a\n  "
			i {
