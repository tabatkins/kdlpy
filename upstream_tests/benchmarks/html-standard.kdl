										- "-->"
									}
									- "\" (U+002D HYPHEN-MINUS, U+002D HYPHEN-MINUS,\n        U+003E GREATER-THAN SIGN)."
								}
								- "\n       "
							}
							dt {
								- "If "
								var {
									- "current node"
								}
								- " is a "
