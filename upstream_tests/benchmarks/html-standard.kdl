					code {
						- "shape"
					}
				}
				- " on "
				code id="non-conforming-features:the-a-element-3" {
					a href="#the-a-element" {
						- "a"
					}
				}
				- " elements"
			}
			dd {
				p {
					- "Use "
					code id="non-conforming-features:the-area-element" {
