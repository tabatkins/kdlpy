							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "ancestor"
							}
							- " is a "
							code id="the-insertion-mode:the-template-element-2" {
								a href="#the-template-element" {
									- "template"
								}
							}
							- " node, jump to the step below\n     labeled "
							i {
								- "done"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "ancestor"
							}
							- " is a "
							code id="the-insertion-mode:the-table-element" {
								a href="#the-table-element" {
									- "table"
								}
							}
							- " node, switch the "
							a href="#insertion-mode" id="the-insertion-mode:insertion-mode-5" {
								- "insertion\n     mode"
							}
							- " to \""
							a href="#parsing-main-inselectintable" id="the-insertion-mode:parsing-main-inselectintable-2" {
								- "in select in table"
