		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLObjectElement/useMap" title="The useMap property of the HTMLObjectElement interface returns a string that reflects the usemap HTML attribute, specifying a <map> element to use." {
						- "HTMLObjectElement/useMap"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "3+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "6+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "1+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
