		h4 id="licensing-works" {
			span class="secno" {
				- "5.3.3"
			}
			- " Licensing works"
			a href="#licensing-works" class="self-link"
		}
		- "\n\n  "
		p {
			- "An item with the "
			a href="#item-types" id="licensing-works:item-types" {
				- "item type"
			}
			- " "
			dfn id="md-work" {
				code {
					- "http://n.whatwg.org/work"
				}
			}
			- " represents a work (e.g. an article, an\n  image, a video, a song, etc.). This type is primarily intended to allow authors to include\n  licensing information for works."
		}
		- "\n\n  "
		p {
			- "The following are the type's "
			a href="#defined-property-name" id="licensing-works:defined-property-name" {
				- "defined property\n  names"
			}
			- "."
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="md-work-work" {
					code {
						- "work"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Identifies the work being described."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="licensing-works:concept-property-value" {
						- "value"
					}
					- " must be an "
					a id="licensing-works:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
						- "absolute\n    URL"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Exactly one property with the name "
					code id="licensing-works:md-work-work" {
						a href="#md-work-work" {
							- "work"
						}
					}
					- " must be present\n    within each "
					a href="#concept-item" id="licensing-works:concept-item" {
						- "item"
					}
					- " with the type "
					code id="licensing-works:md-work" {
						a href="#md-work" {
							- "http://n.whatwg.org/work"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-work-title" {
					code {
						- "title"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the name of the work."
				}
				- "\n\n    "
				p {
					- "A single property with the name "
					code id="licensing-works:md-work-title" {
						a href="#md-work-title" {
							- "title"
						}
					}
					- " may be present\n    within each "
					a href="#concept-item" id="licensing-works:concept-item-2" {
						- "item"
					}
					- " with the type "
					code id="licensing-works:md-work-2" {
						a href="#md-work" {
							- "http://n.whatwg.org/work"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-work-author" {
					code {
						- "author"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Gives the name or contact information of one of the authors or creators of the work."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="licensing-works:concept-property-value-2" {
						- "value"
					}
					- " must be either an "
					a href="#concept-item" id="licensing-works:concept-item-3" {
						- "item"
					}
					- " with the type "
					code id="licensing-works:md-vcard" {
						a href="#md-vcard" {
							- "http://microformats.org/profile/hcard"
						}
					}
					- ", or text."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="licensing-works:md-work-author" {
						a href="#md-work-author" {
							- "author"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="licensing-works:concept-item-4" {
						- "item"
					}
					- " with the type "
					code id="licensing-works:md-work-3" {
						a href="#md-work" {
							- "http://n.whatwg.org/work"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				dfn id="md-work-license" {
					code {
						- "license"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Identifies one of the licenses under which the work is available."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="licensing-works:concept-property-value-3" {
						- "value"
					}
					- " must be an "
					a id="licensing-works:absolute-url-2" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
						- "absolute\n    URL"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="licensing-works:md-work-license" {
						a href="#md-work-license" {
							- "license"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="licensing-works:concept-item-5" {
						- "item"
					}
					- " with the type "
					code id="licensing-works:md-work-4" {
						a href="#md-work" {
							- "http://n.whatwg.org/work"
						}
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n\n\n\n  "
		h5 id="examples-4" {
			span class="secno" {
				- "5.3.3.1"
			}
			- " Examples"
			a href="#examples-4" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
