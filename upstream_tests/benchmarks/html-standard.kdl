				- " "
				c- b="" {
					- "DOMString"
				}
				- "? "
				a href="#dom-storageevent-oldvalue" id="the-storageevent-interface:dom-storageevent-oldvalue" {
					c- g="" {
						- "oldValue"
					}
				}
				- ";\n  "
				c- b="" {
					- "readonly"
				}
				- " "
				c- b="" {
					- "attribute"
				}
				- " "
				c- b="" {
					- "DOMString"
				}
				- "? "
				a href="#dom-storageevent-newvalue" id="the-storageevent-interface:dom-storageevent-newvalue" {
					c- g="" {
						- "newValue"
					}
				}
				- ";\n  "
				c- b="" {
					- "readonly"
				}
				- " "
				c- b="" {
					- "attribute"
				}
				- " "
				c- b="" {
					- "USVString"
				}
				- " "
				a href="#dom-storageevent-url" id="the-storageevent-interface:dom-storageevent-url" {
					c- g="" {
						- "url"
					}
				}
				- ";\n  "
				c- b="" {
					- "readonly"
				}
				- " "
				c- b="" {
					- "attribute"
				}
				- " "
				a href="#storage-2" id="the-storageevent-interface:storage-2" {
					c- n="" {
						- "Storage"
					}
				}
				- "? "
				a href="#dom-storageevent-storagearea" id="the-storageevent-interface:dom-storageevent-storagearea" {
					c- g="" {
						- "storageArea"
					}
				}
				- ";\n\n  "
				c- b="" {
					- "undefined"
				}
				- " "
				a href="#dom-storageevent-initstorageevent" id="the-storageevent-interface:dom-storageevent-initstorageevent" {
					c- g="" {
						- "initStorageEvent"
					}
				}
				- "("
				c- b="" {
					- "DOMString"
				}
				- " "
				c- g="" {
