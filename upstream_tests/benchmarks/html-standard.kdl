		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-storageevent-key" id="dom-storageevent-key-dev" {
						- "key"
					}
				}
			}
			dd {
				p {
					- "Returns the key of the storage item being changed."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-storageevent-oldvalue" id="dom-storageevent-oldvalue-dev" {
						- "oldValue"
					}
				}
			}
			dd {
				p {
					- "Returns the old value of the key of the storage item whose value is being\n   changed."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-storageevent-newvalue" id="dom-storageevent-newvalue-dev" {
						- "newValue"
					}
				}
			}
			dd {
				p {
					- "Returns the new value of the key of the storage item whose value is being\n   changed."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-storageevent-url" id="dom-storageevent-url-dev" {
						- "url"
					}
				}
			}
			dd {
				p {
					- "Returns the "
					a href="https://dom.spec.whatwg.org/#concept-document-url" id="the-storageevent-interface:the-document's-address" data-x-internal="the-document's-address" {
						- "URL"
					}
					- " of the document whose storage\n   item changed."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-storageevent-storagearea" id="dom-storageevent-storagearea-dev" {
						- "storageArea"
					}
				}
			}
			dd {
				p {
					- "Returns the "
					code id="the-storageevent-interface:storage-2-3" {
						a href="#storage-2" {
							- "Storage"
						}
					}
					- " object that was affected."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-key" data-dfn-type="attribute" {
				code {
					- "key"
				}
			}
			- ",\n  "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-oldvalue" data-dfn-type="attribute" {
				code {
					- "oldValue"
				}
			}
			- ",\n  "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-newvalue" data-dfn-type="attribute" {
				code {
					- "newValue"
				}
			}
			- ",\n  "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-url" data-dfn-type="attribute" {
				code {
					- "url"
				}
			}
			- ", and "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-storagearea" data-dfn-type="attribute" {
				code {
					- "storageArea"
				}
			}
			- "\n  attributes must return the values they were initialized to."
		}
		- "\n\n  \n  "
		p {
			- "The "
			dfn data-dfn-for="StorageEvent" id="dom-storageevent-initstorageevent" data-dfn-type="method" {
				code {
					- "initStorageEvent("
					var {
						- "type"
					}
					- ", "
					var {
						- "bubbles"
					}
					- ",\n  "
					var {
						- "cancelable"
					}
					- ", "
					var {
						- "key"
					}
					- ", "
					var {
						- "oldValue"
					}
					- ", "
					var {
						- "newValue"
					}
					- ", "
					var {
						- "url"
					}
					- ",\n  "
					var {
						- "storageArea"
					}
					- ")"
				}
			}
			- " method must initialize the event in a manner analogous to the\n  similarly-named "
			code id="the-storageevent-interface:dom-event-initevent" {
				a data-x-internal="dom-event-initevent" href="https://dom.spec.whatwg.org/#dom-event-initevent" {
					- "initEvent()"
				}
			}
			- " method. "
			a href="#refsDOM" {
				- "[DOM]"
			}
		}
		- "\n\n  \n\n\n  "
		h3 id="privacy" {
			span class="secno" {
				- "12.3"
			}
			- " Privacy"
			a href="#privacy" class="self-link"
		}
		- "\n\n  "
		h4 id="user-tracking" {
			span class="secno" {
				- "12.3.1"
			}
			- " User tracking"
			a href="#user-tracking" class="self-link"
		}
		- "\n\n  "
		p {
			- "A third-party advertiser (or any entity capable of getting content distributed to multiple\n  sites) could use a unique identifier stored in its local storage area to track a user across\n  multiple sessions, building a profile of the user's interests to allow for highly targeted\n  advertising. In conjunction with a site that is aware of the user's real identity (for example an\n  e-commerce site that requires authenticated credentials), this could allow oppressive groups to\n  target individuals with greater accuracy than in a world with purely anonymous web usage."
		}
		- "\n\n  "
		p {
			- "There are a number of techniques that can be used to mitigate the risk of user tracking:"
		}
		- "\n\n  "
		dl {
			dt {
				- "Blocking third-party storage"
			}
			dd {
				- "\n    "
				p {
					- "User agents may restrict access to the "
					code id="user-tracking:dom-localstorage" {
						a href="#dom-localstorage" {
							- "localStorage"
						}
					}
					- "\n    objects to scripts originating at the domain of the "
					a href="#nav-document" id="user-tracking:nav-document" {
						- "active\n    document"
					}
					- " of the "
					a href="#top-level-traversable" id="user-tracking:top-level-traversable" {
						- "top-level traversable"
					}
					- ", for instance denying access to the\n    API for pages from other domains running in "
					code id="user-tracking:the-iframe-element" {
						a href="#the-iframe-element" {
							- "iframe"
						}
					}
					- "s."
				}
				- "\n   "
			}
			dt {
				- "Expiring stored data"
			}
			dd {
				- "\n    "
				p {
					- "User agents may, possibly in a manner configured by the user, automatically delete stored\n    data after a period of time."
				}
				- "\n\n    "
				p {
					- "For example, a user agent could be configured to treat third-party local storage areas as\n    session-only storage, deleting the data once the user had closed all the "
					a href="#navigable" id="user-tracking:navigable" {
						- "navigables"
					}
					- " that could access it."
				}
				- "\n\n    "
				p {
					- "This can restrict the ability of a site to track a user, as the site would then only be able\n    to track the user across multiple sessions when they authenticate with the site itself (e.g. by\n    making a purchase or logging in to a service)."
				}
				- "\n\n    "
				p {
					- "However, this also reduces the usefulness of the API as a long-term storage mechanism. It can\n    also put the user's data at risk, if the user does not fully understand the implications of data\n    expiration."
				}
				- "\n   "
			}
			dt {
				- "Treating persistent storage as cookies"
			}
			dd {
				- "\n    "
				p {
					- "If users attempt to protect their privacy by clearing cookies without also clearing data\n    stored in the local storage area, sites can defeat those attempts by using the two features as\n    redundant backup for each other. User agents should present the interfaces for clearing these in\n    a way that helps users to understand this possibility and enables them to delete data in all\n    persistent storage features simultaneously. "
					a href="#refsCOOKIES" {
						- "[COOKIES]"
					}
				}
				- "\n   "
			}
			dt {
				- "Site-specific safelisting of access to local storage areas"
			}
			dd {
				- "\n    "
				p {
					- "User agents may allow sites to access session storage areas in\n    an unrestricted manner, but require the user to authorize access\n    to local storage areas."
				}
				- "\n   "
			}
			dt {
				- "Origin-tracking of stored data"
			}
			dd {
				- "\n    "
				p {
					- "User agents may record the "
					a href="#concept-origin" id="user-tracking:concept-origin" {
						- "origins"
					}
					- " of sites that contained\n    content from third-party origins that caused data to be stored."
				}
				- "\n\n    "
				p {
					- "If this information is then used to present the view of data currently in persistent storage,\n    it would allow the user to make informed decisions about which parts of the persistent storage\n    to prune. Combined with a blocklist (\"delete this data and prevent this domain from ever storing\n    data again\"), the user can restrict the use of persistent storage to sites that they trust."
				}
				- "\n   "
			}
			dt {
				- "Shared blocklists"
			}
			dd {
				- "\n    "
				p {
					- "User agents may allow users to share their persistent storage domain blocklists."
				}
				- "\n\n    "
				p {
					- "This would allow communities to act together to protect their privacy."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "While these suggestions prevent trivial use of this API for user tracking, they do not block it\n  altogether. Within a single domain, a site can continue to track the user during a session, and\n  can then pass all this information to the third party along with any identifying information\n  (names, credit card numbers, addresses) obtained by the site. If a third party cooperates with\n  multiple sites to obtain such information, a profile can still be created."
		}
		- "\n\n  "
		p {
			- "However, user tracking is to some extent possible even with no cooperation from the user agent\n  whatsoever, for instance by using session identifiers in URLs, a technique already commonly used\n  for innocuous purposes but easily repurposed for user tracking (even retroactively). This\n  information can then be shared with other sites, using visitors' IP addresses and other\n  user-specific data (e.g. user-agent headers and configuration settings) to combine separate\n  sessions into coherent user profiles."
		}
		- "\n\n  \n\n  "
		h4 id="sensitivity-of-data" {
			span class="secno" {
				- "12.3.2"
			}
			- " Sensitivity of data"
			a href="#sensitivity-of-data" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agents should treat persistently stored data as potentially sensitive; it's quite possible\n  for emails, calendar appointments, health records, or other confidential documents to be stored\n  in this mechanism."
		}
		- "\n\n  "
		p {
			- "To this end, user agents should ensure that when deleting data, it is promptly deleted from the\n  underlying storage."
		}
		- "\n\n  \n\n\n  "
		h3 id="security-storage" {
			span class="secno" {
				- "12.4"
			}
			- " Security"
			a href="#security-storage" class="self-link"
		}
		- "\n\n  "
		h4 id="dns-spoofing-attacks" {
			span class="secno" {
				- "12.4.1"
			}
			- " DNS spoofing attacks"
			a href="#dns-spoofing-attacks" class="self-link"
		}
		- "\n\n  "
		p {
			- "Because of the potential for DNS spoofing attacks, one cannot guarantee that a host claiming to\n  be in a certain domain really is from that domain. To mitigate this, pages can use TLS. Pages\n  using TLS can be sure that only the user, software working on behalf of the user, and other pages\n  using TLS that have certificates identifying them as being from the same domain, can access their\n  storage areas."
		}
		- "\n\n\n  "
		h4 id="cross-directory-attacks" {
			span class="secno" {
				- "12.4.2"
			}
			- " Cross-directory attacks"
			a href="#cross-directory-attacks" class="self-link"
		}
		- "\n\n  "
		p {
			- "Different authors sharing one host name, for example users hosting content on the now defunct\n  "
			code {
				- "geocities.com"
			}
			- ", all share one local storage object. There is no feature to\n  restrict the access by pathname. Authors on shared hosts are therefore urged to avoid using these\n  features, as it would be trivial for other authors to read the data and overwrite it."
		}
		- "\n\n  "
		p class="note" {
			- "Even if a path-restriction feature was made available, the usual DOM scripting\n  security model would make it trivial to bypass this protection and access the data from any\n  path."
		}
		- "\n\n\n  \n\n  "
		h4 id="implementation-risks" {
			span class="secno" {
				- "12.4.3"
			}
			- " Implementation risks"
			a href="#implementation-risks" class="self-link"
		}
		- "\n\n  "
		p {
			- "The two primary risks when implementing these persistent storage features are letting hostile\n  sites read information from other domains, and letting hostile sites write information that is\n  then read from other domains."
		}
		- "\n\n  "
		p {
			- "Letting third-party sites read data that is not supposed to be read from their domain causes\n  "
			em {
				- "information leakage"
			}
			- ". For example, a user's shopping wishlist on one domain could be used\n  by another domain for targeted advertising; or a user's work-in-progress confidential documents\n  stored by a word-processing site could be examined by the site of a competing company."
		}
		- "\n\n  "
		p {
			- "Letting third-party sites write data to the persistent storage of other domains can result in\n  "
			em {
				- "information spoofing"
			}
			- ", which is equally dangerous. For example, a hostile site could add\n  items to a user's wishlist; or a hostile site could set a user's session identifier to a known ID\n  that the hostile site can then use to track the user's actions on the victim site."
		}
		- "\n\n  "
		p {
			- "Thus, strictly following the "
			a href="#concept-origin" id="implementation-risks:concept-origin" {
				- "origin"
			}
			- " model described in this specification is\n  important for user security."
		}
		- "\n\n  \n\n\n\n  "
		h2 id="syntax" {
			span class="secno" {
				- "13"
			}
			- " "
			dfn {
				- "The HTML syntax"
			}
			a href="#syntax" class="self-link"
		}
		- "\n\n  "
		p class="note" {
			- "This section only describes the rules for resources labeled with an "
			a id="syntax:html-mime-type" href="https://mimesniff.spec.whatwg.org/#html-mime-type" data-x-internal="html-mime-type" {
				- "HTML\n  MIME type"
			}
			- ". Rules for XML resources are discussed in the section below entitled \""
			a href="#the-xhtml-syntax" id="syntax:the-xhtml-syntax" {
				- "The\n  XML syntax"
			}
			- "\"."
		}
		- "\n\n\n  "
		h3 id="writing" {
			span class="secno" {
				- "13.1"
			}
			- " Writing HTML documents"
			a href="#writing" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			i {
				- "This section only applies to documents, authoring tools, and markup generators. In\n  particular, it does not apply to conformance checkers; conformance checkers must use the\n  requirements given in the next section (\"parsing HTML documents\")."
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Documents must consist of the following parts, in the given\n  order:"
		}
		- "\n\n  "
		ol {
			li {
				- "Optionally, a single U+FEFF BYTE ORDER MARK (BOM) character."
			}
			li {
				- "Any number of "
				a href="#syntax-comments" id="writing:syntax-comments" {
					- "comments"
				}
				- " and "
				a id="writing:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII\n   whitespace"
				}
				- "."
			}
			li {
				- "A "
				a href="#syntax-doctype" id="writing:syntax-doctype" {
					- "DOCTYPE"
				}
				- ".\n\n   "
			}
			li {
				- "Any number of "
				a href="#syntax-comments" id="writing:syntax-comments-2" {
					- "comments"
				}
				- " and "
				a id="writing:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII\n   whitespace"
				}
				- "."
			}
			li {
				- "The "
				a id="writing:document-element" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
					- "document element"
				}
				- ", in the form of an "
				code id="writing:the-html-element" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " "
				a href="#syntax-elements" id="writing:syntax-elements" {
					- "element"
				}
				- "."
			}
			li {
				- "Any number of "
				a href="#syntax-comments" id="writing:syntax-comments-3" {
					- "comments"
				}
				- " and "
				a id="writing:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII\n   whitespace"
				}
				- "."
			}
		}
		- "\n\n  "
		p {
			- "The various types of content mentioned above are described in the next few sections."
		}
		- "\n\n  "
		p {
			- "In addition, there are some restrictions on how "
			a href="#character-encoding-declaration" id="writing:character-encoding-declaration" {
				- "character encoding declarations"
			}
			- " are to be serialized, as discussed in the\n  section on that topic."
		}
		- "\n\n  "
		div class="note" {
			- "\n\n   "
			p {
				a id="writing:space-characters-4" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- " before the "
				code id="writing:the-html-element-2" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element, at the start of the\n   "
				code id="writing:the-html-element-3" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element and before the "
				code id="writing:the-head-element" {
					a href="#the-head-element" {
						- "head"
					}
				}
				- " element, will be dropped when the\n   document is parsed; "
				a id="writing:space-characters-5" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- " "
				em {
					- "after"
				}
				- " the "
				code id="writing:the-html-element-4" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element\n   will be parsed as if it were at the end of the "
				code id="writing:the-body-element" {
					a href="#the-body-element" {
						- "body"
					}
				}
				- " element. Thus, "
				a id="writing:space-characters-6" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII\n   whitespace"
				}
				- " around the "
				a id="writing:document-element-2" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
					- "document element"
				}
				- " does not round-trip."
			}
			- "\n\n   "
			p {
				- "It is suggested that newlines be inserted after the DOCTYPE, after any comments that are\n   before the document element, after the "
				code id="writing:the-html-element-5" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element's start tag (if it is not "
				a href="#syntax-tag-omission" id="writing:syntax-tag-omission" {
					- "omitted"
				}
				- "), and after any comments that are inside the\n   "
				code id="writing:the-html-element-6" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element but before the "
				code id="writing:the-head-element-2" {
					a href="#the-head-element" {
						- "head"
					}
				}
				- " element."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "Many strings in the HTML syntax (e.g. the names of elements and their attributes) are\n  case-insensitive, but only for "
			a href="https://infra.spec.whatwg.org/#ascii-upper-alpha" id="writing:uppercase-ascii-letters" data-x-internal="uppercase-ascii-letters" {
				- "ASCII upper alphas"
			}
			- " and\n  "
			a href="https://infra.spec.whatwg.org/#ascii-lower-alpha" id="writing:lowercase-ascii-letters" data-x-internal="lowercase-ascii-letters" {
				- "ASCII lower alphas"
			}
			- ". For convenience, in this section this\n  is just referred to as \"case-insensitive\"."
		}
		- "\n\n\n  "
		h4 id="the-doctype" {
			span class="secno" {
				- "13.1.1"
			}
			- " The DOCTYPE"
			a href="#the-doctype" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="syntax-doctype" {
				- "DOCTYPE"
			}
			- " is a \n  required preamble."
		}
		- "\n\n  "
		p class="note" {
			- "DOCTYPEs are required for legacy reasons. When omitted, browsers tend to use a\n  different rendering mode that is incompatible with some specifications. Including the DOCTYPE in a\n  document ensures that the browser makes a best-effort attempt at following the relevant\n  specifications."
		}
		- "\n\n  "
		p {
			- "A DOCTYPE must consist of the following components, in this order:"
		}
		- "\n\n  "
		ol class="brief" {
			li {
				- "A string that is an "
				a id="the-doctype:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
					- "ASCII case-insensitive"
				}
				- " match for the string \""
				code {
					- "<!DOCTYPE"
				}
				- "\"."
			}
			li {
				- "One or more "
				a id="the-doctype:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "A string that is an "
				a id="the-doctype:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
					- "ASCII case-insensitive"
				}
				- " match for the string \""
				code {
					- "html"
				}
				- "\"."
			}
			li {
				- "Optionally, a "
				a href="#doctype-legacy-string" id="the-doctype:doctype-legacy-string" {
					- "DOCTYPE legacy string"
				}
				- "."
			}
			li {
				- "Zero or more "
				a id="the-doctype:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "A U+003E GREATER-THAN SIGN character (>)."
			}
		}
		- "\n\n  "
		p class="note" {
			- "In other words, "
			code {
				- "<!DOCTYPE html>"
			}
			- ", case-insensitively."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "For the purposes of HTML generators that cannot output HTML markup with the short DOCTYPE\n  \""
			code {
				- "<!DOCTYPE html>"
			}
			- "\", a "
			dfn id="doctype-legacy-string" {
				- "DOCTYPE legacy string"
			}
			- " may be inserted\n  into the DOCTYPE (in the position defined above). This string must consist of:"
		}
		- "\n\n  "
		ol class="brief" {
			li {
				- "One or more "
				a id="the-doctype:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "A string that is an "
				a id="the-doctype:ascii-case-insensitive-3" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
					- "ASCII case-insensitive"
				}
				- " match for the string \""
				code {
					- "SYSTEM"
				}
				- "\"."
			}
			li {
				- "One or more "
				a id="the-doctype:space-characters-4" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "A U+0022 QUOTATION MARK or U+0027 APOSTROPHE character (the "
				i {
					- "quote mark"
				}
				- ")."
			}
			li {
				- "The literal string \""
				code id="the-doctype:about:legacy-compat" {
					a href="#about:legacy-compat" {
						- "about:legacy-compat"
					}
				}
				- "\"."
			}
			li {
				- "A matching U+0022 QUOTATION MARK or U+0027 APOSTROPHE character (i.e. the same character as in the earlier step labeled "
				i {
					- "quote mark"
				}
				- ")."
			}
		}
		- "\n\n  "
		p class="note" {
			- "In other words, "
			code {
				- "<!DOCTYPE html SYSTEM \"about:legacy-compat\">"
			}
			- " or\n  "
			code {
				- "<!DOCTYPE html SYSTEM 'about:legacy-compat'>"
			}
			- ", case-insensitively except for the\n  part in single or double quotes."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#doctype-legacy-string" id="the-doctype:doctype-legacy-string-2" {
				- "DOCTYPE legacy string"
			}
			- " should not be used unless the document is generated from\n  a system that cannot output the shorter string."
		}
		- "\n\n\n\n  "
		h4 id="elements-2" {
			span class="secno" {
				- "13.1.2"
			}
			- " Elements"
			a href="#elements-2" class="self-link"
		}
		- "\n\n  "
		p {
			- "There are six different kinds of "
			dfn id="syntax-elements" {
				- "elements"
			}
			- ": "
			a href="#void-elements" id="elements-2:void-elements" {
				- "void\n  elements"
			}
			- ", "
			a href="#the-template-element-2" id="elements-2:the-template-element-2" {
				- "the "
				code {
					- "template"
				}
				- " element"
			}
			- ", "
			a href="#raw-text-elements" id="elements-2:raw-text-elements" {
				- "raw text\n  elements"
			}
			- ", "
			a href="#escapable-raw-text-elements" id="elements-2:escapable-raw-text-elements" {
				- "escapable raw text elements"
			}
			- ", "
			a href="#foreign-elements" id="elements-2:foreign-elements" {
				- "foreign elements"
			}
			- ", and\n  "
			a href="#normal-elements" id="elements-2:normal-elements" {
				- "normal elements"
			}
			- "."
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="void-elements" {
					- "Void elements"
				}
			}
			dd {
				code id="elements-2:the-area-element" {
					a href="#the-area-element" {
						- "area"
					}
				}
				- ", "
				code id="elements-2:the-base-element" {
					a href="#the-base-element" {
						- "base"
					}
				}
				- ", "
				code id="elements-2:the-br-element" {
					a href="#the-br-element" {
						- "br"
					}
				}
				- ", "
				code id="elements-2:the-col-element" {
					a href="#the-col-element" {
						- "col"
					}
				}
				- ", "
				code id="elements-2:the-embed-element" {
					a href="#the-embed-element" {
						- "embed"
					}
				}
				- ",\n   "
				code id="elements-2:the-hr-element" {
					a href="#the-hr-element" {
						- "hr"
					}
				}
				- ", "
				code id="elements-2:the-img-element" {
					a href="#the-img-element" {
						- "img"
					}
				}
				- ", "
				code id="elements-2:the-input-element" {
					a href="#the-input-element" {
						- "input"
					}
				}
				- ", "
				code id="elements-2:the-link-element" {
					a href="#the-link-element" {
						- "link"
					}
				}
				- ", "
				code id="elements-2:the-meta-element" {
					a href="#the-meta-element" {
						- "meta"
					}
				}
				- ",\n   "
				code id="elements-2:the-source-element" {
					a href="#the-source-element" {
						- "source"
					}
				}
				- ", "
				code id="elements-2:the-track-element" {
					a href="#the-track-element" {
						- "track"
					}
				}
				- ", "
				code id="elements-2:the-wbr-element" {
					a href="#the-wbr-element" {
						- "wbr"
					}
				}
			}
			dt {
				dfn id="the-template-element-2" {
					- "The "
					code {
						- "template"
					}
					- " element"
				}
			}
			dd {
				code id="elements-2:the-template-element" {
					a href="#the-template-element" {
						- "template"
					}
				}
			}
			dt {
				dfn id="raw-text-elements" {
					- "Raw text elements"
				}
			}
			dd {
				code id="elements-2:the-script-element" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- ", "
				code id="elements-2:the-style-element" {
					a href="#the-style-element" {
						- "style"
					}
				}
			}
			dt {
				dfn id="escapable-raw-text-elements" {
					- "Escapable raw text elements"
				}
			}
			dd {
				code id="elements-2:the-textarea-element" {
					a href="#the-textarea-element" {
						- "textarea"
					}
				}
				- ", "
				code id="elements-2:the-title-element" {
					a href="#the-title-element" {
						- "title"
					}
				}
			}
			dt {
				dfn id="foreign-elements" {
					- "Foreign elements"
				}
			}
			dd {
				- "Elements from the "
				a id="elements-2:mathml-namespace" href="https://infra.spec.whatwg.org/#mathml-namespace" data-x-internal="mathml-namespace" {
					- "MathML namespace"
				}
				- " and the "
				a id="elements-2:svg-namespace" href="https://infra.spec.whatwg.org/#svg-namespace" data-x-internal="svg-namespace" {
					- "SVG namespace"
				}
				- "."
			}
			dt {
				dfn id="normal-elements" {
					- "Normal elements"
				}
			}
			dd {
				- "All other allowed "
				a href="#html-elements" id="elements-2:html-elements" {
					- "HTML elements"
				}
				- " are normal elements."
			}
		}
		- "\n\n  "
		p {
			dfn id="syntax-tags" {
				- "Tags"
			}
			- " are used to delimit the start and end of elements in the\n  markup. "
			a href="#raw-text-elements" id="elements-2:raw-text-elements-2" {
				- "Raw text"
			}
			- ", "
			a href="#escapable-raw-text-elements" id="elements-2:escapable-raw-text-elements-2" {
				- "escapable raw text"
			}
			- ", and "
			a href="#normal-elements" id="elements-2:normal-elements-2" {
				- "normal"
			}
			- " elements have\n  a "
			a href="#syntax-start-tag" id="elements-2:syntax-start-tag" {
				- "start tag"
			}
			- " to indicate where they begin, and an "
			a href="#syntax-end-tag" id="elements-2:syntax-end-tag" {
				- "end tag"
			}
			- " to indicate where they end. The start and end tags of\n  certain "
			a href="#normal-elements" id="elements-2:normal-elements-3" {
				- "normal elements"
			}
			- " can be "
			a href="#syntax-tag-omission" id="elements-2:syntax-tag-omission" {
				- "omitted"
			}
			- ", as\n  described below in the section on "
			a href="#syntax-tag-omission" id="elements-2:syntax-tag-omission-2" {
				- "optional tags"
			}
			- ". Those\n  that cannot be omitted must not be omitted. "
			a href="#void-elements" id="elements-2:void-elements-2" {
				- "Void elements"
			}
			- " only have a start tag; end\n  tags must not be specified for "
			a href="#void-elements" id="elements-2:void-elements-3" {
				- "void elements"
			}
			- ". "
			a href="#foreign-elements" id="elements-2:foreign-elements-2" {
				- "Foreign elements"
			}
			- " must\n  either have a start tag and an end tag, or a start tag that is marked as self-closing, in which\n  case they must not have an end tag."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-html-contents" id="elements-2:concept-html-contents" {
				- "contents"
			}
			- " of the element must be placed between\n  just after the start tag (which "
			a href="#syntax-tag-omission" id="elements-2:syntax-tag-omission-3" {
				- "might be implied, in certain\n  cases"
			}
			- ") and just before the end tag (which again, "
			a href="#syntax-tag-omission" id="elements-2:syntax-tag-omission-4" {
				- "might be\n  implied in certain cases"
			}
			- "). The exact allowed contents of each individual element depend on\n  the "
			a href="#content-models" id="elements-2:content-models" {
				- "content model"
			}
			- " of that element, as described earlier in\n  this specification. Elements must not contain content that their content model disallows. In\n  addition to the restrictions placed on the contents by those content models, however, the five\n  types of elements have additional "
			em {
				- "syntactic"
			}
			- " requirements."
		}
		- "\n\n  "
		p {
			a href="#void-elements" id="elements-2:void-elements-4" {
				- "Void elements"
			}
			- " can't have any contents (since there's no end tag, no content can be\n  put between the start tag and the end tag)."
		}
		- "\n\n  "
		p id="template-syntax" {
			a href="#the-template-element-2" id="elements-2:the-template-element-2-2" {
				- "The "
				code {
					- "template"
				}
				- " element"
			}
			- " can have\n  "
			a href="#template-contents" id="elements-2:template-contents" {
				- "template contents"
			}
			- ", but such "
			a href="#template-contents" id="elements-2:template-contents-2" {
				- "template contents"
			}
			- " are not children of the\n  "
			code id="elements-2:the-template-element-3" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " element itself. Instead, they are stored in a "
			code id="elements-2:documentfragment" {
				a data-x-internal="documentfragment" href="https://dom.spec.whatwg.org/#interface-documentfragment" {
					- "DocumentFragment"
				}
			}
			- "\n  associated with a different "
			code id="elements-2:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " — without a "
			a href="#browsing-context" id="elements-2:browsing-context" {
				- "browsing context"
			}
			- " — so\n  as to avoid the "
			code id="elements-2:the-template-element-4" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " contents interfering with the main "
			code id="elements-2:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- ".\n  The markup for the "
			a href="#template-contents" id="elements-2:template-contents-3" {
				- "template contents"
			}
			- " of a "
			code id="elements-2:the-template-element-5" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " element is placed\n  just after the "
			code id="elements-2:the-template-element-6" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " element's start tag and just before "
			code id="elements-2:the-template-element-7" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- "\n  element's end tag (as with other elements), and may consist of any "
			a href="#syntax-text" id="elements-2:syntax-text" {
				- "text"
			}
			- ", "
			a href="#syntax-charref" id="elements-2:syntax-charref" {
				- "character references"
			}
			- ", "
			a href="#syntax-elements" id="elements-2:syntax-elements" {
				- "elements"
			}
			- ", and "
			a href="#syntax-comments" id="elements-2:syntax-comments" {
				- "comments"
			}
			- ", but\n  the text must not contain the character U+003C LESS-THAN SIGN (<) or an "
			a href="#syntax-ambiguous-ampersand" id="elements-2:syntax-ambiguous-ampersand" {
				- "ambiguous ampersand"
			}
			- "."
		}
		- "\n\n  "
		p {
			a href="#raw-text-elements" id="elements-2:raw-text-elements-3" {
				- "Raw text elements"
			}
			- " can have "
			a href="#syntax-text" id="elements-2:syntax-text-2" {
				- "text"
			}
			- ", though it has "
			a href="#cdata-rcdata-restrictions" {
				- "restrictions"
			}
			- " described below."
		}
		- "\n\n  "
		p {
			a href="#escapable-raw-text-elements" id="elements-2:escapable-raw-text-elements-3" {
				- "Escapable raw text elements"
			}
			- " can have "
			a href="#syntax-text" id="elements-2:syntax-text-3" {
				- "text"
			}
			- " and\n  "
			a href="#syntax-charref" id="elements-2:syntax-charref-2" {
				- "character references"
			}
			- ", but the text must not contain an "
			a href="#syntax-ambiguous-ampersand" id="elements-2:syntax-ambiguous-ampersand-2" {
				- "ambiguous ampersand"
			}
			- ". There are also "
			a href="#cdata-rcdata-restrictions" {
				- "further restrictions"
			}
			- " described below."
		}
		- "\n\n  "
		p {
			a href="#foreign-elements" id="elements-2:foreign-elements-3" {
				- "Foreign elements"
			}
			- " whose start tag is marked as self-closing can't have any contents\n  (since, again, as there's no end tag, no content can be put between the start tag and the end\n  tag). "
			a href="#foreign-elements" id="elements-2:foreign-elements-4" {
				- "Foreign elements"
			}
			- " whose start tag is "
			em {
				- "not"
			}
			- " marked as self-closing can\n  have "
			a href="#syntax-text" id="elements-2:syntax-text-4" {
				- "text"
			}
			- ", "
			a href="#syntax-charref" id="elements-2:syntax-charref-3" {
				- "character\n  references"
			}
			- ", "
			a href="#syntax-cdata" id="elements-2:syntax-cdata" {
				- "CDATA sections"
			}
			- ", other "
			a href="#syntax-elements" id="elements-2:syntax-elements-2" {
				- "elements"
			}
			- ", and "
			a href="#syntax-comments" id="elements-2:syntax-comments-2" {
				- "comments"
			}
			- ", but\n  the text must not contain the character U+003C LESS-THAN SIGN (<) or an "
			a href="#syntax-ambiguous-ampersand" id="elements-2:syntax-ambiguous-ampersand-3" {
				- "ambiguous ampersand"
			}
			- "."
		}
		- "\n\n  "
		div class="note" {
			- "\n\n   "
			p {
				- "The HTML syntax does not support namespace declarations, even in "
				a href="#foreign-elements" id="elements-2:foreign-elements-5" {
					- "foreign\n   elements"
				}
				- "."
			}
			- "\n\n   "
			p {
				- "For instance, consider the following HTML fragment:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "svg"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "metadata"
					}
					c- p="" {
						- ">"
					}
					- "\n   "
					c- c="" {
						- "<!-- this is invalid -->"
					}
					- "\n   "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "cdr:license"
					}
					- " "
					c- e="" {
						- "xmlns:cdr"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://www.example.com/cdr/metadata\""
					}
					- " "
					c- e="" {
						- "name"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"MIT\""
					}
					c- p="" {
						- "/>"
					}
					- "\n  "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "metadata"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "svg"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "The innermost element, "
				code {
					- "cdr:license"
				}
				- ", is actually in the SVG namespace, as\n   the \""
				code {
					- "xmlns:cdr"
				}
				- "\" attribute has no effect (unlike in XML). In fact, as the\n   comment in the fragment above says, the fragment is actually non-conforming. This is because\n   "
				cite {
					- "SVG 2"
				}
				- " does not define any elements called \""
				code {
					- "cdr:license"
				}
				- "\" in\n   the SVG namespace."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			a href="#normal-elements" id="elements-2:normal-elements-4" {
				- "Normal elements"
			}
			- " can have "
			a href="#syntax-text" id="elements-2:syntax-text-5" {
				- "text"
			}
			- ", "
			a href="#syntax-charref" id="elements-2:syntax-charref-4" {
				- "character references"
			}
			- ", other "
			a href="#syntax-elements" id="elements-2:syntax-elements-3" {
				- "elements"
			}
			- ", and "
			a href="#syntax-comments" id="elements-2:syntax-comments-3" {
				- "comments"
			}
			- ", but\n  the text must not contain the character U+003C LESS-THAN SIGN (<) or an "
			a href="#syntax-ambiguous-ampersand" id="elements-2:syntax-ambiguous-ampersand-4" {
				- "ambiguous ampersand"
			}
			- ". Some "
			a href="#normal-elements" id="elements-2:normal-elements-5" {
				- "normal elements"
			}
			- "\n  also have "
			a href="#element-restrictions" {
				- "yet more restrictions"
			}
			- " on what content they are\n  allowed to hold, beyond the restrictions imposed by the content model and those described in this\n  paragraph. Those restrictions are described below."
		}
		- "\n\n  "
		p {
			- "Tags contain a "
			dfn id="syntax-tag-name" {
				- "tag name"
			}
			- ", giving the element's name. HTML\n  elements all have names that only use "
			a href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id="elements-2:alphanumeric-ascii-characters" data-x-internal="alphanumeric-ascii-characters" {
				- "ASCII\n  alphanumerics"
			}
			- ". In the HTML syntax, tag names, even those for "
			a href="#foreign-elements" id="elements-2:foreign-elements-6" {
				- "foreign elements"
			}
			- ",\n  may be written with any mix of lower- and uppercase letters that, when converted to all-lowercase,\n  matches the element's tag name; tag names are case-insensitive."
		}
		- "\n\n\n  "
		h5 id="start-tags" {
			span class="secno" {
				- "13.1.2.1"
			}
			- " Start tags"
			a href="#start-tags" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-start-tag" {
				- "Start tags"
			}
			- " must have the following format:"
		}
		- "\n\n  "
		ol {
			li {
				- "The first character of a start tag must be a U+003C LESS-THAN SIGN character (<)."
			}
			li {
				- "The next few characters of a start tag must be the element's "
				a href="#syntax-tag-name" id="start-tags:syntax-tag-name" {
					- "tag name"
				}
				- "."
			}
			li {
				- "If there are to be any attributes in the next step, there must first be one or more\n   "
				a id="start-tags:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "Then, the start tag may have a number of attributes, the "
				a href="#syntax-attributes" id="start-tags:syntax-attributes" {
					- "syntax for which"
				}
				- " is described below. Attributes must be\n   separated from each other by one or more "
				a id="start-tags:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "After the attributes, or after the "
				a href="#syntax-tag-name" id="start-tags:syntax-tag-name-2" {
					- "tag name"
				}
				- " if there\n   are no attributes, there may be one or more "
				a id="start-tags:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- ". (Some attributes are\n   required to be followed by a space. See the "
				a href="#syntax-attributes" id="start-tags:syntax-attributes-2" {
					- "attributes\n   section"
				}
				- " below.)"
			}
			li {
				- "Then, if the element is one of the "
				a href="#void-elements" id="start-tags:void-elements" {
					- "void elements"
				}
				- ", or if the element is a "
				a href="#foreign-elements" id="start-tags:foreign-elements" {
					- "foreign element"
				}
				- ", then there may be a single U+002F SOLIDUS\n   character (/), which on "
				a href="#foreign-elements" id="start-tags:foreign-elements-2" {
					- "foreign elements"
				}
				- " marks the start tag as self-closing. On\n   "
				a href="#void-elements" id="start-tags:void-elements-2" {
					- "void elements"
				}
				- ", it does not mark the start tag as self-closing but instead is\n   unnecessary and has no effect of any kind. For such void elements, it should be used only with\n   caution — especially since, if directly preceded by an "
				a href="#unquoted" {
					- "unquoted attribute\n   value"
				}
				- ", it becomes part of the attribute value rather than being discarded by the\n   parser."
			}
			li {
				- "Finally, start tags must be closed by a U+003E GREATER-THAN SIGN character (>)."
			}
		}
		- "\n\n\n  "
		h5 id="end-tags" {
			span class="secno" {
				- "13.1.2.2"
			}
			- " End tags"
			a href="#end-tags" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-end-tag" {
				- "End tags"
			}
			- " must have the following format:"
		}
		- "\n\n  "
		ol {
			li {
				- "The first character of an end tag must be a U+003C LESS-THAN SIGN character (<)."
			}
			li {
				- "The second character of an end tag must be a U+002F SOLIDUS character (/)."
			}
			li {
				- "The next few characters of an end tag must be the element's "
				a href="#syntax-tag-name" id="end-tags:syntax-tag-name" {
					- "tag\n   name"
				}
				- "."
			}
			li {
				- "After the tag name, there may be one or more "
				a id="end-tags:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
					- "ASCII whitespace"
				}
				- "."
			}
			li {
				- "Finally, end tags must be closed by a U+003E GREATER-THAN SIGN character (>)."
			}
		}
		- "\n\n\n  "
		h5 id="attributes-2" {
			span class="secno" {
				- "13.1.2.3"
			}
			- " Attributes"
			a href="#attributes-2" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-attributes" {
				- "Attributes"
			}
			- " for an element are expressed inside the\n  element's start tag."
		}
		- "\n\n  "
		p {
			- "Attributes have a name and a value. "
			dfn id="syntax-attribute-name" {
				- "Attribute names"
			}
			- "\n  must consist of one or more characters other than "
			a href="https://infra.spec.whatwg.org/#control" id="attributes-2:control" data-x-internal="control" {
				- "controls"
			}
			- ",\n  U+0020 SPACE, U+0022 (\"), U+0027 ('), U+003E (>), U+002F (/), U+003D (=), and "
			a href="https://infra.spec.whatwg.org/#noncharacter" id="attributes-2:noncharacter" data-x-internal="noncharacter" {
				- "noncharacters"
			}
			- ". In the HTML syntax, attribute names, even those for\n  "
			a href="#foreign-elements" id="attributes-2:foreign-elements" {
				- "foreign elements"
			}
			- ", may be written with any mix of "
			a href="https://infra.spec.whatwg.org/#ascii-lower-alpha" id="attributes-2:lowercase-ascii-letters" data-x-internal="lowercase-ascii-letters" {
				- "ASCII lower"
			}
			- " and "
			a href="https://infra.spec.whatwg.org/#ascii-upper-alpha" id="attributes-2:uppercase-ascii-letters" data-x-internal="uppercase-ascii-letters" {
				- "ASCII upper alphas"
			}
			- "."
		}
		- "\n\n  "
		p {
			dfn id="syntax-attribute-value" {
				- "Attribute values"
			}
			- " are a mixture of "
			a href="#syntax-text" id="attributes-2:syntax-text" {
				- "text"
			}
			- " and "
			a href="#syntax-charref" id="attributes-2:syntax-charref" {
				- "character references"
			}
			- ",\n  except with the additional restriction that the text cannot contain an "
			a href="#syntax-ambiguous-ampersand" id="attributes-2:syntax-ambiguous-ampersand" {
				- "ambiguous ampersand"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Attributes can be specified in four different ways:"
		}
		- "\n\n  "
		dl {
			dt {
				- "Empty attribute syntax"
			}
			dd {
				- "\n    "
				p {
					- "Just the "
					a href="#syntax-attribute-name" id="attributes-2:syntax-attribute-name" {
						- "attribute name"
					}
					- ". The value is implicitly\n    the empty string."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In the following example, the "
						code id="attributes-2:attr-fe-disabled" {
							a href="#attr-fe-disabled" {
								- "disabled"
							}
						}
						- " attribute is\n     given with the empty attribute syntax:"
					}
					- "\n\n     "
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "input"
							}
							- " "
							em {
								c- e="" {
									- "disabled"
								}
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n    "
				}
				- "\n\n    "
				p {
					- "If an attribute using the empty attribute syntax is to be followed by another attribute, then\n    there must be "
					a id="attributes-2:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- " separating the two."
				}
				- "\n   "
			}
			dt id="unquoted" {
				- "Unquoted attribute value syntax"
			}
			dd {
				- "\n    "
				p {
					- "The "
					a href="#syntax-attribute-name" id="attributes-2:syntax-attribute-name-2" {
						- "attribute name"
					}
					- ", followed by zero or more\n    "
					a id="attributes-2:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by a single U+003D EQUALS SIGN character, followed by\n    zero or more "
					a id="attributes-2:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by the "
					a href="#syntax-attribute-value" id="attributes-2:syntax-attribute-value" {
						- "attribute value"
					}
					- ", which, in addition to the requirements\n    given above for attribute values, must not contain any literal "
					a id="attributes-2:space-characters-4" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ",\n    any U+0022 QUOTATION MARK characters (\"), U+0027 APOSTROPHE characters ('), U+003D\n    EQUALS SIGN characters (=), U+003C LESS-THAN SIGN characters (<), U+003E GREATER-THAN SIGN\n    characters (>), or U+0060 GRAVE ACCENT characters (`), and must not be the empty string."
				}
				- "\n\n    \n\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In the following example, the "
						code id="attributes-2:attr-input-value" {
							a href="#attr-input-value" {
								- "value"
							}
						}
						- " attribute is given\n     with the unquoted attribute value syntax:"
					}
					- "\n\n     "
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "input"
							}
							- " "
							em {
								c- e="" {
									- "value"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "yes"
								}
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n    "
				}
				- "\n\n    "
				p {
					- "If an attribute using the unquoted attribute syntax is to be followed by another attribute or\n    by the optional U+002F SOLIDUS character (/) allowed in step 6 of the "
					a href="#syntax-start-tag" id="attributes-2:syntax-start-tag" {
						- "start tag"
					}
					- " syntax above, then there must be "
					a id="attributes-2:space-characters-5" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII\n    whitespace"
					}
					- " separating the two."
				}
				- "\n   "
			}
			dt {
				- "Single-quoted attribute value syntax"
			}
			dd {
				- "\n    "
				p {
					- "The "
					a href="#syntax-attribute-name" id="attributes-2:syntax-attribute-name-3" {
						- "attribute name"
					}
					- ", followed by zero or more\n    "
					a id="attributes-2:space-characters-6" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by a single U+003D EQUALS SIGN character, followed by\n    zero or more "
					a id="attributes-2:space-characters-7" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by a single U+0027 APOSTROPHE character\n    ('), followed by the "
					a href="#syntax-attribute-value" id="attributes-2:syntax-attribute-value-2" {
						- "attribute value"
					}
					- ", which, in\n    addition to the requirements given above for attribute values, must not contain any literal\n    U+0027 APOSTROPHE characters ('), and finally followed by a second single U+0027 APOSTROPHE\n    character (')."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In the following example, the "
						code id="attributes-2:attr-input-type" {
							a href="#attr-input-type" {
								- "type"
							}
						}
						- " attribute is given\n     with the single-quoted attribute value syntax:"
					}
					- "\n\n     "
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "input"
							}
							- " "
							em {
								c- e="" {
									- "type"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "'checkbox'"
								}
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n    "
				}
				- "\n\n    "
				p {
					- "If an attribute using the single-quoted attribute syntax is to be followed by another\n    attribute, then there must be "
					a id="attributes-2:space-characters-8" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- " separating the two."
				}
				- "\n   "
			}
			dt {
				- "Double-quoted attribute value syntax"
			}
			dd {
				- "\n    "
				p {
					- "The "
					a href="#syntax-attribute-name" id="attributes-2:syntax-attribute-name-4" {
						- "attribute name"
					}
					- ", followed by zero or more\n    "
					a id="attributes-2:space-characters-9" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by a single U+003D EQUALS SIGN character, followed by\n    zero or more "
					a id="attributes-2:space-characters-10" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ", followed by a single U+0022 QUOTATION MARK character\n    (\"), followed by the "
					a href="#syntax-attribute-value" id="attributes-2:syntax-attribute-value-3" {
						- "attribute value"
					}
					- ", which, in\n    addition to the requirements given above for attribute values, must not contain any literal\n    U+0022 QUOTATION MARK characters (\"), and finally followed by a second single U+0022 QUOTATION\n    MARK character (\")."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In the following example, the "
						code id="attributes-2:attr-fe-name" {
							a href="#attr-fe-name" {
								- "name"
							}
						}
						- " attribute is given with\n     the double-quoted attribute value syntax:"
					}
					- "\n\n     "
					pre {
						code class="html" {
