		- "\n  \n\n  "
		p {
			- "An "
			a href="#event-loop" id="event-loop-processing-model:event-loop" {
				- "event loop"
			}
			- " must continually run through the following steps for as long as it\n  exists:"
		}
		- "\n\n  \n  "
		ol id="step1" {
			li {
				p {
					- "Let "
					var {
						- "oldestTask"
					}
					- " and "
					var {
						- "taskStartTime"
					}
					- " be null."
				}
			}
			li {
				- "\n    "
				p {
					- "If the "
					a href="#event-loop" id="event-loop-processing-model:event-loop-2" {
						- "event loop"
					}
					- " has a "
					a href="#task-queue" id="event-loop-processing-model:task-queue" {
						- "task queue"
					}
					- " with at least one "
					a href="#concept-task-runnable" id="event-loop-processing-model:concept-task-runnable" {
						- "runnable"
					}
					- " "
					a href="#concept-task" id="event-loop-processing-model:concept-task" {
						- "task"
					}
					- ",\n    then:"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "taskQueue"
							}
							- " be one such "
							a href="#task-queue" id="event-loop-processing-model:task-queue-2" {
								- "task queue"
							}
							- ", chosen in an\n      "
							a id="event-loop-processing-model:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
								- "implementation-defined"
							}
							- " manner."
						}
						- "\n\n      "
						p class="note" {
							- "Remember that the "
							a href="#microtask-queue" id="event-loop-processing-model:microtask-queue" {
								- "microtask queue"
							}
							- " is not a "
							a href="#task-queue" id="event-loop-processing-model:task-queue-3" {
								- "task\n      queue"
							}
							- ", so it will not be chosen in this step. However, a "
							a href="#task-queue" id="event-loop-processing-model:task-queue-4" {
								- "task queue"
							}
							- " to\n      which the "
							a href="#microtask-task-source" id="event-loop-processing-model:microtask-task-source" {
								- "microtask task source"
							}
							- " is associated might be chosen in this step. In\n      that case, the "
							a href="#concept-task" id="event-loop-processing-model:concept-task-2" {
								- "task"
							}
							- " chosen in the next step was originally\n      a "
							a href="#microtask" id="event-loop-processing-model:microtask" {
								- "microtask"
							}
							- ", but it got moved as part of "
							a href="#spin-the-event-loop" id="event-loop-processing-model:spin-the-event-loop" {
								- "spinning the event loop"
							}
							- "."
						}
						- "\n     "
					}
					li {
						p {
							- "Set "
							var {
								- "taskStartTime"
							}
							- " to the "
							a id="event-loop-processing-model:unsafe-shared-current-time" href="https://w3c.github.io/hr-time/#dfn-unsafe-shared-current-time" data-x-internal="unsafe-shared-current-time" {
								- "unsafe shared current time"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "oldestTask"
							}
							- " to the first "
							a href="#concept-task-runnable" id="event-loop-processing-model:concept-task-runnable-2" {
								- "runnable"
							}
							- " "
							a href="#concept-task" id="event-loop-processing-model:concept-task-3" {
								- "task"
							}
							- " in\n     "
							var {
								- "taskQueue"
							}
							- ", and "
							a href="https://infra.spec.whatwg.org/#list-remove" id="event-loop-processing-model:list-remove" data-x-internal="list-remove" {
								- "remove"
							}
							- " it from\n     "
							var {
								- "taskQueue"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "oldestTask"
							}
							- "'s "
							a href="#concept-task-document" id="event-loop-processing-model:concept-task-document" {
								- "document"
							}
							- " is not\n     null, then "
							a id="event-loop-processing-model:record-task-start-time" href="https://w3c.github.io/long-animation-frames/#record-task-start-time" data-x-internal="record-task-start-time" {
								- "record task start time"
							}
							- " given "
							var {
								- "taskStartTime"
							}
							- " and\n     "
							var {
								- "oldestTask"
							}
							- "'s "
							a href="#concept-task-document" id="event-loop-processing-model:concept-task-document-2" {
								- "document"
							}
							- "."
						}
					}
					li {
						p {
							- "Set the "
							a href="#event-loop" id="event-loop-processing-model:event-loop-3" {
								- "event loop"
							}
							- "'s "
							a href="#currently-running-task" id="event-loop-processing-model:currently-running-task" {
								- "currently running task"
							}
							- " to\n     "
							var {
								- "oldestTask"
							}
							- "."
						}
					}
					li {
						p {
							- "Perform "
							var {
								- "oldestTask"
							}
							- "'s "
							a href="#concept-task-steps" id="event-loop-processing-model:concept-task-steps" {
								- "steps"
							}
							- "."
						}
					}
					li {
						p {
							- "Set the "
							a href="#event-loop" id="event-loop-processing-model:event-loop-4" {
								- "event loop"
							}
							- "'s "
							a href="#currently-running-task" id="event-loop-processing-model:currently-running-task-2" {
								- "currently running task"
							}
							- " back to\n     null."
						}
					}
