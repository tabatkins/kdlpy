			- "\n\n   "
			p {
				- "The outer item here has two properties, \"name\" and \"band\". The \"name\" is \"Amanda\", and the\n   \"band\" is an item in its own right, with two properties, \"name\" and \"size\". The \"name\" of the\n   band is \"Jazz Band\", and the \"size\" is \"12\"."
			}
			- "\n\n   "
			p {
				- "The outer item in this example is a top-level microdata item."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "Properties that are not descendants of the element with the "
			code id="the-basic-syntax:attr-itemscope-3" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute can be associated with the "
			a href="#concept-item" id="the-basic-syntax:concept-item-3" {
				- "item"
			}
			- " using the "
			code id="the-basic-syntax:attr-itemref" {
				a href="#attr-itemref" {
					- "itemref"
				}
			}
			- " attribute.\n  This attribute takes a list of IDs of elements to crawl in addition to crawling the children of\n  the element with the "
			code id="the-basic-syntax:attr-itemscope-4" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
