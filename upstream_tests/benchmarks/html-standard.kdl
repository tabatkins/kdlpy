			- "\n\n   "
			p {
				- "MIME type checking for module scripts is strict. In order for the fetch of the "
				a href="#json-module-script" id="the-script-element:json-module-script-3" {
					- "JSON\n   module script"
				}
				- " to succeed, the HTTP response must have a "
				a id="the-script-element:json-mime-type" href="https://mimesniff.spec.whatwg.org/#json-mime-type" data-x-internal="json-mime-type" {
					- "JSON MIME type"
				}
				- ", for\n   example "
				code {
					- "Content-Type: text/json"
				}
				- ". On the other hand, if the "
				code {
					- "with { type: \"json\" }"
				}
				- " part of the statement is omitted, it is assumed that the\n   intent is to import a "
				a href="#javascript-module-script" id="the-script-element:javascript-module-script-11" {
					- "JavaScript module script"
				}
				- ", and the fetch will fail if the HTTP\n   response has a MIME type that is not a "
				a id="the-script-element:javascript-mime-type" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" data-x-internal="javascript-mime-type" {
					- "JavaScript MIME type"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		h5 id="script-processing-model" {
			span class="secno" {
				- "4.12.1.1"
			}
			- " Processing model"
			a href="#script-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			code id="script-processing-model:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element has several associated pieces of state."
		}
		- "\n\n  "
		p {
			- "A "
			code id="script-processing-model:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element has a "
			dfn id="parser-document" {
				- "parser document"
			}
			- ", which is either null or a\n  "
			code id="script-processing-model:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ", initially null. It is set by the "
			a href="#html-parser" id="script-processing-model:html-parser" {
				- "HTML parser"
			}
			- " and the\n  "
			a href="#xml-parser" id="script-processing-model:xml-parser" {
				- "XML parser"
			}
			- " on "
			code id="script-processing-model:the-script-element-3" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements they insert, and affects the processing\n  of those elements. "
			code id="script-processing-model:the-script-element-4" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements with non-null "
			a href="#parser-document" id="script-processing-model:parser-document" {
				- "parser documents"
			}
			- " are known as "
			dfn data-dfn-for="script" id="parser-inserted" data-export="" {
				- "parser-inserted"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			code id="script-processing-model:the-script-element-5" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element has a "
			dfn id="preparation-time-document" {
				- "preparation-time document"
			}
			- ", which is either null\n  or a "
			code id="script-processing-model:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- ", initially null. It is used to prevent scripts that move between\n  documents during "
			a href="#prepare-the-script-element" id="script-processing-model:prepare-the-script-element" {
				- "preparation"
			}
			- " from "
			a href="#execute-the-script-element" id="script-processing-model:execute-the-script-element" {
				- "executing"
			}
			- "."
		}
		- "\n\n  "
		p id="non-blocking" {
			- "A "
			code id="script-processing-model:the-script-element-6" {
				a href="#the-script-element" {
