				- "id"
			}
			- ". A "
			code id="attributes-common-to-td-and-th-elements:the-th-element-9" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- " element "
			var {
				- "A"
			}
			- " is said to be "
			i {
				- "targeted"
			}
			- " by a "
			code id="attributes-common-to-td-and-th-elements:the-th-element-10" {
				a href="#the-th-element" {
					- "th"
				}
			}
