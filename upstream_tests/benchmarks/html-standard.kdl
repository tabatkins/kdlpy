							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android unknown" {
								span {
									- "Opera Android"
								}
								span {
									- "?"
								}
							}
						}
					}
				}
			}
			dt {
				code {
					var {
						- "styles"
					}
					- "."
					a href="#dom-context-2d-linedashoffset" id="line-styles:dom-context-2d-linedashoffset" {
						- "lineDashOffset"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the phase offset (in the same units as the line dash pattern)."
				}
				- "\n\n    "
				p {
					- "Can be set, to change the phase offset. Values that are not finite values are ignored."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Objects that implement the "
			code id="line-styles:canvaspathdrawingstyles" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface have attributes and\n  methods (defined in this section) that control how lines are treated by the object."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-linewidth" data-dfn-type="attribute" {
				code {
					- "lineWidth"
				}
			}
			- " attribute gives the width of lines, in\n  coordinate space units. On getting, it must return the current value. On setting, zero, negative,\n  infinite, and NaN values must be ignored, leaving the value unchanged; other values must change\n  the current value to the new value."
		}
		- "\n\n  "
		p {
			- "When the object implementing the "
			code id="line-styles:canvaspathdrawingstyles-2" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface is created, the\n  "
			code id="line-styles:dom-context-2d-linewidth-2" {
				a href="#dom-context-2d-linewidth" {
					- "lineWidth"
				}
			}
			- " attribute must initially have the value\n  1.0."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-linecap" data-dfn-type="attribute" {
				code {
					- "lineCap"
				}
			}
			- " attribute defines the type of endings that\n  UAs will place on the end of lines. The three valid values are \""
			code {
				- "butt"
			}
			- "\",\n  \""
			code {
				- "round"
			}
			- "\", and \""
			code {
				- "square"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "On getting, it must return the current value. On setting, the current value must be changed\n  to the new value."
		}
		- "\n\n  "
		p {
			- "When the object implementing the "
			code id="line-styles:canvaspathdrawingstyles-3" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface is created, the\n  "
			code id="line-styles:dom-context-2d-linecap-2" {
				a href="#dom-context-2d-linecap" {
					- "lineCap"
				}
			}
			- " attribute must initially have the value\n  \""
			code {
				- "butt"
			}
			- "\"."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-linejoin" data-dfn-type="attribute" {
				code {
					- "lineJoin"
				}
			}
			- " attribute defines the type of corners that\n  UAs will place where two lines meet. The three valid values are \""
			code {
				- "bevel"
			}
			- "\",\n  \""
			code {
				- "round"
			}
			- "\", and \""
			code {
				- "miter"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "On getting, it must return the current value. On setting, the current value must be changed\n  to the new value."
		}
		- "\n\n  "
		p {
			- "When the object implementing the "
			code id="line-styles:canvaspathdrawingstyles-4" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface is created, the\n  "
			code id="line-styles:dom-context-2d-linejoin-2" {
				a href="#dom-context-2d-linejoin" {
					- "lineJoin"
				}
			}
			- " attribute must initially have the value\n  \""
			code {
				- "miter"
			}
			- "\"."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When the "
			code id="line-styles:dom-context-2d-linejoin-3" {
				a href="#dom-context-2d-linejoin" {
					- "lineJoin"
				}
			}
			- " attribute has the value \""
			code {
				- "miter"
			}
			- "\", strokes use the miter limit ratio to decide how to render joins. The\n  miter limit ratio can be explicitly set using the "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-miterlimit" data-dfn-type="attribute" {
				code {
					- "miterLimit"
				}
			}
			- "\n  attribute. On getting, it must return the current value. On setting, zero, negative, infinite, and\n  NaN values must be ignored, leaving the value unchanged; other values must change the current\n  value to the new value."
		}
		- "\n  \n\n  "
		p {
			- "When the object implementing the "
			code id="line-styles:canvaspathdrawingstyles-5" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface is created, the\n  "
			code id="line-styles:dom-context-2d-miterlimit-2" {
				a href="#dom-context-2d-miterlimit" {
					- "miterLimit"
				}
			}
			- " attribute must initially have the value\n  10.0."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			code id="line-styles:canvaspathdrawingstyles-6" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " object has a "
			dfn id="dash-list" {
				- "dash list"
			}
			- ", which is either\n  empty or consists of an even number of non-negative numbers. Initially, the "
			a href="#dash-list" id="line-styles:dash-list" {
				- "dash list"
			}
			- "\n  must be empty."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-setlinedash" data-dfn-type="method" {
				code {
					- "setLineDash("
					var {
						- "segments"
					}
					- ")"
				}
			}
			- " method, when invoked, must run\n  these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If any value in "
					var {
						- "segments"
					}
					- " is not finite (e.g. an Infinity or a NaN value), or\n   if any value is negative (less than zero), then return (without throwing an exception;\n   user agents could show a message on a developer console, though, as that would be helpful for\n   debugging)."
				}
			}
			li {
				p {
					- "If the number of elements in "
					var {
						- "segments"
					}
					- " is odd, then let "
					var {
						- "segments"
					}
					- "\n   be the concatenation of two copies of "
					var {
						- "segments"
					}
					- "."
				}
			}
			li {
				p {
					- "Let the object's "
					a href="#dash-list" id="line-styles:dash-list-2" {
						- "dash list"
					}
					- " be "
					var {
						- "segments"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-getlinedash" data-dfn-type="method" {
				code {
					- "getLineDash()"
				}
			}
			- " method is invoked, it must return a\n  sequence whose values are the values of the object's "
			a href="#dash-list" id="line-styles:dash-list-3" {
				- "dash list"
			}
			- ", in the same\n  order."
		}
		- "\n\n  "
		p {
			- "It is sometimes useful to change the \"phase\" of the dash pattern, e.g. to achieve a \"marching\n  ants\" effect. The phase can be set using the "
			dfn data-dfn-for="CanvasPathDrawingStyles" id="dom-context-2d-linedashoffset" data-dfn-type="attribute" {
				code {
					- "lineDashOffset"
				}
			}
			- " attribute. On getting, it must\n  return the current value. On setting, infinite and NaN values must be ignored, leaving the value\n  unchanged; other values must change the current value to the new value."
		}
		- "\n\n  "
		p {
			- "When the object implementing the "
			code id="line-styles:canvaspathdrawingstyles-7" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface is created, the\n  "
			code id="line-styles:dom-context-2d-linedashoffset-2" {
				a href="#dom-context-2d-linedashoffset" {
					- "lineDashOffset"
				}
			}
			- " attribute must initially have\n  the value 0.0."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="trace-a-path" {
				- "trace a path"
			}
			- ", given an object "
			var {
				- "style"
			}
			- "\n  that implements the "
			code id="line-styles:canvaspathdrawingstyles-8" {
				a href="#canvaspathdrawingstyles" {
					- "CanvasPathDrawingStyles"
				}
			}
			- " interface, it must run the following\n  algorithm. This algorithm returns a new "
			a href="#concept-path" id="line-styles:concept-path" {
				- "path"
			}
			- "."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "path"
					}
					- " be a copy of the path being traced."
				}
			}
			li {
				p {
					- "Prune all zero-length "
					a href="#line-segments" id="line-styles:line-segments" {
						- "line segments"
					}
					- " from "
					var {
						- "path"
					}
					- "."
				}
			}
			li {
				p {
					- "Remove from "
					var {
						- "path"
					}
					- " any subpaths containing no lines (i.e. subpaths with\n   just one point)."
				}
			}
			li {
				p {
					- "Replace each point in each subpath of "
					var {
						- "path"
					}
					- " other than the first point\n   and the last point of each subpath by a "
					i {
						- "join"
					}
					- " that joins the line leading to that point to\n   the line leading out of that point, such that the subpaths all consist of two points (a starting\n   point with a line leading out of it, and an ending point with a line leading into it), one or\n   more lines (connecting the points and the joins), and zero or more joins (each connecting one\n   line to another), connected together such that each subpath is a series of one or more lines with\n   a join between each one and a point on each end."
				}
			}
			li {
				p {
					- "Add a straight closing line to each closed subpath in "
					var {
						- "path"
					}
					- " connecting\n   the last point and the first point of that subpath; change the last point to a join (from the\n   previously last line to the newly added closing line), and change the first point to a join (from\n   the newly added closing line to the first line)."
				}
				- "\n\n   "
			}
			li {
				p {
					- "If "
					var {
						- "style"
					}
					- "'s "
					a href="#dash-list" id="line-styles:dash-list-4" {
						- "dash list"
					}
					- " is empty, then jump to the step\n   labeled "
					i {
						- "convert"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "pattern width"
					}
					- " be the concatenation of all the entries of\n   "
					var {
						- "style"
					}
					- "'s "
					a href="#dash-list" id="line-styles:dash-list-5" {
						- "dash list"
					}
					- ", in coordinate space units."
				}
				- "\n\n   "
			}
			li {
				p {
					- "For each subpath "
					var {
						- "subpath"
					}
					- " in "
					var {
						- "path"
					}
					- ", run the\n   following substeps. These substeps mutate the subpaths in "
					var {
						- "path"
					}
					- " "
					i {
						- "in\n   vivo"
					}
					- "."
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "subpath width"
							}
							- " be the length of all the lines of "
							var {
								- "subpath"
							}
							- ", in coordinate space units."
						}
						- "\n\n     "
					}
					li {
						p {
							- "Let "
							var {
								- "offset"
							}
							- " be the value of "
							var {
								- "style"
							}
							- "'s "
							code id="line-styles:dom-context-2d-linedashoffset-3" {
								a href="#dom-context-2d-linedashoffset" {
									- "lineDashOffset"
								}
							}
							- ", in coordinate space\n     units."
						}
					}
					li {
						- "\n      "
						p {
							- "While "
							var {
								- "offset"
							}
							- " is greater than "
							var {
								- "pattern width"
							}
							- ",\n      decrement it by "
							var {
								- "pattern width"
							}
							- "."
						}
						- "\n\n      "
						p {
							- "While "
							var {
								- "offset"
							}
							- " is less than zero, increment it by "
							var {
								- "pattern\n      width"
							}
							- "."
						}
						- "\n     "
					}
					li {
						p {
							- "Define "
							var {
								- "L"
							}
							- " to be a linear coordinate line defined along all lines in\n     "
							var {
								- "subpath"
							}
							- ", such that the start of the first line in the subpath is defined\n     as coordinate 0, and the end of the last line in the subpath is defined as coordinate "
							var {
								- "subpath width"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "position"
							}
							- " be zero minus "
							var {
								- "offset"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "index"
							}
							- " be 0."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "current state"
							}
							- " be "
							i {
								- "off"
							}
							- " (the other states being "
							i {
								- "on"
							}
							- "\n     and "
							i {
								- "zero-on"
							}
							- ")."
						}
					}
					li {
						p {
							i {
								- "Dash on"
							}
							- ": Let "
							var {
								- "segment length"
							}
							- " be\n     the value of "
							var {
								- "style"
							}
							- "'s "
							a href="#dash-list" id="line-styles:dash-list-6" {
								- "dash\n     list"
							}
							- "'s "
							var {
								- "index"
							}
							- "th entry."
						}
					}
					li {
						p {
							- "Increment "
							var {
								- "position"
							}
							- " by "
							var {
								- "segment length"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "position"
							}
							- " is greater than "
							var {
								- "subpath width"
							}
							- ",\n     then end these substeps for this subpath and start them again for the next subpath; if there\n     are no more subpaths, then jump to the step labeled "
							i {
								- "convert"
							}
							- " instead."
						}
					}
					li {
						p {
							- "If "
							var {
								- "segment length"
							}
							- " is nonzero, then let "
							var {
								- "current state"
							}
							- " be\n     "
							i {
								- "on"
							}
							- "."
						}
					}
					li {
						p {
							- "Increment "
							var {
								- "index"
							}
							- " by one."
						}
					}
					li {
						p {
							i {
								- "Dash off"
							}
							- ": Let "
							var {
								- "segment\n     length"
							}
							- " be the value of "
							var {
								- "style"
							}
							- "'s "
							a href="#dash-list" id="line-styles:dash-list-7" {
								- "dash list"
							}
							- "'s "
							var {
								- "index"
							}
							- "th entry."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "start"
							}
							- " be the offset "
							var {
								- "position"
							}
							- " on "
							var {
								- "L"
							}
							- "."
						}
					}
					li {
						p {
							- "Increment "
							var {
								- "position"
							}
							- " by "
							var {
								- "segment length"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "position"
							}
							- " is less than zero, then jump to the step labeled\n     "
							i {
								- "post-cut"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "start"
							}
							- " is less than zero, then let "
							var {
								- "start"
							}
							- " be\n     zero."
						}
					}
					li {
						p {
							- "If "
							var {
								- "position"
							}
							- " is greater than "
							var {
								- "subpath width"
							}
							- ",\n     then let "
							var {
								- "end"
							}
							- " be the offset "
							var {
								- "subpath width"
							}
							- " on "
							var {
								- "L"
							}
							- ". Otherwise, let "
							var {
								- "end"
							}
							- " be the offset "
							var {
								- "position"
							}
							- " on "
							var {
								- "L"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Jump to the first appropriate step:"
						}
						- "\n\n      "
						dl class="switch" {
							dt {
								- "If "
								var {
									- "segment length"
								}
								- " is zero and "
								var {
									- "current state"
								}
								- " is\n       "
								i {
									- "off"
								}
							}
							dd {
								- "\n        "
								p {
									- "Do nothing, just continue to the next step."
								}
								- "\n       "
							}
							dt {
								- "If "
								var {
									- "current state"
								}
								- " is "
								i {
									- "off"
								}
							}
							dd {
								- "\n        "
								p {
									- "Cut the line on which "
									var {
										- "end"
									}
									- " finds itself short at "
									var {
										- "end"
									}
									- " and place a point there, cutting in two the subpath that it was in;\n        remove all line segments, joins, points, and subpaths that are between "
									var {
										- "start"
									}
									- " and "
									var {
										- "end"
									}
									- "; and finally place a single point at "
									var {
										- "start"
									}
									- " with no lines connecting to it."
								}
								- "\n\n        "
								p {
									- "The point has a "
									i {
										- "directionality"
									}
									- " for the purposes of drawing line caps (see below).\n        The directionality is the direction that the original line had at that point (i.e. when "
									var {
										- "L"
									}
									- " was defined above)."
								}
								- "\n       "
							}
							dt {
								- "Otherwise"
							}
							dd {
								- "\n        "
								p {
									- "Cut the line on which "
									var {
										- "start"
									}
									- " finds itself into two at "
									var {
										- "start"
									}
									- " and place a point there, cutting in two the subpath that it was in, and\n        similarly cut the line on which "
									var {
										- "end"
									}
									- " finds itself short at "
									var {
										- "end"
									}
									- " and place a point there, cutting in two the subpath that "
									em {
										- "it"
									}
									- " was in,\n        and then remove all line segments, joins, points, and subpaths that are between "
									var {
										- "start"
									}
									- " and "
									var {
										- "end"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "If "
									var {
										- "start"
									}
									- " and "
									var {
										- "end"
									}
									- " are the same point, then this\n        results in just the line being cut in two and two points being inserted there, with nothing\n        being removed, unless a join also happens to be at that point, in which case the join must\n        be removed."
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					li {
						p {
							i {
								- "Post-cut"
							}
							- ": If "
							var {
								- "position"
							}
							- " is greater than "
							var {
								- "subpath width"
							}
							- ", then jump to the step labeled "
							i {
								- "convert"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "segment length"
							}
							- " is greater than zero, then let\n     "
							var {
								- "positioned-at-on-dash"
							}
							- " be false."
						}
					}
					li {
						p {
							- "Increment "
							var {
								- "index"
							}
							- " by one. If it is equal to the number of entries in\n     "
							var {
								- "style"
							}
							- "'s "
							a href="#dash-list" id="line-styles:dash-list-8" {
								- "dash list"
							}
							- ", then let "
							var {
								- "index"
							}
							- " be\n     0."
						}
					}
					li {
						p {
							- "Return to the step labeled "
							i {
								- "dash on"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					i {
						- "Convert"
					}
					- ": This is the step that converts the path to a new path that represents its\n    stroke."
				}
				- "\n\n    "
				p {
					- "Create a new "
					a href="#concept-path" id="line-styles:concept-path-2" {
						- "path"
					}
					- " that describes the edge of the areas\n    that would be covered if a straight line of length equal to "
					var {
						- "style"
					}
					- "'s\n    "
					code id="line-styles:dom-context-2d-linewidth-3" {
						a href="#dom-context-2d-linewidth" {
							- "lineWidth"
						}
					}
					- " was swept along each subpath in "
					var {
						- "path"
					}
					- " while being kept at an angle such that the line is orthogonal to the path\n    being swept, replacing each point with the end cap necessary to satisfy "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linecap-3" {
						a href="#dom-context-2d-linecap" {
							- "lineCap"
						}
					}
					- " attribute as\n    described previously and elaborated below, and replacing each join with the join necessary to\n    satisfy "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linejoin-4" {
						a href="#dom-context-2d-linejoin" {
							- "lineJoin"
						}
					}
					- "\n    type, as defined below."
				}
				- "\n\n    "
				p {
					strong {
						- "Caps"
					}
					- ": Each point has a flat edge perpendicular to the direction of the line\n    coming out of it. This is then augmented according to the value of "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linecap-4" {
						a href="#dom-context-2d-linecap" {
							- "lineCap"
						}
					}
					- ". The \""
					code {
						- "butt"
					}
					- "\" value means that no additional line cap is added. The \""
					code {
						- "round"
					}
					- "\" value means that a semi-circle with the diameter equal to\n    "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linewidth-4" {
						a href="#dom-context-2d-linewidth" {
							- "lineWidth"
						}
					}
					- " width must\n    additionally be placed on to the line coming out of each point. The \""
					code {
						- "square"
					}
					- "\" value means that a rectangle with the length of "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linewidth-5" {
						a href="#dom-context-2d-linewidth" {
							- "lineWidth"
						}
					}
					- " width and the\n    width of half "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-linewidth-6" {
						a href="#dom-context-2d-linewidth" {
							- "lineWidth"
						}
					}
					- " width, placed flat against the edge\n    perpendicular to the direction of the line coming out of the point, must be added at each\n    point."
				}
				- "\n\n    "
				p {
					- "Points with no lines coming out of them must have two caps placed back-to-back as if it was\n    really two points connected to each other by an infinitesimally short straight line in the\n    direction of the point's "
					i {
						- "directionality"
					}
					- " (as defined above)."
				}
				- "\n\n    "
				p {
					strong {
						- "Joins"
					}
					- ": In addition to the point where a join occurs, two additional points\n    are relevant to each join, one for each line: the two corners found half the line width away\n    from the join point, one perpendicular to each line, each on the side furthest from the other\n    line."
				}
				- "\n\n    "
				p {
					- "A triangle connecting these two opposite corners with a straight line, with the third point\n    of the triangle being the join point, must be added at all joins. The "
					code id="line-styles:dom-context-2d-linejoin-5" {
						a href="#dom-context-2d-linejoin" {
							- "lineJoin"
						}
					}
					- " attribute controls whether anything else is\n    rendered. The three aforementioned values have the following meanings:"
				}
				- "\n\n    "
				p {
					- "The \""
					code {
						- "bevel"
					}
					- "\" value means that this is all that is rendered at\n    joins."
				}
				- "\n\n    "
				p {
					- "The \""
					code {
						- "round"
					}
					- "\" value means that an arc connecting the two aforementioned\n    corners of the join, abutting (and not overlapping) the aforementioned triangle, with the\n    diameter equal to the line width and the origin at the point of the join, must be added at\n    joins."
				}
				- "\n\n    "
				p {
					- "The \""
					code {
						- "miter"
					}
					- "\" value means that a second triangle must (if it can given\n    the miter length) be added at the join, with one line being the line between the two\n    aforementioned corners, abutting the first triangle, and the other two being continuations of\n    the outside edges of the two joining lines, as long as required to intersect without going over\n    the miter length."
				}
				- "\n\n    "
				p {
					- "The miter length is the distance from the point where the join occurs to the intersection of\n    the line edges on the outside of the join. The miter limit ratio is the maximum allowed ratio of\n    the miter length to half the line width. If the miter length would cause the miter limit ratio\n    (as set by "
					var {
						- "style"
					}
					- "'s "
					code id="line-styles:dom-context-2d-miterlimit-3" {
						a href="#dom-context-2d-miterlimit" {
							- "miterLimit"
						}
					}
					- " attribute) to be exceeded, then this second\n    triangle must not be added."
				}
				- " \n\n\n\n    "
				p {
					- "The subpaths in the newly created path must be oriented such that for any point, the number\n    of times a half-infinite straight line drawn from that point crosses a subpath is even if and\n    only if the number of times a half-infinite straight line drawn from that same point crosses a\n    subpath going in one direction is equal to the number of times it crosses a subpath going in the\n    other direction."
				}
				- "\n   "
			}
			li {
				p {
					- "Return the newly created path."
				}
			}
		}
