						- "origin"
					}
					- " of the "
					code id="downloading-resources:document" {
						a href="#document" {
							- "Document"
						}
					}
					- " in which the "
					a href="#downloading-hyperlinks" id="downloading-resources:downloading-hyperlinks" {
						- "download"
					}
					- " or "
					a href="#navigate" id="downloading-resources:navigate" {
						- "navigate"
					}
					- " action resulting in the\n   download was initiated, if any."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "resource origin"
					}
					- " be the "
					a href="#concept-origin" id="downloading-resources:concept-origin" {
						- "origin"
					}
					- " of the URL of the\n   resource being downloaded, unless that URL's "
					a href="https://url.spec.whatwg.org/#concept-url-scheme" id="downloading-resources:concept-url-scheme" data-x-internal="concept-url-scheme" {
						- "scheme"
					}
					- "\n   component is "
					code {
						- "data"
					}
					- ", in which case let "
					var {
						- "resource origin"
					}
					- " be\n   the same as the "
					var {
						- "interface origin"
					}
					- ", if any."
				}
			}
			li {
				p {
					- "If there is no "
					var {
						- "interface origin"
					}
					- ", then let "
					var {
						- "trusted\n   operation"
					}
					- " be true. Otherwise, let "
					var {
						- "trusted operation"
					}
					- " be true if "
					var {
						- "resource origin"
					}
					- " is the "
					a href="#same-origin" id="downloading-resources:same-origin" {
						- "same origin"
					}
					- " as "
					var {
						- "interface\n   origin"
					}
					- ", and false otherwise."
				}
			}
			li {
				p {
					- "If "
					var {
						- "trusted operation"
					}
					- " is true and the resource has a `"
					code id="downloading-resources:http-content-disposition-4" {
						a data-x-internal="http-content-disposition" href="https://httpwg.org/specs/rfc6266.html" {
							- "Content-Disposition"
						}
					}
					- "` header and that header includes\n   filename information, then let "
					var {
						- "filename"
					}
					- " have the value specified by the header, and\n   jump to the step labeled "
					i {
						- "sanitize"
					}
					- " below. "
					a href="#refsRFC6266" {
						- "[RFC6266]"
					}
				}
			}
			li {
				p {
					- "If the download was not initiated from a "
					a href="#hyperlink" id="downloading-resources:hyperlink-2" {
						- "hyperlink"
					}
					- " created by an\n   "
					code id="downloading-resources:the-a-element-2" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " or "
					code id="downloading-resources:the-area-element-2" {
						a href="#the-area-element" {
							- "area"
						}
					}
					- " element, or if the element of the "
					a href="#hyperlink" id="downloading-resources:hyperlink-3" {
						- "hyperlink"
					}
					- " from\n   which it was initiated did not have a "
					code id="downloading-resources:attr-hyperlink-download-5" {
						a href="#attr-hyperlink-download" {
							- "download"
						}
					}
					- "\n   attribute when the download was initiated, or if there was such an attribute but its value when\n   the download was initiated was the empty string, then jump to the step labeled "
					i {
						- "no proposed\n   filename"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "proposed filename"
					}
					- " have the value of the "
					code id="downloading-resources:attr-hyperlink-download-6" {
						a href="#attr-hyperlink-download" {
							- "download"
						}
					}
					- " attribute of the element of the\n   "
					a href="#hyperlink" id="downloading-resources:hyperlink-4" {
						- "hyperlink"
					}
					- " that initiated the download at the time the download was\n   initiated."
				}
			}
			li {
				p {
					- "If "
					var {
						- "trusted operation"
					}
					- " is true, let "
					var {
						- "filename"
					}
					- " have\n   the value of "
					var {
						- "proposed filename"
					}
					- ", and jump to the step labeled "
					i {
						- "sanitize"
					}
					- "\n   below."
				}
			}
			li {
				p {
					- "If the resource has a `"
					code id="downloading-resources:http-content-disposition-5" {
						a data-x-internal="http-content-disposition" href="https://httpwg.org/specs/rfc6266.html" {
							- "Content-Disposition"
						}
					}
					- "`\n   header and that header specifies the "
					code {
						- "attachment"
					}
					- " disposition type, let\n   "
					var {
						- "filename"
					}
					- " have the value of "
					var {
						- "proposed filename"
					}
					- ", and jump to the step labeled\n   "
					i {
						- "sanitize"
					}
					- " below. "
					a href="#refsRFC6266" {
						- "[RFC6266]"
					}
				}
			}
			li {
				p {
					i {
						- "No proposed filename"
					}
					- ": If "
					var {
						- "trusted operation"
					}
					- " is true, or if the\n   user indicated a preference for having the resource in question downloaded, let\n   "
					var {
						- "filename"
					}
					- " have a value derived from the "
					a id="downloading-resources:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " of the resource in an\n   "
					a id="downloading-resources:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- " manner, and jump to the step labeled "
					i {
						- "sanitize"
					}
					- " below."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "filename"
					}
					- " be set to the user's preferred filename or to a filename selected by\n    the user agent, and jump to the step labeled "
					i {
						- "sanitize"
					}
					- " below."
