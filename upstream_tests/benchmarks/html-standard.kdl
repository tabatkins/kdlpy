				}
			}
			- "\n  object "
			var {
				- "list"
			}
			- ", the user agent must return the "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-6" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " or\n  "
			code id="audiotracklist-and-videotracklist-objects:videotrack-6" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " object that represents the "
			var {
				- "index"
			}
			- "th track in "
			var {
