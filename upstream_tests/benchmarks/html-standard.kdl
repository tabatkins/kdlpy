			}
			- ". Its expected "
			a id="the-meter-element-2:native-appearance" href="https://drafts.csswg.org/css-ui/#native-appearance" data-x-internal="native-appearance" {
				- "native\n  appearance"
			}
			- " is to render as an "
			a id="the-meter-element-2:'inline-block'" href="https://drafts.csswg.org/css2/#value-def-inline-block" data-x-internal="'inline-block'" {
