		- "\n\n\n\n  "
		h5 id="the-style-attribute" {
			span class="secno" {
				- "3.2.6.5"
			}
			- " The "
			code id="the-style-attribute:attr-style" {
				a href="#attr-style" {
					- "style"
				}
			}
			- " attribute"
			a href="#the-style-attribute" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
