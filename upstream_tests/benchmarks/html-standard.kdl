					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "i"
					}
					c- p="" {
						- ">"
					}
					- "Maybe it won't be that bad"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "i"
					}
					c- p="" {
						- ">"
					}
					- ", he told himself. The lie was\ncomforting enough to get him through the rest of the night's\nshift."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
