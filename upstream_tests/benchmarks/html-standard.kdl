										- "continue"
									}
									- "."
								}
							}
							li {
								p {
									a href="#create-an-element-for-the-token" id="parsing-main-inbody:create-an-element-for-the-token" {
										- "Create an element for the token"
									}
									- " for which the element "
									var {
										- "node"
									}
									- " was\n       created, in the "
									a id="parsing-main-inbody:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
										- "HTML namespace"
									}
									- ", with "
									var {
										- "commonAncestor"
									}
									- " as the intended\n       parent; replace the entry for "
									var {
										- "node"
									}
									- " in the "
									a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-11" {
										- "list of active formatting\n       elements"
									}
									- " with an entry for the new element, replace the entry for "
									var {
										- "node"
									}
									- " in\n       the "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-76" {
										- "stack of open elements"
									}
									- " with an entry for the new element, and let\n       "
									var {
										- "node"
									}
									- " be the new element."
								}
							}
							li {
								p {
									- "If "
									var {
										- "lastNode"
									}
									- " is "
									var {
										- "furthestBlock"
									}
									- ", then move the aforementioned\n       bookmark to be immediately after the new "
									var {
										- "node"
									}
									- " in the "
									a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-12" {
										- "list of active\n       formatting elements"
									}
									- "."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-node-append" id="parsing-main-inbody:concept-node-append" data-x-internal="concept-node-append" {
										- "Append"
									}
									- " "
									var {
										- "lastNode"
									}
									- " to\n       "
									var {
										- "node"
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									var {
										- "lastNode"
									}
									- " to "
									var {
										- "node"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							- "Insert whatever "
							var {
								- "lastNode"
							}
							- " ended up being in the previous step at the\n     "
							a href="#appropriate-place-for-inserting-a-node" id="parsing-main-inbody:appropriate-place-for-inserting-a-node" {
								- "appropriate place for inserting a node"
							}
							- ", but using "
							var {
								- "commonAncestor"
							}
							- "\n     as the "
							i {
								- "override target"
							}
							- "."
						}
					}
					li {
						p {
							a href="#create-an-element-for-the-token" id="parsing-main-inbody:create-an-element-for-the-token-2" {
								- "Create an element for the token"
							}
							- " for which "
							var {
								- "formattingElement"
							}
							- " was created,\n     in the "
							a id="parsing-main-inbody:html-namespace-2-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
								- "HTML namespace"
							}
							- ", with "
							var {
								- "furthestBlock"
							}
							- " as the intended parent."
						}
					}
					li {
						p {
							- "Take all of the child nodes of "
							var {
								- "furthestBlock"
							}
							- " and append them to the\n     element created in the last step."
						}
					}
					li {
						p {
							- "Append that new element to "
							var {
								- "furthestBlock"
							}
							- "."
						}
					}
					li {
						p {
							- "Remove "
							var {
								- "formattingElement"
							}
							- " from the "
							a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-13" {
								- "list of active formatting\n     elements"
							}
							- ", and insert the new element into the "
							a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-14" {
								- "list of active formatting\n     elements"
							}
							- " at the position of the aforementioned bookmark."
						}
					}
					li {
						p {
							- "Remove "
							var {
								- "formattingElement"
							}
							- " from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-77" {
								- "stack of open\n     elements"
							}
							- ", and insert the new element into the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-78" {
								- "stack of open elements"
							}
							- "\n     immediately below the position of "
							var {
								- "furthestBlock"
							}
							- " in that stack."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p class="note" {
			- "This algorithm's name, the \"adoption agency algorithm\", comes from the way it\n  causes elements to change parents, and is in contrast with "
			a href="https://ln.hixie.ch/?start=1037910467&count=1" {
				- "other possible algorithms"
			}
			- " for dealing\n  with misnested content."
		}
		- "\n\n\n\n\n\n  "
		h6 id="parsing-main-incdata" {
			span class="secno" {
				- "13.2.6.4.8"
			}
			- " The \""
			dfn {
				- "text"
			}
			- "\" insertion mode"
			a href="#parsing-main-incdata" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-incdata" id="parsing-main-incdata:parsing-main-incdata" {
				- "text"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-incdata:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as\n  follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-character" id="parsing-main-incdata:insert-a-character" {
						- "Insert the token's character"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This can never be a U+0000 NULL character; the tokenizer converts those to\n    U+FFFD REPLACEMENT CHARACTER characters."
				}
				- "\n   "
			}
			dt {
				- "An end-of-file token"
			}
			dd {
				- "\n    \n    "
				p {
					a href="#parse-errors" id="parsing-main-incdata:parse-errors" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#current-node" id="parsing-main-incdata:current-node" {
						- "current node"
					}
					- " is a "
					code id="parsing-main-incdata:the-script-element" {
						a href="#the-script-element" {
							- "script"
						}
					}
					- " element, then set its "
					a href="#already-started" id="parsing-main-incdata:already-started" {
						- "already\n    started"
					}
					- " to true."
				}
				- "\n\n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-incdata:current-node-2" {
						- "current node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-incdata:stack-of-open-elements" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-incdata:insertion-mode-2" {
						- "insertion mode"
					}
					- " to the "
					a href="#original-insertion-mode" id="parsing-main-incdata:original-insertion-mode" {
						- "original insertion mode"
					}
					- " and\n    reprocess the token."
				}
				- "\n   "
			}
			dt id="scriptEndTag" {
				- "An end tag whose tag name is \"script\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#active-speculative-html-parser" id="parsing-main-incdata:active-speculative-html-parser" {
						- "active speculative HTML parser"
					}
					- " is null and the "
					a id="parsing-main-incdata:javascript-execution-context-stack" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution\n    context stack"
					}
					- " is empty, then "
					a href="#perform-a-microtask-checkpoint" id="parsing-main-incdata:perform-a-microtask-checkpoint" {
						- "perform a microtask checkpoint"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Let "
					var {
						- "script"
					}
					- " be the "
					a href="#current-node" id="parsing-main-incdata:current-node-3" {
						- "current node"
					}
					- " (which will be a\n    "
					code id="parsing-main-incdata:the-script-element-2" {
						a href="#the-script-element" {
							- "script"
						}
					}
					- " element)."
				}
				- "\n\n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-incdata:current-node-4" {
						- "current node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-incdata:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-incdata:insertion-mode-3" {
						- "insertion mode"
					}
					- " to the "
					a href="#original-insertion-mode" id="parsing-main-incdata:original-insertion-mode-2" {
						- "original insertion mode"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Let the "
					var {
						- "old insertion point"
					}
					- " have the same value as the current\n    "
					a href="#insertion-point" id="parsing-main-incdata:insertion-point" {
						- "insertion point"
					}
					- ". Let the "
					a href="#insertion-point" id="parsing-main-incdata:insertion-point-2" {
						- "insertion point"
					}
					- " be just before the "
					a href="#next-input-character" id="parsing-main-incdata:next-input-character" {
						- "next\n    input character"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Increment the parser's "
					a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level" {
						- "script nesting level"
					}
					- " by one."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#active-speculative-html-parser" id="parsing-main-incdata:active-speculative-html-parser-2" {
						- "active speculative HTML parser"
					}
					- " is null, then "
					a href="#prepare-the-script-element" id="parsing-main-incdata:prepare-the-script-element" {
						- "prepare the script\n    element"
					}
					- " "
					var {
						- "script"
					}
					- ". This might cause some script to execute, which might cause\n    "
					a href="#dom-document-write" id="parsing-main-incdata:dom-document-write" {
						- "new characters to be inserted into the tokenizer"
					}
					- ", and\n    might cause the tokenizer to output more tokens, resulting in a "
					a href="#nestedParsing" {
						- "reentrant invocation of the parser"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Decrement the parser's "
					a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-2" {
						- "script nesting level"
					}
					- " by one. If the parser's "
					a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-3" {
						- "script\n    nesting level"
					}
					- " is zero, then set the "
					a href="#parser-pause-flag" id="parsing-main-incdata:parser-pause-flag" {
						- "parser pause flag"
					}
					- " to false."
				}
				- "\n\n    "
				p {
					- "Let the "
					a href="#insertion-point" id="parsing-main-incdata:insertion-point-3" {
						- "insertion point"
					}
					- " have the value of the "
					var {
						- "old insertion\n    point"
					}
					- ". (In other words, restore the "
					a href="#insertion-point" id="parsing-main-incdata:insertion-point-4" {
						- "insertion point"
					}
					- " to its previous value.\n    This value might be the \"undefined\" value.)"
				}
				- "\n\n    "
				p id="scriptTagParserResumes" {
					- "At this stage, if the "
					a href="#pending-parsing-blocking-script" id="parsing-main-incdata:pending-parsing-blocking-script" {
						- "pending parsing-blocking\n    script"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If the "
						a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-4" {
							- "script nesting level"
						}
						- " is not zero:"
					}
					dd {
						- "\n      "
						p {
							- "Set the "
							a href="#parser-pause-flag" id="parsing-main-incdata:parser-pause-flag-2" {
								- "parser pause flag"
							}
							- " to true, and abort the processing of any nested\n      invocations of the tokenizer, yielding control back to the caller. (Tokenization will resume\n      when the caller returns to the \"outer\" tree construction stage.)"
						}
						- "\n\n      "
						p class="note" {
							- "The tree construction stage of this particular parser is "
							a href="#nestedParsing" {
								- "being called reentrantly"
							}
							- ", say from a call to "
							code id="parsing-main-incdata:dom-document-write-2" {
								a href="#dom-document-write" {
									- "document.write()"
								}
							}
							- "."
						}
						- "\n     "
					}
					dt {
						- "Otherwise:"
					}
					dd {
						- "\n      "
						p {
							- "While the "
							a href="#pending-parsing-blocking-script" id="parsing-main-incdata:pending-parsing-blocking-script-2" {
								- "pending parsing-blocking script"
							}
							- " is not null:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "the script"
									}
									- " be the "
									a href="#pending-parsing-blocking-script" id="parsing-main-incdata:pending-parsing-blocking-script-3" {
										- "pending parsing-blocking\n       script"
									}
									- "."
								}
							}
							li {
								p {
									- "Set the "
									a href="#pending-parsing-blocking-script" id="parsing-main-incdata:pending-parsing-blocking-script-4" {
										- "pending parsing-blocking script"
									}
									- " to null."
								}
							}
							li {
								p {
									a href="#start-the-speculative-html-parser" id="parsing-main-incdata:start-the-speculative-html-parser" {
										- "Start the speculative HTML parser"
									}
									- " for this instance of the HTML\n       parser."
								}
							}
							li {
								p {
									- "Block the "
									a href="#tokenization" id="parsing-main-incdata:tokenization" {
										- "tokenizer"
									}
									- " for this instance of the\n       "
									a href="#html-parser" id="parsing-main-incdata:html-parser" {
										- "HTML parser"
									}
									- ", such that the "
									a href="#event-loop" id="parsing-main-incdata:event-loop" {
										- "event loop"
									}
									- " will not run "
									a href="#concept-task" id="parsing-main-incdata:concept-task" {
										- "tasks"
									}
									- " that invoke the "
									a href="#tokenization" id="parsing-main-incdata:tokenization-2" {
										- "tokenizer"
									}
									- "."
								}
							}
							li {
								p {
									- "If the parser's "
									code id="parsing-main-incdata:document" {
										a href="#document" {
											- "Document"
										}
									}
									- " "
									a href="#has-a-style-sheet-that-is-blocking-scripts" id="parsing-main-incdata:has-a-style-sheet-that-is-blocking-scripts" {
										- "has a style sheet that is blocking\n       scripts"
									}
									- " or "
									var {
										- "the script"
									}
									- "'s "
									a href="#ready-to-be-parser-executed" id="parsing-main-incdata:ready-to-be-parser-executed" {
										- "ready to be parser-executed"
									}
									- " is false:\n       "
									a href="#spin-the-event-loop" id="parsing-main-incdata:spin-the-event-loop" {
										- "spin the event loop"
									}
									- " until the parser's "
									code id="parsing-main-incdata:document-2" {
										a href="#document" {
											- "Document"
										}
									}
									- " "
									a href="#has-no-style-sheet-that-is-blocking-scripts" id="parsing-main-incdata:has-no-style-sheet-that-is-blocking-scripts" {
										- "has no style\n       sheet that is blocking scripts"
									}
									- " and "
									var {
										- "the script"
									}
									- "'s "
									a href="#ready-to-be-parser-executed" id="parsing-main-incdata:ready-to-be-parser-executed-2" {
										- "ready to be\n       parser-executed"
									}
									- " becomes true."
								}
							}
							li {
								- "\n        "
								p {
									- "If this "
									a href="#abort-a-parser" id="parsing-main-incdata:abort-a-parser" {
										- "parser has been aborted"
									}
									- " in the meantime,\n        return."
								}
								- "\n\n        "
								p class="note" {
									- "This could happen if, e.g., while the "
									a href="#spin-the-event-loop" id="parsing-main-incdata:spin-the-event-loop-2" {
										- "spin the event loop"
									}
									- "\n        algorithm is running, the "
									code id="parsing-main-incdata:document-3" {
										a href="#document" {
											- "Document"
										}
									}
									- " gets "
									a href="#destroy-a-document" id="parsing-main-incdata:destroy-a-document" {
										- "destroyed"
									}
									- ", or the "
									code id="parsing-main-incdata:dom-document-open" {
										a href="#dom-document-open" {
											- "document.open()"
										}
									}
									- "\n        method gets invoked on the "
									code id="parsing-main-incdata:document-4" {
										a href="#document" {
											- "Document"
										}
									}
									- "."
								}
								- "\n       "
							}
							li {
								p {
									a href="#stop-the-speculative-html-parser" id="parsing-main-incdata:stop-the-speculative-html-parser" {
										- "Stop the speculative HTML parser"
									}
									- " for this instance of the HTML\n       parser."
								}
							}
							li {
								p {
									- "Unblock the "
									a href="#tokenization" id="parsing-main-incdata:tokenization-3" {
										- "tokenizer"
									}
									- " for this instance of the\n       "
									a href="#html-parser" id="parsing-main-incdata:html-parser-2" {
										- "HTML parser"
									}
									- ", such that "
									a href="#concept-task" id="parsing-main-incdata:concept-task-2" {
										- "tasks"
									}
									- " that invoke the\n       "
									a href="#tokenization" id="parsing-main-incdata:tokenization-4" {
										- "tokenizer"
									}
									- " can again be run."
								}
							}
							li {
								p {
									- "Let the "
									a href="#insertion-point" id="parsing-main-incdata:insertion-point-5" {
										- "insertion point"
									}
									- " be just before the "
									a href="#next-input-character" id="parsing-main-incdata:next-input-character-2" {
										- "next input\n       character"
									}
									- "."
								}
							}
							li {
								p {
									- "Increment the parser's "
									a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-5" {
										- "script nesting level"
									}
									- " by one (it should be zero\n       before this step, so this sets it to one)."
								}
							}
							li {
								p {
									a href="#execute-the-script-element" id="parsing-main-incdata:execute-the-script-element" {
										- "Execute the script element"
									}
									- " "
									var {
										- "the script"
									}
									- "."
								}
							}
							li {
								p {
									- "Decrement the parser's "
									a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-6" {
										- "script nesting level"
									}
									- " by one. If the parser's\n       "
									a href="#script-nesting-level" id="parsing-main-incdata:script-nesting-level-7" {
										- "script nesting level"
									}
									- " is zero (which it always should be at this point), then set\n       the "
									a href="#parser-pause-flag" id="parsing-main-incdata:parser-pause-flag-3" {
										- "parser pause flag"
									}
									- " to false."
								}
								- "\n\n       "
							}
							li {
								p {
									- "Let the "
									a href="#insertion-point" id="parsing-main-incdata:insertion-point-6" {
										- "insertion point"
									}
									- " be undefined again."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			dt {
				- "Any other end tag"
			}
			dd {
				- "\n    "
				p {
					- "Pop the "
					a href="#current-node" id="parsing-main-incdata:current-node-5" {
						- "current node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-incdata:stack-of-open-elements-3" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-incdata:insertion-mode-4" {
						- "insertion mode"
					}
					- " to the "
					a href="#original-insertion-mode" id="parsing-main-incdata:original-insertion-mode-3" {
						- "original insertion mode"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="parsing-main-intable" {
			span class="secno" {
				- "13.2.6.4.9"
			}
			- " The \""
			dfn {
				- "in table"
			}
			- "\" insertion mode"
			a href="#parsing-main-intable" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-intable" id="parsing-main-intable:parsing-main-intable" {
				- "in\n  table"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-intable:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token, if the "
				a href="#current-node" id="parsing-main-intable:current-node" {
					- "current node"
				}
				- " is "
				code id="parsing-main-intable:the-table-element" {
					a href="#the-table-element" {
						- "table"
					}
				}
				- ", "
				code id="parsing-main-intable:the-tbody-element" {
					a href="#the-tbody-element" {
						- "tbody"
					}
				}
				- ", "
				code id="parsing-main-intable:the-template-element" {
					a href="#the-template-element" {
						- "template"
					}
				}
				- ", "
				code id="parsing-main-intable:the-tfoot-element" {
					a href="#the-tfoot-element" {
						- "tfoot"
					}
				}
				- ", "
				code id="parsing-main-intable:the-thead-element" {
					a href="#the-thead-element" {
						- "thead"
					}
				}
				- ", or "
				code id="parsing-main-intable:the-tr-element" {
					a href="#the-tr-element" {
						- "tr"
					}
				}
				- " element"
			}
			dd {
				- "\n     "
				p {
					- "Let the "
					dfn id="concept-pending-table-char-tokens" {
						var {
							- "pending table character\n     tokens"
						}
					}
					- " be an empty list of tokens."
				}
				- "\n\n     "
				p {
					- "Let the "
					a href="#original-insertion-mode" id="parsing-main-intable:original-insertion-mode" {
						- "original insertion mode"
					}
					- " be the current "
					a href="#insertion-mode" id="parsing-main-intable:insertion-mode-2" {
						- "insertion mode"
					}
					- "."
				}
				- "\n\n     "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intable:insertion-mode-3" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intabletext" id="parsing-main-intable:parsing-main-intabletext" {
						- "in\n     table text"
					}
					- "\" and reprocess the token."
				}
				- "\n   "
			}
			dt {
				- "A comment token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-comment" id="parsing-main-intable:insert-a-comment" {
						- "Insert a comment"
