						- " "
						a href="#dom-dialog-showmodal" id="the-dialog-element:dom-dialog-showmodal" {
							c- g="" {
								- "showModal"
							}
						}
						- "();\n  ["
						a href="#cereactions" id="the-dialog-element:cereactions-5" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "undefined"
						}
						- " "
						a href="#dom-dialog-close" id="the-dialog-element:dom-dialog-close" {
							c- g="" {
								- "close"
							}
						}
						- "("
						c- b="" {
							- "optional"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						c- g="" {
							- "returnValue"
						}
						- ");\n  ["
						a href="#cereactions" id="the-dialog-element:cereactions-6" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "undefined"
						}
						- " "
						a href="#dom-dialog-requestclose" id="the-dialog-element:dom-dialog-requestclose" {
							c- g="" {
								- "requestClose"
							}
						}
						- "("
						c- b="" {
							- "optional"
						}
						- " "
