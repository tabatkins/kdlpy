				- "\n\n    "
				p {
					- "If the image is "
					a href="#img-available" id="the-img-element:img-available-2" {
						- "available"
					}
					- " and the user agent is configured\n    to display that image, then the element "
					a href="#represents" id="the-img-element:represents-3" {
						- "represents"
					}
					- " the element's image data."
				}
				- "\n\n    "
				p {
					- "Otherwise, the element "
					a href="#represents" id="the-img-element:represents-4" {
						- "represents"
					}
					- " the text given by the "
					code id="the-img-element:attr-img-alt-8" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute. User agents may provide the user with a notification\n    that an image is present but has been omitted from the rendering."
				}
				- "\n   "
			}
			dt {
				- "If the "
				code id="the-img-element:attr-img-src-7" {
					a href="#attr-img-src" {
						- "src"
					}
				}
				- " attribute is set and the "
				code id="the-img-element:attr-img-alt-9" {
					a href="#attr-img-alt" {
						- "alt"
					}
				}
				- " attribute is not"
			}
			dd {
				- "\n    "
				p {
					- "The image might be a key part of the content, and there is no textual equivalent of the image\n    available."
				}
				- "\n\n    "
				p class="note" {
					- "In a conforming document, the absence of the "
					code id="the-img-element:attr-img-alt-10" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute indicates that the image is a key part of the content\n    but that a textual replacement for the image was not available when the image was generated."
				}
				- "\n\n    "
				p {
					- "If the image is "
					a href="#img-available" id="the-img-element:img-available-3" {
						- "available"
					}
					- " and the user agent is configured\n    to display that image, then the element "
					a href="#represents" id="the-img-element:represents-5" {
						- "represents"
					}
					- " the element's image data."
				}
				- "\n\n    "
				p {
					- "If the image has a "
					code id="the-img-element:attr-img-src-8" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- " attribute whose value is\n    the empty string, then the element "
					a href="#represents" id="the-img-element:represents-6" {
						- "represents"
					}
					- " nothing."
				}
				- "\n\n    "
				p {
					- "Otherwise, the user agent should display some sort of indicator that there is an image that\n    is not being rendered, and may, if requested by the user, or if so configured, or when required\n    to provide contextual information in response to navigation, provide caption information for the\n    image, derived as follows:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the image has a "
							code id="the-img-element:attr-title" {
								a href="#attr-title" {
									- "title"
								}
							}
							- " attribute whose value is not\n     the empty string, then return the value of that attribute."
						}
					}
					li {
						p {
							- "If the image is a descendant of a "
							code id="the-img-element:the-figure-element" {
								a href="#the-figure-element" {
									- "figure"
								}
							}
							- " element that has a child\n     "
							code id="the-img-element:the-figcaption-element" {
								a href="#the-figcaption-element" {
									- "figcaption"
								}
							}
							- " element, and, ignoring the "
							code id="the-img-element:the-figcaption-element-2" {
								a href="#the-figcaption-element" {
									- "figcaption"
								}
							}
							- " element and its\n     descendants, the "
							code id="the-img-element:the-figure-element-2" {
								a href="#the-figure-element" {
									- "figure"
								}
							}
							- " element has no "
							a href="#flow-content-2" id="the-img-element:flow-content-2-2" {
								- "flow content"
							}
							- " descendants other\n     than "
							a href="#inter-element-whitespace" id="the-img-element:inter-element-whitespace" {
								- "inter-element whitespace"
							}
							- " and the "
							code id="the-img-element:the-img-element-12" {
								a href="#the-img-element" {
									- "img"
								}
							}
							- " element, then return the\n     contents of the first such "
							code id="the-img-element:the-figcaption-element-3" {
								a href="#the-figcaption-element" {
									- "figcaption"
								}
							}
							- " element."
						}
					}
					li {
						p {
							- "Return nothing. (There is no caption information.)"
						}
					}
				}
				- "\n   "
			}
			dt {
				- "If the "
				code id="the-img-element:attr-img-src-9" {
					a href="#attr-img-src" {
						- "src"
					}
				}
				- " attribute is not set and either the "
				code id="the-img-element:attr-img-alt-11" {
					a href="#attr-img-alt" {
						- "alt"
					}
				}
				- " attribute is set to the empty string or the "
				code id="the-img-element:attr-img-alt-12" {
					a href="#attr-img-alt" {
						- "alt"
					}
				}
				- " attribute is not set at all"
			}
			dd {
				- "\n    "
				p {
					- "The element "
					a href="#represents" id="the-img-element:represents-7" {
						- "represents"
