				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If "
							a id="structuredserializeinternal:issharedarraybuffer" href="https://tc39.es/ecma262/#sec-issharedarraybuffer" data-x-internal="issharedarraybuffer" {
								- "IsSharedArrayBuffer"
							}
							- "("
							var {
								- "value"
							}
							- ") is true, then:\n\n      "
						}
						ol {
							li {
								- "\n        "
								p {
									- "If the "
									a href="#current-settings-object" id="structuredserializeinternal:current-settings-object" {
										- "current settings object"
