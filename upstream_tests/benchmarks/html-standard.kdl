			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-9" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrackList" id="dom-audiotracklist-gettrackbyid" data-dfn-type="method" {
				code {
					- "getTrackById("
					var {
						- "id"
					}
					- ")"
				}
			}
			- " and\n  "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-9" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrackList" id="dom-videotracklist-gettrackbyid" data-dfn-type="method" {
				code {
					- "getTrackById("
					var {
						- "id"
					}
					- ")"
				}
			}
			- " methods must\n  return the first "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-7" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " or "
			code id="audiotracklist-and-videotracklist-objects:videotrack-7" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " object (respectively) in the\n  "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-10" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " or "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-10" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object (respectively) whose identifier\n  is equal to the value of the "
			var {
				- "id"
			}
			- " argument (in the natural order of the list, as defined\n  above). When no tracks match the given argument, the methods must return null."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-8" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotrack-8" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " objects represent specific tracks of a\n  "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-5" {
				- "media resource"
			}
			- ". Each track can have an identifier, category, label, and language.\n  These aspects of a track are permanent for the lifetime of the track; even if a track is removed\n  from a "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-6" {
				- "media resource"
			}
			- "'s "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-11" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " or "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-11" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- "\n  objects, those aspects do not change."
		}
		- "\n\n  "
		p {
			- "In addition, "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-9" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " objects can each be enabled or disabled; this is the audio\n  track's "
			i {
				- "enabled state"
			}
			- ". When an "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-10" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " is created, its "
			i {
				- "enabled state"
			}
			- "\n  must be set to false (disabled). The "
			a href="#concept-media-load-resource" id="audiotracklist-and-videotracklist-objects:concept-media-load-resource" {
				- "resource fetch\n  algorithm"
			}
			- " can override this."
		}
		- "\n\n  "
		p {
			- "Similarly, a single "
			code id="audiotracklist-and-videotracklist-objects:videotrack-9" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " object per "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-12" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object can\n  be selected, this is the video track's "
			i {
				- "selection state"
			}
			- ". When a "
			code id="audiotracklist-and-videotracklist-objects:videotrack-10" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " is\n  created, its "
			i {
				- "selection state"
			}
			- " must be set to false (not selected). The "
			a href="#concept-media-load-resource" id="audiotracklist-and-videotracklist-objects:concept-media-load-resource-2" {
				- "resource fetch algorithm"
			}
			- " can override this."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-11" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrack" id="dom-audiotrack-id" data-dfn-type="attribute" {
				code {
					- "id"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotrack-11" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrack" id="dom-videotrack-id" data-dfn-type="attribute" {
				code {
					- "id"
				}
			}
			- " attributes must return the\n  identifier of the track, if it has one, or the empty string otherwise. If the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-7" {
				- "media\n  resource"
			}
			- " is in a format that supports "
			a id="audiotracklist-and-videotracklist-objects:media-fragment-syntax-2" href="https://www.w3.org/TR/media-frags/#media-fragment-syntax" data-x-internal="media-fragment-syntax" {
				- "media fragment syntax"
			}
			- ", the identifier\n  returned for a particular track must be the same identifier that would enable the track if used as\n  the name of a track in the track dimension of such a "
			a href="https://url.spec.whatwg.org/#concept-url-fragment" id="audiotracklist-and-videotracklist-objects:concept-url-fragment-2" data-x-internal="concept-url-fragment" {
				- "fragment"
			}
			- ". "
			a href="#refsINBAND" {
				- "[INBAND]"
			}
		}
		- "\n\n  "
		p class="example" {
			- "For example, in Ogg files, this would be the Name header field of the track.\n  "
			a href="#refsOGGSKELETONHEADERS" {
				- "[OGGSKELETONHEADERS]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-12" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrack" id="dom-audiotrack-kind" data-dfn-type="attribute" {
				code {
					- "kind"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotrack-12" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrack" id="dom-videotrack-kind" data-dfn-type="attribute" {
				code {
					- "kind"
				}
			}
			- " attributes must return the\n  category of the track, if it has one, or the empty string otherwise."
		}
		- "\n\n  "
		p {
			- "The category of a track is the string given in the first column of the table below that is the\n  most appropriate for the track based on the definitions in the table's second and third columns,\n  as determined by the metadata included in the track in the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-8" {
				- "media resource"
			}
			- ". The cell\n  in the third column of a row says what the category given in the cell in the first column of that\n  row applies to; a category is only appropriate for an audio track if it applies to audio tracks,\n  and a category is only appropriate for video tracks if it applies to video tracks. Categories must\n  only be returned for "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-13" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " objects if they are appropriate for audio, and must\n  only be returned for "
			code id="audiotracklist-and-videotracklist-objects:videotrack-13" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " objects if they are appropriate for video."
		}
		- "\n\n  "
		p {
			- "For Ogg files, the Role header field of the track gives the relevant metadata. For DASH media\n  resources, the "
			code {
				- "Role"
			}
			- " element conveys the information. For WebM, only the\n  "
			code {
				- "FlagDefault"
			}
			- " element currently maps to a value. "
			cite {
				- "Sourcing In-band\n  Media Resource Tracks from Media Containers into HTML"
			}
			- " has further details.\n  "
			a href="#refsOGGSKELETONHEADERS" {
				- "[OGGSKELETONHEADERS]"
			}
			- " "
			a href="#refsDASH" {
				- "[DASH]"
			}
			- " "
			a href="#refsWEBMCG" {
				- "[WEBMCG]"
			}
			- " "
			a href="#refsINBAND" {
				- "[INBAND]"
			}
		}
		- "\n\n  \n\n  "
		table id="dom-TrackList-getKind-categories" {
			caption {
				- "Return values for "
				code id="audiotracklist-and-videotracklist-objects:audiotrack-14" {
					a href="#audiotrack" {
						- "AudioTrack"
					}
				}
				- "'s "
				code id="audiotracklist-and-videotracklist-objects:dom-audiotrack-kind-2" {
					a href="#dom-audiotrack-kind" {
						- "kind"
					}
				}
				- " and "
				code id="audiotracklist-and-videotracklist-objects:videotrack-14" {
					a href="#videotrack" {
						- "VideoTrack"
					}
				}
				- "'s "
				code id="audiotracklist-and-videotracklist-objects:dom-videotrack-kind-2" {
					a href="#dom-videotrack-kind" {
						- "kind"
					}
				}
			}
			thead {
				tr {
					th {
						- "Category\n     "
					}
					th {
						- "Definition\n     "
					}
					th {
						- "Applies to..."
					}
					th {
						- "Examples\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "\""
						dfn id="value-track-kind-alternate" {
							code {
								- "alternative"
							}
						}
						- "\"\n     "
					}
					td {
						- "A possible alternative to the main track, e.g. a different take of a song (audio), or a different angle (video).\n     "
					}
					td {
						- "Audio and video.\n     "
					}
					td {
						- "Ogg: \"audio/alternate\" or \"video/alternate\"; DASH: \"alternate\" without \"main\" and \"commentary\" roles, and, for audio, without the \"dub\" role (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-caption" {
							code {
								- "captions"
							}
						}
						- "\"\n     "
					}
					td {
						- "A version of the main video track with captions burnt in. (For legacy content; new content would use text tracks.)\n     "
					}
					td {
						- "Video only.\n     "
					}
					td {
						- "DASH: \"caption\" and \"main\" roles together (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-descriptions" {
							code {
								- "descriptions"
							}
						}
						- "\"\n     "
					}
					td {
						- "An audio description of a video track.\n     "
					}
					td {
						- "Audio only.\n     "
					}
					td {
						- "Ogg: \"audio/audiodesc\".\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-main" {
							code {
								- "main"
							}
						}
						- "\"\n     "
					}
					td {
						- "The primary audio or video track.\n     "
					}
					td {
						- "Audio and video.\n     "
					}
					td {
						- "Ogg: \"audio/main\" or \"video/main\"; WebM: the \"FlagDefault\" element is set; DASH: \"main\" role without \"caption\", \"subtitle\", and \"dub\" roles (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-main-desc" {
							code {
								- "main-desc"
							}
						}
						- "\"\n     "
					}
					td {
						- "The primary audio track, mixed with audio descriptions.\n     "
					}
					td {
						- "Audio only.\n     "
					}
					td {
						- "AC3 audio in MPEG-2 TS: bsmod=2 and full_svc=1. \n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-sign" {
							code {
								- "sign"
							}
						}
						- "\"\n     "
					}
					td {
						- "A sign-language interpretation of an audio track.\n     "
					}
					td {
						- "Video only.\n     "
					}
					td {
						- "Ogg: \"video/sign\".\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-subtitle" {
							code {
								- "subtitles"
							}
						}
						- "\"\n     "
					}
					td {
						- "A version of the main video track with subtitles burnt in. (For legacy content; new content would use text tracks.)\n     "
					}
					td {
						- "Video only.\n     "
					}
					td {
						- "DASH: \"subtitle\" and \"main\" roles together (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-translation" {
							code {
								- "translation"
							}
						}
						- "\"\n     "
					}
					td {
						- "A translated version of the main audio track.\n     "
					}
					td {
						- "Audio only.\n     "
					}
					td {
						- "Ogg: \"audio/dub\". DASH: \"dub\" and \"main\" roles together (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-commentary" {
							code {
								- "commentary"
							}
						}
						- "\"\n     "
					}
					td {
						- "Commentary on the primary audio or video track, e.g. a director's commentary.\n     "
					}
					td {
						- "Audio and video.\n     "
					}
					td {
						- "DASH: \"commentary\" role without \"main\" role (other roles ignored).\n\n    "
					}
				}
				tr {
					td {
						- "\""
						dfn id="value-track-kind-none" {
							code
						}
						- "\" (empty string)\n     "
					}
					td {
						- "No explicit kind, or the kind given by the track's metadata is not recognized by the user agent.\n     "
					}
					td {
						- "Audio and video.\n     "
					}
					td {
						- "\n\n  "
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-15" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrack" id="dom-audiotrack-label" data-dfn-type="attribute" {
				code {
					- "label"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotrack-15" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrack" id="dom-videotrack-label" data-dfn-type="attribute" {
				code {
					- "label"
				}
			}
			- " attributes must return the\n  label of the track, if it has one, or the empty string otherwise. "
			a href="#refsINBAND" {
				- "[INBAND]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-16" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrack" id="dom-audiotrack-language" data-dfn-type="attribute" {
				code {
					- "language"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotrack-16" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrack" id="dom-videotrack-language" data-dfn-type="attribute" {
				code {
					- "language"
				}
			}
			- " attributes must\n  return the BCP 47 language tag of the language of the track, if it has one, or the empty string\n  otherwise. If the user agent is not able to express that language as a BCP 47 language tag (for\n  example because the language information in the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-9" {
				- "media resource"
			}
			- "'s format is a\n  free-form string without a defined interpretation), then the method must return the empty string,\n  as if the track had no language. "
			a href="#refsINBAND" {
				- "[INBAND]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-17" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrack" id="dom-audiotrack-enabled" data-dfn-type="attribute" {
				code {
					- "enabled"
				}
			}
			- " attribute, on getting, must return true if\n  the track is currently enabled, and false otherwise. On setting, it must enable the track if the\n  new value is true, and disable it otherwise. (If the track is no longer in an\n  "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-12" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " object, then the track being enabled or disabled has no effect beyond\n  changing the value of the attribute on the "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-18" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " object.)"
		}
		- "\n\n  "
		p id="toggle-audio-track" {
			- "Whenever an audio track in an "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-13" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " that was\n  disabled is enabled, and whenever one that was enabled is disabled, the user agent must\n  "
			a href="#queue-a-media-element-task" id="audiotracklist-and-videotracklist-objects:queue-a-media-element-task" {
				- "queue a media element task"
			}
			- " given the "
			a href="#media-element" id="audiotracklist-and-videotracklist-objects:media-element" {
				- "media element"
			}
			- " to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="audiotracklist-and-videotracklist-objects:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named "
			code id="audiotracklist-and-videotracklist-objects:event-media-change" {
				a href="#event-media-change" {
					- "change"
				}
			}
			- " at the "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-14" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " object."
		}
		- "\n\n  "
		p {
			- "An audio track that has no data for a particular position on the "
			a href="#media-timeline" id="audiotracklist-and-videotracklist-objects:media-timeline" {
				- "media timeline"
			}
			- ",\n  or that does not exist at that position, must be interpreted as being silent at that point on the\n  timeline."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-13" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrackList" id="dom-videotracklist-selectedindex" data-dfn-type="attribute" {
				code {
					- "selectedIndex"
				}
			}
			- " attribute must return the\n  index of the currently selected track, if any. If the "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-14" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object does not\n  currently represent any tracks, or if none of the tracks are selected, it must instead return\n  −1."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:videotrack-17" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " "
			dfn data-dfn-for="VideoTrack" id="dom-videotrack-selected" data-dfn-type="attribute" {
				code {
					- "selected"
				}
			}
			- " attribute, on getting, must return true if\n  the track is currently selected, and false otherwise.  On setting, it must select the track if the\n  new value is true, and unselect it otherwise. If the track is in a "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-15" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- ",\n  then all the other "
			code id="audiotracklist-and-videotracklist-objects:videotrack-18" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " objects in that list must be unselected. (If the track\n  is no longer in a "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-16" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object, then the track being selected or unselected\n  has no effect beyond changing the value of the attribute on the "
			code id="audiotracklist-and-videotracklist-objects:videotrack-19" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- "\n  object.)"
		}
		- "\n\n  "
		p id="toggle-video-track" {
			- "Whenever a track in a "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-17" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " that was previously\n  not selected is selected, and whenever the selected track in a "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-18" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " is\n  unselected without a new track being selected in its stead, the user agent must "
			a href="#queue-a-media-element-task" id="audiotracklist-and-videotracklist-objects:queue-a-media-element-task-2" {
				- "queue a\n  media element task"
			}
			- " given the "
			a href="#media-element" id="audiotracklist-and-videotracklist-objects:media-element-2" {
				- "media element"
			}
			- " to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="audiotracklist-and-videotracklist-objects:concept-event-fire-2" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named "
			code id="audiotracklist-and-videotracklist-objects:event-media-change-2" {
				a href="#event-media-change" {
					- "change"
				}
			}
			- " at the "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-19" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object. This "
			a href="#concept-task" id="audiotracklist-and-videotracklist-objects:concept-task" {
				- "task"
			}
			- " must be "
			a href="#queue-an-element-task" id="audiotracklist-and-videotracklist-objects:queue-an-element-task" {
				- "queued"
			}
			- "\n  before the "
			a href="#concept-task" id="audiotracklist-and-videotracklist-objects:concept-task-2" {
				- "task"
			}
			- " that fires the "
			code id="audiotracklist-and-videotracklist-objects:event-media-resize" {
				a href="#event-media-resize" {
					- "resize"
				}
			}
			- " event, if any."
		}
		- "\n\n  "
		p {
			- "A video track that has no data for a particular position on the "
			a href="#media-timeline" id="audiotracklist-and-videotracklist-objects:media-timeline-2" {
				- "media timeline"
			}
			- "\n  must be interpreted as being "
			a id="audiotracklist-and-videotracklist-objects:transparent-black" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
				- "transparent black"
			}
			- " at that point on the timeline, with\n  the same dimensions as the last frame before that position, or, if the position is before all the\n  data for that track, the same dimensions as the first frame for that track. A track that does not\n  exist at all at the current position must be treated as if it existed but had no data."
		}
		- "\n\n  "
		p class="example" {
			- "For instance, if a video has a track that is only introduced after one hour of\n  playback, and the user selects that track then goes back to the start, then the user agent will\n  act as if that track started at the start of the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-10" {
				- "media resource"
			}
			- " but was simply\n  transparent until one hour in."
		}
