				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					code id="the-select-element-2:attr-select-size" {
						a href="#attr-select-size" {
							- "size"
						}
					}
					- " attribute is absent or it has no valid\n    value, return the height necessary to contain four rows."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Otherwise, return the height necessary to contain as many rows for items as given by the\n    element's "
					a href="#concept-select-size" id="the-select-element-2:concept-select-size-2" {
						- "display size"
					}
					- "."
