				p {
					- "Run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Initialize "
							var {
								- "node"
							}
							- " to be the "
							a href="#current-node" id="parsing-main-inforeign:current-node-6" {
								- "current node"
							}
							- " (the bottommost\n     node of the stack)."
						}
					}
					li {
