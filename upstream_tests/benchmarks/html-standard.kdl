			- " attribute."
		}
		- "\n\n  "
		p {
			- "To send messages back, you again use "
			code id="communicating-with-a-dedicated-worker:dom-dedicatedworkerglobalscope-postmessage" {
				a href="#dom-dedicatedworkerglobalscope-postmessage" {
					- "postMessage()"
				}
			}
			- ". It supports the\n  structured data in the same manner."
		}
