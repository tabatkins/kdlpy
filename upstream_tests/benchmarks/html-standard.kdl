				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of:  \"b\", \"big\", \"blockquote\", \"body\", \"br\", \"center\", \"code\", \"dd\", \"div\", \"dl\", \"dt\", \"em\", \"embed\", \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\", \"head\", \"hr\", \"i\", \"img\",\n   \"li\", \"listing\",\n   \"menu\", \"meta\", \"nobr\", \"ol\", \"p\", \"pre\", \"ruby\", \"s\",  \"small\", \"span\", \"strong\", \"strike\",  \"sub\",\n   \"sup\", \"table\", \"tt\", \"u\", \"ul\", \"var\""
			}
			dt {
				- "A start tag whose tag name is \"font\", if the token has any attributes named \"color\", \"face\",\n   or \"size\""
			}
			dt {
				- "An end tag whose tag name is \"br\", \"p\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inforeign:parse-errors-3" {
						- "Parse error"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "While the "
					a href="#current-node" id="parsing-main-inforeign:current-node" {
