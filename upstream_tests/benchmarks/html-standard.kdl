			}
			- " is\n  "
			a href="#translate-enabled" id="the-translate-attribute:translate-enabled-5" {
				- "translate-enabled"
			}
			- ", and false otherwise. On setting, it must set the content\n  attribute's value to \""
			code {
				- "yes"
			}
			- "\" if the new value is true, and set the content\n  attribute's value to \""
			code {
				- "no"
			}
			- "\" otherwise."
		}
		- "\n\n  \n\n  "
