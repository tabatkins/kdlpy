					a href="#cannot-show-simple-dialogs" id="simple-dialogs:cannot-show-simple-dialogs-3" {
						- "cannot show simple dialogs"
					}
					- " for "
					a id="simple-dialogs:this-7" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- ", then return\n   null."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "message"
					}
					- " to the result of "
