			code id="client-identification:dom-navigator-oscpu" {
				a href="#dom-navigator-oscpu" {
					- "oscpu"
				}
			}
			- " that are known to be compatible with existing web\n  content."
		}
		- "\n\n  \n\n  "
		p {
			- "Client detection should always be limited to detecting known current versions; future versions\n  and unknown versions should always be assumed to be fully compliant."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
