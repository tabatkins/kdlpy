					- "process.cgi?where.x=127&where.y=40"
				}
				- "\"."
			}
			- "\n\n   "
			p {
				- "(In this example, it's assumed that for users who don't see the map, and who instead just see\n   a button labeled \"Show location list\", clicking the button will cause the server to show a list\n   of locations to pick from instead of the map.)"
			}
			- "\n\n  "
		}
		- "\n\n\n\n  "
		h6 id="reset-button-state-(type=reset)" {
			span class="secno" {
				- "4.10.5.1.20"
			}
			- " "
			dfn data-dfn-for="input" data-dfn-type="element-state" {
