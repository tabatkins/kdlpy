		}
		- "\n\n  "
		p {
			- "When an "
			code id="a-link-or-button-containing-nothing-but-the-image:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " element that creates a "
			a href="#hyperlink" id="a-link-or-button-containing-nothing-but-the-image:hyperlink" {
