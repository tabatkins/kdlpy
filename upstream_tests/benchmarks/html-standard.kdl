				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="concept-try-upgrade" data-export="" {
				- "try to upgrade an element"
			}
			- ", given as input an\n  element "
			var {
				- "element"
			}
			- ", run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "definition"
					}
					- " be the result of "
					a href="#look-up-a-custom-element-definition" id="upgrades:look-up-a-custom-element-definition-2" {
						- "looking up a custom element definition"
					}
					- " given "
					var {
						- "element"
					}
					- "'s "
					a id="upgrades:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n   document"
					}
					- ", "
					var {
						- "element"
					}
					- "'s namespace, "
					var {
						- "element"
					}
					- "'s local name, and\n   "
					var {
						- "element"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-element-is-value" id="upgrades:concept-element-is-value" data-x-internal="concept-element-is-value" {
						code {
							- "is"
						}
						- "\n   value"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "definition"
					}
					- " is not null, then "
					a href="#enqueue-a-custom-element-upgrade-reaction" id="upgrades:enqueue-a-custom-element-upgrade-reaction" {
						- "enqueue a custom element upgrade\n   reaction"
					}
					- " given "
					var {
						- "element"
					}
					- " and "
					var {
						- "definition"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  "
		h4 id="custom-element-reactions" {
			span class="secno" {
				- "4.13.6"
			}
			- " Custom element reactions"
			a href="#custom-element-reactions" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#custom-element" id="custom-element-reactions:custom-element" {
				- "custom element"
			}
			- " possesses the ability to respond to certain occurrences by\n  running author code:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "When "
					a href="#upgrades" id="custom-element-reactions:upgrades" {
						- "upgraded"
					}
					- ", its "
					a href="#custom-element-constructor" id="custom-element-reactions:custom-element-constructor" {
						- "constructor"
					}
					- " is run, with no arguments."
				}
			}
			li {
				p {
					- "When it "
					a href="#becomes-connected" id="custom-element-reactions:becomes-connected" {
						- "becomes connected"
					}
					- ", its "
					code {
						- "connectedCallback"
					}
					- " is\n   called, with no arguments."
				}
			}
			li {
				p {
					- "When it "
					a href="#becomes-disconnected" id="custom-element-reactions:becomes-disconnected" {
						- "becomes disconnected"
					}
					- ", its "
					code {
						- "disconnectedCallback"
					}
					- "\n   is called, with no arguments."
				}
			}
			li {
				p {
					- "When it is "
					a href="https://dom.spec.whatwg.org/#concept-node-adopt" id="custom-element-reactions:concept-node-adopt" data-x-internal="concept-node-adopt" {
						- "adopted"
					}
					- " into a new document, its "
					code {
						- "adoptedCallback"
					}
					- " is called, given the old document and new document as\n   arguments."
				}
			}
			li {
				p {
					- "When any of its attributes are "
					a href="https://dom.spec.whatwg.org/#concept-element-attributes-change" id="custom-element-reactions:concept-element-attributes-change" data-x-internal="concept-element-attributes-change" {
						- "changed"
					}
					- ", "
					a href="https://dom.spec.whatwg.org/#concept-element-attributes-append" id="custom-element-reactions:concept-element-attributes-append" data-x-internal="concept-element-attributes-append" {
						- "appended"
					}
					- ", "
					a href="https://dom.spec.whatwg.org/#concept-element-attributes-remove" id="custom-element-reactions:concept-element-attributes-remove" data-x-internal="concept-element-attributes-remove" {
						- "removed"
					}
					- ", or "
					a href="https://dom.spec.whatwg.org/#concept-element-attributes-replace" id="custom-element-reactions:concept-element-attributes-replace" data-x-internal="concept-element-attributes-replace" {
						- "replaced"
					}
					- ", its "
					code {
						- "attributeChangedCallback"
					}
					- " is called, given the attribute's local name, old value,\n   new value, and namespace as arguments. (An attribute's old or new value is considered to be null\n   when the attribute is added or removed, respectively.)"
				}
			}
			li {
				p {
					- "When the user agent "
					a href="#reset-the-form-owner" id="custom-element-reactions:reset-the-form-owner" {
						- "resets the form owner"
					}
					- " of a\n   "
					a href="#form-associated-custom-element" id="custom-element-reactions:form-associated-custom-element" {
						- "form-associated custom element"
					}
					- " and doing so changes the form owner, its "
					code {
						- "formAssociatedCallback"
					}
					- " is called, given the new form owner (or null if no owner)\n   as an argument."
				}
			}
			li {
				p {
					- "When the form owner of a "
					a href="#form-associated-custom-element" id="custom-element-reactions:form-associated-custom-element-2" {
						- "form-associated custom element"
					}
					- " is "
					a href="#concept-form-reset" id="custom-element-reactions:concept-form-reset" {
						- "reset"
					}
					- ", its "
					code {
						- "formResetCallback"
					}
					- " is\n   called."
				}
			}
			li {
				p {
					- "When the "
					a href="#concept-fe-disabled" id="custom-element-reactions:concept-fe-disabled" {
						- "disabled"
					}
					- " state of a\n   "
					a href="#form-associated-custom-element" id="custom-element-reactions:form-associated-custom-element-3" {
						- "form-associated custom element"
					}
					- " is changed, its "
					code {
						- "formDisabledCallback"
					}
					- " is called, given the new state as an\n   argument."
				}
			}
			li {
				p {
					- "When user agent updates a "
					a href="#form-associated-custom-element" id="custom-element-reactions:form-associated-custom-element-4" {
						- "form-associated custom element"
					}
					- "'s value on behalf of\n   a user or "
					a href="#restore-persisted-state" id="custom-element-reactions:restore-persisted-state" {
						- "as part of navigation"
					}
					- ", its "
					code {
						- "formStateRestoreCallback"
					}
					- " is called, given the new state and a string indicating\n   a reason, \""
					code {
						- "autocomplete"
					}
					- "\" or \""
					code {
						- "restore"
					}
					- "\", as\n   arguments."
				}
			}
		}
		- "\n\n  "
		p {
			- "We call these reactions collectively "
			dfn id="concept-custom-element-reaction" {
				- "custom\n  element reactions"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The way in which "
			a href="#concept-custom-element-reaction" id="custom-element-reactions:concept-custom-element-reaction" {
				- "custom element reactions"
			}
			- "\n  are invoked is done with special care, to avoid running author code during the middle of delicate\n  operations. Effectively, they are delayed until \"just before returning to user script\". This means\n  that for most purposes they appear to execute synchronously, but in the case of complicated\n  composite operations (like "
			a href="https://dom.spec.whatwg.org/#concept-node-clone" id="custom-element-reactions:concept-node-clone" data-x-internal="concept-node-clone" {
				- "cloning"
			}
			- ", or "
			a href="https://dom.spec.whatwg.org/#concept-range" id="custom-element-reactions:concept-range" data-x-internal="concept-range" {
				- "range"
			}
			- " manipulation), they will instead be delayed until after all\n  the relevant user agent processing steps have completed, and then run together as a batch."
		}
		- "\n\n  "
		p {
			- "Additionally, the precise ordering of these reactions is managed via a\n  somewhat-complicated stack-of-queues system, described below. The intention behind this system is\n  to guarantee that "
			a href="#concept-custom-element-reaction" id="custom-element-reactions:concept-custom-element-reaction-2" {
				- "custom element reactions"
			}
			- " always are invoked in the\n  same order as their triggering actions, at least within the local context of a single "
			a href="#custom-element" id="custom-element-reactions:custom-element-2" {
				- "custom\n  element"
			}
			- ". (Because "
			a href="#concept-custom-element-reaction" id="custom-element-reactions:concept-custom-element-reaction-3" {
				- "custom element\n  reaction"
			}
			- " code can perform its own mutations, it is not possible to give a global ordering\n  guarantee across multiple elements.)"
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			a href="#similar-origin-window-agent" id="custom-element-reactions:similar-origin-window-agent" {
				- "similar-origin window agent"
			}
			- " has a "
			dfn id="custom-element-reactions-stack" {
				- "custom element reactions stack"
			}
			- ",\n  which is initially empty. A "
			a href="#similar-origin-window-agent" id="custom-element-reactions:similar-origin-window-agent-2" {
				- "similar-origin window agent"
			}
			- "'s "
			dfn id="current-element-queue" {
				- "current element\n  queue"
			}
			- " is the "
			a href="#element-queue" id="custom-element-reactions:element-queue" {
				- "element queue"
			}
			- " at the top of its "
			a href="#custom-element-reactions-stack" id="custom-element-reactions:custom-element-reactions-stack" {
				- "custom element reactions\n  stack"
			}
			- ". Each item in the stack is an "
			dfn id="element-queue" {
				- "element queue"
			}
			- ", which is initially empty as\n  well. Each item in an "
			a href="#element-queue" id="custom-element-reactions:element-queue-2" {
				- "element queue"
			}
			- " is an element. (The elements are not necessarily\n  "
			a href="https://dom.spec.whatwg.org/#concept-element-custom" id="custom-element-reactions:concept-element-custom" data-x-internal="concept-element-custom" {
				- "custom"
			}
			- " yet, since this queue is used for "
			a href="#upgrades" id="custom-element-reactions:upgrades-2" {
				- "upgrades"
			}
			- " as well.)"
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#custom-element-reactions-stack" id="custom-element-reactions:custom-element-reactions-stack-2" {
				- "custom element reactions stack"
			}
			- " has an associated "
			dfn id="backup-element-queue" {
				- "backup element\n  queue"
			}
			- ", which is an initially-empty "
			a href="#element-queue" id="custom-element-reactions:element-queue-3" {
				- "element queue"
			}
			- ". Elements are pushed onto the\n  "
			a href="#backup-element-queue" id="custom-element-reactions:backup-element-queue" {
				- "backup element queue"
			}
			- " during operations that affect the DOM without going through an\n  API decorated with "
			code id="custom-element-reactions:cereactions" {
				a href="#cereactions" {
					- "[CEReactions]"
				}
			}
			- ", or through the parser's\n  "
			a href="#create-an-element-for-the-token" id="custom-element-reactions:create-an-element-for-the-token" {
				- "create an element for the token"
			}
			- " algorithm. An example of this is a user-initiated\n  editing operation which modifies the descendants or attributes of an "
			a id="custom-element-reactions:editable" href="https://w3c.github.io/editing/docs/execCommand/#editable" data-x-internal="editable" {
				- "editable"
			}
			- "\n  element. To prevent reentrancy when processing the "
			a href="#backup-element-queue" id="custom-element-reactions:backup-element-queue-2" {
				- "backup element queue"
			}
			- ", each\n  "
			a href="#custom-element-reactions-stack" id="custom-element-reactions:custom-element-reactions-stack-3" {
				- "custom element reactions stack"
			}
			- " also has a "
			dfn id="processing-the-backup-element-queue" {
				- "processing the backup element\n  queue"
			}
			- " flag, initially unset."
		}
		- "\n\n  "
		p {
			- "All elements have an associated "
			dfn id="custom-element-reaction-queue" {
				- "custom element reaction queue"
			}
			- ", initially empty. Each\n  item in the "
			a href="#custom-element-reaction-queue" id="custom-element-reactions:custom-element-reaction-queue" {
				- "custom element reaction queue"
			}
			- " is of one of two types:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "An "
					dfn id="upgrade-reaction" {
						- "upgrade reaction"
					}
					- ", which will "
					a href="#upgrades" id="custom-element-reactions:upgrades-3" {
						- "upgrade"
					}
					- " the custom element and contains a "
					a href="#custom-element-definition" id="custom-element-reactions:custom-element-definition" {
						- "custom\n   element definition"
					}
					- "; or"
				}
			}
			li {
				p {
					- "A "
					dfn id="callback-reaction" {
						- "callback reaction"
					}
					- ", which will call a lifecycle callback, and contains a\n   callback function as well as a list of arguments."
				}
			}
		}
		- "\n\n  "
		p {
			- "This is all summarized in the following schematic diagram:"
		}
		- "\n\n  "
		p {
			img class="darkmode-aware" src="/images/custom-element-reactions.svg" alt="A custom element reactions stack consists of a stack of element queues. Zooming in on a particular queue, we see that it contains a number of elements (in our example, <x-a>, then <x-b>, then <x-c>). Any particular element in the queue then has a custom element reaction queue. Zooming in on the custom element reaction queue, we see that it contains a variety of queued-up reactions (in our example, upgrade, then attribute changed, then another attribute changed, then connected)." style="width: 80%; max-width: 580px;"
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="enqueue-an-element-on-the-appropriate-element-queue" {
				- "enqueue an element on the appropriate element queue"
			}
			- ", given an element\n  "
			var {
				- "element"
			}
			- ", run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "reactionsStack"
					}
					- " be "
					var {
						- "element"
					}
					- "'s "
					a href="#relevant-agent" id="custom-element-reactions:relevant-agent" {
						- "relevant agent"
					}
					- "'s\n   "
					a href="#custom-element-reactions-stack" id="custom-element-reactions:custom-element-reactions-stack-4" {
						- "custom element reactions stack"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "reactionsStack"
					}
					- " is empty, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Add "
							var {
								- "element"
							}
							- " to "
							var {
								- "reactionsStack"
							}
							- "'s "
							a href="#backup-element-queue" id="custom-element-reactions:backup-element-queue-3" {
								- "backup element\n     queue"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "reactionsStack"
							}
							- "'s "
							a href="#processing-the-backup-element-queue" id="custom-element-reactions:processing-the-backup-element-queue" {
								- "processing the backup element queue"
							}
							- " flag is\n     set, then return."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "reactionsStack"
							}
							- "'s "
							a href="#processing-the-backup-element-queue" id="custom-element-reactions:processing-the-backup-element-queue-2" {
								- "processing the backup element queue"
							}
							- "\n     flag."
						}
					}
					li {
						- "\n      "
						p {
							a href="#queue-a-microtask" id="custom-element-reactions:queue-a-microtask" {
								- "Queue a microtask"
							}
							- " to perform the following steps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									a href="#invoke-custom-element-reactions" id="custom-element-reactions:invoke-custom-element-reactions" {
										- "Invoke custom element reactions"
									}
									- " in "
									var {
										- "reactionsStack"
									}
									- "'s\n       "
									a href="#backup-element-queue" id="custom-element-reactions:backup-element-queue-4" {
										- "backup element queue"
									}
									- "."
								}
							}
							li {
								p {
									- "Unset "
									var {
										- "reactionsStack"
									}
									- "'s "
									a href="#processing-the-backup-element-queue" id="custom-element-reactions:processing-the-backup-element-queue-3" {
										- "processing the backup element queue"
									}
									- "\n       flag."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Otherwise, add "
					var {
						- "element"
					}
					- " to "
					var {
						- "element"
					}
					- "'s "
					a href="#relevant-agent" id="custom-element-reactions:relevant-agent-2" {
						- "relevant agent"
					}
					- "'s\n   "
					a href="#current-element-queue" id="custom-element-reactions:current-element-queue" {
						- "current element queue"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="enqueue-a-custom-element-callback-reaction" data-export="" {
				- "enqueue a custom element callback reaction"
			}
			- ", given a "
			a href="#custom-element" id="custom-element-reactions:custom-element-3" {
				- "custom\n  element"
			}
			- " "
			var {
				- "element"
			}
			- ", a callback name "
			var {
				- "callbackName"
			}
			- ", and a list of\n  arguments "
			var {
				- "args"
			}
			- ", run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "definition"
					}
					- " be "
					var {
						- "element"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-element-custom-element-definition" id="custom-element-reactions:concept-element-custom-element-definition" data-x-internal="concept-element-custom-element-definition" {
						- "custom element definition"
					}
					- "."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "callback"
					}
					- " be the value of the entry in "
					var {
						- "definition"
					}
					- "'s "
					a href="#concept-custom-element-definition-lifecycle-callbacks" id="custom-element-reactions:concept-custom-element-definition-lifecycle-callbacks" {
						- "lifecycle callbacks"
					}
					- " with\n   key "
					var {
						- "callbackName"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "callback"
					}
					- " is null, then return."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "callbackName"
					}
					- " is \""
					code {
						- "attributeChangedCallback"
					}
					- "\", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "attributeName"
							}
							- " be the first element of "
							var {
								- "args"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "definition"
							}
							- "'s "
							a href="#concept-custom-element-definition-observed-attributes" id="custom-element-reactions:concept-custom-element-definition-observed-attributes" {
								- "observed attributes"
							}
							- " does\n     not contain "
							var {
								- "attributeName"
							}
							- ", then return."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Add a new "
					a href="#callback-reaction" id="custom-element-reactions:callback-reaction" {
						- "callback reaction"
					}
					- " to "
					var {
						- "element"
					}
					- "'s "
					a href="#custom-element-reaction-queue" id="custom-element-reactions:custom-element-reaction-queue-2" {
						- "custom element\n   reaction queue"
					}
					- ", with callback function "
					var {
						- "callback"
					}
					- " and arguments\n   "
					var {
						- "args"
					}
					- "."
				}
			}
			li {
				p {
					a href="#enqueue-an-element-on-the-appropriate-element-queue" id="custom-element-reactions:enqueue-an-element-on-the-appropriate-element-queue" {
						- "Enqueue an element on the appropriate element queue"
					}
