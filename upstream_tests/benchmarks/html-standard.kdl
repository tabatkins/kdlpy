			- "\n\n   "
			p {
				- "This gives the same result as the previous example. The first item has two properties, \"name\",\n   set to \"Amanda\", and \"band\", set to another item. That second item has two further properties,\n   \"name\", set to \"Jazz Band\", and \"size\", set to \"12\"."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "An "
			a href="#concept-item" id="the-basic-syntax:concept-item-5" {
				- "item"
			}
			- " can have multiple properties with the same name and\n  different values."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "This example describes an ice cream, with two flavors:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "div"
					}
					- " "
					c- e="" {
						- "itemscope"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "Flavors in my favorite ice cream:"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n "
