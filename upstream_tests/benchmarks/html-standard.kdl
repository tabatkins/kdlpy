				dfn data-dfn-for="WorkletOptions" id="dom-workletoptions-credentials" data-dfn-type="dict-member" {
					c- g="" {
						- "credentials"
					}
				}
				- " = \"same-origin\";\n};"
			}
		}
		- "\n\n  "
		p {
			- "Specifications that create "
			code id="worklets-worklet:worklet-2" {
				a href="#worklet" {
					- "Worklet"
				}
			}
			- " instances must specify the following for a\n  given instance:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "its "
					dfn id="worklet-global-scope-type" data-export="" {
