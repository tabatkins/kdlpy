					- "\n    "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "By placing an order via this Web site on the first day of the fourth month of the year\n    2010 Anno Domini, you agree to grant Us a non-transferable option to claim, for now and for\n    ever more, your immortal soul."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n    "
					c- p="" {
