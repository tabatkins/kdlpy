					- "\""
				}
				dfn data-dfn-for="NavigationFocusReset" id="dom-navigationfocusreset-after-transition" data-dfn-type="enum-value" {
					c- s="" {
						- "after-transition"
					}
				}
				c- s="" {
					- "\""
				}
				- ",\n  "
				c- s="" {
					- "\""
				}
				dfn data-dfn-for="NavigationFocusReset" id="dom-navigationfocusreset-manual" data-dfn-type="enum-value" {
					c- s="" {
						- "manual"
					}
				}
				c- s="" {
					- "\""
				}
				- "\n};\n\n"
				c- b="" {
					- "enum"
				}
				- " "
				dfn id="navigationscrollbehavior" data-dfn-type="enum" {
					c- g="" {
						- "NavigationScrollBehavior"
					}
				}
				- " {\n  "
				c- s="" {
					- "\""
				}
				dfn data-dfn-for="NavigationScrollBehavior" id="dom-navigationscrollbehavior-after-transition" data-dfn-type="enum-value" {
					c- s="" {
						- "after-transition"
					}
				}
				c- s="" {
					- "\""
				}
				- ",\n  "
				c- s="" {
					- "\""
				}
				dfn data-dfn-for="NavigationScrollBehavior" id="dom-navigationscrollbehavior-manual" data-dfn-type="enum-value" {
					c- s="" {
						- "manual"
					}
				}
				c- s="" {
					- "\""
				}
				- "\n};\n\n"
				c- b="" {
					- "callback"
				}
				- " "
				dfn id="navigationintercepthandler" data-dfn-type="callback" {
					c- g="" {
						- "NavigationInterceptHandler"
					}
				}
				- " = "
				a href="https://webidl.spec.whatwg.org/#idl-promise" id="the-navigateevent-interface:idl-promise" data-x-internal="idl-promise" {
					c- b="" {
