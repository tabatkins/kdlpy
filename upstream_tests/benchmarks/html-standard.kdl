				- "\n   state"
			}
			dd {
				- "\n    "
				p {
					- "Find the first character (in logical order) of the attribute's value that is of bidirectional\n    character type L, AL, or R. "
					a href="#refsBIDI" {
						- "[BIDI]"
					}
				}
				- "\n\n    "
				p {
