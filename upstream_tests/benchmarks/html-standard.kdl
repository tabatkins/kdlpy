							- "Chrome"
						}
						span {
							- "2+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "10.6+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
