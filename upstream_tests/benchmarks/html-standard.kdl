		- "\n\n  \n\n  "
		p {
			- "An "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-3" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " object represents a dynamic list of zero or more audio tracks,\n  of which zero or more can be enabled at a time. Each audio track is represented by an\n  "
			code id="audiotracklist-and-videotracklist-objects:audiotrack-5" {
				a href="#audiotrack" {
					- "AudioTrack"
				}
			}
			- " object."
		}
		- "\n\n  "
		p {
			- "A "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-3" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object represents a dynamic list of zero or more video tracks, of\n  which zero or one can be selected at a time. Each video track is represented by a\n  "
			code id="audiotracklist-and-videotracklist-objects:videotrack-5" {
				a href="#videotrack" {
					- "VideoTrack"
				}
			}
			- " object."
		}
		- "\n\n  "
		p {
			- "Tracks in "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-4" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-4" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " objects must be\n  consistently ordered. If the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource" {
				- "media resource"
			}
			- " is in a format that defines an order,\n  then that order must be used; otherwise, the order must be the relative order in which the tracks\n  are declared in the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-2" {
				- "media resource"
			}
			- ". The order used is called the "
			i {
				- "natural order"
			}
			- "\n  of the list."
		}
		- "\n\n  "
		p class="note" {
			- "Each track in one of these objects thus has an index; the first has the index\n  0, and each subsequent track is numbered one higher than the previous one. If a "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-3" {
				- "media\n  resource"
			}
			- " dynamically adds or removes audio or video tracks, then the indices of the tracks\n  will change dynamically. If the "
			a href="#media-resource" id="audiotracklist-and-videotracklist-objects:media-resource-4" {
				- "media resource"
			}
			- " changes entirely, then all the\n  previous tracks will be removed and replaced with new tracks."
		}
		- "\n\n  "
		p {
			- "The "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-5" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " "
			dfn data-dfn-for="AudioTrackList" id="dom-audiotracklist-length" data-dfn-type="attribute" {
				code {
					- "length"
				}
			}
			- " and "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-5" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- "\n  "
			dfn data-dfn-for="VideoTrackList" id="dom-videotracklist-length" data-dfn-type="attribute" {
				code {
					- "length"
				}
			}
			- "\n  attribute getters must return the number of tracks represented by their objects at the time of\n  getting."
		}
		- "\n\n  "
		p {
			- "The "
			a id="audiotracklist-and-videotracklist-objects:supported-property-indices" href="https://webidl.spec.whatwg.org/#dfn-supported-property-indices" data-x-internal="supported-property-indices" {
				- "supported property indices"
			}
			- " of "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-6" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " and\n  "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-6" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " objects at any instant are the numbers from zero to the number of\n  tracks represented by the respective object minus one, if any tracks are represented. If an\n  "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-7" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
			- " or "
			code id="audiotracklist-and-videotracklist-objects:videotracklist-7" {
				a href="#videotracklist" {
					- "VideoTrackList"
				}
			}
			- " object represents no tracks, it has no\n  "
			a id="audiotracklist-and-videotracklist-objects:supported-property-indices-2" href="https://webidl.spec.whatwg.org/#dfn-supported-property-indices" data-x-internal="supported-property-indices" {
				- "supported property indices"
			}
			- "."
		}
		- "\n\n  "
		p id="dom-tracklist-item" {
			- "To "
			a id="audiotracklist-and-videotracklist-objects:determine-the-value-of-an-indexed-property" href="https://webidl.spec.whatwg.org/#dfn-determine-the-value-of-an-indexed-property" data-x-internal="determine-the-value-of-an-indexed-property" {
				- "determine the value of an indexed property"
			}
			- " for a\n  given index "
			var {
				- "index"
			}
			- " in an "
			code id="audiotracklist-and-videotracklist-objects:audiotracklist-8" {
				a href="#audiotracklist" {
					- "AudioTrackList"
				}
			}
