			dd {
				- "\n    "
				p {
					- "Returns the current level of blur applied to shadows."
				}
				- "\n\n    "
				p {
					- "Can be set, to change the blur level. Values that are not finite numbers greater than or\n    equal to zero are ignored."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Objects which implement the "
			code id="shadows:canvasshadowstyles-2" {
				a href="#canvasshadowstyles" {
					- "CanvasShadowStyles"
				}
			}
			- " interface have an associated "
			dfn id="concept-canvasshadowstyles-shadow-color" {
				- "shadow color"
			}
			- ", which is a CSS color.\n  Initially, it must be "
			a id="shadows:transparent-black" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
				- "transparent black"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasShadowStyles" id="dom-context-2d-shadowcolor" data-dfn-type="attribute" {
				code {
					- "shadowColor"
				}
			}
			- " getter steps are to return the "
			a href="https://drafts.csswg.org/css-color/#serializing-color-values" id="shadows:serialisation-of-a-color" data-x-internal="serialisation-of-a-color" {
				- "serialization"
			}
			- " of "
			a id="shadows:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "'s "
			a href="#concept-canvasshadowstyles-shadow-color" id="shadows:concept-canvasshadowstyles-shadow-color" {
				- "shadow color"
			}
			- " with "
			a href="https://drafts.csswg.org/css-color/#color-serialization-html-compatible-serialization-is-requested" id="shadows:html-compatible-serialization-is-requested" data-x-internal="html-compatible-serialization-is-requested" {
				- "HTML-compatible serialization\n  requested"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="shadows:dom-context-2d-shadowcolor" {
				a href="#dom-context-2d-shadowcolor" {
					- "shadowColor"
				}
			}
			- " setter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "context"
					}
					- " be "
					a id="shadows:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					code id="shadows:dom-context-2d-canvas" {
						a href="#dom-context-2d-canvas" {
							- "canvas"
						}
					}
					- " attribute's value, if that is an element; otherwise\n   null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "parsedValue"
					}
					- " be the result of "
					a href="https://drafts.csswg.org/css-color/#parse-a-css-color-value" id="shadows:parsed-as-a-css-color-value" data-x-internal="parsed-as-a-css-color-value" {
						- "parsing"
					}
					- " the given value with "
					var {
						- "context"
					}
					- " if non-null."
				}
			}
			li {
				p {
					- "If "
					var {
						- "parsedValue"
					}
					- " is failure, then return."
				}
			}
			li {
				p {
					- "Set "
					a id="shadows:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-canvasshadowstyles-shadow-color" id="shadows:concept-canvasshadowstyles-shadow-color-2" {
						- "shadow\n   color"
					}
					- " to "
					var {
						- "parsedValue"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasShadowStyles" id="dom-context-2d-shadowoffsetx" data-dfn-type="attribute" {
				code {
					- "shadowOffsetX"
				}
			}
			- " and "
			dfn data-dfn-for="CanvasShadowStyles" id="dom-context-2d-shadowoffsety" data-dfn-type="attribute" {
				code {
					- "shadowOffsetY"
				}
			}
			- "\n  attributes specify the distance that the shadow will be offset in the positive horizontal and\n  positive vertical distance respectively. Their values are in coordinate space units. They are not\n  affected by the current transformation matrix."
		}
		- "\n\n  "
		p {
			- "When the context is created, the shadow offset attributes must initially have the value\n  0."
		}
		- "\n\n  "
		p {
			- "On getting, they must return their current value. On setting, the attribute being set must be\n  set to the new value, except if the value is infinite or NaN, in which case the new value must be\n  ignored."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="CanvasShadowStyles" id="dom-context-2d-shadowblur" data-dfn-type="attribute" {
				code {
					- "shadowBlur"
				}
			}
			- " attribute specifies the level of the\n  blurring effect. (The units do not map to coordinate space units, and are not affected by the\n  current transformation matrix.)"
		}
		- "\n\n  "
		p {
			- "When the context is created, the "
			code id="shadows:dom-context-2d-shadowblur" {
				a href="#dom-context-2d-shadowblur" {
					- "shadowBlur"
				}
			}
			- "\n  attribute must initially have the value 0."
		}
		- "\n\n  "
		p {
			- "On getting, the attribute must return its current value. On setting, the attribute must be set\n  to the new value, except if the value is negative, infinite or NaN, in which case the new value\n  must be ignored."
		}
		- "\n\n  "
		p {
			dfn id="when-shadows-are-drawn" {
				- "Shadows are only drawn if"
			}
			- " the opacity component of\n  the alpha component of the "
			a href="#concept-canvasshadowstyles-shadow-color" id="shadows:concept-canvasshadowstyles-shadow-color-3" {
				- "shadow\n  color"
			}
			- " is nonzero and either the "
			code id="shadows:dom-context-2d-shadowblur-2" {
				a href="#dom-context-2d-shadowblur" {
					- "shadowBlur"
				}
			}
			- "\n  is nonzero, or the "
			code id="shadows:dom-context-2d-shadowoffsetx" {
				a href="#dom-context-2d-shadowoffsetx" {
					- "shadowOffsetX"
				}
			}
			- " is nonzero, or\n  the "
			code id="shadows:dom-context-2d-shadowoffsety" {
				a href="#dom-context-2d-shadowoffsety" {
					- "shadowOffsetY"
				}
			}
			- " is nonzero."
		}
		- "\n\n  "
		p {
			a href="#when-shadows-are-drawn" id="shadows:when-shadows-are-drawn" {
				- "When shadows are drawn"
			}
			- ", they must be rendered as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "A"
					}
					- " be an infinite "
					a id="shadows:transparent-black-2" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
						- "transparent black"
					}
					- " bitmap on which the source\n   image for which a shadow is being created has been rendered."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "B"
					}
					- " be an infinite "
					a id="shadows:transparent-black-3" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
						- "transparent black"
					}
					- " bitmap, with a coordinate\n   space and an origin identical to "
					var {
						- "A"
					}
					- "."
				}
			}
			li {
				p {
					- "Copy the alpha channel of "
					var {
						- "A"
					}
					- " to "
					var {
						- "B"
					}
					- ", offset by "
					code id="shadows:dom-context-2d-shadowoffsetx-2" {
						a href="#dom-context-2d-shadowoffsetx" {
							- "shadowOffsetX"
						}
					}
					- " in the positive "
					var {
						- "x"
					}
					- "\n   direction, and "
					code id="shadows:dom-context-2d-shadowoffsety-2" {
						a href="#dom-context-2d-shadowoffsety" {
							- "shadowOffsetY"
						}
					}
					- " in the positive\n   "
					var {
						- "y"
					}
					- " direction."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					code id="shadows:dom-context-2d-shadowblur-3" {
						a href="#dom-context-2d-shadowblur" {
							- "shadowBlur"
						}
					}
					- " is greater than 0:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "σ"
							}
							- " be half the value of "
							code id="shadows:dom-context-2d-shadowblur-4" {
								a href="#dom-context-2d-shadowblur" {
									- "shadowBlur"
								}
							}
							- "."
						}
					}
					li {
						p {
							- "Perform a 2D Gaussian Blur on "
							var {
								- "B"
							}
							- ", using "
							var {
								- "σ"
							}
							- "\n     as the standard deviation."
						}
						- "  "
					}
				}
				- "\n\n    "
				p {
					- "User agents may limit values of "
					var {
						- "σ"
					}
					- " to an implementation-specific\n    maximum value to avoid exceeding hardware limitations during the Gaussian blur operation."
				}
				- "\n   "
			}
			li {
				p {
					- "Set the red, green, and blue components of every pixel in "
					var {
						- "B"
					}
					- " to the\n   red, green, and blue components (respectively) of the "
					a href="#concept-canvasshadowstyles-shadow-color" id="shadows:concept-canvasshadowstyles-shadow-color-4" {
						- "shadow color"
					}
					- "."
				}
			}
			li {
				p {
					- "Multiply the alpha component of every pixel in "
					var {
						- "B"
					}
					- " by the alpha\n   component of the "
					a href="#concept-canvasshadowstyles-shadow-color" id="shadows:concept-canvasshadowstyles-shadow-color-5" {
						- "shadow\n   color"
					}
					- "."
				}
			}
			li {
				p {
					- "The shadow is in the bitmap "
					var {
						- "B"
					}
					- ", and is rendered as part of the\n   "
					a href="#drawing-model" id="shadows:drawing-model" {
						- "drawing model"
					}
					- " described below."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "If the "
			a href="#current-compositing-and-blending-operator" id="shadows:current-compositing-and-blending-operator" {
				- "current compositing and blending operator"
			}
			- " is \""
			code id="shadows:gcop-copy" {
				a data-x-internal="gcop-copy" href="https://drafts.fxtf.org/compositing/#porterduffcompositingoperators_src" {
					- "copy"
				}
			}
			- "\", then shadows effectively won't render (since the shape will\n  overwrite the shadow)."
		}
		- "\n\n  "
		h6 id="filters" {
			span class="secno" {
				- "4.12.5.1.19"
			}
			- " Filters"
			a href="#filters" class="self-link"
		}
		- "\n\n  "
		p {
			- "All drawing operations on an object which implements the "
			code id="filters:canvasfilters" {
				a href="#canvasfilters" {
					- "CanvasFilters"
				}
			}
			- "\n  interface are affected by the global "
			dfn data-dfn-for="CanvasFilters" id="dom-context-2d-filter" data-dfn-type="attribute" {
				code {
					- "filter"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "context"
					}
					- "."
					a href="#dom-context-2d-filter" id="dom-context-2d-filter-dev" {
						- "filter"
					}
					- " [ = "
					var {
						- "value"
					}
					- " ]"
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/filter" title="The CanvasRenderingContext2D.filter property of the Canvas 2D API provides filter effects such as blurring and grayscaling. It is similar to the CSS filter property and accepts the same values." {
								- "CanvasRenderingContext2D/filter"
							}
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "49+"
								}
							}
							span class="safari no" {
								span {
									- "Safari"
								}
								span {
									- "No"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "52+"
								}
							}
							hr
							span class="opera unknown" {
								span {
									- "Opera"
								}
								span {
									- "?"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge unknown" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "?"
								}
							}
							span class="ie no" {
								span {
									- "Internet Explorer"
								}
								span {
									- "No"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios unknown" {
								span {
									- "Safari iOS"
								}
								span {
									- "?"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android unknown" {
								span {
									- "WebView Android"
								}
								span {
									- "?"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android unknown" {
								span {
									- "Opera Android"
								}
								span {
									- "?"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the current filter."
				}
				- "\n\n\n    "
				p {
					- "Can be set, to change the filter. Values can either be the string \""
					code {
						- "none"
					}
					- "\" or a string parseable as a "
					a id="filters:filter-value-list" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
						- "<filter-value-list>"
					}
					- ". Other\n    values are ignored."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Such objects have an associated "
			dfn id="concept-canvas-current-filter" {
				- "current\n  filter"
			}
			- ", which is a string. Initially the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter" {
				- "current filter"
			}
			- " is set to the string \""
			code {
				- "none"
			}
			- "\". Whenever the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-2" {
				- "current filter"
			}
			- " is the string \""
			code {
				- "none"
			}
			- "\" filters will be disabled for the context."
		}
		- "\n\n  "
		p {
			- "The "
			code id="filters:dom-context-2d-filter" {
				a href="#dom-context-2d-filter" {
					- "filter"
				}
			}
			- " getter steps are to return\n  "
			a id="filters:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "'s "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-3" {
				- "current filter"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="filters:dom-context-2d-filter-2" {
				a href="#dom-context-2d-filter" {
					- "filter"
				}
			}
			- " setter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the given value is \""
					code {
						- "none"
					}
					- "\", then set "
					a id="filters:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-4" {
						- "current filter"
					}
					- " to \""
					code {
						- "none"
					}
					- "\"\n   and return."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "parsedValue"
					}
					- " be the result of "
					a href="https://drafts.csswg.org/css-syntax/#parse-grammar" id="filters:parse-something-according-to-a-css-grammar" data-x-internal="parse-something-according-to-a-css-grammar" {
						- "parsing"
					}
					- " the given values as a "
					a id="filters:filter-value-list-2" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
						- "<filter-value-list>"
					}
					- ". If any\n   property-independent style sheet syntax like 'inherit' or 'initial' is present, then this\n   parsing must return failure."
				}
			}
			li {
				p {
					- "If "
					var {
						- "parsedValue"
					}
					- " is failure, then return."
				}
			}
			li {
				p {
					- "Set "
					a id="filters:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-5" {
						- "current\n   filter"
					}
					- " to the given value."
				}
			}
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "Though "
			code {
				var {
					- "context"
				}
				- "."
				code id="filters:dom-context-2d-filter-3" {
					a href="#dom-context-2d-filter" {
						- "filter"
					}
				}
				- " = \""
				code {
					- "none"
				}
				- "\""
			}
			- " will disable\n  filters for the context, "
			code {
				var {
					- "context"
				}
				- "."
				code id="filters:dom-context-2d-filter-4" {
					a href="#dom-context-2d-filter" {
						- "filter"
					}
				}
				- " = \"\""
			}
			- ", "
			code {
				var {
					- "context"
				}
				- "."
				code id="filters:dom-context-2d-filter-5" {
					a href="#dom-context-2d-filter" {
						- "filter"
					}
				}
				- " = null"
			}
			- ",\n  and "
			code {
				var {
					- "context"
				}
				- "."
				code id="filters:dom-context-2d-filter-6" {
					a href="#dom-context-2d-filter" {
						- "filter"
					}
				}
				- " =\n  undefined"
			}
			- " are all treated as unparseable inputs and the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-6" {
				- "current filter"
			}
			- " is left unchanged."
		}
		- "\n\n  "
		p {
			- "Coordinates used in the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-7" {
				- "current\n  filter"
			}
			- " are interpreted such that one pixel is equivalent to one SVG user space unit and to\n  one canvas coordinate space unit. Filter coordinates are not affected by the "
			a href="#transformations" id="filters:transformations" {
				- "current transformation matrix"
			}
			- ". The current\n  transformation matrix affects only the input to the filter. Filters are applied in the\n  "
			a href="#output-bitmap" id="filters:output-bitmap" {
				- "output bitmap"
			}
			- "'s coordinate space."
		}
		- "\n\n  \n\n  "
		p {
			- "When the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-8" {
				- "current filter"
			}
			- " is a\n  string parsable as a "
			a id="filters:filter-value-list-3" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
				- "<filter-value-list>"
			}
			- " which defines lengths using\n  percentages or using "
			a id="filters:'em'" href="https://drafts.csswg.org/css-values/#em" data-x-internal="'em'" {
				- "'em'"
			}
			- " or "
			a id="filters:'ex'" href="https://drafts.csswg.org/css-values/#ex" data-x-internal="'ex'" {
				- "'ex'"
			}
			- " units, these must be interpreted\n  relative to the "
			a id="filters:computed-value" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- " of the "
			a id="filters:'font-size'" href="https://drafts.csswg.org/css-fonts/#font-size-prop" data-x-internal="'font-size'" {
				- "'font-size'"
			}
			- " property of the\n  "
			a href="#font-style-source-object" id="filters:font-style-source-object" {
				- "font style source object"
			}
			- " at the time that the attribute is set. If the "
			a href="https://drafts.csswg.org/css-cascade/#computed-value" id="filters:computed-value-2" data-x-internal="computed-value" {
				- "computed values"
			}
			- " are undefined for a particular case (e.g. because\n  the "
			a href="#font-style-source-object" id="filters:font-style-source-object-2" {
				- "font style source object"
			}
			- " is not an element or is not "
			a href="#being-rendered" id="filters:being-rendered" {
				- "being\n  rendered"
			}
			- "), then the relative keywords must be interpreted relative to the default value of\n  the "
			code id="filters:dom-context-2d-font" {
				a href="#dom-context-2d-font" {
					- "font"
				}
			}
			- " attribute. The 'larger' and 'smaller' keywords\n  are not supported."
		}
		- "\n\n  "
		p {
			- "If the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-9" {
				- "current filter"
			}
			- " is a\n  string parseable as a "
			a id="filters:filter-value-list-4" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
				- "<filter-value-list>"
			}
			- " with a reference to an SVG filter in\n  the same document, and this SVG filter changes, then the changed filter is used for the next draw\n  operation."
		}
		- "\n\n  "
		p {
			- "If the value of the "
			a href="#concept-canvas-current-filter" id="filters:concept-canvas-current-filter-10" {
				- "current filter"
			}
			- " is a\n  string parseable as a "
			a id="filters:filter-value-list-5" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
				- "<filter-value-list>"
			}
			- " with a reference to an SVG filter in\n  an external resource document and that document is not loaded when a drawing operation is\n  invoked, then the drawing operation must proceed with no filtering."
		}
		- "\n\n  \n\n  "
		h6 id="working-with-externally-defined-svg-filters" {
			span class="secno" {
				- "4.12.5.1.20"
			}
			- " Working with externally-defined SVG filters"
			a href="#working-with-externally-defined-svg-filters" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "Since drawing is performed using filter value \""
			code {
				- "none"
			}
			- "\" until an\n  externally-defined filter has finished loading, authors might wish to determine whether such a\n  filter has finished loading before proceeding with a drawing operation. One way to accomplish\n  this is to load the externally-defined filter elsewhere within the same page in some element that\n  sends a "
			code {
				- "load"
			}
			- " event (for example, an "
			a id="working-with-externally-defined-svg-filters:svg-use" href="https://svgwg.org/svg2-draft/struct.html#UseElement" data-x-internal="svg-use" {
				- "SVG "
				code {
					- "use"
				}
			}
			- "\n  element), and wait for the "
			code {
				- "load"
			}
			- " event to be dispatched."
		}
		- "\n\n  \n\n  "
		h6 id="drawing-model" {
			span class="secno" {
				- "4.12.5.1.21"
			}
			- " "
			dfn {
				- "Drawing model"
			}
			a href="#drawing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "When a shape or image is painted, user agents must follow these steps, in the order given (or\n  act as if they do):"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Render the shape or image onto an infinite "
					a id="drawing-model:transparent-black" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
						- "transparent black"
					}
					- " bitmap, creating\n   image "
					var {
						- "A"
					}
					- ", as described in the previous sections. For shapes, the current fill, stroke,\n   and line styles must be honored, and the stroke must itself also be subjected to the current\n   transformation matrix."
				}
			}
			li {
				p {
					- "Multiply the alpha component of every pixel in "
					var {
						- "A"
					}
					- " by "
					code id="drawing-model:concept-canvas-global-alpha" {
						a href="#concept-canvas-global-alpha" {
							- "global alpha"
						}
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "When the "
					a href="#concept-canvas-current-filter" id="drawing-model:concept-canvas-current-filter" {
						- "current filter"
					}
					- " is set to a\n    value other than \""
					code {
						- "none"
					}
					- "\" and all the externally-defined filters it\n    references, if any, are in documents that are currently loaded, then use image "
					var {
						- "A"
					}
					- " as\n    the input to the "
					a href="#concept-canvas-current-filter" id="drawing-model:concept-canvas-current-filter-2" {
						- "current filter"
					}
					- ", creating\n    image "
					var {
						- "B"
					}
					- ". If the "
					a href="#concept-canvas-current-filter" id="drawing-model:concept-canvas-current-filter-3" {
						- "current filter"
					}
					- "\n    is a string parseable as a "
					a id="drawing-model:filter-value-list" href="https://drafts.fxtf.org/filter-effects/#typedef-filter-value-list" data-x-internal="filter-value-list" {
						- "<filter-value-list>"
					}
					- ", then draw using the "
					a href="#concept-canvas-current-filter" id="drawing-model:concept-canvas-current-filter-4" {
						- "current filter"
					}
					- " in the same manner as SVG."
				}
				- "\n\n    "
				p {
					- "Otherwise, let "
					var {
						- "B"
					}
					- " be an alias for "
					var {
						- "A"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					a href="#when-shadows-are-drawn" id="drawing-model:when-shadows-are-drawn" {
						- "When shadows are drawn"
					}
					- ", render the shadow from image "
					var {
						- "B"
					}
					- ",\n   using the current shadow styles, creating image "
					var {
						- "C"
					}
					- "."
				}
			}
			li {
				p {
					a href="#when-shadows-are-drawn" id="drawing-model:when-shadows-are-drawn-2" {
						- "When shadows are drawn"
					}
					- ", composite "
					var {
						- "C"
					}
					- " within the\n   "
					a href="#clipping-region" id="drawing-model:clipping-region" {
						- "clipping region"
					}
					- " over the current "
					a href="#output-bitmap" id="drawing-model:output-bitmap" {
						- "output bitmap"
					}
					- " using the "
					a href="#current-compositing-and-blending-operator" id="drawing-model:current-compositing-and-blending-operator" {
						- "current\n   compositing and blending operator"
					}
					- "."
				}
			}
			li {
				p {
					- "Composite "
					var {
						- "B"
					}
					- " within the "
					a href="#clipping-region" id="drawing-model:clipping-region-2" {
						- "clipping region"
					}
					- " over the current\n   "
					a href="#output-bitmap" id="drawing-model:output-bitmap-2" {
						- "output bitmap"
					}
					- " using the "
					a href="#current-compositing-and-blending-operator" id="drawing-model:current-compositing-and-blending-operator-2" {
						- "current compositing and blending\n   operator"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "When compositing onto the "
			a href="#output-bitmap" id="drawing-model:output-bitmap-3" {
				- "output bitmap"
			}
			- ", pixels that would fall outside of the\n  "
			a href="#output-bitmap" id="drawing-model:output-bitmap-4" {
				- "output bitmap"
			}
			- " must be discarded."
		}
		- "\n\n  \n\n\n\n\n  "
		h6 id="best-practices" {
			span class="secno" {
				- "4.12.5.1.22"
			}
			- " Best practices"
			a href="#best-practices" class="self-link"
		}
		- "\n\n  "
		p {
			- "When a canvas is interactive, authors should include "
			a href="#focusable" id="best-practices:focusable" {
				- "focusable"
			}
			- " elements in the\n  element's fallback content corresponding to each "
			a href="#focusable" id="best-practices:focusable-2" {
				- "focusable"
			}
			- " part of the canvas, as in\n  the "
			a href="#drawCustomFocusRingExample" {
				- "example above"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When rendering focus rings, to ensure that focus rings have the appearance of native focus\n  rings, authors should use the "
			code id="best-practices:dom-context-2d-drawfocusifneeded" {
				a href="#dom-context-2d-drawfocusifneeded" {
					- "drawFocusIfNeeded()"
				}
			}
			- " method, passing it the\n  element for which a ring is being drawn. This method only draws the focus ring if the element is\n  "
			a href="#focused" id="best-practices:focused" {
				- "focused"
			}
			- ", so that it can simply be called whenever drawing the element, without\n  checking whether the element is focused or not first."
		}
		- "\n\n  "
		p id="no-text-editing-in-canvas-please" {
			- "Authors should avoid implementing text editing controls\n  using the "
			code id="best-practices:the-canvas-element" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element. Doing so has a large number of disadvantages:"
		}
		- "\n\n  "
		ul {
			li {
				- "Mouse placement of the caret has to be reimplemented."
			}
			li {
				- "Keyboard movement of the caret has to be reimplemented (possibly across lines, for multiline\n   text input)."
			}
			li {
				- "Scrolling of the text control has to be implemented (horizontally for long lines, vertically\n   for multiline input)."
			}
			li {
				- "Native features such as copy-and-paste have to be reimplemented."
			}
			li {
				- "Native features such as spell-checking have to be reimplemented."
			}
			li {
				- "Native features such as drag-and-drop have to be reimplemented."
			}
			li {
				- "Native features such as page-wide text search have to be reimplemented."
			}
			li {
				- "Native features specific to the user, for example custom text services, have to be\n   reimplemented. This is close to impossible since each user might have different services\n   installed, and there is an unbounded set of possible such services."
			}
			li {
				- "Bidirectional text editing has to be reimplemented."
			}
			li {
				- "For multiline text editing, line wrapping has to be implemented for all relevant\n   languages."
			}
			li {
				- "Text selection has to be reimplemented."
			}
			li {
				- "Dragging of bidirectional text selections has to be reimplemented."
			}
			li {
				- "Platform-native keyboard shortcuts have to be reimplemented."
			}
			li {
				- "Platform-native input method editors (IMEs) have to be reimplemented."
			}
			li {
				- "Undo and redo functionality has to be reimplemented."
			}
			li {
				- "Accessibility features such as magnification following the caret or selection have to be\n   reimplemented."
			}
		}
		- "\n\n  "
		p {
			- "This is a huge amount of work, and authors are most strongly encouraged to avoid doing any of\n  it by instead using the "
			code id="best-practices:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element, the "
			code id="best-practices:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element, or the\n  "
			code id="best-practices:attr-contenteditable" {
				a href="#attr-contenteditable" {
					- "contenteditable"
				}
			}
			- " attribute."
		}
		- "\n\n\n  "
		h6 id="examples" {
			span class="secno" {
				- "4.12.5.1.23"
			}
			- " Examples"
			a href="#examples" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n  "
			p {
				- "Here is an example of a script that uses canvas to draw "
				a href="data:text/html;charset=utf-8;base64,PCFET0NUWVBFIEhUTUw%2BDQo8aHRtbCBsYW5nPSJlbiI%2BDQogPGhlYWQ%2BDQogIDx0aXRsZT5QcmV0dHkgR2xvd2luZyBMaW5lczwvdGl0bGU%2BDQogPC9oZWFkPg0KIDxib2R5Pg0KPGNhbnZhcyB3aWR0aD0iODAwIiBoZWlnaHQ9IjQ1MCI%2BPC9jYW52YXM%%2BDQogPC9ib2R5Pg0KPC9odG1sPg0K" {
					- "pretty glowing lines"
				}
				- "."
			}
			- "\n\n  "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "canvas"
					}
					- " "
					c- e="" {
						- "width"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"800\""
					}
					- " "
					c- e="" {
						- "height"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"450\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "canvas"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n\n "
					c- a="" {
						- "var"
					}
					- " context "
					c- o="" {
						- "="
					}
					- " document"
					c- p="" {
						- "."
					}
					- "getElementsByTagName"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'canvas'"
					}
					c- p="" {
						- ")["
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- "]."
					}
					- "getContext"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'2d'"
					}
					c- p="" {
						- ");"
					}
					- "\n\n "
					c- a="" {
						- "var"
					}
					- " lastX "
					c- o="" {
						- "="
					}
					- " context"
					c- p="" {
						- "."
					}
					- "canvas"
					c- p="" {
						- "."
					}
					- "width "
					c- o="" {
						- "*"
					}
					- " Math"
					c- p="" {
						- "."
					}
					- "random"
					c- p="" {
						- "();"
					}
					- "\n "
					c- a="" {
						- "var"
					}
					- " lastY "
					c- o="" {
						- "="
					}
					- " context"
					c- p="" {
						- "."
					}
					- "canvas"
					c- p="" {
						- "."
					}
					- "height "
					c- o="" {
						- "*"
					}
					- " Math"
					c- p="" {
						- "."
					}
					- "random"
					c- p="" {
						- "();"
					}
					- "\n "
					c- a="" {
						- "var"
					}
					- " hue "
					c- o="" {
						- "="
					}
					- " "
					c- mf="" {
						- "0"
					}
					c- p="" {
						- ";"
					}
					- "\n "
					c- a="" {
						- "function"
					}
					- " line"
					c- p="" {
						- "()"
					}
