				- "\n    "
				p {
					- "Gives a sound file relating to the person or organization."
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-property-value" id="vcard:concept-property-value-68" {
						- "value"
					}
					- " must be an "
					a id="vcard:absolute-url-7" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
						- "absolute\n    URL"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vcard:md-vcard-sound" {
						a href="#md-vcard-sound" {
							- "sound"
						}
					}
					- " may be\n    present within each "
					a href="#concept-item" id="vcard:concept-item-78" {
						- "item"
					}
					- " with the type "
					code id="vcard:md-vcard-49" {
