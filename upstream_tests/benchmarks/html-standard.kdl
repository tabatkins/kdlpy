							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "A user agent that is attempting to reduce network usage while still fetching\n      the metadata for each "
							a href="#media-resource" id="loading-the-media-resource:media-resource-15" {
								- "media resource"
							}
							- " would also stop buffering at this point,\n      following "
							a href="#resourceSuspend" {
								- "the rules described previously"
							}
							- ", which involve the\n      "
							code id="loading-the-media-resource:dom-media-networkstate-13" {
