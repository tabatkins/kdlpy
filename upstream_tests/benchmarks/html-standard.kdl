					- " has its "
					a href="#sandboxed-origin-browsing-context-flag" id="creating-browsing-contexts:sandboxed-origin-browsing-context-flag" {
						- "sandboxed origin browsing\n   context flag"
					}
					- " set, then return a new "
					a href="#concept-origin-opaque" id="creating-browsing-contexts:concept-origin-opaque" {
						- "opaque\n   origin"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "url"
					}
					- " is null, then return a new "
					a href="#concept-origin-opaque" id="creating-browsing-contexts:concept-origin-opaque-2" {
						- "opaque\n   origin"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "url"
					}
					- " is "
					code id="creating-browsing-contexts:about:srcdoc" {
						a href="#about:srcdoc" {
							- "about:srcdoc"
						}
					}
					- ", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a id="creating-browsing-contexts:assert-3" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "sourceOrigin"
							}
							- " is non-null."
						}
					}
					li {
						p {
							- "Return "
							var {
								- "sourceOrigin"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "url"
					}
					- " "
					a href="#matches-about:blank" id="creating-browsing-contexts:matches-about:blank" {
						- "matches "
						code {
							- "about:blank"
						}
					}
					- " and\n   "
					var {
						- "sourceOrigin"
					}
					- " is non-null, then return "
					var {
						- "sourceOrigin"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "url"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-origin" id="creating-browsing-contexts:concept-url-origin" data-x-internal="concept-url-origin" {
						- "origin"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The cases that return "
			var {
				- "sourceOrigin"
			}
			- " result in two\n  "
			code id="creating-browsing-contexts:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- "s that end up with the same underlying "
			a href="https://dom.spec.whatwg.org/#concept-document-origin" id="creating-browsing-contexts:concept-document-origin-5" data-x-internal="concept-document-origin" {
				- "origin"
			}
			- ", meaning that "
			code id="creating-browsing-contexts:dom-document-domain" {
				a href="#dom-document-domain" {
					- "document.domain"
				}
			}
			- " affects both."
		}
		- "\n\n\n  "
		h5 id="nested-browsing-contexts" {
			span class="secno" {
				- "7.3.2.2"
			}
			- " Related browsing contexts"
			a href="#nested-browsing-contexts" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context" id="nested-browsing-contexts:browsing-context" {
				- "browsing context"
			}
			- " "
			var {
				- "potentialDescendant"
			}
			- " is said to be an "
			dfn id="ancestor-browsing-context" {
				- "ancestor"
			}
			- " of a browsing context\n  "
			var {
				- "potentialAncestor"
			}
			- " if the following algorithm returns true:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "potentialDescendantDocument"
					}
					- " be "
					var {
						- "potentialDescendant"
					}
					- "'s\n   "
					a href="#active-document" id="nested-browsing-contexts:active-document" {
						- "active document"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "potentialDescendantDocument"
					}
					- " is not "
					a href="#fully-active" id="nested-browsing-contexts:fully-active" {
						- "fully active"
					}
					- ", then return\n   false."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "ancestorBCs"
					}
					- " be the list obtained by taking the "
					a href="#concept-document-bc" id="nested-browsing-contexts:concept-document-bc" {
						- "browsing context"
					}
					- " of the "
					a href="#nav-document" id="nested-browsing-contexts:nav-document" {
						- "active\n   document"
					}
					- " of each member of "
					var {
						- "potentialDescendantDocument"
					}
					- "'s "
					a href="#ancestor-navigables" id="nested-browsing-contexts:ancestor-navigables" {
						- "ancestor\n   navigables"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "ancestorBCs"
					}
					- " "
					a href="https://infra.spec.whatwg.org/#list-contain" id="nested-browsing-contexts:list-contains" data-x-internal="list-contains" {
						- "contains"
					}
					- "\n   "
					var {
						- "potentialAncestor"
					}
					- ", then return true."
				}
			}
			li {
				p {
					- "Return false."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="top-level-browsing-context" data-export="" {
				- "top-level browsing context"
			}
			- " is a "
			a href="#browsing-context" id="nested-browsing-contexts:browsing-context-2" {
				- "browsing context"
			}
			- " whose\n  "
			a href="#active-document" id="nested-browsing-contexts:active-document-2" {
				- "active document"
			}
			- "'s "
			a href="#node-navigable" id="nested-browsing-contexts:node-navigable" {
				- "node navigable"
			}
			- " is a "
			a href="#traversable-navigable" id="nested-browsing-contexts:traversable-navigable" {
				- "traversable\n  navigable"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "It is "
			em {
				- "not"
			}
			- " required to be a "
			a href="#top-level-traversable" id="nested-browsing-contexts:top-level-traversable" {
				- "top-level traversable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="bc-tlbc" {
				- "top-level browsing context"
			}
			- " of a "
			a href="#browsing-context" id="nested-browsing-contexts:browsing-context-3" {
				- "browsing context"
			}
			- "\n  "
			var {
				- "start"
			}
			- " is the result of the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "start"
					}
					- "'s "
					a href="#active-document" id="nested-browsing-contexts:active-document-3" {
						- "active document"
					}
					- " is not "
					a href="#fully-active" id="nested-browsing-contexts:fully-active-2" {
						- "fully active"
					}
					- ", then\n   return null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "navigable"
					}
					- " be "
					var {
						- "start"
					}
					- "'s "
					a href="#active-document" id="nested-browsing-contexts:active-document-4" {
						- "active document"
					}
					- "'s "
					a href="#node-navigable" id="nested-browsing-contexts:node-navigable-2" {
						- "node\n   navigable"
					}
					- "."
				}
			}
			li {
				p {
					- "While "
					var {
						- "navigable"
					}
					- "'s "
					a href="#nav-parent" id="nested-browsing-contexts:nav-parent" {
						- "parent"
					}
					- " is not null, set\n   "
					var {
						- "navigable"
					}
					- " to "
					var {
						- "navigable"
					}
					- "'s "
					a href="#nav-parent" id="nested-browsing-contexts:nav-parent-2" {
						- "parent"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "navigable"
					}
					- "'s "
					a href="#nav-bc" id="nested-browsing-contexts:nav-bc" {
						- "active browsing\n   context"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div id="warning-avoid-related-bc-terms" class="warning" {
			- "\n   "
			p {
				- "The terms "
				a href="#ancestor-browsing-context" id="nested-browsing-contexts:ancestor-browsing-context" {
					- "ancestor browsing context"
				}
				- " and "
				a href="#top-level-browsing-context" id="nested-browsing-contexts:top-level-browsing-context" {
					- "top-level browsing context"
				}
				- "\n   are rarely useful, since "
				a href="#browsing-context" id="nested-browsing-contexts:browsing-context-4" {
					- "browsing contexts"
				}
				- " in general are\n   "
				a href="#warning-avoid-using-bcs" {
					- "usually the inappropriate specification concept to use"
				}
				- ".\n   Note in particular that when a "
				a href="#browsing-context" id="nested-browsing-contexts:browsing-context-5" {
					- "browsing context"
				}
				- "'s "
				a href="#active-document" id="nested-browsing-contexts:active-document-5" {
					- "active document"
				}
				- " is\n   not "
				a href="#fully-active" id="nested-browsing-contexts:fully-active-3" {
					- "fully active"
				}
				- ", it never counts as an ancestor or top-level browsing context, and\n   as such these concepts are not useful when "
				a href="#note-bfcache" {
					- "bfcache"
				}
				- " is in play."
			}
			- "\n\n   "
			p {
				- "Instead, use concepts such as the "
				a href="#ancestor-navigables" id="nested-browsing-contexts:ancestor-navigables-2" {
					- "ancestor navigables"
				}
				- " collection, the "
				a href="#nav-parent" id="nested-browsing-contexts:nav-parent-3" {
					- "parent navigable"
				}
				- ", or a navigable's "
				a href="#nav-traversable" id="nested-browsing-contexts:nav-traversable" {
					- "top-level traversable"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p id="security-1" {
			span id="security-nav"
			- "A "
			a href="#browsing-context" id="nested-browsing-contexts:browsing-context-6" {
				- "browsing context"
			}
			- " "
			var {
				- "A"
			}
			- " is\n  "
			dfn id="familiar-with" {
				- "familiar with"
			}
			- " a second "
			a href="#browsing-context" id="nested-browsing-contexts:browsing-context-7" {
				- "browsing context"
			}
			- " "
			var {
				- "B"
			}
			- " if the following\n  algorithm returns true:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "A"
					}
					- "'s "
					a href="#active-document" id="nested-browsing-contexts:active-document-6" {
						- "active document"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="nested-browsing-contexts:concept-document-origin" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " is "
					a href="#same-origin" id="nested-browsing-contexts:same-origin" {
						- "same origin"
					}
					- " with "
					var {
						- "B"
					}
					- "'s\n   "
					a href="#active-document" id="nested-browsing-contexts:active-document-7" {
						- "active document"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="nested-browsing-contexts:concept-document-origin-2" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- ", then return\n   true."
				}
			}
			li {
				p {
					- "If "
					var {
						- "A"
					}
					- "'s "
					a href="#bc-tlbc" id="nested-browsing-contexts:bc-tlbc" {
						- "top-level browsing context"
					}
					- " is\n   "
					var {
						- "B"
					}
					- ", then return true."
				}
			}
			li {
				p {
					- "If "
					var {
						- "B"
					}
					- " is an "
					a href="#auxiliary-browsing-context" id="nested-browsing-contexts:auxiliary-browsing-context" {
						- "auxiliary browsing context"
					}
					- " and "
					var {
						- "A"
					}
					- " is\n   "
					a href="#familiar-with" id="nested-browsing-contexts:familiar-with" {
						- "familiar with"
					}
					- " "
					var {
						- "B"
					}
					- "'s "
					a href="#opener-browsing-context" id="nested-browsing-contexts:opener-browsing-context" {
						- "opener browsing context"
					}
					- ", then return\n   true."
				}
			}
			li {
				- "\n    "
				p {
					- "If there exists an "
					a href="#ancestor-browsing-context" id="nested-browsing-contexts:ancestor-browsing-context-2" {
						- "ancestor browsing context"
					}
					- " of "
					var {
						- "B"
					}
					- " whose "
					a href="#active-document" id="nested-browsing-contexts:active-document-8" {
						- "active\n    document"
					}
					- " has the "
					a href="#same-origin" id="nested-browsing-contexts:same-origin-2" {
						- "same"
					}
					- " "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="nested-browsing-contexts:concept-document-origin-3" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " as the "
					a href="#active-document" id="nested-browsing-contexts:active-document-9" {
						- "active document"
					}
					- " of\n    "
					var {
						- "A"
					}
					- ", then return true."
				}
				- "\n\n    "
				p class="note" {
					- "This includes the case where "
					var {
						- "A"
					}
					- " is an "
					a href="#ancestor-browsing-context" id="nested-browsing-contexts:ancestor-browsing-context-3" {
						- "ancestor browsing\n    context"
					}
					- " of "
					var {
						- "B"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "Return false."
				}
			}
		}
		- "\n\n  "
		h5 id="groupings-of-browsing-contexts" {
			span class="secno" {
				- "7.3.2.3"
			}
			- " Groupings of browsing contexts"
			a href="#groupings-of-browsing-contexts" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context" {
				- "top-level browsing context"
			}
			- " has an associated "
			dfn id="tlbc-group" {
				- "group"
			}
			- " (null or a "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group" {
				- "browsing context group"
			}
			- "). It is initially null."
		}
		- "\n\n  "
		p {
			- "A user agent holds a "
			dfn id="browsing-context-group-set" {
				- "browsing context group set"
			}
			- " (a "
			a id="groupings-of-browsing-contexts:set" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
				- "set"
			}
			- " of "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-2" {
				- "browsing context groups"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="browsing-context-group" {
				- "browsing context group"
			}
			- " holds a "
			dfn id="browsing-context-set" {
				- "browsing context set"
			}
			- " (a "
			a id="groupings-of-browsing-contexts:set-2" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
				- "set"
			}
			- "\n  of "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-2" {
				- "top-level browsing contexts"
			}
			- ")."
		}
		- "\n\n  "
		p class="note" {
			- "A "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-3" {
				- "top-level browsing context"
			}
			- " is added to the "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-3" {
				- "group"
			}
			- " when the group is "
			a href="#creating-a-new-browsing-context-group-and-document" id="groupings-of-browsing-contexts:creating-a-new-browsing-context-group-and-document" {
				- "created"
			}
			- ". All subsequent "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-4" {
				- "top-level\n  browsing contexts"
			}
			- " added to the "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-4" {
				- "group"
			}
			- " will be\n  "
			a href="#auxiliary-browsing-context" id="groupings-of-browsing-contexts:auxiliary-browsing-context" {
				- "auxiliary browsing contexts"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-5" {
				- "browsing context group"
			}
			- " has an associated "
			dfn id="agent-cluster-map" {
				- "agent cluster map"
			}
			- " (a weak\n  "
			a href="https://infra.spec.whatwg.org/#ordered-map" id="groupings-of-browsing-contexts:ordered-map" data-x-internal="ordered-map" {
				- "map"
			}
			- " of "
			a href="#agent-cluster-key" id="groupings-of-browsing-contexts:agent-cluster-key" {
				- "agent cluster\n  keys"
			}
			- " to "
			a href="https://tc39.es/ecma262/#sec-agent-clusters" id="groupings-of-browsing-contexts:agent-cluster" data-x-internal="agent-cluster" {
				- "agent clusters"
			}
			- "). User agents are responsible\n  for collecting agent clusters when it is deemed that nothing can access them anymore."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-6" {
				- "browsing context group"
			}
			- " has an associated "
			dfn id="historical-agent-cluster-key-map" {
				- "historical agent cluster key\n  map"
			}
			- ", which is a "
			a href="https://infra.spec.whatwg.org/#ordered-map" id="groupings-of-browsing-contexts:ordered-map-2" data-x-internal="ordered-map" {
				- "map"
			}
			- " of "
			a href="#concept-origin" id="groupings-of-browsing-contexts:concept-origin" {
				- "origins"
			}
			- " to "
			a href="#agent-cluster-key" id="groupings-of-browsing-contexts:agent-cluster-key-2" {
				- "agent cluster keys"
			}
			- ". This\n  map is used to ensure the consistency of the "
			a href="#origin-keyed-agent-clusters" {
				- "origin-keyed\n  agent clusters"
			}
			- " feature by recording what agent cluster keys were previously used for a given\n  origin."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#historical-agent-cluster-key-map" id="groupings-of-browsing-contexts:historical-agent-cluster-key-map" {
				- "historical agent cluster key map"
			}
			- " only ever gains entries over the\n  lifetime of the browsing context group."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-7" {
				- "browsing context group"
			}
			- " has a "
			dfn id="bcg-cross-origin-isolation" {
				- "cross-origin isolation mode"
			}
			- ", which is a\n  "
			a href="#cross-origin-isolation-mode" id="groupings-of-browsing-contexts:cross-origin-isolation-mode" {
				- "cross-origin isolation mode"
			}
			- ". It is initially \""
			code id="groupings-of-browsing-contexts:cross-origin-isolation-none" {
				a href="#cross-origin-isolation-none" {
					- "none"
				}
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="cross-origin-isolation-mode" {
				- "cross-origin isolation mode"
			}
			- " is one of three possible values: \""
			dfn id="cross-origin-isolation-none" {
				code {
					- "none"
				}
			}
			- "\", \""
			dfn id="cross-origin-isolation-logical" {
				code {
					- "logical"
				}
			}
			- "\", or \""
			dfn id="cross-origin-isolation-concrete" {
				code {
					- "concrete"
				}
			}
			- "\"."
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "\""
				code id="groupings-of-browsing-contexts:cross-origin-isolation-logical" {
					a href="#cross-origin-isolation-logical" {
						- "logical"
					}
				}
				- "\" and \""
				code id="groupings-of-browsing-contexts:cross-origin-isolation-concrete" {
					a href="#cross-origin-isolation-concrete" {
						- "concrete"
					}
				}
				- "\" are similar. They are both used for\n   "
				a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-8" {
					- "browsing context groups"
				}
				- " where:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "every top-level "
						code id="groupings-of-browsing-contexts:document" {
							a href="#document" {
								- "Document"
							}
						}
						- " has `"
						code {
							a href="#cross-origin-opener-policy-2" id="groupings-of-browsing-contexts:cross-origin-opener-policy-2" {
								- "Cross-Origin-Opener-Policy"
							}
							- ": "
							a href="#coop-same-origin" id="groupings-of-browsing-contexts:coop-same-origin" {
								- "same-origin"
							}
						}
						- "`, and"
					}
				}
				li {
					p {
						- "every "
						code id="groupings-of-browsing-contexts:document-2" {
							a href="#document" {
								- "Document"
							}
						}
						- " has a `"
						code id="groupings-of-browsing-contexts:cross-origin-embedder-policy" {
							a href="#cross-origin-embedder-policy" {
								- "Cross-Origin-Embedder-Policy"
							}
						}
						- "` header\n    whose value is "
						a href="#compatible-with-cross-origin-isolation" id="groupings-of-browsing-contexts:compatible-with-cross-origin-isolation" {
							- "compatible with cross-origin isolation"
						}
						- "."
					}
				}
			}
			- "\n\n   "
			p {
				- "On some platforms, it is difficult to provide the security properties required to grant safe\n   access to the APIs gated by the "
				a href="#concept-settings-object-cross-origin-isolated-capability" id="groupings-of-browsing-contexts:concept-settings-object-cross-origin-isolated-capability" {
					- "cross-origin isolated\n   capability"
				}
				- ". As a result, only \""
				code id="groupings-of-browsing-contexts:cross-origin-isolation-concrete-2" {
					a href="#cross-origin-isolation-concrete" {
						- "concrete"
					}
				}
				- "\" can grant access that capability.\n   \""
				code id="groupings-of-browsing-contexts:cross-origin-isolation-logical-2" {
					a href="#cross-origin-isolation-logical" {
						- "logical"
					}
				}
				- "\" is used on platform not supporting\n   this capability, where various restrictions imposed by cross-origin isolation will still apply,\n   but the capability is not granted."
			}
			- "\n  "
		}
		- "\n\n  "
		p id="creating-a-new-browsing-context-group" {
			- "To "
			dfn id="creating-a-new-browsing-context-group-and-document" {
				- "create a new browsing context group and document"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "group"
					}
					- " be a new "
					a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-9" {
						- "browsing context group"
					}
					- "."
				}
			}
			li {
				p {
					a href="https://infra.spec.whatwg.org/#set-append" id="groupings-of-browsing-contexts:set-append" data-x-internal="set-append" {
						- "Append"
					}
					- " "
					var {
						- "group"
					}
					- " to the user agent's\n   "
					a href="#browsing-context-group-set" id="groupings-of-browsing-contexts:browsing-context-group-set" {
						- "browsing context group set"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "browsingContext"
					}
					- " and "
					var {
						- "document"
					}
					- " be the result of "
					a href="#creating-a-new-browsing-context" id="groupings-of-browsing-contexts:creating-a-new-browsing-context" {
						- "creating a\n   new browsing context and document"
					}
					- " with null, null, and "
					var {
						- "group"
					}
					- "."
				}
			}
			li {
				p {
					a href="#bcg-append" id="groupings-of-browsing-contexts:bcg-append" {
						- "Append"
					}
					- " "
					var {
						- "browsingContext"
					}
					- " to\n   "
					var {
						- "group"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "group"
					}
					- " and "
					var {
						- "document"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="bcg-append" {
				- "append"
			}
			- " a "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-5" {
				- "top-level browsing context"
			}
			- "\n  "
			var {
				- "browsingContext"
			}
			- " to a "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-10" {
				- "browsing context group"
			}
			- " "
			var {
				- "group"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="https://infra.spec.whatwg.org/#set-append" id="groupings-of-browsing-contexts:set-append-2" data-x-internal="set-append" {
						- "Append"
					}
					- " "
					var {
						- "browsingContext"
					}
					- " to "
					var {
						- "group"
					}
					- "'s\n   "
					a href="#browsing-context-set" id="groupings-of-browsing-contexts:browsing-context-set" {
						- "browsing context set"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="groupings-of-browsing-contexts:tlbc-group" {
						- "group"
					}
					- " to\n   "
					var {
						- "group"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="bcg-remove" {
				- "remove"
			}
			- " a "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-6" {
				- "top-level browsing context"
			}
			- "\n  "
			var {
				- "browsingContext"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a id="groupings-of-browsing-contexts:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="groupings-of-browsing-contexts:tlbc-group-2" {
						- "group"
					}
					- "\n   is non-null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "group"
					}
					- " be "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="groupings-of-browsing-contexts:tlbc-group-3" {
						- "group"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="groupings-of-browsing-contexts:tlbc-group-4" {
						- "group"
					}
					- " to null."
				}
			}
			li {
				p {
					a href="https://infra.spec.whatwg.org/#list-remove" id="groupings-of-browsing-contexts:list-remove" data-x-internal="list-remove" {
						- "Remove"
					}
					- " "
					var {
						- "browsingContext"
					}
					- " from\n   "
					var {
						- "group"
					}
					- "'s "
					a href="#browsing-context-set" id="groupings-of-browsing-contexts:browsing-context-set-2" {
						- "browsing context set"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "group"
					}
					- "'s "
					a href="#browsing-context-set" id="groupings-of-browsing-contexts:browsing-context-set-3" {
						- "browsing context set"
					}
					- " "
					a href="https://infra.spec.whatwg.org/#list-is-empty" id="groupings-of-browsing-contexts:list-is-empty" data-x-internal="list-is-empty" {
						- "is\n   empty"
					}
					- ", then "
					a href="https://infra.spec.whatwg.org/#list-remove" id="groupings-of-browsing-contexts:list-remove-2" data-x-internal="list-remove" {
						- "remove"
					}
					- " "
					var {
						- "group"
					}
					- " from the user\n   agent's "
					a href="#browsing-context-group-set" id="groupings-of-browsing-contexts:browsing-context-group-set-2" {
						- "browsing context group set"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			a href="#bcg-append" id="groupings-of-browsing-contexts:bcg-append-2" {
				- "Append"
			}
			- " and "
			a href="#bcg-remove" id="groupings-of-browsing-contexts:bcg-remove" {
				- "remove"
			}
			- " are primitive operations that help define the lifetime of a "
			a href="#browsing-context-group" id="groupings-of-browsing-contexts:browsing-context-group-11" {
				- "browsing\n  context group"
			}
			- ". They are called by higher-level creation and destruction operations for\n  "
			code id="groupings-of-browsing-contexts:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- "s and "
			a href="#browsing-context" id="groupings-of-browsing-contexts:browsing-context" {
				- "browsing contexts"
			}
			- "."
		}
		- "\n\n  "
		p id="a-browsing-context-is-discarded" {
			- "When there are no "
			code id="groupings-of-browsing-contexts:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- " objects whose\n  "
			a href="#concept-document-bc" id="groupings-of-browsing-contexts:concept-document-bc" {
				- "browsing context"
			}
			- " equals a given "
			a href="#browsing-context" id="groupings-of-browsing-contexts:browsing-context-2" {
				- "browsing\n  context"
			}
			- " (i.e., all such "
			code id="groupings-of-browsing-contexts:document-5" {
				a href="#document" {
					- "Document"
				}
			}
			- "s have been "
			a href="#destroy-a-document" id="groupings-of-browsing-contexts:destroy-a-document" {
				- "destroyed"
			}
			- "), and that "
			a href="#browsing-context" id="groupings-of-browsing-contexts:browsing-context-3" {
				- "browsing context"
			}
			- "'s "
			code id="groupings-of-browsing-contexts:windowproxy" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " is\n  eligible for garbage collection, then the "
			a href="#browsing-context" id="groupings-of-browsing-contexts:browsing-context-4" {
				- "browsing context"
			}
			- " will never be accessed\n  again. If it is a "
			a href="#top-level-browsing-context" id="groupings-of-browsing-contexts:top-level-browsing-context-7" {
				- "top-level browsing context"
			}
			- ", then at this point the user agent must\n  "
			a href="#bcg-remove" id="groupings-of-browsing-contexts:bcg-remove-2" {
				- "remove"
			}
			- " it."
		}
		- "\n\n\n  "
		h4 id="fully-active-documents" {
			span class="secno" {
				- "7.3.3"
			}
			- " Fully active documents"
			a href="#fully-active-documents" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			code id="fully-active-documents:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " "
			var {
				- "d"
			}
			- " is said to be "
			dfn data-dfn-for="Document" id="fully-active" data-export="" {
				- "fully\n  active"
			}
			- " when "
			var {
				- "d"
			}
			- " is the "
			a href="#nav-document" id="fully-active-documents:nav-document" {
				- "active document"
			}
			- " of a\n  "
			a href="#navigable" id="fully-active-documents:navigable" {
				- "navigable"
			}
			- " "
			var {
				- "navigable"
			}
			- ", and either "
			var {
				- "navigable"
			}
			- " is a "
			a href="#top-level-traversable" id="fully-active-documents:top-level-traversable" {
				- "top-level\n  traversable"
			}
			- " or "
			var {
				- "navigable"
			}
			- "'s "
			a href="#nav-container-document" id="fully-active-documents:nav-container-document" {
				- "container\n  document"
			}
			- " is "
			a href="#fully-active" id="fully-active-documents:fully-active" {
				- "fully active"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Because they are associated with an element, "
			a href="#child-navigable" id="fully-active-documents:child-navigable" {
				- "child\n  navigables"
			}
			- " are always tied to a specific "
			code id="fully-active-documents:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- ", their "
			a href="#nav-container-document" id="fully-active-documents:nav-container-document-2" {
				- "container document"
			}
			- ", in their "
			a href="#nav-parent" id="fully-active-documents:nav-parent" {
				- "parent navigable"
			}
			- ". User agents must not allow the user to interact with\n  "
			a href="#child-navigable" id="fully-active-documents:child-navigable-2" {
				- "child navigables"
			}
			- " whose "
			a href="#nav-container-document" id="fully-active-documents:nav-container-document-3" {
				- "container documents"
			}
			- " are not themselves "
			a href="#fully-active" id="fully-active-documents:fully-active-2" {
				- "fully\n  active"
			}
			- "."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following example illustrates how a "
				code id="fully-active-documents:document-3" {
					a href="#document" {
						- "Document"
					}
				}
				- " can be the "
				a href="#nav-document" id="fully-active-documents:nav-document-2" {
					- "active document"
				}
				- " of its "
				a href="#node-navigable" id="fully-active-documents:node-navigable" {
					- "node navigable"
				}
				- ", while not being\n   "
				a href="#fully-active" id="fully-active-documents:fully-active-3" {
					- "fully active"
				}
				- ". Here "
				code {
					- "a.html"
				}
				- " is loaded into a browser window,\n   "
				code {
					- "b-1.html"
				}
				- " starts out loaded into an "
				code id="fully-active-documents:the-iframe-element" {
					a href="#the-iframe-element" {
