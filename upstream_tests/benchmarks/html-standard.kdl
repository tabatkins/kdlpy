		- "\n\n  "
		p {
			- "The "
			code id="worklet-dev" {
				a href="#worklet" {
					- "Worklet"
				}
			}
			- " class provides the capability to add module scripts into its\n  associated "
			code id="worklets-worklet:workletglobalscope" {
				a href="#workletglobalscope" {
					- "WorkletGlobalScope"
				}
			}
			- "s. The user agent can then create classes registered on\n  the "
			code id="worklets-worklet:workletglobalscope-2" {
				a href="#workletglobalscope" {
					- "WorkletGlobalScope"
				}
			}
			- "s and invoke their methods."
		}
		- "\n\n  "
		pre {
			code class="idl" {
				- "["
				c- g="" {
					- "Exposed"
				}
				- "="
				c- n="" {
					- "Window"
				}
