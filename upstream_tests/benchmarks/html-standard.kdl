					- "name"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "q"
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "submit"
				}
				c- p="" {
					- ">"
				}
				- "\n"
				c- p="" {
					- "</"
				}
				c- f="" {
					- "form"
				}
				c- p="" {
					- ">"
				}
			}
		}
		- "\n\n  "
		p {
			- "If the user types in \"cats\" in the first field and \"fur\" in the second, and then hits the\n  submit button, then the user agent will load "
			code {
				- "/find.cgi?t=cats&q=fur"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "On the other hand, consider this form:"
		}
		- "\n\n  "
		pre {
			code class="html" {
				c- p="" {
					- "<"
				}
				c- f="" {
					- "form"
				}
				- " "
				c- e="" {
					- "action"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"/find.cgi\""
				}
				- " "
				c- e="" {
					- "method"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "post"
				}
				- " "
				c- e="" {
					- "enctype"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"multipart/form-data\""
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "text"
				}
				- " "
				c- e="" {
					- "name"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "t"
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "search"
				}
				- " "
