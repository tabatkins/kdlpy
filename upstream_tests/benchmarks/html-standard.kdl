							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"color-scheme\""
							}
							- " "
							c- e="" {
								- "content"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"dark\""
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n    "
				}
				- "\n\n    \n\n     "
				p {
					- "To obtain a "
					a id="standard-metadata-names:page's-supported-color-schemes-2" href="https://drafts.csswg.org/css-color-adjust/#pages-supported-color-schemes" data-x-internal="page's-supported-color-schemes" {
						- "page's supported color-schemes"
					}
					- ", user agents must run the following steps:"
				}
				- "\n\n     "
				ol {
					li {
						- "\n       "
						p {
							- "Let "
							var {
								- "candidate elements"
							}
							- " be the list of all "
							code id="standard-metadata-names:the-meta-element-18" {
								a href="#the-meta-element" {
									- "meta"
								}
							}
							- " elements that\n       meet the following criteria, in "
							a id="standard-metadata-names:tree-order-4" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
								- "tree order"
							}
							- ":"
						}
						- "\n\n       "
						ul {
							li {
								p {
									- "the element is "
									a id="standard-metadata-names:in-a-document-tree-3" href="https://dom.spec.whatwg.org/#in-a-document-tree" data-x-internal="in-a-document-tree" {
										- "in a document tree"
									}
									- ";"
								}
							}
							li {
								p {
									- "the element has a "
									code id="standard-metadata-names:attr-meta-name-14" {
										a href="#attr-meta-name" {
											- "name"
										}
									}
									- " attribute, whose value\n        is an "
									a id="standard-metadata-names:ascii-case-insensitive-11" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
										- "ASCII case-insensitive"
									}
									- " match for "
									code id="standard-metadata-names:meta-color-scheme-2" {
										a href="#meta-color-scheme" {
											- "color-scheme"
										}
									}
									- "; and"
								}
							}
							li {
								p {
									- "the element has a "
									code id="standard-metadata-names:attr-meta-content-9" {
										a href="#attr-meta-content" {
											- "content"
										}
									}
									- " attribute."
								}
							}
						}
						- "\n      "
					}
					li {
						- "\n       "
						p {
							- "For each "
							var {
								- "element"
							}
							- " in "
							var {
								- "candidate elements"
							}
							- ":"
