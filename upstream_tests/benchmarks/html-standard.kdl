			tbody {
				tr {
					th headers="th-fa-area" id="td-fa-3" class="data-header" {
						- "\n     The user-agent provided subwidgets of elements that are "
						a href="#being-rendered" id="data-model:being-rendered-3" {
							- "being rendered"
						}
						- " and are not\n     "
						a href="#concept-element-disabled" id="data-model:concept-element-disabled-2" {
							- "actually disabled"
						}
						- " or "
						a href="#inert" id="data-model:inert-3" {
							- "inert"
						}
						- ".\n     "
					}
					td headers="td-fa-3 th-fa-dom-rep" {
						- "\n     The element for which the "
						a href="#focusable-area" id="data-model:focusable-area-9" {
							- "focusable area"
						}
						- " is a subwidget.\n    "
					}
				}
				tr {
					td colspan="2" headers="td-fa-3 th-fa-examples" {
						- "\n     "
						p class="example" {
							- "The "
							a href="#expose-a-user-interface-to-the-user" id="data-model:expose-a-user-interface-to-the-user" {
								- "controls in the user\n     interface"
							}
							- " for a "
							code id="data-model:the-video-element" {
								a href="#the-video-element" {
									- "video"
								}
							}
							- " element, the up and down buttons in a spin-control\n     version of "
							code id="data-model:number-state-(type=number)" {
								a href="#number-state-(type=number)" {
									- "<input type=number>"
								}
							}
							- ", the part of a\n     "
							code id="data-model:the-details-element" {
								a href="#the-details-element" {
									- "details"
								}
							}
							- " element's rendering that enables the element to be opened or closed using\n     keyboard input."
						}
						- "\n\n   "
					}
				}
			}
			tbody {
				tr {
					th headers="th-fa-area" id="td-fa-4" class="data-header" {
						- "\n     The scrollable regions of elements that are "
						a href="#being-rendered" id="data-model:being-rendered-4" {
							- "being rendered"
						}
						- " and are not\n     "
						a href="#inert" id="data-model:inert-4" {
							- "inert"
						}
						- ". \n     "
					}
					td headers="td-fa-4 th-fa-dom-rep" {
						- "\n     The element for which the box that the scrollable region scrolls was created.\n    "
					}
				}
				tr {
					td colspan="2" headers="td-fa-4 th-fa-examples" {
						- "\n     "
						p class="example" {
							- "The CSS "
							a id="data-model:'overflow'" href="https://drafts.csswg.org/css-overflow/#propdef-overflow" data-x-internal="'overflow'" {
								- "'overflow'"
							}
							- " property's 'scroll' value typically creates\n     a scrollable region."
						}
						- "\n\n   "
					}
				}
			}
			tbody {
				tr {
					th headers="th-fa-area" id="td-fa-5" class="data-header" {
						- "\n     The "
						a id="data-model:viewport" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- " of a "
						code id="data-model:document-2" {
							a href="#document" {
								- "Document"
							}
						}
						- " that has a non-null "
						a href="#concept-document-bc" id="data-model:concept-document-bc" {
							- "browsing context"
						}
						- " and is not "
						a href="#inert" id="data-model:inert-5" {
							- "inert"
						}
						- ".\n     "
					}
					td headers="td-fa-5 th-fa-dom-rep" {
						- "\n     The "
						code id="data-model:document-3" {
							a href="#document" {
								- "Document"
							}
						}
						- " for which the "
						a id="data-model:viewport-2" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- " was created.\n    "
					}
				}
				tr {
					td colspan="2" headers="td-fa-5 th-fa-examples" {
						- "\n     "
						p class="example" {
							- "The contents of an "
							code id="data-model:the-iframe-element-2" {
								a href="#the-iframe-element" {
									- "iframe"
								}
							}
							- "."
						}
						- "\n\n   "
					}
				}
			}
			tbody {
				tr {
					th headers="th-fa-area" id="td-fa-6" class="data-header" {
						- "\n     Any other element or part of an element determined by the user agent to be a focusable area,\n     especially to aid with accessibility or to better match platform conventions.\n     "
					}
					td headers="td-fa-6 th-fa-dom-rep" {
						- "\n     The element.\n    "
					}
				}
				tr {
					td colspan="2" headers="td-fa-6 th-fa-examples" {
						- "\n     "
						p class="example" {
							- "A user agent could make all list item bullets "
							a href="#sequentially-focusable" id="data-model:sequentially-focusable" {
								- "sequentially\n     focusable"
							}
							- ", so that a user can more easily navigate lists."
						}
						- "\n     "
						p class="example" {
							- "Similarly, a user agent could make all elements with "
							code id="data-model:attr-title" {
								a href="#attr-title" {
									- "title"
								}
							}
							- " attributes "
							a href="#sequentially-focusable" id="data-model:sequentially-focusable-2" {
								- "sequentially focusable"
							}
							- ", so that their\n     advisory information can be accessed."
						}
						- "\n\n  "
					}
				}
			}
		}
		- "\n\n  "
		p id="bc-focus-ergo-bcc-focus" class="note" {
			- "A "
			a href="#navigable-container" id="data-model:navigable-container" {
				- "navigable container"
			}
			- " (e.g. an\n  "
			code id="data-model:the-iframe-element-3" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- ") is a "
			a href="#focusable-area" id="data-model:focusable-area-10" {
				- "focusable area"
			}
			- ", but key events routed to a "
			a href="#navigable-container" id="data-model:navigable-container-2" {
				- "navigable\n  container"
			}
			- " get immediately routed to its "
			a href="#content-navigable" id="data-model:content-navigable" {
				- "content navigable"
			}
			- "'s "
			a href="#nav-document" id="data-model:nav-document-2" {
				- "active document"
			}
			- ". Similarly, in sequential focus navigation a\n  "
			a href="#navigable-container" id="data-model:navigable-container-3" {
				- "navigable container"
			}
			- " essentially acts merely as a placeholder for its "
			a href="#content-navigable" id="data-model:content-navigable-2" {
				- "content\n  navigable"
			}
			- "'s "
			a href="#nav-document" id="data-model:nav-document-3" {
				- "active document"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "One "
			a href="#focusable-area" id="data-model:focusable-area-11" {
				- "focusable area"
			}
			- " in each "
			code id="data-model:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- " is designated the "
			dfn id="focused-area-of-the-document" {
				- "focused\n  area of the document"
			}
			- ". Which control is so designated changes over time, based on algorithms\n  in this specification."
		}
		- "\n\n  "
		p class="note" {
			- "Even if a document is not "
			a href="#fully-active" id="data-model:fully-active-2" {
				- "fully active"
			}
			- " and not shown to the user, it\n  can still have a "
			a href="#focused-area-of-the-document" id="data-model:focused-area-of-the-document" {
				- "focused area of the document"
			}
			- ". If a document's "
			a href="#fully-active" id="data-model:fully-active-3" {
				- "fully\n  active"
			}
			- " state changes, its "
			a href="#focused-area-of-the-document" id="data-model:focused-area-of-the-document-2" {
				- "focused area of the document"
			}
			- " will stay the same."
		}
		- "\n\n  "
		p id="currently-focused-area-of-a-top-level-browsing-context" {
			- "The "
			dfn id="currently-focused-area-of-a-top-level-traversable" {
				- "currently focused area of\n  a top-level traversable"
			}
			- " "
			var {
				- "traversable"
			}
			- " is the "
			a href="#focusable-area" id="data-model:focusable-area-12" {
				- "focusable area"
			}
			- "-or-null\n  returned by this algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "traversable"
					}
					- " does not have "
