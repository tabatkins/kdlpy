								- "node"
							}
							- " is a "
							code id="parsing-main-inbody:the-dd-element-4" {
								a href="#the-dd-element" {
									- "dd"
								}
							}
							- " element, then run these\n      substeps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-2" {
										- "Generate implied end tags"
									}
									- ", except for "
									code id="parsing-main-inbody:the-dd-element-5" {
										a href="#the-dd-element" {
											- "dd"
										}
									}
									- " elements."
								}
							}
							li {
								p {
									- "If the "
									a href="#current-node" id="parsing-main-inbody:current-node-7" {
										- "current node"
									}
									- " is not a "
									code id="parsing-main-inbody:the-dd-element-6" {
										a href="#the-dd-element" {
											- "dd"
										}
									}
									- " element, then this is a\n       "
									a href="#parse-errors" id="parsing-main-inbody:parse-errors-14" {
										- "parse error"
