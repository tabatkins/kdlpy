							a href="#dom-navigationoptions-info" {
								- "info"
							}
						}
						- "\n     "
					}
					td {
						- "Until the task is queued to fire the "
						code id="ongoing-navigation-tracking:event-navigate" {
							a href="#event-navigate" {
								- "navigate"
							}
						}
						- " event\n     "
					}
					td {
						- "So that we can use it to fire the "
						code id="ongoing-navigation-tracking:event-navigate-2" {
							a href="#event-navigate" {
								- "navigate"
							}
						}
						- " after the trip through the "
						a href="#tn-session-history-traversal-queue" id="ongoing-navigation-tracking:tn-session-history-traversal-queue" {
							- "session history traversal queue"
						}
						- ".\n    "
					}
				}
				tr {
					td {
						- "Any "
						code id="ongoing-navigation-tracking:dom-navigationresult-committed-2" {
							a href="#dom-navigationresult-committed" {
								- "committed"
							}
						}
						- " promise that was returned\n     "
					}
					td {
						- "Until the session history is updated (inside that same task)\n     "
					}
					td {
						- "So that we can resolve or reject it appropriately\n    "
					}
				}
				tr {
					td {
						- "Whether "
						code id="ongoing-navigation-tracking:dom-navigateevent-intercept-5" {
							a href="#dom-navigateevent-intercept" {
								- "intercept()"
							}
						}
						- " was called\n     "
					}
					td {
						- "Until the session history is updated (inside that same task)\n     "
					}
					td {
						- "So that we can suppress the normal scroll restoration logic in favor of the behavior given by the "
						code id="ongoing-navigation-tracking:dom-navigationinterceptoptions-scroll" {
							a href="#dom-navigationinterceptoptions-scroll" {
								- "scroll"
							}
						}
						- " option\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "We also cannot assume there is only a single navigation requested at any given time, due to web\n  developer code such as:"
		}
		- "\n\n  "
		pre {
			code class="js" {
				c- a="" {
					- "const"
				}
				- " p1 "
				c- o="" {
					- "="
				}
				- " navigation"
				c- p="" {
					- "."
				}
				- "navigate"
				c- p="" {
					- "("
				}
				- "url1"
				c- p="" {
					- ")."
				}
				- "finished"
				c- p="" {
					- ";"
				}
				- "\n"
				c- a="" {
					- "const"
				}
				- " p2 "
				c- o="" {
					- "="
				}
				- " navigation"
				c- p="" {
					- "."
				}
				- "navigate"
				c- p="" {
					- "("
				}
				- "url2"
				c- p="" {
					- ")."
				}
				- "finished"
				c- p="" {
					- ";"
				}
			}
		}
		- "\n\n  "
		p {
			- "That is, in this scenario, we need to ensure that while navigating to "
			code {
				- "url2"
			}
			- ", we still have the promise "
			code {
				- "p1"
			}
			- " around so that we can\n  reject it. We can't just get rid of any ongoing navigation promises the moment the second call to\n  "
			code id="ongoing-navigation-tracking:dom-navigation-navigate" {
				a href="#dom-navigation-navigate" {
					- "navigate()"
				}
			}
			- " happens."
		}
		- "\n\n  "
		p {
			- "We end up accomplishing all this by associating the following with each\n  "
			code id="ongoing-navigation-tracking:navigation-2" {
				a href="#navigation" {
					- "Navigation"
				}
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					dfn id="ongoing-navigate-event" {
						- "Ongoing "
						code {
							- "navigate"
						}
						- " event"
