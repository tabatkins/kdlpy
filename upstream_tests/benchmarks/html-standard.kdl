						- "\n     "
					}
					li {
						p {
							- "If "
							var {
								- "val"
							}
							- " is \""
							dfn data-dfn-for="ColorSpaceConversion" id="dom-colorspaceconversion-none" data-dfn-type="enum-value" {
								code {
									- "none"
								}
							}
							- "\", "
							var {
								- "output"
							}
