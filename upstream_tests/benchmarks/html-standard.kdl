								span {
									- "No"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios yes" {
								span {
									- "Safari iOS"
								}
								span {
									- "16+"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android unknown" {
								span {
									- "WebView Android"
								}
								span {
									- "?"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "11+"
								}
							}
						}
					}
				}
			}
			dd {
				p {
					- "Aborts "
					var {
						- "sharedWorkerGlobal"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="SharedWorkerGlobalScope" id="dom-sharedworkerglobalscope-name" data-dfn-type="attribute" {
				code {
					- "name"
				}
			}
			- " getter steps are to return\n  "
			a id="shared-workers-and-the-sharedworkerglobalscope-interface:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "'s "
			a href="#concept-workerglobalscope-name" id="shared-workers-and-the-sharedworkerglobalscope-interface:concept-workerglobalscope-name-2" {
				- "name"
			}
			- ". Its value\n  represents the name that can be used to obtain a reference to the worker using the\n  "
			code id="shared-workers-and-the-sharedworkerglobalscope-interface:sharedworker-3" {
				a href="#sharedworker" {
					- "SharedWorker"
				}
			}
			- " constructor."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="SharedWorkerGlobalScope" id="dom-sharedworkerglobalscope-close" data-dfn-type="method" {
				code {
					- "close()"
				}
			}
			- " method steps are to "
			a href="#close-a-worker" id="shared-workers-and-the-sharedworkerglobalscope-interface:close-a-worker" {
				- "close a\n  worker"
			}
			- " given "
			a id="shared-workers-and-the-sharedworkerglobalscope-interface:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  \n\n  "
		p {
			- "The following are the "
			a href="#event-handlers" id="shared-workers-and-the-sharedworkerglobalscope-interface:event-handlers" {
				- "event handlers"
			}
			- " (and their corresponding "
			a href="#event-handler-event-type" id="shared-workers-and-the-sharedworkerglobalscope-interface:event-handler-event-type" {
				- "event handler event types"
			}
			- ") that must be supported,\n  as "
			a href="#event-handler-idl-attributes" id="shared-workers-and-the-sharedworkerglobalscope-interface:event-handler-idl-attributes" {
				- "event handler IDL attributes"
			}
			- ", by objects implementing the\n  "
			code id="shared-workers-and-the-sharedworkerglobalscope-interface:sharedworkerglobalscope-5" {
				a href="#sharedworkerglobalscope" {
					- "SharedWorkerGlobalScope"
				}
			}
			- " interface:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						a href="#event-handlers" id="shared-workers-and-the-sharedworkerglobalscope-interface:event-handlers-2" {
							- "Event handler"
						}
						- " "
					}
					th {
						a href="#event-handler-event-type" id="shared-workers-and-the-sharedworkerglobalscope-interface:event-handler-event-type-2" {
							- "Event handler event type"
						}
						- "\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="SharedWorkerGlobalScope" id="handler-sharedworkerglobalscope-onconnect" data-dfn-type="attribute" {
							code {
								- "onconnect"
							}
						}
						- " "
						div class="mdn-anno wrapped before" {
							button onclick="toggleStatus(this)" class="mdn-anno-btn" {
								b title="Support in all current engines." class="all-engines-flag" {
									- "✔"
								}
								span {
									- "MDN"
								}
							}
							div class="feature" {
								p {
									a href="https://developer.mozilla.org/en-US/docs/Web/API/SharedWorkerGlobalScope/connect_event" title="The connect event is fired in shared workers at their SharedWorkerGlobalScope when a new client connects." {
										- "SharedWorkerGlobalScope/connect_event"
									}
								}
								p class="all-engines-text" {
									- "Support in all current engines."
								}
								div class="support" {
									span class="firefox yes" {
										span {
											- "Firefox"
										}
										span {
											- "29+"
										}
									}
									span class="safari yes" {
										span {
											- "Safari"
										}
										span {
											- "16+"
										}
									}
									span class="chrome yes" {
										span {
											- "Chrome"
										}
										span {
											- "4+"
										}
									}
									hr
									span class="opera yes" {
										span {
											- "Opera"
										}
										span {
											- "10.6+"
										}
									}
									span class="edge_blink yes" {
										span {
											- "Edge"
										}
										span {
											- "79+"
										}
									}
									hr
									span class="edge unknown" {
										span {
											- "Edge (Legacy)"
										}
										span {
											- "?"
										}
									}
									span class="ie no" {
										span {
											- "Internet Explorer"
										}
										span {
											- "No"
										}
									}
									hr
									span class="firefox_android unknown" {
										span {
											- "Firefox Android"
										}
										span {
											- "?"
										}
									}
									span class="safari_ios yes" {
										span {
											- "Safari iOS"
										}
										span {
											- "16+"
										}
									}
									span class="chrome_android unknown" {
										span {
											- "Chrome Android"
										}
										span {
											- "?"
										}
									}
									span class="webview_android yes" {
										span {
											- "WebView Android"
										}
										span {
											- "37+"
										}
									}
									span class="samsunginternet_android unknown" {
										span {
											- "Samsung Internet"
										}
										span {
											- "?"
										}
									}
									span class="opera_android yes" {
										span {
											- "Opera Android"
										}
										span {
											- "11+"
										}
									}
								}
							}
						}
					}
					td {
						- " "
						code id="shared-workers-and-the-sharedworkerglobalscope-interface:event-workerglobalscope-connect-2" {
							a href="#event-workerglobalscope-connect" {
								- "connect"
							}
						}
						- "\n  "
					}
				}
			}
		}
		- "\n\n\n\n  "
		h4 id="worker-event-loop" {
			span class="secno" {
				- "10.2.2"
			}
			- " The event loop"
			a href="#worker-event-loop" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			a href="#worker-event-loop-2" id="worker-event-loop:worker-event-loop-2" {
				- "worker event loop"
			}
			- "'s "
			a href="#task-queue" id="worker-event-loop:task-queue" {
				- "task queues"
			}
			- " only have\n  events, callbacks, and networking activity as "
			a href="#concept-task" id="worker-event-loop:concept-task" {
				- "tasks"
			}
			- ". These "
			a href="#worker-event-loop-2" id="worker-event-loop:worker-event-loop-2-2" {
				- "worker event loops"
			}
			- " are created by the\n  "
			a href="#run-a-worker" id="worker-event-loop:run-a-worker" {
				- "run a worker"
			}
			- " algorithm."
		}
		- "\n\n  "
		p {
			- "Each "
			code id="worker-event-loop:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object has a "
			dfn data-dfn-for="WorkerGlobalScope" id="dom-workerglobalscope-closing" data-export="" {
				- "closing"
			}
			- " flag, which must be initially\n  false, but which can get set to true by the algorithms in the processing model\n  section below."
		}
		- "\n\n  "
		p {
			- "Once the "
			code id="worker-event-loop:workerglobalscope-2" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- "'s "
			a href="#dom-workerglobalscope-closing" id="worker-event-loop:dom-workerglobalscope-closing" {
				- "closing"
			}
			- " flag is set to true, the "
			a href="#event-loop" id="worker-event-loop:event-loop" {
				- "event\n  loop"
			}
			- "'s "
			a href="#task-queue" id="worker-event-loop:task-queue-2" {
				- "task queues"
			}
			- " must discard any\n  further "
			a href="#concept-task" id="worker-event-loop:concept-task-2" {
				- "tasks"
			}
			- " that would be added to them (tasks already on the\n  queue are unaffected except where otherwise specified). Effectively, once the "
			a href="#dom-workerglobalscope-closing" id="worker-event-loop:dom-workerglobalscope-closing-2" {
				- "closing"
			}
			- " flag is true, timers stop firing,\n  notifications for all pending background operations are dropped, etc."
		}
		- "\n\n\n\n  \n\n  "
		h4 id="the-worker's-lifetime" {
			span class="secno" {
				- "10.2.3"
			}
			- " The worker's lifetime"
			a href="#the-worker's-lifetime" class="self-link"
		}
		- "\n\n  "
		p {
			- "Workers communicate with other workers and with "
			code id="the-worker's-lifetime:window" {
				a href="#window" {
					- "Window"
				}
			}
			- "s through "
			a href="#channel-messaging" id="the-worker's-lifetime:channel-messaging" {
				- "message channels"
			}
			- " and their "
			code id="the-worker's-lifetime:messageport" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- "\n  objects."
		}
		- "\n\n  "
		p {
			- "Each "
			code id="the-worker's-lifetime:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object "
			var {
				- "worker global scope"
			}
			- " has a list of\n  "
			dfn id="the-worker's-ports" data-export="" {
				- "the worker's ports"
			}
			- ", which consists of all the "
			code id="the-worker's-lifetime:messageport-2" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " objects\n  that are entangled with another port and that have one (but only one) port owned by "
			var {
				- "worker\n  global scope"
			}
			- ". This list includes the implicit "
			code id="the-worker's-lifetime:messageport-3" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " in the case of "
			a href="#dedicatedworkerglobalscope" id="the-worker's-lifetime:dedicatedworkerglobalscope" {
				- "dedicated workers"
			}
			- "."
		}
		- "\n\n  "
		p id="list-of-relevant-document-objects-to-add" {
			- "Given an "
			a href="#environment-settings-object" id="the-worker's-lifetime:environment-settings-object" {
				- "environment settings\n  object"
			}
			- " "
			var {
				- "o"
			}
			- " when creating or obtaining a worker, the "
			dfn id="relevant-owner-to-add" {
				- "relevant owner to\n  add"
			}
			- " depends on the type of "
			a href="#concept-settings-object-global" id="the-worker's-lifetime:concept-settings-object-global" {
				- "global\n  object"
			}
			- " specified by "
			var {
				- "o"
			}
			- ". If "
			var {
				- "o"
			}
			- "'s "
			a href="#concept-settings-object-global" id="the-worker's-lifetime:concept-settings-object-global-2" {
				- "global object"
			}
			- " is a "
			code id="the-worker's-lifetime:workerglobalscope-2" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- "\n  object (i.e., if we are creating a nested dedicated worker), then the relevant owner is that\n  global object. Otherwise, "
			var {
				- "o"
			}
			- "'s "
			a href="#concept-settings-object-global" id="the-worker's-lifetime:concept-settings-object-global-3" {
				- "global\n  object"
			}
			- " is a "
			code id="the-worker's-lifetime:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " object, and the relevant owner is that\n  "
			code id="the-worker's-lifetime:window-3" {
				a href="#window" {
					- "Window"
				}
			}
			- "'s "
			a href="#concept-document-window" id="the-worker's-lifetime:concept-document-window" {
				- "associated\n  "
				code {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A worker is said to be a "
			dfn id="permissible-worker" {
				- "permissible worker"
			}
			- " if its "
			code id="the-worker's-lifetime:workerglobalscope-3" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- "'s\n  "
			a href="#concept-WorkerGlobalScope-owner-set" id="the-worker's-lifetime:concept-WorkerGlobalScope-owner-set" {
				- "owner set"
			}
			- " is not "
			a href="https://infra.spec.whatwg.org/#list-is-empty" id="the-worker's-lifetime:list-is-empty" data-x-internal="list-is-empty" {
				- "empty"
			}
			- " or:"
		}
		- "\n\n  "
		ul class="brief" {
			li {
				- "its "
				a href="#concept-WorkerGlobalScope-owner-set" id="the-worker's-lifetime:concept-WorkerGlobalScope-owner-set-2" {
					- "owner set"
				}
				- " has been "
				a href="https://infra.spec.whatwg.org/#list-is-empty" id="the-worker's-lifetime:list-is-empty-2" data-x-internal="list-is-empty" {
					- "empty"
				}
				- " for no more\n   than a short "
				a id="the-worker's-lifetime:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
					- "implementation-defined"
				}
				- " timeout value,"
			}
			li {
				- "its "
				code id="the-worker's-lifetime:workerglobalscope-4" {
					a href="#workerglobalscope" {
						- "WorkerGlobalScope"
					}
				}
				- " object is a "
				code id="the-worker's-lifetime:sharedworkerglobalscope" {
					a href="#sharedworkerglobalscope" {
						- "SharedWorkerGlobalScope"
					}
				}
				- " object\n   (i.e., the worker is a shared worker), and"
			}
			li {
				- "the user agent has a "
				a href="#navigable" id="the-worker's-lifetime:navigable" {
					- "navigable"
				}
				- " whose "
				a href="#nav-document" id="the-worker's-lifetime:nav-document" {
					- "active\n   document"
				}
				- " is not "
				a href="#completely-loaded" id="the-worker's-lifetime:completely-loaded" {
					- "completely loaded"
				}
				- "."
			}
		}
		- "\n\n  "
		p class="note" {
			- "The second part of this definition allows a shared worker to survive for a short\n  time while a page is loading, in case that page is going to contact the shared worker again. This\n  can be used by user agents as a way to avoid the cost of restarting a shared worker used by a site\n  when the user is navigating from page to page within that site."
		}
		- "\n\n  "
		p {
			- "A worker is said to be an "
			dfn id="active-needed-worker" {
				- "active needed worker"
			}
			- " if any of its "
			a href="#concept-WorkerGlobalScope-owner-set" id="the-worker's-lifetime:concept-WorkerGlobalScope-owner-set-3" {
				- "owners"
			}
			- " are either "
			code id="the-worker's-lifetime:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " objects that are "
			a href="#fully-active" id="the-worker's-lifetime:fully-active" {
				- "fully active"
			}
			- " or\n  "
			a href="#active-needed-worker" id="the-worker's-lifetime:active-needed-worker" {
				- "active needed workers"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A worker is said to be a "
			dfn id="protected-worker" {
				- "protected worker"
			}
			- " if it is an "
			a href="#active-needed-worker" id="the-worker's-lifetime:active-needed-worker-2" {
				- "active needed\n  worker"
			}
			- " and either it has outstanding timers, database transactions, or network connections,\n  or its list of "
			a href="#the-worker's-ports" id="the-worker's-lifetime:the-worker's-ports" {
				- "the worker's ports"
			}
			- " is not empty, or its "
			code id="the-worker's-lifetime:workerglobalscope-5" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- "\n  is actually a "
			code id="the-worker's-lifetime:sharedworkerglobalscope-2" {
				a href="#sharedworkerglobalscope" {
					- "SharedWorkerGlobalScope"
				}
			}
			- " object (i.e., the worker is a shared\n  worker)."
		}
		- "\n\n  "
		p {
			- "A worker is said to be a "
			dfn id="suspendable-worker" {
				- "suspendable worker"
			}
			- " if it is not an "
			a href="#active-needed-worker" id="the-worker's-lifetime:active-needed-worker-3" {
				- "active needed\n  worker"
			}
			- " but it is a "
			a href="#permissible-worker" id="the-worker's-lifetime:permissible-worker" {
				- "permissible worker"
			}
			- "."
		}
		- "\n\n\n  "
		h4 id="worker-processing-model" {
			span class="secno" {
				- "10.2.4"
			}
			- " "
			span id="processing-model-10"
			- "Processing model"
			a href="#worker-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="run-a-worker" data-export="" {
				- "run a worker"
			}
			- " for a script with "
			code id="worker-processing-model:worker" {
				a href="#worker" {
					- "Worker"
				}
			}
			- " or\n  "
			code id="worker-processing-model:sharedworker" {
				a href="#sharedworker" {
					- "SharedWorker"
				}
			}
			- " object "
			var {
				- "worker"
			}
			- ", "
			a id="worker-processing-model:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " "
			var {
				- "url"
			}
			- ",\n  "
			a href="#environment-settings-object" id="worker-processing-model:environment-settings-object" {
				- "environment settings object"
			}
			- " "
			var {
				- "outside settings"
			}
			- ", "
			code id="worker-processing-model:messageport" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- "\n  "
			var {
				- "outside port"
			}
			- ", and a "
			code id="worker-processing-model:workeroptions" {
				a href="#workeroptions" {
					- "WorkerOptions"
				}
			}
			- " dictionary "
			var {
				- "options"
			}
			- ", it must\n  run the following steps."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "is shared"
					}
					- " be true if "
					var {
						- "worker"
					}
					- " is a "
					code id="worker-processing-model:sharedworker-2" {
						a href="#sharedworker" {
							- "SharedWorker"
						}
					}
					- "\n   object, and false otherwise."
