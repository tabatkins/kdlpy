			a href="#text-track-in-band-metadata-track-dispatch-type" id="text-track-api:text-track-in-band-metadata-track-dispatch-type-2" {
				- "text track in-band metadata track dispatch type"
			}
			- " of the\n  "
			a href="#text-track" id="text-track-api:text-track-16" {
				- "text track"
			}
			- " that the "
			code id="text-track-api:texttrack-15" {
				a href="#texttrack" {
					- "TextTrack"
				}
			}
			- " object represents."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="TextTrack" id="dom-texttrack-mode" data-dfn-type="attribute" {
				code {
					- "mode"
				}
			}
			- "\n  attribute, on getting, must return the string corresponding to the "
			a href="#text-track-mode" id="text-track-api:text-track-mode-3" {
				- "text track mode"
			}
			- " of\n  the "
			a href="#text-track" id="text-track-api:text-track-17" {
				- "text track"
			}
			- " that the "
			code id="text-track-api:texttrack-16" {
				a href="#texttrack" {
					- "TextTrack"
				}
			}
			- " object represents, as defined by the\n  following list:"
