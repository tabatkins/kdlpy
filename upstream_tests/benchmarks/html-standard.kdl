									}
									- " is a "
									a id="structuredserializewithtransfer:platform-object" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
										- "platform object"
									}
									- " that is\n       a "
									a href="#transferable-objects" id="structuredserializewithtransfer:transferable-objects" {
										- "transferable object"
									}
									- "."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "interfaceName"
									}
									- " be the identifier of the "
									a id="structuredserializewithtransfer:primary-interface" href="https://webidl.spec.whatwg.org/#dfn-primary-interface" data-x-internal="primary-interface" {
										- "primary interface"
									}
									- "\n       of "
									var {
										- "transferable"
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									var {
										- "dataHolder"
									}
									- ".[[Type]] to "
									var {
										- "interfaceName"
									}
									- "."
								}
							}
							li {
								p {
									- "Perform the appropriate "
									a href="#transfer-steps" id="structuredserializewithtransfer:transfer-steps" {
										- "transfer steps"
									}
									- " for the interface identified by\n       "
									var {
										- "interfaceName"
									}
									- ", given "
									var {
										- "transferable"
									}
									- " and "
									var {
										- "dataHolder"
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									var {
										- "transferable"
									}
									- "."
									a href="#detached" id="structuredserializewithtransfer:detached-4" {
										- "[[Detached]]"
									}
									- " to true."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-append" id="structuredserializewithtransfer:list-append" data-x-internal="list-append" {
								- "Append"
							}
							- " "
							var {
								- "dataHolder"
							}
							- " to\n     "
							var {
								- "transferDataHolders"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return { [[Serialized]]: "
					var {
						- "serialized"
					}
					- ", [[TransferDataHolders]]:\n   "
					var {
						- "transferDataHolders"
					}
					- " }."
				}
			}
		}
		- "\n\n  "
		h4 id="structureddeserializewithtransfer" data-dfn-type="abstract-op" data-lt="StructuredDeserializeWithTransfer" {
			span class="secno" {
				- "2.7.8"
			}
			- " "
			dfn {
				- "StructuredDeserializeWithTransfer"
			}
			- " ( "
			var {
				- "serializeWithTransferResult"
			}
			- ",\n  "
			var {
				- "targetRealm"
			}
			- " )"
			a href="#structureddeserializewithtransfer" class="self-link"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "memory"
					}
					- " be an empty "
					a href="https://infra.spec.whatwg.org/#ordered-map" id="structureddeserializewithtransfer:ordered-map" data-x-internal="ordered-map" {
						- "map"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "Analogous to "
					a href="#structuredserializewithtransfer" id="structureddeserializewithtransfer:structuredserializewithtransfer" {
						- "StructuredSerializeWithTransfer"
					}
					- ", in addition to how it\n    is used normally by "
					a href="#structureddeserialize" id="structureddeserializewithtransfer:structureddeserialize" {
						- "StructuredDeserialize"
					}
					- ", in this algorithm "
					var {
						- "memory"
					}
					- " is\n    also used to ensure that "
					a href="#structureddeserialize" id="structureddeserializewithtransfer:structureddeserialize-2" {
						- "StructuredDeserialize"
					}
					- " ignores items in\n    "
					var {
						- "serializeWithTransferResult"
					}
					- ".[[TransferDataHolders]], and let us do our own handling\n    instead."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "transferredValues"
					}
					- " be a new empty "
					a href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" id="structureddeserializewithtransfer:js-list" data-x-internal="js-list" {
						- "List"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="structureddeserializewithtransfer:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "transferDataHolder"
					}
					- " of\n    "
					var {
						- "serializeWithTransferResult"
					}
					- ".[[TransferDataHolders]]:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "value"
							}
							- " be an uninitialized value."
						}
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "transferDataHolder"
							}
							- ".[[Type]] is \"ArrayBuffer\", then set "
							var {
								- "value"
							}
							- " to a\n      new ArrayBuffer object in "
							var {
								- "targetRealm"
							}
							- " whose [[ArrayBufferData]] internal slot value\n      is "
							var {
								- "transferDataHolder"
							}
							- ".[[ArrayBufferData]], and whose [[ArrayBufferByteLength]]\n      internal slot value is "
							var {
								- "transferDataHolder"
							}
							- ".[[ArrayBufferByteLength]]."
						}
						- "\n\n      "
						p class="note" {
							- "In cases where the original memory occupied by [[ArrayBufferData]] is\n      accessible during the deserialization, this step is unlikely to throw an exception, as no new\n      memory needs to be allocated: the memory occupied by [[ArrayBufferData]] is instead just\n      getting transferred into the new ArrayBuffer. This could be true, for example, when both the\n      source and target realms are in the same process."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Otherwise, if "
							var {
								- "transferDataHolder"
							}
							- ".[[Type]] is \"ResizableArrayBuffer\", then set\n      "
							var {
								- "value"
							}
							- " to a new ArrayBuffer object in "
							var {
								- "targetRealm"
							}
							- " whose\n      [[ArrayBufferData]] internal slot value is "
							var {
								- "transferDataHolder"
							}
							- ".[[ArrayBufferData]],\n      whose [[ArrayBufferByteLength]] internal slot value is\n      "
							var {
								- "transferDataHolder"
							}
							- ".[[ArrayBufferByteLength]], and whose\n      [[ArrayBufferMaxByteLength]] internal slot value is\n      "
							var {
								- "transferDataHolder"
							}
							- ".[[ArrayBufferMaxByteLength]]."
						}
						- "\n\n      "
						p class="note" {
							- "For the same reason as the previous step, this step is also unlikely to throw\n      an exception."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Otherwise:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "interfaceName"
									}
									- " be "
									var {
										- "transferDataHolder"
									}
									- ".[[Type]]."
								}
							}
							li {
								p {
									- "If the interface identified by "
									var {
										- "interfaceName"
									}
									- " is not exposed in\n       "
									var {
										- "targetRealm"
									}
									- ", then throw a "
									a id="structureddeserializewithtransfer:datacloneerror" href="https://webidl.spec.whatwg.org/#datacloneerror" data-x-internal="datacloneerror" {
										- "\""
										code {
											- "DataCloneError"
										}
										- "\""
									}
									- "\n       "
									code id="structureddeserializewithtransfer:domexception" {
										a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
											- "DOMException"
										}
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									var {
										- "value"
									}
									- " to a new instance of the interface identified by\n       "
									var {
										- "interfaceName"
									}
									- ", created in "
									var {
										- "targetRealm"
									}
									- "."
								}
							}
							li {
								p {
									- "Perform the appropriate "
									a href="#transfer-receiving-steps" id="structureddeserializewithtransfer:transfer-receiving-steps" {
										- "transfer-receiving steps"
									}
									- " for the interface\n       identified by "
									var {
										- "interfaceName"
									}
									- " given "
									var {
										- "transferDataHolder"
									}
									- " and\n       "
									var {
										- "value"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#map-set" id="structureddeserializewithtransfer:map-set" data-x-internal="map-set" {
								- "Set"
							}
							- " "
							var {
								- "memory"
							}
							- "["
							var {
								- "transferDataHolder"
							}
							- "] to\n     "
							var {
								- "value"
							}
							- "."
						}
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-append" id="structureddeserializewithtransfer:list-append" data-x-internal="list-append" {
								- "Append"
							}
							- " "
							var {
								- "value"
							}
							- " to\n     "
							var {
								- "transferredValues"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "deserialized"
					}
					- " be ?\n   "
					a href="#structureddeserialize" id="structureddeserializewithtransfer:structureddeserialize-3" {
						- "StructuredDeserialize"
					}
					- "("
					var {
						- "serializeWithTransferResult"
					}
					- ".[[Serialized]],\n   "
					var {
						- "targetRealm"
					}
					- ", "
					var {
						- "memory"
					}
					- ")."
				}
			}
			li {
				p {
					- "Return { [[Deserialized]]: "
					var {
						- "deserialized"
					}
					- ", [[TransferredValues]]:\n   "
					var {
						- "transferredValues"
					}
					- " }."
				}
			}
		}
		- "\n\n\n  "
		h4 id="performing-structured-clones-from-other-specifications" {
			span class="secno" {
				- "2.7.9"
			}
			- " Performing serialization and\n  transferring from other specifications"
			a href="#performing-structured-clones-from-other-specifications" class="self-link"
		}
		- "\n\n  "
		p {
			- "Other specifications may use the abstract operations defined here. The following provides\n  some guidance on when each abstract operation is typically useful, with examples."
		}
		- "\n\n  "
		dl {
			dt {
				a href="#structuredserializewithtransfer" id="performing-structured-clones-from-other-specifications:structuredserializewithtransfer" {
					- "StructuredSerializeWithTransfer"
				}
			}
			dt {
				a href="#structureddeserializewithtransfer" id="performing-structured-clones-from-other-specifications:structureddeserializewithtransfer" {
					- "StructuredDeserializeWithTransfer"
				}
			}
			dd {
				- "\n    "
				p {
					- "Cloning a value to another "
					a id="performing-structured-clones-from-other-specifications:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- ", with a transfer list, but where the target\n    realm is not known ahead of time. In this case the serialization step can be performed\n    immediately, with the deserialization step delayed until the target realm becomes known."
				}
				- "\n\n    "
				p class="example" {
					code id="performing-structured-clones-from-other-specifications:dom-messageport-postmessage" {
						a href="#dom-messageport-postmessage" {
							- "messagePort.postMessage()"
						}
					}
					- "\n    uses this pair of abstract operations, as the destination realm is not known until the\n    "
					code id="performing-structured-clones-from-other-specifications:messageport" {
						a href="#messageport" {
							- "MessagePort"
						}
					}
					- " "
					a href="#has-been-shipped" id="performing-structured-clones-from-other-specifications:has-been-shipped" {
						- "has been shipped"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				a href="#structuredserialize" id="performing-structured-clones-from-other-specifications:structuredserialize" {
					- "StructuredSerialize"
				}
			}
			dt {
				a href="#structuredserializeforstorage" id="performing-structured-clones-from-other-specifications:structuredserializeforstorage" {
					- "StructuredSerializeForStorage"
				}
			}
			dt {
				a href="#structureddeserialize" id="performing-structured-clones-from-other-specifications:structureddeserialize" {
					- "StructuredDeserialize"
				}
			}
			dd {
				- "\n    "
				p {
					- "Creating a "
					a id="performing-structured-clones-from-other-specifications:realm-2" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- "-independent snapshot of a given value which can be saved for an\n    indefinite amount of time, and then reified back into a JavaScript value later, possibly\n    multiple times."
				}
				- "\n\n    "
				p {
					a href="#structuredserializeforstorage" id="performing-structured-clones-from-other-specifications:structuredserializeforstorage-2" {
						- "StructuredSerializeForStorage"
					}
					- " can be used for situations where the serialization\n    is anticipated to be stored in a persistent manner, instead of passed between realms. It throws\n    when attempting to serialize "
					code id="performing-structured-clones-from-other-specifications:sharedarraybuffer" {
						a data-x-internal="sharedarraybuffer" href="https://tc39.es/ecma262/#sec-sharedarraybuffer-objects" {
							- "SharedArrayBuffer"
						}
					}
					- " objects, since storing shared memory\n    does not make sense. Similarly, it can throw or possibly have different behavior when given a\n    "
					a id="performing-structured-clones-from-other-specifications:platform-object" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
						- "platform object"
					}
					- " with custom "
					a href="#serialization-steps" id="performing-structured-clones-from-other-specifications:serialization-steps" {
						- "serialization steps"
					}
					- " when the\n    "
					var {
						- "forStorage"
					}
					- " argument is true."
				}
				- "\n\n    "
				p class="example" {
					code id="performing-structured-clones-from-other-specifications:dom-history-pushstate" {
						a href="#dom-history-pushstate" {
							- "history.pushState()"
						}
					}
					- " and "
					code id="performing-structured-clones-from-other-specifications:dom-history-replacestate" {
						a href="#dom-history-replacestate" {
							- "history.replaceState()"
						}
					}
					- " use\n    "
					a href="#structuredserializeforstorage" id="performing-structured-clones-from-other-specifications:structuredserializeforstorage-3" {
						- "StructuredSerializeForStorage"
					}
					- " on author-supplied state objects, storing them as\n    "
					a href="#serialized-state" id="performing-structured-clones-from-other-specifications:serialized-state" {
						- "serialized state"
					}
					- " in the appropriate "
					a href="#session-history-entry" id="performing-structured-clones-from-other-specifications:session-history-entry" {
						- "session history entry"
					}
					- ". Then,\n    "
					a href="#structureddeserialize" id="performing-structured-clones-from-other-specifications:structureddeserialize-2" {
						- "StructuredDeserialize"
					}
					- " is used so that the "
					code id="performing-structured-clones-from-other-specifications:dom-history-state" {
						a href="#dom-history-state" {
							- "history.state"
						}
					}
					- " property can return a clone of the\n    originally-supplied state object."
				}
				- "\n\n    "
				p class="example" {
					code id="performing-structured-clones-from-other-specifications:dom-broadcastchannel-postmessage" {
						a href="#dom-broadcastchannel-postmessage" {
							- "broadcastChannel.postMessage()"
						}
					}
					- " uses\n    "
					a href="#structuredserialize" id="performing-structured-clones-from-other-specifications:structuredserialize-2" {
						- "StructuredSerialize"
					}
					- " on its input, then uses "
					a href="#structureddeserialize" id="performing-structured-clones-from-other-specifications:structureddeserialize-3" {
						- "StructuredDeserialize"
					}
					- "\n    multiple times on the result to produce a fresh clone for each destination being broadcast\n    to. Note that transferring does not make sense in multi-destination situations."
				}
				- "\n\n    "
				p class="example" {
					- "Any API for persisting JavaScript values to the filesystem would also use\n    "
					a href="#structuredserializeforstorage" id="performing-structured-clones-from-other-specifications:structuredserializeforstorage-4" {
						- "StructuredSerializeForStorage"
					}
					- " on its input and "
					a href="#structureddeserialize" id="performing-structured-clones-from-other-specifications:structureddeserialize-4" {
						- "StructuredDeserialize"
					}
					- "\n    on its output."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "In general, call sites may pass in Web IDL values instead of JavaScript values; this is to be\n  understood to perform an implicit "
			a href="https://webidl.spec.whatwg.org/#es-type-mapping" id="performing-structured-clones-from-other-specifications:concept-idl-convert" data-x-internal="concept-idl-convert" {
				- "conversion"
			}
			- " to the\n  JavaScript value before invoking these algorithms."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Call sites that are not invoked as a result of author code synchronously calling into a user\n  agent method must take care to properly "
			a href="#prepare-to-run-script" id="performing-structured-clones-from-other-specifications:prepare-to-run-script" {
				- "prepare to run script"
			}
			- " and "
			a href="#prepare-to-run-a-callback" id="performing-structured-clones-from-other-specifications:prepare-to-run-a-callback" {
				- "prepare to\n  run a callback"
			}
			- " before invoking "
			a href="#structuredserialize" id="performing-structured-clones-from-other-specifications:structuredserialize-3" {
				- "StructuredSerialize"
			}
			- ",\n  "
			a href="#structuredserializeforstorage" id="performing-structured-clones-from-other-specifications:structuredserializeforstorage-5" {
				- "StructuredSerializeForStorage"
			}
			- ", or "
			a href="#structuredserializewithtransfer" id="performing-structured-clones-from-other-specifications:structuredserializewithtransfer-2" {
				- "StructuredSerializeWithTransfer"
			}
			- "\n  abstract operations, if they are being performed on arbitrary objects. This is necessary because\n  the serialization process can invoke author-defined accessors as part of its final\n  deep-serialization steps, and these accessors could call into operations that rely on the "
			a href="#concept-entry-everything" id="performing-structured-clones-from-other-specifications:concept-entry-everything" {
				- "entry"
			}
			- " and "
			a href="#concept-incumbent-everything" id="performing-structured-clones-from-other-specifications:concept-incumbent-everything" {
				- "incumbent"
			}
			- " concepts being properly set up."
		}
		- "\n\n  "
		p class="example" {
			code id="performing-structured-clones-from-other-specifications:dom-window-postmessage" {
				a href="#dom-window-postmessage" {
					- "window.postMessage()"
				}
			}
			- " performs\n  "
			a href="#structuredserializewithtransfer" id="performing-structured-clones-from-other-specifications:structuredserializewithtransfer-3" {
				- "StructuredSerializeWithTransfer"
			}
			- " on its arguments, but is careful to do so\n  immediately, inside the synchronous portion of its algorithm. Thus it is able to use the\n  algorithms without needing to "
			a href="#prepare-to-run-script" id="performing-structured-clones-from-other-specifications:prepare-to-run-script-2" {
				- "prepare to run script"
			}
			- " and "
			a href="#prepare-to-run-a-callback" id="performing-structured-clones-from-other-specifications:prepare-to-run-a-callback-2" {
				- "prepare to run a\n  callback"
			}
			- "."
		}
		- "\n\n  "
		p class="example" {
			- "In contrast, a hypothetical API that used "
			a href="#structuredserialize" id="performing-structured-clones-from-other-specifications:structuredserialize-4" {
				- "StructuredSerialize"
			}
			- " to\n  serialize some author-supplied object periodically, directly from a "
			a href="#concept-task" id="performing-structured-clones-from-other-specifications:concept-task" {
				- "task"
			}
			- " on the "
			a href="#event-loop" id="performing-structured-clones-from-other-specifications:event-loop" {
				- "event loop"
			}
			- ", would need to ensure it performs\n  the appropriate preparations beforehand. As of this time, we know of no such APIs on the platform;\n  usually it is simpler to perform the serialization ahead of time, as a synchronous consequence of\n  author code."
		}
		- "\n\n  \n\n  "
		h4 id="structured-cloning" {
			span class="secno" {
				- "2.7.10"
			}
			- " Structured cloning API"
			a href="#structured-cloning" class="self-link"
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "result"
					}
					- " = self."
