			}
			- "\n\n   "
			p {
				- "When the user submits the form, the user agent includes three fields, one called \"comment\",\n   one called \"comment.dir\", and one called \"mode\"; so if the user types \"Hello\", the submission\n   body might be something like:"
			}
			- "\n\n   "
			pre {
				- "comment=Hello&"
				strong {
