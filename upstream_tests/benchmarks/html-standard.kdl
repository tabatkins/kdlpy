							li {
								p {
									a id="the-popover-attribute:assert-16" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
										- "Assert"
									}
									- ": "
									var {
										- "candidateAncestor"
									}
									- "'s "
									code id="the-popover-attribute:attr-popover-21" {
										a href="#attr-popover" {
											- "popover"
										}
									}
									- " attribute is not in the "
									a href="#attr-popover-manual-state" id="the-popover-attribute:attr-popover-manual-state-3" {
										- "manual"
									}
									- " or "
									a href="#attr-popover-none-state" id="the-popover-attribute:attr-popover-none-state-3" {
										- "none"
									}
									- " state."
								}
							}
							li {
								p {
									- "Set "
