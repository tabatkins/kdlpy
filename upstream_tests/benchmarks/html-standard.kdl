		- "\n\n\n  "
		h5 id="inline-documentation-for-external-scripts" {
			span class="secno" {
				- "4.12.1.4"
			}
			- " "
			dfn {
				- "Inline documentation for external scripts"
			}
			a href="#inline-documentation-for-external-scripts" class="self-link"
		}
		- "\n\n  "
		p {
			- "If a "
			code id="inline-documentation-for-external-scripts:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element's "
			code id="inline-documentation-for-external-scripts:attr-script-src" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- " attribute is\n  specified, then the contents of the "
			code id="inline-documentation-for-external-scripts:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element, if any, must be such that the\n  value of the "
			code id="inline-documentation-for-external-scripts:dom-script-text" {
				a href="#dom-script-text" {
					- "text"
				}
			}
			- " IDL attribute, which is derived from the\n  element's contents, matches the "
			code {
				- "documentation"
			}
			- " production in the following\n  ABNF, the character set for which is Unicode. "
			a href="#refsABNF" {
				- "[ABNF]"
			}
		}
