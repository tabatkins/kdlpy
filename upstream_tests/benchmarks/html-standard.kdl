							- "."
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "For historical reasons, unlike other standard metadata names, the processing\n    model for "
					code id="standard-metadata-names:meta-referrer-2" {
						a href="#meta-referrer" {
							- "referrer"
						}
					}
					- " is not responsive to element removals,\n    and does not use "
					a id="standard-metadata-names:tree-order-2" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
						- "tree order"
					}
					- ". Only the most-recently-inserted or\n    most-recently-modified "
					code id="standard-metadata-names:the-meta-element-10" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element in this state has an effect."
				}
				- "\n\n    \n   "
			}
			dt {
				dfn data-dfn-for="meta/name" id="meta-theme-color" data-dfn-type="attr-value" {
					code {
						- "theme-color"
					}
				}
				div class="mdn-anno wrapped before" {
