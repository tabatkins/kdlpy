					}
					li {
						p {
							- "Set "
							var {
								- "targetStep"
							}
							- " to "
							var {
								- "traversable"
							}
							- "'s "
							a href="#tn-current-session-history-step" id="scroll-to-fragid:tn-current-session-history-step-2" {
								- "current session history step"
							}
							- " + 1."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "targetEntry"
							}
							- "'s "
							a href="#she-step" id="scroll-to-fragid:she-step" {
								- "step"
							}
							- " to\n     "
							var {
								- "targetStep"
							}
							- "."
						}
					}
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-append" id="scroll-to-fragid:list-append" data-x-internal="list-append" {
								- "Append"
							}
							- " "
							var {
								- "targetEntry"
							}
							- " to\n     "
							var {
								- "targetEntries"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="https://infra.spec.whatwg.org/#list-replace" id="scroll-to-fragid:list-replace" data-x-internal="list-replace" {
								- "Replace"
							}
							- " "
							var {
								- "entryToReplace"
							}
							- " with\n     "
							var {
								- "targetEntry"
							}
							- " in "
							var {
								- "targetEntries"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "targetEntry"
							}
							- "'s "
							a href="#she-step" id="scroll-to-fragid:she-step-2" {
								- "step"
							}
							- " to\n     "
							var {
								- "entryToReplace"
							}
							- "'s "
							a href="#she-step" id="scroll-to-fragid:she-step-3" {
								- "step"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "targetStep"
							}
							- " to "
							var {
								- "traversable"
							}
							- "'s "
							a href="#tn-current-session-history-step" id="scroll-to-fragid:tn-current-session-history-step-3" {
								- "current session history step"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					a href="#apply-the-push/replace-history-step" id="scroll-to-fragid:apply-the-push/replace-history-step" {
						- "Apply the push/replace history step"
					}
					- " "
					var {
						- "targetStep"
					}
					- " to\n    "
					var {
						- "traversable"
					}
					- " given "
					var {
						- "historyHandling"
					}
					- " and "
					var {
						- "userInvolvement"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This is done even for \""
					code id="scroll-to-fragid:navigationhistorybehavior-replace-2" {
						a href="#navigationhistorybehavior-replace" {
							- "replace"
						}
					}
					- "\" navigations, as it resolves race\n    conditions across multiple synchronous navigations."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="non-fetch-schemes-and-external-software" {
			span class="secno" {
				- "7.4.2.3.4"
			}
			- " Non-fetch schemes and external software"
			a href="#non-fetch-schemes-and-external-software" class="self-link"
		}
		- "\n\n  "
		p {
			- "The input to "
			a href="#attempt-to-create-a-non-fetch-scheme-document" id="non-fetch-schemes-and-external-software:attempt-to-create-a-non-fetch-scheme-document" {
				- "attempt to create a non-fetch scheme document"
			}
			- " is the "
			dfn id="non-fetch-scheme-navigation-params" {
				- "non-fetch\n  scheme navigation params"
			}
			- " "
			a id="non-fetch-schemes-and-external-software:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- ". It is a lightweight version of\n  "
			a href="#navigation-params" id="non-fetch-schemes-and-external-software:navigation-params" {
				- "navigation params"
			}
			- " which only carries parameters relevant to the non-"
			a id="non-fetch-schemes-and-external-software:fetch-scheme" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
				- "fetch\n  scheme"
			}
			- " navigation case. It has the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="non-fetch-schemes-and-external-software:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  \n  "
		dl {
			dt {
				dfn id="non-fetch-scheme-params-id" {
					- "id"
				}
			}
			dd {
				- "null or a "
				a href="#navigation-id" id="non-fetch-schemes-and-external-software:navigation-id" {
					- "navigation ID"
				}
			}
			dt {
				dfn id="non-fetch-scheme-params-navigable" {
					- "navigable"
				}
			}
			dd {
				- "the "
				a href="#navigable" id="non-fetch-schemes-and-external-software:navigable" {
					- "navigable"
				}
				- " experiencing the navigation"
			}
			dt {
				dfn id="non-fetch-scheme-params-url" {
					- "URL"
				}
			}
			dd {
				- "a "
				a id="non-fetch-schemes-and-external-software:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
					- "URL"
				}
			}
			dt {
				dfn id="non-fetch-scheme-params-target-sandbox" {
					- "target snapshot sandboxing flags"
				}
			}
			dd {
				- "the "
				a href="#target-snapshot-params" id="non-fetch-schemes-and-external-software:target-snapshot-params" {
					- "target snapshot params"
				}
				- "'s "
				a href="#target-snapshot-params-sandbox" id="non-fetch-schemes-and-external-software:target-snapshot-params-sandbox" {
					- "sandboxing flags"
				}
				- " present during navigation"
			}
			dt {
				dfn id="non-fetch-scheme-params-source-activation" {
					- "source snapshot has transient activation"
				}
			}
			dd {
				- "a copy of the "
				a href="#source-snapshot-params" id="non-fetch-schemes-and-external-software:source-snapshot-params" {
					- "source snapshot params"
				}
				- "'s "
				a href="#source-snapshot-params-activation" id="non-fetch-schemes-and-external-software:source-snapshot-params-activation" {
					- "has transient activation"
				}
				- " boolean present during\n   activation"
			}
			dt {
				dfn id="non-fetch-scheme-params-initiator-origin" {
					- "initiator origin"
				}
			}
			dd {
				- "\n    "
				p {
					- "an "
					a href="#concept-origin" id="non-fetch-schemes-and-external-software:concept-origin" {
						- "origin"
					}
					- " possibly for use in a user-facing prompt to confirm the invocation of\n    an external software package"
				}
				- "\n    "
				p class="note" {
					- "This differs slightly from a "
					a href="#she-document-state" id="non-fetch-schemes-and-external-software:she-document-state" {
						- "document\n    state"
					}
					- "'s "
					a href="#document-state-initiator-origin" id="non-fetch-schemes-and-external-software:document-state-initiator-origin" {
						- "initiator origin"
					}
					- " in that a\n    "
					a href="#non-fetch-scheme-navigation-params" id="non-fetch-schemes-and-external-software:non-fetch-scheme-navigation-params" {
						- "non-fetch scheme navigation params"
					}
					- "'s "
					a href="#non-fetch-scheme-params-initiator-origin" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-initiator-origin" {
						- "initiator origin"
					}
					- " follows redirects up\n    to the last "
					a id="non-fetch-schemes-and-external-software:fetch-scheme-2" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
						- "fetch scheme"
					}
					- " URL in a redirect chain that ends in a non-"
					a id="non-fetch-schemes-and-external-software:fetch-scheme-3" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
						- "fetch\n    scheme"
					}
					- " URL."
				}
				- "\n   "
			}
			dt {
				dfn id="non-fetch-scheme-params-nav-timing-type" {
					- "navigation timing type"
				}
			}
			dd {
				- "a "
				code id="non-fetch-schemes-and-external-software:navigationtimingtype" {
					a data-x-internal="navigationtimingtype" href="https://w3c.github.io/navigation-timing/#dom-navigationtimingtype" {
						- "NavigationTimingType"
					}
				}
				- " used for "
				a href="https://w3c.github.io/navigation-timing/#dfn-create-the-navigation-timing-entry" id="non-fetch-schemes-and-external-software:create-the-navigation-timing-entry" data-x-internal="create-the-navigation-timing-entry" {
					- "creating the navigation timing entry"
				}
				- " for the new "
				code id="non-fetch-schemes-and-external-software:document" {
					a href="#document" {
						- "Document"
					}
				}
				- " (if one is\n   created)"
			}
			dt {
				dfn id="non-fetch-scheme-params-user-involvement" {
					- "user involvement"
				}
			}
			dd {
				- "a "
				a href="#user-navigation-involvement" id="non-fetch-schemes-and-external-software:user-navigation-involvement" {
					- "user navigation involvement"
				}
				- " used when "
				a href="#obtain-browsing-context-navigation" id="non-fetch-schemes-and-external-software:obtain-browsing-context-navigation" {
					- "obtaining a browsing context"
				}
				- " for the new\n   "
				code id="non-fetch-schemes-and-external-software:document-2" {
					a href="#document" {
						- "Document"
					}
				}
				- " (if one is created)"
			}
		}
		- "\n\n  "
		p id="process-a-navigate-url-scheme" {
			- "To "
			dfn id="attempt-to-create-a-non-fetch-scheme-document" {
				- "attempt to create a non-fetch scheme document"
			}
			- ",\n  given a "
			a href="#non-fetch-scheme-navigation-params" id="non-fetch-schemes-and-external-software:non-fetch-scheme-navigation-params-2" {
				- "non-fetch scheme navigation params"
			}
			- " "
			var {
				- "navigationParams"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				- "Let "
				var {
					- "url"
				}
				- " be "
				var {
					- "navigationParams"
				}
				- "'s "
				a href="#non-fetch-scheme-params-url" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-url" {
					- "URL"
				}
				- "."
			}
			li {
				- "Let "
				var {
					- "navigable"
				}
				- " be "
				var {
					- "navigationParams"
				}
				- "'s "
				a href="#non-fetch-scheme-params-navigable" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-navigable" {
					- "navigable"
				}
				- "."
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "url"
					}
					- " is to be handled using a mechanism that does not affect\n    "
					var {
						- "navigable"
					}
					- ", e.g., because "
					var {
						- "url"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-scheme" id="non-fetch-schemes-and-external-software:concept-url-scheme" data-x-internal="concept-url-scheme" {
						- "scheme"
					}
					- " is handled externally, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#hand-off-to-external-software" id="non-fetch-schemes-and-external-software:hand-off-to-external-software" {
								- "Hand-off to external software"
							}
							- " given "
							var {
								- "url"
							}
							- ", "
							var {
								- "navigable"
							}
							- ",\n     "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#non-fetch-scheme-params-target-sandbox" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-target-sandbox" {
								- "target\n     snapshot sandboxing flags"
							}
							- ", "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#non-fetch-scheme-params-source-activation" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-source-activation" {
								- "source snapshot has transient\n     activation"
							}
							- ", and "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#non-fetch-scheme-params-initiator-origin" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-initiator-origin-2" {
								- "initiator origin"
							}
							- "."
						}
					}
					li {
						p {
							- "Return null."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Handle "
					var {
						- "url"
					}
					- " by displaying some sort of inline content, e.g., an error message\n    because the specified scheme is not one of the supported protocols, or an inline prompt to allow\n    the user to select "
					a href="#dom-navigator-registerprotocolhandler" id="non-fetch-schemes-and-external-software:dom-navigator-registerprotocolhandler" {
						- "a registered\n    handler"
					}
					- " for the given scheme. Return the result of "
					a href="#read-ua-inline" id="non-fetch-schemes-and-external-software:read-ua-inline" {
						- "displaying the inline content"
					}
					- " given "
					var {
						- "navigable"
					}
					- ",\n    "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#non-fetch-scheme-params-id" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-id" {
						- "id"
					}
					- ",\n    "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#non-fetch-scheme-params-nav-timing-type" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-nav-timing-type" {
						- "navigation\n    timing type"
					}
					- ", and "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#non-fetch-scheme-params-user-involvement" id="non-fetch-schemes-and-external-software:non-fetch-scheme-params-user-involvement" {
						- "user involvement"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "In the case of a registered handler being used, "
					a href="#navigate" id="non-fetch-schemes-and-external-software:navigate" {
						- "navigate"
					}
					- " will be\n    invoked with a new URL."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="hand-off-to-external-software" {
				- "hand-off to external software"
			}
			- " given a "
			a id="non-fetch-schemes-and-external-software:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " or "
			a href="https://fetch.spec.whatwg.org/#concept-response" id="non-fetch-schemes-and-external-software:concept-response" data-x-internal="concept-response" {
				- "response"
			}
			- " "
			var {
				- "resource"
			}
			- ", a "
			a href="#navigable" id="non-fetch-schemes-and-external-software:navigable-2" {
				- "navigable"
			}
			- "\n  "
			var {
				- "navigable"
			}
			- ", a "
			a href="#sandboxing-flag-set" id="non-fetch-schemes-and-external-software:sandboxing-flag-set" {
				- "sandboxing flag set"
			}
			- " "
			var {
				- "sandboxFlags"
			}
			- ", a boolean\n  "
			var {
				- "hasTransientActivation"
			}
			- ", and an "
			a href="#concept-origin" id="non-fetch-schemes-and-external-software:concept-origin-2" {
				- "origin"
			}
			- " "
			var {
				- "initiatorOrigin"
			}
			- " user\n  agents should:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If all of the following are true:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							var {
								- "navigable"
							}
							- " is not a "
							a href="#top-level-traversable" id="non-fetch-schemes-and-external-software:top-level-traversable" {
								- "top-level traversable"
							}
							- ";"
						}
					}
					li {
						p {
							var {
								- "sandboxFlags"
							}
							- " has its "
							a href="#sandboxed-custom-protocols-navigation-browsing-context-flag" id="non-fetch-schemes-and-external-software:sandboxed-custom-protocols-navigation-browsing-context-flag" {
								- "sandboxed custom protocols navigation browsing\n     context flag"
							}
							- " set; and"
						}
					}
					li {
						p {
							var {
								- "sandboxFlags"
							}
							- " has its "
							a href="#sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" id="non-fetch-schemes-and-external-software:sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" {
								- "sandboxed top-level navigation with user\n     activation browsing context flag"
							}
							- " set, or "
							var {
								- "hasTransientActivation"
							}
							- " is\n     false,"
						}
					}
				}
				- "\n\n    "
				p {
					- "then return without invoking the external software package."
				}
				- "\n\n    "
				p class="note" {
					- "Navigation inside an iframe toward external software can be seen by users as a\n    new popup or a new top-level navigation. That's why its is allowed in sandboxed\n    "
					code id="non-fetch-schemes-and-external-software:the-iframe-element" {
						a href="#the-iframe-element" {
							- "iframe"
						}
					}
					- " only when one of "
					code id="non-fetch-schemes-and-external-software:attr-iframe-sandbox-allow-popups" {
						a href="#attr-iframe-sandbox-allow-popups" {
							- "allow-popups"
						}
					}
					- ", "
					code id="non-fetch-schemes-and-external-software:attr-iframe-sandbox-allow-top-navigation" {
						a href="#attr-iframe-sandbox-allow-top-navigation" {
							- "allow-top-navigation"
						}
					}
					- ", "
					code id="non-fetch-schemes-and-external-software:attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
						a href="#attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
							- "allow-top-navigation-by-user-activation"
						}
					}
					- ",\n    or "
					code id="non-fetch-schemes-and-external-software:attr-iframe-sandbox-allow-top-navigation-to-custom-protocols" {
						a href="#attr-iframe-sandbox-allow-top-navigation-to-custom-protocols" {
							- "allow-top-navigation-to-custom-protocols"
						}
					}
					- "\n    is specified."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Perform the appropriate handoff of "
					var {
						- "resource"
					}
					- " while attempting to mitigate the risk\n    that this is an attempt to exploit the target software. For example, user agents could prompt\n    the user to confirm that "
					var {
						- "initiatorOrigin"
					}
					- " is to be allowed to invoke the external\n    software in question. In particular, if "
					var {
						- "hasTransientActivation"
					}
					- " is false, then the\n    user agent should not invoke the external software package without prior user confirmation."
				}
				- "\n\n    "
				p class="example" {
					- "For example, there could be a vulnerability in the target software's URL\n    handler which a hostile page would attempt to exploit by tricking a user into clicking a\n    link."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h5 id="preventing-navigation" {
			span class="secno" {
				- "7.4.2.4"
			}
			- " Preventing navigation"
			a href="#preventing-navigation" class="self-link"
		}
		- "\n\n  "
		p {
			- "A couple of scenarios can intervene early in the navigation process and put the whole thing to\n  a halt. This can be especially exciting when multiple "
			a href="#navigable" id="preventing-navigation:navigable" {
				- "navigables"
			}
			- "\n  are navigating at the same time, due to a session history traversal."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#navigable" id="preventing-navigation:navigable-2" {
				- "navigable"
			}
			- " "
			var {
				- "source"
			}
			- " is "
