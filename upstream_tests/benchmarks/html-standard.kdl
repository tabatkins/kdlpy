						}
					}
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-7" {
								- "Generate implied end tags"
							}
							- "."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-11" {
								- "current node"
							}
							- " is not a "
							code id="parsing-main-inbody:the-form-element" {
								a href="#the-form-element" {
									- "form"
								}
							}
							- " element, then this is a\n     "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-22" {
								- "parse error"
							}
							- "."
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-40" {
								- "stack of open elements"
							}
							- " until a "
