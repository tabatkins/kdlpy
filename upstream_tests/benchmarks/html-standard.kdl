			}
			li {
				p {
					- "If the "
					a href="#current-node" id="parsing-main-inbody:current-node-29" {
						- "current node"
					}
					- " is not a "
					code id="parsing-main-inbody:the-p-element-7" {
						a href="#the-p-element" {
							- "p"
						}
					}
					- " element, then this is a\n   "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-41" {
						- "parse error"
					}
					- "."
				}
			}
			li {
				p {
					- "Pop elements from the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-65" {
						- "stack of open elements"
					}
					- " until a "
					code id="parsing-main-inbody:the-p-element-8" {
						a href="#the-p-element" {
							- "p"
						}
					}
					- " element\n   has been popped from the stack."
				}
			}
		}
		- "\n\n  \n  "
		p id="adoptionAgency" {
			- "The "
			dfn id="adoption-agency-algorithm" {
				- "adoption agency algorithm"
			}
			- ", which takes as its only argument\n  a token "
			var {
				- "token"
			}
			- " for which the algorithm is being run, consists of the following\n  steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "subject"
					}
					- " be "
					var {
						- "token"
					}
					- "'s tag name."
				}
			}
			li {
				p {
					- "If the "
					a href="#current-node" id="parsing-main-inbody:current-node-30" {
						- "current node"
					}
					- " is an "
					a href="#html-elements" id="parsing-main-inbody:html-elements-17" {
						- "HTML element"
					}
					- "\n   whose tag name is "
					var {
						- "subject"
					}
					- ", and the "
					a href="#current-node" id="parsing-main-inbody:current-node-31" {
						- "current node"
					}
					- " is not in the\n   "
					a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-4" {
						- "list of active formatting elements"
					}
					- ", then pop the "
					a href="#current-node" id="parsing-main-inbody:current-node-32" {
						- "current node"
					}
					- " off the\n   "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-66" {
						- "stack of open elements"
					}
					- " and return."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "outerLoopCounter"
					}
					- " be 0."
				}
			}
			li {
				- "\n    "
				p {
					- "While true:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "outerLoopCounter"
							}
							- " is greater than or equal to 8, then return."
						}
					}
					li {
						p {
							- "Increment "
							var {
								- "outerLoopCounter"
							}
							- " by 1."
						}
					}
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "formattingElement"
							}
							- " be the last element in the "
							a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-5" {
								- "list of active\n      formatting elements"
							}
							- " that:"
