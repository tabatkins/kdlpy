					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-mode" id="read-text:concept-document-mode" data-x-internal="concept-document-mode" {
						- "mode"
					}
					- "\n   to \""
					code {
						- "no-quirks"
					}
					- "\"."
				}
			}
			li {
				- "\n    "
				p {
					- "Create an "
					a href="#html-parser" id="read-text:html-parser" {
						- "HTML parser"
					}
					- " and associate it with the "
					var {
						- "document"
					}
					- ". Act as\n    if the tokenizer had emitted a start tag token with the tag name \"pre\" followed by a single\n    U+000A LINE FEED (LF) character, and switch the "
					a href="#html-parser" id="read-text:html-parser-2" {
