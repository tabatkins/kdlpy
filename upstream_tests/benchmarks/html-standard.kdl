		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="local-date-and-time-state-(type=datetime-local):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="local-date-and-time-state-(type=datetime-local):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#local-date-and-time-state-(type=datetime-local)" id="local-date-and-time-state-(type=datetime-local):local-date-and-time-state-(type=datetime-local)" {
				- "Local Date and Time"
			}
			- " state, the rules in\n  this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="local-date-and-time-state-(type=datetime-local):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="local-date-and-time-state-(type=datetime-local):represents" {
				- "represents"
			}
			- " a control for setting the element's\n  "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value" {
				- "value"
			}
			- " to a string representing a "
			a href="#concept-datetime-local" id="local-date-and-time-state-(type=datetime-local):concept-datetime-local" {
				- "local date and time"
			}
			- ", with no time-zone offset\n  information."
		}
		- "\n\n  \n\n  "
		p {
			- "If the element is "
			i id="local-date-and-time-state-(type=datetime-local):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the "
			a href="#concept-datetime-local" id="local-date-and-time-state-(type=datetime-local):concept-datetime-local-2" {
				- "date and time"
			}
			- " represented by its\n  "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-2" {
				- "value"
			}
			- ", as obtained by "
			a href="#parse-a-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):parse-a-local-date-and-time-string" {
				- "parsing a date and time"
			}
			- " from it. User agents must not allow the user to set\n  the "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-3" {
				- "value"
			}
			- " to a non-empty string that is not a "
			a href="#valid-normalised-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-normalised-local-date-and-time-string" {
				- "valid\n  normalized local date and time string"
			}
			- ". If the user agent provides a user interface for\n  selecting a "
			a href="#concept-datetime-local" id="local-date-and-time-state-(type=datetime-local):concept-datetime-local-3" {
				- "local date and time"
			}
			- ", then the "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-4" {
				- "value"
			}
			- " must be set to a "
			a href="#valid-normalised-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-normalised-local-date-and-time-string-2" {
				- "valid normalized local date and time\n  string"
			}
			- " representing the user's selection. User agents should allow the user to set the\n  "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-5" {
				- "value"
			}
			- " to the empty string."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the user interface describes input that the user\n  agent cannot convert to a "
			a href="#valid-normalised-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-normalised-local-date-and-time-string-3" {
				- "valid normalized local date and time string"
			}
			- ", the control is\n  "
			a href="#suffering-from-bad-input" id="local-date-and-time-state-(type=datetime-local):suffering-from-bad-input" {
				- "suffering from bad input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "See the "
			a href="#input-author-notes" {
				- "introduction section"
			}
			- " for a discussion of\n  the difference between the input format and submission format for date, time, and number form\n  controls, and the "
			a href="#input-impl-notes" {
				- "implementation notes"
			}
			- "\n  regarding localization of form controls."
		}
		- "\n\n  "
		p {
			- "The "
			code id="local-date-and-time-state-(type=datetime-local):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not empty, must\n  have a value that is a "
			a href="#valid-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-local-date-and-time-string" {
				- "valid local date and time string"
			}
			- "."
		}
		- " \n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="local-date-and-time-state-(type=datetime-local):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": If the "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-6" {
				- "value"
			}
			- " of the element is a "
			a href="#valid-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-local-date-and-time-string-2" {
				- "valid local date and time\n  string"
			}
			- ", then set it to a "
			a href="#valid-normalised-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-normalised-local-date-and-time-string-4" {
				- "valid normalized local date and time string"
			}
			- "\n  representing the same date and time; otherwise, set it to the empty string instead."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="local-date-and-time-state-(type=datetime-local):attr-input-min" {
				a href="#attr-input-min" {
					- "min"
				}
			}
			- " attribute, if specified, must have a value that is\n  a "
			a href="#valid-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-local-date-and-time-string-3" {
				- "valid local date and time string"
			}
			- ". The "
			code id="local-date-and-time-state-(type=datetime-local):attr-input-max" {
				a href="#attr-input-max" {
					- "max"
				}
			}
			- "\n  attribute, if specified, must have a value that is a "
			a href="#valid-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):valid-local-date-and-time-string-4" {
				- "valid local date and time\n  string"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="local-date-and-time-state-(type=datetime-local):attr-input-step" {
				a href="#attr-input-step" {
					- "step"
				}
			}
			- " attribute is expressed in seconds. The "
			a href="#concept-input-step-scale" id="local-date-and-time-state-(type=datetime-local):concept-input-step-scale" {
				- "step scale factor"
			}
			- " is 1000 (which\n  converts the seconds to milliseconds, as used in the other algorithms). The "
			a href="#concept-input-step-default" id="local-date-and-time-state-(type=datetime-local):concept-input-step-default" {
				- "default step"
			}
			- " is 60 seconds."
		}
		- "\n\n  \n\n  "
		p {
			- "When the element is "
			a href="#suffering-from-a-step-mismatch" id="local-date-and-time-state-(type=datetime-local):suffering-from-a-step-mismatch" {
				- "suffering from a step mismatch"
			}
			- ", the user agent may round the\n  element's "
			a href="#concept-fe-value" id="local-date-and-time-state-(type=datetime-local):concept-fe-value-7" {
				- "value"
			}
			- " to the nearest "
			a href="#concept-datetime-local" id="local-date-and-time-state-(type=datetime-local):concept-datetime-local-4" {
				- "local date and time"
			}
			- " for which the element would not "
			a href="#suffering-from-a-step-mismatch" id="local-date-and-time-state-(type=datetime-local):suffering-from-a-step-mismatch-2" {
				- "suffer from a step mismatch"
