					c- p="" {
						- ":"
					}
					c- nd="" {
						- "state"
					}
					c- o="" {
						- "("
					}
					c- f="" {
						- "checked"
					}
					c- o="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- " "
					c- k="" {
						- "color"
					}
					c- p="" {
						- ":"
					}
					- " "
					c- kc="" {
						- "green"
					}
