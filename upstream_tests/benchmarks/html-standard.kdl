				}
				- "\n\n    "
				p {
					a href="#close-a-p-element" id="parsing-main-inbody:close-a-p-element-8" {
						- "Close a "
						code {
							- "p"
						}
						- " element"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"li\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-42" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-list-item-scope" id="parsing-main-inbody:has-an-element-in-list-item-scope" {
						- "have an "
						code {
							- "li"
						}
						- " element in list item scope"
					}
					- ", then this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-24" {
						- "parse\n    error"
					}
					- "; ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-8" {
								- "Generate implied end tags"
							}
							- ", except for "
							code id="parsing-main-inbody:the-li-element-8" {
								a href="#the-li-element" {
									- "li"
								}
							}
							- " elements."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-12" {
								- "current node"
							}
							- " is not an "
							code id="parsing-main-inbody:the-li-element-9" {
								a href="#the-li-element" {
									- "li"
								}
							}
							- " element, then this is a\n     "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-25" {
								- "parse error"
							}
							- "."
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-43" {
								- "stack of open elements"
							}
							- " until an "
							code id="parsing-main-inbody:the-li-element-10" {
								a href="#the-li-element" {
									- "li"
								}
							}
							- "\n     element has been popped from the stack."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"dd\", \"dt\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-44" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-7" {
						- "have an element in scope"
					}
					- " that is an "
					a href="#html-elements" id="parsing-main-inbody:html-elements-5" {
						- "HTML\n    element"
					}
					- " with the same tag name as that of the token, then this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-26" {
						- "parse\n    error"
					}
					- "; ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-9" {
								- "Generate implied end tags"
							}
							- ", except for "
							a href="#html-elements" id="parsing-main-inbody:html-elements-6" {
								- "HTML elements"
							}
							- " with the\n     same tag name as the token."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-13" {
								- "current node"
							}
							- " is not an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-7" {
								- "HTML\n     element"
							}
							- " with the same tag name as that of the token, then this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-27" {
								- "parse\n     error"
							}
							- "."
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-45" {
								- "stack of open elements"
							}
							- " until an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-8" {
								- "HTML element"
							}
							- " with the same tag name as the token has been popped from the\n     stack."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-46" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-8" {
						- "have an element in scope"
					}
					- " that is an "
					a href="#html-elements" id="parsing-main-inbody:html-elements-9" {
						- "HTML\n    element"
					}
					- " and whose tag name is one of \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", or \"h6\", then this is\n    a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-28" {
						- "parse error"
					}
					- "; ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-10" {
								- "Generate implied end tags"
							}
							- "."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-14" {
								- "current node"
							}
							- " is not an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-10" {
								- "HTML\n     element"
							}
							- " with the same tag name as that of the token, then this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-29" {
								- "parse\n     error"
							}
							- "."
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-47" {
								- "stack of open elements"
							}
							- " until an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-11" {
								- "HTML element"
							}
							- " whose tag name is one of \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", or \"h6\"\n     has been popped from the stack."
						}
					}
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"sarcasm\""
			}
			dd {
				- "\n    "
				p {
					- "Take a deep breath, then act as described in the \"any other end\n    tag\" entry below."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"a\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements" {
						- "list of active formatting elements"
					}
					- " contains an "
					code id="parsing-main-inbody:the-a-element" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " element\n    between the end of the list and the last "
					a href="#concept-parser-marker" id="parsing-main-inbody:concept-parser-marker" {
						- "marker"
					}
					- " on\n    the list (or the start of the list if there is no "
					a href="#concept-parser-marker" id="parsing-main-inbody:concept-parser-marker-2" {
						- "marker"
					}
					- " on the list), then this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-30" {
						- "parse\n    error"
					}
					- "; run the "
					a href="#adoption-agency-algorithm" id="parsing-main-inbody:adoption-agency-algorithm" {
						- "adoption agency algorithm"
					}
					- " for the token, then remove that\n    element from the "
					a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-2" {
						- "list of active formatting elements"
					}
					- " and the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-48" {
						- "stack of open\n    elements"
					}
					- " if the "
					a href="#adoption-agency-algorithm" id="parsing-main-inbody:adoption-agency-algorithm-2" {
						- "adoption agency algorithm"
					}
					- " didn't already remove it (it might\n    not have if the element is not "
					a href="#has-an-element-in-table-scope" id="parsing-main-inbody:has-an-element-in-table-scope" {
						- "in table\n    scope"
					}
					- ")."
				}
				- "\n\n    "
				p class="example" {
					- "In the non-conforming stream\n    "
					code {
						- "<a href=\"a\">a<table><a href=\"b\">b</table>x"
					}
					- ", the first\n    "
					code id="parsing-main-inbody:the-a-element-2" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " element would be closed upon seeing the second one, and the \"x\" character would\n    be inside a link to \"b\", not to \"a\". This is despite the fact that the outer "
					code id="parsing-main-inbody:the-a-element-3" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- "\n    element is not in table scope (meaning that a regular "
					code {
						- "</a>"
					}
					- " end tag at the start\n    of the table wouldn't close the outer "
					code id="parsing-main-inbody:the-a-element-4" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " element). The result is that the two\n    "
					code id="parsing-main-inbody:the-a-element-5" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " elements are indirectly nested inside each other — non-conforming markup\n    will often result in non-conforming DOMs when parsed."
				}
				- "\n\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-5" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-11" {
						- "Insert an HTML element"
					}
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id="parsing-main-inbody:push-onto-the-list-of-active-formatting-elements" {
						- "Push onto the list of active\n    formatting elements"
					}
					- " that element."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"b\", \"big\", \"code\", \"em\",\n   \"font\", \"i\", \"s\", \"small\", \"strike\", \"strong\", \"tt\", \"u\""
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-6" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-12" {
						- "Insert an HTML element"
					}
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id="parsing-main-inbody:push-onto-the-list-of-active-formatting-elements-2" {
						- "Push onto the list of active\n    formatting elements"
					}
					- " that element."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"nobr\""
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-7" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-49" {
						- "stack of open elements"
					}
					- " "
					a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-9" {
						- "has a\n    "
						code {
							- "nobr"
						}
						- " element in scope"
					}
					- ", then this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-31" {
						- "parse error"
					}
					- "; run the\n    "
					a href="#adoption-agency-algorithm" id="parsing-main-inbody:adoption-agency-algorithm-3" {
						- "adoption agency algorithm"
					}
					- " for the token, then once again "
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-8" {
						- "reconstruct the\n    active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-13" {
						- "Insert an HTML element"
					}
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id="parsing-main-inbody:push-onto-the-list-of-active-formatting-elements-3" {
						- "Push onto the list of active\n    formatting elements"
					}
					- " that element."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is one of: \"a\",\n   \"b\", \"big\", \"code\", \"em\", \"font\", \"i\", \"nobr\", \"s\", \"small\",\n   \"strike\", \"strong\", \"tt\", \"u\""
			}
			dd {
				- "\n    "
				p {
					- "Run the "
					a href="#adoption-agency-algorithm" id="parsing-main-inbody:adoption-agency-algorithm-4" {
						- "adoption agency algorithm"
					}
					- " for the token."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"applet\", \"marquee\", \"object\""
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-9" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-14" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p {
					- "Insert a "
					a href="#concept-parser-marker" id="parsing-main-inbody:concept-parser-marker-3" {
						- "marker"
					}
					- " at the end of the "
					a href="#list-of-active-formatting-elements" id="parsing-main-inbody:list-of-active-formatting-elements-3" {
						- "list of\n    active formatting elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Set the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag-8" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"."
				}
				- "\n   "
			}
			dt {
				- "An end tag token whose tag name is one of: \"applet\", \"marquee\", \"object\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-50" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-10" {
						- "have an element in scope"
					}
					- " that is an "
					a href="#html-elements" id="parsing-main-inbody:html-elements-12" {
						- "HTML\n    element"
					}
					- " with the same tag name as that of the token, then this is a "
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-32" {
						- "parse\n    error"
					}
					- "; ignore the token."
				}
				- "\n\n    "
				p {
					- "Otherwise, run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-11" {
								- "Generate implied end tags"
							}
							- "."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-15" {
								- "current node"
							}
							- " is not an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-13" {
								- "HTML\n     element"
							}
							- " with the same tag name as that of the token, then this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-33" {
								- "parse\n     error"
							}
							- "."
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-51" {
								- "stack of open elements"
							}
							- " until an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-14" {
								- "HTML element"
							}
							- " with the same tag name as the token has been popped from the\n     stack."
						}
					}
					li {
						a href="#clear-the-list-of-active-formatting-elements-up-to-the-last-marker" id="parsing-main-inbody:clear-the-list-of-active-formatting-elements-up-to-the-last-marker" {
							- "Clear the list of active formatting elements up to the last marker"
						}
						- "."
					}
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is \"table\""
			}
			dd {
				- "\n    "
				p {
					- "If the "
					code id="parsing-main-inbody:document" {
						a href="#document" {
							- "Document"
						}
					}
					- " is "
					em {
						- "not"
					}
					- " set to "
					a id="parsing-main-inbody:quirks-mode" href="https://dom.spec.whatwg.org/#concept-document-quirks" data-x-internal="quirks-mode" {
						- "quirks mode"
					}
					- ", and the\n    "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-52" {
						- "stack of open elements"
					}
					- " "
					a href="#has-an-element-in-button-scope" id="parsing-main-inbody:has-an-element-in-button-scope-9" {
						- "has a\n    "
						code {
							- "p"
						}
						- " element in button scope"
					}
					- ", then "
					a href="#close-a-p-element" id="parsing-main-inbody:close-a-p-element-9" {
						- "close a "
						code {
							- "p"
						}
						- "\n    element"
					}
					- "."
				}
				- " \n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-15" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p {
					- "Set the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag-9" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"."
				}
				- "\n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-inbody:insertion-mode-7" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intable" id="parsing-main-inbody:parsing-main-intable" {
						- "in\n    table"
					}
					- "\"."
				}
				- "\n   "
			}
			dt {
				- "An end tag whose tag name is \"br\""
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-inbody:parse-errors-34" {
						- "Parse error"
					}
					- ". Drop the attributes from the token, and act as described in the\n    next entry; i.e. act as if this was a \"br\" start tag token with no attributes, rather than the\n    end tag token that it actually is."
				}
				- "\n   "
			}
			dt {
				- "A start tag whose tag name is one of: \"area\", \"br\", \"embed\",\n   \"img\", \"keygen\", \"wbr\""
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-10" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-16" {
						- "Insert an HTML element"
					}
					- " for the token. Immediately pop the "
					a href="#current-node" id="parsing-main-inbody:current-node-16" {
						- "current\n    node"
					}
					- " off the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-53" {
						- "stack of open elements"
					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#acknowledge-self-closing-flag" id="parsing-main-inbody:acknowledge-self-closing-flag" {
						- "Acknowledge the token's "
						i {
							- "self-closing\n    flag"
						}
					}
					- ", if it is set."
				}
				- "\n\n    "
				p {
					- "Set the "
					a href="#frameset-ok-flag" id="parsing-main-inbody:frameset-ok-flag-10" {
						- "frameset-ok flag"
					}
					- " to \"not ok\"."
				}
				- "\n    \n   "
			}
			dt {
				- "A start tag whose tag name is \"input\""
			}
			dd {
				- "\n    "
				p {
					a href="#reconstruct-the-active-formatting-elements" id="parsing-main-inbody:reconstruct-the-active-formatting-elements-11" {
						- "Reconstruct the active formatting elements"
					}
					- ", if any."
				}
				- "\n\n    "
				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-17" {
						- "Insert an HTML element"
					}
					- " for the token. Immediately pop the "
					a href="#current-node" id="parsing-main-inbody:current-node-17" {
						- "current\n    node"
					}
