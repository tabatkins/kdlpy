					- "textarea"
				}
			}
			- " element"
			a href="#the-textarea-element-2" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-textarea-element-2:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element is a "
			a id="the-textarea-element-2:devolvable-widget" href="https://drafts.csswg.org/css-ui/#devolvable" data-x-internal="devolvable-widget" {
				- "devolvable widget"
			}
			- " expected to render as an\n  "
			a id="the-textarea-element-2:'inline-block'" href="https://drafts.csswg.org/css2/#value-def-inline-block" data-x-internal="'inline-block'" {
				- "'inline-block'"
			}
			- " box depicting a multiline text control. If this multiline text control\n  provides a selection, then, when the user changes the current selection, the user agent is\n  expected to "
			a href="#queue-an-element-task" id="the-textarea-element-2:queue-an-element-task" {
				- "queue an element task"
			}
			- " on the "
			a href="#user-interaction-task-source" id="the-textarea-element-2:user-interaction-task-source" {
				- "user interaction task source"
			}
			- "\n  given the "
			code id="the-textarea-element-2:the-textarea-element-3" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-textarea-element-2:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- "\n  named "
			code id="the-textarea-element-2:event-select" {
				a href="#event-select" {
					- "select"
				}
			}
			- " at the element, with the "
			code id="the-textarea-element-2:dom-event-bubbles" {
				a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
					- "bubbles"
				}
			}
			- " attribute initialized to true."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-textarea-element-2:the-textarea-element-4" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element is an "
			a id="the-textarea-element-2:element-with-default-preferred-size" href="https://drafts.csswg.org/css-ui/#element-with-default-preferred-size" data-x-internal="element-with-default-preferred-size" {
				- "element with default preferred size"
			}
			- ", and\n  user agents are expected to apply the "
			a id="the-textarea-element-2:'field-sizing'" href="https://drafts.csswg.org/css-ui/#field-sizing" data-x-internal="'field-sizing'" {
				- "'field-sizing'"
			}
			- " CSS property to\n  "
			code id="the-textarea-element-2:the-textarea-element-5" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements.\n\n  "
		}
		p {
			- "If the "
			a id="the-textarea-element-2:'field-sizing'-2" href="https://drafts.csswg.org/css-ui/#field-sizing" data-x-internal="'field-sizing'" {
				- "'field-sizing'"
			}
			- " property on the element has a "
			a id="the-textarea-element-2:computed-value" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- "\n  of "
			a href="https://drafts.csswg.org/css-ui/#valdef-field-sizing-content" id="the-textarea-element-2:field-sizing-content" data-x-internal="field-sizing-content" {
				- "'content'"
			}
			- ", the "
			a id="the-textarea-element-2:intrinsic-size" href="https://drafts.csswg.org/css-sizing/#intrinsic-size" data-x-internal="intrinsic-size" {
				- "intrinsic size"
			}
			- " is\n  determined from the text which the element shows. The text is either a\n  "
			a href="#concept-textarea-raw-value" id="the-textarea-element-2:concept-textarea-raw-value" {
				- "raw value"
			}
			- " or a short hint specified by the\n  "
