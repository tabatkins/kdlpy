				a href="#attr-tdth-headers" {
					- "headers"
				}
			}
			- "\n  attributes take part in the "
			a href="#table-model" id="attributes-common-to-td-and-th-elements:table-model-3" {
				- "table model"
			}
			- "."
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "cell"
					}
					- "."
					a href="#dom-tdth-cellindex" id="dom-tdth-cellindex-dev" {
						- "cellIndex"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the position of the cell in the row's "
					code id="attributes-common-to-td-and-th-elements:dom-tr-cells" {
						a href="#dom-tr-cells" {
							- "cells"
						}
					}
					- " list.\n    This does not necessarily correspond to the "
