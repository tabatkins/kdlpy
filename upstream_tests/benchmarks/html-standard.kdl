			- " element is available\n  for such use cases."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "User agent requirements"
			}
			- ": If the "
			code id="the-progress-element:attr-progress-value-6" {
				a href="#attr-progress-value" {
					- "value"
				}
			}
			- "\n  attribute is omitted, then the progress bar is an indeterminate progress bar. Otherwise, it is a\n  determinate progress bar."
