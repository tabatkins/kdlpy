				a href="#link-type-modulepreload" {
					- "modulepreload"
				}
			}
			- " keyword is a specialized alternative\n  to the "
			code id="link-type-modulepreload:link-type-preload" {
				a href="#link-type-preload" {
					- "preload"
				}
			}
			- " keyword, with a processing model geared toward\n  preloading "
			a href="#module-script" id="link-type-modulepreload:module-script" {
