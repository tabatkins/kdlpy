		- "\n\n  "
		p {
			- "Elaborating on the example in the previous section, consider the case where the second\n  "
			code id="the-execution-of-scripts-that-are-moving-across-multiple-documents:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element is an external script (i.e. one with a "
			code id="the-execution-of-scripts-that-are-moving-across-multiple-documents:attr-script-src" {
				a href="#attr-script-src" {
					- "src"
				}
