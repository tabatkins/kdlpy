				}
				- "\" will be fetched and evaluated (as a "
				a href="#javascript-module-script" id="the-script-element:javascript-module-script-8" {
					- "JavaScript module\n  script"
				}
				- "). Conversely, older user agents will ignore the "
				code id="the-script-element:the-script-element-21" {
					a href="#the-script-element" {
