									}
									- " state or "
									var {
										- "candidateAncestor"
									}
									- "'s "
									code id="the-popover-attribute:attr-popover-23" {
										a href="#attr-popover" {
											- "popover"
										}
									}
									- " attribute is in the "
									a href="#attr-popover-auto-state" id="the-popover-attribute:attr-popover-auto-state-8" {
										- "auto"
									}
									- " state."
								}
							}
							li {
								p {
									- "If "
									var {
										- "okNesting"
									}
									- " is false, then set "
									var {
										- "candidate"
									}
									- " to\n       "
									var {
										- "candidateAncestor"
									}
									- "'s parent in the "
									a id="the-popover-attribute:flat-tree" href="https://drafts.csswg.org/css-scoping/#flat-tree" data-x-internal="flat-tree" {
										- "flat tree"
