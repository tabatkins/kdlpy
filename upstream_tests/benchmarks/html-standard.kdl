		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-paused" data-dfn-type="attribute" {
				code {
					- "paused"
				}
			}
			- "\n  attribute represents whether the "
			a href="#media-element" id="playing-the-media-resource:media-element" {
				- "media element"
			}
			- " is paused or not. The attribute must\n  initially be true."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-2" {
				- "media element"
			}
			- " is a "
			dfn id="blocked-media-element" {
				- "blocked media element"
			}
			- " if its "
			code id="playing-the-media-resource:dom-media-readystate" {
				a href="#dom-media-readystate" {
					- "readyState"
				}
			}
			- " attribute is in the "
			code id="playing-the-media-resource:dom-media-have_nothing" {
				a href="#dom-media-have_nothing" {
					- "HAVE_NOTHING"
				}
			}
			- " state, the "
			code id="playing-the-media-resource:dom-media-have_metadata" {
				a href="#dom-media-have_metadata" {
					- "HAVE_METADATA"
				}
			}
			- " state, or the "
			code id="playing-the-media-resource:dom-media-have_current_data" {
				a href="#dom-media-have_current_data" {
					- "HAVE_CURRENT_DATA"
				}
			}
			- " state, or if the element has\n  "
			a href="#paused-for-user-interaction" id="playing-the-media-resource:paused-for-user-interaction" {
				- "paused for user interaction"
			}
			- " or "
			a href="#paused-for-in-band-content" id="playing-the-media-resource:paused-for-in-band-content" {
				- "paused for in-band content"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-3" {
				- "media element"
			}
			- " is said to be "
			dfn data-dfn-for="media element" id="potentially-playing" data-export="" {
				- "potentially\n  playing"
			}
			- " when its "
			code id="playing-the-media-resource:dom-media-paused-3" {
				a href="#dom-media-paused" {
					- "paused"
				}
			}
			- " attribute is false, the\n  element has not "
			a href="#ended-playback" id="playing-the-media-resource:ended-playback" {
				- "ended playback"
			}
			- ", playback has not "
			a href="#stopped-due-to-errors" id="playing-the-media-resource:stopped-due-to-errors" {
				- "stopped due to errors"
			}
			- ",\n  and the element is not a "
			a href="#blocked-media-element" id="playing-the-media-resource:blocked-media-element" {
				- "blocked media element"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "A "
			code id="playing-the-media-resource:event-media-waiting" {
				a href="#event-media-waiting" {
					- "waiting"
				}
			}
			- " DOM event "
			a href="#fire-waiting-when-waiting" {
				- "can be fired"
			}
			- " as a result of an element that is\n  "
			a href="#potentially-playing" id="playing-the-media-resource:potentially-playing" {
				- "potentially playing"
			}
			- " stopping playback due to its "
			code id="playing-the-media-resource:dom-media-readystate-2" {
				a href="#dom-media-readystate" {
					- "readyState"
				}
			}
			- " attribute changing to a value lower than "
			code id="playing-the-media-resource:dom-media-have_future_data" {
