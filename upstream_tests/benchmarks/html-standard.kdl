		- "\n\n  "
		hr
		- "\n\n  \n\n  "
		h4 id="sse-processing-model" {
			span class="secno" {
				- "9.2.3"
			}
			- " "
			span id="processing-model-9"
			- "Processing model"
			a href="#sse-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="announce-the-connection" {
				- "announce the connection"
			}
			- ", the user agent must "
			a href="#queue-a-task" id="sse-processing-model:queue-a-task" {
				- "queue a\n  task"
			}
			- " which, if the "
			code id="sse-processing-model:dom-eventsource-readystate" {
				a href="#dom-eventsource-readystate" {
					- "readyState"
				}
			}
			- " attribute is\n  set to a value other than "
			code id="sse-processing-model:dom-eventsource-closed" {
				a href="#dom-eventsource-closed" {
					- "CLOSED"
				}
			}
			- ", sets the "
			code id="sse-processing-model:dom-eventsource-readystate-2" {
				a href="#dom-eventsource-readystate" {
					- "readyState"
				}
			}
			- " attribute to "
			code id="sse-processing-model:dom-eventsource-open" {
				a href="#dom-eventsource-open" {
					- "OPEN"
				}
			}
			- " and "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sse-processing-model:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fires an\n  event"
			}
			- " named "
			code id="sse-processing-model:event-open" {
				a href="#event-open" {
					- "open"
				}
			}
			- " at the "
			code id="sse-processing-model:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "\n  object."
		}
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="reestablish-the-connection" {
				- "reestablish the connection"
			}
			- ", the user agent must run the\n  following steps. These steps are run "
			a href="#in-parallel" id="sse-processing-model:in-parallel" {
				- "in parallel"
			}
			- ", not as part of a "
			a href="#concept-task" id="sse-processing-model:concept-task" {
				- "task"
			}
			- ". (The tasks that it queues, of course, are run like normal tasks\n  and not themselves "
			a href="#in-parallel" id="sse-processing-model:in-parallel-2" {
				- "in parallel"
			}
			- ".)"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					a href="#queue-a-task" id="sse-processing-model:queue-a-task-2" {
						- "Queue a task"
					}
					- " to run the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							code id="sse-processing-model:dom-eventsource-readystate-3" {
								a href="#dom-eventsource-readystate" {
									- "readyState"
								}
							}
							- " attribute is set to\n     "
							code id="sse-processing-model:dom-eventsource-closed-2" {
								a href="#dom-eventsource-closed" {
									- "CLOSED"
								}
							}
							- ", abort the task."
						}
					}
					li {
						p {
							- "Set the "
							code id="sse-processing-model:dom-eventsource-readystate-4" {
								a href="#dom-eventsource-readystate" {
									- "readyState"
								}
							}
							- " attribute to "
							code id="sse-processing-model:dom-eventsource-connecting" {
								a href="#dom-eventsource-connecting" {
									- "CONNECTING"
								}
							}
							- "."
						}
					}
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sse-processing-model:concept-event-fire-2" data-x-internal="concept-event-fire" {
								- "Fire an event"
							}
							- " named "
							code id="sse-processing-model:event-error" {
								a href="#event-error" {
									- "error"
								}
							}
							- " at the "
							code id="sse-processing-model:eventsource-2" {
								a href="#eventsource" {
									- "EventSource"
								}
							}
							- " object."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Wait a delay equal to the reconnection time of the event source."
				}
			}
			li {
				p {
					- "Optionally, wait some more. In particular, if the previous attempt failed, then user\n   agents might introduce an exponential backoff delay to avoid overloading a potentially already\n   overloaded server. Alternatively, if the operating system has reported that there is no network\n   connectivity, user agents might wait for the operating system to announce that the network\n   connection has returned before retrying."
				}
			}
			li {
				p {
					- "Wait until the aforementioned task has run, if it has not yet run."
				}
			}
			li {
				- "\n    "
				p {
					a href="#queue-a-task" id="sse-processing-model:queue-a-task-3" {
						- "Queue a task"
					}
					- " to run the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							code id="sse-processing-model:eventsource-3" {
								a href="#eventsource" {
									- "EventSource"
								}
							}
							- " object's "
							code id="sse-processing-model:dom-eventsource-readystate-5" {
								a href="#dom-eventsource-readystate" {
									- "readyState"
								}
							}
							- " attribute is not set to "
							code id="sse-processing-model:dom-eventsource-connecting-2" {
								a href="#dom-eventsource-connecting" {
									- "CONNECTING"
								}
							}
							- ", then return."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "request"
							}
							- " be the "
							code id="sse-processing-model:eventsource-4" {
								a href="#eventsource" {
									- "EventSource"
								}
							}
							- " object's "
							a href="#concept-event-stream-request" id="sse-processing-model:concept-event-stream-request" {
								- "request"
							}
							- ".\n\n     "
						}
					}
					li {
						- "\n      "
						p {
							- "If the "
							code id="sse-processing-model:eventsource-5" {
								a href="#eventsource" {
									- "EventSource"
								}
							}
							- " object's "
							a href="#concept-event-stream-last-event-id" id="sse-processing-model:concept-event-stream-last-event-id" {
								- "last event ID string"
							}
							- " is not the empty\n      string, then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Let "
									var {
										- "lastEventIDValue"
									}
									- " be the "
									code id="sse-processing-model:eventsource-6" {
										a href="#eventsource" {
											- "EventSource"
										}
									}
									- " object's "
									a href="#concept-event-stream-last-event-id" id="sse-processing-model:concept-event-stream-last-event-id-2" {
										- "last event ID string"
									}
									- ", "
									a href="https://encoding.spec.whatwg.org/#utf-8-encode" id="sse-processing-model:utf-8-encode" data-x-internal="utf-8-encode" {
										- "encoded as UTF-8"
									}
									- "."
								}
							}
							li {
								p {
									a href="https://fetch.spec.whatwg.org/#concept-header-list-set" id="sse-processing-model:concept-header-list-set" data-x-internal="concept-header-list-set" {
										- "Set"
									}
									- " (`"
									code id="sse-processing-model:last-event-id" {
										a href="#last-event-id" {
											- "Last-Event-ID"
										}
									}
									- "`,\n       "
									var {
										- "lastEventIDValue"
									}
									- ") in "
									var {
										- "request"
									}
									- "'s "
									a href="https://fetch.spec.whatwg.org/#concept-request-header-list" id="sse-processing-model:concept-request-header-list" data-x-internal="concept-request-header-list" {
										- "header list"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							a href="https://fetch.spec.whatwg.org/#concept-fetch" id="sse-processing-model:concept-fetch" data-x-internal="concept-fetch" {
								- "Fetch"
							}
							- " "
							var {
								- "request"
							}
							- " and process the\n     response obtained in this fashion, if any, as described earlier in this section."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="fail-the-connection" {
				- "fail the connection"
			}
			- ", the user agent must "
			a href="#queue-a-task" id="sse-processing-model:queue-a-task-4" {
