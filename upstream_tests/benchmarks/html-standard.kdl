					- " to "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-documents:concept-event-fire" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named "
					code id="loading-documents:event-load-3" {
						a href="#event-load" {
							- "load"
						}
