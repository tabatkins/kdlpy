			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "hostSuffix"
					}
					- " does not "
					a href="https://url.spec.whatwg.org/#concept-host-equals" id="relaxing-the-same-origin-restriction:host-equals" data-x-internal="host-equals" {
