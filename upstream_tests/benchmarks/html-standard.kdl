												- "networking task source"
											}
											- ".)"
										}
										- "\n\n         "
									}
									li {
										p {
											- "Let "
											var {
												- "processEndOfMedia"
											}
											- " be the following step: If the fetching process has\n         completed without errors, including decoding the media data, and if all of the data is\n         available to the user agent without network access, then, the user agent must move on to\n         the "
											i {
												- "final step"
											}
											- " below. This might never happen, e.g. when streaming an infinite\n         resource such as web radio, or if the resource is longer than the user agent's ability to\n         cache data."
										}
									}
									li {
										p {
											- "If the result of "
											a href="#verify-a-media-response" id="loading-the-media-resource:verify-a-media-response" {
												- "verifying"
											}
											- "\n         "
											var {
												- "response"
											}
											- " given the "
											var {
												- "current media resource"
											}
											- " and "
											var {
												- "byteRange"
											}
											- "\n         is false, then abort these steps."
										}
									}
									li {
										p {
											- "Otherwise, "
											a href="https://fetch.spec.whatwg.org/#body-incrementally-read" id="loading-the-media-resource:body-incrementally-read" data-x-internal="body-incrementally-read" {
												- "incrementally read"
											}
											- "\n         "
											var {
												- "response"
											}
											- "'s "
											a href="https://fetch.spec.whatwg.org/#concept-response-body" id="loading-the-media-resource:concept-response-body" data-x-internal="concept-response-body" {
												- "body"
											}
											- " given\n         "
											var {
												- "updateMedia"
											}
											- ", "
											var {
												- "processEndOfMedia"
											}
											- ", an empty algorithm, and\n         "
											var {
												- "global"
											}
											- "."
										}
									}
									li {
										p {
											- "Update the "
											a href="#media-data" id="loading-the-media-resource:media-data-2" {
												- "media data"
											}
											- " with the contents of "
											var {
												- "response"
											}
											- "'s\n         "
											a href="#unsafe-response" id="loading-the-media-resource:unsafe-response-2" {
												- "unsafe response"
											}
											- " obtained in this fashion. "
											var {
												- "response"
											}
											- " can be\n         "
											a href="#cors-same-origin" id="loading-the-media-resource:cors-same-origin" {
												- "CORS-same-origin"
											}
											- " or "
											a href="#cors-cross-origin" id="loading-the-media-resource:cors-cross-origin-2" {
												- "CORS-cross-origin"
											}
											- "; this affects whether\n         subtitles referenced in the "
											a href="#media-data" id="loading-the-media-resource:media-data-3" {
												- "media data"
											}
											- " are exposed in the API and, for\n         "
											code id="loading-the-media-resource:the-video-element" {
												a href="#the-video-element" {
													- "video"
												}
											}
											- " elements, whether a"
											code id="loading-the-media-resource:the-canvas-element" {
												a href="#the-canvas-element" {
													- "canvas"
												}
											}
											- " gets tainted when the video is\n         drawn on it."
										}
									}
								}
								- "\n\n        "
								p {
									- "The "
									dfn id="stall-timeout" data-export="" {
										- "media element stall timeout"
									}
									- " is an\n        "
									a id="loading-the-media-resource:implementation-defined-3" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
										- "implementation-defined"
									}
									- " length of time, which should be about three seconds.\n        When a "
									a href="#media-element" id="loading-the-media-resource:media-element-44" {
										- "media element"
									}
									- " that is actively attempting to obtain "
									a href="#media-data" id="loading-the-media-resource:media-data-4" {
										- "media\n        data"
									}
									- " has failed to receive any data for a duration equal to the "
									a href="#stall-timeout" id="loading-the-media-resource:stall-timeout" {
										- "media element\n        stall timeout"
									}
									- ", the user agent must "
									a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-12" {
										- "queue a media element task"
									}
									- " given the\n        "
									a href="#media-element" id="loading-the-media-resource:media-element-45" {
										- "media element"
									}
									- " to:"
								}
								- "\n\n        "
								ol {
									li {
										p {
											a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-8" data-x-internal="concept-event-fire" {
												- "Fire an event"
											}
											- " named "
											code id="loading-the-media-resource:event-media-stalled" {
												a href="#event-media-stalled" {
													- "stalled"
												}
											}
											- " at the element."
										}
									}
									li {
										p {
											- "Set the element's "
											a href="#is-currently-stalled" id="loading-the-media-resource:is-currently-stalled-2" {
												- "is currently stalled"
											}
											- " to true."
										}
									}
								}
								- "\n\n        "
								p {
									- "User agents may allow users to selectively block or slow "
									a href="#media-data" id="loading-the-media-resource:media-data-5" {
										- "media data"
									}
									- " downloads.\n        When a "
									a href="#media-element" id="loading-the-media-resource:media-element-46" {
										- "media element"
									}
									- "'s download has been blocked altogether, the user agent must\n        act as if it was stalled (as opposed to acting as if the connection was closed). The rate of the\n        download may also be throttled automatically by the user agent, e.g. to balance the download\n        with other connections sharing the same bandwidth."
								}
								- "\n\n        "
								p id="resourceSuspend" {
									- "User agents may decide to not download more content at any time,\n        e.g. after buffering five minutes of a one hour media resource, while waiting for the user\n        to decide whether to play the resource or not, while waiting for user input in an\n        interactive resource, or when the user navigates away from the page. When a "
									a href="#media-element" id="loading-the-media-resource:media-element-47" {
										- "media\n        element"
									}
									- "'s download has been suspended, the user agent must "
									a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-13" {
										- "queue a media\n        element task"
									}
									- " given the "
									a href="#media-element" id="loading-the-media-resource:media-element-48" {
										- "media element"
									}
									- " to set the "
									code id="loading-the-media-resource:dom-media-networkstate-11" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- " to "
									code id="loading-the-media-resource:dom-media-network_idle-3" {
										a href="#dom-media-network_idle" {
											- "NETWORK_IDLE"
										}
									}
									- " and "
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-9" data-x-internal="concept-event-fire" {
										- "fire an event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-suspend-2" {
										a href="#event-media-suspend" {
											- "suspend"
										}
									}
									- " at the element. If and when downloading of the\n        resource resumes, the user agent must "
									a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-14" {
										- "queue a media element task"
									}
									- " given the\n        "
									a href="#media-element" id="loading-the-media-resource:media-element-49" {
										- "media element"
									}
									- " to set the "
									code id="loading-the-media-resource:dom-media-networkstate-12" {
										a href="#dom-media-networkstate" {
											- "networkState"
										}
									}
									- " to "
									code id="loading-the-media-resource:dom-media-network_loading-5" {
										a href="#dom-media-network_loading" {
											- "NETWORK_LOADING"
										}
									}
									- ". Between the queuing of these\n        tasks, the load is suspended (so "
									code id="loading-the-media-resource:event-media-progress" {
										a href="#event-media-progress" {
											- "progress"
										}
									}
									- " events\n        don't fire, as described above)."
								}
								- "\n\n        "
								p class="note" {
									- "The "
									code id="loading-the-media-resource:attr-media-preload-2" {
										a href="#attr-media-preload" {
											- "preload"
										}
									}
									- " attribute provides a hint\n        regarding how much buffering the author thinks is advisable, even in the absence of the "
									code id="loading-the-media-resource:attr-media-autoplay" {
										a href="#attr-media-autoplay" {
											- "autoplay"
										}
									}
									- " attribute."
								}
								- "\n\n        "
								p {
									- "When a user agent decides to completely suspend a download, e.g., if it is waiting until\n        the user starts playback before downloading any further content, the user agent must\n        "
									a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-15" {
										- "queue a media element task"
									}
									- " given the "
									a href="#media-element" id="loading-the-media-resource:media-element-50" {
										- "media element"
									}
									- " to set the\n        element's "
									a href="#delaying-the-load-event-flag" id="loading-the-media-resource:delaying-the-load-event-flag-9" {
										- "delaying-the-load-event flag"
									}
									- " to false. This stops "
									a href="#delay-the-load-event" id="loading-the-media-resource:delay-the-load-event-9" {
										- "delaying the load event"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "Although the above steps give an algorithm for issuing requests, the user agent may use\n        other means besides those exact ones, especially in the face of error conditions. For\n        example, the user agent may reconnect to the server or switch to a streaming protocol. The\n        user agent must only consider the resource erroneous, and proceed into the error branches\n        of the above steps, if the user agent has given up trying to fetch the resource."
								}
								- "\n\n        "
								p {
									- "To determine the format of the "
									a href="#media-resource" id="loading-the-media-resource:media-resource-5" {
										- "media resource"
									}
									- ", the user agent must use the\n        "
									a href="https://mimesniff.spec.whatwg.org/#rules-for-sniffing-audio-and-video-specifically" id="loading-the-media-resource:content-type-sniffing:-video" data-x-internal="content-type-sniffing:-video" {
										- "rules for sniffing audio and video specifically"
									}
									- "."
								}
								- "\n\n        "
								p {
									- "While the load is not suspended (see below), every 350ms (±200ms) or for every byte\n        received, whichever is "
									em {
										- "least"
									}
									- " frequent, "
									a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-16" {
										- "queue a media element task"
									}
									- "\n        given the "
									a href="#media-element" id="loading-the-media-resource:media-element-51" {
										- "media element"
									}
									- " to:\n\n        "
								}
								ol {
									li {
										p {
											a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-10" data-x-internal="concept-event-fire" {
												- "Fire an event"
											}
											- " named "
											code id="loading-the-media-resource:event-media-progress-2" {
												a href="#event-media-progress" {
													- "progress"
												}
											}
											- " at the element."
										}
									}
									li {
										p {
											- "Set the element's "
											a href="#is-currently-stalled" id="loading-the-media-resource:is-currently-stalled-3" {
												- "is currently stalled"
											}
											- " to false."
										}
									}
								}
								- "\n\n        "
								p {
									- "While the user agent might still need network access to obtain parts of the "
									a href="#media-resource" id="loading-the-media-resource:media-resource-6" {
										- "media\n        resource"
									}
									- ", the user agent must remain on this step."
								}
								- "\n\n        "
								p class="example" {
									- "For example, if the user agent has discarded the first half of a video, the\n        user agent will remain at this step even once the "
									a href="#ended-playback" id="loading-the-media-resource:ended-playback" {
										- "playback has\n        ended"
									}
									- ", because there is always the chance the user will seek back to the start. In fact,\n        in this situation, once "
									a href="#ended-playback" id="loading-the-media-resource:ended-playback-2" {
										- "playback has ended"
									}
									- ", the user agent\n        will end up firing a "
									code id="loading-the-media-resource:event-media-suspend-3" {
										a href="#event-media-suspend" {
											- "suspend"
										}
									}
									- " event, as described\n        earlier."
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					dt {
						- "Otherwise ("
						var {
							- "mode"
						}
						- " is "
						i {
							- "local"
						}
						- ")"
					}
					dd {
						- "\n      "
						p {
							- "The resource described by the "
							var {
								- "current media resource"
							}
							- ", if any, contains the\n      "
							a href="#media-data" id="loading-the-media-resource:media-data-6" {
								- "media data"
							}
							- ". It is "
							a href="#cors-same-origin" id="loading-the-media-resource:cors-same-origin-2" {
								- "CORS-same-origin"
							}
							- ". "
						}
						- "\n\n      "
						p {
							- "If the "
							var {
								- "current media resource"
							}
							- " is a raw data stream (e.g. from a\n      "
							code id="loading-the-media-resource:file" {
								a data-x-internal="file" href="https://w3c.github.io/FileAPI/#dfn-file" {
									- "File"
								}
							}
							- " object), then to determine the format of the "
							a href="#media-resource" id="loading-the-media-resource:media-resource-7" {
								- "media resource"
							}
							- ",\n      the user agent must use the "
							a href="https://mimesniff.spec.whatwg.org/#rules-for-sniffing-audio-and-video-specifically" id="loading-the-media-resource:content-type-sniffing:-video-2" data-x-internal="content-type-sniffing:-video" {
								- "rules for sniffing\n      audio and video specifically"
							}
							- ". Otherwise, if the data stream is pre-decoded, then the\n      format is the format given by the relevant specification."
						}
						- "\n\n      "
						p {
							- "Whenever new data for the "
							var {
								- "current media resource"
							}
							- " becomes available, "
							a href="#queue-a-media-element-task" id="loading-the-media-resource:queue-a-media-element-task-17" {
								- "queue\n      a media element task"
							}
							- " given the "
							a href="#media-element" id="loading-the-media-resource:media-element-52" {
								- "media element"
							}
							- " to run the first appropriate\n      steps from the "
							a href="#media-data-processing-steps-list" id="loading-the-media-resource:media-data-processing-steps-list-2" {
								- "media data processing steps list"
							}
							- " below."
						}
						- "\n\n      "
						p {
							- "When the "
							var {
								- "current media resource"
							}
							- " is permanently exhausted (e.g. all the bytes of\n      a "
							code id="loading-the-media-resource:blob" {
								a data-x-internal="blob" href="https://w3c.github.io/FileAPI/#dfn-Blob" {
									- "Blob"
								}
							}
							- " have been processed), if there were no decoding errors, then the user\n      agent must move on to the "
							i {
								- "final step"
							}
							- " below. This might never happen, e.g. if the\n      "
							var {
								- "current media resource"
							}
							- " is a "
							code id="loading-the-media-resource:mediastream" {
								a data-x-internal="mediastream" href="https://w3c.github.io/mediacapture-main/getusermedia.html#idl-def-mediastream" {
									- "MediaStream"
								}
							}
							- "."
						}
						- "\n     "
					}
				}
				- "\n\n    "
				p {
					- "The "
					dfn id="media-data-processing-steps-list" {
						- "media data processing steps list"
					}
					- " is as follows:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If the "
						a href="#media-data" id="loading-the-media-resource:media-data-7" {
							- "media data"
						}
						- " cannot be fetched at all, due to network errors, causing the\n     user agent to give up trying to fetch the resource"
					}
					dt {
						- "If the "
						a href="#media-data" id="loading-the-media-resource:media-data-8" {
							- "media data"
						}
						- " can be fetched but is found by inspection to be in an\n     unsupported format, or can otherwise not be rendered at all"
					}
					dd {
						- "\n      "
						p {
							- "DNS errors, HTTP 4xx and 5xx errors (and equivalents in other protocols), and other fatal\n      network errors that occur before the user agent has established whether the "
							var {
								- "current media resource"
							}
							- " is usable, as well as the file using an unsupported\n      container format, or using unsupported codecs for all the data, must cause the user agent to\n      execute the following steps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "The user agent should cancel the fetching process."
								}
							}
							li {
								p {
									- "Abort this subalgorithm, returning to the "
									a href="#concept-media-load-algorithm" id="loading-the-media-resource:concept-media-load-algorithm-3" {
										- "resource selection algorithm"
									}
									- "."
								}
								- "\n      "
							}
						}
						- "\n     "
					}
					dt id="found-another-audio-track" {
						- "If the "
						a href="#media-resource" id="loading-the-media-resource:media-resource-8" {
							- "media resource"
						}
						- " is found to have an audio\n     track"
					}
					dd {
						- "\n      "
						ol {
							li {
								p {
									- "Create an "
									code id="loading-the-media-resource:audiotrack" {
										a href="#audiotrack" {
											- "AudioTrack"
										}
									}
									- " object to represent the audio track."
								}
							}
							li {
								p {
									- "Update the "
									a href="#media-element" id="loading-the-media-resource:media-element-53" {
										- "media element"
									}
									- "'s "
									code id="loading-the-media-resource:dom-media-audiotracks" {
										a href="#dom-media-audiotracks" {
											- "audioTracks"
										}
									}
									- " attribute's "
									code id="loading-the-media-resource:audiotracklist" {
										a href="#audiotracklist" {
											- "AudioTrackList"
										}
									}
									- "\n       object with the new "
									code id="loading-the-media-resource:audiotrack-2" {
										a href="#audiotrack" {
											- "AudioTrack"
										}
									}
									- " object."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "enable"
									}
									- " be "
									i {
										- "unknown"
									}
									- "."
								}
							}
							li {
								- "\n        "
								p {
									- "If either the "
									a href="#media-resource" id="loading-the-media-resource:media-resource-9" {
										- "media resource"
									}
									- " or the "
									a id="loading-the-media-resource:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
										- "URL"
									}
									- " of the "
									var {
										- "current\n        media resource"
									}
									- " indicate a particular set of audio tracks to enable, or if the user\n        agent has information that would facilitate the selection of specific audio tracks to\n        improve the user's experience, then: if this audio track is one of the ones to enable, then\n        set "
									var {
										- "enable"
									}
									- " to "
									i {
										- "true"
									}
									- ", otherwise, set "
									var {
										- "enable"
									}
									- "\n        to "
									i {
										- "false"
									}
									- "."
								}
								- "\n\n        "
								p class="example" {
									- "This could be triggered by "
									a id="loading-the-media-resource:media-fragment-syntax" href="https://www.w3.org/TR/media-frags/#media-fragment-syntax" data-x-internal="media-fragment-syntax" {
										- "media fragment syntax"
									}
									- ", but it\n        could also be triggered e.g. by the user agent selecting a 5.1 surround sound audio track\n        over a stereo audio track."
								}
								- "\n       "
							}
							li {
								p {
									- "If "
									var {
										- "enable"
									}
									- " is still "
									i {
										- "unknown"
									}
									- ", then, if the "
									a href="#media-element" id="loading-the-media-resource:media-element-54" {
										- "media\n       element"
									}
									- " does not yet have an "
									a href="#dom-audiotrack-enabled" id="loading-the-media-resource:dom-audiotrack-enabled" {
										- "enabled"
									}
									- "\n       audio track, then set "
									var {
										- "enable"
									}
									- " to "
									i {
										- "true"
									}
									- ", otherwise, set "
									var {
										- "enable"
									}
									- " to "
									i {
										- "false"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "enable"
									}
									- " is "
									i {
										- "true"
									}
									- ", then enable this audio track,\n       otherwise, do not enable this audio track."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-11" data-x-internal="concept-event-fire" {
										- "Fire an event"
									}
									- " named "
									code id="loading-the-media-resource:event-media-addtrack" {
