		- "\n\n  "
		p {
			- "When the steps above require the UA to "
			dfn id="clear-the-stack-back-to-a-table-context" {
				- "clear the stack back to a table context"
			}
			- ", it\n  means that the UA must, while the "
			a href="#current-node" id="parsing-main-intable:current-node-2" {
				- "current node"
