		- "\n\n  "
		p {
			- "Set the "
			var id="numeric-character-reference-end-state:temporary-buffer" {
				a href="#temporary-buffer" {
					- "temporary buffer"
				}
			}
			- " to the empty string. Append a\n  code point equal to the "
