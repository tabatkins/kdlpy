							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"Promise.resolve('import(`./example.mjs`)').then(eval)\""
							}
							c- p="" {
								- ">"
							}
							- "Click me"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "button"
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n     "
					p {
						- "In this case, the JavaScript function for the "
						a href="#event-handlers" id="hostmakejobcallback:event-handlers" {
							- "event\n     handler"
						}
						- " will be created by the "
						a href="#getting-the-current-value-of-the-event-handler" id="hostmakejobcallback:getting-the-current-value-of-the-event-handler" {
							- "get the current value of the event handler"
						}
						- " algorithm, which creates a function\n     with null [[ScriptOrModule]] value. Thus, when the promise machinery calls\n     "
						a href="#hostmakejobcallback" id="hostmakejobcallback:hostmakejobcallback" {
							- "HostMakeJobCallback"
						}
						- ", there will be no "
						a href="#active-script" id="hostmakejobcallback:active-script-4" {
							- "active script"
						}
						- " to pass\n     along."
					}
					- "\n\n     "
					p {
						- "As a consequence, this means that when the "
						code id="hostmakejobcallback:import()-3" {
							a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" {
								- "import()"
							}
						}
						- " expression is evaluated,\n     there will still be no "
						a href="#active-script" id="hostmakejobcallback:active-script-5" {
							- "active script"
						}
						- ". Fortunately that is handled by our\n     implementation of "
						a href="#hostloadimportedmodule" id="hostmakejobcallback:hostloadimportedmodule" {
							- "HostLoadImportedModule"
						}
						- " by falling back to using the\n     "
						a href="#current-settings-object" id="hostmakejobcallback:current-settings-object" {
							- "current settings object"
						}
						- "'s "
						a href="#api-base-url" id="hostmakejobcallback:api-base-url" {
							- "API base URL"
						}
						- "."
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				p {
					- "Return the "
					a id="hostmakejobcallback:jobcallback-record" href="https://tc39.es/ecma262/#sec-jobcallback-records" data-x-internal="jobcallback-record" {
						- "JobCallback Record"
					}
					- " { [[Callback]]: "
					var {
						- "callable"
					}
					- ",\n   [[HostDefined]]: { [[IncumbentSettings]]: "
					var {
						- "incumbent settings"
					}
					- ", [[ActiveScriptContext]]:\n   "
					var {
						- "script execution context"
					}
					- " } }."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h5 id="integration-with-the-javascript-module-system" {
			span class="secno" {
				- "8.1.6.7"
			}
			- " Module-related host hooks"
			a href="#integration-with-the-javascript-module-system" class="self-link"
		}
		- "\n\n  "
		p {
			- "The JavaScript specification defines a syntax for modules, as well as some host-agnostic parts\n  of their processing model. This specification defines the rest of their processing model: how the\n  module system is bootstrapped, via the "
			code id="integration-with-the-javascript-module-system:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element with "
			code id="integration-with-the-javascript-module-system:attr-script-type" {
				a href="#attr-script-type" {
					- "type"
				}
			}
			- " attribute set to \""
			code {
				- "module"
			}
			- "\", and how\n  modules are fetched, resolved, and executed. "
			a href="#refsJAVASCRIPT" {
				- "[JAVASCRIPT]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "Although the JavaScript specification speaks in terms of \"scripts\" versus\n  \"modules\", in general this specification speaks in terms of "
			a href="#classic-script" id="integration-with-the-javascript-module-system:classic-script" {
				- "classic\n  scripts"
			}
			- " versus "
			a href="#module-script" id="integration-with-the-javascript-module-system:module-script" {
				- "module scripts"
			}
			- ", since both of them use\n  the "
			code id="integration-with-the-javascript-module-system:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "modulePromise"
					}
					- " = "
					a href="https://tc39.es/ecma262/#sec-import-calls" id="integration-with-the-javascript-module-system:import()" data-x-internal="import()" {
						- "import("
						var {
							- "specifier"
						}
						- ")"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns a promise for the module namespace object for the "
					a href="#module-script" id="integration-with-the-javascript-module-system:module-script-2" {
						- "module script"
					}
					- "\n    identified by "
					var {
						- "specifier"
					}
					- ". This allows dynamic importing of module scripts at runtime,\n    instead of statically using the "
					code {
						- "import"
					}
					- " statement form. The specifier will\n    be "
					a href="#resolve-a-module-specifier" id="integration-with-the-javascript-module-system:resolve-a-module-specifier" {
						- "resolved"
					}
					- " relative to the "
					a href="#active-script" id="integration-with-the-javascript-module-system:active-script" {
						- "active\n    script"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "The returned promise will be rejected if an invalid specifier is given, or if a failure is\n    encountered while "
					a href="#hostloadimportedmodule" id="integration-with-the-javascript-module-system:hostloadimportedmodule" {
						- "fetching"
					}
					- " or evaluating the\n    resulting module graph."
				}
				- "\n\n    "
				p {
					- "This syntax can be used inside both "
					a href="#classic-script" id="integration-with-the-javascript-module-system:classic-script-2" {
						- "classic"
					}
					- " and "
					a href="#module-script" id="integration-with-the-javascript-module-system:module-script-3" {
						- "module scripts"
					}
					- ". It thus provides a bridge into the module-script\n    world, from the classic-script world."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "url"
					}
					- " = "
					a href="https://tc39.es/ecma262/#sec-meta-properties" id="integration-with-the-javascript-module-system:import.meta" data-x-internal="import.meta" {
						- "import.meta"
					}
					- "."
					a href="#import-meta-url" id="integration-with-the-javascript-module-system:import-meta-url" {
						- "url"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the "
					a href="#active-script" id="integration-with-the-javascript-module-system:active-script-2" {
						- "active module script"
					}
					- "'s "
					a href="#concept-script-base-url" id="integration-with-the-javascript-module-system:concept-script-base-url" {
						- "base URL"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "This syntax can only be used inside "
					a href="#module-script" id="integration-with-the-javascript-module-system:module-script-4" {
						- "module scripts"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "url"
					}
					- " = "
					a href="https://tc39.es/ecma262/#sec-meta-properties" id="integration-with-the-javascript-module-system:import.meta-2" data-x-internal="import.meta" {
						- "import.meta"
					}
					- "."
					a href="#import-meta-resolve" id="integration-with-the-javascript-module-system:import-meta-resolve" {
						- "resolve"
					}
					- "("
					var {
						- "specifier"
					}
					- ")"
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns "
					var {
						- "specifier"
					}
					- ", "
					a href="#resolve-a-module-specifier" id="integration-with-the-javascript-module-system:resolve-a-module-specifier-2" {
						- "resolved"
					}
					- "\n    relative to the "
					a href="#active-script" id="integration-with-the-javascript-module-system:active-script-3" {
						- "active script"
					}
					- ". That is, this returns the URL that would be imported\n    by using "
					code id="integration-with-the-javascript-module-system:import()-2" {
						a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" {
							- "import("
							var {
								- "specifier"
							}
							- ")"
						}
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Throws a "
					code id="integration-with-the-javascript-module-system:typeerror" {
						a data-x-internal="typeerror" href="https://tc39.es/ecma262/#sec-native-error-types-used-in-this-standard-typeerror" {
							- "TypeError"
						}
					}
					- " exception if an invalid specifier is given."
				}
				- "\n\n    "
				p {
					- "This syntax can only be used inside "
					a href="#module-script" id="integration-with-the-javascript-module-system:module-script-5" {
						- "module scripts"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="module-map" {
				- "module map"
			}
			- " is a "
			a href="https://infra.spec.whatwg.org/#ordered-map" id="integration-with-the-javascript-module-system:ordered-map" data-x-internal="ordered-map" {
				- "map"
			}
			- " keyed by "
			a href="https://infra.spec.whatwg.org/#tuple" id="integration-with-the-javascript-module-system:tuple" data-x-internal="tuple" {
				- "tuples"
			}
			- " consisting of a "
			a id="integration-with-the-javascript-module-system:url-record" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url-record" {
				- "URL record"
			}
			- " and a "
			a id="integration-with-the-javascript-module-system:string" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
			}
			- ".\n  The "
			a id="integration-with-the-javascript-module-system:url-record-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url-record" {
				- "URL record"
			}
			- " is the "
			a href="https://fetch.spec.whatwg.org/#concept-request-url" id="integration-with-the-javascript-module-system:concept-request-url" data-x-internal="concept-request-url" {
				- "request URL"
			}
			- " at which\n  the module was fetched, and the "
			a id="integration-with-the-javascript-module-system:string-2" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
			}
			- " indicates the type of the module (e.g. \""
			code {
				- "javascript-or-wasm"
			}
			- "\"). The "
			a href="#module-map" id="integration-with-the-javascript-module-system:module-map" {
				- "module map"
			}
			- "'s values are either a\n  "
			a href="#module-script" id="integration-with-the-javascript-module-system:module-script-6" {
				- "module script"
			}
			- ", null (used to represent failed fetches), or a placeholder value \""
			code {
				- "fetching"
			}
			- "\". "
			a href="#module-map" id="integration-with-the-javascript-module-system:module-map-2" {
				- "Module maps"
			}
			- " are used to ensure\n  that imported module scripts are only fetched, parsed, and evaluated once per\n  "
			code id="integration-with-the-javascript-module-system:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " or "
			a href="#workers" {
				- "worker"
			}
			- "."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Since "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-3" {
					- "module maps"
				}
				- " are keyed by (URL, module type), the\n   following code will create three separate entries in the "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-4" {
					- "module map"
				}
				- ", since it\n   results in three different (URL, module type) "
				a href="https://infra.spec.whatwg.org/#tuple" id="integration-with-the-javascript-module-system:tuple-2" data-x-internal="tuple" {
					- "tuples"
				}
				- " (all with \""
				code {
					- "javascript-or-wasm"
				}
				- "\" type):"
			}
			- "\n\n   "
			pre {
				code class="js" {
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module.mjs\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module.mjs#map-buster\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module.mjs?debug=true\""
					}
					c- p="" {
						- ";"
					}
				}
			}
			- "\n\n   "
			p {
				- "That is, URL "
				a href="https://url.spec.whatwg.org/#concept-url-query" id="integration-with-the-javascript-module-system:concept-url-query" data-x-internal="concept-url-query" {
					- "queries"
				}
				- " and "
				a href="https://url.spec.whatwg.org/#concept-url-fragment" id="integration-with-the-javascript-module-system:concept-url-fragment" data-x-internal="concept-url-fragment" {
					- "fragments"
				}
				- " can be varied to create distinct entries in the\n   "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-5" {
					- "module map"
				}
				- "; they are not ignored. Thus, three separate fetches and three separate\n   module evaluations will be performed."
			}
			- "\n\n   "
			p {
				- "In contrast, the following code would only create a single entry in the "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-6" {
					- "module\n   map"
				}
				- ", since after applying the "
				a id="integration-with-the-javascript-module-system:url-parser" href="https://url.spec.whatwg.org/#concept-url-parser" data-x-internal="url-parser" {
					- "URL parser"
				}
				- " to these inputs, the resulting "
				a href="https://url.spec.whatwg.org/#concept-url" id="integration-with-the-javascript-module-system:url-record-3" data-x-internal="url-record" {
					- "URL records"
				}
				- " are equal:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module2.mjs\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https:example.com/module2.mjs\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://///example.com\\\\module2.mjs\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/foo/../module2.mjs\""
					}
					c- p="" {
						- ";"
					}
				}
			}
			- "\n\n   "
			p {
				- "So in this second example, only one fetch and one module evaluation will occur."
			}
			- "\n\n   "
			p {
				- "Note that this behavior is the same as how "
				a href="#sharedworker" id="integration-with-the-javascript-module-system:sharedworker" {
					- "shared workers"
				}
				- " are keyed by their parsed "
				a href="#concept-sharedworkerglobalscope-constructor-url" id="integration-with-the-javascript-module-system:concept-sharedworkerglobalscope-constructor-url" {
					- "constructor url"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Since module type is also part of the "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-7" {
					- "module map"
				}
				- " key, the following code will\n   create two separate entries in the "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-8" {
					- "module map"
				}
				- " (the type is \""
				code {
					- "javascript-or-wasm"
				}
				- "\" for the first, and \""
				code {
					- "css"
				}
				- "\" for the\n   second):"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "module"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module\""
					}
					c- p="" {
						- ";"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "module"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- k="" {
						- "import"
					}
					- " "
					c- u="" {
						- "\"https://example.com/module\""
					}
					- " "
					c- a="" {
						- "with"
					}
					- " "
					c- p="" {
						- "{"
					}
					- " type"
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"css\""
					}
					- " "
					c- p="" {
						- "};"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "This can result in two separate fetches and two separate module evaluations being performed."
			}
			- "\n\n   "
			p class="XXX" {
				- "In practice, due to the as-yet-unspecified memory cache (see issue "
				a href="https://github.com/whatwg/html/issues/6110" {
					- "#6110"
				}
				- ") the resource may only be fetched\n   once in WebKit and Blink-based browsers. Additionally, as long as all module types are mutually\n   exclusive, the module type check in "
				a href="#fetch-a-single-module-script" id="integration-with-the-javascript-module-system:fetch-a-single-module-script" {
					- "fetch a single module script"
				}
				- " will fail for at\n   least one of the imports, so at most one module evaluation will occur."
			}
			- "\n\n   "
			p {
				- "The purpose of including the type in the "
				a href="#module-map" id="integration-with-the-javascript-module-system:module-map-9" {
					- "module map"
				}
				- " key is so that an import\n   with the wrong type attribute does not prevent a different import of the same specifier but with\n   the correct type from succeeding."
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "JavaScript module scripts are the default import type when importing from another JavaScript\n    module; that is, when an "
				code {
					- "import"
				}
				- " statement lacks a "
				code {
					- "type"
				}
				- " import attribute the imported module script's type will be JavaScript.\n    Attempting to import a JavaScript resource using an "
				code {
					- "import"
				}
				- " statement with\n    a "
				code {
					- "type"
				}
				- " import attribute will fail:"
			}
			- "\n\n    "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"module\""
					}
					c- p="" {
						- ">"
					}
