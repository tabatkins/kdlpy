		p {
			- "A "
			a href="#form-associated-element" id="association-of-controls-and-forms:form-associated-element-4" {
				- "form-associated element"
			}
			- " is, by default, associated with its nearest ancestor "
			code id="association-of-controls-and-forms:the-form-element-3" {
