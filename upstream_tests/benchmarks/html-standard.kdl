		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "To ensure "
			a href="#concept-custom-element-reaction" id="custom-element-reactions:concept-custom-element-reaction-4" {
				- "custom element reactions"
			}
			- " are\n  triggered appropriately, we introduce the "
			dfn id="cereactions" data-dfn-type="extended-attribute" data-lt="CEReactions" {
				code {
					- "[CEReactions]"
				}
			}
			- " IDL "
			a id="custom-element-reactions:extended-attribute" href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" data-x-internal="extended-attribute" {
				- "extended attribute"
			}
			- ". It\n  indicates that the relevant algorithm is to be supplemented with additional steps in order to\n  appropriately track and invoke "
			a href="#concept-custom-element-reaction" id="custom-element-reactions:concept-custom-element-reaction-5" {
				- "custom element\n  reactions"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="custom-element-reactions:cereactions-2" {
				a href="#cereactions" {
					- "[CEReactions]"
				}
			}
			- " extended attribute must take no\n  arguments, and must not appear on anything other than an operation, attribute, setter, or deleter.\n  Additionally, it must not appear on readonly attributes."
		}
		- "\n\n  "
		p {
			- "Operations, attributes, setters, or deleters annotated with the "
			code id="custom-element-reactions:cereactions-3" {
				a href="#cereactions" {
					- "[CEReactions]"
				}
			}
			- " extended attribute must run the following steps in place\n  of the ones specified in their description:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="https://infra.spec.whatwg.org/#stack-push" id="custom-element-reactions:stack-push" data-x-internal="stack-push" {
						- "Push"
					}
					- " a new "
					a href="#element-queue" id="custom-element-reactions:element-queue-5" {
						- "element queue"
					}
					- " onto this object's\n   "
					a href="#relevant-agent" id="custom-element-reactions:relevant-agent-3" {
						- "relevant agent"
					}
					- "'s "
					a href="#custom-element-reactions-stack" id="custom-element-reactions:custom-element-reactions-stack-5" {
						- "custom element reactions stack"
					}
					- "."
				}
			}
			li {
				p {
					- "Run the originally-specified steps for this construct, catching any exceptions. If the\n   steps return a value, let "
					var {
						- "value"
					}
					- " be the returned value. If they throw an exception, let\n   "
					var {
						- "exception"
					}
					- " be the thrown exception."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "queue"
					}
					- " be the result of "
					a href="https://infra.spec.whatwg.org/#stack-pop" id="custom-element-reactions:stack-pop" data-x-internal="stack-pop" {
						- "popping"
					}
