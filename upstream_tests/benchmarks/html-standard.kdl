		- "\n\n  \n\n\n  \n\n  "
		h4 id="attributes-for-embedded-content-and-images" {
			span class="secno" {
				- "15.4.3"
			}
			- " Attributes for embedded content and images"
			a href="#attributes-for-embedded-content-and-images" class="self-link"
		}
		- "\n\n  "
		p {
			- "The following CSS rules are expected to apply as "
			a href="#presentational-hints" id="attributes-for-embedded-content-and-images:presentational-hints" {
				- "presentational hints"
			}
			- ":"
		}
		- "\n\n  "
		pre {
			code class="css" {
				c- n="" {
					- "@namespace"
				}
				- " "
				c- s="" {
					- "\"http://www.w3.org/1999/xhtml\""
				}
				c- p="" {
					- ";"
				}
				- "\n\n"
				c- f="" {
					- "iframe[frameborder='0'], iframe[frameborder=no i] "
				}
				c- p="" {
					- "{"
				}
				- " "
				c- k="" {
					- "border"
				}
				c- p="" {
