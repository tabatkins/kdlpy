						- "stack of open\n   elements"
					}
					- "."
				}
			}
			li {
				p {
					i {
						- "Loop"
					}
					- ": If "
					var {
						- "node"
					}
					- " is the first node in the stack of open elements, then set\n   "
					var {
						- "last"
					}
					- " to true, and, if the parser was created as part of the "
					a href="#html-fragment-parsing-algorithm" id="the-insertion-mode:html-fragment-parsing-algorithm" {
