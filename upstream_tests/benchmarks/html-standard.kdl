		- "\n\n  "
		p {
			- "For the purposes of this algorithm, a file "
			dfn id="concept-extension" {
				- "extension"
			}
			- "\n  consists of any part of the filename that platform conventions dictate will be used for\n  identifying the type of the file. For example, many operating systems use the part of the filename\n  following the last dot (\""
			code {
				- "."
			}
			- "\") in the filename to determine the type of the\n  file, and from that the manner in which the file is to be opened or executed."
		}
		- "\n\n  "
		p {
			- "User agents should ignore any directory or path information provided by the resource itself,\n  its "
			a id="downloading-resources:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- ", and any "
			code id="downloading-resources:attr-hyperlink-download-8" {
				a href="#attr-hyperlink-download" {
					- "download"
				}
			}
			- " attribute, in\n  deciding where to store the resulting file in the user's file system."
		}
		- "\n\n  \n\n\n  "
		h4 id="hyperlink-auditing" {
			span class="secno" {
				- "4.6.6"
			}
			- " "
			dfn {
				- "Hyperlink auditing"
			}
			a href="#hyperlink-auditing" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			- "If a "
			a href="#hyperlink" id="hyperlink-auditing:hyperlink" {
				- "hyperlink"
			}
			- " created by an "
			code id="hyperlink-auditing:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " or "
			code id="hyperlink-auditing:the-area-element" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " element has a\n  "
			code id="hyperlink-auditing:ping" {
				a href="#ping" {
					- "ping"
				}
			}
			- " attribute, and the user follows the hyperlink, and\n  the value of the element's "
			code id="hyperlink-auditing:attr-hyperlink-href" {
				a href="#attr-hyperlink-href" {
					- "href"
				}
			}
			- " attribute can be "
			a href="#encoding-parsing-a-url" id="hyperlink-auditing:encoding-parsing-a-url" {
				- "parsed"
			}
			- ", relative to the element's "
			a id="hyperlink-auditing:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node\n  document"
			}
			- ", without failure, then the user agent must take the "
			code id="hyperlink-auditing:ping-2" {
				a href="#ping" {
					- "ping"
				}
			}
			- " attribute's value, "
			a href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id="hyperlink-auditing:split-a-string-on-spaces" data-x-internal="split-a-string-on-spaces" {
				- "split that string on ASCII whitespace"
			}
			- ", "
			a href="#encoding-parsing-a-url" id="hyperlink-auditing:encoding-parsing-a-url-2" {
				- "parse"
			}
			- " each resulting token, relative to the element's "
			a id="hyperlink-auditing:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node document"
			}
			- ", and\n  then run these steps for each resulting "
			a id="hyperlink-auditing:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- " "
			var {
				- "ping URL"
			}
			- ", ignoring when\n  parsing returns failure:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "ping URL"
					}
					- "'s "
					a href="https://url.spec.whatwg.org/#concept-url-scheme" id="hyperlink-auditing:concept-url-scheme" data-x-internal="concept-url-scheme" {
