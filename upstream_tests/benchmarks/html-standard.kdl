				- "\n\n    "
				p {
					- "Otherwise, if the document is "
					em {
						- "not"
					}
					- " "
					a href="#an-iframe-srcdoc-document" id="the-initial-insertion-mode:an-iframe-srcdoc-document-2" {
						- "an "
						code {
							- "iframe"
						}
						- " "
						code {
							- "srcdoc"
						}
						- " document"
					}
					- ", and the "
					a href="#parser-cannot-change-the-mode-flag" id="the-initial-insertion-mode:parser-cannot-change-the-mode-flag-2" {
						- "parser cannot change\n    the mode flag"
					}
					- " is false, and the DOCTYPE token matches one of the conditions in the\n    following list, then set the "
