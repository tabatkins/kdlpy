							- "descriptions"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If there are any "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-8" {
						- "text tracks"
					}
					- " in the "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-13" {
						- "media\n   element"
					}
					- "'s "
					a href="#list-of-text-tracks" id="sourcing-out-of-band-text-tracks:list-of-text-tracks-4" {
						- "list of text tracks"
					}
					- " whose "
					a href="#text-track-kind" id="sourcing-out-of-band-text-tracks:text-track-kind-3" {
						- "text track kind"
					}
					- " is "
					code id="sourcing-out-of-band-text-tracks:dom-texttrack-kind-metadata-2" {
						a href="#dom-texttrack-kind-metadata" {
							- "chapters"
						}
					}
					- " or "
					code id="sourcing-out-of-band-text-tracks:dom-texttrack-kind-metadata-3" {
						a href="#dom-texttrack-kind-metadata" {
							- "metadata"
						}
					}
					- " that correspond to "
					code id="sourcing-out-of-band-text-tracks:the-track-element-7" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- "\n   elements with a "
					code id="sourcing-out-of-band-text-tracks:attr-track-default" {
						a href="#attr-track-default" {
							- "default"
						}
					}
					- " attribute set whose "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-2" {
						- "text\n   track mode"
					}
					- " is set to "
					a href="#text-track-disabled" id="sourcing-out-of-band-text-tracks:text-track-disabled-2" {
						- "disabled"
					}
					- ", then set the\n   "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-3" {
						- "text track mode"
					}
					- " of all such tracks to "
					a href="#text-track-hidden" id="sourcing-out-of-band-text-tracks:text-track-hidden" {
						- "hidden"
					}
					- "."
				}
			}
			li {
				p {
					- "Set the element's "
					a href="#did-perform-automatic-track-selection" id="sourcing-out-of-band-text-tracks:did-perform-automatic-track-selection-2" {
						- "did-perform-automatic-track-selection"
					}
					- " flag to\n   true."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the steps above say to "
			dfn id="perform-automatic-text-track-selection" {
				- "perform automatic text track selection"
			}
			- " for one or more\n  "
			a href="#text-track-kind" id="sourcing-out-of-band-text-tracks:text-track-kind-4" {
				- "text track kinds"
			}
			- ", it means to run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "candidates"
					}
					- " be a list consisting of the "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-9" {
						- "text tracks"
					}
					- " in the "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-14" {
						- "media element"
					}
					- "'s "
					a href="#list-of-text-tracks" id="sourcing-out-of-band-text-tracks:list-of-text-tracks-5" {
						- "list of text tracks"
					}
					- "\n   whose "
					a href="#text-track-kind" id="sourcing-out-of-band-text-tracks:text-track-kind-5" {
						- "text track kind"
					}
					- " is one of the kinds that were passed to the algorithm, if any,\n   in the order given in the "
					a href="#list-of-text-tracks" id="sourcing-out-of-band-text-tracks:list-of-text-tracks-6" {
						- "list of text tracks"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "candidates"
					}
					- " is empty, then return."
				}
			}
			li {
				p {
					- "If any of the "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-10" {
						- "text tracks"
					}
					- " in "
					var {
						- "candidates"
					}
					- " have a "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-4" {
						- "text track mode"
					}
					- " set to "
					a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing" {
						- "showing"
					}
					- ", return."
				}
			}
			li {
				- "\n    "
				p {
					- "If the user has expressed an interest in having a track from "
					var {
						- "candidates"
					}
					- "\n    enabled based on its "
					a href="#text-track-kind" id="sourcing-out-of-band-text-tracks:text-track-kind-6" {
						- "text track kind"
					}
					- ", "
					a href="#text-track-language" id="sourcing-out-of-band-text-tracks:text-track-language-2" {
						- "text track language"
					}
					- ", and\n    "
					a href="#text-track-label" id="sourcing-out-of-band-text-tracks:text-track-label-2" {
						- "text track label"
					}
					- ", then set its "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-5" {
						- "text track mode"
					}
					- " to "
					a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-2" {
						- "showing"
					}
					- "."
				}
				- " \n\n    "
				p class="note" {
					- "For example, the user could have set a browser preference to the effect of \"I\n    want French captions whenever possible\", or \"If there is a subtitle track with 'Commentary' in\n    the title, enable it\", or \"If there are audio description tracks available, enable one, ideally\n    in Swiss German, but failing that in Standard Swiss German or Standard German\"."
				}
				- "\n\n    "
				p {
					- "Otherwise, if there are any "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-11" {
						- "text tracks"
					}
					- " in "
					var {
						- "candidates"
					}
					- " that correspond to "
					code id="sourcing-out-of-band-text-tracks:the-track-element-8" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " elements with a "
					code id="sourcing-out-of-band-text-tracks:attr-track-default-2" {
						a href="#attr-track-default" {
							- "default"
						}
					}
					- " attribute set whose "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-6" {
						- "text track mode"
					}
					- " is\n    set to "
					a href="#text-track-disabled" id="sourcing-out-of-band-text-tracks:text-track-disabled-3" {
						- "disabled"
					}
					- ", then set the "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-7" {
						- "text track\n    mode"
					}
					- " of the first such track to "
					a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-3" {
						- "showing"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-12" {
				- "text track"
			}
			- " corresponding to a "
			code id="sourcing-out-of-band-text-tracks:the-track-element-9" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element experiences any of\n  the following circumstances, the user agent must "
			a href="#start-the-track-processing-model" id="sourcing-out-of-band-text-tracks:start-the-track-processing-model" {
				- "start the "
				code {
					- "track"
				}
				- " processing\n  model"
			}
			- " for that "
			a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-13" {
				- "text track"
			}
			- " and its "
			code id="sourcing-out-of-band-text-tracks:the-track-element-10" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element:\n\n  "
		}
		ul {
			li {
				- "The "
				code id="sourcing-out-of-band-text-tracks:the-track-element-11" {
					a href="#the-track-element" {
						- "track"
					}
				}
				- " element is created."
			}
			li {
				- "The "
				a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-14" {
					- "text track"
				}
				- " has its "
				a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-8" {
					- "text track mode"
				}
				- " changed."
			}
			li {
				- "The "
				code id="sourcing-out-of-band-text-tracks:the-track-element-12" {
					a href="#the-track-element" {
						- "track"
					}
				}
				- " element's parent element changes and the new parent is a "
				a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-15" {
					- "media\n   element"
				}
				- "."
			}
		}
		- "\n\n  "
		p {
			- "When a user agent is to "
			dfn id="start-the-track-processing-model" {
				- "start the "
				code {
					- "track"
				}
				- " processing model"
			}
			- " for a\n  "
			a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-15" {
				- "text track"
			}
			- " and its "
			code id="sourcing-out-of-band-text-tracks:the-track-element-13" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element, it must run the following algorithm.\n  This algorithm interacts closely with the "
			a href="#event-loop" id="sourcing-out-of-band-text-tracks:event-loop" {
				- "event loop"
			}
			- " mechanism; in particular, it has\n  a "
			a href="#synchronous-section" id="sourcing-out-of-band-text-tracks:synchronous-section" {
				- "synchronous section"
			}
			- " (which is triggered as part of the "
			a href="#event-loop" id="sourcing-out-of-band-text-tracks:event-loop-2" {
				- "event loop"
			}
			- "\n  algorithm). The steps in that section are marked with ⌛."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If another occurrence of this algorithm is already running for this "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-16" {
						- "text\n   track"
					}
					- " and its "
					code id="sourcing-out-of-band-text-tracks:the-track-element-14" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element, return, letting that other algorithm\n   take care of this element."
				}
			}
			li {
				p {
					- "If the "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-17" {
						- "text track"
					}
					- "'s "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-9" {
						- "text track mode"
					}
					- " is not set to one of "
					a href="#text-track-hidden" id="sourcing-out-of-band-text-tracks:text-track-hidden-2" {
						- "hidden"
					}
					- " or "
					a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-4" {
						- "showing"
					}
					- ",\n   then return."
				}
			}
			li {
				p {
					- "If the "
					a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-18" {
						- "text track"
					}
					- "'s "
					code id="sourcing-out-of-band-text-tracks:the-track-element-15" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element does not have a "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-16" {
						- "media\n   element"
					}
					- " as a parent, return."
				}
			}
			li {
				p {
					- "Run the remainder of these steps "
					a href="#in-parallel" id="sourcing-out-of-band-text-tracks:in-parallel" {
						- "in parallel"
					}
					- ", allowing whatever caused these steps to\n   run to continue."
				}
			}
			li {
				p {
					i {
						- "Top"
					}
					- ": "
					a href="#await-a-stable-state" id="sourcing-out-of-band-text-tracks:await-a-stable-state" {
						- "Await a stable state"
					}
					- ". The "
					a href="#synchronous-section" id="sourcing-out-of-band-text-tracks:synchronous-section-2" {
						- "synchronous section"
					}
					- "\n   consists of the following steps. (The steps in the "
					a href="#synchronous-section" id="sourcing-out-of-band-text-tracks:synchronous-section-3" {
						- "synchronous section"
					}
					- " are marked\n   with ⌛.)"
				}
			}
			li {
				p {
					- "⌛ Set the "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-2" {
						- "text track readiness state"
					}
					- " to "
					a href="#text-track-loading" id="sourcing-out-of-band-text-tracks:text-track-loading" {
						- "loading"
					}
					- "."
				}
			}
			li {
				p {
					- "⌛ Let "
					var {
						- "URL"
					}
					- " be the "
					a href="#track-url" id="sourcing-out-of-band-text-tracks:track-url-2" {
						- "track URL"
					}
					- " of the\n   "
					code id="sourcing-out-of-band-text-tracks:the-track-element-16" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
			}
			li {
				p {
					- "⌛ If the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-17" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element's parent is a "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-17" {
						- "media element"
					}
					- " then\n   let "
					var {
						- "corsAttributeState"
					}
					- " be the state of the parent "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-18" {
						- "media element"
					}
					- "'s "
					code id="sourcing-out-of-band-text-tracks:attr-media-crossorigin" {
						a href="#attr-media-crossorigin" {
							- "crossorigin"
						}
					}
					- " content attribute. Otherwise, let\n   "
					var {
						- "corsAttributeState"
					}
					- " be "
					a href="#attr-crossorigin-none" id="sourcing-out-of-band-text-tracks:attr-crossorigin-none" {
						- "No CORS"
					}
					- "."
				}
			}
			li {
				p {
					- "End the "
					a href="#synchronous-section" id="sourcing-out-of-band-text-tracks:synchronous-section-4" {
						- "synchronous section"
					}
					- ", continuing the remaining steps\n   "
					a href="#in-parallel" id="sourcing-out-of-band-text-tracks:in-parallel-2" {
						- "in parallel"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "URL"
					}
					- " is not the empty string, then:\n\n    "
				}
				ol {
					li {
						p {
							- "Let "
							var {
								- "request"
							}
							- " be the result of "
							a href="#create-a-potential-cors-request" id="sourcing-out-of-band-text-tracks:create-a-potential-cors-request" {
								- "creating a potential-CORS request"
							}
							- " given\n     "
							var {
								- "URL"
							}
							- ", \""
							code {
								- "track"
							}
							- "\", and "
							var {
								- "corsAttributeState"
							}
							- ", and with the\n     "
							i {
								- "same-origin fallback flag"
							}
							- " set."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "request"
							}
							- "'s "
							a href="https://fetch.spec.whatwg.org/#concept-request-client" id="sourcing-out-of-band-text-tracks:concept-request-client" data-x-internal="concept-request-client" {
								- "client"
							}
							- " to the\n     "
							code id="sourcing-out-of-band-text-tracks:the-track-element-18" {
								a href="#the-track-element" {
									- "track"
								}
							}
							- " element's "
							a id="sourcing-out-of-band-text-tracks:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node document"
							}
							- "'s "
							a href="#relevant-settings-object" id="sourcing-out-of-band-text-tracks:relevant-settings-object" {
								- "relevant settings\n     object"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "request"
							}
							- "'s "
							a href="https://fetch.spec.whatwg.org/#request-initiator-type" id="sourcing-out-of-band-text-tracks:concept-request-initiator-type" data-x-internal="concept-request-initiator-type" {
								- "initiator\n     type"
							}
							- " to \""
							code {
								- "track"
							}
							- "\"."
						}
					}
					li {
						p {
							a href="https://fetch.spec.whatwg.org/#concept-fetch" id="sourcing-out-of-band-text-tracks:concept-fetch" data-x-internal="concept-fetch" {
								- "Fetch"
							}
							- " "
							var {
								- "request"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p {
					- "The "
					a href="#concept-task" id="sourcing-out-of-band-text-tracks:concept-task" {
						- "tasks"
					}
					- " "
					a href="#queue-a-task" id="sourcing-out-of-band-text-tracks:queue-a-task" {
						- "queued"
					}
					- " by the\n    fetching algorithm on the "
					a href="#networking-task-source" id="sourcing-out-of-band-text-tracks:networking-task-source" {
						- "networking task source"
					}
					- " to process the data as it is being\n    fetched must determine the  type of\n    the resource. If the  type of the resource is not a supported text\n    track format, the load will fail, as described below. Otherwise, the resource's data must be\n    passed to the appropriate parser (e.g., the "
					a id="sourcing-out-of-band-text-tracks:webvtt-parser" href="https://w3c.github.io/webvtt/#webvtt-parser" data-x-internal="webvtt-parser" {
						- "WebVTT parser"
					}
					- ") as it is received, with the "
					a href="#text-track-list-of-cues" id="sourcing-out-of-band-text-tracks:text-track-list-of-cues-2" {
						- "text\n    track list of cues"
					}
					- " being used for that parser's output. "
					a href="#refsWEBVTT" {
						- "[WEBVTT]"
					}
				}
				- "\n\n    "
				p class="note" {
					- "The appropriate parser will incrementally update the "
					a href="#text-track-list-of-cues" id="sourcing-out-of-band-text-tracks:text-track-list-of-cues-3" {
						- "text track list of\n    cues"
					}
					- " during these "
					a href="#networking-task-source" id="sourcing-out-of-band-text-tracks:networking-task-source-2" {
						- "networking task\n    source"
					}
					- " "
					a href="#concept-task" id="sourcing-out-of-band-text-tracks:concept-task-2" {
						- "tasks"
					}
					- ", as each such task is\n    run with whatever data has been received from the network)."
				}
				- "\n\n    "
				p class="critical" {
					- "This specification does not currently say whether or how to check the MIME\n    types of text tracks, or whether or how to perform file type sniffing using the actual file\n    data. Implementers differ in their intentions on this matter and it is therefore unclear what\n    the right solution is. In the absence of any requirement here, the HTTP specifications' strict\n    requirement to follow the Content-Type header prevails (\"Content-Type specifies the media type\n    of the underlying data.\" ... \"If and only if the media type is not given by a Content-Type\n    field, the recipient MAY attempt to guess the media type via inspection of its content\n    and/or the name extension(s) of the URI used to identify the resource.\")."
				}
				- "\n\n    "
				p {
					- "If fetching fails for any reason (network error, the server returns an error code, CORS\n    fails, etc.), or if "
					var {
						- "URL"
					}
					- " is the empty string, then "
					a href="#queue-an-element-task" id="sourcing-out-of-band-text-tracks:queue-an-element-task" {
						- "queue an element task"
					}
					- "\n    on the "
					a href="#dom-manipulation-task-source" id="sourcing-out-of-band-text-tracks:dom-manipulation-task-source" {
						- "DOM manipulation task source"
					}
					- " given the "
					a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element-19" {
						- "media element"
					}
					- " to first\n    change the "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-3" {
						- "text track readiness state"
					}
					- " to "
					a href="#text-track-failed-to-load" id="sourcing-out-of-band-text-tracks:text-track-failed-to-load" {
						- "failed to load"
					}
					- " and then "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sourcing-out-of-band-text-tracks:concept-event-fire-3" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- "\n    named "
					code id="sourcing-out-of-band-text-tracks:event-track-error" {
						a href="#event-track-error" {
							- "error"
						}
					}
					- " at the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-19" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n    \n\n    "
				p {
					- "If fetching does not fail, but the  type of the resource is not a supported\n    text track format, or the file was not successfully processed (e.g., the format in question is\n    an XML format and the file contained a well-formedness error that "
					cite {
						- "XML"
					}
					- " requires be\n    detected and reported to the application), then the "
					a href="#concept-task" id="sourcing-out-of-band-text-tracks:concept-task-3" {
						- "task"
					}
					- " that\n    is "
					a href="#queue-an-element-task" id="sourcing-out-of-band-text-tracks:queue-an-element-task-2" {
						- "queued"
					}
					- " on the "
					a href="#networking-task-source" id="sourcing-out-of-band-text-tracks:networking-task-source-3" {
						- "networking task source"
					}
					- "\n    in which the aforementioned problem is found must change the "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-4" {
						- "text track readiness\n    state"
					}
					- " to "
					a href="#text-track-failed-to-load" id="sourcing-out-of-band-text-tracks:text-track-failed-to-load-2" {
						- "failed to load"
					}
					- " and "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sourcing-out-of-band-text-tracks:concept-event-fire-4" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named "
					code id="sourcing-out-of-band-text-tracks:event-track-error-2" {
						a href="#event-track-error" {
							- "error"
						}
					}
					- " at the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-20" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n\n    "
				p {
					- "If fetching does not fail, and the file was successfully processed, then the final "
					a href="#concept-task" id="sourcing-out-of-band-text-tracks:concept-task-4" {
						- "task"
					}
					- " that is "
					a href="#queue-an-element-task" id="sourcing-out-of-band-text-tracks:queue-an-element-task-3" {
						- "queued"
					}
					- " by\n    the "
					a href="#networking-task-source" id="sourcing-out-of-band-text-tracks:networking-task-source-4" {
						- "networking task source"
					}
					- ", after it has finished parsing the data, must change the\n    "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-5" {
						- "text track readiness state"
					}
					- " to "
					a href="#text-track-loaded" id="sourcing-out-of-band-text-tracks:text-track-loaded" {
						- "loaded"
					}
					- ", and\n    "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sourcing-out-of-band-text-tracks:concept-event-fire-5" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named "
					code id="sourcing-out-of-band-text-tracks:event-track-load" {
						a href="#event-track-load" {
							- "load"
						}
					}
					- " at the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-21" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element."
				}
				- "\n\n    "
				p {
					- "If, while fetching is ongoing, either:"
				}
				- "\n\n    "
				ul {
					li {
						- "the "
						a href="#track-url" id="sourcing-out-of-band-text-tracks:track-url-3" {
							- "track URL"
						}
						- " changes so that it is no longer equal to "
						var {
							- "URL"
						}
						- ", while the "
						a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-10" {
							- "text track mode"
						}
						- " is set to "
						a href="#text-track-hidden" id="sourcing-out-of-band-text-tracks:text-track-hidden-3" {
							- "hidden"
						}
						- " or "
						a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-5" {
							- "showing"
						}
						- "; or"
					}
					li {
						- "the "
						a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-11" {
							- "text track mode"
						}
						- " changes to "
						a href="#text-track-hidden" id="sourcing-out-of-band-text-tracks:text-track-hidden-4" {
							- "hidden"
						}
						- "\n     or "
						a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-6" {
							- "showing"
						}
						- ", while the "
						a href="#track-url" id="sourcing-out-of-band-text-tracks:track-url-4" {
							- "track URL"
						}
						- " is not\n     equal to "
						var {
							- "URL"
						}
					}
				}
				- "\n\n    "
				p {
					- "...then the user agent must abort "
					a href="https://fetch.spec.whatwg.org/#concept-fetch" id="sourcing-out-of-band-text-tracks:concept-fetch-2" data-x-internal="concept-fetch" {
						- "fetching"
					}
					- ", discarding\n    any pending "
					a href="#concept-task" id="sourcing-out-of-band-text-tracks:concept-task-5" {
						- "tasks"
					}
					- " generated by that algorithm (and in\n    particular, not adding any cues to the "
					a href="#text-track-list-of-cues" id="sourcing-out-of-band-text-tracks:text-track-list-of-cues-4" {
						- "text track list of cues"
					}
					- " after the moment the\n    URL changed), and then "
					a href="#queue-an-element-task" id="sourcing-out-of-band-text-tracks:queue-an-element-task-4" {
						- "queue an element task"
					}
					- " on the "
					a href="#dom-manipulation-task-source" id="sourcing-out-of-band-text-tracks:dom-manipulation-task-source-2" {
						- "DOM manipulation task\n    source"
					}
					- " given the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-22" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element that first changes the "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-6" {
						- "text track\n    readiness state"
					}
					- " to "
					a href="#text-track-failed-to-load" id="sourcing-out-of-band-text-tracks:text-track-failed-to-load-3" {
						- "failed to load"
					}
					- " and\n    then "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sourcing-out-of-band-text-tracks:concept-event-fire-6" data-x-internal="concept-event-fire" {
						- "fires an event"
					}
					- " named "
					code id="sourcing-out-of-band-text-tracks:event-track-error-3" {
						a href="#event-track-error" {
							- "error"
						}
					}
					- " at the "
					code id="sourcing-out-of-band-text-tracks:the-track-element-23" {
						a href="#the-track-element" {
							- "track"
						}
					}
					- " element. "
				}
				- "\n   "
			}
			li {
				p {
					- "Wait until the "
					a href="#text-track-readiness-state" id="sourcing-out-of-band-text-tracks:text-track-readiness-state-7" {
						- "text track readiness state"
					}
					- " is no longer set to "
					a href="#text-track-loading" id="sourcing-out-of-band-text-tracks:text-track-loading-2" {
						- "loading"
					}
					- "."
				}
			}
			li {
				p {
					- "Wait until the "
					a href="#track-url" id="sourcing-out-of-band-text-tracks:track-url-5" {
						- "track URL"
					}
					- " is no longer equal to "
					var {
						- "URL"
					}
					- ", at\n   the same time as the "
					a href="#text-track-mode" id="sourcing-out-of-band-text-tracks:text-track-mode-12" {
						- "text track mode"
					}
					- " is set to "
					a href="#text-track-hidden" id="sourcing-out-of-band-text-tracks:text-track-hidden-5" {
						- "hidden"
					}
					- " or "
					a href="#text-track-showing" id="sourcing-out-of-band-text-tracks:text-track-showing-7" {
						- "showing"
					}
					- "."
				}
			}
			li {
				p {
					- "Jump to the step labeled "
					i {
						- "top"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "Whenever a "
			code id="sourcing-out-of-band-text-tracks:the-track-element-24" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element has its "
			code id="sourcing-out-of-band-text-tracks:attr-track-src" {
				a href="#attr-track-src" {
					- "src"
				}
			}
			- " attribute\n  set, changed, or removed, the user agent must "
			a href="#immediately" id="sourcing-out-of-band-text-tracks:immediately" {
				- "immediately"
			}
			- " empty the element's "
			a href="#text-track" id="sourcing-out-of-band-text-tracks:text-track-19" {
				- "text\n  track"
			}
			- "'s "
			a href="#text-track-list-of-cues" id="sourcing-out-of-band-text-tracks:text-track-list-of-cues-5" {
				- "text track list of cues"
			}
			- ". (This also causes the algorithm above to stop\n  adding cues from the resource being obtained using the previously given URL, if any.)"
		}
		- "\n\n  \n\n\n  \n\n  "
		h6 id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues" {
			span class="secno" {
				- "4.8.11.11.4"
			}
			- " "
			dfn {
				- "Guidelines for exposing cues"
			}
			- " in various formats as "
			a href="#text-track-cue" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue" {
				- "text track cues"
			}
			a href="#guidelines-for-exposing-cues-in-various-formats-as-text-track-cues" class="self-link"
		}
		- "\n\n  "
		p {
			- "How a specific format's text track cues are to be interpreted for the purposes of processing by\n  an HTML user agent is defined by that format. In the absence of such a specification, this section\n  provides some constraints within which implementations can attempt to consistently expose such\n  formats."
		}
		- "\n\n  "
		p {
			- "To support the "
			a href="#text-track" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track" {
				- "text track"
			}
			- " model of HTML, each unit of timed data is converted to a\n  "
			a href="#text-track-cue" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-2" {
				- "text track cue"
			}
			- ". Where the mapping of the format's features to the aspects of a\n  "
			a href="#text-track-cue" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-3" {
				- "text track cue"
			}
			- " as defined in this specification are not defined, implementations must\n  ensure that the mapping is consistent with the definitions of the aspects of a "
			a href="#text-track-cue" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-4" {
				- "text track\n  cue"
			}
			- " as defined above, as well as with the following constraints:"
		}
		- "\n\n  "
		dl {
			dt {
				- "The "
				a href="#text-track-cue-identifier" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-identifier" {
					- "text track cue identifier"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "Should be set to the empty string if the format has no obvious analogue to a per-cue\n    identifier."
				}
				- "\n   "
			}
			dt {
				- "The "
				a href="#text-track-cue-pause-on-exit-flag" id="guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-pause-on-exit-flag" {
					- "text track cue pause-on-exit flag"
				}
				- "\n   "
			}
			dd {
				- "\n    "
				p {
					- "Should be set to false."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n\n  "
		h6 id="text-track-api" {
			span class="secno" {
				- "4.8.11.11.5"
			}
			- " Text track API"
			a href="#text-track-api" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
