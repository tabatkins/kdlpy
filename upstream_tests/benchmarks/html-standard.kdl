						- "realm execution context"
					}
					- " from the\n   "
					a id="calling-scripts:javascript-execution-context-stack-2" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
						- "JavaScript execution context stack"
