		- "\n\n  "
		p {
			- "All "
			a href="#html-elements" id="the-hidden-attribute:html-elements" {
				- "HTML elements"
			}
			- " may have the "
			dfn data-dfn-for="html-global" id="attr-hidden" data-dfn-type="element-attr" {
				code {
					- "hidden"
				}
			}
			- " content attribute set. The "
			code id="the-hidden-attribute:attr-hidden-2" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute is an "
			a href="#enumerated-attribute" id="the-hidden-attribute:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the\n  following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/hidden" id="attr-hidden-hidden" data-dfn-type="attr-value" {
							code {
								- "hidden"
							}
						}
						- "\n     "
					}
					td rowspan="2" {
						dfn id="attr-hidden-hidden-state" {
							- "hidden"
						}
						- "\n     "
					}
					td rowspan="2" {
						- "Will not be rendered.\n    "
					}
				}
				tr {
					td {
						- "(the empty string)\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/hidden" id="attr-hidden-until-found" data-dfn-type="attr-value" {
							code {
								- "until-found"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-hidden-until-found-state" {
							- "hidden until found"
						}
						- "\n     "
					}
					td {
						- "Will not be rendered, but content inside will be accessible to "
						a href="#find-in-page-2" id="the-hidden-attribute:find-in-page-2" {
							- "find-in-page"
						}
						- "\n     and "
						a href="#navigate-fragid" id="the-hidden-attribute:navigate-fragid" {
							- "fragment navigation"
						}
						- ".\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="the-hidden-attribute:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " is the "
			dfn id="attr-hidden-not-hidden-state" {
				- "not hidden"
			}
			- " state, and its "
			i id="the-hidden-attribute:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " is the "
			a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state" {
				- "hidden"
			}
			- "\n  state."
		}
		- "\n\n  "
		p {
			- "When an element has the "
			code id="the-hidden-attribute:attr-hidden-3" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in the "
			a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state-2" {
				- "hidden"
			}
			- " state, it indicates that the element is not yet, or\n  is no longer, directly relevant to the page's current state, or that it is being used to declare\n  content to be reused by other parts of the page as opposed to being directly accessed by the user.\n  User agents should not render elements that are in the "
			a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state-3" {
				- "hidden"
			}
			- " state. This requirement may be implemented\n  indirectly through the style layer. For example, a web browser could implement these requirements\n  "
			a href="#hiddenCSS" {
				- "using the rules suggested in the Rendering section"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an element has the "
			code id="the-hidden-attribute:attr-hidden-4" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in the "
			a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state" {
				- "hidden until found"
			}
			- " state, it indicates that the\n  element is hidden like the "
			a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state-4" {
				- "hidden"
			}
			- " state but the\n  content inside the element will be accessible to "
			a href="#find-in-page-2" id="the-hidden-attribute:find-in-page-2-2" {
				- "find-in-page"
			}
			- " and "
			a href="#navigate-fragid" id="the-hidden-attribute:navigate-fragid-2" {
				- "fragment navigation"
			}
			- ". When these features attempt to scroll to a\n  target which is in the element's subtree, the user agent will remove the "
			code id="the-hidden-attribute:attr-hidden-5" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in order to reveal the content before scrolling to\n  it. In addition to removing the "
			code id="the-hidden-attribute:attr-hidden-6" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute, an event named\n  "
			code id="the-hidden-attribute:event-beforematch" {
				a href="#event-beforematch" {
					- "beforematch"
				}
			}
			- " is also fired on the element before the "
			code id="the-hidden-attribute:attr-hidden-7" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute is removed."
		}
		- "\n\n  "
		p {
			- "Web browsers will use 'content-visibility: hidden' instead of 'display: none' when the "
			code id="the-hidden-attribute:attr-hidden-8" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute is in the "
			a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-2" {
				- "hidden until found"
			}
			- " state, as specified in the "
			a href="#hiddenCSS" {
				- "Rendering section"
			}
			- "."
		}
		- "\n\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "Because this attribute is typically implemented using CSS, it's also possible to override it\n   using CSS. For instance, a rule that applies 'display: block' to all elements will cancel the\n   effects of the "
				a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state-5" {
					- "hidden"
				}
				- " state. Authors therefore\n   have to take care when writing their style sheets to make sure that the attribute is still styled\n   as expected. In addition, legacy user agents which don't support the "
				a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-3" {
					- "hidden until found"
				}
				- " state will have 'display: none'\n   instead of 'content-visibility: hidden', so authors are encouraged to make sure that their style\n   sheets don't change the 'display' or 'content-visibility' properties of "
				a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-4" {
					- "hidden until found"
				}
				- " elements."
			}
			- "\n\n   "
			p {
				- "Since elements with the "
				code id="the-hidden-attribute:attr-hidden-9" {
					a href="#attr-hidden" {
						- "hidden"
					}
				}
				- " attribute in the "
				a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-5" {
					- "hidden until found"
				}
				- " state use 'content-visibility:\n   hidden' instead of 'display: none', there are two caveats of the "
				a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-6" {
					- "hidden until found"
				}
				- " state that make it different\n   from the "
				a href="#attr-hidden-hidden-state" id="the-hidden-attribute:attr-hidden-hidden-state-6" {
					- "hidden"
				}
				- " state:"
			}
			- "\n\n   "
			ol {
				li {
					p {
						- "The element needs to be affected by "
						a id="the-hidden-attribute:layout-containment" href="https://drafts.csswg.org/css-contain/#containment-layout" data-x-internal="layout-containment" {
							- "layout containment"
						}
						- " in order to be\n    revealed by find-in-page. This means that if the element in the "
						a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-7" {
							- "hidden until found"
						}
						- " state has a 'display' value of\n    'none', 'contents', or 'inline', then the element will not be revealed by find-in-page."
					}
				}
				li {
					p {
						- "The element will still have a "
						a href="https://drafts.csswg.org/css2/#propdef-visibility" id="the-hidden-attribute:'visibility'" data-x-internal="'visibility'" {
							- "generated box"
						}
						- " when in\n    the "
						a href="#attr-hidden-until-found-state" id="the-hidden-attribute:attr-hidden-until-found-state-8" {
							- "hidden until found"
						}
						- " state, which means\n    that borders, margin, and padding will still be rendered around the element."
					}
				}
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In the following skeletal example, the attribute is used to hide the web game's main screen\n   until the user logs in:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					- "  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "h1"
					}
					c- p="" {
						- ">"
					}
					- "The Example Game"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "h1"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "section"
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"login\""
					}
					c- p="" {
						- ">"
					}
					- "\n   "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "h2"
					}
					c- p="" {
						- ">"
					}
					- "Login"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "h2"
					}
					c- p="" {
						- ">"
					}
					- "\n   "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "form"
					}
					c- p="" {
						- ">"
					}
					- "\n    ...\n    "
					c- c="" {
						- "<!-- calls login() once the user's credentials have been checked -->"
					}
					- "\n   "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "form"
					}
					c- p="" {
						- ">"
					}
					- "\n   "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n    "
					c- a="" {
						- "function"
					}
					- " login"
					c- p="" {
						- "()"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      "
					c- c1="" {
						- "// switch screens"
					}
					- "\n      document"
					c- p="" {
						- "."
					}
					- "getElementById"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'login'"
					}
					c- p="" {
						- ")."
					}
					- "hidden "
					c- o="" {
						- "="
					}
					- " "
					c- kc="" {
						- "true"
					}
					c- p="" {
						- ";"
					}
					- "\n      document"
					c- p="" {
						- "."
					}
					- "getElementById"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'game'"
					}
					c- p="" {
						- ")."
					}
					- "hidden "
					c- o="" {
						- "="
					}
					- " "
					c- kc="" {
						- "false"
					}
					c- p="" {
						- ";"
					}
					- "\n    "
					c- p="" {
						- "}"
					}
					- "\n   "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "section"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "section"
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"game\""
					}
