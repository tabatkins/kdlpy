							a href="https://developer.mozilla.org/en-US/docs/Web/API/Window/window" title="The window property of a Window object points to the window object itself." {
								- "Window/window"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
