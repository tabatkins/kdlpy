					code id="navigation-activation-interface:navigationactivation-2" {
						a href="#navigationactivation" {
							- "NavigationActivation"
						}
					}
					- " containing information about the most recent\n    cross-document navigation, the navigation that \"activated\" this "
					code id="navigation-activation-interface:document" {
						a href="#document" {
							- "Document"
						}
					}
					- "."
				}
				- "\n\n    "
				p {
					- "While "
					code id="navigation-activation-interface:dom-navigation-currententry" {
						a href="#dom-navigation-currententry" {
							- "navigation.currentEntry"
						}
					}
					- " and the\n    "
					code id="navigation-activation-interface:document-2" {
						a href="#document" {
							- "Document"
						}
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-url" id="navigation-activation-interface:the-document's-address" data-x-internal="the-document's-address" {
						- "URL"
					}
					- " can be updated regularly\n    due to same-document navigations, "
					code id="navigation-activation-interface:dom-navigation-activation" {
						a href="#dom-navigation-activation" {
							- "navigation.activation"
						}
					}
					- " stays constant, and its properties\n    are only updated if the "
					code id="navigation-activation-interface:document-3" {
						a href="#document" {
							- "Document"
						}
					}
					- " is "
					a href="#reactivate-a-document" id="navigation-activation-interface:reactivate-a-document" {
						- "reactivated"
					}
					- " from history."
				}
				- "\n   "
			}
			dt {
				code {
					a href="#dom-navigation" id="navigation-activation-interface:dom-navigation-2" {
						- "navigation"
					}
					- "."
					a href="#dom-navigation-activation" id="navigation-activation-interface:dom-navigation-activation-2" {
						- "activation"
					}
					- "."
					a href="#dom-navigationactivation-entry" id="dom-navigationactivation-entry-dev" {
						- "entry"
					}
				}
			}
			dd {
				p {
					- "A "
					code id="navigation-activation-interface:navigationhistoryentry-3" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- ", equivalent to the value of the "
					code id="navigation-activation-interface:dom-navigation-currententry-2" {
						a href="#dom-navigation-currententry" {
							- "navigation.currentEntry"
						}
					}
					- " property at the moment the\n   "
					code id="navigation-activation-interface:document-4" {
						a href="#document" {
							- "Document"
						}
					}
					- " was activated."
				}
			}
			dt {
				code {
					a href="#dom-navigation" id="navigation-activation-interface:dom-navigation-3" {
						- "navigation"
