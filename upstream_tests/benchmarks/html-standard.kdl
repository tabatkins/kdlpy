				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="fire-a-focus-event" {
				- "fire a focus event"
			}
			- " named "
			var {
				- "e"
			}
			- " at an element "
			var {
				- "t"
			}
			- " with a given\n  related target "
			var {
				- "r"
			}
			- ", "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="focus-processing-model:concept-event-fire-2" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named\n  "
			var {
				- "e"
			}
			- " at "
			var {
				- "t"
			}
			- ", using "
			code id="focus-processing-model:focusevent" {
				a data-x-internal="focusevent" href="https://w3c.github.io/uievents/#focusevent" {
					- "FocusEvent"
				}
			}
			- ", with the "
			code id="focus-processing-model:dom-focusevent-relatedtarget" {
				a data-x-internal="dom-focusevent-relatedtarget" href="https://w3c.github.io/uievents/#dom-focusevent-relatedtarget" {
					- "relatedTarget"
				}
			}
			- " attribute initialized to "
			var {
				- "r"
			}
			- ",\n  the "
			code id="focus-processing-model:dom-uievent-view" {
				a data-x-internal="dom-uievent-view" href="https://w3c.github.io/uievents/#dom-uievent-view" {
					- "view"
				}
			}
			- " attribute initialized to "
			var {
				- "t"
			}
			- "'s\n  "
			a id="focus-processing-model:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node document"
			}
			- "'s "
			a href="#concept-relevant-global" id="focus-processing-model:concept-relevant-global-4" {
				- "relevant global object"
			}
			- ", and the "
			a id="focus-processing-model:composed-flag" href="https://dom.spec.whatwg.org/#composed-flag" data-x-internal="composed-flag" {
				- "composed\n  flag"
			}
			- " set."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When a key event is to be routed in a "
			a href="#top-level-traversable" id="focus-processing-model:top-level-traversable" {
				- "top-level traversable"
			}
			- ", the user agent must\n  run the following steps:"
		}
		- "\n\n  \n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "target area"
					}
					- " be the "
					a href="#currently-focused-area-of-a-top-level-traversable" id="focus-processing-model:currently-focused-area-of-a-top-level-traversable-10" {
						- "currently focused area of the top-level traversable"
					}
					- "."
				}
			}
			li {
				p {
					a id="focus-processing-model:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					var {
						- "target area"
					}
					- " is not null, since key events are only routed\n   to "
					a href="#top-level-traversable" id="focus-processing-model:top-level-traversable-2" {
						- "top-level traversables"
					}
					- " that have "
					a href="#system-focus" id="focus-processing-model:system-focus-3" {
						- "system\n   focus"
					}
					- ". Therefore, "
					var {
						- "target area"
					}
					- " is a "
					a href="#focusable-area" id="focus-processing-model:focusable-area-17" {
						- "focusable area"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "target node"
					}
					- " be "
					var {
						- "target area"
					}
					- "'s "
					a href="#dom-anchor" id="focus-processing-model:dom-anchor-5" {
						- "DOM anchor"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "target node"
					}
					- " is a "
					code id="focus-processing-model:document-7" {
						a href="#document" {
							- "Document"
						}
					}
					- " that has a "
					a href="#the-body-element-2" id="focus-processing-model:the-body-element-2" {
						- "body element"
					}
					- ", then let "
					var {
						- "target node"
					}
					- " be "
					a href="#the-body-element-2" id="focus-processing-model:the-body-element-2-2" {
						- "the body\n    element"
					}
					- " of that "
					code id="focus-processing-model:document-8" {
						a href="#document" {
							- "Document"
						}
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Otherwise, if "
					var {
						- "target node"
					}
					- " is a "
					code id="focus-processing-model:document-9" {
						a href="#document" {
							- "Document"
						}
					}
					- " object that has a non-null\n    "
					a id="focus-processing-model:document-element-2" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
						- "document element"
					}
					- ", then let "
					var {
						- "target node"
					}
					- " be that "
					a id="focus-processing-model:document-element-3" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
						- "document\n    element"
					}
					- "."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "target node"
					}
					- " is not "
					a href="#inert" id="focus-processing-model:inert-3" {
						- "inert"
					}
					- ", then:"
				}
				- "\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "canHandle"
							}
							- " be the result of "
							a href="https://dom.spec.whatwg.org/#concept-event-dispatch" id="focus-processing-model:concept-event-dispatch" data-x-internal="concept-event-dispatch" {
								- "dispatching"
							}
							- " the key event at "
							var {
								- "target\n     node"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "canHandle"
							}
							- " is true, then let "
							var {
								- "target area"
							}
							- " handle the key event.\n     This might include "
							a href="#fire-a-click-event" id="focus-processing-model:fire-a-click-event" {
								- "firing a "
								code {
									- "click"
								}
								- " event"
							}
							- " at "
							var {
								- "target node"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn id="has-focus-steps" data-export="" {
				- "has focus steps"
			}
			- ", given a "
			code id="focus-processing-model:document-10" {
				a href="#document" {
					- "Document"
				}
			}
			- " object "
			var {
				- "target"
			}
			- ",\n  are as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "target"
					}
					- "'s "
					a href="#node-navigable" id="focus-processing-model:node-navigable-3" {
						- "node navigable"
					}
					- "'s "
					a href="#nav-top" id="focus-processing-model:nav-top" {
						- "top-level\n   traversable"
					}
					- " does not have "
					a href="#system-focus" id="focus-processing-model:system-focus-4" {
						- "system focus"
					}
					- ", then return false."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "candidate"
					}
					- " be "
					var {
						- "target"
					}
					- "'s "
					a href="#node-navigable" id="focus-processing-model:node-navigable-4" {
						- "node navigable"
					}
					- "'s "
					a href="#nav-top" id="focus-processing-model:nav-top-2" {
						- "top-level traversable"
					}
					- "'s "
					a href="#active-document" id="focus-processing-model:active-document" {
						- "active document"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "While true:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "candidate"
							}
							- " is "
							var {
								- "target"
							}
							- ", then return true."
						}
					}
					li {
						p {
							- "If the "
							a href="#focused-area-of-the-document" id="focus-processing-model:focused-area-of-the-document-3" {
								- "focused area"
							}
							- " of\n     "
							var {
								- "candidate"
							}
							- " is a "
							a href="#navigable-container" id="focus-processing-model:navigable-container-4" {
								- "navigable container"
							}
							- " with a non-null "
							a href="#content-navigable" id="focus-processing-model:content-navigable-5" {
								- "content\n     navigable"
							}
							- ", then set "
							var {
								- "candidate"
							}
							- " to the "
							a href="#nav-document" id="focus-processing-model:nav-document-4" {
								- "active\n     document"
							}
							- " of that "
							a href="#navigable-container" id="focus-processing-model:navigable-container-5" {
								- "navigable container"
							}
							- "'s "
							a href="#content-navigable" id="focus-processing-model:content-navigable-6" {
								- "content\n     navigable"
							}
							- "."
						}
					}
					li {
						p {
							- "Otherwise, return false."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n\n\n  "
		h4 id="sequential-focus-navigation" {
			span class="secno" {
				- "6.6.5"
			}
			- " "
			dfn {
				- "Sequential focus navigation"
			}
			a href="#sequential-focus-navigation" class="self-link"
		}
		- "\n\n  "
		p {
			- "Each "
			code id="sequential-focus-navigation:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " has a "
			dfn id="sequential-focus-navigation-order" {
				- "sequential focus navigation order"
			}
			- ", which orders\n  some or all of the "
			a href="#focusable-area" id="sequential-focus-navigation:focusable-area" {
				- "focusable areas"
			}
			- " in the\n  "
			code id="sequential-focus-navigation:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " relative to each other. Its contents and ordering are given by the\n  "
			a href="#flattened-tabindex-ordered-focus-navigation-scope" id="sequential-focus-navigation:flattened-tabindex-ordered-focus-navigation-scope" {
				- "flattened tabindex-ordered focus navigation scope"
			}
			- " of the "
			code id="sequential-focus-navigation:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "Per the rules defining the "
			a href="#flattened-tabindex-ordered-focus-navigation-scope" id="sequential-focus-navigation:flattened-tabindex-ordered-focus-navigation-scope-2" {
				- "flattened tabindex-ordered focus navigation\n  scope"
			}
			- ", the ordering is not necessarily related to the "
			a id="sequential-focus-navigation:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
				- "tree order"
			}
			- " of the\n  "
			code id="sequential-focus-navigation:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "If a "
			a href="#focusable-area" id="sequential-focus-navigation:focusable-area-2" {
				- "focusable area"
			}
			- " is omitted from the "
			a href="#sequential-focus-navigation-order" id="sequential-focus-navigation:sequential-focus-navigation-order" {
				- "sequential focus navigation\n  order"
			}
			- " of its "
			code id="sequential-focus-navigation:document-5" {
				a href="#document" {
					- "Document"
				}
			}
			- ", then it is unreachable via "
			a href="#sequential-focus-navigation" id="sequential-focus-navigation:sequential-focus-navigation" {
				- "sequential focus\n  navigation"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "There can also be a "
			dfn id="sequential-focus-navigation-starting-point" {
				- "sequential focus navigation starting point"
			}
			- ". It is initially\n  unset. The user agent may set it when the user indicates that it should be moved."
		}
		- "\n\n  "
		p class="example" {
			- "For example, the user agent could set it to the position of the user's click if\n  the user clicks on the document contents."
		}
		- "\n\n  "
		p class="note" {
			- "User agents are required to set the "
			a href="#sequential-focus-navigation-starting-point" id="sequential-focus-navigation:sequential-focus-navigation-starting-point" {
				- "sequential focus navigation starting\n  point"
			}
			- " to the "
			a href="#target-element" id="sequential-focus-navigation:target-element" {
				- "target element"
			}
			- " when "
			a href="#navigate-fragid" id="sequential-focus-navigation:navigate-fragid" {
				- "navigating\n  to a fragment"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="sequential-focus-direction" {
				- "sequential focus direction"
			}
			- " is one of two possible values: \""
			dfn id="sequential-focus-forward" {
				code {
					- "forward"
				}
			}
			- "\", or \""
			dfn id="sequential-focus-backward" {
				code {
					- "backward"
				}
			}
			- "\". They are used in the below algorithms\n  to describe the direction in which sequential focus travels at the user's request."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="selection-mechanism" {
				- "selection mechanism"
			}
			- " is one of two possible values: \""
			dfn id="selection-mechanism-dom" {
				code {
					- "DOM"
				}
			}
			- "\", or\n  \""
			dfn id="selection-mechanism-sequential" {
				code {
					- "sequential"
				}
			}
			- "\". They are used to\n  describe how the "
			a href="#sequential-navigation-search-algorithm" id="sequential-focus-navigation:sequential-navigation-search-algorithm" {
				- "sequential navigation search algorithm"
			}
			- " finds the "
			a href="#focusable-area" id="sequential-focus-navigation:focusable-area-3" {
				- "focusable\n  area"
			}
			- " it returns."
		}
		- "\n\n  "
		p {
			- "When the user requests that focus move from the "
			a href="#currently-focused-area-of-a-top-level-traversable" id="sequential-focus-navigation:currently-focused-area-of-a-top-level-traversable" {
				- "currently focused area of a top-level\n  traversable"
			}
			- " to the next or previous "
			a href="#focusable-area" id="sequential-focus-navigation:focusable-area-4" {
				- "focusable area"
			}
			- " (e.g., as the default\n  action of pressing the "
			kbd {
				kbd {
					- "tab"
				}
			}
			- " key), or when the user requests that focus\n  sequentially move to a "
			a href="#top-level-traversable" id="sequential-focus-navigation:top-level-traversable" {
				- "top-level traversable"
			}
			- " in the first place (e.g., from the\n  browser's location bar), the user agent must use the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "starting point"
					}
					- " be the "
					a href="#currently-focused-area-of-a-top-level-traversable" id="sequential-focus-navigation:currently-focused-area-of-a-top-level-traversable-2" {
						- "currently focused area of a top-level\n   traversable"
					}
					- ", if the user requested to move focus sequentially from there, or else the\n   "
					a href="#top-level-traversable" id="sequential-focus-navigation:top-level-traversable-2" {
						- "top-level traversable"
					}
					- " itself, if the user instead requested to move focus from\n   outside the "
					a href="#top-level-traversable" id="sequential-focus-navigation:top-level-traversable-3" {
						- "top-level traversable"
					}
					- "."
				}
			}
			li {
				p {
					- "If there is a "
					a href="#sequential-focus-navigation-starting-point" id="sequential-focus-navigation:sequential-focus-navigation-starting-point-2" {
						- "sequential focus navigation starting point"
					}
					- " defined and it is\n   inside "
					var {
						- "starting point"
					}
					- ", then let "
					var {
						- "starting point"
					}
					- " be the "
					a href="#sequential-focus-navigation-starting-point" id="sequential-focus-navigation:sequential-focus-navigation-starting-point-3" {
						- "sequential\n   focus navigation starting point"
					}
					- " instead."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "direction"
					}
					- " be \""
					code id="sequential-focus-navigation:sequential-focus-forward" {
						a href="#sequential-focus-forward" {
							- "forward"
						}
					}
					- "\" if the\n    user requested the next control, and \""
					code id="sequential-focus-navigation:sequential-focus-backward" {
						a href="#sequential-focus-backward" {
							- "backward"
						}
					}
					- "\" if the user requested the previous\n    control."
				}
				- "\n\n    "
				p class="note" {
					- "Typically, pressing "
					kbd {
						kbd {
							- "tab"
						}
					}
					- " requests the next control, and\n    pressing "
					kbd {
						kbd {
							- "shift"
						}
						- " + "
						kbd {
							- "tab"
						}
					}
					- " requests the previous control."
				}
				- "\n   "
			}
			li {
