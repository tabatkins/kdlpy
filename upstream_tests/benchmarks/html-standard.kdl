		- "\n\n  "
		p {
			code id="the-datatransfer-interface:datatransfer-2" {
				a href="#datatransfer" {
					- "DataTransfer"
				}
			}
			- " objects are used to expose the "
			a href="#drag-data-store" id="the-datatransfer-interface:drag-data-store" {
				- "drag data store"
			}
			- " that\n  underlies a drag-and-drop operation."
		}
		- "\n\n  "
		pre {
			code class="idl" {
				- "["
				c- g="" {
					- "Exposed"
				}
				- "="
				c- n="" {
					- "Window"
				}
				- "]\n"
				c- b="" {
