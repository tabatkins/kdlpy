			- "If the "
			code id="location-of-the-media-resource:names:-the-itemprop-attribute" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute is specified on the "
			a href="#media-element" id="location-of-the-media-resource:media-element-2" {
				- "media\n  element"
			}
			- ", then the "
			code id="location-of-the-media-resource:attr-media-src" {
				a href="#attr-media-src" {
					- "src"
				}
			}
			- " attribute must also be\n  specified."
