		}
		- "\n\n  "
		p {
			- "The "
			code id="attributes-common-to-td-and-th-elements:the-td-element-2" {
				a href="#the-td-element" {
					- "td"
				}
			}
			- " and "
			code id="attributes-common-to-td-and-th-elements:the-th-element-2" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- " elements may have a "
			dfn data-dfn-for="td,th" id="attr-tdth-colspan" data-dfn-type="element-attr" {
				code {
					- "colspan"
				}
			}
			- " content attribute specified, whose value must be a\n  "
			a href="#valid-non-negative-integer" id="attributes-common-to-td-and-th-elements:valid-non-negative-integer" {
				- "valid non-negative integer"
			}
			- " greater than zero and less than or equal to 1000."
		}
		- "\n\n  "
		p {
			- "The "
			code id="attributes-common-to-td-and-th-elements:the-td-element-3" {
				a href="#the-td-element" {
					- "td"
				}
			}
			- " and "
			code id="attributes-common-to-td-and-th-elements:the-th-element-3" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- " elements may also have a "
			dfn data-dfn-for="td,th" id="attr-tdth-rowspan" data-dfn-type="element-attr" {
				code {
					- "rowspan"
				}
			}
			- " content attribute specified,\n  whose value must be a "
			a href="#valid-non-negative-integer" id="attributes-common-to-td-and-th-elements:valid-non-negative-integer-2" {
				- "valid non-negative integer"
			}
			- " less than or equal to 65534.  For\n  this attribute, the value zero means that the cell is to span all the remaining rows in the row\n  group."
		}
		- " \n\n  "
		p {
			- "These attributes give the number of columns and rows respectively that the cell is to span.\n  These attributes must not be used to overlap cells, as described in the\n  description of the "
			a href="#table-model" id="attributes-common-to-td-and-th-elements:table-model" {
				- "table model"
			}
			- "."
		}
		- " \n\n  "
		hr
		- "\n\n  "
		p {
