			- " state\n  and the "
			a href="#text-(type=text)-state-and-search-state-(type=search)" id="text-(type=text)-state-and-search-state-(type=search):text-(type=text)-state-and-search-state-(type=search)-4" {
				- "Search"
			}
			- " state is primarily stylistic: on\n  platforms where search controls are distinguished from regular text controls, the "
			a href="#text-(type=text)-state-and-search-state-(type=search)" id="text-(type=text)-state-and-search-state-(type=search):text-(type=text)-state-and-search-state-(type=search)-5" {
				- "Search"
