					}
				}
				- "<"
				c- b="" {
					- "undefined"
				}
				- "> ();"
			}
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-navigationtype" id="dom-navigateevent-navigationtype-dev" {
						- "navigationType"
					}
				}
			}
			dd {
				p {
					- "One of \""
					code id="the-navigateevent-interface:dom-navigationtype-push-2" {
						a href="#dom-navigationtype-push" {
							- "push"
						}
					}
					- "\", \""
					code id="the-navigateevent-interface:dom-navigationtype-replace" {
						a href="#dom-navigationtype-replace" {
							- "replace"
						}
					}
					- "\", \""
					code id="the-navigateevent-interface:dom-navigationtype-reload" {
						a href="#dom-navigationtype-reload" {
							- "reload"
						}
					}
					- "\", or \""
					code id="the-navigateevent-interface:dom-navigationtype-traverse" {
						a href="#dom-navigationtype-traverse" {
							- "traverse"
						}
					}
					- "\", indicating what type of navigation this\n   is."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-destination" id="dom-navigateevent-destination-dev" {
						- "destination"
					}
				}
			}
			dd {
				p {
					- "A "
					code id="the-navigateevent-interface:navigationdestination-3" {
						a href="#navigationdestination" {
							- "NavigationDestination"
						}
					}
					- " representing the destination of the\n   navigation."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-canintercept" id="dom-navigateevent-canintercept-dev" {
						- "canIntercept"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "True if "
					code id="the-navigateevent-interface:dom-navigateevent-intercept-2" {
						a href="#dom-navigateevent-intercept" {
							- "intercept()"
						}
					}
					- " can be called to\n    intercept this navigation and convert it into a same-document navigation, replacing its usual\n    behavior; false otherwise."
				}
				- "\n\n    "
				p {
					- "Generally speaking, this will be true whenever the current "
					code id="the-navigateevent-interface:document" {
						a href="#document" {
							- "Document"
						}
					}
					- " "
					a href="#can-have-its-url-rewritten" id="the-navigateevent-interface:can-have-its-url-rewritten" {
						- "can\n    have its URL rewritten"
					}
					- " to the destination URL, except for in the case of cross-document\n    \""
					code id="the-navigateevent-interface:dom-navigationtype-traverse-2" {
						a href="#dom-navigationtype-traverse" {
							- "traverse"
						}
					}
					- "\" navigations, where it will always\n    be false."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-userinitiated" id="dom-navigateevent-userinitiated-dev" {
						- "userInitiated"
					}
				}
			}
			dd {
				p {
					- "True if this navigation was due to a user clicking on an "
					code id="the-navigateevent-interface:the-a-element" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " element,\n   submitting a "
					code id="the-navigateevent-interface:the-form-element" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, or using the "
					a href="#nav-traversal-ui" {
						- "browser UI"
					}
					- "\n   to navigate; false otherwise."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-hashchange" id="dom-navigateevent-hashchange-dev" {
						- "hashChange"
					}
				}
			}
			dd {
				p {
					- "True for a "
					a href="#navigate-fragid" id="the-navigateevent-interface:navigate-fragid" {
						- "fragment navigation"
					}
					- "; false\n   otherwise."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-signal" id="dom-navigateevent-signal-dev" {
						- "signal"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "An "
					code id="the-navigateevent-interface:abortsignal-3" {
						a data-x-internal="abortsignal" href="https://dom.spec.whatwg.org/#abortsignal" {
							- "AbortSignal"
						}
					}
					- " which will become aborted if the navigation gets canceled, e.g.,\n    by the user pressing their browser's \"Stop\" button, or by another navigation interrupting this\n    one."
				}
				- "\n\n    "
				p {
					- "The expected pattern is for developers to pass this along to any async operations, such as\n    "
					code id="the-navigateevent-interface:fetch()" {
						a data-x-internal="fetch()" href="https://fetch.spec.whatwg.org/#dom-global-fetch" {
							- "fetch()"
						}
					}
					- ", which they perform as part of handling this navigation."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-formdata" id="dom-navigateevent-formdata-dev" {
						- "formData"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="the-navigateevent-interface:formdata-3" {
						a data-x-internal="formdata" href="https://xhr.spec.whatwg.org/#formdata" {
							- "FormData"
						}
					}
					- " representing the submitted form entries for this navigation, if\n    this navigation is a \""
					code id="the-navigateevent-interface:dom-navigationtype-push-3" {
						a href="#dom-navigationtype-push" {
							- "push"
						}
					}
					- "\" or \""
					code id="the-navigateevent-interface:dom-navigationtype-replace-2" {
						a href="#dom-navigationtype-replace" {
							- "replace"
						}
					}
					- "\" navigation representing a POST "
					a href="#concept-form-submit" id="the-navigateevent-interface:concept-form-submit" {
						- "form submission"
					}
					- "; null otherwise."
				}
				- "\n\n    "
				p {
					- "(Notably, this will be null even for \""
					code id="the-navigateevent-interface:dom-navigationtype-reload-2" {
						a href="#dom-navigationtype-reload" {
							- "reload"
						}
					}
					- "\"\n    or \""
					code id="the-navigateevent-interface:dom-navigationtype-traverse-3" {
						a href="#dom-navigationtype-traverse" {
							- "traverse"
						}
					}
					- "\" navigations that are revisiting\n    a "
					a href="#session-history-entry" id="the-navigateevent-interface:session-history-entry" {
						- "session history entry"
					}
					- " that was originally created from a form submission.)"
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-downloadrequest" id="dom-navigateevent-downloadrequest-dev" {
						- "downloadRequest"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Represents whether or not this navigation was requested to be a download, by using an\n    "
					code id="the-navigateevent-interface:the-a-element-2" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " or "
					code id="the-navigateevent-interface:the-area-element" {
						a href="#the-area-element" {
							- "area"
						}
					}
					- " element's "
					code id="the-navigateevent-interface:attr-hyperlink-download" {
						a href="#attr-hyperlink-download" {
							- "download"
						}
					}
					- " attribute:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "If a download was not requested, then this property is null."
						}
					}
					li {
						p {
							- "If a download was requested, returns the filename that was supplied as the "
							code id="the-navigateevent-interface:attr-hyperlink-download-2" {
								a href="#attr-hyperlink-download" {
									- "download"
								}
							}
							- " attribute's value. (This could be the empty\n     string.)"
						}
					}
				}
				- "\n\n    "
				p {
					- "Note that a download being requested does not always mean that a download will happen: for\n    example, a download might be blocked by browser security policies, or end up being treated as a\n    \""
					code id="the-navigateevent-interface:navigationhistorybehavior-push" {
						a href="#navigationhistorybehavior-push" {
							- "push"
						}
					}
					- "\" navigation for "
					a href="https://github.com/whatwg/html/issues/7718" class="XXX" {
						- "unspecified reasons"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Similarly, a navigation might end up being a download even if it was not requested to be one,\n    due to the destination server responding with a `"
					code id="the-navigateevent-interface:http-content-disposition" {
						a data-x-internal="http-content-disposition" href="https://httpwg.org/specs/rfc6266.html" {
							- "Content-Disposition: attachment"
						}
					}
					- "` header."
				}
				- "\n\n    "
				p {
					- "Finally, note that the "
					code id="the-navigateevent-interface:event-navigate" {
						a href="#event-navigate" {
							- "navigate"
						}
					}
					- " event will not fire at\n    all for downloads initiated using browser UI affordances, e.g., those created by right-clicking\n    and choosing to save the target of a link."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-info" id="dom-navigateevent-info-dev" {
						- "info"
					}
				}
			}
			dd {
				p {
					- "An arbitrary JavaScript value passed via one of the "
					a href="#navigation-api-initiating-navigations" {
						- "navigation API methods"
					}
					- " which initiated this\n   navigation, or undefined if the navigation was initiated by the user or by a different\n   API."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-hasuavisualtransition" id="dom-navigateevent-hasuavisualtransition-dev" {
						- "hasUAVisualTransition"
					}
				}
			}
			dd {
				p {
					- "Returns true if the user agent performed a visual transition for this navigation before\n   dispatching this event. If true, the best user experience will be given if the author\n   synchronously updates the DOM to the post-navigation state."
				}
			}
			dt {
				code {
					var {
						- "event"
					}
					- "."
					a href="#dom-navigateevent-intercept" id="dom-navigateevent-intercept-dev" {
						- "intercept"
					}
					- "({ "
					a href="#dom-navigationinterceptoptions-handler" id="dom-navigationinterceptoptions-handler-dev" {
						- "handler"
					}
					- ", "
					a href="#dom-navigationinterceptoptions-focusreset" id="dom-navigationinterceptoptions-focusreset-dev" {
						- "focusReset"
					}
					- ", "
					a href="#dom-navigationinterceptoptions-scroll" id="dom-navigationinterceptoptions-scroll-dev" {
						- "scroll"
					}
					- " })"
				}
			}
			dd {
				- "\n    "
				p {
					- "Intercepts this navigation, preventing its normal handling and instead converting it into a\n    same-document navigation of the same type to the destination URL."
				}
				- "\n\n    "
				p {
					- "The "
					code id="the-navigateevent-interface:dom-navigationinterceptoptions-handler" {
						a href="#dom-navigationinterceptoptions-handler" {
							- "handler"
						}
					}
					- " option can be a\n    function that returns a promise. The handler function will run after the "
					code id="the-navigateevent-interface:event-navigate-2" {
						a href="#event-navigate" {
							- "navigate"
						}
					}
					- " event has finished firing, and the "
					code id="the-navigateevent-interface:dom-navigation-currententry" {
						a href="#dom-navigation-currententry" {
							- "navigation.currentEntry"
						}
					}
					- " property has been\n    synchronously updated. This returned promise is used to signal the duration, and success or\n    failure, of the navigation. After it settles, the browser signals to the user (e.g., via a\n    loading spinner UI, or assistive technology) that the navigation is finished. Additionally, it\n    fires "
					code id="the-navigateevent-interface:event-navigatesuccess" {
						a href="#event-navigatesuccess" {
							- "navigatesuccess"
						}
					}
					- " or "
					code id="the-navigateevent-interface:event-navigateerror" {
						a href="#event-navigateerror" {
							- "navigateerror"
						}
					}
					- " events as appropriate, which other parts of\n    the web application can respond to."
				}
				- "\n\n    "
				p {
					- "By default, using this method will cause focus to reset when any handlers' returned promises\n    settle. Focus will be reset to the first element with the "
					code id="the-navigateevent-interface:attr-fe-autofocus" {
						a href="#attr-fe-autofocus" {
							- "autofocus"
						}
					}
					- " attribute set, or "
					a href="#the-body-element-2" id="the-navigateevent-interface:the-body-element-2" {
						- "the body element"
					}
					- " if\n    the attribute isn't present. The "
					code id="the-navigateevent-interface:dom-navigationinterceptoptions-focusreset" {
						a href="#dom-navigationinterceptoptions-focusreset" {
							- "focusReset"
						}
					}
					- " option can be set to \""
					code id="the-navigateevent-interface:dom-navigationfocusreset-manual" {
						a href="#dom-navigationfocusreset-manual" {
							- "manual"
						}
					}
					- "\" to avoid this behavior."
				}
				- "\n\n    "
				p {
					- "By default, using this method will delay the browser's scroll restoration logic for \""
					code id="the-navigateevent-interface:dom-navigationtype-traverse-4" {
						a href="#dom-navigationtype-traverse" {
							- "traverse"
						}
					}
					- "\" or \""
					code id="the-navigateevent-interface:dom-navigationtype-reload-3" {
						a href="#dom-navigationtype-reload" {
							- "reload"
						}
					}
					- "\" navigations, or its\n    scroll-reset/scroll-to-a-fragment logic for \""
					code id="the-navigateevent-interface:dom-navigationtype-push-4" {
						a href="#dom-navigationtype-push" {
							- "push"
						}
					}
					- "\"\n    or \""
					code id="the-navigateevent-interface:dom-navigationtype-replace-3" {
						a href="#dom-navigationtype-replace" {
							- "replace"
						}
					}
					- "\" navigations, until any handlers'\n    returned promises settle. The "
