				}
			}
			- " object has "
			a href="#transient-activation" id="playing-the-media-resource:transient-activation" {
				- "transient activation"
			}
			- ", but an\n  exception could be made to allow playback while "
			a href="#concept-media-muted" id="playing-the-media-resource:concept-media-muted" {
				- "muted"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-7" {
				- "media element"
			}
			- " is said to have "
			dfn id="ended-playback" {
				- "ended playback"
			}
			- " when:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The element's "
					code id="playing-the-media-resource:dom-media-readystate-3" {
						a href="#dom-media-readystate" {
							- "readyState"
						}
					}
					- " attribute is "
					code id="playing-the-media-resource:dom-media-have_metadata-2" {
						a href="#dom-media-have_metadata" {
							- "HAVE_METADATA"
						}
					}
					- " or greater, and"
				}
				- "\n\n   "
			}
			li {
				- "\n    "
				p {
					- "Either:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "The "
							a href="#current-playback-position" id="playing-the-media-resource:current-playback-position" {
								- "current playback position"
							}
							- " is the end of the "
							a href="#media-resource" id="playing-the-media-resource:media-resource-7" {
								- "media\n     resource"
							}
							- ", and"
						}
					}
					li {
						p {
							- "The "
							a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback" {
								- "direction of playback"
							}
							- " is forwards, and"
						}
					}
					li {
						p {
							- "The "
							a href="#media-element" id="playing-the-media-resource:media-element-8" {
								- "media element"
							}
							- " does not have a "
							code id="playing-the-media-resource:attr-media-loop" {
								a href="#attr-media-loop" {
									- "loop"
								}
							}
							- " attribute specified."
						}
					}
				}
				- "\n\n    "
				p {
					- "Or:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "The "
							a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-2" {
								- "current playback position"
							}
							- " is the "
							a href="#earliest-possible-position" id="playing-the-media-resource:earliest-possible-position" {
								- "earliest possible\n     position"
							}
							- ", and"
						}
					}
					li {
						p {
							- "The "
							a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback-2" {
								- "direction of playback"
							}
							- " is backwards."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-ended" data-dfn-type="attribute" {
				code {
					- "ended"
				}
			}
			- "\n  attribute must return true if, the last time the "
			a href="#event-loop" id="playing-the-media-resource:event-loop" {
				- "event loop"
			}
			- " reached "
			a href="#step1" {
				- "step 1"
			}
			- ", the "
			a href="#media-element" id="playing-the-media-resource:media-element-9" {
				- "media element"
			}
			- " had "
			a href="#ended-playback" id="playing-the-media-resource:ended-playback-2" {
				- "ended playback"
			}
			- " and the\n  "
			a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback-3" {
				- "direction of playback"
			}
			- " was forwards, and false otherwise."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-10" {
				- "media element"
			}
			- " is said to have "
			dfn id="stopped-due-to-errors" {
				- "stopped due to errors"
			}
			- " when the\n  element's "
			code id="playing-the-media-resource:dom-media-readystate-4" {
				a href="#dom-media-readystate" {
					- "readyState"
				}
			}
			- " attribute is "
			code id="playing-the-media-resource:dom-media-have_metadata-3" {
				a href="#dom-media-have_metadata" {
					- "HAVE_METADATA"
				}
			}
			- " or greater, and the user agent "
			a href="#non-fatal-media-error" {
				- "encounters a non-fatal error"
			}
			- " during the processing of the\n  "
			a href="#media-data" id="playing-the-media-resource:media-data" {
				- "media data"
			}
			- ", and due to that error, is not able to play the content at the\n  "
			a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-3" {
				- "current playback position"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-11" {
				- "media element"
			}
			- " is said to have "
			dfn id="paused-for-user-interaction" {
				- "paused for user interaction"
			}
			- " when its\n  "
			code id="playing-the-media-resource:dom-media-paused-5" {
				a href="#dom-media-paused" {
					- "paused"
				}
			}
			- " attribute is false, the "
			code id="playing-the-media-resource:dom-media-readystate-5" {
				a href="#dom-media-readystate" {
					- "readyState"
				}
			}
			- " attribute is either "
			code id="playing-the-media-resource:dom-media-have_future_data-2" {
				a href="#dom-media-have_future_data" {
					- "HAVE_FUTURE_DATA"
				}
			}
			- " or "
			code id="playing-the-media-resource:dom-media-have_enough_data" {
				a href="#dom-media-have_enough_data" {
					- "HAVE_ENOUGH_DATA"
				}
			}
			- " and the user agent has reached a point\n  in the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-8" {
				- "media resource"
			}
			- " where the user has to make a selection for the resource to\n  continue."
		}
		- "\n\n  "
		p {
			- "It is possible for a "
			a href="#media-element" id="playing-the-media-resource:media-element-12" {
				- "media element"
			}
			- " to have both "
			a href="#ended-playback" id="playing-the-media-resource:ended-playback-3" {
				- "ended playback"
			}
			- " and\n  "
			a href="#paused-for-user-interaction" id="playing-the-media-resource:paused-for-user-interaction-2" {
				- "paused for user interaction"
			}
			- " at the same time."
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#media-element" id="playing-the-media-resource:media-element-13" {
				- "media element"
			}
			- " that is "
			a href="#potentially-playing" id="playing-the-media-resource:potentially-playing-2" {
				- "potentially playing"
			}
			- " stops playing\n  because it has "
			a href="#paused-for-user-interaction" id="playing-the-media-resource:paused-for-user-interaction-3" {
				- "paused for user interaction"
			}
			- ", the user agent must "
			a href="#queue-a-media-element-task" id="playing-the-media-resource:queue-a-media-element-task" {
				- "queue a media\n  element task"
			}
			- " given the "
			a href="#media-element" id="playing-the-media-resource:media-element-14" {
				- "media element"
			}
			- " to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fire\n  an event"
			}
			- " named "
			code id="playing-the-media-resource:event-media-timeupdate" {
				a href="#event-media-timeupdate" {
					- "timeupdate"
				}
			}
			- " at the element."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="playing-the-media-resource:media-element-15" {
				- "media element"
			}
			- " is said to have "
			dfn id="paused-for-in-band-content" {
				- "paused for in-band content"
			}
			- " when its\n  "
			code id="playing-the-media-resource:dom-media-paused-6" {
				a href="#dom-media-paused" {
					- "paused"
				}
			}
			- " attribute is false, the "
			code id="playing-the-media-resource:dom-media-readystate-6" {
				a href="#dom-media-readystate" {
					- "readyState"
				}
			}
			- " attribute is either "
			code id="playing-the-media-resource:dom-media-have_future_data-3" {
				a href="#dom-media-have_future_data" {
					- "HAVE_FUTURE_DATA"
				}
			}
			- " or "
			code id="playing-the-media-resource:dom-media-have_enough_data-2" {
				a href="#dom-media-have_enough_data" {
					- "HAVE_ENOUGH_DATA"
				}
			}
			- " and the user agent has suspended\n  playback of the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-9" {
				- "media resource"
			}
			- " in order to play content that is temporally anchored\n  to the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-10" {
				- "media resource"
			}
			- " and has a nonzero length, or to play content that is\n  temporally anchored to a segment of the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-11" {
				- "media resource"
			}
			- " but has a length longer than\n  that segment."
		}
		- "\n\n  "
		p class="example" {
			- "One example of when a "
			a href="#media-element" id="playing-the-media-resource:media-element-16" {
				- "media element"
			}
			- " would be "
			a href="#paused-for-in-band-content" id="playing-the-media-resource:paused-for-in-band-content-2" {
				- "paused for\n  in-band content"
			}
			- " is when the user agent is playing "
			a href="#attr-track-kind-descriptions" id="playing-the-media-resource:attr-track-kind-descriptions" {
				- "audio descriptions"
			}
			- " from an external WebVTT file, and\n  the synthesized speech generated for a cue is longer than the time between the "
			a href="#text-track-cue-start-time" id="playing-the-media-resource:text-track-cue-start-time" {
				- "text track\n  cue start time"
			}
			- " and the "
			a href="#text-track-cue-end-time" id="playing-the-media-resource:text-track-cue-end-time" {
				- "text track cue end time"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p id="reaches-the-end" {
			- "When the "
			a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-4" {
				- "current playback position"
			}
			- " reaches the end of the\n  "
			a href="#media-resource" id="playing-the-media-resource:media-resource-12" {
				- "media resource"
			}
			- " when the "
			a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback-4" {
				- "direction of playback"
			}
			- " is forwards, then the user\n  agent must follow these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the "
					a href="#media-element" id="playing-the-media-resource:media-element-17" {
						- "media element"
					}
					- " has a "
					code id="playing-the-media-resource:attr-media-loop-2" {
						a href="#attr-media-loop" {
							- "loop"
						}
					}
					- "\n   attribute specified, then "
					a href="#dom-media-seek" id="playing-the-media-resource:dom-media-seek" {
						- "seek"
					}
					- " to the "
					a href="#earliest-possible-position" id="playing-the-media-resource:earliest-possible-position-2" {
						- "earliest\n   possible position"
					}
					- " of the "
					a href="#media-resource" id="playing-the-media-resource:media-resource-13" {
						- "media resource"
					}
					- " and return."
				}
			}
			li {
				p {
					- "As defined above, the "
					code id="playing-the-media-resource:dom-media-ended" {
						a href="#dom-media-ended" {
							- "ended"
						}
					}
					- " IDL attribute starts\n   returning true once the "
					a href="#event-loop" id="playing-the-media-resource:event-loop-2" {
						- "event loop"
					}
					- " returns to "
					a href="#step1" {
						- "step 1"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					a href="#queue-a-media-element-task" id="playing-the-media-resource:queue-a-media-element-task-2" {
						- "Queue a media element task"
					}
					- " given the "
					a href="#media-element" id="playing-the-media-resource:media-element-18" {
						- "media element"
					}
					- " and the\n    following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-2" data-x-internal="concept-event-fire" {
								- "Fire an event"
							}
							- " named "
							code id="playing-the-media-resource:event-media-timeupdate-2" {
								a href="#event-media-timeupdate" {
									- "timeupdate"
								}
							}
							- " at the "
							a href="#media-element" id="playing-the-media-resource:media-element-19" {
								- "media element"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "If the "
							a href="#media-element" id="playing-the-media-resource:media-element-20" {
								- "media element"
							}
							- " has "
							a href="#ended-playback" id="playing-the-media-resource:ended-playback-4" {
								- "ended playback"
							}
							- ", the "
							a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback-5" {
								- "direction of\n      playback"
							}
							- " is forwards, and "
							a href="#dom-media-paused" id="playing-the-media-resource:dom-media-paused-7" {
								- "paused"
							}
							- " is false,\n      then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Set the "
									code id="playing-the-media-resource:dom-media-paused-8" {
										a href="#dom-media-paused" {
											- "paused"
										}
									}
									- " attribute to true."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-3" data-x-internal="concept-event-fire" {
										- "Fire an event"
									}
									- " named "
									code id="playing-the-media-resource:event-media-pause" {
										a href="#event-media-pause" {
											- "pause"
										}
									}
									- " at the "
									a href="#media-element" id="playing-the-media-resource:media-element-21" {
										- "media element"
									}
									- "."
								}
							}
							li {
								p {
									a href="#take-pending-play-promises" id="playing-the-media-resource:take-pending-play-promises" {
										- "Take pending play promises"
									}
									- " and "
									a href="#reject-pending-play-promises" id="playing-the-media-resource:reject-pending-play-promises" {
										- "reject pending play promises"
									}
									- "\n       with the result and an "
									a id="playing-the-media-resource:aborterror" href="https://webidl.spec.whatwg.org/#aborterror" data-x-internal="aborterror" {
										- "\""
										code {
											- "AbortError"
										}
										- "\""
									}
									- "\n       "
									code id="playing-the-media-resource:domexception" {
										a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
											- "DOMException"
										}
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-4" data-x-internal="concept-event-fire" {
								- "Fire an event"
							}
							- " named "
							code id="playing-the-media-resource:event-media-ended" {
								a href="#event-media-ended" {
									- "ended"
								}
							}
							- " at the "
							a href="#media-element" id="playing-the-media-resource:media-element-22" {
								- "media element"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "When the "
			a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-5" {
				- "current playback position"
			}
			- " reaches the "
			a href="#earliest-possible-position" id="playing-the-media-resource:earliest-possible-position-3" {
				- "earliest possible\n  position"
			}
			- " of the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-14" {
				- "media resource"
			}
			- " when the "
			a href="#direction-of-playback" id="playing-the-media-resource:direction-of-playback-6" {
				- "direction of playback"
			}
			- " is\n  backwards, then the user agent must only "
			a href="#queue-a-media-element-task" id="playing-the-media-resource:queue-a-media-element-task-3" {
				- "queue a media element task"
			}
			- " given the\n  "
			a href="#media-element" id="playing-the-media-resource:media-element-23" {
				- "media element"
			}
			- " to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-5" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named "
			code id="playing-the-media-resource:event-media-timeupdate-3" {
				a href="#event-media-timeupdate" {
					- "timeupdate"
				}
			}
			- " at the element."
		}
		- "\n\n  "
		p class="note" {
			- "The word \"reaches\" here does not imply that the "
			a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-6" {
				- "current playback\n  position"
			}
			- " needs to have changed during normal playback; it could be via "
			a href="#dom-media-seek" id="playing-the-media-resource:dom-media-seek-2" {
				- "seeking"
			}
			- ", for instance."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-defaultplaybackrate" data-dfn-type="attribute" {
				code {
					- "defaultPlaybackRate"
				}
			}
			- " attribute gives the\n  desired speed at which the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-15" {
				- "media resource"
			}
			- " is to play, as a multiple of its intrinsic\n  speed. The attribute is mutable: on getting it must return the last value it was set to, or 1.0 if\n  it hasn't yet been set; on setting the attribute must be set to the new value."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			code id="playing-the-media-resource:dom-media-defaultplaybackrate" {
				a href="#dom-media-defaultplaybackrate" {
					- "defaultPlaybackRate"
				}
			}
			- " is used\n  by the user agent when it "
			a href="#expose-a-user-interface-to-the-user" id="playing-the-media-resource:expose-a-user-interface-to-the-user" {
				- "exposes a user\n  interface to the user"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-playbackrate" data-dfn-type="attribute" {
				code {
					- "playbackRate"
				}
			}
			- " attribute gives the effective playback\n  rate, which is the speed at which the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-16" {
				- "media resource"
			}
			- " plays, as a multiple of its\n  intrinsic speed. If it is not equal to the "
			code id="playing-the-media-resource:dom-media-defaultplaybackrate-2" {
				a href="#dom-media-defaultplaybackrate" {
					- "defaultPlaybackRate"
				}
			}
			- ", then the implication is that\n  the user is using a feature such as fast forward or slow motion playback. The attribute is\n  mutable: on getting it must return the last value it was set to, or 1.0 if it hasn't yet been set;\n  on setting, the user agent must follow these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the given value is not supported by the user agent, then throw a\n   "
					a id="playing-the-media-resource:notsupportederror" href="https://webidl.spec.whatwg.org/#notsupportederror" data-x-internal="notsupportederror" {
						- "\""
						code {
							- "NotSupportedError"
						}
						- "\""
					}
					- " "
					code id="playing-the-media-resource:domexception-2" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					code id="playing-the-media-resource:dom-media-playbackrate-3" {
						a href="#dom-media-playbackrate" {
							- "playbackRate"
						}
					}
					- " to the new value, and if the\n   element is "
					a href="#potentially-playing" id="playing-the-media-resource:potentially-playing-3" {
						- "potentially playing"
					}
					- ", change the playback speed."
				}
			}
		}
		- "\n\n  "
		p id="rateUpdate" {
			- "When the "
			code id="playing-the-media-resource:dom-media-defaultplaybackrate-3" {
				a href="#dom-media-defaultplaybackrate" {
					- "defaultPlaybackRate"
				}
			}
			- " or "
			code id="playing-the-media-resource:dom-media-playbackrate-4" {
				a href="#dom-media-playbackrate" {
					- "playbackRate"
				}
			}
			- " attributes change value (either by being set\n  by script or by being changed directly by the user agent, e.g. in response to user control) the\n  user agent must "
			a href="#queue-a-media-element-task" id="playing-the-media-resource:queue-a-media-element-task-4" {
				- "queue a media element task"
			}
			- " given the "
			a href="#media-element" id="playing-the-media-resource:media-element-24" {
				- "media element"
			}
			- " to\n  "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-6" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named "
			code id="playing-the-media-resource:event-media-ratechange" {
				a href="#event-media-ratechange" {
					- "ratechange"
				}
			}
			- " at the "
			a href="#media-element" id="playing-the-media-resource:media-element-25" {
				- "media element"
			}
			- ". The user\n  agent must process attribute changes smoothly and must not introduce any perceivable gaps or\n  muting of playback in response."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-preservespitch" data-dfn-type="attribute" {
				code {
					- "preservesPitch"
				}
			}
			- " getter steps are to return true if a\n  pitch-preserving algorithm is in effect during playback. The setter steps are to correspondingly\n  switch the pitch-preserving algorithm on or off, without any perceivable gaps or muting of\n  playback. By default, such a pitch-preserving algorithm must be in effect (i.e., the getter will\n  initially return true)."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-played" data-dfn-type="attribute" {
				code {
					- "played"
				}
			}
			- "\n  attribute must return a new static "
			a href="#normalised-timeranges-object" id="playing-the-media-resource:normalised-timeranges-object" {
				- "normalized "
				code {
					- "TimeRanges"
				}
				- " object"
			}
			- " that\n  represents the ranges of points on the "
			a href="#media-timeline" id="playing-the-media-resource:media-timeline" {
				- "media timeline"
			}
			- " of the "
			a href="#media-resource" id="playing-the-media-resource:media-resource-17" {
				- "media\n  resource"
			}
			- " reached through the usual monotonic increase of the "
			a href="#current-playback-position" id="playing-the-media-resource:current-playback-position-7" {
				- "current playback\n  position"
			}
			- " during normal playback, if any, at the time the attribute is evaluated."
		}
		- "\n\n  "
		p class="warning" {
			- "Returning a new object each time is a bad pattern for attribute getters and is\n  only enshrined here as it would be costly to change it. It is not to be copied to new APIs."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			a href="#media-element" id="playing-the-media-resource:media-element-26" {
				- "media element"
			}
			- " has a "
			dfn id="list-of-pending-play-promises" {
				- "list of pending play promises"
			}
			- ", which must\n  initially be empty."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="take-pending-play-promises" {
				- "take pending play promises"
			}
			- " for a "
			a href="#media-element" id="playing-the-media-resource:media-element-27" {
				- "media element"
			}
			- ", the user agent must\n  run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "promises"
					}
					- " be an empty list of promises."
				}
			}
			li {
				p {
					- "Copy the "
					a href="#media-element" id="playing-the-media-resource:media-element-28" {
						- "media element"
					}
					- "'s "
					a href="#list-of-pending-play-promises" id="playing-the-media-resource:list-of-pending-play-promises" {
						- "list of pending play promises"
					}
					- " to\n   "
					var {
						- "promises"
					}
					- "."
				}
			}
			li {
				p {
					- "Clear the "
					a href="#media-element" id="playing-the-media-resource:media-element-29" {
						- "media element"
					}
					- "'s "
					a href="#list-of-pending-play-promises" id="playing-the-media-resource:list-of-pending-play-promises-2" {
						- "list of pending play\n   promises"
					}
					- "."
				}
			}
			li {
				- "Return "
				var {
					- "promises"
				}
				- "."
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="resolve-pending-play-promises" {
				- "resolve pending play promises"
			}
			- " for a "
			a href="#media-element" id="playing-the-media-resource:media-element-30" {
				- "media element"
			}
			- " with a list of\n  promises "
			var {
				- "promises"
			}
			- ", the user agent must resolve each promise in "
			var {
				- "promises"
			}
			- " with\n  undefined."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="reject-pending-play-promises" {
				- "reject pending play promises"
			}
			- " for a "
			a href="#media-element" id="playing-the-media-resource:media-element-31" {
				- "media element"
			}
			- " with a list of\n  promises "
			var {
				- "promises"
			}
			- " and an exception name "
			var {
				- "error"
			}
			- ", the user agent must reject\n  each promise in "
			var {
				- "promises"
			}
			- " with "
			var {
				- "error"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="notify-about-playing" {
				- "notify about playing"
			}
			- " for a "
			a href="#media-element" id="playing-the-media-resource:media-element-32" {
				- "media element"
			}
			- ", the user agent must run\n  the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="#take-pending-play-promises" id="playing-the-media-resource:take-pending-play-promises-2" {
						- "Take pending play promises"
					}
					- " and let "
					var {
						- "promises"
					}
					- " be the\n   result."
				}
			}
			li {
				- "\n    "
				p {
					a href="#queue-a-media-element-task" id="playing-the-media-resource:queue-a-media-element-task-5" {
						- "Queue a media element task"
					}
					- " given the element and the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="playing-the-media-resource:concept-event-fire-7" data-x-internal="concept-event-fire" {
								- "Fire an event"
							}
							- " named "
							code id="playing-the-media-resource:event-media-playing" {
								a href="#event-media-playing" {
									- "playing"
								}
							}
							- " at the element."
						}
					}
					li {
						p {
							a href="#resolve-pending-play-promises" id="playing-the-media-resource:resolve-pending-play-promises" {
								- "Resolve pending play promises"
							}
							- " with "
							var {
								- "promises"
							}
							- "."
						}
