			dfn id="text/plain-encoding-algorithm" {
				code {
					- "text/plain"
				}
				- " encoding algorithm"
			}
			- ", given a list of name-value\n  pairs "
			var {
				- "pairs"
			}
			- ", is as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be the empty string."
				}
			}
			li {
				- "\n    "
				p {
					- "For each "
					var {
						- "pair"
					}
					- " in "
					var {
						- "pairs"
					}
					- ":"
				}
				- "\n\n    "
