						- "form-associated custom element"
					}
					- "."
				}
				- "\n  "
			}
			dt {
				- " "
				dfn id="suffering-from-bad-input" {
					- "Suffering from bad input"
				}
				- " "
			}
			dd {
				- "\n    "
				p {
					- "When a control has incomplete input and the user agent does not think the user ought to\n    be able to submit the form in its current state."
				}
				- "\n\n    "
				p {
					- "When the "
					code id="definitions:dom-elementinternals-setvalidity-10" {
						a href="#dom-elementinternals-setvalidity" {
							- "setValidity()"
						}
					}
					- " method sets\n    "
					code {
						- "badInput"
					}
					- " flag to true for a "
					a href="#form-associated-custom-element" id="definitions:form-associated-custom-element-11" {
						- "form-associated custom element"
					}
					- ".\n    "
				}
				- "\n   "
			}
			dt {
				- " "
				dfn id="suffering-from-a-custom-error" {
					- "Suffering from a custom error"
				}
				- " "
			}
			dd {
				- " "
				p {
					- "When a control's "
					a href="#custom-validity-error-message" id="definitions:custom-validity-error-message-4" {
						- "custom validity error message"
					}
					- " (as set by the element's\n   "
					code id="definitions:dom-cva-setcustomvalidity-2" {
						a href="#dom-cva-setcustomvalidity" {
							- "setCustomValidity()"
						}
					}
					- " method or\n   "
					code id="definitions:elementinternals-2" {
						a href="#elementinternals" {
							- "ElementInternals"
						}
					}
					- "'s "
					code id="definitions:dom-elementinternals-setvalidity-11" {
						a href="#dom-elementinternals-setvalidity" {
							- "setValidity()"
						}
					}
					- " method) is\n   not the empty string."
				}
				- " "
			}
		}
		- "\n\n  "
		p class="note" {
			- "An element can still suffer from these states even when the element is "
			a href="#concept-fe-disabled" id="definitions:concept-fe-disabled" {
				- "disabled"
			}
			- "; thus these states can be represented in the DOM even\n  if validating the form during submission wouldn't indicate a problem to the user."
		}
		- "\n\n  "
		p {
			- "An element "
			dfn id="concept-fv-valid" {
				- "satisfies its constraints"
			}
			- " if it is not suffering\n  from any of the above "
			a href="#validity-states" id="definitions:validity-states" {
				- "validity states"
			}
			- "."
		}
		- "\n\n  \n\n\n\n  \n\n  "
		h5 id="constraint-validation" {
			span class="secno" {
				- "4.10.20.2"
			}
			- " Constraint validation"
			a href="#constraint-validation" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is required to "
			dfn id="statically-validate-the-constraints" {
				- "statically validate the constraints"
			}
			- " of\n  "
			code id="constraint-validation:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element "
			var {
				- "form"
			}
			- ", it must run the following steps, which return\n  either a "
			i {
				- "positive"
			}
			- " result (all the controls in the form are valid) or a "
			i {
				- "negative"
			}
			- "\n  result (there are invalid controls) along with a (possibly empty) list of elements that are\n  invalid and for which no script has claimed responsibility:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "controls"
