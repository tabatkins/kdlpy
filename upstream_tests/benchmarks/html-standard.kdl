											- " is not null, then set "
											var {
												- "scope"
											}
											- " to "
											a href="https://tc39.es/ecma262/#sec-newobjectenvironment" id="event-handler-attributes:js-newobjectenvironment-2" data-x-internal="js-newobjectenvironment" {
												- "NewObjectEnvironment"
											}
											- "("
											var {
												- "form owner"
											}
											- ", true,\n         "
											var {
												- "scope"
											}
											- ")."
										}
									}
									li {
										p {
											- "If "
											var {
												- "element"
											}
											- " is not null, then set "
											var {
												- "scope"
											}
											- " to "
											a href="https://tc39.es/ecma262/#sec-newobjectenvironment" id="event-handler-attributes:js-newobjectenvironment-3" data-x-internal="js-newobjectenvironment" {
												- "NewObjectEnvironment"
											}
											- "("
											var {
												- "element"
											}
											- ", true,\n         "
											var {
												- "scope"
											}
											- ")."
										}
									}
									li {
										p {
											- "Return "
											var {
												- "scope"
											}
											- "."
										}
									}
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					li {
						p {
							- "Remove "
							var {
								- "settings object"
							}
							- "'s "
							a href="#realm-execution-context" id="event-handler-attributes:realm-execution-context-2" {
								- "realm execution context"
							}
							- " from the\n     "
							a id="event-handler-attributes:javascript-execution-context-stack-2" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
								- "JavaScript execution context stack"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Set "
							var {
								- "function"
							}
							- ".[[ScriptOrModule]] to null."
						}
						- "\n\n      "
						div class="note" {
							- "\n       "
							p {
								- "This is done because the default behavior, of associating the created function\n       with the nearest "
								a href="#concept-script" id="event-handler-attributes:concept-script" {
									- "script"
								}
								- " on the stack, can lead to\n       path-dependent results. For example, an event handler which is first invoked by user\n       interaction would end up with null [[ScriptOrModule]] (since then this algorithm would be\n       first invoked when the "
								a href="#active-script" id="event-handler-attributes:active-script" {
									- "active script"
								}
								- " is null), whereas one that is first invoked\n       by dispatching an event from script would have its [[ScriptOrModule]] set to that script."
							}
							- "\n\n       "
							p {
								- "Instead, we just always set [[ScriptOrModule]] to null. This is more intuitive anyway; the\n       idea that the first script which dispatches an event is somehow responsible for the event\n       handler code is dubious."
							}
							- "\n\n       "
							p {
								- "In practice, this only affects the resolution of relative URLs via "
								code id="event-handler-attributes:import()" {
									a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" {
										- "import()"
									}
								}
								- ",\n       which consult the "
								a href="#concept-script-base-url" id="event-handler-attributes:concept-script-base-url" {
									- "base URL"
								}
								- " of the associated\n       script. Nulling out [[ScriptOrModule]] means that "
								a href="#hostloadimportedmodule" id="event-handler-attributes:hostloadimportedmodule" {
									- "HostLoadImportedModule"
								}
								- " will\n       fall back to the "
								a href="#current-settings-object" id="event-handler-attributes:current-settings-object" {
									- "current settings object"
								}
								- "'s "
								a href="#api-base-url" id="event-handler-attributes:api-base-url" {
									- "API base URL"
								}
								- "."
							}
							- "\n      "
						}
						- "\n     "
					}
					li {
						p {
							- "Set "
							var {
								- "eventHandler"
							}
							- "'s "
							a href="#event-handler-value" id="event-handler-attributes:event-handler-value-12" {
								- "value"
							}
							- " to the\n     result of creating a Web IDL "
							code id="event-handler-attributes:eventhandler-3" {
								a href="#eventhandler" {
									- "EventHandler"
								}
							}
							- " callback function object whose object\n     reference is "
							var {
								- "function"
							}
							- " and whose "
							a id="event-handler-attributes:callback-context-2" href="https://webidl.spec.whatwg.org/#dfn-callback-context" data-x-internal="callback-context" {
								- "callback context"
							}
							- " is "
							var {
								- "settings\n     object"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "eventHandler"
					}
					- "'s "
