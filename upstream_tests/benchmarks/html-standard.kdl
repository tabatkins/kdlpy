				- " and "
				code {
					- "https://streams.spec.whatwg.org/"
				}
				- " in the recent past, then the rendering might look\n   like this:"
			}
			- "\n\n   "
			p {
				img class="darkmode-aware" src="/images/sample-url.svg" width="480" alt="A text box with an icon on the left followed by the text \"spec.w\" and a cursor, with a drop down button on the right hand side; with, below, a drop down box containing a list of six URLs on the left, with the first four having grayed out labels on the right; and a scrollbar to the right of the drop down box, indicating further values are available." height="150"
			}
			- "\n\n   "
			p {
				- "The first four URLs in this sample consist of the four URLs in the author-specified list that\n   match the text the user has entered, sorted in some "
				a id="url-state-(type=url):implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
					- "implementation-defined"
				}
				- " manner\n   (maybe by how frequently the user refers to those URLs). Note how the UA is using the knowledge\n   that the values are URLs to allow the user to omit the scheme part and perform intelligent\n   matching on the domain name."
			}
			- "\n\n   "
			p {
				- "The last two URLs (and probably many more, given the scrollbar's indications of more values\n   being available) are the matches from the user agent's session history data. This data is not\n   made available to the page DOM. In this particular case, the UA has no titles to provide for\n   those values."
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h6 id="email-state-(type=email)" {
			span class="secno" {
				- "4.10.5.1.5"
			}
			- " "
			dfn data-dfn-for="input" data-dfn-type="element-state" {
				- "Email"
			}
			- " state ("
			code {
				- "type=email"
			}
			- ")"
			span id="e-mail-state-(type=email)"
			a href="#email-state-(type=email)" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/email" title="<input> elements of type email are used to let the user enter and edit an email address, or, if the multiple attribute is specified, a list of email addresses." {
						- "Element/input/email"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "5+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "5+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "11+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "10+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "3+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "11+"
						}
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="email-state-(type=email):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="email-state-(type=email):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#email-state-(type=email)" id="email-state-(type=email):email-state-(type=email)" {
				- "Email"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "How the "
			a href="#email-state-(type=email)" id="email-state-(type=email):email-state-(type=email)-2" {
				- "Email"
			}
			- " state operates depends on whether the\n  "
			code id="email-state-(type=email):attr-input-multiple" {
				a href="#attr-input-multiple" {
					- "multiple"
				}
			}
			- " attribute is specified or not."
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "When the "
				code id="email-state-(type=email):attr-input-multiple-2" {
					a href="#attr-input-multiple" {
						- "multiple"
					}
				}
				- " attribute is not specified on the\n   element"
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="email-state-(type=email):the-input-element-2" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " element "
					a href="#represents" id="email-state-(type=email):represents" {
						- "represents"
					}
					- " a control for editing an email\n    address given in the element's "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value" {
						- "value"
					}
					- "."
				}
				- "\n\n    \n\n    "
				p {
					- "If the element is "
					i id="email-state-(type=email):concept-fe-mutable" {
						a href="#concept-fe-mutable" {
							- "mutable"
						}
					}
					- ", the user agent should allow the\n    user to change the email address represented by its "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-2" {
						- "value"
					}
					- ". User agents may allow the user to set the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-3" {
						- "value"
					}
					- " to a string that is not a "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address" {
						- "valid email\n    address"
					}
					- ". The user agent should act in a manner consistent with expecting the user to\n    provide a single email address. User agents should allow the user to set the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-4" {
						- "value"
					}
					- " to the empty string. User agents must not allow users to\n    insert U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR) characters into the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-5" {
						- "value"
					}
					- ". User agents may transform the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-6" {
						- "value"
					}
					- " for display and editing; in particular, user agents should\n    convert punycode in the domain labels of the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-7" {
						- "value"
					}
					- " to IDN in the display and\n    vice versa."
				}
				- "\n\n    "
				p {
					strong {
						- "Constraint validation"
					}
					- ": While the user interface is representing input that\n    the user agent cannot convert to punycode, the control is "
					a href="#suffering-from-bad-input" id="email-state-(type=email):suffering-from-bad-input" {
						- "suffering from bad\n    input"
					}
					- "."
				}
				- "\n\n    \n\n    "
				p {
					- "The "
					code id="email-state-(type=email):attr-input-value" {
						a href="#attr-input-value" {
							- "value"
						}
					}
					- " attribute, if specified and not empty, must\n    have a value that is a single "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address-2" {
						- "valid email address"
					}
					- "."
				}
				- "\n\n    \n\n    "
				p {
					strong {
						- "The "
						a href="#value-sanitization-algorithm" id="email-state-(type=email):value-sanitization-algorithm" {
							- "value sanitization algorithm"
						}
						- " is as follows"
					}
					- ": "
					a id="email-state-(type=email):strip-newlines" href="https://infra.spec.whatwg.org/#strip-newlines" data-x-internal="strip-newlines" {
						- "Strip\n    newlines"
					}
					- " from the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-8" {
						- "value"
					}
					- ", then "
					a id="email-state-(type=email):strip-leading-and-trailing-ascii-whitespace" href="https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace" data-x-internal="strip-leading-and-trailing-ascii-whitespace" {
						- "strip leading\n    and trailing ASCII whitespace"
					}
					- " from the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-9" {
						- "value"
					}
					- "."
				}
				- "\n\n    "
				p {
					strong {
						- "Constraint validation"
					}
					- ": While the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-10" {
						- "value"
					}
					- "\n    of the element is neither the empty string nor a single "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address-3" {
						- "valid email address"
					}
					- ", the\n    element is "
					a href="#suffering-from-a-type-mismatch" id="email-state-(type=email):suffering-from-a-type-mismatch" {
						- "suffering from a type mismatch"
					}
					- "."
				}
				- "\n\n    \n   "
			}
			dt {
				- "When the "
				code id="email-state-(type=email):attr-input-multiple-3" {
					a href="#attr-input-multiple" {
						- "multiple"
					}
				}
				- " attribute "
				em {
					- "is"
				}
				- " specified on\n   the element"
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="email-state-(type=email):the-input-element-3" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " element "
					a href="#represents" id="email-state-(type=email):represents-2" {
						- "represents"
					}
					- " a control for adding, removing, and\n    editing the email addresses given in the element's "
					a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values" {
						- "value"
						em {
							- "s"
						}
					}
					- "."
				}
				- "\n\n    \n\n    "
				p {
					- "If the element is "
					i id="email-state-(type=email):concept-fe-mutable-2" {
						a href="#concept-fe-mutable" {
							- "mutable"
						}
					}
					- ", the user agent should allow the\n    user to add, remove, and edit the email addresses represented by its "
					a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values-2" {
						- "values"
					}
					- ". User agents may allow the user to set any\n    individual value in the list of "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-11" {
						- "value"
						em {
							- "s"
						}
					}
					- " to a\n    string that is not a "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address-4" {
						- "valid email address"
					}
					- ", but must not allow users to set any\n    individual value to a string containing U+002C COMMA (,), U+000A LINE FEED (LF), or U+000D\n    CARRIAGE RETURN (CR) characters. User agents should allow the user to remove all the addresses\n    in the element's "
					a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values-3" {
						- "values"
					}
					- ". User agents may\n    transform the "
					a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values-4" {
						- "values"
					}
					- " for display and editing; in\n    particular, user agents should convert punycode in the domain labels of the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-12" {
						- "value"
					}
					- " to IDN in the display and vice versa."
				}
				- "\n\n    "
				p {
					strong {
						- "Constraint validation"
					}
					- ": While the user interface describes a situation where\n    an individual value contains a U+002C COMMA (,) or is representing input that the user agent\n    cannot convert to punycode, the control is "
					a href="#suffering-from-bad-input" id="email-state-(type=email):suffering-from-bad-input-2" {
						- "suffering from bad input"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Whenever the user changes the element's "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-13" {
						- "value"
						em {
							- "s"
						}
					}
					- ", the user agent must run the following\n    steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "latest values"
							}
							- " be a copy of the element's "
							a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-14" {
								- "value"
								em {
									- "s"
								}
							}
							- "."
						}
					}
					li {
						p {
							a id="email-state-(type=email):strip-leading-and-trailing-ascii-whitespace-2" href="https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace" data-x-internal="strip-leading-and-trailing-ascii-whitespace" {
								- "Strip leading and trailing ASCII whitespace"
							}
							- " from each value in "
							var {
								- "latest\n     values"
							}
							- "."
						}
					}
					li {
						p {
							- "Let the element's "
							a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-15" {
								- "value"
							}
							- " be the result of\n     concatenating all the values in "
							var {
								- "latest values"
							}
							- ", separating each value from\n     the next by a single U+002C COMMA character (,), maintaining the list's order."
						}
					}
				}
				- "\n\n    \n\n    "
				p {
					- "The "
					code id="email-state-(type=email):attr-input-value-2" {
						a href="#attr-input-value" {
							- "value"
						}
					}
					- " attribute, if specified, must have a value\n    that is a "
					a href="#valid-e-mail-address-list" id="email-state-(type=email):valid-e-mail-address-list" {
						- "valid email address list"
					}
					- "."
				}
				- "\n\n    \n\n    "
				p {
					strong {
						- "The "
						a href="#value-sanitization-algorithm" id="email-state-(type=email):value-sanitization-algorithm-2" {
							- "value sanitization algorithm"
						}
						- " is as follows"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a href="https://infra.spec.whatwg.org/#split-on-commas" id="email-state-(type=email):split-a-string-on-commas" data-x-internal="split-a-string-on-commas" {
								- "Split on commas"
							}
							- " the element's "
							a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-16" {
								- "value"
							}
							- ", "
							a id="email-state-(type=email):strip-leading-and-trailing-ascii-whitespace-3" href="https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace" data-x-internal="strip-leading-and-trailing-ascii-whitespace" {
								- "strip leading and trailing ASCII\n     whitespace"
							}
							- " from each resulting token, if any, and let the element's "
							a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values-5" {
								- "values"
							}
							- " be the (possibly empty) resulting list of\n     (possibly empty) tokens, maintaining the original order."
						}
					}
					li {
						p {
							- "Let the element's "
							a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-17" {
								- "value"
							}
							- " be the result of\n     concatenating the element's "
							a href="#concept-fe-values" id="email-state-(type=email):concept-fe-values-6" {
								- "values"
							}
							- ", separating\n     each value from the next by a single U+002C COMMA character (,), maintaining the list's\n     order."
						}
					}
				}
				- "\n\n    "
				p {
					strong {
						- "Constraint validation"
					}
					- ": While the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-18" {
						- "value"
					}
					- "\n    of the element is not a "
					a href="#valid-e-mail-address-list" id="email-state-(type=email):valid-e-mail-address-list-2" {
						- "valid email address list"
					}
					- ", the element is "
					a href="#suffering-from-a-type-mismatch" id="email-state-(type=email):suffering-from-a-type-mismatch-2" {
						- "suffering\n    from a type mismatch"
					}
					- "."
				}
				- "\n\n    \n   "
			}
		}
		- "\n\n  "
		p {
			- "When the "
			code id="email-state-(type=email):attr-input-multiple-4" {
				a href="#attr-input-multiple" {
					- "multiple"
				}
			}
			- " attribute is set or removed, the\n  user agent must run the "
			a href="#value-sanitization-algorithm" id="email-state-(type=email):value-sanitization-algorithm-3" {
				- "value sanitization algorithm"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="valid-e-mail-address" {
				- "valid email address"
			}
			- " is a string that matches the "
			code {
				- "email"
			}
			- " production of the following ABNF, the character set for which is Unicode.\n  This ABNF implements the extensions described in RFC 1123. "
			a href="#refsABNF" {
				- "[ABNF]"
			}
			- " "
			a href="#refsRFC5322" {
				- "[RFC5322]"
			}
			- "\n  "
			a href="#refsRFC1034" {
				- "[RFC1034]"
			}
			- " "
			a href="#refsRFC1123" {
				- "[RFC1123]"
			}
		}
		- "\n\n  "
		pre {
			code class="abnf" {
				c- nc="" {
					- "email"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- o="" {
					- "1*"
				}
				c- p="" {
					- "("
				}
				- " "
				c- nc="" {
					- "atext"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "\".\""
				}
				- " "
				c- p="" {
					- ")"
				}
				- " "
				c- l="" {
					- "\"@\""
				}
				- " "
				c- nc="" {
					- "label"
				}
				- " "
				c- o="" {
					- "*"
				}
				c- p="" {
					- "("
				}
				- " "
				c- l="" {
					- "\".\""
				}
				- " "
				c- nc="" {
					- "label"
				}
				- " "
				c- p="" {
					- ")"
				}
				- "\n"
				c- nc="" {
					- "label"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- nc="" {
					- "let-dig"
				}
				- " "
				c- p="" {
					- "["
				}
				- " "
				c- p="" {
					- "["
				}
				- " "
				c- nc="" {
					- "ldh-str"
				}
				- " "
				c- p="" {
					- "]"
				}
				- " "
				c- nc="" {
					- "let-dig"
				}
				- " "
				c- p="" {
					- "]"
				}
				- "  "
				c- c1="" {
					- "; limited to a length of 63 characters by "
				}
				a href="https://www.rfc-editor.org/rfc/rfc1034#section-3.5" {
					c- c1="" {
						- "RFC 1034 section 3.5"
					}
				}
				- "\n"
				c- nc="" {
					- "atext"
