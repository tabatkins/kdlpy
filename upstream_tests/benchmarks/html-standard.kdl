			}
			- ", an "
			a href="#environment-settings-object" id="script-settings-for-workers:environment-settings-object" {
				- "environment settings object"
			}
			- "\n  "
			var {
				- "outside settings"
			}
			- ", and a number "
			var {
				- "unsafeWorkerCreationTime"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "inherited origin"
					}
					- " be "
					var {
