										- "relevant settings\n       object"
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									var {
										- "request"
									}
									- "'s "
									a href="https://fetch.spec.whatwg.org/#request-initiator-type" id="loading-the-media-resource:concept-request-initiator-type" data-x-internal="concept-request-initiator-type" {
										- "initiator\n       type"
									}
									- " to "
									var {
										- "destination"
									}
									- "."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "byteRange"
									}
									- ", which is \""
									code {
										- "entire resource"
									}
									- "\" or a\n       (number, number or \""
