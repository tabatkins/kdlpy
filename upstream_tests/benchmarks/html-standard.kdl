					- "min"
				}
			}
			- " content\n  attribute must be set to that string."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMeterElement" id="dom-meter-max" data-dfn-type="attribute" {
				code {
