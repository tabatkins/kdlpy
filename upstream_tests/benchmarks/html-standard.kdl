		- "\n\n\n  "
		h6 id="date-state-(type=date)" {
			span class="secno" {
				- "4.10.5.1.7"
			}
			- " "
			dfn data-dfn-for="input" data-dfn-type="element-state" {
				- "Date"
			}
			- " state ("
			code {
				- "type=date"
			}
			- ")"
			a href="#date-state-(type=date)" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/date" title="<input> elements of type=\"date\" create input fields that let the user enter a date, either with a textbox that validates the input or a special date picker interface." {
						- "Element/input/date"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "57+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "14.1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "20+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "11+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
