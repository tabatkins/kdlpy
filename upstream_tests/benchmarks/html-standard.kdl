					- "\n\n    "
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "In this example, the web page has three layouts depending on the width of the\n     "
						a id="introduction-3:viewport-7" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- ". The narrow layout has one column of images (the width of each image is\n     about 100%), the middle layout has two columns of images (the width of each image is about\n     50%), and the widest layout has three columns of images, and some page margin (the width of\n     each image is about 33%). It breaks between these layouts when the "
						a id="introduction-3:viewport-8" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
							- "viewport"
						}
						- " is\n     "
						code {
							- "30em"
						}
						- " wide and "
						code {
							- "50em"
						}
						- " wide, respectively."
					}
					- "\n\n"
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "img"
							}
							- " "
							strong {
								c- e="" {
