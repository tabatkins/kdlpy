			}
			- ", then those\n  rules apply.  Otherwise, if the resource is expected to be an image, user agents may apply the\n  "
			a href="https://mimesniff.spec.whatwg.org/#rules-for-sniffing-images-specifically" id="processing-the-type-attribute:content-type-sniffing:-image" data-x-internal="content-type-sniffing:-image" {
				- "image sniffing rules"
			}
			- ", with the "
			var {
				- "official\n  type"
