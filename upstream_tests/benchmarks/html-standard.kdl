				}
				- " "
				a id="the-navigateevent-interface:abortsignal-2" href="https://dom.spec.whatwg.org/#abortsignal" data-x-internal="abortsignal" {
					c- n="" {
						- "AbortSignal"
					}
				}
				- " "
				dfn data-dfn-for="NavigateEventInit" id="dom-navigateeventinit-signal" data-dfn-type="dict-member" {
					c- g="" {
						- "signal"
					}
				}
				- ";\n  "
				a id="the-navigateevent-interface:formdata-2" href="https://xhr.spec.whatwg.org/#formdata" data-x-internal="formdata" {
