		}
		- "\n\n\n  "
		h5 id="limiting-user-input-length:-the-maxlength-attribute" {
			span class="secno" {
				- "4.10.18.3"
			}
			- " Limiting user input length: the "
			code id="limiting-user-input-length:-the-maxlength-attribute:attr-fe-maxlength" {
				a href="#attr-fe-maxlength" {
					- "maxlength"
				}
			}
			- " attribute"
			a href="#limiting-user-input-length:-the-maxlength-attribute" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn data-dfn-for="input,textarea" id="attr-fe-maxlength" data-dfn-type="element-attr" data-lt="maxlength" {
				- "form\n  control "
				code {
					- "maxlength"
				}
				- " attribute"
			}
			- ", controlled by the "
			a href="#concept-fe-dirty" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-dirty" {
				- "dirty value flag"
			}
			- ", declares a limit on the number of characters a\n  user can input. The number of characters is measured using "
			a id="limiting-user-input-length:-the-maxlength-attribute:length" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
				- "length"
			}
			- " and, in the case\n  of "
			code id="limiting-user-input-length:-the-maxlength-attribute:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements, with all newlines normalized to a single character (as opposed\n  to CRLF pairs)."
		}
		- "\n\n  "
		p {
			- "If an element has its "
			a href="#attr-fe-maxlength" id="limiting-user-input-length:-the-maxlength-attribute:attr-fe-maxlength-2" {
				- "form control "
				code {
					- "maxlength"
				}
				- " attribute"
			}
			- " specified, the attribute's value must be a "
			a href="#valid-non-negative-integer" id="limiting-user-input-length:-the-maxlength-attribute:valid-non-negative-integer" {
				- "valid\n  non-negative integer"
			}
			- ". If the attribute is specified and applying the "
			a href="#rules-for-parsing-non-negative-integers" id="limiting-user-input-length:-the-maxlength-attribute:rules-for-parsing-non-negative-integers" {
				- "rules for\n  parsing non-negative integers"
			}
			- " to its value results in a number, then that number is the\n  element's "
			dfn id="maximum-allowed-value-length" {
				- "maximum allowed value length"
			}
			- ". If the attribute is omitted or parsing its\n  value results in an error, then there is no "
			a href="#maximum-allowed-value-length" id="limiting-user-input-length:-the-maxlength-attribute:maximum-allowed-value-length" {
				- "maximum allowed value length"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": If an element has a "
			a href="#maximum-allowed-value-length" id="limiting-user-input-length:-the-maxlength-attribute:maximum-allowed-value-length-2" {
				- "maximum allowed value\n  length"
			}
			- ", its "
			a href="#concept-fe-dirty" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-dirty-2" {
				- "dirty value flag"
			}
			- " is true, its "
			a href="#concept-fe-value" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-value" {
				- "value"
			}
			- " was last changed by a user edit (as opposed to a change\n  made by a script), and the "
			a id="limiting-user-input-length:-the-maxlength-attribute:length-2" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
				- "length"
			}
			- " of the element's "
			a href="#concept-fe-api-value" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-api-value" {
				- "API value"
			}
			- " is greater than the element's "
			a href="#maximum-allowed-value-length" id="limiting-user-input-length:-the-maxlength-attribute:maximum-allowed-value-length-3" {
				- "maximum allowed\n  value length"
			}
			- ", then the element is "
			a href="#suffering-from-being-too-long" id="limiting-user-input-length:-the-maxlength-attribute:suffering-from-being-too-long" {
				- "suffering from being too long"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "User agents may prevent the user from causing the element's "
			a href="#concept-fe-api-value" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-api-value-2" {
				- "API value"
			}
			- " to be set to a value whose "
			a id="limiting-user-input-length:-the-maxlength-attribute:length-3" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
				- "length"
			}
			- " is\n  greater than the element's "
			a href="#maximum-allowed-value-length" id="limiting-user-input-length:-the-maxlength-attribute:maximum-allowed-value-length-4" {
				- "maximum allowed value length"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "In the case of "
			code id="limiting-user-input-length:-the-maxlength-attribute:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements, the "
			a href="#concept-fe-api-value" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-api-value-3" {
				- "API value"
			}
			- " and "
			a href="#concept-fe-value" id="limiting-user-input-length:-the-maxlength-attribute:concept-fe-value-2" {
				- "value"
			}
			- "\n  differ. In particular, "
			a href="https://infra.spec.whatwg.org/#normalize-newlines" id="limiting-user-input-length:-the-maxlength-attribute:normalize-newlines" data-x-internal="normalize-newlines" {
				- "newline normalization"
			}
			- " is applied\n  before the "
			a href="#maximum-allowed-value-length" id="limiting-user-input-length:-the-maxlength-attribute:maximum-allowed-value-length-5" {
				- "maximum allowed value length"
			}
			- " is checked (whereas the "
			a href="#textarea-wrapping-transformation" id="limiting-user-input-length:-the-maxlength-attribute:textarea-wrapping-transformation" {
				- "textarea\n  wrapping transformation"
			}
			- " is not applied)."
		}
		- "\n\n  \n\n\n  "
		h5 id="setting-minimum-input-length-requirements:-the-minlength-attribute" {
			span class="secno" {
				- "4.10.18.4"
			}
			- " Setting minimum input length requirements: the "
			code id="setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength" {
				a href="#attr-fe-minlength" {
					- "minlength"
				}
			}
			- " attribute"
			a href="#setting-minimum-input-length-requirements:-the-minlength-attribute" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn data-dfn-for="input,textarea" id="attr-fe-minlength" data-dfn-type="element-attr" data-lt="minlength" {
				- "form\n  control "
				code {
					- "minlength"
				}
				- " attribute"
			}
			- ", controlled by the "
			a href="#concept-fe-dirty" id="setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-dirty" {
				- "dirty value flag"
			}
			- ", declares a lower bound on the number of\n  characters a user can input. The \"number of characters\" is measured using "
			a id="setting-minimum-input-length-requirements:-the-minlength-attribute:length" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
				- "length"
			}
			- " and,\n  in the case of "
			code id="setting-minimum-input-length-requirements:-the-minlength-attribute:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements, with all newlines normalized to a single character\n  (as opposed to CRLF pairs)."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			code id="setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-2" {
				a href="#attr-fe-minlength" {
					- "minlength"
				}
			}
			- " attribute does not imply the\n  "
			code {
				- "required"
			}
			- " attribute. If the form control has no "
			code {
				- "required"
			}
			- " attribute, then the value can still be omitted; the "
			code id="setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-3" {
				a href="#attr-fe-minlength" {
					- "minlength"
				}
			}
			- " attribute only kicks in once the user has entered a\n  value at all. If the empty string is not allowed, then the "
			code {
				- "required"
			}
			- "\n  attribute also needs to be set."
		}
		- "\n\n  "
		p {
			- "If an element has its "
			a href="#attr-fe-minlength" id="setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-4" {
				- "form control "
				code {
					- "minlength"
				}
				- " attribute"
			}
			- " specified, the attribute's value must be a "
			a href="#valid-non-negative-integer" id="setting-minimum-input-length-requirements:-the-minlength-attribute:valid-non-negative-integer" {
				- "valid\n  non-negative integer"
			}
			- ". If the attribute is specified and applying the "
			a href="#rules-for-parsing-non-negative-integers" id="setting-minimum-input-length-requirements:-the-minlength-attribute:rules-for-parsing-non-negative-integers" {
				- "rules for\n  parsing non-negative integers"
			}
			- " to its value results in a number, then that number is the\n  element's "
			dfn id="minimum-allowed-value-length" {
				- "minimum allowed value length"
			}
			- ". If the attribute is omitted or parsing its\n  value results in an error, then there is no "
			a href="#minimum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length" {
				- "minimum allowed value length"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "If an element has both a "
			a href="#maximum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:maximum-allowed-value-length" {
				- "maximum allowed value length"
			}
			- " and a "
			a href="#minimum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-2" {
				- "minimum allowed\n  value length"
			}
			- ", the "
			a href="#minimum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-3" {
				- "minimum allowed value length"
			}
			- " must be smaller than or equal\n  to the "
			a href="#maximum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:maximum-allowed-value-length-2" {
				- "maximum allowed value length"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": If an element has a "
			a href="#minimum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-4" {
				- "minimum allowed value\n  length"
			}
			- ", its "
			a href="#concept-fe-dirty" id="setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-dirty-2" {
				- "dirty value flag"
			}
			- " is true, its "
			a href="#concept-fe-value" id="setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-value" {
				- "value"
			}
			- " was last changed by a user edit (as opposed to a change\n  made by a script), its "
			a href="#concept-fe-value" id="setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-value-2" {
				- "value"
			}
			- " is not the empty string, and\n  the "
			a id="setting-minimum-input-length-requirements:-the-minlength-attribute:length-2" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
				- "length"
			}
			- " of the element's "
			a href="#concept-fe-api-value" id="setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-api-value" {
				- "API value"
			}
			- " is\n  less than the element's "
			a href="#minimum-allowed-value-length" id="setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-5" {
				- "minimum allowed value length"
