									}
									- " created by the "
									a href="#html-parser" id="serialising-html-fragments:html-parser" {
										- "HTML parser"
									}
									- " or\n        "
									code id="serialising-html-fragments:dom-document-createelement" {
										a data-x-internal="dom-document-createelement" href="https://dom.spec.whatwg.org/#dom-document-createelement" {
											- "createElement()"
										}
									}
