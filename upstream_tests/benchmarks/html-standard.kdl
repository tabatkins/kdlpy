							- "form"
						}
					}
					- " element is "
					a href="#concept-form-reset" id="categories:concept-form-reset" {
						- "reset"
					}
					- "."
				}
				- "\n\n    \n    "
				ul class="brief category-list" {
					li {
						code id="categories:the-input-element-4" {
							a href="#the-input-element" {
