								}
							}
							- " attribute."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "navigation"
							}
							- " be "
							var {
								- "subject"
							}
							- "'s "
							a href="#concept-relevant-global" id="downloading-resources:concept-relevant-global" {
								- "relevant global object"
							}
							- "'s\n     "
