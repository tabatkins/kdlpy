							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When an "
			code id="url-state-(type=url):the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element's "
			code id="url-state-(type=url):attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in\n  the "
			a href="#url-state-(type=url)" id="url-state-(type=url):url-state-(type=url)" {
				- "URL"
			}
			- " state, the rules in this section apply."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="url-state-(type=url):the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element "
			a href="#represents" id="url-state-(type=url):represents" {
				- "represents"
			}
			- " a control for editing a single\n  "
			a id="url-state-(type=url):absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- " given in the element's "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value" {
				- "value"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "If the element is "
			i id="url-state-(type=url):concept-fe-mutable" {
				a href="#concept-fe-mutable" {
					- "mutable"
				}
			}
			- ", the user agent should allow the\n  user to change the URL represented by its "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-2" {
				- "value"
			}
			- ". User agents\n  may allow the user to set the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-3" {
				- "value"
			}
			- " to a string that is not\n  a "
			a href="https://url.spec.whatwg.org/#valid-url-string" id="url-state-(type=url):valid-url-string" data-x-internal="valid-url-string" {
				- "valid"
			}
			- " "
			a id="url-state-(type=url):absolute-url-2" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- ", but may also or instead\n  automatically escape characters entered by the user so that the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-4" {
				- "value"
			}
			- " is always a "
			a href="https://url.spec.whatwg.org/#valid-url-string" id="url-state-(type=url):valid-url-string-2" data-x-internal="valid-url-string" {
				- "valid"
			}
			- "\n  "
			a id="url-state-(type=url):absolute-url-3" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- " (even if that isn't the actual value seen and edited by the user in the\n  interface). User agents should allow the user to set the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-5" {
				- "value"
			}
			- " to the empty string. User agents must not allow users to\n  insert U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR) characters into the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-6" {
				- "value"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="url-state-(type=url):attr-input-value" {
				a href="#attr-input-value" {
					- "value"
				}
			}
			- " attribute, if specified and not empty, must\n  have a value that is a "
			a href="#valid-url-potentially-surrounded-by-spaces" id="url-state-(type=url):valid-url-potentially-surrounded-by-spaces" {
				- "valid URL potentially surrounded by spaces"
			}
			- " that is also an\n  "
			a id="url-state-(type=url):absolute-url-4" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "The "
				a href="#value-sanitization-algorithm" id="url-state-(type=url):value-sanitization-algorithm" {
					- "value sanitization algorithm"
				}
				- " is as follows"
			}
			- ": "
			a id="url-state-(type=url):strip-newlines" href="https://infra.spec.whatwg.org/#strip-newlines" data-x-internal="strip-newlines" {
				- "Strip\n  newlines"
			}
			- " from the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-7" {
				- "value"
			}
			- ", then "
			a id="url-state-(type=url):strip-leading-and-trailing-ascii-whitespace" href="https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace" data-x-internal="strip-leading-and-trailing-ascii-whitespace" {
				- "strip leading\n  and trailing ASCII whitespace"
			}
			- " from the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-8" {
				- "value"
			}
			- "."
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": While the "
			a href="#concept-fe-value" id="url-state-(type=url):concept-fe-value-9" {
				- "value"
			}
			- "\n  of the element is neither the empty string nor a "
			a href="https://url.spec.whatwg.org/#valid-url-string" id="url-state-(type=url):valid-url-string-3" data-x-internal="valid-url-string" {
				- "valid"
			}
			- "\n  "
			a id="url-state-(type=url):absolute-url-5" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- ", the element is "
			a href="#suffering-from-a-type-mismatch" id="url-state-(type=url):suffering-from-a-type-mismatch" {
				- "suffering from a type mismatch"
			}
			- "."
		}
