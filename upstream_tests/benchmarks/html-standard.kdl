			}
			- ". "
			a href="#refsXML" {
				- "[XML]"
			}
			- " "
			a href="#refsXMLNS" {
				- "[XMLNS]"
			}
			- " "
			a href="#refsRFC7303" {
				- "[RFC7303]"
			}
			- "\n  "
			a href="#refsDOM" {
				- "[DOM]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "At the time of writing, the XML specification community had not actually yet\n  specified how XML and the DOM interact."
		}
		- " \n\n  "
		p {
			- "The first "
			a href="#concept-task" id="read-xml:concept-task" {
