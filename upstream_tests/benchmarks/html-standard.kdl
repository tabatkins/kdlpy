						a href="#dom-media-paused" {
							- "paused"
						}
					}
					- " attribute is true;"
				}
			}
			li {
				p {
					- "it has an "
					code id="playing-the-media-resource:attr-media-autoplay" {
						a href="#attr-media-autoplay" {
							- "autoplay"
						}
					}
					- " attribute\n   specified;"
