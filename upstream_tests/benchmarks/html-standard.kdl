				- "CSS pixels"
			}
			- ". (The element's "
			a id="the-textarea-element-2:'letter-spacing'" href="https://drafts.csswg.org/css-text/#letter-spacing-property" data-x-internal="'letter-spacing'" {
				- "'letter-spacing'"
			}
