					}
					- "("
					var {
						- "options"
					}
					- "[\""
					code id="the-history-entry-list:dom-navigationupdatecurrententryoptions-state-2" {
						a href="#dom-navigationupdatecurrententryoptions-state" {
							- "state"
						}
					}
					- "\"]), rethrowing any\n   exceptions."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "current"
					}
					- "'s "
					a href="#nhe-she" id="the-history-entry-list:nhe-she" {
						- "session history entry"
					}
					- "'s "
					a href="#she-navigation-api-state" id="the-history-entry-list:she-navigation-api-state-2" {
						- "navigation API state"
					}
					- " to\n   "
					var {
						- "serializedState"
					}
					- "."
				}
			}
			li {
				p {
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-history-entry-list:concept-event-fire" data-x-internal="concept-event-fire" {
						- "Fire an event"
					}
					- " named "
					code id="the-history-entry-list:event-currententrychange" {
						a href="#event-currententrychange" {
							- "currententrychange"
						}
					}
					- " at "
					a id="the-history-entry-list:this-5" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- " using\n   "
					code id="the-history-entry-list:navigationcurrententrychangeevent" {
						a href="#navigationcurrententrychangeevent" {
							- "NavigationCurrentEntryChangeEvent"
						}
					}
					- ", with its "
					code id="the-history-entry-list:dom-navigationcurrententrychangeevent-navigationtype" {
						a href="#dom-navigationcurrententrychangeevent-navigationtype" {
							- "navigationType"
						}
					}
					- " attribute\n   initialized to null and its "
					code id="the-history-entry-list:dom-navigationcurrententrychangeevent-from" {
						a href="#dom-navigationcurrententrychangeevent-from" {
							- "from"
						}
					}
					- "\n   initialized to "
					var {
						- "current"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="Navigation" id="dom-navigation-cangoback" data-dfn-type="attribute" {
				code {
					- "canGoBack"
				}
			}
			- " getter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a id="the-history-entry-list:this-6" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- " "
					a href="#has-entries-and-events-disabled" id="the-history-entry-list:has-entries-and-events-disabled-2" {
						- "has entries and events disabled"
					}
					- ", then return\n   false."
				}
			}
			li {
				p {
					a id="the-history-entry-list:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					a id="the-history-entry-list:this-7" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#navigation-current-entry-index" id="the-history-entry-list:navigation-current-entry-index" {
						- "current entry index"
					}
					- " is not −1."
				}
			}
			li {
				p {
					- "If "
					a id="the-history-entry-list:this-8" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#navigation-current-entry-index" id="the-history-entry-list:navigation-current-entry-index-2" {
						- "current entry\n   index"
					}
					- " is 0, then return false."
				}
			}
			li {
				p {
					- "Return true."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="Navigation" id="dom-navigation-cangoforward" data-dfn-type="attribute" {
				code {
					- "canGoForward"
				}
			}
			- " getter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a id="the-history-entry-list:this-9" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- " "
					a href="#has-entries-and-events-disabled" id="the-history-entry-list:has-entries-and-events-disabled-3" {
						- "has entries and events disabled"
					}
					- ", then return\n   false."
				}
			}
			li {
				p {
					a id="the-history-entry-list:assert-2" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					a id="the-history-entry-list:this-10" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#navigation-current-entry-index" id="the-history-entry-list:navigation-current-entry-index-3" {
						- "current entry index"
					}
					- " is not −1."
				}
			}
			li {
				p {
					- "If "
					a id="the-history-entry-list:this-11" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#navigation-current-entry-index" id="the-history-entry-list:navigation-current-entry-index-4" {
						- "current entry\n   index"
					}
					- " is equal to "
					a id="the-history-entry-list:this-12" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#navigation-entry-list" id="the-history-entry-list:navigation-entry-list-2" {
						- "entry\n   list"
					}
					- "'s "
					a href="https://infra.spec.whatwg.org/#list-size" id="the-history-entry-list:list-size" data-x-internal="list-size" {
						- "size"
					}
					- " − 1, then return false."
				}
			}
			li {
				p {
					- "Return true."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h5 id="navigation-api-initiating-navigations" {
			span class="secno" {
				- "7.2.6.7"
			}
			- " Initiating navigations"
			a href="#navigation-api-initiating-navigations" class="self-link"
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					- "{ "
					a href="#dom-navigationresult-committed" id="navigation-api-initiating-navigations:dom-navigationresult-committed" {
						- "committed"
					}
					- ", "
					a href="#dom-navigationresult-finished" id="navigation-api-initiating-navigations:dom-navigationresult-finished" {
						- "finished"
					}
					- " } = "
					a href="#dom-navigation" id="navigation-api-initiating-navigations:dom-navigation" {
						- "navigation"
					}
					- "."
					a href="#dom-navigation-navigate" id="dom-navigation-navigate-dev" {
						- "navigate"
					}
					- "("
					var {
						- "url"
					}
					- ")"
				}
			}
			dt {
				code {
					- "{ "
					a href="#dom-navigationresult-committed" id="navigation-api-initiating-navigations:dom-navigationresult-committed-2" {
						- "committed"
					}
					- ", "
					a href="#dom-navigationresult-finished" id="navigation-api-initiating-navigations:dom-navigationresult-finished-2" {
						- "finished"
					}
					- " } = "
					a href="#dom-navigation" id="navigation-api-initiating-navigations:dom-navigation-2" {
						- "navigation"
					}
					- "."
					a href="#dom-navigation-navigate" id="navigation-api-initiating-navigations:dom-navigation-navigate" {
						- "navigate"
					}
					- "("
					var {
						- "url"
					}
					- ", "
					var {
						- "options"
					}
					- ")"
				}
			}
			dd {
				- "\n    "
				p {
					a href="#navigate" id="navigation-api-initiating-navigations:navigate" {
						- "Navigates"
					}
					- " the current page to the given "
					var {
						- "url"
					}
					- ".\n    "
					var {
						- "options"
					}
					- " can contain the following values:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							code id="dom-navigationnavigateoptions-history-dev" {
								a href="#dom-navigationnavigateoptions-history" {
									- "history"
								}
							}
							- " can be set to\n     \""
							code id="navigationhistorybehavior-replace-dev" {
								a href="#navigationhistorybehavior-replace" {
									- "replace"
								}
							}
							- "\" to replace the current\n     session history entry, instead of pushing a new one."
						}
					}
					li {
						p {
							code id="dom-navigationoptions-info-dev" {
								a href="#dom-navigationoptions-info" {
									- "info"
								}
							}
							- " can be set to any value; it\n     will populate the "
							code id="navigation-api-initiating-navigations:dom-navigateevent-info" {
								a href="#dom-navigateevent-info" {
									- "info"
								}
							}
							- " property of the\n     corresponding "
							code id="navigation-api-initiating-navigations:navigateevent" {
								a href="#navigateevent" {
									- "NavigateEvent"
								}
							}
							- "."
						}
					}
					li {
						p {
							code id="dom-navigationnavigateoptions-state-dev" {
								a href="#dom-navigationnavigateoptions-state" {
									- "state"
								}
							}
							- " can be set to any\n     "
							a href="#serializable-objects" id="navigation-api-initiating-navigations:serializable-objects" {
								- "serializable"
							}
							- " value; it will populate the state\n     retrieved by "
							code id="navigation-api-initiating-navigations:dom-navigationhistoryentry-getstate" {
								a href="#dom-navigationhistoryentry-getstate" {
									- "navigation.currentEntry.getState()"
								}
							}
							- " once the\n     navigation completes, for same-document navigations. (It will be ignored for navigations that\n     end up cross-document.)"
						}
					}
				}
				- "\n\n    "
				p {
					- "By default this will perform a full navigation (i.e., a cross-document navigation, unless the\n    given URL differs only in a "
					a href="https://url.spec.whatwg.org/#concept-url-fragment" id="navigation-api-initiating-navigations:concept-url-fragment" data-x-internal="concept-url-fragment" {
						- "fragment"
					}
					- " from the current\n    one). The "
					code id="navigation-api-initiating-navigations:dom-navigateevent-intercept" {
						a href="#dom-navigateevent-intercept" {
							- "navigateEvent.intercept()"
						}
					}
					- " method can\n    be used to convert it into a same-document navigation."
				}
				- "\n\n    "
				p {
					- "The returned promises will behave as follows:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "For navigations that get aborted, both promises will reject with an\n     "
							a id="navigation-api-initiating-navigations:aborterror" href="https://webidl.spec.whatwg.org/#aborterror" data-x-internal="aborterror" {
								- "\""
								code {
									- "AbortError"
								}
								- "\""
							}
							- " "
							code id="navigation-api-initiating-navigations:domexception" {
								a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
									- "DOMException"
								}
							}
							- "."
						}
					}
					li {
						p {
							- "For same-document navigations created by using the "
							code id="navigation-api-initiating-navigations:dom-navigateevent-intercept-2" {
								a href="#dom-navigateevent-intercept" {
									- "navigateEvent.intercept()"
								}
							}
							- " method, "
							code id="navigation-api-initiating-navigations:dom-navigationresult-committed-3" {
								a href="#dom-navigationresult-committed" {
									- "committed"
								}
							}
							- " will fulfill immediately, and "
							code id="navigation-api-initiating-navigations:dom-navigationresult-finished-3" {
								a href="#dom-navigationresult-finished" {
									- "finished"
								}
							}
							- " will fulfill or reject according to any\n     promsies returned by handlers passed to "
							code id="navigation-api-initiating-navigations:dom-navigateevent-intercept-3" {
								a href="#dom-navigateevent-intercept" {
									- "intercept()"
								}
							}
							- "."
						}
					}
					li {
						p {
							- "For other same-document navigations (e.g., non-intercepted "
							a href="#navigate-fragid" id="navigation-api-initiating-navigations:navigate-fragid" {
								- "fragment navigations"
							}
							- "), both promises will fulfill\n     immediately."
						}
					}
					li {
						p {
							- "For cross-document navigations, or navigations that result in 204 or 205 "
							a href="https://fetch.spec.whatwg.org/#concept-response-status" id="navigation-api-initiating-navigations:concept-response-status" data-x-internal="concept-response-status" {
								- "statuses"
							}
							- " or `"
							code id="navigation-api-initiating-navigations:http-content-disposition" {
								a data-x-internal="http-content-disposition" href="https://httpwg.org/specs/rfc6266.html" {
									- "Content-Disposition: attachment"
								}
							}
							- "` header fields from\n     the server (and thus do not actually navigate), both promises will never settle."
						}
					}
				}
				- "\n\n    "
				p {
					- "In all cases, when the returned promises fulfill, it will be with the\n    "
					code id="navigation-api-initiating-navigations:navigationhistoryentry" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- " that was navigated to."
				}
				- "\n   "
			}
			dt {
				code {
					- "{ "
					a href="#dom-navigationresult-committed" id="navigation-api-initiating-navigations:dom-navigationresult-committed-4" {
						- "committed"
					}
					- ", "
					a href="#dom-navigationresult-finished" id="navigation-api-initiating-navigations:dom-navigationresult-finished-4" {
						- "finished"
					}
					- " } = "
					a href="#dom-navigation" id="navigation-api-initiating-navigations:dom-navigation-3" {
						- "navigation"
					}
					- "."
					a href="#dom-navigation-reload" id="dom-navigation-reload-dev" {
						- "reload"
					}
					- "("
					var {
						- "options"
					}
					- ")"
				}
			}
			dd {
				- "\n    "
				p {
					a href="#reload" id="navigation-api-initiating-navigations:reload" {
						- "Reloads"
					}
					- " the current page. "
					var {
						- "options"
					}
					- " can contain "
					code id="navigation-api-initiating-navigations:dom-navigationoptions-info" {
						a href="#dom-navigationoptions-info" {
							- "info"
						}
					}
					- " and "
					code id="dom-navigationreloadoptions-state-dev" {
						a href="#dom-navigationreloadoptions-state" {
							- "state"
						}
					}
					- ", which behave as described above."
				}
				- "\n\n    "
				p {
					- "The default behavior of performing a from-network-or-cache reload of the current page can be\n    overriden by the using the "
					code id="navigation-api-initiating-navigations:dom-navigateevent-intercept-4" {
						a href="#dom-navigateevent-intercept" {
							- "navigateEvent.intercept()"
						}
					}
					- " method. Doing so will mean\n    this call only updates state or passes along the appropriate "
					code id="navigation-api-initiating-navigations:dom-navigationoptions-info-2" {
						a href="#dom-navigationoptions-info" {
							- "info"
						}
					}
					- ", plus performing whater actions the "
					code id="navigation-api-initiating-navigations:event-navigate" {
