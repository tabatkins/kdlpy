		- "\n\n\n  \n\n  "
		h3 id="converting-html-to-other-formats" {
			span class="secno" {
				- "5.4"
			}
			- " Converting HTML to other formats"
			a href="#converting-html-to-other-formats" class="self-link"
		}
		- "\n\n  "
		h4 id="json" {
			span class="secno" {
				- "5.4.1"
			}
			- " JSON"
			a href="#json" class="self-link"
		}
		- "\n\n  "
		p {
			- "Given a list of nodes "
			var {
				- "nodes"
			}
			- " in a "
			code id="json:document" {
				a href="#document" {
					- "Document"
				}
			}
			- ", a user agent must\n  run the following algorithm to "
			dfn id="extracting-json" {
				- "extract the microdata from those nodes\n  into a JSON form"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be an empty object."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "items"
					}
					- " be an empty array."
				}
			}
			li {
				p {
					- "For each "
					var {
						- "node"
					}
					- " in "
					var {
						- "nodes"
					}
					- ", check if the element is a\n   "
					a href="#top-level-microdata-items" id="json:top-level-microdata-items" {
						- "top-level microdata item"
					}
					- ", and if it is then\n   "
					a href="#get-the-object" id="json:get-the-object" {
						- "get the object"
					}
					- " for that element and add it to "
					var {
						- "items"
					}
					- "."
				}
			}
			li {
				p {
					- "Add an entry to "
					var {
						- "result"
					}
					- " called \""
					code {
						- "items"
					}
					- "\" whose\n   value is the array "
					var {
						- "items"
					}
					- "."
				}
			}
			li {
				p {
					- "Return the result of serializing "
					var {
						- "result"
					}
					- " to JSON in the shortest\n   possible way (meaning no whitespace between tokens, no unnecessary zero digits in numbers, and\n   only using Unicode escapes in strings for characters that do not have a dedicated escape\n   sequence), and with a lowercase \""
					code {
						- "e"
					}
					- "\" used, when appropriate, in the\n   representation of any numbers. "
					a href="#refsJSON" {
						- "[JSON]"
					}
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "This algorithm returns an object with a single property that is an array, instead\n  of just returning an array, so that it is possible to extend the algorithm in the future if\n  necessary."
		}
		- "\n\n  "
		p {
			- "When the user agent is to "
			dfn id="get-the-object" {
				- "get the object"
			}
			- " for an item "
			var {
				- "item"
			}
			- ",\n  optionally with a list of elements "
			var {
				- "memory"
			}
			- ", it must run the following\n  substeps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be an empty object."
				}
			}
			li {
				p {
					- "If no "
					var {
						- "memory"
					}
					- " was passed to the algorithm, let "
					var {
						- "memory"
					}
					- " be an empty list."
				}
			}
			li {
				p {
					- "Add "
					var {
						- "item"
					}
					- " to "
					var {
						- "memory"
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "item"
					}
					- " has any "
					a href="#item-types" id="json:item-types" {
						- "item types"
					}
					- ", add an entry to "
					var {
						- "result"
					}
					- " called \""
					code {
						- "type"
					}
					- "\" whose value is an array listing the\n   "
					a href="#item-types" id="json:item-types-2" {
						- "item types"
					}
					- " of "
					var {
						- "item"
					}
					- ", in the order they were specified on the\n   "
					code id="json:attr-itemtype" {
						a href="#attr-itemtype" {
							- "itemtype"
						}
					}
					- " attribute."
				}
				- "\n\n   "
			}
			li {
				p {
					- "If the "
					var {
						- "item"
					}
					- " has a "
					a href="#global-identifier" id="json:global-identifier" {
						- "global identifier"
					}
					- ", add an entry to "
					var {
						- "result"
					}
					- " called \""
					code {
						- "id"
					}
					- "\" whose value is the "
					a href="#global-identifier" id="json:global-identifier-2" {
						- "global\n   identifier"
					}
					- " of "
					var {
						- "item"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "properties"
					}
					- " be an empty object."
				}
			}
			li {
				- "\n    "
				p {
					- "For each element "
					var {
						- "element"
					}
					- " that has one or more "
					a href="#property-names" id="json:property-names" {
						- "property names"
					}
					- "\n    and is one of "
					a href="#the-properties-of-an-item" id="json:the-properties-of-an-item" {
						- "the properties of the item"
					}
					- " "
					var {
						- "item"
					}
					- ", in the order those elements are given by the algorithm that returns\n    "
					a href="#the-properties-of-an-item" id="json:the-properties-of-an-item-2" {
						- "the properties of an item"
					}
					- ", run the following substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "value"
							}
							- " be the "
							a href="#concept-property-value" id="json:concept-property-value" {
								- "property\n     value"
							}
							- " of "
							var {
								- "element"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "value"
							}
							- " is an "
							a href="#concept-item" id="json:concept-item" {
								- "item"
							}
							- ", then: If "
							var {
								- "value"
							}
							- " is in "
							var {
								- "memory"
							}
							- ", then let "
							var {
								- "value"
							}
							- " be\n     the string \""
							code {
								- "ERROR"
							}
							- "\". Otherwise, "
							a href="#get-the-object" id="json:get-the-object-2" {
								- "get the object"
							}
							- " for "
							var {
								- "value"
							}
							- ", passing a copy of "
							var {
								- "memory"
							}
							- ", and then replace "
							var {
								- "value"
							}
							- " with the object returned from those steps."
						}
					}
					li {
						- "\n      "
						p {
							- "For each name "
							var {
								- "name"
							}
							- " in "
							var {
								- "element"
							}
							- "'s "
							a href="#property-names" id="json:property-names-2" {
								- "property\n      names"
							}
							- ", run the following substeps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "If there is no entry named "
									var {
										- "name"
									}
									- " in "
									var {
										- "properties"
									}
									- ",\n       then add an entry named "
									var {
										- "name"
									}
									- " to "
									var {
										- "properties"
									}
									- " whose\n       value is an empty array."
								}
							}
							li {
								p {
									- "Append "
									var {
										- "value"
									}
									- " to the entry named "
									var {
										- "name"
									}
									- " in "
									var {
										- "properties"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Add an entry to "
					var {
						- "result"
					}
					- " called \""
					code {
						- "properties"
					}
					- "\" whose\n   value is the object "
					var {
						- "properties"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "result"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For example, take this markup:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- cp="" {
