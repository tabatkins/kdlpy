				}
			}
			- " and "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="sse-processing-model:concept-event-fire-3" data-x-internal="concept-event-fire" {
				- "fires an\n  event"
			}
			- " named "
			code id="sse-processing-model:event-error-2" {
				a href="#event-error" {
					- "error"
				}
			}
			- " at the "
			code id="sse-processing-model:eventsource-7" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object.\n  "
			strong {
				- "Once the user agent has "
				a href="#fail-the-connection" id="sse-processing-model:fail-the-connection" {
					- "failed the connection"
				}
				- ",\n  it does "
				em {
					- "not"
				}
				- " attempt to reconnect."
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			a href="#task-source" id="sse-processing-model:task-source" {
				- "task source"
			}
			- " for any "
			a href="#concept-task" id="sse-processing-model:concept-task-2" {
				- "tasks"
			}
			- " that are "
			a href="#queue-a-task" id="sse-processing-model:queue-a-task-5" {
				- "queued"
			}
			- " by "
			code id="sse-processing-model:eventsource-8" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " objects is the "
			dfn id="remote-event-task-source" {
				- "remote event\n  task source"
			}
			- "."
		}
		- "\n\n  \n\n\n  "
		h4 id="the-last-event-id-header" {
			span class="secno" {
				- "9.2.4"
			}
			- " The `"
			code id="the-last-event-id-header:last-event-id" {
				a href="#last-event-id" {
					- "Last-Event-ID"
				}
			}
			- "` header"
			a href="#the-last-event-id-header" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="last-event-id" data-dfn-type="http-header" {
				code {
					- "Last-Event-ID"
				}
			}
			- "` HTTP request header reports an\n  "
			code id="the-last-event-id-header:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object's "
			a href="#concept-event-stream-last-event-id" id="the-last-event-id-header:concept-event-stream-last-event-id" {
				- "last event ID\n  string"
			}
			- " to the server when the user agent is to "
			a href="#reestablish-the-connection" id="the-last-event-id-header:reestablish-the-connection" {
				- "reestablish the connection"
			}
			- ".\n\n  "
		}
		p class="XXX" {
			- "See "
			a href="https://github.com/whatwg/html/issues/7363" {
				- "whatwg/html issue\n  #7363"
			}
			- " to define the value space better. It is essentially any UTF-8 encoded string, that does\n  not contain U+0000 NULL, U+000A LF, or U+000D CR."
		}
		- "\n\n\n  "
		h4 id="parsing-an-event-stream" {
			span class="secno" {
				- "9.2.5"
			}
			- " Parsing an event stream"
			a href="#parsing-an-event-stream" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			- "This event stream format's "
			a id="parsing-an-event-stream:mime-type" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
				- "MIME type"
			}
			- " is "
			code id="parsing-an-event-stream:text/event-stream" {
				a href="#text/event-stream" {
					- "text/event-stream"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The event stream format is as described by the "
			code {
				- "stream"
			}
			- " production of the\n  following ABNF, the character set for which is Unicode. "
			a href="#refsABNF" {
				- "[ABNF]"
			}
		}
		- "\n\n  "
		pre {
			code class="abnf" {
				c- nc="" {
					- "stream"
				}
				- "        "
				c- o="" {
					- "="
				}
				- " "
				c- p="" {
					- "["
				}
				- " "
				c- nc="" {
					- "bom"
				}
				- " "
				c- p="" {
					- "]"
				}
				- " "
				c- o="" {
					- "*"
				}
				c- nc="" {
					- "event"
				}
				- "\n"
				c- nc="" {
					- "event"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- o="" {
					- "*"
				}
				c- p="" {
					- "("
				}
				- " "
				c- nc="" {
					- "comment"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- nc="" {
					- "field"
				}
				- " "
				c- p="" {
					- ")"
				}
				- " "
				c- nc="" {
					- "end-of-line"
				}
				- "\n"
				c- nc="" {
					- "comment"
				}
				- "       "
				c- o="" {
					- "="
				}
				- " "
				c- nc="" {
					- "colon"
				}
				- " "
				c- o="" {
					- "*"
				}
				c- nc="" {
					- "any-char"
				}
				- " "
				c- nc="" {
					- "end-of-line"
				}
				- "\n"
				c- nc="" {
					- "field"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- o="" {
					- "1*"
				}
				c- nc="" {
					- "name-char"
				}
				- " "
				c- p="" {
					- "["
				}
				- " "
				c- nc="" {
					- "colon"
				}
				- " "
				c- p="" {
					- "["
				}
				- " "
				c- nc="" {
					- "space"
				}
				- " "
				c- p="" {
					- "]"
				}
				- " "
				c- o="" {
					- "*"
				}
				c- nc="" {
					- "any-char"
				}
				- " "
				c- p="" {
					- "]"
				}
				- " "
				c- nc="" {
					- "end-of-line"
				}
				- "\n"
				c- nc="" {
					- "end-of-line"
				}
				- "   "
				c- o="" {
					- "="
				}
				- " "
				c- p="" {
					- "("
				}
				- " "
				c- nc="" {
					- "cr"
				}
				- " "
				c- nc="" {
					- "lf"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- nc="" {
					- "cr"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- nc="" {
					- "lf"
				}
				- " "
				c- p="" {
					- ")"
				}
				- "\n\n"
				c- c1="" {
					- "; characters"
				}
				- "\n"
				c- nc="" {
					- "lf"
				}
				- "            "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x000A"
				}
				- " "
				c- c1="" {
					- "; U+000A LINE FEED (LF)"
				}
				- "\n"
				c- nc="" {
					- "cr"
				}
				- "            "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x000D"
				}
				- " "
				c- c1="" {
					- "; U+000D CARRIAGE RETURN (CR)"
				}
				- "\n"
				c- nc="" {
					- "space"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x0020"
				}
				- " "
				c- c1="" {
					- "; U+0020 SPACE"
				}
				- "\n"
				c- nc="" {
					- "colon"
				}
				- "         "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x003A"
				}
				- " "
				c- c1="" {
					- "; U+003A COLON (:)"
				}
				- "\n"
				c- nc="" {
					- "bom"
				}
				- "           "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%xFEFF"
				}
				- " "
				c- c1="" {
					- "; U+FEFF BYTE ORDER MARK"
				}
				- "\n"
				c- nc="" {
					- "name-char"
				}
				- "     "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x0000-0009"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "%x000B-000C"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "%x000E-0039"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "%x003B-10FFFF"
				}
				- "\n                "
				c- c1="" {
					- "; a "
				}
				a id="parsing-an-event-stream:scalar-value" href="https://infra.spec.whatwg.org/#scalar-value" data-x-internal="scalar-value" {
					c- c1="" {
						- "scalar value"
					}
				}
				c- c1="" {
					- " other than U+000A LINE FEED (LF), U+000D CARRIAGE RETURN (CR), or U+003A COLON (:)"
				}
				- "\n"
				c- nc="" {
					- "any-char"
				}
				- "      "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "%x0000-0009"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "%x000B-000C"
				}
				- " "
				c- o="" {
					- "/"
				}
				- " "
				c- l="" {
					- "%x000E-10FFFF"
				}
				- "\n                "
				c- c1="" {
					- "; a "
				}
				a id="parsing-an-event-stream:scalar-value-2" href="https://infra.spec.whatwg.org/#scalar-value" data-x-internal="scalar-value" {
					c- c1="" {
						- "scalar value"
					}
				}
				c- c1="" {
					- " other than U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR)"
				}
			}
		}
		- "\n\n  "
		p {
			- "Event streams in this format must always be encoded as UTF-8. "
			a href="#refsENCODING" {
				- "[ENCODING]"
			}
		}
		- "\n\n  "
		p {
			- "Lines must be separated by either a U+000D CARRIAGE RETURN U+000A LINE FEED (CRLF) character\n  pair, a single U+000A LINE FEED (LF) character, or a single U+000D CARRIAGE RETURN (CR)\n  character."
		}
		- "\n\n  "
		p {
			- "Since connections established to remote servers for such resources are expected to be\n  long-lived, UAs should ensure that appropriate buffering is used. In particular, while line\n  buffering with lines are defined to end with a single U+000A LINE FEED (LF) character is safe,\n  block buffering or line buffering with different expected line endings can cause delays in event\n  dispatch."
		}
		- "\n\n\n  \n\n  "
		h4 id="event-stream-interpretation" {
			span class="secno" {
				- "9.2.6"
			}
			- " Interpreting an event stream"
			a href="#event-stream-interpretation" class="self-link"
		}
		- "\n\n  "
		p {
			- "Streams must be decoded using the "
			a id="event-stream-interpretation:utf-8-decode" href="https://encoding.spec.whatwg.org/#utf-8-decode" data-x-internal="utf-8-decode" {
				- "UTF-8 decode"
			}
			- " algorithm."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a id="event-stream-interpretation:utf-8-decode-2" href="https://encoding.spec.whatwg.org/#utf-8-decode" data-x-internal="utf-8-decode" {
				- "UTF-8 decode"
			}
			- " algorithm strips one leading UTF-8 Byte Order Mark\n  (BOM), if any."
		}
		- "\n\n  "
		p {
			- "The stream must then be parsed by reading everything line by line, with a U+000D CARRIAGE\n  RETURN U+000A LINE FEED (CRLF) character pair, a single U+000A LINE FEED (LF) character not\n  preceded by a U+000D CARRIAGE RETURN (CR) character, and a single U+000D CARRIAGE RETURN (CR)\n  character not followed by a U+000A LINE FEED (LF) character being the ways in which a line can\n  end."
		}
		- "\n\n  "
		p {
			- "When a stream is parsed, a "
			var {
				- "data"
			}
			- " buffer, an "
			var {
				- "event type"
			}
			- "\n  buffer, and a "
			var {
				- "last event ID"
			}
			- " buffer must be associated with it. They must be\n  initialized to the empty string."
		}
		- "\n\n  "
		p {
			- "Lines must be processed, in the order they are received, as follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the line is empty (a blank line)"
			}
			dd {
				p {
					a href="#dispatchMessage" id="event-stream-interpretation:dispatchMessage" {
						- "Dispatch the event"
					}
					- ", as defined below."
				}
			}
			dt {
				- "If the line starts with a U+003A COLON character (:)"
			}
			dd {
				p {
					- "Ignore the line."
				}
			}
			dt {
				- "If the line contains a U+003A COLON character (:)"
			}
			dd {
				- "\n    "
				p {
					- "Collect the characters on the line before the first U+003A COLON character (:), and let "
					var {
						- "field"
					}
					- " be that string."
				}
				- "\n\n    "
				p {
					- "Collect the characters on the line after the first U+003A COLON character (:), and let "
					var {
						- "value"
					}
					- " be that string. If "
					var {
						- "value"
					}
					- " starts with a U+0020 SPACE\n    character, remove it from "
					var {
						- "value"
					}
					- "."
				}
				- "\n\n    "
				p {
					a href="#processField" {
						- "Process the field"
					}
					- " using the steps described below, using "
					var {
						- "field"
					}
					- " as the field name and "
					var {
						- "value"
					}
					- " as the field value."
				}
				- "\n   "
			}
			dt {
				- "Otherwise, the string is not empty but does not contain a U+003A COLON character (:)"
			}
			dd {
				- "\n    "
				p {
					a href="#processField" {
						- "Process the field"
					}
					- " using the steps described below, using the\n    whole line as the field name, and the empty string as the field value."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "Once the end of the file is reached, any pending data must be discarded. (If the file ends in\n  the middle of an event, before the final empty line, the incomplete event is not dispatched.)"
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p id="processField" {
			- "The steps to "
			dfn {
				- "process the field"
			}
			- " given a field name and a\n  field value depend on the field name, as given in the following list. Field names must be compared\n  literally, with no case folding performed."
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the field name is \"event\""
			}
			dd {
				p {
					- "Set the "
					var {
						- "event type"
					}
					- " buffer to field value."
				}
			}
			dt {
				- "If the field name is \"data\""
			}
			dd {
				p {
					- "Append the field value to the "
					var {
						- "data"
					}
					- " buffer, then append a single U+000A\n   LINE FEED (LF) character to the "
					var {
						- "data"
					}
					- " buffer."
				}
			}
			dt {
				- "If the field name is \"id\""
			}
			dd {
				p {
					- "If the field value does not contain U+0000 NULL, then set the "
					var {
						- "last event ID"
					}
					- "\n   buffer to the field value. Otherwise, ignore the field."
				}
			}
			dt {
				- "If the field name is \"retry\""
			}
			dd {
				p {
					- "If the field value consists of only "
					a id="event-stream-interpretation:ascii-digits" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
						- "ASCII digits"
					}
					- ", then interpret the field\n   value as an integer in base ten, and set the event stream's "
					a href="#concept-event-stream-reconnection-time" id="event-stream-interpretation:concept-event-stream-reconnection-time" {
						- "reconnection time"
					}
					- " to that integer.\n   Otherwise, ignore the field."
				}
			}
			dt {
				- "Otherwise"
			}
			dd {
				p {
					- "The field is ignored."
				}
			}
		}
		- "\n\n\n  "
		p {
			- "When the user agent is required to "
			dfn id="dispatchMessage" {
				- "dispatch the\n  event"
			}
			- ", the user agent must process the "
			var {
				- "data"
			}
			- " buffer, the "
			var {
				- "event type"
			}
			- " buffer, and the "
			var {
				- "last event ID"
			}
			- " buffer using steps\n  appropriate for the user agent."
		}
		- "\n\n  "
		p {
			- "For web browsers, the appropriate steps to "
			a href="#dispatchMessage" id="event-stream-interpretation:dispatchMessage-2" {
				- "dispatch the event"
			}
			- " are as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set the "
					a href="#concept-event-stream-last-event-id" id="event-stream-interpretation:concept-event-stream-last-event-id" {
						- "last event ID string"
					}
					- " of\n   the event source to the value of the "
					var {
						- "last event ID"
					}
					- " buffer. The buffer does\n   not get reset, so the "
					a href="#concept-event-stream-last-event-id" id="event-stream-interpretation:concept-event-stream-last-event-id-2" {
						- "last event ID\n   string"
					}
					- " of the event source remains set to this value until the next time it is set by the\n   server."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "data"
					}
					- " buffer is an empty string, set the "
					var {
						- "data"
					}
					- " buffer and the "
					var {
						- "event type"
					}
					- " buffer to the empty string and\n   return."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "data"
					}
					- " buffer's last character is a U+000A LINE FEED (LF)\n   character, then remove the last character from the "
					var {
						- "data"
					}
					- " buffer."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "event"
					}
					- " be the result of "
					a id="event-stream-interpretation:creating-an-event" href="https://dom.spec.whatwg.org/#concept-event-create" data-x-internal="creating-an-event" {
						- "creating an event"
					}
					- " using\n   "
					code id="event-stream-interpretation:messageevent" {
						a href="#messageevent" {
							- "MessageEvent"
						}
					}
					- ", in the "
					a href="#concept-relevant-realm" id="event-stream-interpretation:concept-relevant-realm" {
						- "relevant realm"
					}
					- " of\n   the "
					code id="event-stream-interpretation:eventsource" {
						a href="#eventsource" {
							- "EventSource"
						}
					}
					- " object."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code id="event-stream-interpretation:dom-event-type" {
						a data-x-internal="dom-event-type" href="https://dom.spec.whatwg.org/#dom-event-type" {
							- "type"
						}
					}
					- " attribute to\n   \""
					code id="event-stream-interpretation:event-message" {
						a href="#event-message" {
							- "message"
						}
					}
					- "\", its "
					code id="event-stream-interpretation:dom-messageevent-data" {
						a href="#dom-messageevent-data" {
							- "data"
						}
					}
					- " attribute to "
					var {
						- "data"
					}
					- ", its "
					code id="event-stream-interpretation:dom-messageevent-origin" {
						a href="#dom-messageevent-origin" {
							- "origin"
						}
					}
					- " attribute to the "
					a href="#ascii-serialisation-of-an-origin" id="event-stream-interpretation:ascii-serialisation-of-an-origin" {
						- "serialization"
					}
					- " of the "
					a href="https://url.spec.whatwg.org/#concept-url-origin" id="event-stream-interpretation:concept-url-origin" data-x-internal="concept-url-origin" {
						- "origin"
					}
					- " of the\n   event stream's final URL (i.e., the URL after redirects), and its "
					code id="event-stream-interpretation:dom-messageevent-lasteventid" {
						a href="#dom-messageevent-lasteventid" {
							- "lastEventId"
						}
					}
					- " attribute to the "
					a href="#concept-event-stream-last-event-id" id="event-stream-interpretation:concept-event-stream-last-event-id-3" {
						- "last event ID string"
					}
					- " of the event\n   source."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "event type"
					}
					- " buffer has a value other than the empty string, change the\n   "
					a href="https://dom.spec.whatwg.org/#dom-event-type" id="event-stream-interpretation:concept-event-type" data-x-internal="concept-event-type" {
						- "type"
					}
					- " of the newly created event to equal the value of\n   the "
					var {
						- "event type"
					}
					- " buffer."
				}
			}
			li {
				p {
					- "Set the "
					var {
						- "data"
					}
					- " buffer and the "
					var {
						- "event type"
					}
					- " buffer to\n   the empty string."
				}
			}
			li {
				p {
					a href="#queue-a-task" id="event-stream-interpretation:queue-a-task" {
						- "Queue a task"
					}
					- " which, if the "
					code id="event-stream-interpretation:dom-eventsource-readystate" {
						a href="#dom-eventsource-readystate" {
							- "readyState"
						}
					}
					- " attribute is set to a value other than "
					code id="event-stream-interpretation:dom-eventsource-closed" {
						a href="#dom-eventsource-closed" {
							- "CLOSED"
						}
					}
					- ", "
					a href="https://dom.spec.whatwg.org/#concept-event-dispatch" id="event-stream-interpretation:concept-event-dispatch" data-x-internal="concept-event-dispatch" {
						- "dispatches"
					}
					- " the newly created event at the\n   "
					code id="event-stream-interpretation:eventsource-2" {
						a href="#eventsource" {
							- "EventSource"
						}
					}
					- " object."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "If an event doesn't have an \"id\" field, but an earlier event did set the event\n  source's "
			a href="#concept-event-stream-last-event-id" id="event-stream-interpretation:concept-event-stream-last-event-id-4" {
				- "last event ID string"
			}
			- ", then the\n  event's "
			code id="event-stream-interpretation:dom-messageevent-lasteventid-2" {
				a href="#dom-messageevent-lasteventid" {
					- "lastEventId"
				}
			}
			- " field will be set to the\n  value of whatever the last seen \"id\" field was."
		}
		- "\n\n  "
		p {
			- "For other user agents, the appropriate steps to "
			a href="#dispatchMessage" id="event-stream-interpretation:dispatchMessage-3" {
				- "dispatch the event"
			}
			- " are\n  implementation dependent, but at a minimum they must set the "
			var {
				- "data"
			}
			- " and "
			var {
				- "event type"
			}
			- " buffers to the empty string before returning."
		}
		- "\n\n  \n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following event stream, once followed by a blank line:"
			}
			- "\n   "
			pre {
				- "data: YHOO\ndata: +2\ndata: 10"
			}
			- "\n\n   "
			p {
				- "...would cause an event "
				code id="event-stream-interpretation:event-message-2" {
					a href="#event-message" {
						- "message"
					}
				}
				- " with the interface\n   "
				code id="event-stream-interpretation:messageevent-2" {
					a href="#messageevent" {
						- "MessageEvent"
					}
				}
				- " to be dispatched on the "
				code id="event-stream-interpretation:eventsource-3" {
					a href="#eventsource" {
						- "EventSource"
					}
				}
				- " object. The event's\n   "
				code id="event-stream-interpretation:dom-messageevent-data-2" {
					a href="#dom-messageevent-data" {
						- "data"
					}
				}
				- " attribute would contain the string \""
				code {
					- "YHOO\\n+2\\n10"
				}
				- "\" (where \""
				code {
					- "\\n"
				}
				- "\" represents a newline)."
			}
			- "\n\n   "
			p {
				- "This could be used as follows:\n   "
			}
			pre {
				code class="js" {
					c- a="" {
						- "var"
					}
					- " stocks "
					c- o="" {
						- "="
					}
					- " "
					c- k="" {
						- "new"
					}
					- " EventSource"
					c- p="" {
						- "("
					}
					c- u="" {
						- "\"https://stocks.example.com/ticker.php\""
					}
					c- p="" {
						- ");"
					}
					- "\nstocks"
					c- p="" {
						- "."
					}
					- "onmessage "
					c- o="" {
						- "="
					}
					- " "
					c- a="" {
						- "function"
					}
					- " "
					c- p="" {
						- "("
					}
					- "event"
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n  "
					c- a="" {
						- "var"
					}
					- " data "
					c- o="" {
						- "="
					}
					- " event"
					c- p="" {
						- "."
					}
					- "data"
					c- p="" {
						- "."
					}
					- "split"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'\\n'"
					}
					c- p="" {
						- ");"
					}
					- "\n  updateStocks"
					c- p="" {
						- "("
					}
					- "data"
					c- p="" {
						- "["
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- "],"
					}
					- " data"
					c- p="" {
						- "["
					}
					c- mf="" {
						- "1"
					}
					c- p="" {
						- "],"
					}
					- " data"
					c- p="" {
						- "["
					}
					c- mf="" {
						- "2"
					}
					c- p="" {
						- "]);"
					}
					- "\n"
					c- p="" {
						- "};"
					}
				}
			}
			- "\n\n   "
			p {
				- "...where "
				code {
					- "updateStocks()"
				}
				- " is a function defined as:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					c- a="" {
						- "function"
					}
					- " updateStocks"
					c- p="" {
						- "("
					}
					- "symbol"
					c- p="" {
						- ","
					}
					- " delta"
					c- p="" {
						- ","
					}
					- " value"
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- " "
					c- p="" {
						- "..."
					}
					- " "
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "...or some such."
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following stream contains four blocks. The first block has just a comment, and will fire\n   nothing. The second block has two fields with names \"data\" and \"id\" respectively; an event will\n   be fired for this block, with the data \"first event\", and will then set the last event ID to \"1\"\n   so that if the connection died between this block and the next, the server would be sent a\n   `"
				code id="event-stream-interpretation:last-event-id" {
					a href="#last-event-id" {
						- "Last-Event-ID"
					}
				}
				- "` header with the value `"
				code {
					- "1"
				}
				- "`. The third block\n   fires an event with data \"second event\", and also has an \"id\" field, this time with no value,\n   which resets the last event ID to the empty string (meaning no `"
				code id="event-stream-interpretation:last-event-id-2" {
					a href="#last-event-id" {
						- "Last-Event-ID"
					}
				}
				- "`\n   header will now be sent in the event of a reconnection being attempted). Finally, the last block\n   just fires an event with the data \" third event\" (with a single leading space\n   character). Note that the last still has to end with a blank line, the end of the stream is not\n   enough to trigger the dispatch of the last event."
			}
			- "\n\n   "
			pre {
				- ": test stream\n\ndata: first event\nid: 1\n\ndata:second event\nid\n\ndata:  third event\n"
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following stream fires two events:"
			}
			- "\n\n   "
			pre {
				- "data\n\ndata\ndata\n\ndata:"
			}
			- "\n\n   "
			p {
				- "The first block fires events with the data set to the empty string, as would the last block if\n   it was followed by a blank line. The middle block fires an event with the data set to a single\n   newline character. The last block is discarded because it is not followed by a blank line."
			}
			- "\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following stream fires two identical events:"
			}
			- "\n\n   "
			pre {
				- "data:test\n\ndata: test\n"
			}
			- "\n\n   "
			p {
				- "This is because the space after the colon is ignored if present."
			}
			- "\n  "
		}
		- "\n\n\n  "
		h4 id="authoring-notes" {
			span class="secno" {
				- "9.2.7"
			}
			- " Authoring notes"
			a href="#authoring-notes" class="self-link"
		}
		- "\n\n  "
		p {
			- "Legacy proxy servers are known to, in certain cases, drop HTTP connections after a short\n  timeout. To protect against such proxy servers, authors can include a comment line (one starting\n  with a ':' character) every 15 seconds or so."
		}
		- "\n\n  "
		p {
			- "Authors wishing to relate event source connections to each other or to specific documents\n  previously served might find that relying on IP addresses doesn't work, as individual clients can\n  have multiple IP addresses (due to having multiple proxy servers) and individual IP addresses can\n  have multiple clients (due to sharing a proxy server). It is better to include a unique identifier\n  in the document when it is served and then pass that identifier as part of the URL when the\n  connection is established."
		}
		- "\n\n  "
		p {
			- "Authors are also cautioned that HTTP chunking can have unexpected negative effects on the\n  reliability of this protocol, in particular if the chunking is done by a different layer unaware\n  of the timing requirements. If this is a problem, chunking can be disabled for serving event\n  streams."
		}
		- " \n\n  "
		p {
			- "Clients that support HTTP's per-server connection limitation might run into trouble when\n  opening multiple pages from a site if each page has an "
			code id="authoring-notes:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " to the same\n  domain. Authors can avoid this using the relatively complex mechanism of using unique domain names\n  per connection, or by allowing the user to enable or disable the "
			code id="authoring-notes:eventsource-2" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "\n  functionality on a per-page basis, or by sharing a single "
			code id="authoring-notes:eventsource-3" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object using a\n  "
			a href="#sharedworkerglobalscope" id="authoring-notes:sharedworkerglobalscope" {
				- "shared worker"
			}
			- "."
		}
		- "\n\n  \n\n  "
		h4 id="eventsource-push" {
			span class="secno" {
				- "9.2.8"
			}
			- " Connectionless push and other features"
			a href="#eventsource-push" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agents running in controlled environments, e.g. browsers on mobile handsets tied to\n  specific carriers, may offload the management of the connection to a proxy on the network. In such\n  a situation, the user agent for the purposes of conformance is considered to include both the\n  handset software and the network proxy."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For example, a browser on a mobile device, after having established a connection, might detect\n   that it is on a supporting network and request that a proxy server on the network take over the\n   management of the connection. The timeline for such a situation might be as follows:"
			}
			- "\n\n   "
			ol {
				li {
					- "Browser connects to a remote HTTP server and requests the resource specified by the author\n    in the "
					code id="eventsource-push:dom-eventsource" {
						a href="#dom-eventsource" {
							- "EventSource"
						}
					}
					- " constructor."
				}
				li {
					- "The server sends occasional messages."
				}
				li {
					- "In between two messages, the browser detects that it is idle except for the network activity\n    involved in keeping the TCP connection alive, and decides to switch to sleep mode to save\n    power."
				}
				li {
					- "The browser disconnects from the server."
				}
				li {
					- "The browser contacts a service on the network, and requests that the service, a \"push\n    proxy\", maintain the connection instead."
				}
				li {
					- "The \"push proxy\" service contacts the remote HTTP server and requests the resource specified\n    by the author in the "
					code id="eventsource-push:dom-eventsource-2" {
						a href="#dom-eventsource" {
							- "EventSource"
						}
					}
					- " constructor (possibly\n    including a `"
					code id="eventsource-push:last-event-id" {
						a href="#last-event-id" {
							- "Last-Event-ID"
						}
					}
					- "` HTTP header, etc.)."
				}
				li {
					- "The browser allows the mobile device to go to sleep."
				}
				li {
					- "The server sends another message."
				}
				li {
					- "The \"push proxy\" service uses a technology such as OMA push to convey the event to the\n    mobile device, which wakes only enough to process the event and then returns to sleep."
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "This can reduce the total data usage, and can therefore result in considerable power\n  savings."
		}
		- "\n\n  "
		p {
			- "As well as implementing the existing API and "
			code id="eventsource-push:text/event-stream" {
				a href="#text/event-stream" {
					- "text/event-stream"
				}
			}
			- " wire format as\n  defined by this specification and in more distributed ways as described above, formats of event\n  framing defined by "
			a href="#other-applicable-specifications" id="eventsource-push:other-applicable-specifications" {
				- "other applicable specifications"
			}
			- " may be supported. This\n  specification does not define how they are to be parsed or processed."
		}
		- "\n\n\n  "
		h4 id="garbage-collection" {
			span class="secno" {
				- "9.2.9"
			}
			- " Garbage collection"
			a href="#garbage-collection" class="self-link"
		}
		- "\n\n  "
		p {
			- "While an "
			code id="garbage-collection:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object's "
			code id="garbage-collection:dom-eventsource-readystate" {
				a href="#dom-eventsource-readystate" {
					- "readyState"
				}
			}
			- " is "
			code id="garbage-collection:dom-eventsource-connecting" {
				a href="#dom-eventsource-connecting" {
					- "CONNECTING"
				}
			}
			- ", and the object has one or more event\n  listeners registered for "
			code id="garbage-collection:event-open" {
				a href="#event-open" {
					- "open"
				}
			}
			- ", "
			code id="garbage-collection:event-message" {
				a href="#event-message" {
					- "message"
				}
			}
			- ", or "
			code id="garbage-collection:event-error" {
				a href="#event-error" {
					- "error"
				}
			}
			- " events, there must\n  be a strong reference from the "
			code id="garbage-collection:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " or "
			code id="garbage-collection:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object that\n  the "
			code id="garbage-collection:eventsource-2" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object's constructor was invoked from to the "
			code id="garbage-collection:eventsource-3" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "\n  object itself."
		}
		- "\n\n  "
		p {
			- "While an "
			code id="garbage-collection:eventsource-4" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object's "
			code id="garbage-collection:dom-eventsource-readystate-2" {
				a href="#dom-eventsource-readystate" {
					- "readyState"
				}
			}
			- " is "
			code id="garbage-collection:dom-eventsource-open" {
				a href="#dom-eventsource-open" {
					- "OPEN"
				}
			}
			- ", and the object has one or more event listeners\n  registered for "
			code id="garbage-collection:event-message-2" {
				a href="#event-message" {
					- "message"
				}
			}
			- " or "
			code id="garbage-collection:event-error-2" {
				a href="#event-error" {
					- "error"
				}
			}
			- " events, there must be a strong reference from the\n  "
			code id="garbage-collection:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " or "
			code id="garbage-collection:workerglobalscope-2" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object that the "
			code id="garbage-collection:eventsource-5" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "\n  object's constructor was invoked from to the "
			code id="garbage-collection:eventsource-6" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object itself."
		}
		- "\n\n  "
		p {
			- "While there is a task queued by an "
			code id="garbage-collection:eventsource-7" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object on the "
			a href="#remote-event-task-source" id="garbage-collection:remote-event-task-source" {
				- "remote event\n  task source"
			}
			- ", there must be a strong reference from the "
			code id="garbage-collection:window-3" {
				a href="#window" {
					- "Window"
				}
			}
			- " or\n  "
			code id="garbage-collection:workerglobalscope-3" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " object that the "
			code id="garbage-collection:eventsource-8" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object's constructor was\n  invoked from to that "
			code id="garbage-collection:eventsource-9" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object."
		}
		- "\n\n  "
		p {
			- "If a user agent is to "
			dfn id="concept-eventsource-forcibly-close" {
				- "forcibly close"
			}
			- " an\n  "
			code id="garbage-collection:eventsource-10" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object (this happens when a "
			code id="garbage-collection:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " object goes away\n  permanently), the user agent must abort any instances of the "
			a href="https://fetch.spec.whatwg.org/#concept-fetch" id="garbage-collection:concept-fetch" data-x-internal="concept-fetch" {
				- "fetch"
			}
			- " algorithm started for this "
			code id="garbage-collection:eventsource-11" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object,\n  and must set the "
			code id="garbage-collection:dom-eventsource-readystate-3" {
				a href="#dom-eventsource-readystate" {
					- "readyState"
				}
			}
			- " attribute to "
			code id="garbage-collection:dom-eventsource-closed" {
				a href="#dom-eventsource-closed" {
					- "CLOSED"
				}
			}
			- "."
		}
		- " \n\n  "
		p {
			- "If an "
			code id="garbage-collection:eventsource-12" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " object is garbage collected while its connection is still open,\n  the user agent must abort any instance of the "
			a href="https://fetch.spec.whatwg.org/#concept-fetch" id="garbage-collection:concept-fetch-2" data-x-internal="concept-fetch" {
				- "fetch"
			}
			- " algorithm\n  opened by this "
			code id="garbage-collection:eventsource-13" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "."
		}
		- " \n\n\n  "
		h4 id="implementation-advice" {
			span class="secno" {
				- "9.2.10"
			}
			- " Implementation advice"
			a href="#implementation-advice" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "User agents are strongly urged to provide detailed diagnostic information about\n  "
			code id="implementation-advice:eventsource" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- " objects and their related network connections in their development\n  consoles, to aid authors in debugging code using this API."
		}
		- "\n\n  "
		p {
			- "For example, a user agent could have a panel displaying all the "
			code id="implementation-advice:eventsource-2" {
				a href="#eventsource" {
					- "EventSource"
				}
			}
			- "\n  objects a page has created, each listing the constructor's arguments, whether there was a network\n  error, what the CORS status of the connection is and what headers were sent by the client and\n  received from the server to lead to that status, the messages that were received and how they were\n  parsed, and so forth."
		}
		- "\n\n  "
		p {
			- "Implementations are especially encouraged to report detailed information to their development\n  consoles whenever an "
			code id="implementation-advice:event-error" {
				a href="#event-error" {
					- "error"
				}
			}
			- " event is fired, since little to no\n  information can be made available in the events themselves."
		}
		- "\n\n  \n\n\n  "
		h3 id="web-messaging" {
			span class="secno" {
				- "9.3"
			}
			- " "
			dfn id="crossDocumentMessages" {
				- "Cross-document messaging"
			}
			a href="#web-messaging" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/Window/postMessage" title="The window.postMessage() method safely enables cross-origin communication between Window objects; e.g., between a page and a pop-up that it spawned, or between a page and an iframe embedded within it." {
						- "Window/postMessage"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "3+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "2+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "9.5+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "10+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android yes" {
						span {
							- "WebView Android"
						}
						span {
							- "≤37+"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "10.1+"
						}
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "Web browsers, for security and privacy reasons, prevent documents in different domains from\n  affecting each other; that is, cross-site scripting is disallowed."
		}
		- "\n\n  "
		p {
			- "While this is an important security feature, it prevents pages from different domains from\n  communicating even when those pages are not hostile. This section introduces a messaging system\n  that allows documents to communicate with each other regardless of their source domain, in a way\n  designed to not enable cross-site scripting attacks."
		}
		- "\n\n  "
		p id="fingerprint-postMessage" class="note" {
			- "\n  \n  The "
			code id="web-messaging:dom-window-postmessage" {
				a href="#dom-window-postmessage" {
					- "postMessage()"
				}
			}
			- " API can be used as a "
			a id="web-messaging:tracking-vector" href="https://infra.spec.whatwg.org/#tracking-vector" data-x-internal="tracking-vector" {
				- "tracking\n  vector"
			}
			- "."
		}
		- "\n\n\n  "
		h4 id="introduction-12" {
			span class="secno" {
				- "9.3.1"
			}
			- " Introduction"
			a href="#introduction-12" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For example, if document A contains an "
				code id="introduction-12:the-iframe-element" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " element that contains document B,\n   and script in document A calls "
				code id="introduction-12:dom-window-postmessage" {
					a href="#dom-window-postmessage" {
						- "postMessage()"
					}
				}
				- " on the\n   "
				code id="introduction-12:window" {
					a href="#window" {
						- "Window"
					}
				}
				- " object of document B, then a message event will be fired on that object,\n   marked as originating from the "
				code id="introduction-12:window-2" {
					a href="#window" {
						- "Window"
					}
				}
				- " of document A. The script in document A might\n   look like:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					c- a="" {
						- "var"
					}
					- " o "
					c- o="" {
						- "="
					}
					- " document"
					c- p="" {
						- "."
					}
					- "getElementsByTagName"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'iframe'"
					}
					c- p="" {
						- ")["
					}
					c- mf="" {
						- "0"
					}
					c- p="" {
						- "];"
					}
					- "\no"
					c- p="" {
						- "."
					}
					- "contentWindow"
					c- p="" {
						- "."
					}
					- "postMessage"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'Hello world'"
					}
					c- p="" {
						- ","
					}
					- " "
					c- t="" {
						- "'https://b.example.org/'"
					}
					c- p="" {
						- ");"
					}
				}
			}
			- "\n\n   "
			p {
				- "To register an event handler for incoming events, the script would use "
				code {
					- "addEventListener()"
				}
				- " (or similar mechanisms). For example, the script in document B\n   might look like:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					- "window"
					c- p="" {
						- "."
					}
					- "addEventListener"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'message'"
					}
					c- p="" {
						- ","
					}
					- " receiver"
					c- p="" {
						- ","
					}
					- " "
					c- kc="" {
						- "false"
					}
					c- p="" {
						- ");"
					}
					- "\n"
					c- a="" {
						- "function"
					}
					- " receiver"
					c- p="" {
						- "("
					}
					- "e"
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n  "
					c- k="" {
						- "if"
					}
					- " "
					c- p="" {
						- "("
					}
					- "e"
					c- p="" {
						- "."
					}
					- "origin "
					c- o="" {
						- "=="
					}
					- " "
					c- t="" {
						- "'https://example.com'"
					}
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- k="" {
						- "if"
					}
					- " "
					c- p="" {
						- "("
					}
					- "e"
					c- p="" {
						- "."
					}
					- "data "
					c- o="" {
						- "=="
					}
					- " "
					c- t="" {
						- "'Hello world'"
					}
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      e"
					c- p="" {
						- "."
					}
					- "source"
					c- p="" {
						- "."
					}
					- "postMessage"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'Hello'"
					}
					c- p="" {
						- ","
					}
					- " e"
					c- p="" {
						- "."
					}
					- "origin"
					c- p="" {
						- ");"
					}
					- "\n    "
					c- p="" {
						- "}"
					}
					- " "
					c- k="" {
						- "else"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      alert"
					c- p="" {
						- "("
					}
					- "e"
					c- p="" {
						- "."
					}
					- "data"
					c- p="" {
						- ");"
					}
					- "\n    "
					c- p="" {
						- "}"
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "This script first checks the domain is the expected domain, and then looks at the message,\n   which it either displays to the user, or responds to by sending a message back to the document\n   which sent the message in the first place."
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h4 id="security-postmsg" {
			span class="secno" {
				- "9.3.2"
			}
			- " Security"
			a href="#security-postmsg" class="self-link"
		}
		- "\n\n  \n\n  "
		h5 id="authors" {
			span class="secno" {
				- "9.3.2.1"
			}
			- " Authors"
			a href="#authors" class="self-link"
		}
		- "\n\n  \n\n  "
		p id="security-4" class="warning" {
			- "Use of this API requires extra care to protect users from\n  hostile entities abusing a site for their own purposes."
		}
		- "\n\n  "
		p {
			- "Authors should check the "
			code id="authors:dom-messageevent-origin" {
				a href="#dom-messageevent-origin" {
					- "origin"
				}
			}
			- " attribute to\n  ensure that messages are only accepted from domains that they expect to receive messages from.\n  Otherwise, bugs in the author's message handling code could be exploited by hostile sites."
		}
		- "\n\n  "
		p {
			- "Furthermore, even after checking the "
			code id="authors:dom-messageevent-origin-2" {
				a href="#dom-messageevent-origin" {
					- "origin"
				}
			}
			- "\n  attribute, authors should also check that the data in question is of the expected format.\n  Otherwise, if the source of the event has been attacked using a cross-site scripting flaw, further\n  unchecked processing of information sent using the "
			code id="authors:dom-window-postmessage" {
				a href="#dom-window-postmessage" {
					- "postMessage()"
				}
			}
			- " method could result in the attack being\n  propagated into the receiver."
		}
		- "\n\n  "
		p {
			- "Authors should not use the wildcard keyword (*) in the "
			var {
				- "targetOrigin"
			}
			- "\n  argument in messages that contain any confidential information, as otherwise there is no way to\n  guarantee that the message is only delivered to the recipient to which it was intended."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Authors who accept messages from any origin are encouraged to consider the risks of a\n  denial-of-service attack. An attacker could send a high volume of messages; if the receiving page\n  performs expensive computation or causes network traffic to be sent for each such message, the\n  attacker's message could be multiplied into a denial-of-service attack. Authors are encouraged to\n  employ rate limiting (only accepting a certain number of messages per minute) to make such attacks\n  impractical."
		}
		- "\n\n\n  \n\n  "
		h5 id="user-agents" {
			span class="secno" {
				- "9.3.2.2"
			}
			- " User agents"
			a href="#user-agents" class="self-link"
		}
		- "\n\n  "
		p {
			- "The integrity of this API is based on the inability for scripts of one "
			a href="#concept-origin" id="user-agents:concept-origin" {
				- "origin"
			}
			- " to\n  post arbitrary events (using "
			code {
				- "dispatchEvent()"
			}
			- " or otherwise) to objects in\n  other origins (those that are not the "
			a href="#same-origin" id="user-agents:same-origin" {
				- "same"
			}
			- ")."
		}
		- "\n\n  "
		p class="note" {
			- "Implementers are urged to take extra care in the implementation of this feature.\n  It allows authors to transmit information from one domain to another domain, which is normally\n  disallowed for security reasons. It also requires that UAs be careful to allow access to certain\n  properties but not others."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "User agents are also encouraged to consider rate-limiting message traffic between different\n  "
			a href="#concept-origin" id="user-agents:concept-origin-2" {
				- "origins"
			}
			- ", to protect naïve sites from denial-of-service\n  attacks."
		}
		- "\n\n  \n\n\n\n  "
		h4 id="posting-messages" {
			span class="secno" {
				- "9.3.3"
			}
			- " Posting messages"
			a href="#posting-messages" class="self-link"
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "window"
					}
					- "."
					a href="#dom-window-postmessage-options" id="dom-window-postmessage-options-dev" {
						- "postMessage"
					}
					- "("
					var {
						- "message"
					}
					- " [, "
					var {
						- "options"
					}
					- " ])"
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						b title="Support in all current engines." class="all-engines-flag" {
							- "✔"
						}
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/Window/postMessage" title="The window.postMessage() method safely enables cross-origin communication between Window objects; e.g., between a page and a pop-up that it spawned, or between a page and an iframe embedded within it." {
								- "Window/postMessage"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "3+"
								}
							}
							span class="safari yes" {
								span {
									- "Safari"
								}
								span {
									- "4+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "2+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "9.5+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "10+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios unknown" {
								span {
									- "Safari iOS"
								}
								span {
									- "?"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android yes" {
								span {
									- "WebView Android"
								}
								span {
									- "37+"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "10.1+"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Posts a message to the given window. Messages can be structured objects, e.g. nested objects\n    and arrays, can contain JavaScript values (strings, numbers, "
					code id="posting-messages:date" {
						a data-x-internal="date" href="https://tc39.es/ecma262/#sec-date-objects" {
							- "Date"
						}
					}
					- " objects, etc.),\n    and can contain certain data objects such as "
					code id="posting-messages:file" {
						a data-x-internal="file" href="https://w3c.github.io/FileAPI/#dfn-file" {
							- "File"
						}
					}
					- " "
					code id="posting-messages:blob" {
						a data-x-internal="blob" href="https://w3c.github.io/FileAPI/#dfn-Blob" {
							- "Blob"
						}
					}
					- ",\n    "
					code id="posting-messages:filelist" {
						a data-x-internal="filelist" href="https://w3c.github.io/FileAPI/#filelist-section" {
							- "FileList"
						}
					}
					- ", and "
					code id="posting-messages:idl-arraybuffer" {
						a data-x-internal="idl-arraybuffer" href="https://webidl.spec.whatwg.org/#idl-ArrayBuffer" {
							- "ArrayBuffer"
						}
					}
					- " objects."
				}
				- "\n\n    "
				p {
					- "Objects listed in the "
					code id="posting-messages:dom-structuredserializeoptions-transfer" {
						a href="#dom-structuredserializeoptions-transfer" {
							- "transfer"
						}
					}
					- " member\n    of "
					var {
						- "options"
					}
					- " are transferred, not just cloned, meaning that they are no longer usable\n    on the sending side."
				}
				- "\n\n    "
				p {
					- "A target origin can be specified using the "
					code id="posting-messages:dom-windowpostmessageoptions-targetorigin" {
						a href="#dom-windowpostmessageoptions-targetorigin" {
							- "targetOrigin"
						}
					}
					- " member of\n    "
					var {
						- "options"
					}
					- ". If not provided, it defaults to \""
					code {
						- "/"
					}
					- "\". This default\n    restricts the message to same-origin targets only."
				}
				- "\n\n    "
				p {
					- "If the origin of the target window doesn't match the given target origin, the message is\n    discarded, to avoid information leakage. To send the message to the target regardless of origin,\n    set the target origin to \""
					code {
						- "*"
					}
					- "\"."
				}
				- "\n\n    "
