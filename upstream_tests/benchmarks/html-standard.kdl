		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "New points and the lines connecting them are added to subpaths using the methods described\n  below. In all cases, the methods only modify the last subpath in the object's path."
		}
		- "\n\n  "
		p {
			- "The "
