					}
				}
				- "\n\n    "
				p class="tablenote" {
					small {
						- "The contents of this table are derived from the intersection of\n    Windows, Chrome, and Firefox defaults."
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			a id="determining-the-character-encoding:document's-character-encoding-4" href="https://dom.spec.whatwg.org/#concept-document-encoding" data-x-internal="document's-character-encoding" {
				- "document's character encoding"
			}
			- " must immediately be set to the value returned\n  from this algorithm, at the same time as the user agent uses the returned value to select the\n  decoder to use for the input byte stream."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When an algorithm requires a user agent to "
			dfn id="prescan-a-byte-stream-to-determine-its-encoding" data-export="" {
				- "prescan a byte stream to determine its\n  encoding"
			}
			- ", given some defined "
			dfn data-dfn-for="prescan a byte\n  stream to determine its encoding" id="prescan-end-condition" data-export="" {
				var {
					- "end condition"
				}
			}
			- ", then it must run the following\n  steps. If at any point during these steps (including during instances of the "
			a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing" {
				- "get an attribute"
			}
			- " algorithm invoked by this\n  one) the user agent either runs out of bytes (meaning the "
			var {
				- "position"
			}
			- " pointer created in\n  the first step below goes beyond the end of the byte stream obtained so far) or reaches its\n  "
			var {
				- "end condition"
			}
			- ", then abort the "
			a href="#prescan-a-byte-stream-to-determine-its-encoding" id="determining-the-character-encoding:prescan-a-byte-stream-to-determine-its-encoding-2" {
				- "prescan a byte stream to determine its\n  encoding"
			}
			- " algorithm and return the result "
			a href="#concept-get-xml-encoding-when-sniffing" id="determining-the-character-encoding:concept-get-xml-encoding-when-sniffing" {
				- "get an XML encoding"
			}
			- " applied to the same\n  bytes that the "
			a href="#prescan-a-byte-stream-to-determine-its-encoding" id="determining-the-character-encoding:prescan-a-byte-stream-to-determine-its-encoding-3" {
				- "prescan a byte stream to determine its encoding"
			}
			- " algorithm was applied\n  to. Otherwise, these steps will return a character encoding."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "fallback encoding"
					}
					- " be null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "position"
					}
					- " be a pointer to a byte in the input byte stream, initially\n   pointing at the first byte."
				}
			}
			li {
				- "\n    "
				p {
					- "Prescan for UTF-16 XML declarations: If "
					var {
						- "position"
					}
					- " points to:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "A sequence of bytes starting with: 0x3C, 0x0, 0x3F, 0x0, 0x78, 0x0 (case-sensitive UTF-16\n     little-endian '<?x')"
					}
					dd {
						p {
							- "Return "
							a id="determining-the-character-encoding:utf-16le" href="https://encoding.spec.whatwg.org/#utf-16le" data-x-internal="utf-16le" {
								- "UTF-16LE"
							}
							- "."
						}
					}
					dt {
						- "A sequence of bytes starting with: 0x0, 0x3C, 0x0, 0x3F, 0x0, 0x78 (case-sensitive UTF-16\n     big-endian '<?x')"
					}
					dd {
						p {
							- "Return "
							a id="determining-the-character-encoding:utf-16be" href="https://encoding.spec.whatwg.org/#utf-16be" data-x-internal="utf-16be" {
								- "UTF-16BE"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "For historical reasons, the prefix is two bytes longer than in "
					a href="https://www.w3.org/TR/REC-xml/#sec-guessing" {
						- "Appendix F"
					}
					- " of "
					cite {
						- "XML"
					}
					- " and the\n    encoding name is not checked."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					i {
						- "Loop"
					}
					- ": If "
					var {
						- "position"
					}
					- " points to:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "A sequence of bytes starting with: 0x3C 0x21 0x2D 0x2D (`"
						code {
							- "<!--"
						}
						- "`)"
					}
					dd {
						- "\n      "
						p {
							- "Advance the "
							var {
								- "position"
							}
							- " pointer so that it points at the first 0x3E byte\n      which is preceded by two 0x2D bytes (i.e. at the end of an ASCII '-->' sequence) and comes\n      after the 0x3C byte that was found. (The two 0x2D bytes can be the same as those in the\n      '<!--' sequence.)"
						}
						- "\n     "
					}
					dt {
						- "A sequence of bytes starting with: 0x3C, 0x4D or 0x6D, 0x45 or 0x65, 0x54 or 0x74, 0x41 or 0x61, and one of 0x09, 0x0A, 0x0C, 0x0D, 0x20, 0x2F (case-insensitive ASCII '<meta' followed by a space or slash)"
					}
					dd {
						- "\n      "
						ol {
							li {
								p {
									- "Advance the "
									var {
										- "position"
									}
									- " pointer so that it points at the next 0x09,\n       0x0A, 0x0C, 0x0D, 0x20, or 0x2F byte (the one in sequence of characters matched\n       above)."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "attribute list"
									}
									- " be an empty list of strings."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "got pragma"
									}
									- " be false."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "need pragma"
									}
									- " be null."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "charset"
									}
									- " be the null value (which, for the purposes of this\n       algorithm, is distinct from an unrecognized encoding or the empty string)."
								}
							}
							li {
								p {
									i {
										- "Attributes"
									}
									- ": "
									a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-2" {
										- "Get an\n       attribute"
									}
									- " and its value. If no attribute was sniffed, then jump to the\n       "
									i {
										- "processing"
									}
									- " step below."
								}
							}
							li {
								p {
									- "If the attribute's name is already in "
									var {
										- "attribute list"
									}
									- ", then return\n       to the step labeled "
									i {
										- "attributes"
									}
									- "."
								}
								- "\n\n       "
							}
							li {
								p {
									- "Add the attribute's name to "
									var {
										- "attribute list"
									}
									- "."
								}
								- "\n\n       "
							}
							li {
								- "\n        "
								p {
									- "Run the appropriate step from the following list, if one applies:"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										- "If the attribute's name is \""
										code {
											- "http-equiv"
										}
										- "\""
									}
									dd {
										p {
											- "If the attribute's value is \""
											code {
												- "content-type"
											}
											- "\", then set "
											var {
												- "got pragma"
											}
											- " to true."
										}
									}
									dt {
										- "If the attribute's name is \""
										code {
											- "content"
										}
										- "\""
									}
									dd {
										p {
											- "Apply the "
											a href="#algorithm-for-extracting-a-character-encoding-from-a-meta-element" id="determining-the-character-encoding:algorithm-for-extracting-a-character-encoding-from-a-meta-element" {
												- "algorithm for extracting a character encoding from a\n         "
												code {
													- "meta"
												}
												- " element"
											}
											- ", giving the attribute's value as the string to parse. If a\n         character encoding is returned, and if "
											var {
												- "charset"
											}
											- " is still set to null,\n         let "
											var {
												- "charset"
											}
											- " be the encoding returned, and set "
											var {
												- "need\n         pragma"
											}
											- " to true."
										}
									}
									dt {
										- "If the attribute's name is \""
										code {
											- "charset"
										}
										- "\""
									}
									dd {
										p {
											- "Let "
											var {
												- "charset"
											}
											- " be the result of "
											a id="determining-the-character-encoding:getting-an-encoding" href="https://encoding.spec.whatwg.org/#concept-encoding-get" data-x-internal="getting-an-encoding" {
												- "getting an encoding"
											}
											- "\n         from the attribute's value, and set "
											var {
												- "need pragma"
											}
											- " to false."
										}
									}
								}
								- "\n       "
							}
							li {
								p {
									- "Return to the step labeled "
									i {
										- "attributes"
									}
									- "."
								}
							}
							li {
								p {
									i {
										- "Processing"
									}
									- ": If "
									var {
										- "need pragma"
									}
									- " is null, then jump to the step\n       below labeled "
									i {
										- "next byte"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "need pragma"
									}
									- " is true but "
									var {
										- "got pragma"
									}
									- " is\n       false, then jump to the step below labeled "
									i {
										- "next byte"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "charset"
									}
									- " is failure, then jump to the step below labeled "
									i {
										- "next\n       byte"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "charset"
									}
									- " is "
									a id="determining-the-character-encoding:utf-16-encoding-2" href="https://encoding.spec.whatwg.org/#utf-16be-le" data-x-internal="utf-16-encoding" {
										- "UTF-16BE/LE"
									}
									- ", then set "
									var {
										- "charset"
									}
									- " to\n       "
									a id="determining-the-character-encoding:utf-8" href="https://encoding.spec.whatwg.org/#utf-8" data-x-internal="utf-8" {
										- "UTF-8"
									}
									- ".\n\n       "
								}
							}
							li {
								p {
									- "If "
									var {
										- "charset"
									}
									- " is "
									a id="determining-the-character-encoding:x-user-defined" href="https://encoding.spec.whatwg.org/#x-user-defined" data-x-internal="x-user-defined" {
										- "x-user-defined"
									}
									- ", then set "
									var {
										- "charset"
									}
									- " to\n       "
									a id="determining-the-character-encoding:windows-1252-2" href="https://encoding.spec.whatwg.org/#windows-1252" data-x-internal="windows-1252" {
										- "windows-1252"
									}
									- "."
								}
							}
							li {
								p {
									- "Return "
									var {
										- "charset"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					dt {
						- "A sequence of bytes starting with a 0x3C byte (<), optionally a 0x2F byte (/), and\n     finally a byte in the range 0x41-0x5A or 0x61-0x7A (A-Z or a-z)"
					}
					dd {
						- "\n      "
						ol {
							li {
								p {
									- "Advance the "
									var {
										- "position"
									}
									- " pointer so that it points at the next 0x09 (HT),\n       0x0A (LF), 0x0C (FF), 0x0D (CR), 0x20 (SP), or 0x3E (>) byte."
								}
							}
							li {
								p {
									- "Repeatedly "
									a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-3" {
										- "get an attribute"
									}
									- "\n       until no further attributes can be found, then jump to the step below labeled "
									i {
										- "next\n       byte"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
					dt {
						- "A sequence of bytes starting with: 0x3C 0x21 (`"
						code {
							- "<!"
						}
						- "`)"
					}
					dt {
						- "A sequence of bytes starting with: 0x3C 0x2F (`"
						code {
							- "</"
						}
						- "`)"
					}
					dt {
						- "A sequence of bytes starting with: 0x3C 0x3F (`"
						code {
							- "<?"
						}
						- "`)"
					}
					dd {
						- "\n      "
						p {
							- "Advance the "
							var {
								- "position"
							}
							- " pointer so that it points at the first 0x3E byte (>) that\n      comes after the 0x3C byte that was found."
						}
						- "\n     "
					}
					dt {
						- "Any other byte"
					}
					dd {
						- "\n      "
						p {
							- "Do nothing with that byte."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				i {
					- "Next byte"
				}
				- ": Move "
				var {
					- "position"
				}
				- " so it points at the next byte in the\n   input byte stream, and return to the step above labeled "
				i {
					- "loop"
				}
				- "."
			}
		}
		- "\n\n  "
		p {
			- "When the "
			a href="#prescan-a-byte-stream-to-determine-its-encoding" id="determining-the-character-encoding:prescan-a-byte-stream-to-determine-its-encoding-4" {
				- "prescan a byte stream to determine its encoding"
			}
			- " algorithm says to "
			dfn id="concept-get-attributes-when-sniffing" {
				- "get an attribute"
			}
			- ", it means doing this:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the byte at "
					var {
						- "position"
					}
					- " is one of 0x09 (HT), 0x0A (LF), 0x0C (FF), 0x0D (CR),\n   0x20 (SP), or 0x2F (/) then advance "
					var {
						- "position"
					}
					- " to the next byte and redo this\n   step."
				}
			}
			li {
				p {
					- "If the byte at "
					var {
						- "position"
					}
					- " is 0x3E (>), then abort the "
					a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-4" {
						- "get an attribute"
					}
					- " algorithm. There isn't\n   one."
				}
			}
			li {
				p {
					- "Otherwise, the byte at "
					var {
						- "position"
					}
					- " is the start of the attribute name.\n   Let "
					var {
						- "attribute name"
					}
					- " and "
					var {
						- "attribute value"
					}
					- " be the empty\n   string."
				}
			}
			li {
				p {
					- "Process the byte at "
					var {
						- "position"
					}
					- " as follows:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If it is 0x3D (=), and the "
						var {
							- "attribute name"
						}
						- " is longer than the empty string"
					}
					dd {
						- "Advance "
						var {
							- "position"
						}
						- " to the next byte and jump to the step below labeled\n     "
						i {
							- "value"
						}
						- "."
					}
					dt {
						- "If it is 0x09 (HT), 0x0A (LF), 0x0C (FF), 0x0D (CR), or 0x20 (SP)"
					}
					dd {
						- "Jump to the step below labeled "
						i {
							- "spaces"
						}
						- "."
					}
					dt {
						- "If it is 0x2F (/) or 0x3E (>)"
					}
					dd {
						- "Abort the "
						a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-5" {
							- "get an attribute"
						}
						- "\n     algorithm. The attribute's name is the value of "
						var {
							- "attribute name"
						}
						- ", its value\n     is the empty string."
					}
					dt {
						- "If it is in the range 0x41 (A) to 0x5A (Z)"
					}
					dd {
						- "Append the code point "
						var {
							- "b"
						}
						- "+0x20 to "
						var {
							- "attribute name"
						}
						- "\n     (where "
						var {
							- "b"
						}
						- " is the value of the byte at "
						var {
							- "position"
						}
						- "). (This converts the input\n     to lowercase.)"
					}
					dt {
						- "Anything else"
					}
					dd {
						- "Append the code point with the same value as the byte at "
						var {
							- "position"
						}
						- " to\n     "
						var {
							- "attribute name"
						}
						- ". (It doesn't actually matter how bytes outside the ASCII range are\n     handled here, since only ASCII bytes can contribute to the detection of a character\n     encoding.)"
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Advance "
					var {
						- "position"
					}
					- " to the next byte and return to the previous\n   step."
				}
			}
			li {
				p {
					i {
						- "Spaces"
					}
					- ": If the byte at "
					var {
						- "position"
					}
					- " is one of 0x09 (HT), 0x0A (LF), 0x0C\n   (FF), 0x0D (CR), or 0x20 (SP) then advance "
					var {
						- "position"
					}
					- " to the next byte, then, repeat\n   this step."
				}
			}
			li {
				p {
					- "If the byte at "
					var {
						- "position"
					}
					- " is "
					em {
						- "not"
					}
					- " 0x3D (=), abort the "
					a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-6" {
						- "get an attribute"
					}
					- " algorithm. The attribute's\n   name is the value of "
					var {
						- "attribute name"
					}
					- ", its value is the empty string."
				}
			}
			li {
				p {
					- "Advance "
					var {
						- "position"
					}
					- " past the 0x3D (=) byte."
				}
			}
			li {
				p {
					i {
						- "Value"
					}
					- ": If the byte at "
					var {
						- "position"
					}
					- " is one of 0x09 (HT), 0x0A (LF), 0x0C\n   (FF), 0x0D (CR), or 0x20 (SP) then advance "
					var {
						- "position"
					}
					- " to the next byte, then, repeat\n   this step."
				}
			}
			li {
				p {
					- "Process the byte at "
					var {
						- "position"
					}
					- " as follows:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If it is 0x22 (\") or 0x27 (')"
					}
					dd {
						- "\n      "
						ol {
							li {
								- "Let "
								var {
									- "b"
								}
								- " be the value of the byte at "
								var {
									- "position"
								}
								- "."
							}
							li {
								i {
									- "Quote loop"
								}
								- ": Advance "
								var {
									- "position"
								}
								- " to the next byte."
							}
							li {
								- "If the value of the byte at "
								var {
									- "position"
								}
								- " is the value of "
								var {
									- "b"
								}
								- ", then advance "
								var {
									- "position"
								}
								- " to the next byte and abort the\n       \"get an attribute\" algorithm. The attribute's name is the value of "
								var {
									- "attribute\n       name"
								}
								- ", and its value is the value of "
								var {
									- "attribute value"
								}
								- "."
							}
							li {
								- "Otherwise, if the value of the byte at "
								var {
									- "position"
								}
								- " is in the range 0x41 (A) to\n       0x5A (Z), then append a code point to "
								var {
									- "attribute value"
								}
								- " whose value is 0x20 more\n       than the value of the byte at "
								var {
									- "position"
								}
								- "."
							}
							li {
								- "Otherwise, append a code point to "
								var {
									- "attribute value"
								}
								- " whose value is the same as\n       the value of the byte at "
								var {
									- "position"
								}
								- "."
							}
							li {
								- "Return to the step above labeled "
								i {
									- "quote loop"
								}
								- "."
							}
						}
						- "\n     "
					}
					dt {
						- "If it is 0x3E (>)"
					}
					dd {
						- "Abort the "
						a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-7" {
							- "get an attribute"
						}
						- "\n     algorithm. The attribute's name is the value of "
						var {
							- "attribute name"
						}
						- ", its value\n     is the empty string."
					}
					dt {
						- "If it is in the range 0x41 (A) to 0x5A (Z)"
					}
					dd {
						- "Append a code point "
						var {
							- "b"
						}
						- "+0x20 to "
						var {
							- "attribute value"
						}
						- "\n     (where "
						var {
							- "b"
						}
						- " is the value of the byte at "
						var {
							- "position"
						}
						- "). Advance\n     "
						var {
							- "position"
						}
						- " to the next byte."
					}
					dt {
						- "Anything else"
					}
					dd {
						- "Append a code point with the same value as the byte at "
						var {
							- "position"
						}
						- " to\n     "
						var {
							- "attribute value"
						}
						- ". Advance "
						var {
							- "position"
						}
						- " to the next byte."
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Process the byte at "
					var {
						- "position"
					}
					- " as\n   follows:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						- "If it is 0x09 (HT), 0x0A (LF), 0x0C (FF), 0x0D (CR), 0x20 (SP), or 0x3E (>)"
					}
					dd {
						- "Abort the "
						a href="#concept-get-attributes-when-sniffing" id="determining-the-character-encoding:concept-get-attributes-when-sniffing-8" {
							- "get an attribute"
						}
						- "\n     algorithm. The attribute's name is the value of "
						var {
							- "attribute name"
						}
						- " and its\n     value is the value of "
						var {
							- "attribute value"
						}
						- "."
					}
					dt {
						- "If it is in the range 0x41 (A) to 0x5A (Z)"
					}
					dd {
						- "Append a code point "
						var {
							- "b"
						}
						- "+0x20 to "
						var {
							- "attribute value"
						}
						- "\n     (where "
						var {
							- "b"
						}
						- " is the value of the byte at "
						var {
							- "position"
						}
						- ")."
					}
					dt {
						- "Anything else"
					}
					dd {
						- "Append a code point with the same value as the byte at "
						var {
							- "position"
						}
						- " to\n     "
						var {
							- "attribute value"
						}
						- "."
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Advance "
					var {
						- "position"
					}
					- " to the next byte and return to the previous\n   step."
				}
			}
		}
		- "\n\n  "
		p {
			- "When the "
			a href="#prescan-a-byte-stream-to-determine-its-encoding" id="determining-the-character-encoding:prescan-a-byte-stream-to-determine-its-encoding-5" {
				- "prescan a byte stream to determine its encoding"
			}
			- " algorithm is aborted\n  without returning an encoding, "
			dfn id="concept-get-xml-encoding-when-sniffing" {
				- "get an XML\n  encoding"
			}
			- " means doing this."
		}
		- "\n\n  "
		p class="note" {
			- "Looking for syntax resembling an XML declaration, even in "
			code id="determining-the-character-encoding:text/html" {
				a href="#text/html" {
					- "text/html"
				}
			}
			- ",\n  is necessary for compatibility with existing content."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "encodingPosition"
					}
					- " be a pointer to the start of the stream."
				}
			}
			li {
				p {
					- "If "
					var {
						- "encodingPosition"
					}
					- " does not point to the start of a byte sequence 0x3C, 0x3F,\n   0x78, 0x6D, 0x6C (`"
					code {
						- "<?xml"
					}
					- "`), then return failure."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "xmlDeclarationEnd"
					}
					- " be a pointer to the next byte in the input byte stream\n   which is 0x3E (>). If there is no such byte, then return failure."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "encodingPosition"
					}
					- " to the position of the first occurrence of the subsequence\n   of bytes 0x65, 0x6E, 0x63, 0x6F, 0x64, 0x69, 0x6E, 0x67 (`"
					code {
						- "encoding"
					}
					- "`) at or\n   after the current "
					var {
						- "encodingPosition"
					}
					- ". If there is no such sequence, then return\n   failure."
				}
			}
			li {
				p {
					- "Advance "
					var {
						- "encodingPosition"
					}
					- " past the 0x67 (g) byte."
				}
			}
			li {
				p {
					- "While the byte at "
					var {
						- "encodingPosition"
					}
					- " is less than or equal to 0x20 (i.e., it is\n   either an ASCII space or control character), advance "
					var {
						- "encodingPosition"
					}
					- " to the next\n   byte."
				}
			}
			li {
				p {
					- "If the byte at "
					var {
						- "encodingPosition"
					}
					- " is not 0x3D (=), then return failure."
				}
			}
			li {
				p {
					- "Advance "
					var {
						- "encodingPosition"
					}
					- " to the next byte."
				}
			}
			li {
				p {
					- "While the byte at "
					var {
						- "encodingPosition"
					}
					- " is less than or equal to 0x20 (i.e., it is\n   either an ASCII space or control character), advance "
					var {
						- "encodingPosition"
					}
					- " to the next\n   byte."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "quoteMark"
					}
					- " be the byte at "
					var {
						- "encodingPosition"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "quoteMark"
					}
					- " is not either 0x22 (\") or 0x27 ('), then return failure."
				}
			}
			li {
				p {
					- "Advance "
					var {
						- "encodingPosition"
					}
					- " to the next byte."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "encodingEndPosition"
					}
					- " be the position of the next occurrence of\n   "
					var {
						- "quoteMark"
					}
					- " at or after "
					var {
						- "encodingPosition"
					}
					- ". If "
					var {
						- "quoteMark"
					}
					- " does not\n   occur again, then return failure."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "potentialEncoding"
					}
					- " be the sequence of the bytes between\n   "
					var {
						- "encodingPosition"
					}
					- " (inclusive) and "
					var {
						- "encodingEndPosition"
					}
					- " (exclusive)."
				}
			}
			li {
				p {
					- "If "
					var {
						- "potentialEncoding"
					}
					- " contains one or more bytes whose byte value is 0x20 or\n   below, then return failure."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "encoding"
					}
					- " be the result of "
					a id="determining-the-character-encoding:getting-an-encoding-2" href="https://encoding.spec.whatwg.org/#concept-encoding-get" data-x-internal="getting-an-encoding" {
						- "getting an encoding"
					}
					- " given\n   "
					var {
						- "potentialEncoding"
					}
					- " "
					a href="https://infra.spec.whatwg.org/#isomorphic-decode" id="determining-the-character-encoding:isomorphic-decode" data-x-internal="isomorphic-decode" {
						- "isomorphic decoded"
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "encoding"
					}
					- " is "
					a id="determining-the-character-encoding:utf-16-encoding-3" href="https://encoding.spec.whatwg.org/#utf-16be-le" data-x-internal="utf-16-encoding" {
						- "UTF-16BE/LE"
					}
					- ", then change it to\n   "
					a id="determining-the-character-encoding:utf-8-2" href="https://encoding.spec.whatwg.org/#utf-8" data-x-internal="utf-8" {
						- "UTF-8"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "encoding"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "For the sake of interoperability, user agents should not use a pre-scan algorithm that returns\n  different results than the one described above. (But, if you do, please at least let us know, so\n  that we can improve this algorithm and benefit everyone...)"
		}
		- "\n\n\n\n  "
		h5 id="character-encodings" {
			span class="secno" {
				- "13.2.3.3"
			}
			- " Character encodings"
			a href="#character-encodings" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agents must support the encodings defined in "
			cite {
				- "Encoding"
			}
			- ", including, but\n  not limited to,\n  "
			dfn id="utf-8" {
				a href="https://encoding.spec.whatwg.org/#utf-8" {
					- "UTF-8"
				}
			}
			- ",\n  "
			dfn id="iso-8859-2" {
				a href="https://encoding.spec.whatwg.org/#iso-8859-2" {
					- "ISO-8859-2"
				}
			}
			- ",\n  "
			dfn id="iso-8859-7" {
				a href="https://encoding.spec.whatwg.org/#iso-8859-7" {
					- "ISO-8859-7"
				}
			}
			- ",\n  "
			dfn id="iso-8859-8" {
				a href="https://encoding.spec.whatwg.org/#iso-8859-8" {
					- "ISO-8859-8"
				}
			}
			- ",\n  "
			dfn id="windows-874" {
				a href="https://encoding.spec.whatwg.org/#windows-874" {
					- "windows-874"
				}
			}
			- ",\n  "
			dfn id="windows-1250" {
				a href="https://encoding.spec.whatwg.org/#windows-1250" {
					- "windows-1250"
				}
			}
			- ",\n  "
			dfn id="windows-1251" {
				a href="https://encoding.spec.whatwg.org/#windows-1251" {
					- "windows-1251"
				}
			}
			- ",\n  "
			dfn id="windows-1252" {
				a href="https://encoding.spec.whatwg.org/#windows-1252" {
					- "windows-1252"
				}
			}
			- ",\n  "
			dfn id="windows-1254" {
				a href="https://encoding.spec.whatwg.org/#windows-1254" {
					- "windows-1254"
				}
			}
			- ",\n  "
			dfn id="windows-1255" {
				a href="https://encoding.spec.whatwg.org/#windows-1255" {
					- "windows-1255"
				}
			}
			- ",\n  "
			dfn id="windows-1256" {
				a href="https://encoding.spec.whatwg.org/#windows-1256" {
					- "windows-1256"
				}
			}
			- ",\n  "
			dfn id="windows-1257" {
				a href="https://encoding.spec.whatwg.org/#windows-1257" {
					- "windows-1257"
				}
			}
			- ",\n  "
			dfn id="windows-1258" {
				a href="https://encoding.spec.whatwg.org/#windows-1258" {
					- "windows-1258"
				}
			}
			- ",\n  "
			dfn id="gbk" {
				a href="https://encoding.spec.whatwg.org/#gbk" {
					- "GBK"
				}
			}
			- ",\n  "
			dfn id="big5" {
				a href="https://encoding.spec.whatwg.org/#big5" {
					- "Big5"
				}
			}
			- ",\n  "
			dfn id="iso-2022-jp" {
				a href="https://encoding.spec.whatwg.org/#iso-2022-jp" {
					- "ISO-2022-JP"
				}
			}
			- ",\n  "
			dfn id="shift_jis" {
				a href="https://encoding.spec.whatwg.org/#shift_jis" {
					- "Shift_JIS"
				}
			}
			- ",\n  "
			dfn id="euc-kr" {
				a href="https://encoding.spec.whatwg.org/#euc-kr" {
					- "EUC-KR"
				}
			}
			- ",\n  "
			dfn id="utf-16be" {
				a href="https://encoding.spec.whatwg.org/#utf-16be" {
					- "UTF-16BE"
				}
			}
			- ",\n  "
			dfn id="utf-16le" {
				a href="https://encoding.spec.whatwg.org/#utf-16le" {
					- "UTF-16LE"
				}
			}
			- ",\n  "
			dfn id="utf-16-encoding" {
				a href="https://encoding.spec.whatwg.org/#utf-16be-le" {
					- "UTF-16BE/LE"
				}
			}
			- ", and\n  "
			dfn id="x-user-defined" {
				a href="https://encoding.spec.whatwg.org/#x-user-defined" {
					- "x-user-defined"
				}
			}
			- ".\n  User agents must not support other encodings."
		}
		- "\n\n  "
		p class="note" {
			- "The above prohibits supporting, for example, CESU-8, UTF-7, BOCU-1, SCSU, EBCDIC,\n  and UTF-32. This specification does not make any attempt to support prohibited encodings in its\n  algorithms; support and use of prohibited encodings would thus lead to unexpected behavior.\n  "
			a href="#refsCESU8" {
				- "[CESU8]"
			}
			- " "
			a href="#refsUTF7" {
				- "[UTF7]"
			}
			- " "
			a href="#refsBOCU1" {
				- "[BOCU1]"
			}
			- " "
			a href="#refsSCSU" {
				- "[SCSU]"
			}
		}
		- "\n\n\n  "
		h5 id="changing-the-encoding-while-parsing" {
			span class="secno" {
				- "13.2.3.4"
			}
			- " Changing the encoding while parsing"
			a href="#changing-the-encoding-while-parsing" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the parser requires the user agent to "
			dfn id="change-the-encoding" {
				- "change the encoding"
			}
			- ", it must run the\n  following steps. This might happen if the "
			a href="#encoding-sniffing-algorithm" id="changing-the-encoding-while-parsing:encoding-sniffing-algorithm" {
				- "encoding sniffing algorithm"
			}
			- " described above\n  failed to find a character encoding, or if it found a character encoding that was not the actual\n  encoding of the file."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the encoding that is already being used to interpret the input stream is\n   "
					a id="changing-the-encoding-while-parsing:utf-16-encoding" href="https://encoding.spec.whatwg.org/#utf-16be-le" data-x-internal="utf-16-encoding" {
						- "UTF-16BE/LE"
					}
					- ", then set the "
					a href="#concept-encoding-confidence" id="changing-the-encoding-while-parsing:concept-encoding-confidence" {
						- "confidence"
					}
					- " to "
					i {
						- "certain"
					}
					- " and return. The new\n   encoding is ignored; if it was anything but the same encoding, then it would be clearly\n   incorrect."
				}
			}
			li {
				p {
					- "If the new encoding is "
					a id="changing-the-encoding-while-parsing:utf-16-encoding-2" href="https://encoding.spec.whatwg.org/#utf-16be-le" data-x-internal="utf-16-encoding" {
						- "UTF-16BE/LE"
					}
					- ", then change it to\n   "
					a id="changing-the-encoding-while-parsing:utf-8" href="https://encoding.spec.whatwg.org/#utf-8" data-x-internal="utf-8" {
						- "UTF-8"
					}
					- "."
				}
			}
			li {
				p {
					- "If the new encoding is "
					a id="changing-the-encoding-while-parsing:x-user-defined" href="https://encoding.spec.whatwg.org/#x-user-defined" data-x-internal="x-user-defined" {
						- "x-user-defined"
					}
					- ", then change it to\n   "
					a id="changing-the-encoding-while-parsing:windows-1252" href="https://encoding.spec.whatwg.org/#windows-1252" data-x-internal="windows-1252" {
						- "windows-1252"
					}
					- "."
				}
			}
			li {
				p {
					- "If the new encoding is identical or equivalent to the encoding that is already being used\n   to interpret the input stream, then set the "
					a href="#concept-encoding-confidence" id="changing-the-encoding-while-parsing:concept-encoding-confidence-2" {
						- "confidence"
					}
					- " to "
					i {
						- "certain"
					}
					- " and return.\n   This happens when the encoding information found in the file matches what the "
					a href="#encoding-sniffing-algorithm" id="changing-the-encoding-while-parsing:encoding-sniffing-algorithm-2" {
						- "encoding\n   sniffing algorithm"
					}
					- " determined to be the encoding, and in the second pass through the\n   parser if the first pass found that the encoding sniffing algorithm described in the earlier\n   section failed to find the right encoding."
				}
			}
			li {
				p {
					- "If all the bytes up to the last byte converted by the current decoder have the same\n   Unicode interpretations in both the current encoding and the new encoding, and if the user agent\n   supports changing the converter on the fly, then the user agent may change to the new converter\n   for the encoding on the fly. Set the "
					a id="changing-the-encoding-while-parsing:document's-character-encoding" href="https://dom.spec.whatwg.org/#concept-document-encoding" data-x-internal="document's-character-encoding" {
						- "document's character encoding"
					}
					- " and the encoding\n   used to convert the input stream to the new encoding, set the "
					a href="#concept-encoding-confidence" id="changing-the-encoding-while-parsing:concept-encoding-confidence-3" {
						- "confidence"
					}
					- " to "
					i {
						- "certain"
					}
					- ", and return."
				}
			}
			li {
				p {
					- "Otherwise, restart the "
					a href="#navigate" id="changing-the-encoding-while-parsing:navigate" {
						- "navigate"
					}
					- " algorithm, with "
					i id="changing-the-encoding-while-parsing:navigation-hh" {
						a href="#navigation-hh" {
							- "historyHandling"
						}
					}
					- " set to \""
					code id="changing-the-encoding-while-parsing:navigationhistorybehavior-replace" {
						a href="#navigationhistorybehavior-replace" {
							- "replace"
						}
					}
					- "\" and other inputs kept the same, but\n   this time skip the "
					a href="#encoding-sniffing-algorithm" id="changing-the-encoding-while-parsing:encoding-sniffing-algorithm-3" {
						- "encoding sniffing algorithm"
					}
					- " and instead just set the encoding to\n   the new encoding and the "
					a href="#concept-encoding-confidence" id="changing-the-encoding-while-parsing:concept-encoding-confidence-4" {
						- "confidence"
					}
					- " to\n   "
					i {
						- "certain"
					}
					- ". Whenever possible, this should be done without actually contacting the network\n   layer (the bytes should be re-parsed from memory), even if, e.g., the document is marked as not\n   being cacheable. If this is not possible and contacting the network layer would involve repeating\n   a request that uses a method other than `"
					code {
						- "GET"
					}
					- "`, then instead set the "
					a href="#concept-encoding-confidence" id="changing-the-encoding-while-parsing:concept-encoding-confidence-5" {
						- "confidence"
					}
					- " to "
					i {
						- "certain"
					}
					- " and ignore the new\n   encoding. The resource will be misinterpreted. User agents may notify the user of the situation,\n   to aid in application development."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "This algorithm is only invoked when a new encoding is found declared on a\n  "
			code id="changing-the-encoding-while-parsing:the-meta-element" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element."
		}
		- " \n\n\n  "
		h5 id="preprocessing-the-input-stream" {
			span class="secno" {
				- "13.2.3.5"
			}
			- " Preprocessing the input stream"
			a href="#preprocessing-the-input-stream" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="input-stream" {
				- "input stream"
			}
			- " consists of the characters pushed into it as the "
			a href="#the-input-byte-stream" id="preprocessing-the-input-stream:the-input-byte-stream" {
				- "input byte\n  stream"
			}
			- " is decoded or from the various APIs that directly manipulate the input stream."
		}
		- "\n\n  "
		p {
			- "Any occurrences of "
			a href="https://infra.spec.whatwg.org/#surrogate" id="preprocessing-the-input-stream:surrogate" data-x-internal="surrogate" {
				- "surrogates"
			}
			- " are "
			a href="#parse-error-surrogate-in-input-stream" id="preprocessing-the-input-stream:parse-error-surrogate-in-input-stream" {
				- "surrogate-in-input-stream"
			}
			- "\n  "
			a href="#parse-errors" id="preprocessing-the-input-stream:parse-errors" {
				- "parse errors"
			}
			- ". Any occurrences of "
			a href="https://infra.spec.whatwg.org/#noncharacter" id="preprocessing-the-input-stream:noncharacter" data-x-internal="noncharacter" {
				- "noncharacters"
			}
			- " are "
			a href="#parse-error-noncharacter-in-input-stream" id="preprocessing-the-input-stream:parse-error-noncharacter-in-input-stream" {
				- "noncharacter-in-input-stream"
			}
			- "\n  "
			a href="#parse-errors" id="preprocessing-the-input-stream:parse-errors-2" {
				- "parse errors"
			}
			- " and any occurrences of "
			a href="https://infra.spec.whatwg.org/#control" id="preprocessing-the-input-stream:control" data-x-internal="control" {
				- "controls"
			}
			- " other than "
			a id="preprocessing-the-input-stream:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
				- "ASCII whitespace"
			}
			- " and U+0000 NULL\n  characters are "
			a href="#parse-error-control-character-in-input-stream" id="preprocessing-the-input-stream:parse-error-control-character-in-input-stream" {
				- "control-character-in-input-stream"
			}
			- "\n  "
			a href="#parse-errors" id="preprocessing-the-input-stream:parse-errors-3" {
				- "parse errors"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "The handling of U+0000 NULL characters varies based on where the characters are\n  found and happens at the later stages of the parsing. They are either ignored or, for security\n  reasons, replaced with a U+FFFD REPLACEMENT CHARACTER. This handling is, by necessity, spread\n  across both the tokenization stage and the tree construction stage."
		}
		- "\n\n  "
		p {
			- "Before the "
			a href="#tokenization" id="preprocessing-the-input-stream:tokenization" {
				- "tokenization"
			}
			- " stage, the input stream must be preprocessed by "
			a href="https://infra.spec.whatwg.org/#normalize-newlines" id="preprocessing-the-input-stream:normalize-newlines" data-x-internal="normalize-newlines" {
				- "normalizing newlines"
			}
			- ". Thus, newlines in HTML DOMs are\n  represented by U+000A LF characters, and there are never any U+000D CR characters in the input to\n  the "
			a href="#tokenization" id="preprocessing-the-input-stream:tokenization-2" {
				- "tokenization"
			}
			- " stage."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="next-input-character" {
				- "next input character"
			}
			- " is the first character in the "
			a href="#input-stream" id="preprocessing-the-input-stream:input-stream" {
				- "input stream"
			}
			- "\n  that has not yet been "
			dfn {
				- "consumed"
			}
			- " or explicitly ignored by the requirements in\n  this section. Initially, the "
			i id="preprocessing-the-input-stream:next-input-character" {
				a href="#next-input-character" {
					- "next input character"
				}
			}
			- " is the\n  first character in the input. The "
			dfn id="current-input-character" {
				- "current input character"
			}
			- " is the last character to have\n  been "
			i {
				- "consumed"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="insertion-point" {
				- "insertion point"
			}
			- " is the position (just before a character or just before the end\n  of the input stream) where content inserted using "
			code id="preprocessing-the-input-stream:dom-document-write" {
				a href="#dom-document-write" {
					- "document.write()"
				}
			}
			- " is actually inserted. The insertion point is\n  relative to the position of the character immediately after it, it is not an absolute offset into\n  the input stream. Initially, the insertion point is undefined."
		}
		- "\n\n  "
		p {
			- "The \"EOF\" character in the tables below is a conceptual character representing the end of the\n  "
			a href="#input-stream" id="preprocessing-the-input-stream:input-stream-2" {
				- "input stream"
			}
			- ". If the parser is a "
			a href="#script-created-parser" id="preprocessing-the-input-stream:script-created-parser" {
				- "script-created parser"
			}
			- ", then the end of\n  the "
			a href="#input-stream" id="preprocessing-the-input-stream:input-stream-3" {
				- "input stream"
			}
			- " is reached when an "
			dfn id="explicit-eof-character" {
				- "explicit \"EOF\" character"
			}
			- " (inserted by\n  the "
			code id="preprocessing-the-input-stream:dom-document-close" {
				a href="#dom-document-close" {
					- "document.close()"
				}
			}
			- " method) is consumed. Otherwise, the\n  \"EOF\" character is not a real character in the stream, but rather the lack of any further\n  characters."
		}
		- "\n\n  \n\n\n  \n\n  "
		h4 id="parse-state" {
			span class="secno" {
				- "13.2.4"
			}
			- " Parse state"
			a href="#parse-state" class="self-link"
		}
		- "\n\n  "
		h5 id="the-insertion-mode" {
			span class="secno" {
				- "13.2.4.1"
			}
			- " The insertion mode"
			a href="#the-insertion-mode" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="insertion-mode" {
				- "insertion mode"
			}
			- " is a state variable that controls the primary operation of the\n  tree construction stage."
		}
		- "\n\n  "
		p {
			- "Initially, the "
			a href="#insertion-mode" id="the-insertion-mode:insertion-mode" {
				- "insertion mode"
			}
			- " is \""
			a href="#the-initial-insertion-mode" id="the-insertion-mode:the-initial-insertion-mode" {
				- "initial"
			}
			- "\". It can change to \""
			a href="#the-before-html-insertion-mode" id="the-insertion-mode:the-before-html-insertion-mode" {
				- "before\n  html"
			}
			- "\", \""
			a href="#the-before-head-insertion-mode" id="the-insertion-mode:the-before-head-insertion-mode" {
				- "before head"
			}
			- "\", \""
			a href="#parsing-main-inhead" id="the-insertion-mode:parsing-main-inhead" {
				- "in head"
			}
			- "\", \""
			a href="#parsing-main-inheadnoscript" id="the-insertion-mode:parsing-main-inheadnoscript" {
				- "in head noscript"
			}
			- "\", \""
			a href="#the-after-head-insertion-mode" id="the-insertion-mode:the-after-head-insertion-mode" {
				- "after head"
			}
			- "\",\n  \""
			a href="#parsing-main-inbody" id="the-insertion-mode:parsing-main-inbody" {
				- "in body"
			}
			- "\", \""
			a href="#parsing-main-incdata" id="the-insertion-mode:parsing-main-incdata" {
				- "text"
			}
			- "\", \""
			a href="#parsing-main-intable" id="the-insertion-mode:parsing-main-intable" {
				- "in table"
			}
			- "\", \""
			a href="#parsing-main-intabletext" id="the-insertion-mode:parsing-main-intabletext" {
				- "in table text"
			}
			- "\", \""
			a href="#parsing-main-incaption" id="the-insertion-mode:parsing-main-incaption" {
				- "in caption"
			}
			- "\", \""
			a href="#parsing-main-incolgroup" id="the-insertion-mode:parsing-main-incolgroup" {
				- "in column\n  group"
			}
			- "\", \""
			a href="#parsing-main-intbody" id="the-insertion-mode:parsing-main-intbody" {
				- "in table body"
			}
			- "\", \""
			a href="#parsing-main-intr" id="the-insertion-mode:parsing-main-intr" {
				- "in row"
			}
			- "\", \""
			a href="#parsing-main-intd" id="the-insertion-mode:parsing-main-intd" {
				- "in\n  cell"
			}
			- "\", \""
			a href="#parsing-main-inselect" id="the-insertion-mode:parsing-main-inselect" {
				- "in select"
			}
			- "\", \""
			a href="#parsing-main-inselectintable" id="the-insertion-mode:parsing-main-inselectintable" {
				- "in select in table"
			}
			- "\", \""
			a href="#parsing-main-intemplate" id="the-insertion-mode:parsing-main-intemplate" {
				- "in template"
			}
			- "\", \""
			a href="#parsing-main-afterbody" id="the-insertion-mode:parsing-main-afterbody" {
				- "after body"
			}
			- "\",\n  \""
			a href="#parsing-main-inframeset" id="the-insertion-mode:parsing-main-inframeset" {
				- "in frameset"
			}
			- "\", \""
			a href="#parsing-main-afterframeset" id="the-insertion-mode:parsing-main-afterframeset" {
				- "after frameset"
			}
			- "\", \""
			a href="#the-after-after-body-insertion-mode" id="the-insertion-mode:the-after-after-body-insertion-mode" {
				- "after\n  after body"
			}
			- "\", and \""
			a href="#the-after-after-frameset-insertion-mode" id="the-insertion-mode:the-after-after-frameset-insertion-mode" {
				- "after after\n  frameset"
			}
			- "\" during the course of the parsing, as described in the "
			a href="#tree-construction" id="the-insertion-mode:tree-construction" {
				- "tree\n  construction"
			}
			- " stage. The insertion mode affects how tokens are processed and whether CDATA\n  sections are supported."
		}
		- "\n\n  "
		p {
			- "Several of these modes, namely \""
			a href="#parsing-main-inhead" id="the-insertion-mode:parsing-main-inhead-2" {
				- "in head"
			}
			- "\", \""
			a href="#parsing-main-inbody" id="the-insertion-mode:parsing-main-inbody-2" {
				- "in body"
			}
			- "\", \""
			a href="#parsing-main-intable" id="the-insertion-mode:parsing-main-intable-2" {
				- "in\n  table"
			}
			- "\", and \""
			a href="#parsing-main-inselect" id="the-insertion-mode:parsing-main-inselect-2" {
				- "in select"
			}
			- "\", are special, in\n  that the other modes defer to them at various times. When the algorithm below says that the user\n  agent is to do something \""
			dfn id="using-the-rules-for" {
				- "using the rules for"
			}
			- " the "
			var {
				- "m"
			}
			- " insertion\n  mode\", where "
			var {
				- "m"
			}
			- " is one of these modes, the user agent must use the rules\n  described under the "
			var {
				- "m"
			}
			- " "
			a href="#insertion-mode" id="the-insertion-mode:insertion-mode-2" {
				- "insertion mode"
			}
			- "'s section, but must leave\n  the "
			a href="#insertion-mode" id="the-insertion-mode:insertion-mode-3" {
				- "insertion mode"
			}
			- " unchanged unless the rules in "
			var {
				- "m"
			}
			- " themselves\n  switch the "
			a href="#insertion-mode" id="the-insertion-mode:insertion-mode-4" {
				- "insertion mode"
			}
			- " to a new value."
		}
		- "\n\n  "
		p {
			- "When the insertion mode is switched to \""
			a href="#parsing-main-incdata" id="the-insertion-mode:parsing-main-incdata-2" {
				- "text"
			}
			- "\" or\n  \""
			a href="#parsing-main-intabletext" id="the-insertion-mode:parsing-main-intabletext-2" {
				- "in table text"
			}
			- "\", the "
			dfn id="original-insertion-mode" {
				- "original insertion\n  mode"
			}
			- " is also set. This is the insertion mode to which the tree construction stage will\n  return."
		}
		- "\n\n  "
		p {
			- "Similarly, to parse nested "
			code id="the-insertion-mode:the-template-element" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- " elements, a "
			dfn id="stack-of-template-insertion-modes" {
				- "stack of template insertion\n  modes"
			}
			- " is used. It is initially empty. The "
			dfn id="current-template-insertion-mode" {
				- "current template insertion mode"
			}
			- " is the\n  insertion mode that was most recently added to the "
			a href="#stack-of-template-insertion-modes" id="the-insertion-mode:stack-of-template-insertion-modes" {
				- "stack of template insertion modes"
			}
			- ".\n  The algorithms in the sections below will "
			i {
				- "push"
			}
			- " insertion modes onto this stack, meaning\n  that the specified insertion mode is to be added to the stack, and "
			i {
				- "pop"
			}
			- " insertion modes from\n  the stack, which means that the most recently added insertion mode must be removed from the\n  stack."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When the steps below require the UA to "
			dfn id="reset-the-insertion-mode-appropriately" {
				- "reset the insertion mode appropriately"
			}
			- ", it\n  means the UA must follow these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "last"
					}
					- " be false."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "node"
					}
					- " be the last node in the "
