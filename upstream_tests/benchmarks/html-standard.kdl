			var {
				- "settingsObject"
			}
			- ", a "
			a id="import-map-processing-model:string-5" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
			}
			- " "
			var {
				- "serializedBaseURL"
			}
			- ", a\n  "
			a id="import-map-processing-model:string-6" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
				- "string"
