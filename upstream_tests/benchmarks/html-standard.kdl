		- "\n\n  "
		p {
			- "A "
			dfn id="concept-datetime-local" {
				- "local date and time"
			}
			- " consists of a specific\n  "
			a href="#proleptic-gregorian-date" id="local-dates-and-times:proleptic-gregorian-date" {
				- "proleptic-Gregorian date"
			}
			- ", consisting of a year, a month, and a day, and a time,\n  consisting of an hour, a minute, a second, and a fraction of a second, but expressed without a\n  time zone. "
			a href="#refsGREGORIAN" {
				- "[GREGORIAN]"
			}
		}
		- "\n\n  "
		p {
			- "A string is a "
			dfn id="valid-local-date-and-time-string" {
				- "valid local date and time string"
			}
			- " representing a date and time if it\n  consists of the following components in the given order:"
		}
		- "\n\n  "
		ol {
			li {
