			}
			li {
				p {
					- "Let "
					var {
						- "settingsObject"
					}
					- " be the element's "
					a id="hyperlink-auditing:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
