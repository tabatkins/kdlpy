					}
					- ", and any script in the currently running "
					a href="#concept-task" id="event-loop-processing-model:concept-task-10" {
						- "task"
					}
					- " must block. User agents should remain responsive to user input\n   while paused, however, albeit in a reduced capacity since the "
					a href="#event-loop" id="event-loop-processing-model:event-loop-26" {
						- "event loop"
					}
					- " will not be\n   doing anything."
				}
			}
			li {
				p {
					a id="event-loop-processing-model:record-pause-duration" href="https://w3c.github.io/long-animation-frames/#record-pause-duration" data-x-internal="record-pause-duration" {
						- "Record pause duration"
					}
					- " given the "
					a id="event-loop-processing-model:duration-from" href="https://w3c.github.io/hr-time/#dfn-duration-from" data-x-internal="duration-from" {
						- "duration from"
					}
					- "\n   "
					var {
						- "timeBeforePause"
					}
					- " to the "
					a id="event-loop-processing-model:current-high-resolution-time-3" href="https://w3c.github.io/hr-time/#dfn-current-high-resolution-time" data-x-internal="current-high-resolution-time" {
						- "current high resolution time"
					}
					- " given\n   "
					var {
						- "global"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div class="warning" {
			- "\n   "
			p {
				a href="#pause" id="event-loop-processing-model:pause" {
					- "Pausing"
				}
				- " is highly detrimental to the user experience, especially\n   in scenarios where a single "
				a href="#event-loop" id="event-loop-processing-model:event-loop-27" {
					- "event loop"
				}
				- " is shared among multiple documents. User\n   agents are encouraged to experiment with alternatives to "
				a href="#pause" id="event-loop-processing-model:pause-2" {
					- "pausing"
				}
				- ",\n   such as "
				a href="#spin-the-event-loop" id="event-loop-processing-model:spin-the-event-loop-7" {
					- "spinning the event loop"
				}
				- " or even simply\n   proceeding without any kind of suspended execution at all, insofar as it is possible to do so\n   while preserving compatibility with existing content. This specification will happily change if\n   a less-drastic alternative is discovered to be web-compatible."
			}
			- "\n\n   "
			p {
				- "In the interim, implementers should be aware that the variety of alternatives that user agents\n   might experiment with can change subtle aspects of "
				a href="#event-loop" id="event-loop-processing-model:event-loop-28" {
					- "event loop"
				}
				- " behavior, including\n   "
				a href="#concept-task" id="event-loop-processing-model:concept-task-11" {
					- "task"
				}
				- " and "
				a href="#microtask" id="event-loop-processing-model:microtask-4" {
					- "microtask"
				}
				- " timing. Implementations should\n   continue experimenting even if doing so causes them to violate the exact semantics implied by the\n   "
				a href="#pause" id="event-loop-processing-model:pause-3" {
					- "pause"
				}
				- " operation."
			}
			- "\n  "
		}
		- "\n\n  "
		h5 id="generic-task-sources" {
			span class="secno" {
				- "8.1.7.4"
			}
			- " Generic task sources"
			a href="#generic-task-sources" class="self-link"
		}
		- "\n\n  "
		p {
			- "The following "
			a href="#task-source" id="generic-task-sources:task-source" {
				- "task sources"
			}
			- " are used by a number of mostly\n  unrelated features in this and other specifications."
		}
		- "\n\n  "
		dl {
			dt {
				- "The "
				dfn id="dom-manipulation-task-source" data-export="" {
					- "DOM manipulation task source"
				}
			}
			dd {
				- "\n    "
				p {
					- "This "
					a href="#task-source" id="generic-task-sources:task-source-2" {
						- "task source"
					}
					- " is used for features that react to DOM manipulations, such as\n    things that happen in a non-blocking fashion when an element is "
					a href="#insert-an-element-into-a-document" id="generic-task-sources:insert-an-element-into-a-document" {
						- "inserted into the document"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="user-interaction-task-source" data-export="" {
					- "user interaction task source"
				}
			}
			dd {
				- "\n    "
				p {
					- "This "
					a href="#task-source" id="generic-task-sources:task-source-3" {
						- "task source"
					}
					- " is used for features that react to user interaction, for\n    example keyboard or mouse input."
				}
				- "\n\n    "
				p {
					- "Events sent in response to user input (e.g. "
					code id="generic-task-sources:event-click" {
						a data-x-internal="event-click" href="https://w3c.github.io/uievents/#event-type-click" {
							- "click"
						}
					}
					- " events) must be fired using "
					a href="#concept-task" id="generic-task-sources:concept-task" {
						- "tasks"
					}
					- " "
					a href="#queue-a-task" id="generic-task-sources:queue-a-task" {
						- "queued"
					}
					- " with the "
					a href="#user-interaction-task-source" id="generic-task-sources:user-interaction-task-source" {
						- "user\n    interaction task source"
					}
					- ". "
					a href="#refsUIEVENTS" {
						- "[UIEVENTS]"
					}
				}
				- " \n   "
			}
			dt {
				- "The "
				dfn id="networking-task-source" data-export="" {
					- "networking task source"
				}
			}
			dd {
				- "\n    "
				p {
					- "This "
					a href="#task-source" id="generic-task-sources:task-source-4" {
						- "task source"
					}
					- " is used for features that trigger in response to network\n    activity."
				}
				- "\n   "
			}
			dt id="history-traversal-task-source" {
				- "The "
				dfn id="navigation-and-traversal-task-source" {
					- "navigation and traversal task source"
				}
			}
			dd {
				- "\n    "
				p {
					- "This "
					a href="#task-source" id="generic-task-sources:task-source-5" {
						- "task source"
					}
					- " is used to queue tasks involved in "
					a href="#navigate" id="generic-task-sources:navigate" {
						- "navigation"
					}
					- " and "
					a href="#apply-the-traverse-history-step" id="generic-task-sources:apply-the-traverse-history-step" {
						- "history\n    traversal"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="rendering-task-source" {
					- "rendering task source"
				}
			}
			dd {
				- "\n    "
				p {
					- "This "
					a href="#task-source" id="generic-task-sources:task-source-6" {
						- "task source"
					}
					- " is used solely to "
					a href="#update-the-rendering" id="generic-task-sources:update-the-rendering" {
						- "update the rendering"
					}
					- ".\n   "
				}
			}
		}
		- "\n\n  "
		h5 id="event-loop-for-spec-authors" {
			span class="secno" {
				- "8.1.7.5"
			}
			- " Dealing with the event loop from other specifications"
			a href="#event-loop-for-spec-authors" class="self-link"
		}
		- "\n\n  "
		p {
			- "Writing specifications that correctly interact with the "
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop" {
				- "event loop"
			}
			- " can be tricky.\n  This is compounded by how this specification uses concurrency-model-independent terminology, so we\n  say things like \""
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop-2" {
				- "event loop"
			}
			- "\" and \""
			a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel" {
				- "in parallel"
			}
			- "\" instead of using more\n  familiar model-specific terms like \"main thread\" or \"on a background thread\"."
		}
		- "\n\n  "
		p {
			- "By default, specification text generally runs on the "
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop-3" {
				- "event loop"
			}
			- ". This falls out\n  from the formal "
			a href="#event-loop-processing-model" {
				- "event loop processing model"
			}
			- ", in that\n  you can eventually trace most algorithms back to a "
			a href="#concept-task" id="event-loop-for-spec-authors:concept-task" {
				- "task"
			}
			- " "
			a href="#queue-a-task" id="event-loop-for-spec-authors:queue-a-task" {
				- "queued"
			}
			- " there."
		}
		- "\n\n  "
		p class="example" {
			- "The algorithm steps for any JavaScript method will be invoked by author code\n  calling that method. And author code can only be run via queued tasks, usually originating\n  somewhere in the "
			a href="#script-processing-model" {
				code {
					- "script"
				}
				- " processing model"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "From this starting point, the overriding guideline is that any work a specification needs to\n  perform that would otherwise block the "
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop-4" {
				- "event loop"
			}
			- " must instead be performed "
			a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-2" {
				- "in\n  parallel"
			}
			- " with it. This includes (but is not limited to):"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "performing heavy computation;"
				}
			}
			li {
				p {
					- "displaying a user-facing prompt;"
				}
			}
			li {
				p {
					- "performing operations which could require involving outside systems (i.e. \"going out of\n   process\")."
				}
			}
		}
		- "\n\n  "
		p {
			- "The next complication is that, in algorithm sections that are "
			a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-3" {
				- "in parallel"
			}
			- ", you\n  must not create or manipulate objects associated to a specific "
			a id="event-loop-for-spec-authors:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- ", "
			a href="#global-object" id="event-loop-for-spec-authors:global-object" {
				- "global"
			}
			- ", or "
			a href="#environment-settings-object" id="event-loop-for-spec-authors:environment-settings-object" {
				- "environment settings object"
			}
			- ". (Stated in more\n  familiar terms, you must not directly access main-thread artifacts from a background thread.)\n  Doing so would create data races observable to JavaScript code, since after all, your algorithm\n  steps are running "
			em {
				a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-4" {
					- "in parallel"
				}
			}
			- " to the JavaScript code."
		}
		- "\n\n  "
		p {
			- "You can, however, manipulate specification-level data structures and values from\n  "
			cite {
				- "Infra"
			}
			- ", as those are realm-agnostic. They are never directly exposed to JavaScript without\n  a specific conversion taking place (often "
			a href="https://webidl.spec.whatwg.org/#es-type-mapping" id="event-loop-for-spec-authors:concept-idl-convert" data-x-internal="concept-idl-convert" {
				- "via Web IDL"
			}
			- ").\n  "
			a href="#refsINFRA" {
				- "[INFRA]"
			}
			- " "
			a href="#refsWEBIDL" {
				- "[WEBIDL]"
			}
		}
		- "\n\n  "
		p {
			- "To affect the world of observable JavaScript objects, then, you must "
			a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task" {
				- "queue a global\n  task"
			}
			- " to perform any such manipulations. This ensures your steps are properly interleaved\n  with respect to other things happening on the "
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop-5" {
				- "event loop"
			}
			- ". Furthermore, you must\n  choose a "
			a href="#task-source" id="event-loop-for-spec-authors:task-source" {
				- "task source"
			}
			- " when "
			a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-2" {
				- "queuing a global\n  task"
			}
			- "; this governs the relative order of your steps versus others. If you are unsure which\n  "
			a href="#task-source" id="event-loop-for-spec-authors:task-source-2" {
				- "task source"
			}
			- " to use, pick one of the "
			a href="#generic-task-sources" {
				- "generic task\n  sources"
			}
			- " that sounds most applicable. Finally, you must indicate which "
			a href="#global-object" id="event-loop-for-spec-authors:global-object-2" {
				- "global\n  object"
			}
			- " your queued task is associated with; this ensures that if that global object is\n  inactive, the task does not run."
		}
		- "\n\n  "
		p class="note" {
			- "The base primitive, on which "
			a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-3" {
				- "queue a global task"
			}
			- " builds, is the\n  "
			a href="#queue-a-task" id="event-loop-for-spec-authors:queue-a-task-2" {
				- "queue a task"
			}
			- " algorithm. In general, "
			a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-4" {
				- "queue a global task"
			}
			- " is better\n  because it automatically picks the right "
			a href="#event-loop" id="event-loop-for-spec-authors:event-loop-6" {
				- "event loop"
			}
			- " and, where appropriate, "
			a href="#concept-task-document" id="event-loop-for-spec-authors:concept-task-document" {
				- "document"
			}
			- ". Older specifications often use "
			a href="#queue-a-task" id="event-loop-for-spec-authors:queue-a-task-3" {
				- "queue a\n  task"
			}
			- " combined with the "
			a href="#implied-event-loop" id="event-loop-for-spec-authors:implied-event-loop" {
				- "implied event loop"
			}
			- " and "
			a href="#implied-document" id="event-loop-for-spec-authors:implied-document" {
				- "implied document"
			}
			- "\n  concepts, but this is discouraged."
		}
		- "\n\n  "
		p {
			- "Putting this all together, we can provide a template for a typical algorithm that needs to do\n  work asynchronously:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Do any synchronous setup work, while still on the "
					a href="#event-loop" id="event-loop-for-spec-authors:event-loop-7" {
						- "event loop"
					}
					- ". This may\n   include converting "
					a id="event-loop-for-spec-authors:realm-2" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- "-specific JavaScript values into realm-agnostic\n   specification-level values."
				}
			}
			li {
				p {
					- "Perform a set of potentially-expensive steps "
					a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-5" {
						- "in parallel"
					}
					- ", operating entirely\n   on realm-agnostic values, and producing a realm-agnostic result."
				}
			}
			li {
				p {
					a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-5" {
						- "Queue a global task"
					}
					- ", on a specified "
					a href="#task-source" id="event-loop-for-spec-authors:task-source-3" {
						- "task source"
					}
					- " and given an\n   appropriate "
					a href="#global-object" id="event-loop-for-spec-authors:global-object-3" {
						- "global object"
					}
					- ", to convert the realm-agnostic result back into observable\n   effects on the observable world of JavaScript objects on the "
					a href="#event-loop" id="event-loop-for-spec-authors:event-loop-8" {
						- "event loop"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		div id="example-event-loop-using-algorithm" class="example" {
			- "\n\n   "
			p {
				- "The following is an algorithm that \"encrypts\" a passed-in "
				a id="event-loop-for-spec-authors:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
					- "list"
				}
				- " of "
				a href="https://infra.spec.whatwg.org/#scalar-value-string" id="event-loop-for-spec-authors:scalar-value-string" data-x-internal="scalar-value-string" {
					- "scalar value strings"
				}
				- " "
				var {
					- "input"
				}
				- ", after parsing them as\n   URLs:"
			}
			- "\n\n   "
			ol {
				li {
					p {
						- "Let "
						var {
							- "urls"
						}
						- " be an empty "
						a id="event-loop-for-spec-authors:list-2" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
							- "list"
						}
						- "."
					}
				}
				li {
					- "\n     "
					p {
						a href="https://infra.spec.whatwg.org/#list-iterate" id="event-loop-for-spec-authors:list-iterate" data-x-internal="list-iterate" {
							- "For each"
						}
						- " "
						var {
							- "string"
						}
						- " of "
						var {
							- "input"
						}
						- ":"
					}
					- "\n\n     "
					ol {
						li {
							p {
								- "Let "
								var {
									- "parsed"
								}
								- " be the result of "
								a href="#encoding-parsing-a-url" id="event-loop-for-spec-authors:encoding-parsing-a-url" {
									- "encoding-parsing a URL"
								}
								- " given\n      "
								var {
									- "string"
								}
								- ", relative to the "
								a href="#current-settings-object" id="event-loop-for-spec-authors:current-settings-object" {
									- "current settings object"
								}
								- "."
							}
						}
						li {
							p {
								- "If "
								var {
									- "parsed"
								}
								- " is failure, then return "
								a id="event-loop-for-spec-authors:a-promise-rejected-with" href="https://webidl.spec.whatwg.org/#a-promise-rejected-with" data-x-internal="a-promise-rejected-with" {
									- "a promise rejected with"
								}
								- " a\n      "
								a id="event-loop-for-spec-authors:syntaxerror" href="https://webidl.spec.whatwg.org/#syntaxerror" data-x-internal="syntaxerror" {
									- "\""
									code {
										- "SyntaxError"
									}
									- "\""
								}
								- " "
								code id="event-loop-for-spec-authors:domexception" {
									a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
										- "DOMException"
									}
								}
								- "."
							}
						}
						li {
							p {
								- "Let "
								var {
									- "serialized"
								}
								- " be the result of applying the "
								a href="https://url.spec.whatwg.org/#concept-url-serializer" id="event-loop-for-spec-authors:concept-url-serializer" data-x-internal="concept-url-serializer" {
									- "URL serializer"
								}
								- " to "
								var {
									- "parsed"
								}
								- "."
							}
						}
						li {
							p {
								a href="https://infra.spec.whatwg.org/#list-append" id="event-loop-for-spec-authors:list-append" data-x-internal="list-append" {
									- "Append"
								}
								- " "
								var {
									- "serialized"
								}
								- " to "
								var {
									- "urls"
								}
								- "."
							}
						}
					}
					- "\n    "
				}
				li {
					p {
						- "Let "
						var {
							- "realm"
						}
						- " be the "
						a id="event-loop-for-spec-authors:current-realm" href="https://tc39.es/ecma262/#current-realm" data-x-internal="current-realm" {
							- "current realm"
						}
						- "."
					}
				}
				li {
					p {
						- "Let "
						var {
							- "p"
						}
						- " be a new promise."
					}
				}
				li {
					- "\n     "
					p {
						- "Run the following steps "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-6" {
							- "in parallel"
						}
						- ":"
					}
					- "\n\n     "
					ol {
						li {
							p {
								- "Let "
								var {
									- "encryptedURLs"
								}
								- " be an empty "
								a id="event-loop-for-spec-authors:list-3" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
									- "list"
								}
								- "."
							}
						}
						li {
							- "\n       "
							p {
								a href="https://infra.spec.whatwg.org/#list-iterate" id="event-loop-for-spec-authors:list-iterate-2" data-x-internal="list-iterate" {
									- "For each"
								}
								- " "
								var {
									- "url"
								}
								- " of "
								var {
									- "urls"
								}
								- ":"
							}
							- "\n\n       "
							ol {
								li {
									p {
										- "Wait 100 milliseconds, so that people think we're doing heavy-duty encryption."
									}
								}
								li {
									p {
										- "Let "
										var {
											- "encrypted"
										}
										- " be a new "
										a id="event-loop-for-spec-authors:string" href="https://infra.spec.whatwg.org/#string" data-x-internal="string" {
											- "string"
										}
										- " derived from "
										var {
											- "url"
										}
										- ",\n        whose "
										var {
											- "n"
										}
										- "th "
										a id="event-loop-for-spec-authors:code-unit" href="https://infra.spec.whatwg.org/#code-unit" data-x-internal="code-unit" {
											- "code unit"
										}
										- " is equal to "
										var {
											- "url"
										}
										- "'s "
										var {
											- "n"
										}
										- "th\n        "
										a id="event-loop-for-spec-authors:code-unit-2" href="https://infra.spec.whatwg.org/#code-unit" data-x-internal="code-unit" {
											- "code unit"
										}
										- " plus 13."
									}
								}
								li {
									p {
										a href="https://infra.spec.whatwg.org/#list-append" id="event-loop-for-spec-authors:list-append-2" data-x-internal="list-append" {
											- "Append"
										}
										- " "
										var {
											- "encrypted"
										}
										- " to\n        "
										var {
											- "encryptedURLs"
										}
										- "."
									}
									- "\n       "
								}
							}
							- "\n      "
						}
						li {
							- "\n       "
							p {
								a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-6" {
									- "Queue a global task"
								}
								- " on the "
								a href="#networking-task-source" id="event-loop-for-spec-authors:networking-task-source" {
									- "networking task source"
								}
								- ", given\n       "
								var {
									- "realm"
								}
								- "'s "
								a href="#concept-realm-global" id="event-loop-for-spec-authors:concept-realm-global" {
									- "global object"
								}
								- ", to perform the\n       following steps:"
							}
							- "\n\n       "
							ol {
								li {
									p {
										- "Let "
										var {
											- "array"
										}
										- " be the result of "
										a href="https://webidl.spec.whatwg.org/#es-type-mapping" id="event-loop-for-spec-authors:concept-idl-convert-2" data-x-internal="concept-idl-convert" {
											- "converting"
										}
										- " "
										var {
											- "encryptedURLs"
										}
										- " to a JavaScript\n        array, in "
										var {
											- "realm"
										}
										- "."
									}
								}
								li {
									p {
										- "Resolve "
										var {
											- "p"
										}
										- " with "
										var {
											- "array"
										}
										- "."
									}
								}
							}
							- "\n      "
						}
					}
					- "\n    "
				}
				li {
					p {
						- "Return "
						var {
							- "p"
						}
						- "."
					}
				}
			}
			- "\n\n   "
			p {
				- "Here are several things to notice about this algorithm:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "It does its URL parsing up front, on the "
						a href="#event-loop" id="event-loop-for-spec-authors:event-loop-9" {
							- "event loop"
						}
						- ", before going to the\n    "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-7" {
							- "in parallel"
						}
						- " steps. This is necessary, since parsing depends on the "
						a href="#current-settings-object" id="event-loop-for-spec-authors:current-settings-object-2" {
							- "current\n    settings object"
						}
						- ", which would no longer be current after going "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-8" {
							- "in\n    parallel"
						}
						- "."
					}
				}
				li {
					p {
						- "Alternately, it could have saved a reference to the "
						a href="#current-settings-object" id="event-loop-for-spec-authors:current-settings-object-3" {
							- "current settings\n    object"
						}
						- "'s "
						a href="#api-base-url" id="event-loop-for-spec-authors:api-base-url" {
							- "API base URL"
						}
						- " and used it during the "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-9" {
							- "in parallel"
						}
						- " steps;\n    that would have been equivalent. However, we recommend instead doing as much work as possible up\n    front, as this example does. Attempting to save the correct values can be error prone; for\n    example, if we'd saved just the "
						a href="#current-settings-object" id="event-loop-for-spec-authors:current-settings-object-4" {
							- "current settings object"
						}
						- ", instead of its "
						a href="#api-base-url" id="event-loop-for-spec-authors:api-base-url-2" {
							- "API\n    base URL"
						}
						- ", there would have been a potential race."
					}
				}
				li {
					p {
						- "It implicitly passes a "
						a id="event-loop-for-spec-authors:list-4" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
							- "list"
						}
						- " of "
						a href="https://infra.spec.whatwg.org/#string" id="event-loop-for-spec-authors:string-2" data-x-internal="string" {
							- "strings"
						}
						- " from the\n    initial steps to the "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-10" {
							- "in parallel"
						}
						- " steps. This is OK, as both "
						a href="https://infra.spec.whatwg.org/#list" id="event-loop-for-spec-authors:list-5" data-x-internal="list" {
							- "lists"
						}
						- " and "
						a href="https://infra.spec.whatwg.org/#string" id="event-loop-for-spec-authors:string-3" data-x-internal="string" {
							- "strings"
						}
						- " are\n    "
						a id="event-loop-for-spec-authors:realm-3" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
							- "realm"
						}
						- "-agnostic."
					}
				}
				li {
					p {
						- "It performs \"expensive computation\" (waiting for 100 milliseconds per input URL) during\n    the "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-11" {
							- "in parallel"
						}
						- " steps, thus not blocking the main "
						a href="#event-loop" id="event-loop-for-spec-authors:event-loop-10" {
							- "event loop"
						}
						- "."
					}
				}
				li {
					p {
						- "Promises, as observable JavaScript objects, are never created and manipulated during the\n    "
						a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-12" {
							- "in parallel"
						}
						- " steps. "
						var {
							- "p"
						}
						- " is created before entering those steps, and then is\n    manipulated during a "
						a href="#concept-task" id="event-loop-for-spec-authors:concept-task-2" {
							- "task"
						}
						- " that is "
						a href="#queue-a-global-task" id="event-loop-for-spec-authors:queue-a-global-task-7" {
							- "queued"
						}
						- " specifically for that purpose."
					}
				}
				li {
					p {
						- "The creation of a JavaScript array object also happens during the queued task, and is\n    careful to specify which realm it creates the array in since that is no longer obvious from\n    context."
					}
				}
			}
			- "\n\n   "
			p {
				- "(On these last two points, see also "
				a href="https://github.com/whatwg/webidl/issues/135" {
					- "whatwg/webidl issue #135"
				}
				- " and "
				a href="https://github.com/whatwg/webidl/issues/371" {
					- "whatwg/webidl issue #371"
				}
				- ", where we are\n   still mulling over the subtleties of the above promise-resolution pattern.)"
			}
			- "\n\n   "
			p {
				- "Another thing to note is that, in the event this algorithm was called from a Web IDL-specified\n   operation taking a "
				code {
					- "sequence"
				}
				- "<"
				code id="event-loop-for-spec-authors:idl-usvstring" {
					a data-x-internal="idl-usvstring" href="https://webidl.spec.whatwg.org/#idl-USVString" {
						- "USVString"
					}
				}
				- ">, there was an automatic conversion from\n   "
				a id="event-loop-for-spec-authors:realm-4" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
					- "realm"
				}
				- "-specific JavaScript objects provided by the author as input, into the\n   realm-agnostic "
				code {
					- "sequence"
				}
				- "<"
				code id="event-loop-for-spec-authors:idl-usvstring-2" {
					a data-x-internal="idl-usvstring" href="https://webidl.spec.whatwg.org/#idl-USVString" {
						- "USVString"
					}
				}
				- ">\n   Web IDL type, which we then treat as a "
				a id="event-loop-for-spec-authors:list-6" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
					- "list"
				}
				- " of "
				a href="https://infra.spec.whatwg.org/#scalar-value-string" id="event-loop-for-spec-authors:scalar-value-string-2" data-x-internal="scalar-value-string" {
					- "scalar value strings"
				}
				- ". So depending on how your specification is structured, there\n   may be other implicit steps happening on the main "
				a href="#event-loop" id="event-loop-for-spec-authors:event-loop-11" {
					- "event loop"
				}
				- " that play a part in\n   this whole process of getting you ready to go "
				a href="#in-parallel" id="event-loop-for-spec-authors:in-parallel-13" {
					- "in parallel"
				}
				- "."
			}
			- "\n\n  "
		}
		- "\n\n\n  \n\n  "
		h4 id="events" {
			span class="secno" {
				- "8.1.8"
			}
			- " Events"
			a href="#events" class="self-link"
		}
		- "\n\n  "
		h5 id="event-handler-attributes" {
			span class="secno" {
				- "8.1.8.1"
			}
			- " Event handlers"
			a href="#event-handler-attributes" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/Guide/Events/Event_handlers" title="Events are signals fired inside the browser window that notify of changes in the browser or operating system environment. Programmers can create event handler code that will run when an event fires, allowing web pages to respond appropriately to change." {
						- "Events/Event_handlers"
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "Many objects can have "
			dfn id="event-handlers" data-lt="event handler" data-export="" {
				- "event handlers"
			}
			- " specified. These\n  act as non-capture "
			a href="https://dom.spec.whatwg.org/#concept-event-listener" id="event-handler-attributes:event-listener" data-x-internal="event-listener" {
				- "event listeners"
			}
			- " for the object on which\n  they are specified. "
			a href="#refsDOM" {
				- "[DOM]"
			}
		}
		- "\n\n  \n\n  "
		p {
			- "An "
			a href="#event-handlers" id="event-handler-attributes:event-handlers" {
				- "event handler"
			}
			- " is a "
			a id="event-handler-attributes:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with two "
			a href="https://infra.spec.whatwg.org/#struct-item" id="event-handler-attributes:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "a "
					dfn data-dfn-for="event handler" id="event-handler-value" data-export="" {
						- "value"
					}
					- ", which is\n   either null, a callback object, or an\n   "
					a href="#internal-raw-uncompiled-handler" id="event-handler-attributes:internal-raw-uncompiled-handler" {
						- "internal raw uncompiled handler"
					}
					- ". The "
					code id="event-handler-attributes:eventhandler" {
						a href="#eventhandler" {
							- "EventHandler"
						}
					}
					- " callback\n   function type describes how this is exposed to scripts. Initially, an "
					a href="#event-handlers" id="event-handler-attributes:event-handlers-2" {
						- "event handler"
					}
					- "'s "
					a href="#event-handler-value" id="event-handler-attributes:event-handler-value" {
						- "value"
					}
					- "\n   must be set to null."
				}
			}
			li {
				p {
					- "a "
					dfn data-dfn-for="event handler" id="event-handler-listener" data-export="" {
						- "listener"
					}
					- ", which\n   is either null or an "
					a id="event-handler-attributes:event-listener-2" href="https://dom.spec.whatwg.org/#concept-event-listener" data-x-internal="event-listener" {
						- "event listener"
					}
					- " responsible for running "
					a href="#the-event-handler-processing-algorithm" id="event-handler-attributes:the-event-handler-processing-algorithm" {
						- "the\n   event handler processing algorithm"
					}
					- ". Initially, an "
					a href="#event-handlers" id="event-handler-attributes:event-handlers-3" {
						- "event handler"
					}
					- "'s "
					a href="#event-handler-listener" id="event-handler-attributes:event-handler-listener" {
						- "listener"
					}
					- " must be set to null."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Event handlers are exposed in two ways."
		}
		- "\n\n  "
		p {
			- "The first way, common to all event handlers, is as an "
			a href="#event-handler-idl-attributes" id="event-handler-attributes:event-handler-idl-attributes" {
				- "event handler IDL attribute"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The second way is as an "
			a href="#event-handler-content-attributes" id="event-handler-attributes:event-handler-content-attributes" {
				- "event handler content\n  attribute"
			}
			- ". Event handlers on "
			a href="#html-elements" id="event-handler-attributes:html-elements" {
				- "HTML elements"
			}
			- " and some of the event handlers on\n  "
			code id="event-handler-attributes:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " objects are exposed in this way."
		}
		- "\n\n  "
		p {
			- "For both of these two ways, the "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-4" {
				- "event handler"
			}
			- " is exposed\n  through a "
			dfn id="event-handler-name" {
				- "name"
			}
			- ", which is a string that always starts with\n  \""
			code {
				- "on"
			}
			- "\" and is followed by the name of the event for which the handler is\n  intended."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Most of the time, the object that exposes an "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-5" {
				- "event handler"
			}
			- "\n  is the same as the object on which the corresponding "
			a id="event-handler-attributes:event-listener-3" href="https://dom.spec.whatwg.org/#concept-event-listener" data-x-internal="event-listener" {
				- "event listener"
			}
			- " is added.\n  However, the "
			code id="event-handler-attributes:the-body-element" {
				a href="#the-body-element" {
					- "body"
				}
			}
			- " and "
			code id="event-handler-attributes:frameset" {
				a href="#frameset" {
					- "frameset"
				}
			}
			- " elements expose several "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-6" {
				- "event\n  handlers"
			}
			- " that act upon the element's "
			code id="event-handler-attributes:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " object, if one exists. In either\n  case, we call the object an "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-7" {
				- "event handler"
			}
			- " acts upon the "
			dfn id="event-handler-target" {
				- "target"
			}
			- " of that "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-8" {
				- "event\n  handler"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "To "
			dfn id="determining-the-target-of-an-event-handler" {
				- "determine the target of an event\n  handler"
			}
			- ", given an "
			code id="event-handler-attributes:eventtarget" {
				a data-x-internal="eventtarget" href="https://dom.spec.whatwg.org/#interface-eventtarget" {
					- "EventTarget"
				}
			}
			- " object "
			var {
				- "eventTarget"
			}
			- " on which the "
			a href="#event-handlers" id="event-handler-attributes:event-handlers-9" {
				- "event handler"
			}
			- " is exposed, and an "
			a href="#event-handler-name" id="event-handler-attributes:event-handler-name" {
				- "event handler name"
			}
			- "\n  "
			var {
				- "name"
			}
			- ", the following steps are taken:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "eventTarget"
					}
					- " is not a "
					code id="event-handler-attributes:the-body-element-2" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element or a "
					code id="event-handler-attributes:frameset-2" {
						a href="#frameset" {
							- "frameset"
						}
					}
					- "\n   element, then return "
					var {
						- "eventTarget"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "name"
					}
					- " is not the name of an attribute member of the\n   "
					code id="event-handler-attributes:windoweventhandlers" {
						a href="#windoweventhandlers" {
							- "WindowEventHandlers"
						}
					}
					- " interface mixin and the "
					a href="#window-reflecting-body-element-event-handler-set" id="event-handler-attributes:window-reflecting-body-element-event-handler-set" {
						code {
							- "Window"
						}
						- "-reflecting\n   body element event handler set"
					}
					- " does not "
					a href="https://infra.spec.whatwg.org/#list-contain" id="event-handler-attributes:list-contains" data-x-internal="list-contains" {
						- "contain"
					}
					- "\n   "
					var {
						- "name"
					}
					- ", then return "
					var {
						- "eventTarget"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "eventTarget"
					}
					- "'s "
					a id="event-handler-attributes:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- " is not an "
					a href="#active-document" id="event-handler-attributes:active-document" {
						- "active\n    document"
					}
					- ", then return null."
				}
				- "\n\n    "
				p class="note" {
					- "This could happen if this object is a "
					code id="event-handler-attributes:the-body-element-3" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element without\n    a corresponding "
					code id="event-handler-attributes:window-3" {
						a href="#window" {
							- "Window"
						}
					}
					- " object, for example."
				}
				- "\n\n    "
				p class="note" {
					- "This check does not necessarily prevent "
					code id="event-handler-attributes:the-body-element-4" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " and\n    "
					code id="event-handler-attributes:frameset-3" {
						a href="#frameset" {
							- "frameset"
						}
					}
					- " elements that are not "
					a href="#the-body-element-2" id="event-handler-attributes:the-body-element-2-2" {
						- "the body element"
					}
					- " of their "
					a id="event-handler-attributes:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n    document"
					}
					- " from reaching the next step. In particular, a "
					code id="event-handler-attributes:the-body-element-5" {
						a href="#the-body-element" {
							- "body"
						}
					}
					- " element created\n    in an "
					a href="#active-document" id="event-handler-attributes:active-document-2" {
						- "active document"
					}
					- " (perhaps with "
					code id="event-handler-attributes:dom-document-createelement" {
