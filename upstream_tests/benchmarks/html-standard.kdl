					}
					- "'s "
					a href="#concept-settings-object-origin" id="script-settings-for-workers:concept-settings-object-origin" {
						- "origin"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "realm"
					}
					- " be the value of "
					var {
						- "execution context"
					}
					- "'s Realm\n   component."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "worker global scope"
					}
					- " be "
					var {
						- "realm"
					}
					- "'s "
					a href="#concept-realm-global" id="script-settings-for-workers:concept-realm-global" {
						- "global object"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "settings object"
					}
					- " be a new "
					a href="#environment-settings-object" id="script-settings-for-workers:environment-settings-object-2" {
						- "environment settings object"
					}
					- " whose algorithms\n    are defined as follows:"
