					- "allow-same-origin"
				}
			}
			- " keyword causes the\n  content to be treated as being from its real origin instead of forcing it into an "
			a href="#concept-origin-opaque" id="the-iframe-element:concept-origin-opaque-2" {
				- "opaque origin"
			}
			- "; the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-2" {
				a href="#attr-iframe-sandbox-allow-top-navigation" {
					- "allow-top-navigation"
				}
			}
			- " keyword allows the\n  content to "
			a href="#navigate" id="the-iframe-element:navigate-4" {
				- "navigate"
			}
			- " its "
			a href="#nav-traversable" id="the-iframe-element:nav-traversable" {
				- "traversable navigable"
			}
			- ";\n  the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-by-user-activation-2" {
				a href="#attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
					- "allow-top-navigation-by-user-activation"
				}
			}
			- "\n  keyword behaves similarly but allows such "
			a href="#navigate" id="the-iframe-element:navigate-5" {
				- "navigation"
			}
			- " only when the\n  browsing context's "
			a href="#nav-window" id="the-iframe-element:nav-window" {
				- "active window"
			}
			- " has "
			a href="#transient-activation" id="the-iframe-element:transient-activation" {
				- "transient\n  activation"
			}
			- "; the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-to-custom-protocols-2" {
				a href="#attr-iframe-sandbox-allow-top-navigation-to-custom-protocols" {
					- "allow-top-navigation-to-custom-protocols"
				}
			}
			- "\n  reenables navigations toward non "
			a id="the-iframe-element:fetch-scheme" href="https://fetch.spec.whatwg.org/#fetch-scheme" data-x-internal="fetch-scheme" {
				- "fetch scheme"
			}
			- " to be "
			a href="#hand-off-to-external-software" id="the-iframe-element:hand-off-to-external-software" {
				- "handed off to external software"
			}
			- "; and the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-forms-2" {
				a href="#attr-iframe-sandbox-allow-forms" {
					- "allow-forms"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-modals-2" {
				a href="#attr-iframe-sandbox-allow-modals" {
					- "allow-modals"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-orientation-lock-2" {
				a href="#attr-iframe-sandbox-allow-orientation-lock" {
					- "allow-orientation-lock"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-pointer-lock-2" {
				a href="#attr-iframe-sandbox-allow-pointer-lock" {
					- "allow-pointer-lock"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-popups-2" {
				a href="#attr-iframe-sandbox-allow-popups" {
					- "allow-popups"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-presentation-2" {
				a href="#attr-iframe-sandbox-allow-presentation" {
					- "allow-presentation"
				}
			}
			- ", "
			code id="the-iframe-element:attr-iframe-sandbox-allow-scripts-2" {
				a href="#attr-iframe-sandbox-allow-scripts" {
					- "allow-scripts"
				}
			}
			- ", and "
			code id="the-iframe-element:attr-iframe-sandbox-allow-popups-to-escape-sandbox-2" {
				a href="#attr-iframe-sandbox-allow-popups-to-escape-sandbox" {
					- "allow-popups-to-escape-sandbox"
				}
			}
			- "\n  keywords re-enable forms, modal dialogs, screen orientation lock, the pointer lock API, popups,\n  the presentation API, scripts, and the creation of unsandboxed "
			a href="#auxiliary-browsing-context" id="the-iframe-element:auxiliary-browsing-context" {
				- "auxiliary browsing contexts"
			}
			- " respectively. The "
			code id="the-iframe-element:attr-iframe-sandbox-allow-downloads-2" {
				a href="#attr-iframe-sandbox-allow-downloads" {
					- "allow-downloads"
				}
			}
			- " keyword allows content to\n  perform downloads. "
			a href="#refsPOINTERLOCK" {
				- "[POINTERLOCK]"
			}
			- " "
			a href="#refsSCREENORIENTATION" {
				- "[SCREENORIENTATION]"
			}
			- " "
			a href="#refsPRESENTATION" {
				- "[PRESENTATION]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-3" {
				a href="#attr-iframe-sandbox-allow-top-navigation" {
					- "allow-top-navigation"
				}
			}
			- " and "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-by-user-activation-3" {
				a href="#attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
					- "allow-top-navigation-by-user-activation"
				}
			}
			- "\n  keywords must not both be specified, as doing so is redundant; only "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-4" {
				a href="#attr-iframe-sandbox-allow-top-navigation" {
					- "allow-top-navigation"
				}
			}
			- " will have an effect\n  in such non-conformant markup."
		}
		- "\n\n  "
		p {
			- "Similarly, the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-to-custom-protocols-3" {
				a href="#attr-iframe-sandbox-allow-top-navigation-to-custom-protocols" {
					- "allow-top-navigation-to-custom-protocols"
				}
			}
			- "\n  keyword must not be specified if either "
			code id="the-iframe-element:attr-iframe-sandbox-allow-top-navigation-5" {
				a href="#attr-iframe-sandbox-allow-top-navigation" {
					- "allow-top-navigation"
				}
			}
			- " or "
			code id="the-iframe-element:attr-iframe-sandbox-allow-popups-3" {
				a href="#attr-iframe-sandbox-allow-popups" {
					- "allow-popups"
				}
			}
			- " are specified, as doing so is\n  redundant."
		}
		- "\n\n  "
		p class="note" {
			- "To allow "
			code id="the-iframe-element:dom-alert" {
				a href="#dom-alert" {
					- "alert()"
				}
			}
			- ", "
			code id="the-iframe-element:dom-confirm" {
				a href="#dom-confirm" {
					- "confirm()"
				}
			}
			- ", and "
			code id="the-iframe-element:dom-prompt" {
				a href="#dom-prompt" {
					- "prompt()"
				}
			}
			- " inside\n  sandboxed content, both the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-modals-3" {
				a href="#attr-iframe-sandbox-allow-modals" {
					- "allow-modals"
				}
			}
			- "\n  and "
			code id="the-iframe-element:attr-iframe-sandbox-allow-same-origin-3" {
				a href="#attr-iframe-sandbox-allow-same-origin" {
					- "allow-same-origin"
				}
			}
			- " keywords need to\n  be specified, and the loaded URL needs to be "
			a href="#same-origin" id="the-iframe-element:same-origin" {
				- "same origin"
			}
			- " with the "
			a href="#concept-environment-top-level-origin" id="the-iframe-element:concept-environment-top-level-origin" {
				- "top-level\n  origin"
			}
			- ". Without the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-same-origin-4" {
				a href="#attr-iframe-sandbox-allow-same-origin" {
					- "allow-same-origin"
				}
			}
			- " keyword, the content is\n  always treated as cross-origin, and cross-origin content "
			a href="#cannot-show-simple-dialogs" id="the-iframe-element:cannot-show-simple-dialogs" {
				- "cannot show simple\n  dialogs"
			}
			- "."
		}
		- "\n\n  "
		p class="warning" {
			- "Setting both the "
			code id="the-iframe-element:attr-iframe-sandbox-allow-scripts-3" {
				a href="#attr-iframe-sandbox-allow-scripts" {
					- "allow-scripts"
				}
			}
			- " and "
			code id="the-iframe-element:attr-iframe-sandbox-allow-same-origin-5" {
				a href="#attr-iframe-sandbox-allow-same-origin" {
					- "allow-same-origin"
				}
			}
			- " keywords together when the\n  embedded page has the "
			a href="#same-origin" id="the-iframe-element:same-origin-2" {
				- "same origin"
			}
			- " as the page containing the "
			code id="the-iframe-element:the-iframe-element-19" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- "\n  allows the embedded page to simply remove the "
			code id="the-iframe-element:attr-iframe-sandbox-5" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- "\n  attribute and then reload itself, effectively breaking out of the sandbox altogether."
		}
		- "\n\n  "
		p class="warning" {
			- "These flags only take effect when the "
			a href="#content-navigable" id="the-iframe-element:content-navigable-20" {
				- "content navigable"
			}
			- " of the\n  "
			code id="the-iframe-element:the-iframe-element-20" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element is "
			a href="#navigate" id="the-iframe-element:navigate-6" {
				- "navigated"
			}
			- ". Removing them, or\n  removing the entire "
			code id="the-iframe-element:attr-iframe-sandbox-6" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- " attribute, has no effect on\n  an already-loaded page."
		}
		- "\n\n  "
		p class="warning" {
			- "Potentially hostile files should not be served from the same server as the file\n  containing the "
			code id="the-iframe-element:the-iframe-element-21" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element. Sandboxing hostile content is of minimal help if an\n  attacker can convince the user to just visit the hostile content directly, rather than in the\n  "
			code id="the-iframe-element:the-iframe-element-22" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- ". To limit the damage that can be caused by hostile HTML content, it should be\n  served from a separate dedicated domain. Using a different domain ensures that scripts in the\n  files are unable to attack the site, even if the user is tricked into visiting those pages\n  directly, without the protection of the "
			code id="the-iframe-element:attr-iframe-sandbox-7" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- "\n  attribute."
		}
		- "\n\n  \n\n  \n\n  "
		p {
			- "When an "
			code id="the-iframe-element:the-iframe-element-23" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element's "
			code id="the-iframe-element:attr-iframe-sandbox-8" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- "\n  attribute is set or changed while it has a non-null "
			a href="#content-navigable" id="the-iframe-element:content-navigable-21" {
				- "content navigable"
			}
			- ", the user\n  agent must "
			a href="#parse-a-sandboxing-directive" id="the-iframe-element:parse-a-sandboxing-directive-2" {
				- "parse the sandboxing directive"
			}
			- "\n  given the attribute's value and the "
			code id="the-iframe-element:the-iframe-element-24" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element's "
			a href="#iframe-sandboxing-flag-set" id="the-iframe-element:iframe-sandboxing-flag-set-2" {
				code {
					- "iframe"
				}
				- "\n  sandboxing flag set"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an "
			code id="the-iframe-element:the-iframe-element-25" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element's "
			code id="the-iframe-element:attr-iframe-sandbox-9" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- "\n  attribute is removed while it has a non-null "
			a href="#content-navigable" id="the-iframe-element:content-navigable-22" {
				- "content navigable"
			}
			- ", the user agent must\n  empty the "
			code id="the-iframe-element:the-iframe-element-26" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element's "
			a href="#iframe-sandboxing-flag-set" id="the-iframe-element:iframe-sandboxing-flag-set-3" {
				code {
					- "iframe"
				}
				- " sandboxing flag set"
			}
			- "."
		}
		- "\n\n  \n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In this example, some completely-unknown, potentially hostile, user-provided HTML content is\n   embedded in a page. Because it is served from a separate domain, it is affected by all the normal\n   cross-site restrictions. In addition, the embedded page has scripting disabled, plugins disabled,\n   forms disabled, and it cannot navigate any frames or windows other than itself (or any frames or\n   windows it itself embeds)."
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "We're not scared of you! Here is your content, unedited:"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "iframe"
					}
					- " "
					c- e="" {
						- "sandbox"
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://usercontent.example.net/getusercontent.cgi?id=12193\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "iframe"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p class="warning" {
				- "It is important to use a separate domain so that if the attacker convinces the\n   user to visit that page directly, the page doesn't run in the context of the site's origin, which\n   would make the user vulnerable to any attack found in the page."
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In this example, a gadget from another site is embedded. The gadget has scripting and forms\n   enabled, and the origin sandbox restrictions are lifted, allowing the gadget to communicate with\n   its originating server. The sandbox is still useful, however, as it disables plugins and popups,\n   thus reducing the risk of the user being exposed to malware and other annoyances."
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "iframe"
					}
					- " "
					c- e="" {
						- "sandbox"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"allow-same-origin allow-forms allow-scripts\""
					}
					- "\n        "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://maps.example.com/embedded.html\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "iframe"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Suppose a file A contained the following fragment:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "iframe"
					}
					- " "
					c- e="" {
						- "sandbox"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"allow-same-origin allow-forms\""
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "B"
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "iframe"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "Suppose that file B contained an iframe also:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "iframe"
					}
					- " "
					c- e="" {
						- "sandbox"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"allow-scripts\""
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "C"
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "iframe"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "Further, suppose that file C contained a link:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "a"
					}
					- " "
					c- e="" {
						- "href"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "D"
					}
					c- p="" {
						- ">"
					}
					- "Link"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "a"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "For this example, suppose all the files were served as "
				code id="the-iframe-element:text/html" {
					a href="#text/html" {
						- "text/html"
					}
				}
				- "."
			}
			- "\n\n   "
			p {
				- "Page C in this scenario has all the sandboxing flags set. Scripts are disabled, because the\n   "
				code id="the-iframe-element:the-iframe-element-27" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " in A has scripts disabled, and this overrides the "
				code id="the-iframe-element:attr-iframe-sandbox-allow-scripts-4" {
					a href="#attr-iframe-sandbox-allow-scripts" {
						- "allow-scripts"
					}
				}
				- " keyword set on the\n   "
				code id="the-iframe-element:the-iframe-element-28" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " in B. Forms are also disabled, because the inner "
				code id="the-iframe-element:the-iframe-element-29" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " (in B)\n   does not have the "
				code id="the-iframe-element:attr-iframe-sandbox-allow-forms-3" {
					a href="#attr-iframe-sandbox-allow-forms" {
						- "allow-forms"
					}
				}
				- " keyword\n   set."
			}
			- "\n\n   "
			p {
				- "Suppose now that a script in A removes all the "
				code id="the-iframe-element:attr-iframe-sandbox-10" {
					a href="#attr-iframe-sandbox" {
						- "sandbox"
					}
				}
				- " attributes in A  and B.\n   This would change nothing immediately. If the user clicked the link in C, loading page D into\n   the "
				code id="the-iframe-element:the-iframe-element-30" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " in B, page D would now act as if the "
				code id="the-iframe-element:the-iframe-element-31" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " in B had the\n   "
				code id="the-iframe-element:attr-iframe-sandbox-allow-same-origin-6" {
					a href="#attr-iframe-sandbox-allow-same-origin" {
						- "allow-same-origin"
					}
				}
				- " and "
				code id="the-iframe-element:attr-iframe-sandbox-allow-forms-4" {
					a href="#attr-iframe-sandbox-allow-forms" {
						- "allow-forms"
					}
				}
				- " keywords set, because that was the\n   state of the "
				a href="#content-navigable" id="the-iframe-element:content-navigable-23" {
					- "content navigable"
				}
				- " in the "
				code id="the-iframe-element:the-iframe-element-32" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- " in A when page B was\n   loaded."
			}
			- "\n\n   "
			p {
				- "Generally speaking, dynamically removing or changing the "
				code id="the-iframe-element:attr-iframe-sandbox-11" {
					a href="#attr-iframe-sandbox" {
						- "sandbox"
					}
				}
