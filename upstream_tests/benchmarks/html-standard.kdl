					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "User agents may "
			a href="#destroy-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:destroy-a-top-level-traversable" {
				- "destroy a top-level traversable"
			}
			- " at any time (typically, "
			a href="#nav-traversal-ui" {
				- "in response to user requests"
			}
			- ")."
		}
		- "\n\n  "
		p id="closing-browsing-contexts" {
			span id="close-a-browsing-context"
			- "To "
			dfn data-dfn-for="top-level traversable" id="close-a-top-level-traversable" data-export="" {
				- "close"
			}
			- " a "
			a href="#top-level-traversable" id="garbage-collection-and-browsing-contexts:top-level-traversable-2" {
				- "top-level traversable"
			}
			- " "
			var {
				- "traversable"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "traversable"
					}
					- "'s "
					a href="#is-closing" id="garbage-collection-and-browsing-contexts:is-closing" {
						- "is closing"
					}
					- " is true, then return."
				}
			}
			li {
				p {
					a href="#definitely-close-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:definitely-close-a-top-level-traversable" {
						- "Definitely close"
					}
					- "\n   "
					var {
						- "traversable"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="definitely-close-a-top-level-traversable" {
				- "definitely close"
			}
			- " a\n  "
			a href="#top-level-traversable" id="garbage-collection-and-browsing-contexts:top-level-traversable-3" {
				- "top-level traversable"
			}
			- " "
			var {
				- "traversable"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "toUnload"
					}
					- " be "
					var {
						- "traversable"
					}
					- "'s "
					a href="#nav-document" id="garbage-collection-and-browsing-contexts:nav-document-2" {
						- "active\n   document"
					}
					- "'s "
					a href="#inclusive-descendant-navigables" id="garbage-collection-and-browsing-contexts:inclusive-descendant-navigables" {
						- "inclusive descendant navigables"
					}
					- "."
				}
			}
			li {
				p {
					- "If the result of "
					a href="#checking-if-unloading-is-canceled" id="garbage-collection-and-browsing-contexts:checking-if-unloading-is-canceled" {
						- "checking if unloading is canceled"
					}
					- " for "
					var {
						- "toUnload"
					}
					- " is\n   true, then return."
				}
			}
			li {
				- "\n    "
				p {
					a href="#tn-append-session-history-traversal-steps" id="garbage-collection-and-browsing-contexts:tn-append-session-history-traversal-steps-2" {
						- "Append the following session history\n    traversal steps"
					}
					- " to "
					var {
						- "traversable"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "afterAllUnloads"
							}
							- " be an algorithm step which "
							a href="#destroy-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:destroy-a-top-level-traversable-2" {
								- "destroys"
							}
							- " "
							var {
								- "traversable"
							}
							- "."
						}
					}
					li {
						p {
							a href="#unload-a-document-and-its-descendants" id="garbage-collection-and-browsing-contexts:unload-a-document-and-its-descendants" {
								- "Unload a document and its descendants"
							}
							- " given "
							var {
								- "traversable"
							}
							- "'s "
							a href="#nav-document" id="garbage-collection-and-browsing-contexts:nav-document-3" {
								- "active document"
							}
							- ", null, and "
							var {
								- "afterAllUnloads"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#close-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:close-a-top-level-traversable" {
				- "close"
			}
			- " vs. "
			a href="#definitely-close-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:definitely-close-a-top-level-traversable-2" {
				- "definitely close"
			}
			- " separation allows other\n  specifications to call "
			a href="#close-a-top-level-traversable" id="garbage-collection-and-browsing-contexts:close-a-top-level-traversable-2" {
				- "close"
			}
			- " and have it be a\n  no-op if the top-level traversable is already closing due to JavaScript code calling "
			code id="garbage-collection-and-browsing-contexts:dom-window-close" {
				a href="#dom-window-close" {
					- "window.close()"
				}
			}
			- "."
		}
		- "\n\n\n  "
		h5 id="navigable-target-names" {
			span class="secno" {
				- "7.3.1.7"
			}
			- " "
			span id="browsing-context-names"
			- "Navigable target names"
			a href="#navigable-target-names" class="self-link"
		}
		- "\n\n  "
		p {
			a href="#navigable" id="navigable-target-names:navigable" {
				- "Navigables"
			}
			- " can be given "
			a href="#nav-target" id="navigable-target-names:nav-target" {
				- "target\n  names"
			}
			- ", which are strings allowing certain APIs (such as "
			code id="navigable-target-names:dom-open" {
				a href="#dom-open" {
					- "window.open()"
				}
			}
			- " or the "
			code id="navigable-target-names:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " element's "
			code id="navigable-target-names:attr-hyperlink-target" {
				a href="#attr-hyperlink-target" {
					- "target"
				}
			}
			- " attribute) to target "
			a href="#navigate" id="navigable-target-names:navigate" {
				- "navigations"
			}
			- " at that navigable."
		}
		- "\n\n  "
		p id="valid-browsing-context-name" {
			- "A "
			dfn id="valid-navigable-target-name" {
				- "valid navigable target name"
			}
			- " is any string with at\n  least one character that does not contain both an "
			a id="navigable-target-names:ascii-tab-or-newline" href="https://infra.spec.whatwg.org/#ascii-tab-or-newline" data-x-internal="ascii-tab-or-newline" {
				- "ASCII tab or newline"
			}
			- " and a U+003C\n  (<), and it does not start with a U+005F (_). (Names starting with a U+005F (_) are reserved\n  for special keywords.)"
		}
		- "\n\n  "
		p id="valid-browsing-context-name-or-keyword" {
			- "A "
			dfn id="valid-navigable-target-name-or-keyword" {
				- "valid navigable target name or\n  keyword"
			}
			- " is any string that is either a "
			a href="#valid-navigable-target-name" id="navigable-target-names:valid-navigable-target-name" {
				- "valid navigable target name"
			}
			- " or that is\n  an "
			a id="navigable-target-names:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII case-insensitive"
			}
			- " match for one of: "
			code {
				- "_blank"
			}
			- ", "
			code {
				- "_self"
			}
			- ", "
			code {
				- "_parent"
			}
			- ", or "
			code {
				- "_top"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "These values have different meanings based on whether the page is sandboxed or not, as\n  summarized in the following (non-normative) table. In this table, \"current\" means the\n  "
			a href="#navigable" id="navigable-target-names:navigable-2" {
				- "navigable"
			}
			- " that the link or script is in, \"parent\" means the "
			a href="#nav-parent" id="navigable-target-names:nav-parent" {
				- "parent"
			}
			- " of the "
			a href="#navigable" id="navigable-target-names:navigable-3" {
				- "navigable"
			}
			- " that the link or script is in,\n  \"top\" means the "
			a href="#nav-top" id="navigable-target-names:nav-top" {
				- "top-level traversable"
			}
			- " of the "
			a href="#navigable" id="navigable-target-names:navigable-4" {
				- "navigable"
			}
			- "\n  that the link or script is in, \"new\" means a new "
			a href="#traversable-navigable" id="navigable-target-names:traversable-navigable" {
				- "traversable navigable"
			}
			- " with a null\n  "
			a href="#nav-parent" id="navigable-target-names:nav-parent-2" {
				- "parent"
			}
			- " (which may use an "
			a href="#auxiliary-browsing-context" id="navigable-target-names:auxiliary-browsing-context" {
				- "auxiliary browsing\n  context"
			}
			- ", subject to various user preferences and user agent policies), \"none\" means that\n  nothing will happen, and \"maybe new\" means the same as \"new\" if the \""
			code id="navigable-target-names:attr-iframe-sandbox-allow-popups" {
				a href="#attr-iframe-sandbox-allow-popups" {
					- "allow-popups"
				}
			}
			- "\" keyword is also specified on the\n  "
			code id="navigable-target-names:attr-iframe-sandbox" {
				a href="#attr-iframe-sandbox" {
					- "sandbox"
				}
			}
			- " attribute (or if the user overrode the\n  sandboxing), and the same as \"none\" otherwise."
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th rowspan="2" {
						- "Keyword\n     "
					}
					th rowspan="2" {
						- "Ordinary effect\n     "
					}
					th colspan="2" {
						- "Effect in an "
						code id="navigable-target-names:the-iframe-element" {
							a href="#the-iframe-element" {
								- "iframe"
							}
						}
						- " with...\n    "
					}
				}
				tr {
					th {
						code {
							- "sandbox=\"\""
						}
						- "\n     "
					}
					th {
						code {
							- "sandbox=\"allow-top-navigation\""
						}
						- "\n\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "none specified, for links and form submissions \n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						- "empty string\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_blank"
						}
						- "\n     "
					}
					td {
						- "new\n     "
					}
					td {
						- "maybe new\n     "
					}
					td {
						- "maybe new\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_self"
						}
						- "\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_parent"
						}
						- " if there isn't a parent\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_parent"
						}
						- " if parent is also top\n     "
					}
					td {
						- "parent/top\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "parent/top\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_parent"
						}
						- " if there is one and it's not top\n     "
					}
					td {
						- "parent\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "none\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_top"
						}
						- " if top is current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						code {
							- "_top"
						}
						- " if top is not current\n     "
					}
					td {
						- "top\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "top\n\n    "
					}
				}
				tr {
					td {
						- "name that doesn't exist\n     "
					}
					td {
						- "new\n     "
					}
					td {
						- "maybe new\n     "
					}
					td {
						- "maybe new\n\n    "
					}
				}
				tr {
					td {
						- "name that exists and is a descendant\n     "
					}
					td {
						- "specified descendant\n     "
					}
					td {
						- "specified descendant\n     "
					}
					td {
						- "specified descendant\n\n    "
					}
				}
				tr {
					td {
						- "name that exists and is current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n     "
					}
					td {
						- "current\n\n    "
					}
				}
				tr {
					td {
						- "name that exists and is an ancestor that is top\n     "
					}
					td {
						- "specified ancestor\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "specified ancestor/top\n\n    "
					}
				}
				tr {
					td {
						- "name that exists and is an ancestor that is not top\n     "
					}
					td {
						- "specified ancestor\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "none\n\n    "
					}
				}
				tr {
					td {
						- "other name that exists with common top\n     "
					}
					td {
						- "specified\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "none\n\n    "
					}
				}
				tr {
					td {
						- "name that exists with different top, if "
						a href="#familiar-with" id="navigable-target-names:familiar-with" {
							- "familiar"
						}
						- " and "
						a href="#one-permitted-sandboxed-navigator" id="navigable-target-names:one-permitted-sandboxed-navigator" {
							- "one permitted sandboxed navigator"
						}
						- "\n     "
					}
					td {
						- "specified\n     "
					}
					td {
						- "specified\n     "
					}
					td {
						- "specified\n\n    "
					}
				}
				tr {
					td {
						- "name that exists with different top, if "
						a href="#familiar-with" id="navigable-target-names:familiar-with-2" {
							- "familiar"
						}
						- " but not "
						a href="#one-permitted-sandboxed-navigator" id="navigable-target-names:one-permitted-sandboxed-navigator-2" {
							- "one permitted sandboxed navigator"
						}
						- "\n     "
					}
					td {
						- "specified\n     "
					}
					td {
						- "none\n     "
					}
					td {
						- "none\n\n    "
					}
				}
				tr {
					td {
						- "name that exists with different top, not "
						a href="#familiar-with" id="navigable-target-names:familiar-with-3" {
							- "familiar"
						}
						- "\n     "
					}
					td {
						- "new\n     "
					}
					td {
						- "maybe new\n     "
					}
					td {
						- "maybe new\n\n  "
					}
				}
			}
		}
		- "\n\n  "
		p class="tablenote" {
			small {
				- "Most of the restrictions on sandboxed browsing contexts are applied by\n  other algorithms, e.g. the "
				a href="#navigate" id="navigable-target-names:navigate-2" {
					- "navigation"
				}
				- " algorithm, not "
				a href="#the-rules-for-choosing-a-navigable" id="navigable-target-names:the-rules-for-choosing-a-navigable" {
					- "the\n  rules for choosing a navigable"
				}
				- " given below."
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "To "
			dfn id="find-a-navigable-by-target-name" {
				- "find a navigable by target name"
			}
			- " given a string "
			var {
				- "name"
			}
			- " and a\n  "
			a href="#navigable" id="navigable-target-names:navigable-5" {
				- "navigable"
			}
			- " "
			var {
				- "currentNavigable"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "currentDocument"
					}
					- " be "
					var {
						- "currentNavigable"
					}
					- "'s "
					a href="#nav-document" id="navigable-target-names:nav-document" {
						- "active document"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "sourceSnapshotParams"
					}
					- " be the result of "
					a href="#snapshotting-source-snapshot-params" id="navigable-target-names:snapshotting-source-snapshot-params" {
						- "snapshotting source snapshot\n   params"
					}
					- " given "
					var {
						- "currentDocument"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "subtreesToSearch"
					}
					- " be an "
					a id="navigable-target-names:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- " choice of one of\n    the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "« "
							var {
								- "currentNavigable"
							}
							- "'s "
							a href="#nav-traversable" id="navigable-target-names:nav-traversable" {
								- "traversable\n     navigable"
							}
							- ", "
							var {
								- "currentNavigable"
							}
							- " »"
						}
					}
					li {
						p {
							- "the "
							a href="#inclusive-ancestor-navigables" id="navigable-target-names:inclusive-ancestor-navigables" {
								- "inclusive ancestor navigables"
							}
							- " of "
							var {
								- "currentDocument"
							}
						}
					}
				}
				- "\n\n    "
				p class="XXX" {
					a href="https://github.com/whatwg/html/issues/10848" {
						- "Issue #10848"
					}
					- " tracks\n    settling on one of these two possibilities, to achieve interoperability."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					a href="https://infra.spec.whatwg.org/#list-iterate" id="navigable-target-names:list-iterate" data-x-internal="list-iterate" {
						- "For each"
					}
					- " "
					var {
						- "subtreeToSearch"
					}
					- " of\n    "
					var {
						- "subtreesToSearch"
					}
					- ", in reverse order:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "documentToSearch"
							}
							- " be "
							var {
								- "subtreeToSearch"
							}
							- "'s "
							a href="#nav-document" id="navigable-target-names:nav-document-2" {
								- "active document"
							}
							- "."
