		- "\n\n  \n\n  "
		p {
			- " "
			img class="extra" width="276" src="/images/sample-progress.png" height="115" alt=""
			- " When the this\n  element has a "
			a href="#horizontal-writing-mode" id="the-progress-element-2:horizontal-writing-mode" {
				- "horizontal writing mode"
			}
			- ", the element is expected to be depicted as a\n  horizontal progress bar. The start is on the right and the end is on the left if the\n  "
			a id="the-progress-element-2:'direction'" href="https://drafts.csswg.org/css-writing-modes/#direction" data-x-internal="'direction'" {
				- "'direction'"
			}
			- " property on this element has a "
			a id="the-progress-element-2:computed-value" href="https://drafts.csswg.org/css-cascade/#computed-value" data-x-internal="computed-value" {
				- "computed value"
			}
			- " of 'rtl', and\n  with the start on the left and the end on the right otherwise. When this element has a\n  "
			a href="#vertical-writing-mode" id="the-progress-element-2:vertical-writing-mode" {
				- "vertical writing mode"
			}
			- ", it is expected to be depicted as a vertical progress bar. The\n  start is on the bottom and the end is on the top if the "
			a id="the-progress-element-2:'direction'-2" href="https://drafts.csswg.org/css-writing-modes/#direction" data-x-internal="'direction'" {
				- "'direction'"
			}
			- " property on this\n  element has a "
