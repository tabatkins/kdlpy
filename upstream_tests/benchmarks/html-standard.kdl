					code class="idl" {
						- "["
						c- g="" {
							- "Exposed"
						}
						- "="
						c- n="" {
							- "Window"
						}
						- "]\n"
						c- b="" {
							- "interface"
						}
						- " "
						dfn id="htmlmetaelement" data-dfn-type="interface" {
							c- g="" {
								- "HTMLMetaElement"
							}
						}
						- " : "
						a href="#htmlelement" id="the-meta-element:htmlelement" {
							c- n="" {
								- "HTMLElement"
							}
						}
						- " {\n  ["
						a href="#htmlconstructor" id="the-meta-element:htmlconstructor" {
							c- g="" {
								- "HTMLConstructor"
							}
						}
						- "] "
						c- g="" {
							- "constructor"
						}
						- "();\n\n  ["
						a href="#cereactions" id="the-meta-element:cereactions" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-meta-name" id="the-meta-element:dom-meta-name" {
							c- g="" {
								- "name"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-meta-element:cereactions-2" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-meta-httpequiv" id="the-meta-element:dom-meta-httpequiv" {
							c- g="" {
								- "httpEquiv"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-meta-element:cereactions-3" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-meta-content" id="the-meta-element:dom-meta-content" {
							c- g="" {
								- "content"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-meta-element:cereactions-4" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-meta-media" id="the-meta-element:dom-meta-media" {
							c- g="" {
								- "media"
							}
						}
						- ";\n\n  // "
						a href="#HTMLMetaElement-partial" {
							- "also has obsolete members"
						}
						- "\n};"
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-meta-element:the-meta-element" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element "
			a href="#represents" id="the-meta-element:represents" {
				- "represents"
			}
			- " various kinds of metadata that cannot be\n  expressed using the "
			code id="the-meta-element:the-title-element" {
				a href="#the-title-element" {
					- "title"
				}
			}
			- ", "
			code id="the-meta-element:the-base-element" {
				a href="#the-base-element" {
					- "base"
				}
			}
			- ", "
			code id="the-meta-element:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ", "
			code id="the-meta-element:the-style-element" {
				a href="#the-style-element" {
					- "style"
				}
			}
			- ",\n  and "
			code id="the-meta-element:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-meta-element:the-meta-element-2" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element can represent document-level metadata with the "
			code id="the-meta-element:attr-meta-name-3" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- " attribute, pragma directives with the "
			code id="the-meta-element:attr-meta-http-equiv-5" {
				a href="#attr-meta-http-equiv" {
					- "http-equiv"
				}
			}
			- " attribute, and the file's "
			a href="#character-encoding-declaration" id="the-meta-element:character-encoding-declaration-2" {
				- "character encoding\n  declaration"
			}
			- " when an HTML document is serialized to string form (e.g. for transmission over\n  the network or for disk storage) with the "
			code id="the-meta-element:attr-meta-charset-3" {
				a href="#attr-meta-charset" {
					- "charset"
				}
			}
			- "\n  attribute."
		}
		- "\n\n  "
		p {
			- "Exactly one of the "
			code id="the-meta-element:attr-meta-name-4" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- ", "
			code id="the-meta-element:attr-meta-http-equiv-6" {
				a href="#attr-meta-http-equiv" {
					- "http-equiv"
				}
			}
			- ", "
			code id="the-meta-element:attr-meta-charset-4" {
				a href="#attr-meta-charset" {
					- "charset"
				}
			}
			- ",\n  and "
			code id="the-meta-element:names:-the-itemprop-attribute-5" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attributes must be specified."
		}
		- "\n\n  "
		p {
			- "If either "
			code id="the-meta-element:attr-meta-name-5" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- ", "
			code id="the-meta-element:attr-meta-http-equiv-7" {
				a href="#attr-meta-http-equiv" {
					- "http-equiv"
				}
			}
			- ", or "
			code id="the-meta-element:names:-the-itemprop-attribute-6" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " is\n  specified, then the "
			code id="the-meta-element:attr-meta-content-2" {
				a href="#attr-meta-content" {
					- "content"
				}
			}
			- " attribute must also be\n  specified. Otherwise, it must be omitted."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="meta" id="attr-meta-charset" data-dfn-type="element-attr" {
				code {
					- "charset"
				}
			}
			- "\n  attribute specifies the "
			a href="https://encoding.spec.whatwg.org/#encoding" id="the-meta-element:encoding" data-x-internal="encoding" {
				- "character encoding"
			}
			- " used by the document.\n  This is a "
			a href="#character-encoding-declaration" id="the-meta-element:character-encoding-declaration-3" {
				- "character encoding declaration"
			}
			- ". If the attribute is present, its value must\n  be an "
			a id="the-meta-element:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII case-insensitive"
			}
			- " match for the string \""
			code {
				- "utf-8"
			}
			- "\"."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			code id="the-meta-element:attr-meta-charset-5" {
				a href="#attr-meta-charset" {
					- "charset"
				}
			}
			- " attribute on the\n  "
			code id="the-meta-element:the-meta-element-3" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element has no effect in XML documents, but is allowed in XML documents in order\n  to facilitate migration to and from XML."
		}
		- "\n\n  "
		p {
			- "There must not be more than one "
			code id="the-meta-element:the-meta-element-4" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element with a "
			code id="the-meta-element:attr-meta-charset-6" {
				a href="#attr-meta-charset" {
					- "charset"
				}
			}
			- " attribute per document."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="meta" id="attr-meta-content" data-dfn-type="element-attr" {
				code {
					- "content"
				}
			}
			- "\n  attribute gives the value of the document metadata or pragma directive when the element is used\n  for those purposes. The allowed values depend on the exact context, as described in subsequent\n  sections of this specification."
		}
		- "\n\n  "
		p {
			- "If a "
			code id="the-meta-element:the-meta-element-5" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element has a "
			dfn data-dfn-for="meta" id="attr-meta-name" data-dfn-type="element-attr" {
				code {
					- "name"
				}
			}
			- " attribute, it sets document metadata. Document metadata\n  is expressed in terms of name-value pairs, the "
			code id="the-meta-element:attr-meta-name-6" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- " attribute\n  on the "
			code id="the-meta-element:the-meta-element-6" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element giving the name, and the "
			code id="the-meta-element:attr-meta-content-3" {
				a href="#attr-meta-content" {
					- "content"
				}
			}
			- " attribute on the same element giving the value. The name\n  specifies what aspect of metadata is being set; valid names and the meaning of their values are\n  described in the following sections. If a "
			code id="the-meta-element:the-meta-element-7" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element has no "
			code id="the-meta-element:attr-meta-content-4" {
				a href="#attr-meta-content" {
					- "content"
				}
			}
			- " attribute, then the value part of the metadata\n  name-value pair is the empty string."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="meta" id="attr-meta-media" data-dfn-type="element-attr" {
				code {
					- "media"
				}
			}
			- " attribute\n  says which media the metadata applies to. The value must be a "
			a href="#valid-media-query-list" id="the-meta-element:valid-media-query-list" {
				- "valid media query list"
			}
			- ".\n  Unless the "
			code id="the-meta-element:attr-meta-name-7" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- " is "
			code id="the-meta-element:meta-theme-color" {
				a href="#meta-theme-color" {
					- "theme-color"
				}
			}
			- ", the "
			code id="the-meta-element:attr-meta-media-2" {
				a href="#attr-meta-media" {
					- "media"
				}
			}
			- "\n  attribute has no effect on the processing model and must not be used by authors."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMetaElement" id="dom-meta-name" data-dfn-type="attribute" {
				code {
					- "name"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLMetaElement" id="dom-meta-content" data-dfn-type="attribute" {
				code {
					- "content"
				}
			}
			- ", and "
			dfn data-dfn-for="HTMLMetaElement" id="dom-meta-media" data-dfn-type="attribute" {
				code {
					- "media"
				}
			}
			- " IDL attributes\n  must "
			a href="#reflect" id="the-meta-element:reflect" {
				- "reflect"
			}
			- " the respective content attributes of the same name. The IDL attribute\n  "
			dfn data-dfn-for="HTMLMetaElement" id="dom-meta-httpequiv" data-dfn-type="attribute" {
				code {
					- "httpEquiv"
				}
			}
			- " must\n  "
			a href="#reflect" id="the-meta-element:reflect-2" {
				- "reflect"
			}
			- " the content attribute "
			code id="the-meta-element:attr-meta-http-equiv-8" {
				a href="#attr-meta-http-equiv" {
					- "http-equiv"
				}
			}
			- "."
		}
		- "\n\n  \n\n\n  "
		h5 id="standard-metadata-names" {
			span class="secno" {
				- "4.2.5.1"
			}
			- " Standard metadata names"
			a href="#standard-metadata-names" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/meta/name" title="The <meta> element can be used to provide document metadata in terms of name-value pairs, with the name attribute giving the metadata name, and the content attribute giving the value." {
						- "Element/meta/name"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "6+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "This specification defines a few names for the "
			code id="standard-metadata-names:attr-meta-name" {
				a href="#attr-meta-name" {
					- "name"
				}
			}
			- "\n  attribute of the "
			code id="standard-metadata-names:the-meta-element" {
				a href="#the-meta-element" {
					- "meta"
				}
			}
			- " element."
		}
		- "\n\n  "
		p {
			- "Names are case-insensitive"
			span class="impl" {
				- ", and must be compared in an "
				a id="standard-metadata-names:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
					- "ASCII\n  case-insensitive"
				}
				- " manner"
			}
			- "."
		}
		- "\n\n  "
		dl {
			dt {
				dfn data-dfn-for="meta/name" id="meta-application-name" data-dfn-type="attr-value" {
					code {
						- "application-name"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "The value must be a short free-form string giving the name of the web application that the\n    page represents. If the page is not a web application, the "
					code id="standard-metadata-names:meta-application-name" {
						a href="#meta-application-name" {
							- "application-name"
						}
					}
					- " metadata name must not be used.\n    Translations of the web application's name may be given, using the "
					code id="standard-metadata-names:attr-lang" {
						a href="#attr-lang" {
							- "lang"
						}
					}
					- " attribute to specify the language of each name."
				}
				- "\n\n    "
				p {
					- "There must not be more than one "
					code id="standard-metadata-names:the-meta-element-2" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element with a given "
					a href="#language" id="standard-metadata-names:language" {
						- "language"
					}
					- "\n    and where the "
					code id="standard-metadata-names:attr-meta-name-2" {
						a href="#attr-meta-name" {
							- "name"
						}
					}
					- " attribute value is an\n    "
					a id="standard-metadata-names:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for\n    "
					code id="standard-metadata-names:meta-application-name-2" {
						a href="#meta-application-name" {
							- "application-name"
						}
					}
					- " per document."
				}
				- "\n\n    \n\n    "
				p {
					- "User agents may use the application name in UI in preference to the page's\n    "
					code id="standard-metadata-names:the-title-element" {
						a href="#the-title-element" {
							- "title"
						}
					}
					- ", since the title might include status messages and the like relevant to the\n    status of the page at a particular moment in time instead of just being the name of the\n    application."
				}
				- "\n\n    "
				p {
					- "To find the application name to use given an ordered list of languages (e.g. British English,\n    American English, and English), user agents must run the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "languages"
							}
							- " be the list of languages."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "default language"
							}
							- " be the "
							a href="#language" id="standard-metadata-names:language-2" {
								- "language"
							}
							- " of the\n     "
							code id="standard-metadata-names:document" {
								a href="#document" {
									- "Document"
								}
							}
							- "'s "
							a id="standard-metadata-names:document-element" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
								- "document element"
							}
							- ", if any, and if that language is not\n     unknown."
						}
						- "\n\n     "
					}
					li {
						p {
							- "If there is a "
							var {
								- "default language"
							}
							- ", and if it is not the same language\n     as any of the languages in "
							var {
								- "languages"
							}
							- ", append it to "
							var {
								- "languages"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "winning language"
							}
							- " be the first language in "
							var {
								- "languages"
							}
							- " for which\n      there is a "
							code id="standard-metadata-names:the-meta-element-3" {
								a href="#the-meta-element" {
									- "meta"
								}
							}
							- " element in the "
							code id="standard-metadata-names:document-2" {
								a href="#document" {
									- "Document"
								}
							}
							- " where the\n      "
							code id="standard-metadata-names:attr-meta-name-3" {
								a href="#attr-meta-name" {
									- "name"
								}
							}
							- " attribute value is an\n      "
							a id="standard-metadata-names:ascii-case-insensitive-3" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
								- "ASCII case-insensitive"
							}
							- " match for\n      "
							code id="standard-metadata-names:meta-application-name-3" {
								a href="#meta-application-name" {
									- "application-name"
								}
							}
							- " and whose\n      "
							a href="#language" id="standard-metadata-names:language-3" {
								- "language"
							}
							- " is the language in question."
						}
						- "\n\n      "
						p {
							- "If none of the languages have such a "
							code id="standard-metadata-names:the-meta-element-4" {
								a href="#the-meta-element" {
									- "meta"
								}
							}
							- " element, then return;\n      there's no given application name."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Return the value of the "
							code id="standard-metadata-names:attr-meta-content" {
								a href="#attr-meta-content" {
									- "content"
								}
							}
							- " attribute of the\n      first "
							code id="standard-metadata-names:the-meta-element-5" {
								a href="#the-meta-element" {
									- "meta"
								}
							}
							- " element in the "
							code id="standard-metadata-names:document-3" {
								a href="#document" {
									- "Document"
								}
							}
							- " in "
							a id="standard-metadata-names:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
								- "tree order"
							}
							- " where the\n      "
							code id="standard-metadata-names:attr-meta-name-4" {
								a href="#attr-meta-name" {
									- "name"
								}
							}
							- " attribute value is an\n      "
							a id="standard-metadata-names:ascii-case-insensitive-4" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
								- "ASCII case-insensitive"
							}
							- " match for "
							code id="standard-metadata-names:meta-application-name-4" {
								a href="#meta-application-name" {
									- "application-name"
								}
							}
							- "\n      and whose "
							a href="#language" id="standard-metadata-names:language-4" {
								- "language"
							}
							- " is "
							var {
								- "winning language"
							}
							- "."
						}
						- "\n     "
					}
				}
				- "\n\n    "
				p class="note" {
					- "This algorithm would be used by a browser when it needs a name for the page, for\n    instance, to label a bookmark. The languages it would provide to the algorithm would be the\n    user's preferred languages."
				}
				- "\n\n    \n   "
			}
			dt {
				dfn data-dfn-for="meta/name" id="meta-author" data-dfn-type="attr-value" {
					code {
						- "author"
					}
				}
			}
			dd {
				p {
					- "The value must be a free-form string giving the name of one of the page's\n   authors."
				}
			}
			dt {
				dfn data-dfn-for="meta/name" id="meta-description" data-dfn-type="attr-value" {
					code {
						- "description"
					}
				}
			}
			dd {
				p {
					- "The value must be a free-form string that describes the page. The value must be\n   appropriate for use in a directory of pages, e.g. in a search engine. There must not be more than\n   one "
					code id="standard-metadata-names:the-meta-element-6" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element where the "
					code id="standard-metadata-names:attr-meta-name-5" {
						a href="#attr-meta-name" {
							- "name"
						}
					}
					- " attribute value\n   is an "
					a id="standard-metadata-names:ascii-case-insensitive-5" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for\n   "
					code id="standard-metadata-names:meta-description" {
						a href="#meta-description" {
							- "description"
						}
					}
					- " per document."
				}
			}
			dt {
				dfn data-dfn-for="meta/name" id="meta-generator" data-dfn-type="attr-value" {
					code {
						- "generator"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "The value must be a free-form string that identifies one of the software packages used to\n    generate the document. This value must not be used on pages whose markup is not generated by\n    software, e.g. pages whose markup was written by a user in a text editor."
