						tr {
							td {
								- "0x8E "
							}
							td {
								- "0x017D "
							}
							td {
								- "LATIN CAPITAL LETTER Z WITH CARON (Ž)\n      \n      \n      "
							}
						}
						tr {
							td {
								- "0x91 "
							}
							td {
								- "0x2018 "
							}
							td {
								- "LEFT SINGLE QUOTATION MARK (‘)\n      "
							}
						}
						tr {
							td {
								- "0x92 "
							}
							td {
								- "0x2019 "
							}
							td {
								- "RIGHT SINGLE QUOTATION MARK (’)\n      "
							}
						}
						tr {
							td {
								- "0x93 "
							}
							td {
								- "0x201C "
							}
							td {
								- "LEFT DOUBLE QUOTATION MARK (“)\n      "
							}
						}
						tr {
							td {
								- "0x94 "
							}
							td {
								- "0x201D "
							}
							td {
								- "RIGHT DOUBLE QUOTATION MARK (”)\n      "
							}
