						- "String replace all"
					}
					- " with the given value within "
					a id="the-output-element:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLOutputElement" id="dom-output-defaultvalue" data-dfn-type="attribute" {
				code {
					- "defaultValue"
				}
			}
			- " getter steps are to return the result\n  of running "
			a id="the-output-element:this-4" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
