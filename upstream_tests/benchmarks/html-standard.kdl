						- "ASCII case-insensitive"
					}
					- "\n    match for the string \""
					dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" id="attr-fe-autocomplete-section" data-dfn-type="attr-value" {
