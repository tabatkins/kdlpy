					li {
						p {
							- "Perform "
							a id="hostloadimportedmodule:finishloadingimportedmodule-6" href="https://tc39.es/ecma262/#sec-FinishLoadingImportedModule" data-x-internal="finishloadingimportedmodule" {
								- "FinishLoadingImportedModule"
							}
							- "("
							var {
								- "referrer"
							}
							- ",\n     "
							var {
								- "moduleRequest"
							}
							- ", "
							var {
								- "payload"
							}
							- ", "
							var {
								- "completion"
							}
							- ")."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		h4 id="event-loops" {
			span class="secno" {
				- "8.1.7"
			}
			- " Event loops"
			a href="#event-loops" class="self-link"
		}
		- "\n\n  "
		h5 id="definitions-3" {
			span class="secno" {
				- "8.1.7.1"
			}
			- " Definitions"
			a href="#definitions-3" class="self-link"
		}
		- "\n\n  "
		p {
			- "To coordinate events, user interaction, scripts, rendering, networking, and so forth, user\n  agents must use "
			dfn id="event-loop" data-lt="event loop" data-export="" {
				- "event loops"
			}
			- " as\n  described in this section. Each "
			a id="definitions-3:agent" href="https://tc39.es/ecma262/#sec-agents" data-x-internal="agent" {
				- "agent"
			}
			- " has an associated "
			dfn data-dfn-for="agent" id="concept-agent-event-loop" data-export="" {
				- "event loop"
			}
			- ", which is unique to that agent."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-agent-event-loop" id="definitions-3:concept-agent-event-loop" {
				- "event loop"
			}
			- " of a "
			a href="#similar-origin-window-agent" id="definitions-3:similar-origin-window-agent" {
				- "similar-origin window\n  agent"
			}
			- " is known as a "
			dfn id="window-event-loop" {
				- "window event loop"
			}
			- ". The "
			a href="#concept-agent-event-loop" id="definitions-3:concept-agent-event-loop-2" {
				- "event loop"
			}
			- " of a "
			a href="#dedicated-worker-agent" id="definitions-3:dedicated-worker-agent" {
				- "dedicated worker agent"
			}
			- ",\n  "
			a href="#shared-worker-agent" id="definitions-3:shared-worker-agent" {
				- "shared worker agent"
			}
			- ", or "
			a href="#service-worker-agent" id="definitions-3:service-worker-agent" {
				- "service worker agent"
			}
			- " is known as a "
			dfn id="worker-event-loop-2" {
				- "worker\n  event loop"
			}
			- ". And the "
			a href="#concept-agent-event-loop" id="definitions-3:concept-agent-event-loop-3" {
				- "event loop"
			}
			- " of a\n  "
			a href="#worklet-agent" id="definitions-3:worklet-agent" {
				- "worklet agent"
			}
			- " is known as a "
			dfn id="worklet-event-loop" {
				- "worklet event loop"
			}
			- "."
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				a href="#event-loop" id="definitions-3:event-loop" {
					- "Event loops"
				}
				- " do not necessarily correspond to implementation\n   threads. For example, multiple "
				a href="#window-event-loop" id="definitions-3:window-event-loop" {
					- "window event loops"
				}
				- " could\n   be cooperatively scheduled in a single thread."
			}
			- "\n\n   "
			p {
				- "However, for the various worker "
				a href="https://tc39.es/ecma262/#sec-agents" id="definitions-3:agent-2" data-x-internal="agent" {
					- "agents"
				}
				- " that are allocated with\n   [[CanBlock]] set to true, the JavaScript specification does place requirements on them regarding\n   "
				a id="definitions-3:forward-progress" href="https://tc39.es/ecma262/#sec-forward-progress" data-x-internal="forward-progress" {
					- "forward progress"
				}
				- ", which effectively amount to requiring dedicated per-agent threads\n   in those cases."
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "An "
			a href="#event-loop" id="definitions-3:event-loop-2" {
				- "event loop"
			}
			- " has one or more "
			dfn id="task-queue" {
				- "task queues"
			}
			- ". A\n  "
			a href="#task-queue" id="definitions-3:task-queue" {
				- "task queue"
			}
			- " is a "
			a id="definitions-3:set" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
				- "set"
			}
			- " of "
			a href="#concept-task" id="definitions-3:concept-task" {
				- "tasks"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			a href="#task-queue" id="definitions-3:task-queue-2" {
				- "Task queues"
			}
			- " are "
			a href="https://infra.spec.whatwg.org/#ordered-set" id="definitions-3:set-2" data-x-internal="set" {
				- "sets"
			}
			- ",\n  not "
			a href="https://infra.spec.whatwg.org/#queue" id="definitions-3:queue" data-x-internal="queue" {
				- "queues"
			}
			- ", because the "
			a href="#event-loop-processing-model" {
				- "event\n  loop processing model"
			}
			- " grabs the first "
			a href="#concept-task-runnable" id="definitions-3:concept-task-runnable" {
				em {
					- "runnable"
				}
			}
			- " "
			a href="#concept-task" id="definitions-3:concept-task-2" {
				- "task"
			}
			- "\n  from the chosen queue, instead of "
			a href="https://infra.spec.whatwg.org/#queue-dequeue" id="definitions-3:dequeue" data-x-internal="dequeue" {
				- "dequeuing"
			}
			- " the first task."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#microtask-queue" id="definitions-3:microtask-queue" {
				- "microtask queue"
			}
			- " is not a "
			a href="#task-queue" id="definitions-3:task-queue-3" {
				- "task queue"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Tasks encapsulate algorithms that are responsible for such work as:"
		}
		- "\n\n  "
		dl {
			dt {
				- "Events"
			}
			dd {
				- "\n    "
				p {
					- "Dispatching an "
					code id="definitions-3:event" {
						a data-x-internal="event" href="https://dom.spec.whatwg.org/#interface-event" {
							- "Event"
						}
					}
					- " object at a particular\n    "
					code id="definitions-3:eventtarget" {
						a data-x-internal="eventtarget" href="https://dom.spec.whatwg.org/#interface-eventtarget" {
							- "EventTarget"
						}
					}
					- " object is often done by a dedicated task."
				}
				- "\n\n    "
				p class="note" {
					- "Not all events are dispatched using the "
					a href="#task-queue" id="definitions-3:task-queue-4" {
						- "task queue"
					}
					- "; many are\n    dispatched during other tasks."
				}
				- "\n   "
			}
			dt {
				- "Parsing"
			}
			dd {
				p {
					- "The "
					a href="#html-parser" id="definitions-3:html-parser" {
						- "HTML parser"
					}
					- " tokenizing one or more bytes, and then processing any\n   resulting tokens, is typically a task."
				}
			}
			dt {
				- "Callbacks"
			}
			dd {
				p {
					- "Calling a callback is often done by a dedicated task."
				}
			}
			dt {
				- "Using a resource"
			}
			dd {
				p {
					- "When an algorithm "
					a href="https://fetch.spec.whatwg.org/#concept-fetch" id="definitions-3:concept-fetch" data-x-internal="concept-fetch" {
						- "fetches"
					}
					- " a resource, if the fetching\n   occurs in a non-blocking fashion then the processing of the resource once some or all of the\n   resource is available is performed by a task."
				}
			}
			dt {
				- "Reacting to DOM manipulation"
			}
			dd {
				p {
					- "Some elements have tasks that trigger in response to DOM manipulation, e.g. when that\n   element is "
					a href="#insert-an-element-into-a-document" id="definitions-3:insert-an-element-into-a-document" {
						- "inserted into the document"
					}
					- "."
				}
				- "\n  "
			}
		}
		- "\n\n  "
		p {
			- "Formally, a "
			dfn id="concept-task" data-lt="task" data-export="" {
				- "task"
			}
			- " is a\n  "
			a id="definitions-3:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " which has:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="concept-task-steps" {
					- "Steps"
				}
			}
			dd {
				- "A series of steps specifying the work to be done by the task."
			}
			dt {
				- "A "
				dfn id="concept-task-source" {
					- "source"
				}
			}
			dd {
				- "One of the "
				a href="#task-source" id="definitions-3:task-source" {
					- "task sources"
				}
				- ", used to group and serialize\n   related tasks."
			}
			dt {
				- "A "
				dfn id="concept-task-document" {
					- "document"
				}
			}
			dd {
				- "A "
				code id="definitions-3:document" {
					a href="#document" {
						- "Document"
					}
				}
				- " associated with the task, or null for tasks that are not in a\n   "
				a href="#window-event-loop" id="definitions-3:window-event-loop-2" {
					- "window event loop"
				}
				- "."
			}
			dt {
				- "A "
				dfn id="script-evaluation-environment-settings-object-set" data-export="" {
					- "script evaluation environment settings object set"
				}
			}
			dd {
				- "A "
				a id="definitions-3:set-3" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
					- "set"
				}
				- " of "
				a href="#environment-settings-object" id="definitions-3:environment-settings-object" {
					- "environment settings\n   objects"
				}
				- " used for tracking script evaluation during the task."
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#concept-task" id="definitions-3:concept-task-3" {
				- "task"
			}
			- " is "
			dfn id="concept-task-runnable" {
				- "runnable"
			}
			- "\n  if its "
			a href="#concept-task-document" id="definitions-3:concept-task-document" {
				- "document"
			}
			- " is either null or "
			a href="#fully-active" id="definitions-3:fully-active" {
				- "fully\n  active"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Per its "
			a href="#concept-task-source" id="definitions-3:concept-task-source" {
				- "source"
			}
			- " field, each "
			a href="#concept-task" id="definitions-3:concept-task-4" {
				- "task"
			}
			- " is defined as coming from a specific "
			dfn id="task-source" data-export="" {
				- "task\n  source"
			}
			- ". For each "
			a href="#event-loop" id="definitions-3:event-loop-3" {
				- "event loop"
			}
			- ", every "
			a href="#task-source" id="definitions-3:task-source-2" {
				- "task source"
			}
			- " must be associated\n  with a specific "
			a href="#task-queue" id="definitions-3:task-queue-5" {
				- "task queue"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "Essentially, "
			a href="#task-source" id="definitions-3:task-source-3" {
				- "task sources"
			}
			- " are used within\n  standards to separate logically-different types of tasks, which a user agent might wish to\n  distinguish between. "
			a href="#task-queue" id="definitions-3:task-queue-6" {
				- "Task queues"
			}
			- " are used by user agents to\n  coalesce task sources within a given "
			a href="#event-loop" id="definitions-3:event-loop-4" {
				- "event loop"
			}
			- "."
		}
		- "\n\n  "
		p class="example" {
			- "For example, a user agent could have one "
			a href="#task-queue" id="definitions-3:task-queue-7" {
				- "task queue"
			}
			- " for mouse and\n  key events (to which the "
			a href="#user-interaction-task-source" id="definitions-3:user-interaction-task-source" {
				- "user interaction task source"
			}
			- " is associated), and another to\n  which all other "
			a href="#task-source" id="definitions-3:task-source-4" {
				- "task sources"
			}
			- " are associated. Then, using the\n  freedom granted in the initial step of the "
			a href="#event-loop-processing-model" {
				- "event loop\n  processing model"
			}
			- ", it could give keyboard and mouse events preference over other tasks\n  three-quarters of the time, keeping the interface responsive but not starving other task queues.\n  Note that in this setup, the processing model still enforces that the user agent would never\n  process events from any one "
			a href="#task-source" id="definitions-3:task-source-5" {
				- "task source"
			}
			- " out of order."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			a href="#event-loop" id="definitions-3:event-loop-5" {
				- "event loop"
			}
			- " has a "
			dfn id="currently-running-task" {
				- "currently running task"
			}
			- ", which is either a "
			a href="#concept-task" id="definitions-3:concept-task-5" {
				- "task"
			}
			- " or null. Initially, this is null. It is used to handle\n  reentrancy."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#event-loop" id="definitions-3:event-loop-6" {
				- "event loop"
			}
			- " has a "
			dfn id="microtask-queue" {
				- "microtask queue"
			}
			- ", which is a "
			a id="definitions-3:queue-2" href="https://infra.spec.whatwg.org/#queue" data-x-internal="queue" {
				- "queue"
			}
			- " of\n  "
			a href="#microtask" id="definitions-3:microtask" {
				- "microtasks"
			}
			- ", initially empty. A "
			dfn id="microtask" data-export="" {
				- "microtask"
			}
			- " is a\n  colloquial way of referring to a "
			a href="#concept-task" id="definitions-3:concept-task-6" {
				- "task"
			}
			- " that was created via the\n  "
			a href="#queue-a-microtask" id="definitions-3:queue-a-microtask" {
				- "queue a microtask"
			}
			- " algorithm."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#event-loop" id="definitions-3:event-loop-7" {
				- "event loop"
			}
			- " has a "
			dfn id="performing-a-microtask-checkpoint" {
				- "performing a microtask checkpoint"
			}
			- " boolean,\n  which is initially false. It is used to prevent reentrant invocation of the "
			a href="#perform-a-microtask-checkpoint" id="definitions-3:perform-a-microtask-checkpoint" {
				- "perform a\n  microtask checkpoint"
			}
			- " algorithm."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#window-event-loop" id="definitions-3:window-event-loop-3" {
				- "window event loop"
			}
			- " has a "
			code id="definitions-3:domhighrestimestamp" {
				a data-x-internal="domhighrestimestamp" href="https://w3c.github.io/hr-time/#dom-domhighrestimestamp" {
					- "DOMHighResTimeStamp"
				}
			}
			- "\n  "
			dfn id="last-render-opportunity-time" {
				- "last render opportunity time"
			}
			- ", initially set to zero."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#window-event-loop" id="definitions-3:window-event-loop-4" {
				- "window event loop"
			}
			- " has a "
			code id="definitions-3:domhighrestimestamp-2" {
				a data-x-internal="domhighrestimestamp" href="https://w3c.github.io/hr-time/#dom-domhighrestimestamp" {
					- "DOMHighResTimeStamp"
				}
			}
			- "\n  "
			dfn id="last-idle-period-start-time" {
				- "last idle period start time"
			}
			- ", initially set to zero."
		}
		- "\n\n  "
		p {
			- "To get the "
			dfn id="same-loop-windows" {
				- "same-loop windows"
			}
			- " for a "
			a href="#window-event-loop" id="definitions-3:window-event-loop-5" {
				- "window event loop"
			}
			- " "
			var {
				- "loop"
			}
			- ",\n  return all "
			code id="definitions-3:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " objects whose "
			a href="#relevant-agent" id="definitions-3:relevant-agent" {
				- "relevant agent"
			}
			- "'s\n  "
			a href="#concept-agent-event-loop" id="definitions-3:concept-agent-event-loop-4" {
				- "event loop"
			}
			- " is "
			var {
				- "loop"
			}
			- "."
		}
		- "\n\n\n  "
		h5 id="queuing-tasks" {
			span class="secno" {
				- "8.1.7.2"
			}
			- " Queuing tasks"
			a href="#queuing-tasks" class="self-link"
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="queue-a-task" data-export="" {
				- "queue a task"
			}
			- " on a "
			a href="#task-source" id="queuing-tasks:task-source" {
				- "task source"
			}
			- " "
			var {
				- "source"
			}
			- ", which\n  performs a series of steps "
			var {
				- "steps"
			}
			- ", optionally given an event loop "
			var {
				- "event loop"
			}
			- "\n  and a document "
			var {
				- "document"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "event loop"
					}
					- " was not given, set "
					var {
						- "event loop"
					}
					- " to the "
					a href="#implied-event-loop" id="queuing-tasks:implied-event-loop" {
						- "implied\n   event loop"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- " was not given, set "
					var {
						- "document"
					}
					- " to the "
					a href="#implied-document" id="queuing-tasks:implied-document" {
						- "implied\n   document"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "task"
					}
					- " be a new "
					a href="#concept-task" id="queuing-tasks:concept-task" {
						- "task"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "task"
					}
					- "'s "
					a href="#concept-task-steps" id="queuing-tasks:concept-task-steps" {
						- "steps"
					}
					- " to\n   "
					var {
						- "steps"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "task"
					}
					- "'s "
					a href="#concept-task-source" id="queuing-tasks:concept-task-source" {
						- "source"
					}
					- " to\n   "
					var {
						- "source"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "task"
					}
					- "'s "
					a href="#concept-task-document" id="queuing-tasks:concept-task-document" {
						- "document"
					}
					- " to the\n   "
					var {
						- "document"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "task"
					}
					- "'s "
					a href="#script-evaluation-environment-settings-object-set" id="queuing-tasks:script-evaluation-environment-settings-object-set" {
						- "script evaluation environment settings object set"
					}
					- " to an\n   empty "
					a id="queuing-tasks:set" href="https://infra.spec.whatwg.org/#ordered-set" data-x-internal="set" {
						- "set"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "queue"
					}
					- " be the "
