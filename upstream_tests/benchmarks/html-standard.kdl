						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "11.3+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
