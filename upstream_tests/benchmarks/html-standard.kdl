					}
					- " is beyond the end of "
					var {
						- "input"
					}
					- " or the character at "
					var {
						- "position"
					}
					- " is neither a U+0054 LATIN CAPITAL LETTER T character (T) nor a U+0020\n    SPACE character, then set "
					var {
