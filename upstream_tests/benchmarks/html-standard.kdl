		- "\n\n\n\n  "
		h4 id="the-drag-data-store" {
			span class="secno" {
				- "6.11.2"
			}
			- " The drag data store"
			a href="#the-drag-data-store" class="self-link"
		}
		- "\n\n  "
		p {
			- "The data that underlies a drag-and-drop operation, known as the "
			dfn id="drag-data-store" {
				- "drag data store"
			}
			- ",\n  consists of the following information:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					dfn id="drag-data-store-item-list" {
						- "drag data store item list"
					}
					- ", which is a list of items representing the dragged\n   data, each consisting of the following information:"
				}
				- "\n\n    "
				dl {
					dt {
						dfn id="the-drag-data-item-kind" {
							- "The drag data item kind"
						}
					}
					dd {
						- "\n      "
						p {
							- "The kind of data:"
						}
						- "\n\n      "
						dl {
							dt {
								i {
									- "Text"
								}
							}
							dd {
								- "\n        "
								p {
									- "Text."
								}
								- "\n       "
							}
							dt {
								i {
									- "File"
								}
							}
							dd {
								- "\n        "
								p {
									- "Binary data with a filename."
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					dt {
						dfn id="the-drag-data-item-type-string" {
							- "The drag data item type string"
						}
					}
					dd {
						- "\n      "
						p {
							- "A Unicode string giving the type or format of the data, generally given by a "
							a id="the-drag-data-store:mime-type" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
								- "MIME\n      type"
							}
							- ". Some values that are not "
							a href="https://mimesniff.spec.whatwg.org/#mime-type" id="the-drag-data-store:mime-type-2" data-x-internal="mime-type" {
								- "MIME types"
							}
							- " are\n      special-cased for legacy reasons. The API does not enforce the use of "
							a href="https://mimesniff.spec.whatwg.org/#mime-type" id="the-drag-data-store:mime-type-3" data-x-internal="mime-type" {
								- "MIME types"
							}
							- "; other values can be used as well. In all cases, however, the values\n      are all "
							a id="the-drag-data-store:converted-to-ascii-lowercase" href="https://infra.spec.whatwg.org/#ascii-lowercase" data-x-internal="converted-to-ascii-lowercase" {
								- "converted to ASCII lowercase"
							}
							- " by the API."
						}
						- "\n\n      "
						p {
							- "There is a limit of one "
							i {
								- "text"
							}
							- " item per "
							a href="#the-drag-data-item-type-string" id="the-drag-data-store:the-drag-data-item-type-string" {
								- "item type string"
							}
							- "."
						}
						- " \n     "
					}
					dt {
						- "The actual data"
					}
					dd {
						p {
							- "A Unicode or binary string, in some cases with a filename (itself a Unicode string),\n      as per "
							a href="#the-drag-data-item-kind" id="the-drag-data-store:the-drag-data-item-kind" {
								- "the drag data item kind"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p {
					- "The "
					a href="#drag-data-store-item-list" id="the-drag-data-store:drag-data-store-item-list" {
						- "drag data store item list"
					}
					- " is ordered in the order that the items were added\n    to the list; most recently added last."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "The following information, used to generate the UI feedback during the drag:"
				}
				- "\n\n    "
				ul {
					li {
						- "User-agent-defined default feedback information, known as the "
						dfn id="drag-data-store-default-feedback" {
							- "drag data store default\n     feedback"
						}
						- "."
					}
					li {
						- "Optionally, a bitmap image and the coordinate of a point within that image, known as the\n     "
						dfn id="drag-data-store-bitmap" {
							- "drag data store bitmap"
						}
						- " and "
						dfn id="drag-data-store-hot-spot-coordinate" {
							- "drag data store hot spot coordinate"
						}
						- "."
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "A "
					dfn id="drag-data-store-mode" {
						- "drag data store mode"
					}
					- ", which is one of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						dfn id="concept-dnd-rw" {
							- "Read/write mode"
						}
					}
					dd {
						- "\n      "
						p {
							- "For the "
							code id="the-drag-data-store:event-dnd-dragstart" {
								a href="#event-dnd-dragstart" {
									- "dragstart"
								}
							}
							- " event. New data can be added to the\n      "
							a href="#drag-data-store" id="the-drag-data-store:drag-data-store" {
								- "drag data store"
							}
							- "."
						}
						- "\n     "
					}
					dt {
						dfn id="concept-dnd-ro" {
							- "Read-only mode"
						}
					}
					dd {
						- "\n      "
						p {
							- "For the "
							code id="the-drag-data-store:event-dnd-drop" {
								a href="#event-dnd-drop" {
									- "drop"
								}
							}
							- " event. The list of items representing dragged\n      data can be read, including the data. No new data can be added."
						}
						- "\n     "
					}
					dt {
						dfn id="concept-dnd-p" {
							- "Protected mode"
						}
					}
					dd {
						- "\n      "
						p {
							- "For all other events. The formats and kinds in the "
							a href="#drag-data-store" id="the-drag-data-store:drag-data-store-2" {
								- "drag data store"
							}
							- " list of\n      items representing dragged data can be enumerated, but the data itself is unavailable and no\n      new data can be added."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "A "
					dfn id="drag-data-store-allowed-effects-state" {
						- "drag data store allowed effects state"
					}
					- ", which is a string."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "When a "
			a href="#drag-data-store" id="the-drag-data-store:drag-data-store-3" {
				- "drag data store"
			}
			- " is "
			dfn id="create-a-drag-data-store" {
				- "created"
			}
			- ", it\n  must be initialized such that its "
			a href="#drag-data-store-item-list" id="the-drag-data-store:drag-data-store-item-list-2" {
				- "drag data store item list"
			}
			- " is empty, it has no\n  "
			a href="#drag-data-store-default-feedback" id="the-drag-data-store:drag-data-store-default-feedback" {
				- "drag data store default feedback"
			}
			- ", it has no "
			a href="#drag-data-store-bitmap" id="the-drag-data-store:drag-data-store-bitmap" {
				- "drag data store bitmap"
			}
			- " and\n  "
			a href="#drag-data-store-hot-spot-coordinate" id="the-drag-data-store:drag-data-store-hot-spot-coordinate" {
				- "drag data store hot spot coordinate"
			}
			- ", its "
			a href="#drag-data-store-mode" id="the-drag-data-store:drag-data-store-mode" {
				- "drag data store mode"
			}
			- " is "
			a href="#concept-dnd-p" id="the-drag-data-store:concept-dnd-p" {
				- "protected mode"
			}
			- ", and its "
			a href="#drag-data-store-allowed-effects-state" id="the-drag-data-store:drag-data-store-allowed-effects-state" {
				- "drag data store allowed effects\n  state"
			}
			- " is the string \""
			code id="the-drag-data-store:dom-datatransfer-effectallowed-uninitialized" {
				a href="#dom-datatransfer-effectallowed-uninitialized" {
					- "uninitialized"
				}
			}
			- "\"."
		}
		- "\n\n\n  "
		h4 id="the-datatransfer-interface" {
			span class="secno" {
				- "6.11.3"
			}
			- " The "
			code id="the-datatransfer-interface:datatransfer" {
				a href="#datatransfer" {
					- "DataTransfer"
				}
			}
			- " interface"
			a href="#the-datatransfer-interface" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/DataTransfer" title="The DataTransfer object is used to hold the data that is being dragged during a drag and drop operation. It may hold one or more data items, each of one or more data types. For more information about drag and drop, see HTML Drag and Drop API." {
						- "DataTransfer"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
