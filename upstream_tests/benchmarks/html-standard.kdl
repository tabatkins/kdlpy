		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					a href="#concept-relevant-global" id="common-input-element-apis:concept-relevant-global-2" {
						- "relevant global object"
					}
					- " does not have "
					a href="#transient-activation" id="common-input-element-apis:transient-activation-3" {
						- "transient\n   activation"
					}
					- ", then return."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is not "
					i id="common-input-element-apis:concept-fe-mutable-3" {
						a href="#concept-fe-mutable" {
							- "mutable"
						}
					}
					- ", then\n   return."
				}
			}
			li {
				p {
					a href="#consume-user-activation" id="common-input-element-apis:consume-user-activation" {
						- "Consume user activation"
					}
					- " given "
					a id="common-input-element-apis:element" href="https://dom.spec.whatwg.org/#interface-element" data-x-internal="element" {
