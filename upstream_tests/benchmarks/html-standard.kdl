									}
									- "\n       element has been popped from the stack."
								}
							}
							li {
								p {
									- "Jump to the step labeled "
									i {
										- "done"
									}
									- " below."
								}
							}
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "node"
							}
							- " is a "
							code id="parsing-main-inbody:the-dt-element-4" {
								a href="#the-dt-element" {
									- "dt"
								}
							}
							- " element, then run these substeps:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-3" {
										- "Generate implied end tags"
									}
									- ", except for "
									code id="parsing-main-inbody:the-dt-element-5" {
										a href="#the-dt-element" {
											- "dt"
										}
									}
									- " elements."
								}
							}
							li {
								p {
									- "If the "
									a href="#current-node" id="parsing-main-inbody:current-node-8" {
										- "current node"
									}
									- " is not a "
									code id="parsing-main-inbody:the-dt-element-6" {
										a href="#the-dt-element" {
											- "dt"
										}
									}
									- " element, then this is a\n       "
									a href="#parse-errors" id="parsing-main-inbody:parse-errors-15" {
										- "parse error"
									}
									- "."
								}
							}
							li {
								p {
									- "Pop elements from the "
									a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-27" {
										- "stack of open elements"
									}
