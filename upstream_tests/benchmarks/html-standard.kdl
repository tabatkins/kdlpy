				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "val"
					}
					- " be the value of "
					dfn data-dfn-for="ImageBitmapOptions" id="dom-imagebitmapoptions-premultiplyalpha" data-dfn-type="dict-member" {
						code {
							- "premultiplyAlpha"
						}
					}
					- " member of\n    "
					var {
						- "options"
					}
					- ", and then run these substeps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "val"
							}
							- " is \""
							dfn data-dfn-for="PremultiplyAlpha" id="dom-premultiplyalpha-default" data-dfn-type="enum-value" {
								code {
									- "default"
								}
							}
							- "\", the alpha premultiplication\n     behavior is implementation-specific, and should be chosen according to implementation deems\n     optimal for drawing images onto the canvas."
						}
					}
					li {
						p {
							- "If "
							var {
								- "val"
							}
							- " is \""
							dfn data-dfn-for="PremultiplyAlpha" id="dom-premultiplyalpha-premultiply" data-dfn-type="enum-value" {
								code {
									- "premultiply"
								}
							}
							- "\", the "
							var {
								- "output"
							}
							- " that\n     is not premultiplied by alpha must have its color components "
							a href="#convert-to-premultiplied" id="images-2:convert-to-premultiplied" {
								- "multiplied by alpha"
							}
							- " and that is premultiplied by alpha\n     must be left untouched."
						}
					}
					li {
						p {
							- "If "
							var {
