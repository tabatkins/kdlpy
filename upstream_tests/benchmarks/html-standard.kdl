		- "\n\n\n  "
		h5 id="attributes-common-to-source-and-img-elements" {
			span class="secno" {
				- "4.8.4.2"
			}
			- " Attributes common to "
			code id="attributes-common-to-source-and-img-elements:the-source-element" {
				a href="#the-source-element" {
					- "source"
				}
			}
			- ",\n  "
			code id="attributes-common-to-source-and-img-elements:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- ", and "
			code id="attributes-common-to-source-and-img-elements:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " elements"
			a href="#attributes-common-to-source-and-img-elements" class="self-link"
		}
		- "\n\n  "
		h6 id="srcset-attributes" {
			span class="secno" {
				- "4.8.4.2.1"
			}
			- " Srcset attributes"
			a href="#srcset-attributes" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="srcset-attribute" {
				- "srcset attribute"
			}
			- " is an attribute with requirements defined in this section."
		}
		- "\n\n  "
		p {
			- "If present, its value must consist of one or more "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string" {
				- "image\n  candidate strings"
			}
			- ", each separated from the next by a U+002C COMMA character (,). If an\n  "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-2" {
				- "image candidate string"
			}
			- " contains no descriptors and no "
			a id="srcset-attributes:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
				- "ASCII whitespace"
			}
			- "\n  after the URL, the following "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-3" {
				- "image candidate string"
			}
			- ", if there is one, must begin with\n  one or more "
			a id="srcset-attributes:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
				- "ASCII whitespace"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="image-candidate-string" {
				- "image candidate string"
			}
			- " consists of the following components, in order, with the\n  further restrictions described below this list:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Zero or more "
					a id="srcset-attributes:space-characters-3" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- "."
				}
			}
			li {
				p {
					- "A "
					a href="#valid-non-empty-url" id="srcset-attributes:valid-non-empty-url" {
						- "valid non-empty URL"
					}
					- " that does not start or end with a U+002C COMMA\n   character (,), referencing a non-interactive, optionally animated, image resource that is neither\n   paged nor scripted."
				}
			}
			li {
				p {
					- "Zero or more "
					a id="srcset-attributes:space-characters-4" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Zero or one of the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "A "
							dfn id="width-descriptor" {
								- "width descriptor"
							}
							- ", consisting of: "
							a id="srcset-attributes:space-characters-5" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII whitespace"
							}
							- ", a\n     "
							a href="#valid-non-negative-integer" id="srcset-attributes:valid-non-negative-integer" {
								- "valid non-negative integer"
							}
							- " giving a number greater than zero representing the\n     "
							dfn id="width-descriptor-value" {
								- "width descriptor value"
							}
							- ", and a U+0077 LATIN SMALL LETTER W character."
						}
					}
					li {
						p {
							- "A "
							dfn id="pixel-density-descriptor" {
								- "pixel density descriptor"
							}
							- ", consisting of: "
							a id="srcset-attributes:space-characters-6" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII whitespace"
							}
							- ", a\n     "
							a href="#valid-floating-point-number" id="srcset-attributes:valid-floating-point-number" {
								- "valid floating-point number"
							}
							- " giving a number greater than zero representing the\n     "
							dfn id="pixel-density-descriptor-value" {
								- "pixel density descriptor value"
							}
							- ", and a U+0078 LATIN SMALL LETTER X\n     character."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Zero or more "
					a id="srcset-attributes:space-characters-7" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "There must not be an "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-4" {
				- "image candidate string"
			}
			- " for an element that has the same\n  "
			a href="#width-descriptor-value" id="srcset-attributes:width-descriptor-value" {
				- "width descriptor value"
			}
			- " as another "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-5" {
				- "image candidate string"
			}
			- "'s "
			a href="#width-descriptor-value" id="srcset-attributes:width-descriptor-value-2" {
				- "width\n  descriptor value"
			}
			- " for the same element."
		}
		- "\n\n  "
		p {
			- "There must not be an "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-6" {
				- "image candidate string"
			}
			- " for an element that has the same\n  "
			a href="#pixel-density-descriptor-value" id="srcset-attributes:pixel-density-descriptor-value" {
				- "pixel density descriptor value"
			}
			- " as another "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-7" {
				- "image candidate string"
			}
			- "'s\n  "
			a href="#pixel-density-descriptor-value" id="srcset-attributes:pixel-density-descriptor-value-2" {
				- "pixel density descriptor value"
			}
			- " for the same element. For the purpose of this\n  requirement, an "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-8" {
				- "image candidate string"
			}
			- " with no descriptors is equivalent to an\n  "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-9" {
				- "image candidate string"
			}
			- " with a "
			code {
				- "1x"
			}
			- " descriptor."
		}
		- "\n\n  "
		p {
			- "If an "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-10" {
				- "image candidate string"
			}
			- " for an element has the "
			a href="#width-descriptor" id="srcset-attributes:width-descriptor" {
				- "width descriptor"
			}
			- "\n  specified, all other "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-11" {
				- "image candidate strings"
			}
			- " for that\n  element must also have the "
			a href="#width-descriptor" id="srcset-attributes:width-descriptor-2" {
				- "width descriptor"
			}
			- " specified."
		}
		- "\n\n  "
		p {
			- "The specified width in an "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-12" {
				- "image candidate string"
			}
			- "'s "
			a href="#width-descriptor" id="srcset-attributes:width-descriptor-3" {
				- "width descriptor"
			}
			- "\n  must match the "
			a id="srcset-attributes:natural-width" href="https://drafts.csswg.org/css-images/#natural-width" data-x-internal="natural-width" {
				- "natural width"
			}
			- " in the resource given by the\n  "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-13" {
				- "image candidate string"
			}
			- "'s URL, if it has a "
			a id="srcset-attributes:natural-width-2" href="https://drafts.csswg.org/css-images/#natural-width" data-x-internal="natural-width" {
				- "natural width"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "If an element has a "
			a href="#sizes-attribute" id="srcset-attributes:sizes-attribute" {
				- "sizes attribute"
			}
			- " present, all "
			a href="#image-candidate-string" id="srcset-attributes:image-candidate-string-14" {
				- "image candidate strings"
			}
			- " for that element must have the "
			a href="#width-descriptor" id="srcset-attributes:width-descriptor-4" {
				- "width\n  descriptor"
			}
			- " specified."
		}
		- "\n\n\n  "
		h6 id="sizes-attributes" {
			span class="secno" {
				- "4.8.4.2.2"
			}
			- " Sizes attributes"
			a href="#sizes-attributes" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="sizes-attribute" {
				- "sizes attribute"
			}
			- " is an attribute with requirements defined in this section."
		}
		- "\n\n  "
		p {
			- "If present, the value must be a "
			a href="#valid-source-size-list" id="sizes-attributes:valid-source-size-list" {
				- "valid source size list"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="valid-source-size-list" {
				- "valid source size list"
			}
			- " is a string that matches the following grammar:\n  "
			a href="#refsCSSVALUES" {
				- "[CSSVALUES]"
			}
			- " "
			a href="#refsMQ" {
				- "[MQ]"
			}
		}
		- "\n\n"
		pre {
			code class="html" {
				dfn id="source-size-list" data-dfn-type="type" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size-list"
					}
					c- p="" {
						- ">"
					}
				}
				- " = "
				a href="#source-size" id="sizes-attributes:source-size" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size"
					}
					c- p="" {
						- ">"
					}
				}
				- "#? , "
				a href="#source-size-value" id="sizes-attributes:source-size-value" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size-value"
					}
					c- p="" {
						- ">"
					}
				}
				- "\n"
				dfn id="source-size" data-dfn-type="type" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size"
					}
					c- p="" {
						- ">"
					}
				}
				- " = "
				a id="sizes-attributes:media-condition" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "media-condition"
					}
					c- p="" {
						- ">"
					}
				}
				- " "
				a href="#source-size-value" id="sizes-attributes:source-size-value-2" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size-value"
					}
					c- p="" {
						- ">"
					}
				}
				- " | "
				a href="#valdef-sizes-auto" id="sizes-attributes:valdef-sizes-auto" {
					- "auto"
				}
				- "\n"
				dfn id="source-size-value" data-dfn-type="type" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "source-size-value"
					}
					c- p="" {
						- ">"
					}
				}
				- " = "
				a id="sizes-attributes:length-2" href="https://drafts.csswg.org/css-values/#lengths" data-x-internal="length-2" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "length"
					}
					c- p="" {
						- ">"
					}
				}
				- " | "
				a href="#valdef-sizes-auto" id="sizes-attributes:valdef-sizes-auto-2" {
					- "auto"
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#source-size-value" id="sizes-attributes:source-size-value-3" {
				- "<source-size-value>"
			}
			- " that is a "
			a id="sizes-attributes:length-2-2" href="https://drafts.csswg.org/css-values/#lengths" data-x-internal="length-2" {
				- "<length>"
			}
			- " must not be negative,\n  and must not use CSS functions other than the "
			a id="sizes-attributes:math-functions" href="https://drafts.csswg.org/css-values/#math-function" data-x-internal="math-functions" {
				- "math functions"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The keyword "
			dfn id="valdef-sizes-auto" {
				code {
					- "auto"
				}
			}
			- " is a width that is\n  computed in "
			a href="#parse-a-sizes-attribute" id="sizes-attributes:parse-a-sizes-attribute" {
				- "parse a sizes attribute"
			}
			- ". If present, it must be the first entry and the\n  entire "
			a href="#source-size-list" id="sizes-attributes:source-size-list" {
				- "<source-size-list>"
			}
			- " value must either be the string \""
			code {
				- "auto"
			}
			- "\" ("
			a id="sizes-attributes:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII case-insensitive"
			}
			- ") or start with the string \""
			code {
				- "auto,"
			}
			- "\" ("
			a id="sizes-attributes:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII case-insensitive"
			}
			- ")."
		}
		- "\n\n  "
		p class="note" {
			- "If the "
			code id="sizes-attributes:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element that initiated the image loading (with the\n  "
			a href="#update-the-image-data" id="sizes-attributes:update-the-image-data" {
				- "update the image data"
			}
			- " or "
			a href="#img-environment-changes" id="sizes-attributes:img-environment-changes" {
				- "react to environment\n  changes"
			}
			- " algorithms) "
			a href="#allows-auto-sizes" id="sizes-attributes:allows-auto-sizes" {
				- "allows auto-sizes"
			}
			- " and is "
			a href="#being-rendered" id="sizes-attributes:being-rendered" {
				- "being rendered"
			}
			- ",\n  then "
			code id="sizes-attributes:valdef-sizes-auto-3" {
				a href="#valdef-sizes-auto" {
					- "auto"
				}
			}
			- " is the "
			a id="sizes-attributes:concrete-object-size" href="https://drafts.csswg.org/css-images/#concrete-object-size" data-x-internal="concrete-object-size" {
				- "concrete object size"
			}
			- " width.\n  Otherwise, the "
			code id="sizes-attributes:valdef-sizes-auto-4" {
				a href="#valdef-sizes-auto" {
					- "auto"
				}
			}
			- " value is ignored and the next\n  "
			a href="#source-size-2" id="sizes-attributes:source-size-2" {
				- "source size"
			}
			- " is used instead, if any."
		}
		- "\n\n  "
		p {
			- "The "
			code id="sizes-attributes:valdef-sizes-auto-5" {
				a href="#valdef-sizes-auto" {
					- "auto"
				}
			}
			- " keyword may be specified in the "
			code id="sizes-attributes:attr-source-sizes" {
				a href="#attr-source-sizes" {
					- "sizes"
				}
			}
			- " attribute of "
			code id="sizes-attributes:the-source-element" {
				a href="#the-source-element" {
					- "source"
				}
			}
			- " elements and "
			code id="sizes-attributes:attr-img-sizes" {
				a href="#attr-img-sizes" {
					- "sizes"
				}
			}
			- " attribute of "
			code id="sizes-attributes:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements, if the following\n  conditions are met. Otherwise, "
			code id="sizes-attributes:valdef-sizes-auto-6" {
				a href="#valdef-sizes-auto" {
					- "auto"
				}
			}
			- " must not be\n  specified."
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The element is a "
					code id="sizes-attributes:the-source-element-2" {
						a href="#the-source-element" {
							- "source"
						}
					}
					- " element with a following sibling\n   "
					code id="sizes-attributes:the-img-element-3" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element."
				}
			}
			li {
				p {
					- "The element is an "
					code id="sizes-attributes:the-img-element-4" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element."
				}
			}
			li {
				p {
					- "The "
					code id="sizes-attributes:the-img-element-5" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element referenced in either condition above "
					a href="#allows-auto-sizes" id="sizes-attributes:allows-auto-sizes-2" {
						- "allows\n   auto-sizes"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "In addition, it is strongly encouraged to specify dimensions using the "
			code id="sizes-attributes:attr-dim-width" {
				a href="#attr-dim-width" {
					- "width"
				}
			}
			- " and "
			code id="sizes-attributes:attr-dim-height" {
				a href="#attr-dim-height" {
					- "height"
				}
			}
			- " attributes\n  or with CSS. Without specified dimensions, the image will likely render with 300x150 dimensions\n  because "
			code {
				- "sizes=\"auto\""
			}
			- " implies "
			code {
				- "contain-intrinsic-size: 300px\n  150px"
			}
			- " in "
			a href="#img-contain-size" {
				- "the Rendering section"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#source-size-value" id="sizes-attributes:source-size-value-4" {
				- "<source-size-value>"
			}
			- " gives the intended layout width of the image. The\n  author can specify different widths for different environments with\n  "
			a id="sizes-attributes:media-condition-2" href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" data-x-internal="media-condition" {
				- "<media-condition>"
			}
			- "s."
		}
		- "\n\n  "
		p class="note" {
			- "Percentages are not allowed in a "
			a href="#source-size-value" id="sizes-attributes:source-size-value-5" {
				- "<source-size-value>"
			}
			- ",\n  to avoid confusion about what it would be relative to.\n  The "
			a id="sizes-attributes:'vw'" href="https://drafts.csswg.org/css-values/#vw" data-x-internal="'vw'" {
				- "'vw'"
			}
			- " unit can be used for sizes relative to the "
			a id="sizes-attributes:viewport" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- "\n  width."
		}
		- "\n\n  \n\n  "
		h5 id="images-processing-model" {
			span class="secno" {
				- "4.8.4.3"
			}
			- " Processing model"
			a href="#images-processing-model" class="self-link"
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "An "
			code id="images-processing-model:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element has a "
			dfn id="current-request" {
				- "current request"
			}
			- " and a "
			dfn id="pending-request" {
				- "pending request"
			}
			- ".\n  The "
			a href="#current-request" id="images-processing-model:current-request" {
				- "current request"
			}
			- " is initially set to a new "
			a href="#image-request" id="images-processing-model:image-request" {
				- "image request"
			}
			- ".\n  The "
			a href="#pending-request" id="images-processing-model:pending-request" {
				- "pending request"
			}
			- " is initially set to null."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="image-request" data-export="" {
				- "image request"
			}
			- " has a "
			dfn data-dfn-for="image request" id="img-req-state" data-export="" {
				- "state"
			}
			- ", "
			dfn data-dfn-for="image request" id="img-req-url" data-export="" {
				- "current URL"
			}
			- ", and "
			dfn data-dfn-for="image request" id="img-req-data" data-export="" {
				- "image data"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			a href="#image-request" id="images-processing-model:image-request-2" {
				- "image request"
			}
			- "'s "
			a href="#img-req-state" id="images-processing-model:img-req-state" {
				- "state"
			}
			- " is one of the\n  following:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="img-none" {
					- "Unavailable"
				}
			}
			dd {
				- "The user agent hasn't obtained any image data,\n   or has obtained some or all of the image data but\n   hasn't yet decoded enough of the image to get the image dimensions."
			}
			dt {
				dfn id="img-inc" {
					- "Partially available"
				}
			}
			dd {
				- "The user agent has obtained some of the image data and at least the image dimensions are\n   available."
			}
			dt {
				dfn id="img-all" {
					- "Completely available"
				}
			}
			dd {
				- "The user agent has obtained all of the image data and at least the image dimensions are\n   available."
			}
			dt {
				dfn id="img-error" {
					- "Broken"
				}
			}
			dd {
				- "The user agent has obtained all of the image data that it can, but it cannot even decode the\n   image enough to get the image dimensions (e.g. the image is corrupted, or the format is not\n   supported, or no data could be obtained)."
			}
		}
		- "\n\n  "
		p {
			- "An "
			a href="#image-request" id="images-processing-model:image-request-3" {
				- "image request"
			}
			- "'s "
			a href="#img-req-url" id="images-processing-model:img-req-url" {
				- "current URL"
			}
			- " is initially the\n  empty string."
		}
		- "\n\n  "
		p {
			- "An "
			a href="#image-request" id="images-processing-model:image-request-4" {
				- "image request"
			}
			- "'s "
			a href="#img-req-data" id="images-processing-model:img-req-data" {
				- "image data"
			}
			- " is the decoded\n  image data."
		}
		- "\n\n  "
		p {
			- "When an "
			a href="#image-request" id="images-processing-model:image-request-5" {
				- "image request"
			}
			- "'s "
			a href="#img-req-state" id="images-processing-model:img-req-state-2" {
				- "state"
			}
			- " is either "
			a href="#img-inc" id="images-processing-model:img-inc" {
				- "partially available"
			}
			- " or "
			a href="#img-all" id="images-processing-model:img-all" {
				- "completely available"
			}
			- ",\n  the "
			a href="#image-request" id="images-processing-model:image-request-6" {
				- "image request"
			}
			- " is said to be "
			dfn id="img-available" {
				- "available"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an "
			code id="images-processing-model:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's "
			a href="#current-request" id="images-processing-model:current-request-2" {
				- "current request"
			}
			- "'s "
			a href="#img-req-state" id="images-processing-model:img-req-state-3" {
				- "state"
			}
			- " is "
			a href="#img-all" id="images-processing-model:img-all-2" {
				- "completely available"
			}
			- " and the\n  user agent can decode the media data without errors, then the "
			code id="images-processing-model:the-img-element-3" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element is said to\n  be "
			dfn id="img-good" {
				- "fully decodable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			a href="#image-request" id="images-processing-model:image-request-7" {
				- "image request"
			}
			- "'s "
			a href="#img-req-state" id="images-processing-model:img-req-state-4" {
				- "state"
			}
			- " is initially "
			a href="#img-none" id="images-processing-model:img-none" {
				- "unavailable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an "
			code id="images-processing-model:the-img-element-4" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's "
			a href="#current-request" id="images-processing-model:current-request-3" {
				- "current request"
			}
			- " is "
			a href="#img-available" id="images-processing-model:img-available" {
				- "available"
			}
			- ", the "
			code id="images-processing-model:the-img-element-5" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element provides a "
			a id="images-processing-model:paint-source" href="https://drafts.csswg.org/css-images-4/#paint-source" data-x-internal="paint-source" {
				- "paint\n  source"
			}
			- " whose width is the image's "
			a href="#density-corrected-intrinsic-width-and-height" id="images-processing-model:density-corrected-intrinsic-width-and-height" {
				- "density-corrected natural width"
			}
			- " (if any), whose height is the image's "
			a href="#density-corrected-intrinsic-width-and-height" id="images-processing-model:density-corrected-intrinsic-width-and-height-2" {
				- "density-corrected natural height"
			}
			- "\n  (if any), and whose appearance is the natural appearance of the image."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "An "
			code id="images-processing-model:the-img-element-6" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element is said to "
			dfn id="use-srcset-or-picture" {
				- "use "
				code {
					- "srcset"
				}
				- " or\n  "
				code {
					- "picture"
				}
			}
			- " if it has a "
			code id="images-processing-model:attr-img-srcset" {
				a href="#attr-img-srcset" {
					- "srcset"
				}
			}
			- " attribute\n  specified or if it has a parent that is a "
			code id="images-processing-model:the-picture-element" {
				a href="#the-picture-element" {
					- "picture"
				}
			}
			- " element."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Each "
			code id="images-processing-model:the-img-element-7" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element has a "
			dfn id="last-selected-source" {
				- "last selected source"
			}
			- ", which must initially be\n  null."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#image-request" id="images-processing-model:image-request-8" {
				- "image request"
			}
			- " has a "
			dfn id="current-pixel-density" {
				- "current pixel density"
			}
			- ", which must initially be\n  1."
		}
		- "\n\n  "
		p {
			- "Each "
			a href="#image-request" id="images-processing-model:image-request-9" {
				- "image request"
			}
			- " has "
			dfn id="preferred-density-corrected-dimensions" {
				- "preferred density-corrected dimensions"
			}
			- ", which is\n  either a struct consisting of a width and a height or is null. It must initially be null."
		}
		- "\n\n  "
		p {
			- "To determine the "
			dfn id="density-corrected-intrinsic-width-and-height" {
				- "density-corrected\n  natural width and height"
			}
			- " of an "
			code id="images-processing-model:the-img-element-8" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element "
			var {
				- "img"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "dim"
					}
					- " be "
					var {
						- "img"
					}
					- "'s "
					a href="#current-request" id="images-processing-model:current-request-4" {
						- "current request"
					}
					- "'s "
					a href="#preferred-density-corrected-dimensions" id="images-processing-model:preferred-density-corrected-dimensions" {
						- "preferred\n    density-corrected dimensions"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "The "
					a href="#preferred-density-corrected-dimensions" id="images-processing-model:preferred-density-corrected-dimensions-2" {
						- "preferred density-corrected dimensions"
					}
					- " are set in the\n    "
					a href="#prepare-an-image-for-presentation" id="images-processing-model:prepare-an-image-for-presentation" {
						- "prepare an image for presentation"
					}
					- " algorithm based on meta information in the\n    image."
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "dim"
					}
					- " is null, set "
					var {
						- "dim"
					}
					- " to "
					var {
						- "img"
					}
					- "'s "
					a id="images-processing-model:natural-dimensions" href="https://drafts.csswg.org/css-images/#natural-dimensions" data-x-internal="natural-dimensions" {
						- "natural\n   dimensions"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "dim"
					}
					- "'s width to "
					var {
						- "dim"
					}
					- "'s width divided by "
					var {
						- "img"
					}
					- "'s\n   "
					a href="#current-request" id="images-processing-model:current-request-5" {
						- "current request"
					}
					- "'s "
					a href="#current-pixel-density" id="images-processing-model:current-pixel-density" {
						- "current pixel density"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "dim"
					}
					- "'s height to "
					var {
						- "dim"
					}
					- "'s height divided by "
					var {
						- "img"
					}
					- "'s\n   "
					a href="#current-request" id="images-processing-model:current-request-6" {
						- "current request"
					}
					- "'s "
					a href="#current-pixel-density" id="images-processing-model:current-pixel-density-2" {
						- "current pixel density"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "dim"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="example" {
			- "For example, if the "
			a href="#current-pixel-density" id="images-processing-model:current-pixel-density-3" {
				- "current pixel density"
			}
			- " is 3.125, that means\n  that there are 300 device pixels per "
			a href="https://drafts.csswg.org/css-values/#in" id="images-processing-model:'in'" data-x-internal="'in'" {
				- "CSS inch"
			}
			- ", and thus if the image\n  data is 300x600, it has "
			a href="#density-corrected-intrinsic-width-and-height" id="images-processing-model:density-corrected-intrinsic-width-and-height-3" {
				- "density-corrected natural width and height"
			}
			- " of 96 "
			a href="https://drafts.csswg.org/css-values/#px" id="images-processing-model:'px'" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- " by 192 "
			a href="https://drafts.csswg.org/css-values/#px" id="images-processing-model:'px'-2" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "All "
			code id="images-processing-model:the-img-element-9" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " and "
			code id="images-processing-model:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " elements are associated with a "
			a href="#source-set" id="images-processing-model:source-set" {
				- "source set"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="source-set" {
				- "source set"
			}
			- " is an ordered set of zero or more "
			a href="#image-source" id="images-processing-model:image-source" {
				- "image sources"
			}
			- "\n  and a "
			a href="#source-size-2" id="images-processing-model:source-size-2" {
				- "source size"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="image-source" {
				- "image source"
			}
			- " is a "
			a id="images-processing-model:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- ", and optionally either a "
			a href="#pixel-density-descriptor" id="images-processing-model:pixel-density-descriptor" {
				- "pixel density\n  descriptor"
			}
			- ", or a "
			a href="#width-descriptor" id="images-processing-model:width-descriptor" {
				- "width descriptor"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="source-size-2" {
				- "source size"
			}
			- " is a "
			a href="#source-size-value" id="images-processing-model:source-size-value" {
				- "<source-size-value>"
			}
			- ".\n  When a "
			a href="#source-size-2" id="images-processing-model:source-size-2-2" {
				- "source size"
			}
			- " has a unit relative to the "
			a id="images-processing-model:viewport" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- ",\n  it must be interpreted relative to the "
			code id="images-processing-model:the-img-element-10" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's "
			a id="images-processing-model:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node document"
			}
			- "'s\n  "
			a id="images-processing-model:viewport-2" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- ". Other units must be interpreted the same as in Media Queries.\n  "
			a href="#refsMQ" {
				- "[MQ]"
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-microsyntax-parse-error" {
				- "parse error"
			}
			- " for algorithms in this\n  section indicates a non-fatal mismatch between input and requirements. User agents are encouraged\n  to expose "
			a href="#concept-microsyntax-parse-error" id="images-processing-model:concept-microsyntax-parse-error" {
				- "parse error"
			}
			- "s somehow."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Whether the image is fetched successfully or not (e.g. whether the response status was an\n  "
			a id="images-processing-model:ok-status" href="https://fetch.spec.whatwg.org/#ok-status" data-x-internal="ok-status" {
				- "ok status"
			}
			- ") must be ignored when determining the image's type and whether it is a\n  valid image."
		}
		- "\n\n  "
		p class="note" {
			- "This allows servers to return images with error responses, and have them\n  displayed."
		}
		- "\n\n  "
		p id="img-determine-type" {
			- "The user agent should apply the "
			a href="https://mimesniff.spec.whatwg.org/#rules-for-sniffing-images-specifically" id="images-processing-model:content-type-sniffing:-image" data-x-internal="content-type-sniffing:-image" {
				- "image sniffing rules"
			}
			- " to determine the type of the image, with the image's "
			a href="#content-type" id="images-processing-model:content-type" {
				- "associated Content-Type headers"
			}
			- " giving the "
			var {
				- "official\n  type"
			}
			- ". If these rules are not applied, then the type of the image must be the type given by\n  the image's "
			a href="#content-type" id="images-processing-model:content-type-2" {
				- "associated Content-Type headers"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "User agents must not support non-image resources with the "
			code id="images-processing-model:the-img-element-11" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element (e.g. XML\n  files whose "
			a id="images-processing-model:document-element" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
				- "document element"
			}
			- " is an HTML element). User agents must not run executable\n  code (e.g. scripts) embedded in the image resource. User agents must only display the first page\n  of a multipage resource (e.g. a PDF file). User agents must not allow the resource to act in an\n  interactive fashion, but should honour any animation in the resource."
		}
		- "\n\n  "
		p {
			- "This specification does not specify which image types are to be supported."
		}
		- "\n\n\n  "
		h6 id="when-to-obtain-images" {
			span class="secno" {
				- "4.8.4.3.1"
			}
			- " When to obtain images"
			a href="#when-to-obtain-images" class="self-link"
		}
		- "\n\n  "
		p {
			- "By default, images are obtained immediately. User agents may provide users with the option to\n  instead obtain them on-demand. (The on-demand option might be used by bandwidth-constrained users,\n  for example.)"
		}
		- "\n\n  "
		p {
			- "When obtaining images immediately, the user agent must synchronously "
			a href="#update-the-image-data" id="when-to-obtain-images:update-the-image-data" {
				- "update the image\n  data"
			}
			- " of the "
			code id="when-to-obtain-images:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element, with the "
			i {
				- "restart animation"
			}
			- " flag set if so\n  stated, whenever that element is created or has experienced "
			a href="#relevant-mutations" id="when-to-obtain-images:relevant-mutations" {
				- "relevant mutations"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When obtaining images on demand, the user agent must "
			a href="#update-the-image-data" id="when-to-obtain-images:update-the-image-data-2" {
				- "update the image data"
			}
			- " of an\n  "
			code id="when-to-obtain-images:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element whenever it needs the image data (i.e., on demand), but only if the\n  "
			code id="when-to-obtain-images:the-img-element-3" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's "
			a href="#current-request" id="when-to-obtain-images:current-request" {
				- "current request"
			}
			- "'s "
			a href="#img-req-state" id="when-to-obtain-images:img-req-state" {
				- "state"
			}
			- " is "
			a href="#img-none" id="when-to-obtain-images:img-none" {
				- "unavailable"
			}
			- ". When an\n  "
			code id="when-to-obtain-images:the-img-element-4" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element has experienced "
			a href="#relevant-mutations" id="when-to-obtain-images:relevant-mutations-2" {
				- "relevant mutations"
			}
			- ", if the user agent only\n  obtains images on demand, the "
			code id="when-to-obtain-images:the-img-element-5" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's "
			a href="#current-request" id="when-to-obtain-images:current-request-2" {
				- "current request"
			}
			- "'s "
			a href="#img-req-state" id="when-to-obtain-images:img-req-state-2" {
				- "state"
			}
			- " must return to "
			a href="#img-none" id="when-to-obtain-images:img-none-2" {
				- "unavailable"
			}
			- "."
		}
		- "\n\n\n  "
		h6 id="reacting-to-dom-mutations" {
			span class="secno" {
				- "4.8.4.3.2"
			}
			- " Reacting to DOM mutations"
			a href="#reacting-to-dom-mutations" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="relevant-mutations" {
				- "relevant mutations"
			}
			- " for an "
			code id="reacting-to-dom-mutations:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element are as follows:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The element's "
					code id="reacting-to-dom-mutations:attr-img-src" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-img-srcset" {
						a href="#attr-img-srcset" {
							- "srcset"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-dim-width" {
						a href="#attr-dim-width" {
							- "width"
						}
					}
					- ", or "
					code id="reacting-to-dom-mutations:attr-img-sizes" {
						a href="#attr-img-sizes" {
							- "sizes"
						}
					}
					- " attributes are set, changed, or removed."
				}
			}
			li {
				p {
					- "The element's "
					code id="reacting-to-dom-mutations:attr-img-src-2" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- " attribute is set to the same value as the previous value.\n   This must set the "
					i {
						- "restart animation"
					}
					- " flag for the "
					a href="#update-the-image-data" id="reacting-to-dom-mutations:update-the-image-data" {
						- "update the image data"
					}
					- " algorithm."
				}
			}
			li {
				p {
					- "The element's "
					code id="reacting-to-dom-mutations:attr-img-crossorigin" {
						a href="#attr-img-crossorigin" {
							- "crossorigin"
						}
					}
					- " attribute's state is changed."
				}
			}
			li {
				p {
					- "The element's "
					code id="reacting-to-dom-mutations:attr-img-referrerpolicy" {
						a href="#attr-img-referrerpolicy" {
							- "referrerpolicy"
						}
					}
					- " attribute's\n   state is changed."
				}
			}
			li {
				p {
					- "The "
					code id="reacting-to-dom-mutations:the-img-element-2" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " or "
					code id="reacting-to-dom-mutations:the-source-element" {
						a href="#the-source-element" {
							- "source"
						}
					}
					- " "
					a href="#html-element-insertion-steps" id="reacting-to-dom-mutations:html-element-insertion-steps" {
						- "HTML element insertion steps"
					}
					- " or\n   "
					a href="#html-element-removing-steps" id="reacting-to-dom-mutations:html-element-removing-steps" {
						- "HTML element removing steps"
					}
					- " count the mutation as a "
					a href="#relevant-mutations" id="reacting-to-dom-mutations:relevant-mutations" {
						- "relevant mutation"
					}
					- "."
				}
			}
			li {
				p {
					- "The element's parent is a "
					code id="reacting-to-dom-mutations:the-picture-element" {
						a href="#the-picture-element" {
							- "picture"
						}
					}
					- " element and a "
					code id="reacting-to-dom-mutations:the-source-element-2" {
						a href="#the-source-element" {
							- "source"
						}
					}
					- " element\n   that is a previous sibling has its "
					code id="reacting-to-dom-mutations:attr-source-srcset" {
						a href="#attr-source-srcset" {
							- "srcset"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-source-sizes" {
						a href="#attr-source-sizes" {
							- "sizes"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-source-media" {
						a href="#attr-source-media" {
							- "media"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-source-type" {
						a href="#attr-source-type" {
							- "type"
						}
					}
					- ", "
					code id="reacting-to-dom-mutations:attr-dim-width-2" {
						a href="#attr-dim-width" {
							- "width"
						}
					}
					- " or "
					code id="reacting-to-dom-mutations:attr-dim-height" {
						a href="#attr-dim-height" {
							- "height"
						}
					}
					- " attributes set, changed, or removed."
				}
			}
			li {
				p {
					- "The element's "
					a href="https://dom.spec.whatwg.org/#concept-node-adopt-ext" id="reacting-to-dom-mutations:concept-node-adopt-ext" data-x-internal="concept-node-adopt-ext" {
						- "adopting steps"
					}
					- " are run."
				}
			}
			li {
				p {
					- "If the element "
					a href="#allows-auto-sizes" id="reacting-to-dom-mutations:allows-auto-sizes" {
						- "allows auto-sizes"
					}
					- ": the element starts or stops "
					a href="#being-rendered" id="reacting-to-dom-mutations:being-rendered" {
						- "being\n   rendered"
					}
					- ", or its "
					a id="reacting-to-dom-mutations:concrete-object-size" href="https://drafts.csswg.org/css-images/#concrete-object-size" data-x-internal="concrete-object-size" {
						- "concrete object size"
					}
					- " width changes. This must set the\n   "
					i {
						- "maybe omit events"
					}
					- " flag for the "
					a href="#update-the-image-data" id="reacting-to-dom-mutations:update-the-image-data-2" {
						- "update the image data"
					}
					- " algorithm."
				}
			}
		}
		- "\n\n\n  "
		h6 id="the-list-of-available-images" {
			span class="secno" {
				- "4.8.4.3.3"
			}
			- " The list of available images"
			a href="#the-list-of-available-images" class="self-link"
		}
		- "\n\n  "
		p {
			- "Each "
			code id="the-list-of-available-images:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " object must have a "
			dfn id="list-of-available-images" {
				- "list of available images"
			}
			- ". Each image\n  in this list is identified by a tuple consisting of an "
			a id="the-list-of-available-images:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- ", a "
			a href="#cors-settings-attribute" id="the-list-of-available-images:cors-settings-attribute" {
				- "CORS\n  settings attribute"
			}
			- " mode, and, if the mode is not "
			a href="#attr-crossorigin-none" id="the-list-of-available-images:attr-crossorigin-none" {
				- "No\n  CORS"
			}
			- ", an "
			a href="#concept-origin" id="the-list-of-available-images:concept-origin" {
				- "origin"
			}
			- ".\n  Each image furthermore has an "
			dfn id="ignore-higher-layer-caching" {
				- "ignore higher-layer caching"
			}
			- " flag.\n  User agents may copy entries from one "
			code id="the-list-of-available-images:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  object's "
			a href="#list-of-available-images" id="the-list-of-available-images:list-of-available-images" {
				- "list of available images"
			}
			- " to another at any time (e.g. when the\n  "
			code id="the-list-of-available-images:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- " is created, user agents can add to it all the images that are loaded in\n  other "
			code id="the-list-of-available-images:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- "s), but must not change the keys of entries copied in this way when\n  doing so, and must unset the "
			a href="#ignore-higher-layer-caching" id="the-list-of-available-images:ignore-higher-layer-caching" {
				- "ignore higher-layer caching"
			}
			- " flag for the copied entry.\n  User agents may also remove images from such lists at any time (e.g. to save\n  memory).\n  User agents must remove entries in the "
			a href="#list-of-available-images" id="the-list-of-available-images:list-of-available-images-2" {
				- "list of available images"
			}
			- " as appropriate\n  given higher-layer caching semantics for the resource (e.g. the HTTP `"
			code id="the-list-of-available-images:http-cache-control" {
				a data-x-internal="http-cache-control" href="https://httpwg.org/specs/rfc7234.html#header.cache-control" {
					- "Cache-Control"
				}
			}
			- "` response header) when the "
			a href="#ignore-higher-layer-caching" id="the-list-of-available-images:ignore-higher-layer-caching-2" {
				- "ignore\n  higher-layer caching"
			}
			- " flag is unset."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#list-of-available-images" id="the-list-of-available-images:list-of-available-images-3" {
				- "list of available images"
			}
			- " is intended to enable synchronous\n  switching when changing the "
			code id="the-list-of-available-images:attr-img-src" {
				a href="#attr-img-src" {
					- "src"
				}
			}
			- " attribute to a URL that has\n  previously been loaded, and to avoid re-downloading images in the same document even when they\n  don't allow caching per HTTP. It is not used to avoid re-downloading the same image while the\n  previous image is still loading."
		}
		- "\n\n  "
		p class="note" {
			- "The user agent can also store the image data separately from the "
			a href="#list-of-available-images" id="the-list-of-available-images:list-of-available-images-4" {
				- "list of available images"
			}
			- "."
		}
		- "\n\n  "
		p class="example" {
			- "For example, if a resource has the HTTP response header\n  `"
			code {
				- "Cache-Control: must-revalidate"
			}
			- "`, and its "
			a href="#ignore-higher-layer-caching" id="the-list-of-available-images:ignore-higher-layer-caching-3" {
				- "ignore higher-layer\n  caching"
			}
			- " flag is unset, the user agent would remove it from the "
			a href="#list-of-available-images" id="the-list-of-available-images:list-of-available-images-5" {
				- "list of available\n  images"
			}
			- " but could keep the image data separately, and use that if the server responds with a\n  "
			code {
				- "304 Not Modified"
			}
			- " status."
		}
		- "\n\n  "
		h6 id="decoding-images" {
			span class="secno" {
				- "4.8.4.3.4"
			}
			- " Decoding images"
			a href="#decoding-images" class="self-link"
		}
		- "\n\n  "
		p {
			- "Image data is usually encoded in order to reduce file size. This means that in order for the\n  user agent to present the image to the screen, the data needs to be decoded.\n  "
			dfn id="img-decoding-process" {
				- "Decoding"
			}
			- " is the process which converts an image's media\n  data into a bitmap form, suitable for presentation to the screen. Note that this process can be\n  slow relative to other processes involved in presenting content. Thus, the user agent can choose\n  when to perform decoding, in order to create the best user experience."
		}
		- "\n\n  "
		p {
			- "Image decoding is said to be synchronous if it prevents presentation of other content until it\n  is finished. Typically, this has an effect of atomically presenting the image and any other\n  content at the same time. However, this presentation is delayed by the amount of time it takes to\n  perform the decode."
		}
		- "\n\n  "
		p {
			- "Image decoding is said to be asynchronous if it does not prevent presentation of other content.\n  This has an effect of presenting non-image content faster. However, the image content is missing\n  on screen until the decode finishes. Once the decode is finished, the screen is updated with the\n  image."
		}
		- "\n\n  "
		p {
			- "In both synchronous and asynchronous decoding modes, the final content is presented to screen\n  after the same amount of time has elapsed. The main difference is whether the user agent presents\n  non-image content ahead of presenting the final content."
		}
		- "\n\n  "
		p {
			- "In order to aid the user agent in deciding whether to perform synchronous or asynchronous\n  decode, the "
			code id="decoding-images:attr-img-decoding" {
				a href="#attr-img-decoding" {
					- "decoding"
				}
			}
			- " attribute can be set on\n  "
			code id="decoding-images:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements. The possible values of the "
			code id="decoding-images:attr-img-decoding-2" {
				a href="#attr-img-decoding" {
					- "decoding"
				}
			}
			- " attribute are the following "
			dfn id="image-decoding-hint" {
				- "image decoding\n  hint"
			}
			- " keywords:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="img/decoding" id="attr-img-decoding-sync" data-dfn-type="attr-value" {
							code {
								- "sync"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-img-decoding-sync-state" {
							- "Sync"
						}
						- "\n     "
					}
					td {
						- "Indicates a preference to "
						a href="#img-decoding-process" id="decoding-images:img-decoding-process" {
							- "decode"
						}
						- " this image\n     synchronously for atomic presentation with other content.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="img/decoding" id="attr-img-decoding-async" data-dfn-type="attr-value" {
							code {
								- "async"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-img-decoding-async-state" {
							- "Async"
						}
						- "\n     "
					}
					td {
						- "Indicates a preference to "
						a href="#img-decoding-process" id="decoding-images:img-decoding-process-2" {
							- "decode"
						}
						- " this image\n     asynchronously to avoid delaying presentation of other content.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="img/decoding" id="attr-img-decoding-auto" data-dfn-type="attr-value" {
							code {
								- "auto"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-img-decoding-auto-state" {
							- "Auto"
						}
						- "\n     "
					}
					td {
						- "Indicates no preference in decoding mode (the default).\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "When "
			a href="#img-decoding-process" id="decoding-images:img-decoding-process-3" {
				- "decoding"
			}
			- " an image, the user agent should\n  respect the preference indicated by the "
			code id="decoding-images:attr-img-decoding-3" {
				a href="#attr-img-decoding" {
					- "decoding"
				}
			}
			- "\n  attribute's state. If the state indicated is "
			a href="#attr-img-decoding-auto-state" id="decoding-images:attr-img-decoding-auto-state" {
				- "auto"
			}
			- ", then the user agent is free to choose any\n  decoding behavior."
		}
		- "\n\n  "
		p class="note" {
			- "It is also possible to control the decoding behavior using the "
			code id="decoding-images:dom-img-decode" {
				a href="#dom-img-decode" {
					- "decode()"
				}
			}
			- " method. Since the "
			code id="decoding-images:dom-img-decode-2" {
				a href="#dom-img-decode" {
					- "decode()"
				}
			}
			- " method performs "
			a href="#img-decoding-process" id="decoding-images:img-decoding-process-4" {
				- "decoding"
			}
			- " independently from the process responsible for\n  presenting content to screen, it is unaffected by the "
			code id="decoding-images:attr-img-decoding-4" {
				a href="#attr-img-decoding" {
					- "decoding"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		h6 id="updating-the-image-data" {
			span class="secno" {
				- "4.8.4.3.5"
			}
			- " Updating the image data"
			a href="#updating-the-image-data" class="self-link"
		}
		- "\n\n  "
		p class="note" {
			- "This algorithm cannot be called from steps running "
			a href="#in-parallel" id="updating-the-image-data:in-parallel" {
				- "in parallel"
			}
			- ". If\n  a user agent needs to call this algorithm from steps running "
			a href="#in-parallel" id="updating-the-image-data:in-parallel-2" {
				- "in parallel"
			}
			- ", it needs to\n  "
			a href="#queue-a-task" id="updating-the-image-data:queue-a-task" {
				- "queue"
			}
			- " a task to do so."
		}
		- "\n\n  "
		p {
			- "When the user agent is to "
			dfn id="update-the-image-data" {
				- "update the image data"
			}
			- " of an "
			code id="updating-the-image-data:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element,\n  optionally with the "
			i {
				- "restart animations"
			}
			- " flag set, optionally with the "
			i {
				- "maybe omit\n  events"
			}
			- " flag set, it must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the element's "
					a id="updating-the-image-data:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- " is not "
					a href="#fully-active" id="updating-the-image-data:fully-active" {
						- "fully active"
					}
					- ", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Continue running this algorithm "
							a href="#in-parallel" id="updating-the-image-data:in-parallel-3" {
								- "in parallel"
							}
							- "."
						}
					}
					li {
						p {
							- "Wait until the element's "
							a id="updating-the-image-data:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node document"
							}
							- " is "
							a href="#fully-active" id="updating-the-image-data:fully-active-2" {
								- "fully\n     active"
							}
							- "."
						}
					}
					li {
						p {
							- "If another instance of this algorithm for this "
							code id="updating-the-image-data:the-img-element-2" {
								a href="#the-img-element" {
									- "img"
								}
							}
							- " element was started after this instance\n     (even if it aborted and is no longer running), then return."
						}
					}
					li {
						p {
							a href="#queue-a-microtask" id="updating-the-image-data:queue-a-microtask" {
								- "Queue a microtask"
							}
							- " to continue this algorithm."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If the user agent cannot support images, or its support for images has been disabled, then\n   "
					a href="#abort-the-image-request" id="updating-the-image-data:abort-the-image-request" {
						- "abort the image request"
					}
					- " for the "
					a href="#current-request" id="updating-the-image-data:current-request" {
						- "current request"
					}
					- " and the "
					a href="#pending-request" id="updating-the-image-data:pending-request" {
						- "pending\n   request"
					}
					- ", set "
					a href="#current-request" id="updating-the-image-data:current-request-2" {
						- "current request"
					}
					- "'s "
					a href="#img-req-state" id="updating-the-image-data:img-req-state" {
						- "state"
					}
					- " to\n   "
					a href="#img-none" id="updating-the-image-data:img-none" {
						- "unavailable"
					}
					- ", set "
					a href="#pending-request" id="updating-the-image-data:pending-request-2" {
						- "pending request"
					}
					- " to null, and\n   return."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "previous URL"
					}
					- " be the "
					a href="#current-request" id="updating-the-image-data:current-request-3" {
						- "current request"
					}
					- "'s "
					a href="#img-req-url" id="updating-the-image-data:img-req-url" {
						- "current URL"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "selected source"
					}
					- " be null and "
					var {
						- "selected pixel density"
					}
					- " be undefined.\n\n   "
				}
			}
			li {
				p {
					- "If the element does not "
					a href="#use-srcset-or-picture" id="updating-the-image-data:use-srcset-or-picture" {
						- "use "
						code {
							- "srcset"
						}
						- " or "
						code {
							- "picture"
						}
					}
					- " and\n   it has a "
					code id="updating-the-image-data:attr-img-src" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- " attribute specified whose value is not the empty\n   string, then set "
					var {
						- "selected source"
					}
					- " to the value of the element's "
					code id="updating-the-image-data:attr-img-src-2" {
						a href="#attr-img-src" {
							- "src"
						}
					}
					- " attribute and set "
					var {
						- "selected pixel density"
					}
					- " to\n   1.0."
				}
			}
			li {
				p {
					- "Set the element's "
					a href="#last-selected-source" id="updating-the-image-data:last-selected-source" {
						- "last selected source"
					}
					- " to "
					var {
						- "selected\n   source"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "selected source"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "urlString"
							}
							- " be the result of "
							a href="#encoding-parsing-and-serializing-a-url" id="updating-the-image-data:encoding-parsing-and-serializing-a-url" {
								- "encoding-parsing-and-serializing a\n     URL"
							}
							- " given "
							var {
								- "selected source"
							}
							- ", relative to the element's "
							a id="updating-the-image-data:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node\n     document"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "urlString"
							}
							- " is failure, then abort this inner set of steps."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "key"
							}
							- " be a tuple consisting of "
							var {
								- "urlString"
							}
							- ", the "
							code id="updating-the-image-data:the-img-element-3" {
								a href="#the-img-element" {
									- "img"
								}
							}
							- "\n     element's "
							code id="updating-the-image-data:attr-img-crossorigin" {
								a href="#attr-img-crossorigin" {
									- "crossorigin"
								}
							}
							- " attribute's mode, and, if that\n     mode is not "
							a href="#attr-crossorigin-none" id="updating-the-image-data:attr-crossorigin-none" {
								- "No CORS"
							}
							- ", the "
							a id="updating-the-image-data:node-document-4" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node\n     document"
							}
							- "'s "
							a href="https://dom.spec.whatwg.org/#concept-document-origin" id="updating-the-image-data:concept-document-origin" data-x-internal="concept-document-origin" {
								- "origin"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "If the "
							a href="#list-of-available-images" id="updating-the-image-data:list-of-available-images" {
								- "list of available images"
							}
							- " contains an entry for "
							var {
								- "key"
							}
							- ",\n      then:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Set the "
									a href="#ignore-higher-layer-caching" id="updating-the-image-data:ignore-higher-layer-caching" {
										- "ignore higher-layer caching"
									}
									- " flag for that entry."
								}
							}
							li {
								p {
									a href="#abort-the-image-request" id="updating-the-image-data:abort-the-image-request-2" {
										- "Abort the image request"
									}
									- " for the "
									a href="#current-request" id="updating-the-image-data:current-request-4" {
										- "current request"
									}
									- " and the\n       "
									a href="#pending-request" id="updating-the-image-data:pending-request-3" {
										- "pending request"
									}
									- "."
								}
							}
							li {
								p {
									- "Set "
									a href="#pending-request" id="updating-the-image-data:pending-request-4" {
										- "pending request"
									}
									- " to null."
								}
							}
							li {
								p {
									- "Let "
									a href="#current-request" id="updating-the-image-data:current-request-5" {
										- "current request"
									}
									- " be a new "
									a href="#image-request" id="updating-the-image-data:image-request" {
										- "image request"
									}
									- " whose "
									a href="#img-req-data" id="updating-the-image-data:img-req-data" {
										- "image data"
									}
									- " is that of the entry and whose "
									a href="#img-req-state" id="updating-the-image-data:img-req-state-2" {
										- "state"
									}
									- " is "
									a href="#img-all" id="updating-the-image-data:img-all" {
										- "completely\n       available"
									}
									- "."
								}
							}
							li {
								p {
									a href="#prepare-an-image-for-presentation" id="updating-the-image-data:prepare-an-image-for-presentation" {
										- "Prepare "
										var {
