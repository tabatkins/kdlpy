							}
							- ", then set "
							var {
								- "mode"
							}
							- "\n     to "
							i {
								- "local"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "mode"
					}
					- " is "
					i {
						- "remote"
					}
					- ", then let the "
					var {
						- "current media resource"
					}
					- " be the\n   resource given by the "
					a id="loading-the-media-resource:url-record-3" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url-record" {
						- "URL record"
					}
					- " passed to this algorithm; otherwise, let the\n   "
