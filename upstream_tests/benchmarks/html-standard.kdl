		- "\n\n  "
		p {
			strong {
				- "The "
				a href="#concept-input-value-string-number" id="local-date-and-time-state-(type=datetime-local):concept-input-value-string-number" {
					- "algorithm to convert a string to a\n  number"
				}
				- ", given a string "
				var {
					- "input"
				}
				- ", is as follows"
			}
			- ": If "
			a href="#parse-a-local-date-and-time-string" id="local-date-and-time-state-(type=datetime-local):parse-a-local-date-and-time-string-2" {
				- "parsing a date and time"
			}
			- " from "
			var {
				- "input"
			}
			- " results in an error, then return an error; otherwise, return the number of\n  milliseconds elapsed from midnight on the morning of 1970-01-01 (the time represented by the value\n  \""
			code {
				- "1970-01-01T00:00:00.0"
			}
