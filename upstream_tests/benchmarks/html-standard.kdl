		- "\n\n  "
		p {
			- "The attribute's "
			i id="the-area-element:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="the-area-element:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both the "
			a href="#attr-area-shape-rect" id="the-area-element:attr-area-shape-rect-2" {
				- "rectangle"
			}
			- " state."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="area" id="attr-area-coords" data-dfn-type="element-attr" {
				code {
					- "coords"
				}
			}
			- " attribute\n  must, if specified, contain a "
			a href="#valid-list-of-floating-point-numbers" id="the-area-element:valid-list-of-floating-point-numbers" {
				- "valid list of floating-point numbers"
			}
			- ". This attribute\n  gives the coordinates for the shape described by the "
			code id="the-area-element:attr-area-shape-3" {
				a href="#attr-area-shape" {
					- "shape"
				}
			}
			- "\n  attribute. The processing for this attribute is described as part of the "
			a href="#image-map" id="the-area-element:image-map-6" {
				- "image\n  map"
			}
			- " processing model."
		}
		- "\n\n  \n\n  "
		p {
			- "In the "
			dfn data-dfn-for="area/shape" id="attr-area-shape-circle" data-dfn-type="attr-value" {
				- "circle state"
			}
			- ",\n  "
			code id="the-area-element:the-area-element-7" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements must have a "
			code id="the-area-element:attr-area-coords-7" {
				a href="#attr-area-coords" {
					- "coords"
				}
			}
			- " attribute\n  present, with three integers, the last of which must be non-negative. The first integer must be\n  the distance in "
			a href="https://drafts.csswg.org/css-values/#px" id="the-area-element:'px'" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- " from the left edge of the image to the\n  center of the circle, the second integer must be the distance in "
			a href="https://drafts.csswg.org/css-values/#px" id="the-area-element:'px'-2" data-x-internal="'px'" {
				- "CSS\n  pixels"
			}
			- " from the top edge of the image to the center of the circle, and the third integer\n  must be the radius of the circle, again in "
			a href="https://drafts.csswg.org/css-values/#px" id="the-area-element:'px'-3" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "In the "
			dfn data-dfn-for="area/shape" id="attr-area-shape-default" data-dfn-type="attr-value" {
				- "default state"
			}
			- ",\n  "
			code id="the-area-element:the-area-element-8" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements must not have a "
			code id="the-area-element:attr-area-coords-8" {
				a href="#attr-area-coords" {
					- "coords"
				}
			}
			- "\n  attribute. (The area is the whole image.)"
		}
		- "\n\n  "
		p {
			- "In the "
			dfn data-dfn-for="area/shape" id="attr-area-shape-poly" data-dfn-type="attr-value" {
				- "polygon state"
			}
			- ",\n  "
			code id="the-area-element:the-area-element-9" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements must have a "
			code id="the-area-element:attr-area-coords-9" {
				a href="#attr-area-coords" {
					- "coords"
				}
			}
			- " attribute\n  with at least six integers, and the number of integers must be even. Each pair of integers must\n  represent a coordinate given as the distances from the left and the top of the image in "
			a href="https://drafts.csswg.org/css-values/#px" id="the-area-element:'px'-4" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- " respectively, and all the coordinates together must represent the\n  points of the polygon, in order."
		}
		- "\n\n  "
		p {
			- "In the "
			dfn data-dfn-for="area/shape" id="attr-area-shape-rect" data-dfn-type="attr-value" {
				- "rectangle state"
			}
			- ",\n  "
			code id="the-area-element:the-area-element-10" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements must have a "
			code id="the-area-element:attr-area-coords-10" {
				a href="#attr-area-coords" {
					- "coords"
				}
			}
			- " attribute\n  with exactly four integers, the first of which must be less than the third, and the second of\n  which must be less than the fourth. The four points must represent, respectively, the distance\n  from the left edge of the image to the left side of the rectangle, the distance from the top edge\n  to the top side, the distance from the left edge to the right side, and the distance from the top\n  edge to the bottom side, all in "
			a href="https://drafts.csswg.org/css-values/#px" id="the-area-element:'px'-5" data-x-internal="'px'" {
				- "CSS pixels"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "When user agents allow users to "
			a href="#following-hyperlinks-2" id="the-area-element:following-hyperlinks-2" {
				- "follow hyperlinks"
			}
			- " or\n  "
			a href="#downloading-hyperlinks" id="the-area-element:downloading-hyperlinks" {
				- "download hyperlinks"
			}
			- " created using the\n  "
			code id="the-area-element:the-area-element-11" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " element, the "
			code id="the-area-element:attr-hyperlink-href-5" {
				a href="#attr-hyperlink-href" {
					- "href"
				}
			}
			- ", "
			code id="the-area-element:attr-hyperlink-target-2" {
				a href="#attr-hyperlink-target" {
					- "target"
				}
			}
			- ", "
			code id="the-area-element:attr-hyperlink-download-2" {
				a href="#attr-hyperlink-download" {
					- "download"
				}
			}
			- ", and "
			code id="the-area-element:ping-2" {
				a href="#ping" {
					- "ping"
				}
			}
			- " attributes decide how the link is followed. The "
			code id="the-area-element:attr-hyperlink-rel-2" {
				a href="#attr-hyperlink-rel" {
					- "rel"
				}
			}
			- " attribute may be used to indicate to the user the likely\n  nature of the target resource before the user follows the link."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="the-area-element:attr-hyperlink-target-3" {
				a href="#attr-hyperlink-target" {
					- "target"
				}
			}
			- ", "
			code id="the-area-element:attr-hyperlink-download-3" {
				a href="#attr-hyperlink-download" {
					- "download"
				}
			}
			- ", "
			code id="the-area-element:ping-3" {
				a href="#ping" {
					- "ping"
				}
			}
			- ",\n  "
			code id="the-area-element:attr-hyperlink-rel-3" {
				a href="#attr-hyperlink-rel" {
					- "rel"
				}
			}
			- ", and "
			code id="the-area-element:attr-hyperlink-referrerpolicy-2" {
				a href="#attr-hyperlink-referrerpolicy" {
					- "referrerpolicy"
				}
			}
			- " attributes must be omitted if the\n  "
			code id="the-area-element:attr-hyperlink-href-6" {
				a href="#attr-hyperlink-href" {
					- "href"
				}
			}
			- " attribute is not present."
		}
		- "\n\n  "
		p {
			- "If the "
			code id="the-area-element:names:-the-itemprop-attribute" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute is specified on an\n  "
			code id="the-area-element:the-area-element-12" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " element, then the "
			code id="the-area-element:attr-hyperlink-href-7" {
				a href="#attr-hyperlink-href" {
					- "href"
				}
			}
			- " attribute must\n  also be specified."
		}
		- "\n\n  \n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLAreaElement/rel" title="The HTMLAreaElement.rel property reflects the rel attribute. It is a string containing a space-separated list of link types indicating the relationship between the resource represented by the <area> element and the current document." {
						- "HTMLAreaElement/rel"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "30+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "9+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "54+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "11"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The IDL attributes "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-alt" data-dfn-type="attribute" {
				code {
					- "alt"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-coords" data-dfn-type="attribute" {
				code {
					- "coords"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-shape" data-dfn-type="attribute" {
				code {
					- "shape"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-target" data-dfn-type="attribute" {
				code {
					- "target"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-download" data-dfn-type="attribute" {
				code {
					- "download"
				}
			}
			- ", "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-ping" data-dfn-type="attribute" {
				code {
					- "ping"
				}
			}
			- ", and "
			dfn data-dfn-for="HTMLAreaElement" id="dom-area-rel" data-dfn-type="attribute" {
				code {
					- "rel"
				}
			}
			- ", each must "
			a href="#reflect" id="the-area-element:reflect" {
				- "reflect"
			}
			- " the respective content\n  attributes of the same name."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLAreaElement/relList" title="The HTMLAreaElement.relList read-only property reflects the rel attribute. It is a live DOMTokenList containing the set of link types indicating the relationship between the resource represented by the <area> element and the current document." {
						- "HTMLAreaElement/relList"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "30+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "9+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "65+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "41+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
