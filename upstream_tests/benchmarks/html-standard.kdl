			- "'s "
			a href="https://dom.spec.whatwg.org/#concept-document-origin" id="read-ua-inline:concept-document-origin" data-x-internal="concept-document-origin" {
				- "origin"
			}
			- " is "
			a href="#concept-origin-opaque" id="read-ua-inline:concept-origin-opaque-2" {
				- "opaque"
			}
			- ", and the resulting "
			code id="read-ua-inline:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- " cannot run\n  script with access to the DOM, the existence and properties of this "
			code id="read-ua-inline:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- " are not\n  observable to web developer code. This means that most of the above values, e.g., the\n  "
			code id="read-ua-inline:text/html" {
				a href="#text/html" {
					- "text/html"
				}
			}
