					}
					- ", then jump to the step labeled "
					i {
						- "default"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "category"
					}
					- " is Off, let the element's "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-2" {
						- "autofill field name"
					}
					- "\n   be the string \""
					code {
						- "off"
					}
					- "\", let its "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-3" {
						- "autofill hint set"
					}
					- " be empty, and\n   let its "
					a href="#idl-exposed-autofill-value" id="autofill-processing-model:idl-exposed-autofill-value" {
						- "IDL-exposed autofill value"
					}
					- " be the string \""
					code {
						- "off"
					}
					- "\". Then,\n   return."
				}
				- "\n\n   "
			}
			li {
				p {
					- "If "
					var {
						- "category"
					}
					- " is Automatic, let the element's "
					a href="#autofill-field-name" id="autofill-processing-model:autofill-field-name-3" {
						- "autofill field\n   name"
					}
					- " be the string \""
					code {
						- "on"
					}
					- "\", let its "
					a href="#autofill-hint-set" id="autofill-processing-model:autofill-hint-set-4" {
						- "autofill hint set"
					}
					- " be\n   empty, and let its "
					a href="#idl-exposed-autofill-value" id="autofill-processing-model:idl-exposed-autofill-value-2" {
						- "IDL-exposed autofill value"
					}
					- " be the string \""
					code {
						- "on"
					}
					- "\". Then, return."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "scope tokens"
					}
					- " be an empty list."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "hint tokens"
					}
					- " be an empty set."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "credential type"
					}
					- " be null."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "IDL value"
					}
					- " have the same value as "
					var {
						- "field"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "category"
					}
					- " is Credential and the "
					var {
						- "index"
					}
					- "th token in "
					var {
						- "tokens"
					}
					- " is\n    an "
					a id="autofill-processing-model:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for \""
					code id="autofill-processing-model:attr-fe-autocomplete-webauthn" {
						a href="#attr-fe-autocomplete-webauthn" {
							- "webauthn"
						}
					}
					- "\", then run the substeps that follow:"
				}
				- "\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "credential type"
							}
							- " to \""
							code {
								- "webauthn"
							}
							- "\"."
						}
					}
					li {
						p {
							- "If the "
							var {
								- "index"
							}
							- "th token in "
							var {
								- "tokens"
							}
							- " is the first entry,\n     then skip to the step labeled "
							i {
								- "done"
							}
							- "."
						}
					}
					li {
						p {
							- "Decrement "
							var {
								- "index"
							}
							- " by one."
						}
					}
					li {
						p {
							- "Set the "
							var {
								- "category"
							}
							- ", "
							var {
								- "maximum tokens"
							}
							- " pair to the result of "
							a href="#determine-a-field's-category" id="autofill-processing-model:determine-a-field's-category-2" {
								- "determining a field's category"
							}
							- " given\n     the "
							var {
								- "index"
							}
							- "th token in "
							var {
								- "tokens"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "category"
							}
							- " is not Normal and "
							var {
								- "category"
							}
							- " is not Contact, then jump to\n     the step labeled "
							i {
								- "default"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "index"
							}
							- " is greater than "
							var {
								- "maximum tokens"
							}
							- " minus one (i.e. if the\n     number of remaining tokens is greater than "
							var {
								- "maximum tokens"
							}
