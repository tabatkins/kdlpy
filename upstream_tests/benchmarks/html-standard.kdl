			}
			dd {
				p {
					- "Prompts the user to print the page."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="Window" id="dom-print" data-dfn-type="method" {
				code {
					- "print()"
				}
			}
			- " method steps\n  are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "document"
					}
					- " be "
					a id="printing:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#concept-document-window" id="printing:concept-document-window" {
						- "associated "
						code {
							- "Document"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- " is not "
					a href="#fully-active" id="printing:fully-active" {
						- "fully active"
					}
					- ", then return."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- "'s "
					a href="#unload-counter" id="printing:unload-counter" {
						- "unload counter"
					}
					- " is greater than 0, then\n   return."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- " is "
					a href="#ready-for-post-load-tasks" id="printing:ready-for-post-load-tasks" {
						- "ready for post-load tasks"
					}
					- ", then run the\n   "
					a href="#printing-steps" id="printing:printing-steps" {
						- "printing steps"
					}
					- " for "
					var {
						- "document"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, set "
					var {
						- "document"
					}
					- "'s "
					dfn id="print-when-loaded" {
						- "print when loaded"
					}
					- " flag."
				}
			}
		}
		- "\n\n  "
		p {
			- "User agents should also run the "
			a href="#printing-steps" id="printing:printing-steps-2" {
				- "printing steps"
			}
			- " whenever the user asks for the\n  opportunity to "
			a href="#obtain-a-physical-form" id="printing:obtain-a-physical-form" {
				- "obtain a physical form"
			}
			- " (e.g. printed copy), or the representation of a\n  physical form (e.g. PDF copy), of a document."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="printing-steps" {
				- "printing steps"
			}
			- " for a "
			code id="printing:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " "
			var {
				- "document"
			}
			- " are:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "The user agent may display a message to the user or return (or both)."
				}
				- "\n\n    "
				p class="example" {
					- "For instance, a kiosk browser could silently ignore any invocations of the\n    "
					code id="printing:dom-print" {
						a href="#dom-print" {
							- "print()"
						}
					}
					- " method."
				}
				- "\n\n    "
				p class="example" {
					- "For instance, a browser on a mobile device could detect that there are no\n    printers in the vicinity and display a message saying so before continuing to offer a \"save to\n    PDF\" option."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					a href="#active-sandboxing-flag-set" id="printing:active-sandboxing-flag-set" {
						- "active sandboxing flag set"
					}
					- " of "
					var {
						- "document"
					}
					- " has the "
					a href="#sandboxed-modals-flag" id="printing:sandboxed-modals-flag" {
						- "sandboxed\n    modals flag"
					}
					- " set, then return."
				}
				- "\n\n    "
				p class="note" {
					- "If the printing dialog is blocked by a "
					code id="printing:document-2" {
						a href="#document" {
							- "Document"
						}
					}
					- "'s sandbox,\n    then neither the "
					code id="printing:event-beforeprint" {
						a href="#event-beforeprint" {
							- "beforeprint"
						}
					}
					- " nor "
					code id="printing:event-afterprint" {
						a href="#event-afterprint" {
							- "afterprint"
						}
					}
					- " events will be fired."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "The user agent must "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="printing:concept-event-fire" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named "
					code id="printing:event-beforeprint-2" {
						a href="#event-beforeprint" {
							- "beforeprint"
						}
					}
					- " at the "
					a href="#concept-relevant-global" id="printing:concept-relevant-global" {
						- "relevant global object"
					}
					- " of\n    "
					var {
						- "document"
					}
					- ", as well as any "
					a href="#child-navigable" id="printing:child-navigable" {
						- "child navigable"
					}
					- " in\n    it."
				}
				- "\n\n    "
				p class="XXX" {
					- "Firing in children only doesn't seem right here, and some tasks likely need to\n    be queued. See "
					a href="https://github.com/whatwg/html/issues/5096" {
						- "issue #5096"
					}
					- "."
				}
				- "\n\n    "
				p class="example" {
					- "The "
					code id="printing:event-beforeprint-3" {
						a href="#event-beforeprint" {
							- "beforeprint"
						}
					}
					- " event can be used to\n    annotate the printed copy, for instance adding the time at which the document was printed."
				}
				- "\n   "
			}
			li {
				p {
					- "The user agent should offer the user the opportunity to "
					a href="#obtain-a-physical-form" id="printing:obtain-a-physical-form-2" {
						- "obtain a physical\n   form"
					}
					- " (or the representation of a physical form) of "
					var {
						- "document"
					}
					- ". The user agent may\n   wait for the user to either accept or decline before returning; if so, the user agent must\n   "
					a href="#pause" id="printing:pause" {
						- "pause"
					}
					- " while the method is waiting. Even if the user agent doesn't wait at this\n   point, the user agent must use the state of the relevant documents as they are at this point in\n   the algorithm if and when it eventually creates the alternate form."
				}
			}
			li {
				- "\n    "
				p {
					- "The user agent must "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="printing:concept-event-fire-2" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named "
					code id="printing:event-afterprint-2" {
						a href="#event-afterprint" {
							- "afterprint"
						}
					}
					- " at the "
					a href="#concept-relevant-global" id="printing:concept-relevant-global-2" {
						- "relevant global object"
					}
					- " of\n    "
					var {
						- "document"
					}
					- ", as well as any "
					a href="#child-navigable" id="printing:child-navigable-2" {
						- "child navigables"
					}
					- " in\n    it."
				}
				- "\n\n    "
				p class="XXX" {
					- "Firing in children only doesn't seem right here, and some tasks likely need to\n    be queued. See "
					a href="https://github.com/whatwg/html/issues/5096" {
						- "issue #5096"
