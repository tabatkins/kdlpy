				- "Consume those characters and switch to the "
				a href="#doctype-state" id="markup-declaration-open-state:doctype-state" {
					- "DOCTYPE state"
				}
				- "."
			}
			dt {
				- "The string \"[CDATA[\" (the five uppercase letters \"CDATA\" with a U+005B LEFT SQUARE BRACKET\n   character before and after)"
			}
			dd {
				- "Consume those characters. If there is an "
				a href="#adjusted-current-node" id="markup-declaration-open-state:adjusted-current-node" {
					- "adjusted current node"
				}
				- " and it is not\n   an element in the "
				a id="markup-declaration-open-state:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
					- "HTML namespace"
				}
				- ", then switch to the "
				a href="#cdata-section-state" id="markup-declaration-open-state:cdata-section-state" {
					- "CDATA section\n   state"
				}
				- ". Otherwise, this is a "
				a href="#parse-error-cdata-in-html-content" id="markup-declaration-open-state:parse-error-cdata-in-html-content" {
					- "cdata-in-html-content"
				}
				- " "
				a href="#parse-errors" id="markup-declaration-open-state:parse-errors" {
					- "parse\n   error"
				}
				- ". Create a comment token whose data is the \"[CDATA[\" string. Switch to the\n   "
				a href="#bogus-comment-state" id="markup-declaration-open-state:bogus-comment-state" {
					- "bogus comment state"
				}
				- "."
			}
			dt {
				- "Anything else"
			}
			dd {
				- "This is an "
				a href="#parse-error-incorrectly-opened-comment" id="markup-declaration-open-state:parse-error-incorrectly-opened-comment" {
					- "incorrectly-opened-comment"
				}
				- "\n   "
				a href="#parse-errors" id="markup-declaration-open-state:parse-errors-2" {
					- "parse error"
				}
				- ". Create a comment token whose data is the empty string. Switch to the\n   "
				a href="#bogus-comment-state" id="markup-declaration-open-state:bogus-comment-state-2" {
					- "bogus comment state"
				}
				- " (don't consume anything in the current state)."
			}
		}
