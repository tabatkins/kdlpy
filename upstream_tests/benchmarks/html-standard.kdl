		- "\n\n  "
		p {
			- "The "
			code id="the-textarea-element:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element "
			a href="#represents" id="the-textarea-element:represents" {
				- "represents"
			}
			- " a multiline plain text edit\n  control for the element's "
			dfn id="concept-textarea-raw-value" {
				- "raw\n  value"
			}
			- ". The contents of the control represent the control's default value."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value" {
				- "raw value"
			}
			- " of a "
			code id="the-textarea-element:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- "\n  control must be initially the empty string."
		}
		- "\n\n  "
		p class="note" {
			- "This element "
			a href="#bidireq" {
				- "has rendering requirements involving the\n  bidirectional algorithm"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="textarea" id="attr-textarea-readonly" data-dfn-type="element-attr" {
				code {
					- "readonly"
				}
			}
			- " attribute is a "
			a href="#boolean-attribute" id="the-textarea-element:boolean-attribute" {
				- "boolean\n  attribute"
			}
			- " used to control whether the text can be edited by the user or not."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In this example, a text control is marked read-only because it represents a read-only\n   file:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					- "Filename: "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "code"
					}
					c- p="" {
						- ">"
					}
					- "/etc/bash.bashrc"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "code"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "textarea"
					}
					- " "
					c- e="" {
						- "name"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"buffer\""
					}
					- " "
					c- e="" {
						- "readonly"
					}
					c- p="" {
						- ">"
					}
					- "\n# System-wide .bashrc file for interactive bash(1) shells.\n\n# To enable the settings / commands in this file for login shells as well,\n# this file has to be sourced in /etc/profile.\n\n# If not running interactively, don't do anything\n[ -z \"$PS1\" ] "
					c- ni="" {
						- "&amp;&amp;"
					}
					- " return\n\n..."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "textarea"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": If the "
			code id="the-textarea-element:attr-textarea-readonly-2" {
				a href="#attr-textarea-readonly" {
					- "readonly"
				}
			}
			- " attribute is specified on a "
			code id="the-textarea-element:the-textarea-element-3" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- "\n  element, the element is "
			a href="#barred-from-constraint-validation" id="the-textarea-element:barred-from-constraint-validation" {
				- "barred from constraint validation"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			code id="the-textarea-element:the-textarea-element-4" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element is "
			a href="#concept-fe-mutable" id="the-textarea-element:concept-fe-mutable" {
				- "mutable"
			}
			- " if it is\n  neither "
			a href="#concept-fe-disabled" id="the-textarea-element:concept-fe-disabled" {
				- "disabled"
			}
			- " nor has a "
			code id="the-textarea-element:attr-textarea-readonly-3" {
				a href="#attr-textarea-readonly" {
					- "readonly"
				}
			}
			- " attribute specified."
		}
		- "\n\n  "
		p {
			- "When a "
			code id="the-textarea-element:the-textarea-element-5" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " is "
			a href="#concept-fe-mutable" id="the-textarea-element:concept-fe-mutable-2" {
				- "mutable"
			}
			- ", its "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-2" {
				- "raw value"
			}
			- " should be editable by the user: the user\n  agent should allow the user to edit, insert, and remove text, and to insert and remove line breaks\n  in the form of U+000A LINE FEED (LF) characters. Any time the user causes the element's "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-3" {
				- "raw value"
			}
			- " to change, the user agent must "
			a href="#queue-an-element-task" id="the-textarea-element:queue-an-element-task" {
				- "queue an\n  element task"
			}
			- " on the "
			a href="#user-interaction-task-source" id="the-textarea-element:user-interaction-task-source" {
				- "user interaction task source"
			}
			- " given the\n  "
			code id="the-textarea-element:the-textarea-element-6" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-textarea-element:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named\n  "
			code id="the-textarea-element:event-input" {
				a data-x-internal="event-input" href="https://w3c.github.io/uievents/#event-type-input" {
					- "input"
				}
			}
			- " at the "
			code id="the-textarea-element:the-textarea-element-7" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element, with the "
			code id="the-textarea-element:dom-event-bubbles" {
				a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
					- "bubbles"
				}
			}
			- " and "
			code id="the-textarea-element:dom-event-composed" {
				a data-x-internal="dom-event-composed" href="https://dom.spec.whatwg.org/#dom-event-composed" {
					- "composed"
				}
			}
			- "\n  attributes initialized to true. User agents may wait for a suitable break in the user's\n  interaction before queuing the task; for example, a user agent could wait for the user to have not\n  hit a key for 100ms, so as to only fire the event when the user pauses, instead of continuously\n  for each keystroke."
		}
		- "\n  \n\n  "
		p {
			- "A "
			code id="the-textarea-element:the-textarea-element-8" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element's "
			a href="#concept-fe-dirty" id="the-textarea-element:concept-fe-dirty" {
				- "dirty value flag"
			}
			- " must\n  be set to true whenever the user interacts with the control in a way that changes the "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-4" {
				- "raw value"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="https://dom.spec.whatwg.org/#concept-node-clone-ext" id="the-textarea-element:concept-node-clone-ext" data-x-internal="concept-node-clone-ext" {
				- "cloning steps"
			}
			- " for "
			code id="the-textarea-element:the-textarea-element-9" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- "\n  elements given "
			var {
				- "node"
			}
			- ", "
			var {
				- "copy"
			}
			- ", and "
			var {
				- "subtree"
			}
			- " are to propagate the "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-5" {
				- "raw value"
			}
			- " and "
			a href="#concept-fe-dirty" id="the-textarea-element:concept-fe-dirty-2" {
				- "dirty\n  value flag"
			}
			- " from "
			var {
				- "node"
			}
			- " to "
			var {
				- "copy"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a id="the-textarea-element:children-changed-steps" href="https://dom.spec.whatwg.org/#concept-node-children-changed-ext" data-x-internal="children-changed-steps" {
				- "children changed steps"
			}
			- " for "
			code id="the-textarea-element:the-textarea-element-10" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements must, if the\n  element's "
			a href="#concept-fe-dirty" id="the-textarea-element:concept-fe-dirty-3" {
				- "dirty value flag"
			}
			- " is false, set the element's\n  "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-6" {
				- "raw value"
			}
			- " to its "
			a id="the-textarea-element:child-text-content" href="https://dom.spec.whatwg.org/#concept-child-text-content" data-x-internal="child-text-content" {
				- "child text\n  content"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#concept-form-reset-control" id="the-textarea-element:concept-form-reset-control" {
				- "reset algorithm"
			}
			- " for "
			code id="the-textarea-element:the-textarea-element-11" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- "\n  elements is to set the "
			a href="#user-validity" id="the-textarea-element:user-validity" {
				- "user validity"
			}
			- " to false, "
			a href="#concept-fe-dirty" id="the-textarea-element:concept-fe-dirty-4" {
				- "dirty value flag"
			}
			- " back to false, and set the "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-7" {
				- "raw value"
			}
			- " of element to its "
			a id="the-textarea-element:child-text-content-2" href="https://dom.spec.whatwg.org/#concept-child-text-content" data-x-internal="child-text-content" {
				- "child text\n  content"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When a "
			code id="the-textarea-element:the-textarea-element-12" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element is popped off the "
			a href="#stack-of-open-elements" id="the-textarea-element:stack-of-open-elements" {
				- "stack of open elements"
			}
			- " of\n  an "
			a href="#html-parser" id="the-textarea-element:html-parser" {
				- "HTML parser"
			}
			- " or "
			a href="#xml-parser" id="the-textarea-element:xml-parser" {
				- "XML parser"
			}
			- ", then the user agent must invoke the\n  element's "
			a href="#concept-form-reset-control" id="the-textarea-element:concept-form-reset-control-2" {
				- "reset algorithm"
			}
			- "."
		}
		- "\n\n  \n  \n  "
		p {
			- "If the element is "
			a href="#concept-fe-mutable" id="the-textarea-element:concept-fe-mutable-3" {
				- "mutable"
			}
			- ", the user agent should allow\n  the user to change the writing direction of the element, setting it either to a left-to-right\n  writing direction or a right-to-left writing direction. If the user does so, the user agent must\n  then run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set the element's "
					code id="the-textarea-element:attr-dir" {
						a href="#attr-dir" {
							- "dir"
						}
					}
					- " attribute to \""
					code id="the-textarea-element:attr-dir-ltr" {
						a href="#attr-dir-ltr" {
							- "ltr"
						}
					}
					- "\" if the user selected a left-to-right writing direction, and\n   \""
					code id="the-textarea-element:attr-dir-rtl" {
						a href="#attr-dir-rtl" {
							- "rtl"
						}
					}
					- "\" if the user selected a right-to-left writing\n   direction."
				}
			}
			li {
				p {
					a href="#queue-an-element-task" id="the-textarea-element:queue-an-element-task-2" {
						- "Queue an element task"
					}
					- " on the "
					a href="#user-interaction-task-source" id="the-textarea-element:user-interaction-task-source-2" {
						- "user interaction task source"
					}
					- " given\n   the "
					code id="the-textarea-element:the-textarea-element-13" {
						a href="#the-textarea-element" {
							- "textarea"
						}
					}
					- " element to "
					a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-textarea-element:concept-event-fire-2" data-x-internal="concept-event-fire" {
						- "fire an event"
					}
					- " named\n   "
					code id="the-textarea-element:event-input-2" {
						a data-x-internal="event-input" href="https://w3c.github.io/uievents/#event-type-input" {
							- "input"
						}
					}
					- " at the "
					code id="the-textarea-element:the-textarea-element-14" {
						a href="#the-textarea-element" {
							- "textarea"
						}
					}
					- " element, with the "
					code id="the-textarea-element:dom-event-bubbles-2" {
						a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
							- "bubbles"
						}
					}
					- " and "
					code id="the-textarea-element:dom-event-composed-2" {
						a data-x-internal="dom-event-composed" href="https://dom.spec.whatwg.org/#dom-event-composed" {
							- "composed"
						}
					}
					- "\n   attributes initialized to true."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="textarea" id="attr-textarea-cols" data-dfn-type="element-attr" {
				code {
					- "cols"
				}
			}
			- "\n  attribute specifies the expected maximum number of characters per line. If the "
			code id="the-textarea-element:attr-textarea-cols-2" {
				a href="#attr-textarea-cols" {
					- "cols"
				}
			}
			- " attribute is specified, its value must be a "
			a href="#valid-non-negative-integer" id="the-textarea-element:valid-non-negative-integer" {
				- "valid\n  non-negative integer"
			}
			- " greater than zero. If applying the "
			a href="#rules-for-parsing-non-negative-integers" id="the-textarea-element:rules-for-parsing-non-negative-integers" {
				- "rules for\n  parsing non-negative integers"
			}
			- " to the attribute's value results in a number greater than\n  zero, then the element's "
			dfn id="attr-textarea-cols-value" {
				- "character width"
			}
			- " is that\n  value; otherwise, it is 20."
		}
		- "\n\n  \n\n  "
		p {
			- "The user agent may use the "
			code id="the-textarea-element:the-textarea-element-15" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element's "
			a href="#attr-textarea-cols-value" id="the-textarea-element:attr-textarea-cols-value" {
				- "character width"
			}
			- " as a hint to the user as to how many\n  characters the server prefers per line (e.g. for visual user agents by making the width of the\n  control be that many characters). In visual renderings, the user agent should wrap the user's\n  input in the rendering so that each line is no wider than this number of characters."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="textarea" id="attr-textarea-rows" data-dfn-type="element-attr" {
				code {
					- "rows"
				}
			}
			- "\n  attribute specifies the number of lines to show. If the "
			code id="the-textarea-element:attr-textarea-rows-2" {
				a href="#attr-textarea-rows" {
					- "rows"
				}
			}
			- " attribute is specified, its value must be a "
			a href="#valid-non-negative-integer" id="the-textarea-element:valid-non-negative-integer-2" {
				- "valid\n  non-negative integer"
			}
			- " greater than zero. If applying the "
			a href="#rules-for-parsing-non-negative-integers" id="the-textarea-element:rules-for-parsing-non-negative-integers-2" {
				- "rules for\n  parsing non-negative integers"
			}
			- " to the attribute's value results in a number greater than\n  zero, then the element's "
			dfn id="attr-textarea-rows-value" {
				- "character height"
			}
			- " is that\n  value; otherwise, it is 2."
		}
		- "\n\n  \n\n  "
		p {
			- "Visual user agents should set the height of the control to the number of lines given by "
			a href="#attr-textarea-rows-value" id="the-textarea-element:attr-textarea-rows-value" {
				- "character height"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			dfn data-dfn-for="textarea" id="attr-textarea-wrap" data-dfn-type="element-attr" {
				code {
					- "wrap"
				}
			}
			- "\n  attribute is an "
			a href="#enumerated-attribute" id="the-textarea-element:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="textarea/wrap" id="attr-textarea-wrap-soft" data-dfn-type="attr-value" {
							code {
								- "soft"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-textarea-wrap-soft-state" {
							- "Soft"
						}
						- "\n     "
					}
					td {
						- "Text is not to be wrapped when submitted (though can still be wrapped in the rendering).\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="textarea/wrap" id="attr-textarea-wrap-hard" data-dfn-type="attr-value" {
							code {
								- "hard"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-textarea-wrap-hard-state" {
							- "Hard"
						}
						- "\n     "
					}
					td {
						- "Text is to have newlines added by the user agent so that the text is wrapped when it is\n     submitted.\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="the-textarea-element:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="the-textarea-element:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both the "
			a href="#attr-textarea-wrap-soft-state" id="the-textarea-element:attr-textarea-wrap-soft-state" {
				- "Soft"
			}
			- " state."
		}
		- "\n\n  "
		p {
			- "If the element's "
			code id="the-textarea-element:attr-textarea-wrap-2" {
				a href="#attr-textarea-wrap" {
					- "wrap"
				}
			}
			- " attribute is in the "
			a href="#attr-textarea-wrap-hard-state" id="the-textarea-element:attr-textarea-wrap-hard-state" {
				- "Hard"
			}
			- " state, the "
			code id="the-textarea-element:attr-textarea-cols-3" {
				a href="#attr-textarea-cols" {
					- "cols"
				}
			}
			- " attribute must be specified."
		}
		- "\n\n  \n\n  \n\n  "
		p {
			- "For historical reasons, the element's value is normalized in three different ways for three\n  different purposes. The "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-8" {
				- "raw value"
			}
			- " is the value as\n  it was originally set. It is not normalized. The "
			a href="#concept-fe-api-value" id="the-textarea-element:concept-fe-api-value" {
				- "API\n  value"
			}
			- " is the value used in the "
			code id="the-textarea-element:dom-textarea-value-2" {
				a href="#dom-textarea-value" {
					- "value"
				}
			}
			- " IDL\n  attribute, "
			code id="the-textarea-element:dom-textarea-textlength-2" {
				a href="#dom-textarea-textlength" {
					- "textLength"
				}
			}
			- " IDL attribute, and by the\n  "
			code id="the-textarea-element:attr-fe-maxlength" {
				a href="#attr-fe-maxlength" {
					- "maxlength"
				}
			}
			- " and "
			code id="the-textarea-element:attr-fe-minlength" {
				a href="#attr-fe-minlength" {
					- "minlength"
				}
			}
			- " content attributes. It is normalized so that line\n  breaks use U+000A LINE FEED (LF) characters. Finally, there is the "
			a href="#concept-fe-value" id="the-textarea-element:concept-fe-value" {
				- "value"
			}
			- ", as used in form submission and other processing models in\n  this specification. It is normalized as for the "
			a href="#concept-fe-api-value" id="the-textarea-element:concept-fe-api-value-2" {
				- "API\n  value"
			}
			- ", and in addition, if necessary given the element's "
			code id="the-textarea-element:attr-textarea-wrap-3" {
				a href="#attr-textarea-wrap" {
					- "wrap"
				}
			}
			- " attribute, additional line breaks are inserted to wrap the\n  text at the given width."
		}
		- "\n\n  "
		p id="textarea-line-break-normalisation-transformation" {
			- "The algorithm for obtaining\n  the element's "
			a href="#concept-fe-api-value" id="the-textarea-element:concept-fe-api-value-3" {
				- "API value"
			}
			- " is to return the element's\n  "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-9" {
				- "raw value"
			}
			- ", with "
			a href="https://infra.spec.whatwg.org/#normalize-newlines" id="the-textarea-element:normalize-newlines" data-x-internal="normalize-newlines" {
				- "newlines normalized"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The element's "
			a href="#concept-fe-value" id="the-textarea-element:concept-fe-value-2" {
				- "value"
			}
			- " is defined to be the element's "
			a href="#concept-textarea-raw-value" id="the-textarea-element:concept-textarea-raw-value-10" {
				- "API value"
			}
			- " with the "
			a href="#textarea-wrapping-transformation" id="the-textarea-element:textarea-wrapping-transformation" {
				- "textarea wrapping\n  transformation"
			}
			- " applied. The "
			dfn id="textarea-wrapping-transformation" {
				- "textarea wrapping transformation"
			}
			- " is the following\n  algorithm, as applied to a string:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the element's "
					code id="the-textarea-element:attr-textarea-wrap-4" {
