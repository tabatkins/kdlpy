				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "policy"
							}
							- "'s "
							a href="https://w3c.github.io/webappsec-csp/#policy-disposition" id="sandboxing:csp-disposition" data-x-internal="csp-disposition" {
								- "disposition"
							}
