					- "text/javascript"
				}
			}
			- " for JavaScript resources, in accordance with\n  "
			cite {
				- "Updates to ECMAScript Media Types"
			}
			- ". Servers should not use other\n  "
			a href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id="scriptingLanguages:javascript-mime-type" data-x-internal="javascript-mime-type" {
				- "JavaScript MIME types"
			}
			- " for JavaScript resources, and\n  must not use non-"
			a href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id="scriptingLanguages:javascript-mime-type-2" data-x-internal="javascript-mime-type" {
				- "JavaScript MIME types"
			}
			- ".\n  "
			a href="#refsRFC9239" {
				- "[RFC9239]"
			}
		}
		- "\n\n  \n\n  "
		p {
			- "For external JavaScript resources, MIME type parameters in `"
			code id="scriptingLanguages:content-type" {
				a href="#content-type" {
					- "Content-Type"
				}
			}
			- "` headers\n  are generally ignored. (In some cases the `"
			code {
				- "charset"
			}
			- "` parameter has an\n  effect.) However, for the "
			code id="scriptingLanguages:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element's "
			code id="scriptingLanguages:attr-script-type" {
				a href="#attr-script-type" {
					- "type"
				}
			}
			- " attribute they are significant; it uses the "
			a id="scriptingLanguages:javascript-mime-type-essence-match" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type-essence-match" data-x-internal="javascript-mime-type-essence-match" {
				- "JavaScript\n  MIME type essence match"
			}
			- " concept."
		}
		- "\n\n  "
		p class="note" {
			- "For example, scripts with their "
			code id="scriptingLanguages:attr-script-type-2" {
				a href="#attr-script-type" {
					- "type"
				}
			}
			- "\n  attribute set to \""
			code {
				- "text/javascript; charset=utf-8"
			}
			- "\" will not be\n  evaluated, even though that is a valid "
			a id="scriptingLanguages:javascript-mime-type-3" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" data-x-internal="javascript-mime-type" {
				- "JavaScript MIME type"
			}
			- " when parsed."
		}
		- "\n\n  "
		p {
			- "Furthermore, again for external JavaScript resources, special considerations apply around\n  `"
			code id="scriptingLanguages:content-type-2" {
				a href="#content-type" {
					- "Content-Type"
				}
			}
			- "` header processing as detailed in the "
			a href="#prepare-the-script-element" id="scriptingLanguages:prepare-the-script-element" {
				- "prepare the script\n  element"
			}
			- " algorithm and "
			cite {
				- "Fetch"
			}
			- ". "
			a href="#refsFETCH" {
				- "[FETCH]"
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h5 id="restrictions-for-contents-of-script-elements" {
			span class="secno" {
				- "4.12.1.3"
			}
			- " "
			dfn {
				- "Restrictions for contents of "
				code {
					- "script"
				}
				- " elements"
			}
			a href="#restrictions-for-contents-of-script-elements" class="self-link"
		}
		- "\n\n  "
		p class="note" {
			- "The easiest and safest way to avoid the rather strange restrictions described in\n  this section is to always escape an ASCII case-insensitive match for \""
			code {
				- "<!--"
			}
			- "\" as \""
			code {
				- "\\x3C!--"
			}
			- "\", \""
			code {
				- "<script"
			}
			- "\" as \""
			code {
				- "\\x3Cscript"
			}
			- "\", and \""
			code {
				- "</script"
			}
			- "\" as \""
			code {
				- "\\x3C/script"
			}
			- "\" when these sequences appear\n  in literals in scripts (e.g. in strings, regular expressions, or comments), and to avoid writing\n  code that uses such constructs in expressions. Doing so avoids the pitfalls that the restrictions\n  in this section are prone to triggering: namely, that, for historical reasons, parsing of\n  "
			code id="restrictions-for-contents-of-script-elements:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " blocks in HTML is a strange and exotic practice that acts unintuitively in the\n  face of these sequences."
		}
		- "\n\n  "
		p {
			- "The "
			code id="restrictions-for-contents-of-script-elements:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element's "
			a id="restrictions-for-contents-of-script-elements:descendant-text-content" href="https://dom.spec.whatwg.org/#concept-descendant-text-content" data-x-internal="descendant-text-content" {
				- "descendant text content"
			}
			- " must match the "
			code {
				- "script"
			}
			- " production in the following ABNF, the character set for which is Unicode.\n  "
			a href="#refsABNF" {
				- "[ABNF]"
			}
		}
		- "\n\n  "
		pre {
			code class="abnf" {
				c- nc="" {
					- "script"
				}
				- "        "
				c- o="" {
					- "="
				}
