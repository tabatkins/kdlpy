		- "\n\n\n\n  "
		h4 id="values" {
			span class="secno" {
				- "5.2.4"
			}
			- " Values"
			a href="#values" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="concept-property-value" {
				- "property value"
			}
			- " of a name-value pair added by an\n  element with an "
			code id="values:names:-the-itemprop-attribute" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute is as given for the first\n  matching case in the following list:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the element also has an "
				code id="values:attr-itemscope" {
					a href="#attr-itemscope" {
						- "itemscope"
					}
				}
				- " attribute"
			}
			dd {
				- "\n    "
				p {
					- "The value is the "
					a href="#concept-item" id="values:concept-item" {
						- "item"
					}
					- " created by the element."
				}
				- "\n   "
			}
			dt {
				- "If the element is a "
				code id="values:the-meta-element" {
					a href="#the-meta-element" {
						- "meta"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the value of the element's "
					code id="values:attr-meta-content" {
						a href="#attr-meta-content" {
							- "content"
						}
					}
					- "\n    attribute, if any, or the empty string if there is no such attribute."
				}
				- "\n   "
			}
			dt {
				- "If the element is an "
				code id="values:the-audio-element" {
					a href="#the-audio-element" {
						- "audio"
					}
				}
				- ", "
				code id="values:the-embed-element" {
					a href="#the-embed-element" {
						- "embed"
					}
				}
				- ", "
				code id="values:the-iframe-element" {
					a href="#the-iframe-element" {
						- "iframe"
					}
				}
				- ",\n   "
				code id="values:the-img-element" {
					a href="#the-img-element" {
						- "img"
					}
				}
				- ", "
				code id="values:the-source-element" {
					a href="#the-source-element" {
						- "source"
					}
				}
				- ", "
				code id="values:the-track-element" {
					a href="#the-track-element" {
						- "track"
					}
				}
				- ", or "
				code id="values:the-video-element" {
					a href="#the-video-element" {
						- "video"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the result of "
					a href="#encoding-parsing-and-serializing-a-url" id="values:encoding-parsing-and-serializing-a-url" {
						- "encoding-parsing-and-serializing a URL"
					}
					- " given the\n    element's "
					code {
						- "src"
					}
					- " attribute's value, relative to the element's "
					a id="values:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n    document"
					}
					- ", at the time the attribute is set, or the empty string if there is no such\n    attribute or the result is failure."
				}
				- "\n   "
			}
			dt {
				- "If the element is an "
				code id="values:the-a-element" {
					a href="#the-a-element" {
						- "a"
					}
				}
				- ", "
				code id="values:the-area-element" {
					a href="#the-area-element" {
						- "area"
					}
				}
				- ", or "
				code id="values:the-link-element" {
					a href="#the-link-element" {
						- "link"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the result of "
					a href="#encoding-parsing-and-serializing-a-url" id="values:encoding-parsing-and-serializing-a-url-2" {
						- "encoding-parsing-and-serializing a URL"
					}
					- " given the\n    element's "
					code {
						- "href"
					}
					- " attribute's value, relative to the element's "
					a id="values:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n    document"
					}
					- ", at the time the attribute is set, or the empty string if there is no such\n    attribute or the result is failure."
				}
				- "\n   "
			}
			dt {
				- "If the element is an "
				code id="values:the-object-element" {
					a href="#the-object-element" {
						- "object"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the result of "
					a href="#encoding-parsing-and-serializing-a-url" id="values:encoding-parsing-and-serializing-a-url-3" {
						- "encoding-parsing-and-serializing a URL"
					}
					- " given the\n    element's "
					code {
						- "data"
					}
					- " attribute's value, relative to the element's "
					a id="values:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node\n    document"
					}
					- ", at the time the attribute is set, or the empty string if there is no such\n    attribute or the result is failure."
				}
				- "\n   "
			}
			dt {
				- "If the element is a "
				code id="values:the-data-element" {
					a href="#the-data-element" {
						- "data"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the value of the element's "
					code id="values:attr-data-value" {
						a href="#attr-data-value" {
							- "value"
						}
					}
					- " attribute,\n    if it has one, or the empty string otherwise."
				}
				- "\n   "
			}
			dt {
				- "If the element is a "
				code id="values:the-meter-element" {
					a href="#the-meter-element" {
						- "meter"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the value of the element's "
					code id="values:attr-meter-value" {
						a href="#attr-meter-value" {
							- "value"
						}
					}
					- " attribute,\n    if it has one, or the empty string otherwise."
				}
				- "\n   "
			}
			dt {
				- "If the element is a "
				code id="values:the-time-element" {
					a href="#the-time-element" {
						- "time"
					}
				}
				- " element"
			}
			dd {
				- "\n    "
				p {
					- "The value is the element's "
					a href="#datetime-value" id="values:datetime-value" {
						- "datetime value"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "Otherwise"
			}
			dd {
				- "\n    "
				p {
					- "The value is the element's "
					a id="values:descendant-text-content" href="https://dom.spec.whatwg.org/#concept-descendant-text-content" data-x-internal="descendant-text-content" {
						- "descendant text content"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="url-property-elements" {
				- "URL property elements"
			}
			- " are the "
			code id="values:the-a-element-2" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- ", "
			code id="values:the-area-element-2" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- ",\n  "
			code id="values:the-audio-element-2" {
				a href="#the-audio-element" {
					- "audio"
				}
			}
			- ", "
			code id="values:the-embed-element-2" {
				a href="#the-embed-element" {
					- "embed"
				}
			}
			- ", "
			code id="values:the-iframe-element-2" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- ", "
			code id="values:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- ", "
			code id="values:the-link-element-2" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ",\n  "
			code id="values:the-object-element-2" {
				a href="#the-object-element" {
					- "object"
				}
			}
			- ", "
			code id="values:the-source-element-2" {
				a href="#the-source-element" {
					- "source"
				}
			}
			- ", "
			code id="values:the-track-element-2" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- ", and "
			code id="values:the-video-element-2" {
				a href="#the-video-element" {
					- "video"
				}
			}
			- " elements."
		}
		- "\n\n  "
		p {
			- "If a property's "
			a href="#concept-property-value" id="values:concept-property-value" {
				- "value"
			}
			- ", as defined by the property's\n  definition, is an "
			a id="values:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- ", the property must be specified using a "
			a href="#url-property-elements" id="values:url-property-elements" {
				- "URL property element"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "These requirements do not apply just because a property value happens to match the\n  syntax for a URL. They only apply if the property is explicitly defined as taking such a\n  value."
		}
		- "\n\n  "
		p class="example" {
			- "For example, a book about the first moon landing  could be\n  called \"mission:moon\". A \"title\" property from a vocabulary that defines a title as being a string\n  would not expect the title to be given in an "
			code id="values:the-a-element-3" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " element, even though it looks like a\n  "
			a id="values:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- ". On the other hand, if there was a (rather narrowly scoped!) vocabulary for\n  \"books whose titles look like URLs\" which had a \"title\" property defined to take a URL, then the\n  property "
			em {
				- "would"
			}
			- " expect the title to be given in an "
			code id="values:the-a-element-4" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " element (or one of the\n  other "
			a href="#url-property-elements" id="values:url-property-elements-2" {
				- "URL property elements"
			}
			- "), because of the requirement above."
		}
		- "\n\n\n  \n\n  "
		h4 id="associating-names-with-items" {
			span class="secno" {
				- "5.2.5"
			}
			- " Associating names with items"
			a href="#associating-names-with-items" class="self-link"
		}
		- "\n\n  "
		p {
			- "To find "
			dfn id="the-properties-of-an-item" {
				- "the properties of an item"
			}
			- " defined by the element "
			var {
				- "root"
			}
			- ",\n  the user agent must run the following steps. These steps are also used to flag "
			a href="#microdata-error" id="associating-names-with-items:microdata-error" {
				- "microdata errors"
			}
			- "."
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "results"
					}
					- ", "
					var {
						- "memory"
					}
					- ", and "
					var {
						- "pending"
					}
					- " be empty lists of elements."
				}
			}
			li {
				p {
					- "Add the element "
					var {
						- "root"
					}
					- " to "
					var {
						- "memory"
					}
					- "."
				}
			}
			li {
				p {
					- "Add the child elements of "
					var {
						- "root"
					}
					- ", if any, to "
					var {
						- "pending"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "root"
					}
					- " has an "
					code id="associating-names-with-items:attr-itemref" {
						a href="#attr-itemref" {
							- "itemref"
						}
					}
					- " attribute, "
					a href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id="associating-names-with-items:split-a-string-on-spaces" data-x-internal="split-a-string-on-spaces" {
						- "split the value of that "
						code {
							- "itemref"
						}
						- " attribute on ASCII whitespace"
					}
					- ". For each resulting\n   token "
					var {
						- "ID"
					}
					- ", if there is an element in the "
					a id="associating-names-with-items:tree" href="https://dom.spec.whatwg.org/#concept-tree" data-x-internal="tree" {
						- "tree"
					}
					- " of "
					var {
						- "root"
					}
					- " with the\n   "
					a href="https://dom.spec.whatwg.org/#concept-id" id="associating-names-with-items:concept-id" data-x-internal="concept-id" {
						- "ID"
					}
					- " "
					var {
						- "ID"
					}
					- ", then add the first such element to\n   "
					var {
						- "pending"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "While "
					var {
						- "pending"
					}
					- " is not empty:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Remove an element from "
							var {
								- "pending"
							}
							- " and let "
							var {
								- "current"
							}
							- " be that\n     element."
						}
					}
					li {
						p {
							- "If "
							var {
								- "current"
							}
							- " is already in "
							var {
								- "memory"
							}
							- ", there is a\n     "
							a href="#microdata-error" id="associating-names-with-items:microdata-error-2" {
								- "microdata error"
							}
							- "; "
							a id="associating-names-with-items:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- "."
						}
					}
					li {
						p {
							- "Add "
							var {
								- "current"
							}
							- " to "
							var {
								- "memory"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "current"
							}
							- " does not have an "
							code id="associating-names-with-items:attr-itemscope" {
								a href="#attr-itemscope" {
									- "itemscope"
								}
							}
							- "\n     attribute, then: add all the child elements of "
							var {
								- "current"
							}
							- " to\n     "
							var {
								- "pending"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "current"
							}
							- " has an "
							code id="associating-names-with-items:names:-the-itemprop-attribute" {
								a href="#names:-the-itemprop-attribute" {
									- "itemprop"
								}
							}
							- " attribute\n     specified and has one or more "
							a href="#property-names" id="associating-names-with-items:property-names" {
								- "property names"
							}
							- ", then add "
							var {
								- "current"
							}
							- " to\n     "
							var {
								- "results"
							}
							- "."
						}
					}
				}
				- "\n\n   "
			}
			li {
				p {
					- "Sort "
					var {
						- "results"
					}
					- " in "
					a id="associating-names-with-items:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
						- "tree order"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "results"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "A document must not contain any "
			a href="#concept-item" id="associating-names-with-items:concept-item" {
				- "items"
			}
			- " for which the algorithm\n  to find "
			a href="#the-properties-of-an-item" id="associating-names-with-items:the-properties-of-an-item" {
				- "the properties of an item"
			}
			- " finds any "
			dfn id="microdata-error" {
				- "microdata\n  errors"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			a href="#concept-item" id="associating-names-with-items:concept-item-2" {
				- "item"
			}
			- " is a "
			dfn id="top-level-microdata-items" {
				- "top-level\n  microdata item"
			}
			- " if its element does not have an "
			code id="associating-names-with-items:names:-the-itemprop-attribute-2" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- "\n  attribute."
		}
		- "\n\n\n\n  "
		p {
			- "All "
			code id="associating-names-with-items:attr-itemref-2" {
				a href="#attr-itemref" {
					- "itemref"
				}
			}
			- " attributes in a "
			code id="associating-names-with-items:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " must be\n  such that there are no cycles in the graph formed from representing each "
			a href="#concept-item" id="associating-names-with-items:concept-item-3" {
				- "item"
			}
			- " in the "
			code id="associating-names-with-items:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " as a node in the graph and each\n  "
			a href="#the-properties-of-an-item" id="associating-names-with-items:the-properties-of-an-item-2" {
				- "property"
			}
			- " of an item whose "
			a href="#concept-property-value" id="associating-names-with-items:concept-property-value" {
				- "value"
			}
			- " is another item as an edge in the graph connecting\n  those two items."
		}
		- "\n\n  \n  "
		p {
			- "A document must not contain any elements that have an "
			code id="associating-names-with-items:names:-the-itemprop-attribute-3" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute that would not be found to be a property of any of\n  the "
			a href="#concept-item" id="associating-names-with-items:concept-item-4" {
				- "items"
			}
			- " in that document were their "
			a href="#the-properties-of-an-item" id="associating-names-with-items:the-properties-of-an-item-3" {
				- "properties"
			}
			- " all to be determined."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In this example, a single license statement is applied to two works, using "
				code id="associating-names-with-items:attr-itemref-3" {
					a href="#attr-itemref" {
						- "itemref"
					}
				}
				- " from the items representing the works:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- cp="" {
						- "<!DOCTYPE HTML>"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
