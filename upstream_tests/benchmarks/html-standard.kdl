							- " to \""
							a href="#the-before-head-insertion-mode" id="the-insertion-mode:the-before-head-insertion-mode-2" {
								- "before head"
							}
							- "\"\n     and return. ("
							a href="#fragment-case" id="the-insertion-mode:fragment-case-3" {
								- "fragment case"
							}
