		- "\n\n  \n\n\n  "
		h4 id="the-autofocus-attribute" {
			span class="secno" {
				- "6.6.7"
			}
			- " "
			span id="autofocusing-a-form-control:-the-autofocus-attribute"
			- "The "
			code id="the-autofocus-attribute:attr-fe-autofocus" {
				a href="#attr-fe-autofocus" {
					- "autofocus"
				}
			}
			- " attribute"
			a href="#the-autofocus-attribute" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-fe-autofocus" data-dfn-type="element-attr" {
				code {
					- "autofocus"
				}
			}
			- "\n  content attribute allows the author to indicate that an element is to be focused as soon as the\n  page is loaded, allowing the user to just start typing without having to manually focus the main\n  element."
		}
		- "\n\n  "
		p {
			- "When the "
			code id="the-autofocus-attribute:attr-fe-autofocus-2" {
				a href="#attr-fe-autofocus" {
					- "autofocus"
				}
			}
			- " attribute is specified on an element\n  inside "
			code id="the-autofocus-attribute:the-dialog-element" {
				a href="#the-dialog-element" {
					- "dialog"
				}
			}
			- " elements or "
			a href="#html-elements" id="the-autofocus-attribute:html-elements" {
				- "HTML elements"
			}
			- " whose "
			code id="the-autofocus-attribute:attr-popover" {
				a href="#attr-popover" {
					- "popover"
				}
			}
			- " attribute is set, then it will be focused when the dialog or\n  popover becomes shown."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-autofocus-attribute:attr-fe-autofocus-3" {
				a href="#attr-fe-autofocus" {
					- "autofocus"
				}
			}
			- " attribute is a "
			a href="#boolean-attribute" id="the-autofocus-attribute:boolean-attribute" {
				- "boolean\n  attribute"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "To find the "
			dfn id="nearest-ancestor-autofocus-scoping-root-element" {
				- "nearest ancestor autofocus scoping root element"
			}
			- " given an\n  "
			code id="the-autofocus-attribute:element" {
				a data-x-internal="element" href="https://dom.spec.whatwg.org/#interface-element" {
					- "Element"
				}
			}
			- " "
			var {
				- "element"
			}
