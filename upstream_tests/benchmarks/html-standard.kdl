					}
					- ", an\n    "
					a href="#html-integration-point" id="parsing-main-inforeign:html-integration-point" {
						- "HTML integration point"
					}
					- ", or an element in the "
					a id="parsing-main-inforeign:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
						- "HTML namespace"
					}
					- ", pop\n    elements from the "
					a href="#stack-of-open-elements" id="parsing-main-inforeign:stack-of-open-elements" {
