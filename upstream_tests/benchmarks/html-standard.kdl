				p {
					a href="#insert-an-html-element" id="parsing-main-inbody:insert-an-html-element-25" {
						- "Insert an HTML element"
					}
					- " for the token."
				}
				- "\n\n    "
				p class="note" {
					- "This element will be an "
					a href="#ordinary" id="parsing-main-inbody:ordinary" {
						- "ordinary"
					}
					- " element. With one exception: if\n    the "
					a href="#scripting-flag" id="parsing-main-inbody:scripting-flag-2" {
						- "scripting flag"
					}
					- " is disabled, it can also be a "
					code id="parsing-main-inbody:the-noscript-element" {
						a href="#the-noscript-element" {
							- "noscript"
						}
					}
					- " element."
				}
				- "\n   "
			}
			dt {
				- "Any other end tag"
			}
			dd {
				- "\n    "
				p {
					- "Run these steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Initialize "
							var {
								- "node"
							}
							- " to be the "
							a href="#current-node" id="parsing-main-inbody:current-node-26" {
								- "current node"
							}
							- " (the bottommost\n     node of the stack)."
						}
					}
					li {
						p {
							i {
								- "Loop"
							}
							- ": If "
							var {
								- "node"
							}
							- " is an "
							a href="#html-elements" id="parsing-main-inbody:html-elements-15" {
								- "HTML\n     element"
							}
