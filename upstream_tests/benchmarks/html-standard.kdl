				- "reflect"
			}
			- " the content attribute of the same name."
		}
		- "\n\n  \n\n\n  \n\n  "
		h4 id="table-processing-model" {
			span class="secno" {
				- "4.9.12"
			}
			- " "
			span id="processing-model-2"
			- "Processing model"
			a href="#table-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "The various table elements and their content attributes together define the "
			dfn id="table-model" {
				- "table\n  model"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-table" {
				- "table"
			}
			- " consists of cells aligned on a two-dimensional grid of\n  "
			dfn id="concept-slots" {
				- "slots"
			}
			- " with coordinates ("
			var {
				- "x"
			}
			- ", "
			var {
				- "y"
			}
			- "). The grid is finite, and is either empty or has one or more slots. If the grid\n  has one or more slots, then the "
			var {
				- "x"
			}
			- " coordinates are always in the range "
			span {
				- "0 ≤ "
				var {
					- "x"
				}
				- " < "
				var {
					- "x"
					sub {
						- "width"
					}
				}
			}
			- ", and the "
			var {
				- "y"
			}
			- " coordinates are always in the\n  range "
			span {
				- "0 ≤ "
				var {
					- "y"
				}
				- " < "
				var {
					- "y"
					sub {
						- "height"
					}
				}
			}
			- ". If one or both of "
			var {
				- "x"
				sub {
					- "width"
				}
			}
			- " and "
			var {
				- "y"
				sub {
					- "height"
				}
			}
			- " are zero, then the\n  table is empty (has no slots). Tables correspond to "
			code id="table-processing-model:the-table-element" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- " elements."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-cell" {
				- "cell"
			}
			- " is a set of slots anchored at a slot ("
			var {
				- "cell"
				sub {
					- "x"
				}
			}
			- ", "
			var {
				- "cell"
				sub {
					- "y"
				}
			}
			- "), and with\n  a particular "
			var {
				- "width"
			}
			- " and "
			var {
				- "height"
			}
			- " such that the cell covers\n  all the slots with coordinates ("
			var {
				- "x"
			}
			- ", "
			var {
				- "y"
			}
			- ") where "
			span {
				var {
					- "cell"
					sub {
						- "x"
					}
				}
				- " ≤ "
				var {
					- "x"
				}
				- " < "
				var {
					- "cell"
					sub {
						- "x"
					}
				}
				- "+"
				var {
					- "width"
				}
			}
			- " and "
			var {
				- "cell"
				sub {
					- "y"
				}
			}
			- " ≤ "
			var {
				- "y"
			}
			- " < "
			var {
				- "cell"
				sub {
					- "y"
				}
			}
			- "+"
			var {
				- "height"
			}
			- ". Cells can either be "
			em {
				- "data cells"
			}
			- "\n  or "
			em {
				- "header cells"
			}
			- ". Data cells correspond to "
			code id="table-processing-model:the-td-element" {
				a href="#the-td-element" {
					- "td"
				}
			}
			- " elements, and header cells\n  correspond to "
			code id="table-processing-model:the-th-element" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- " elements. Cells of both types can have zero or more associated\n  header cells."
		}
		- "\n\n  "
		p {
			- "It is possible, in certain error cases, for two cells to occupy the same slot."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-row" {
				- "row"
			}
			- " is a complete set of slots from "
			var {
				- "x"
			}
			- "=0 to "
			var {
				- "x"
			}
			- "="
			var {
				- "x"
				sub {
					- "width"
				}
			}
			- "-1, for a particular value of "
			var {
				- "y"
			}
			- ". Rows usually\n  correspond to "
			code id="table-processing-model:the-tr-element" {
				a href="#the-tr-element" {
					- "tr"
				}
			}
			- " elements, though a "
			a href="#concept-row-group" id="table-processing-model:concept-row-group" {
				- "row group"
			}
			- "\n  can have some implied "
			a href="#concept-row" id="table-processing-model:concept-row" {
				- "rows"
			}
			- " at the end in some cases involving\n  "
			a href="#concept-cell" id="table-processing-model:concept-cell" {
				- "cells"
			}
			- " spanning multiple rows."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-column" {
				- "column"
			}
			- " is a complete set of slots from "
			var {
				- "y"
			}
			- "=0 to "
			var {
				- "y"
			}
			- "="
			var {
				- "y"
				sub {
					- "height"
				}
			}
			- "-1, for a particular value of "
			var {
				- "x"
			}
			- ". Columns can\n  correspond to "
			code id="table-processing-model:the-col-element" {
				a href="#the-col-element" {
					- "col"
				}
			}
			- " elements. In the absence of "
			code id="table-processing-model:the-col-element-2" {
				a href="#the-col-element" {
					- "col"
				}
			}
			- " elements, columns are\n  implied."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-row-group" {
				- "row group"
			}
			- " is a set of "
			a href="#concept-row" id="table-processing-model:concept-row-2" {
				- "rows"
			}
			- " anchored at a slot (0, "
			var {
				- "group"
				sub {
					- "y"
				}
			}
			- ") with a particular "
			var {
				- "height"
			}
			- " such that the row group\n  covers all the slots with coordinates ("
			var {
				- "x"
			}
			- ", "
			var {
				- "y"
			}
			- ") where "
			span {
				- "0 ≤ "
				var {
					- "x"
				}
				- " < "
				var {
					- "x"
					sub {
						- "width"
					}
				}
			}
			- " and "
			var {
				- "group"
				sub {
					- "y"
				}
			}
			- " ≤ "
			var {
				- "y"
			}
			- " < "
			var {
				- "group"
				sub {
					- "y"
				}
			}
			- "+"
			var {
				- "height"
			}
			- ". Row groups correspond to\n  "
			code id="table-processing-model:the-tbody-element" {
				a href="#the-tbody-element" {
					- "tbody"
				}
			}
			- ", "
			code id="table-processing-model:the-thead-element" {
				a href="#the-thead-element" {
					- "thead"
				}
			}
			- ", and "
			code id="table-processing-model:the-tfoot-element" {
				a href="#the-tfoot-element" {
					- "tfoot"
				}
			}
			- " elements. Not every row is\n  necessarily in a row group."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="concept-column-group" {
				- "column group"
			}
			- " is a set of "
			a href="#concept-column" id="table-processing-model:concept-column" {
				- "columns"
			}
			- " anchored at a slot ("
			var {
				- "group"
				sub {
					- "x"
				}
			}
			- ", 0) with a particular "
			var {
				- "width"
			}
			- " such that the column group\n  covers all the slots with coordinates ("
			var {
				- "x"
			}
			- ", "
			var {
				- "y"
			}
			- ") where "
			span {
				var {
					- "group"
					sub {
						- "x"
					}
				}
				- " ≤ "
				var {
					- "x"
				}
				- " < "
				var {
					- "group"
					sub {
						- "x"
					}
				}
				- "+"
				var {
					- "width"
				}
			}
			- " and "
			span {
				- "0 ≤ "
				var {
					- "y"
				}
				- " < "
				var {
					- "y"
					sub {
						- "height"
					}
				}
			}
			- ". Column\n  groups correspond to "
			code id="table-processing-model:the-colgroup-element" {
				a href="#the-colgroup-element" {
					- "colgroup"
				}
			}
			- " elements. Not every column is necessarily in a column\n  group."
		}
		- "\n\n  "
		p {
			a href="#concept-row-group" id="table-processing-model:concept-row-group-2" {
				- "Row groups"
			}
			- " cannot overlap each other. Similarly, "
			a href="#concept-column-group" id="table-processing-model:concept-column-group" {
				- "column groups"
			}
			- " cannot overlap each other."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#concept-cell" id="table-processing-model:concept-cell-2" {
				- "cell"
			}
			- " cannot cover slots that are from two or more "
			a href="#concept-row-group" id="table-processing-model:concept-row-group-3" {
				- "row groups"
			}
			- ". It is, however, possible for a cell to be in multiple\n  "
			a href="#concept-column-group" id="table-processing-model:concept-column-group-2" {
				- "column groups"
			}
			- ". All the slots that form part of one cell\n  are part of zero or one "
			a href="#concept-row-group" id="table-processing-model:concept-row-group-4" {
				- "row groups"
			}
			- " and zero or more "
			a href="#concept-column-group" id="table-processing-model:concept-column-group-3" {
				- "column groups"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "In addition to "
			a href="#concept-cell" id="table-processing-model:concept-cell-3" {
				- "cells"
			}
			- ", "
			a href="#concept-column" id="table-processing-model:concept-column-2" {
				- "columns"
			}
			- ", "
			a href="#concept-row" id="table-processing-model:concept-row-3" {
				- "rows"
			}
			- ", "
			a href="#concept-row-group" id="table-processing-model:concept-row-group-5" {
				- "row groups"
			}
			- ", and "
			a href="#concept-column-group" id="table-processing-model:concept-column-group-4" {
				- "column\n  groups"
			}
			- ", "
			a href="#concept-table" id="table-processing-model:concept-table" {
				- "tables"
			}
			- " can have a "
			code id="table-processing-model:the-caption-element" {
				a href="#the-caption-element" {
					- "caption"
				}
			}
			- " element\n  associated with them. This gives the table a heading, or legend."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="table-model-error" {
				- "table model error"
			}
			- " is an error with the data represented by "
			code id="table-processing-model:the-table-element-2" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- "\n  elements and their descendants. Documents must not have table model errors."
		}
		- "\n\n\n  "
		h5 id="forming-a-table" {
			span class="secno" {
				- "4.9.12.1"
			}
			- " Forming a table"
			a href="#forming-a-table" class="self-link"
		}
		- "\n\n  "
		p {
			- "To determine which elements correspond to which slots in a "
			a href="#concept-table" id="forming-a-table:concept-table" {
				- "table"
			}
			- " associated with a "
			code id="forming-a-table:the-table-element" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- " element, to determine the\n  dimensions of the table ("
			var {
				- "x"
				sub {
					- "width"
				}
			}
			- " and "
			var {
				- "y"
				sub {
					- "height"
				}
			}
			- "), and to determine if there are any "
			a href="#table-model-error" id="forming-a-table:table-model-error" {
				- "table model errors"
			}
			- ", user agents must use the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "x"
						sub {
							- "width"
						}
					}
					- " be zero."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "y"
						sub {
							- "height"
						}
					}
					- " be zero."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "pending "
						code id="forming-a-table:the-tfoot-element" {
							a href="#the-tfoot-element" {
								- "tfoot"
							}
						}
						- " elements"
					}
					- " be a list of "
					code id="forming-a-table:the-tfoot-element-2" {
						a href="#the-tfoot-element" {
							- "tfoot"
						}
					}
					- "\n    elements, initially empty."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "the table"
					}
					- " be the "
					a href="#concept-table" id="forming-a-table:concept-table-2" {
						- "table"
					}
					- " represented\n    by the "
					code id="forming-a-table:the-table-element-2" {
						a href="#the-table-element" {
							- "table"
						}
					}
					- " element. The "
					var {
						- "x"
						sub {
							- "width"
						}
					}
					- " and "
					var {
						- "y"
						sub {
							- "height"
						}
					}
					- " variables give "
					var {
						- "the table"
					}
					- "'s\n    dimensions. "
					var {
						- "The table"
					}
					- " is initially empty."
				}
				- "\n   "
			}
			li {
				- "\n    \n\n    "
				p {
					- "If the "
					code id="forming-a-table:the-table-element-3" {
						a href="#the-table-element" {
							- "table"
						}
					}
					- " element has no children elements, then return "
					var {
						- "the\n    table"
					}
					- " (which will be empty)."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Associate the first "
					code id="forming-a-table:the-caption-element" {
						a href="#the-caption-element" {
							- "caption"
						}
					}
					- " element child of the "
					code id="forming-a-table:the-table-element-4" {
						a href="#the-table-element" {
							- "table"
						}
					}
					- " element with\n    "
					var {
						- "the table"
					}
					- ". If there are no such children, then it has no associated\n    "
					code id="forming-a-table:the-caption-element-2" {
						a href="#the-caption-element" {
							- "caption"
						}
					}
					- " element."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let the "
					var {
						- "current element"
					}
					- " be the first element child of the\n    "
					code id="forming-a-table:the-table-element-5" {
						a href="#the-table-element" {
							- "table"
						}
					}
					- " element."
				}
				- "\n\n    "
				p {
					- "If a step in this algorithm ever requires the "
					var {
						- "current element"
					}
					- " to be "
					dfn id="concept-table-advance" {
						- "advanced to the next child of the "
						code {
							- "table"
						}
					}
					- " when\n    there is no such next child, then the user agent must jump to the step labeled "
					i {
						- "end"
					}
					- ", near\n    the end of this algorithm."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "While the "
					var {
						- "current element"
					}
					- " is not one of the following elements, "
					a href="#concept-table-advance" id="forming-a-table:concept-table-advance" {
						- "advance"
					}
					- " the "
					var {
						- "current element"
					}
					- " to the next\n    child of the "
					code id="forming-a-table:the-table-element-6" {
						a href="#the-table-element" {
							- "table"
						}
					}
					- ":"
				}
				- "\n\n    "
				ul class="brief" {
					li {
						code id="forming-a-table:the-colgroup-element" {
							a href="#the-colgroup-element" {
								- "colgroup"
							}
						}
					}
					li {
						code id="forming-a-table:the-thead-element" {
							a href="#the-thead-element" {
								- "thead"
							}
						}
					}
					li {
						code id="forming-a-table:the-tbody-element" {
							a href="#the-tbody-element" {
								- "tbody"
							}
						}
					}
					li {
						code id="forming-a-table:the-tfoot-element-3" {
							a href="#the-tfoot-element" {
								- "tfoot"
							}
						}
					}
					li {
						code id="forming-a-table:the-tr-element" {
							a href="#the-tr-element" {
								- "tr"
							}
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If the "
					var {
						- "current element"
					}
					- " is a "
					code id="forming-a-table:the-colgroup-element-2" {
						a href="#the-colgroup-element" {
							- "colgroup"
						}
					}
					- ", follow these\n    substeps:"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							i {
								- "Column groups"
							}
							- ": Process the "
							var {
								- "current element"
							}
							- " according to the\n      appropriate case below:"
						}
						- "\n\n      "
						dl class="switch" {
							dt {
								- "If the "
								var {
									- "current element"
								}
								- " has any "
								code id="forming-a-table:the-col-element" {
									a href="#the-col-element" {
										- "col"
									}
								}
								- " element children"
							}
							dd {
								- "\n        "
								p {
									- "Follow these steps:"
								}
								- "\n\n        "
								ol {
									li {
										- "\n          "
										p {
											- "Let "
											var {
												- "x"
												sub {
													- "start"
												}
											}
											- " have the value of "
											span {
												var {
													- "x"
													sub {
														- "width"
													}
												}
											}
											- "."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Let the "
											var {
												- "current column"
											}
											- " be the first "
											code id="forming-a-table:the-col-element-2" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element child\n          of the "
											code id="forming-a-table:the-colgroup-element-3" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											i {
												- "Columns"
											}
											- ": If the "
											var {
												- "current column"
											}
											- " "
											code id="forming-a-table:the-col-element-3" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element has\n          a "
											code id="forming-a-table:attr-col-span" {
												a href="#attr-col-span" {
													- "span"
												}
											}
											- " attribute, then parse its value using the\n          "
											a href="#rules-for-parsing-non-negative-integers" id="forming-a-table:rules-for-parsing-non-negative-integers" {
												- "rules for parsing non-negative integers"
											}
											- "."
										}
										- "\n\n          "
										p {
											- "If the result of parsing the value is not an error or zero, then let "
											var {
												- "span"
											}
											- " be that value."
										}
										- "\n\n          "
										p {
											- "Otherwise, if the "
											code id="forming-a-table:the-col-element-4" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element has no "
											code id="forming-a-table:attr-col-span-2" {
												a href="#attr-col-span" {
													- "span"
												}
											}
											- " attribute, or if trying to parse the attribute's value\n          resulted in an error or zero, then let "
											var {
												- "span"
											}
											- " be 1."
										}
										- "\n\n          "
										p {
											- "If "
											var {
												- "span"
											}
											- " is greater than 1000, let it be 1000 instead."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Increase "
											var {
												- "x"
												sub {
													- "width"
												}
											}
											- " by "
											var {
												- "span"
											}
											- "."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Let the last "
											var {
												- "span"
											}
											- " "
											a href="#concept-column" id="forming-a-table:concept-column" {
												- "columns"
											}
											- " in\n          "
											var {
												- "the table"
											}
											- " correspond to the "
											var {
												- "current column"
											}
											- "\n          "
											code id="forming-a-table:the-col-element-5" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "If "
											var {
												- "current column"
											}
											- " is not the last "
											code id="forming-a-table:the-col-element-6" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element child of\n          the "
											code id="forming-a-table:the-colgroup-element-4" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element, then let the "
											var {
												- "current column"
											}
											- " be the\n          next "
											code id="forming-a-table:the-col-element-7" {
												a href="#the-col-element" {
													- "col"
												}
											}
											- " element child of the "
											code id="forming-a-table:the-colgroup-element-5" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element, and return to\n          the step labeled "
											i {
												- "columns"
											}
											- "."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Let all the last "
											a href="#concept-column" id="forming-a-table:concept-column-2" {
												- "columns"
											}
											- " in "
											var {
												- "the\n          table"
											}
											- " from "
											span {
												- "x="
												var {
													- "x"
													sub {
														- "start"
													}
												}
											}
											- " to\n          "
											span {
												- "x="
												var {
													- "x"
													sub {
														- "width"
													}
												}
												- "-1"
											}
											- " form a new "
											a href="#concept-column-group" id="forming-a-table:concept-column-group" {
												- "column group"
											}
											- ", anchored at the slot ("
											var {
												- "x"
												sub {
													- "start"
												}
											}
											- ", 0), with width "
											var {
												- "x"
												sub {
													- "width"
												}
											}
											- "-"
											var {
												- "x"
												sub {
													- "start"
												}
											}
											- ", corresponding to the "
											code id="forming-a-table:the-colgroup-element-6" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element."
										}
										- "\n         "
									}
								}
								- "\n       "
							}
							dt {
								- "If the "
								var {
									- "current element"
								}
								- " has no "
								code id="forming-a-table:the-col-element-8" {
									a href="#the-col-element" {
										- "col"
									}
								}
								- " element children"
							}
							dd {
								- "\n        "
								ol {
									li {
										- "\n          "
										p {
											- "If the "
											code id="forming-a-table:the-colgroup-element-7" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element has a "
											code id="forming-a-table:attr-colgroup-span" {
												a href="#attr-colgroup-span" {
													- "span"
												}
											}
											- "\n attribute, then parse its value using the "
											a href="#rules-for-parsing-non-negative-integers" id="forming-a-table:rules-for-parsing-non-negative-integers-2" {
												- "rules for parsing non-negative\n          integers"
											}
											- "."
										}
										- "\n\n          "
										p {
											- "If the result of parsing the value is not an error or zero, then let "
											var {
												- "span"
											}
											- " be that value."
										}
										- "\n\n          "
										p {
											- "Otherwise, if the "
											code id="forming-a-table:the-colgroup-element-8" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element has no "
											code id="forming-a-table:attr-colgroup-span-2" {
												a href="#attr-colgroup-span" {
													- "span"
												}
											}
											- " attribute, or if trying to parse the attribute's\n          value resulted in an error or zero, then let "
											var {
												- "span"
											}
											- " be 1."
										}
										- "\n\n          "
										p {
											- "If "
											var {
												- "span"
											}
											- " is greater than 1000, let it be 1000 instead."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Increase "
											var {
												- "x"
												sub {
													- "width"
												}
											}
											- " by "
											var {
												- "span"
											}
											- "."
										}
										- "\n         "
									}
									li {
										- "\n          "
										p {
											- "Let the last "
											var {
												- "span"
											}
											- " "
											a href="#concept-column" id="forming-a-table:concept-column-3" {
												- "columns"
											}
											- " in\n          "
											var {
												- "the table"
											}
											- " form a new "
											a href="#concept-column-group" id="forming-a-table:concept-column-group-2" {
												- "column\n          group"
											}
											- ", anchored at the slot ("
											var {
												- "x"
												sub {
													- "width"
												}
											}
											- "-"
											var {
												- "span"
											}
											- ", 0), with width "
											var {
												- "span"
											}
											- ", corresponding to the "
											code id="forming-a-table:the-colgroup-element-9" {
												a href="#the-colgroup-element" {
													- "colgroup"
												}
											}
											- " element."
										}
										- "\n         "
									}
								}
								- "\n       "
							}
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							a href="#concept-table-advance" id="forming-a-table:concept-table-advance-2" {
								- "Advance"
							}
							- " the "
							var {
								- "current element"
							}
							- "\n      to the next child of the "
							code id="forming-a-table:the-table-element-7" {
								a href="#the-table-element" {
