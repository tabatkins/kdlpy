		- "\n\n  "
		p {
			- "When a "
			a href="#category-listed" id="association-of-controls-and-forms:category-listed-5" {
				- "listed"
			}
			- " "
			a href="#form-associated-element" id="association-of-controls-and-forms:form-associated-element-12" {
				- "form-associated element"
			}
			- " has a\n  "
			code id="association-of-controls-and-forms:attr-fae-form-4" {
