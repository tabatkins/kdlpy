			- " of the "
			a href="#concept-relevant-realm" id="relevant:concept-relevant-realm-2" {
				- "relevant realm"
			}
			- " for\n  "
			var {
				- "o"
			}
			- "."
		}
		- "\n\n  "
		h5 id="enabling-and-disabling-scripting" {
			span class="secno" {
				- "8.1.3.4"
			}
			- " Enabling and disabling scripting"
			a href="#enabling-and-disabling-scripting" class="self-link"
		}
		- "\n\n  "
		p id="concept-bc-script" {
			dfn id="concept-environment-script" {
				- "Scripting is enabled"
			}
			- " for\n  an "
			a href="#environment-settings-object" id="enabling-and-disabling-scripting:environment-settings-object" {
				- "environment settings object"
			}
			- " "
			var {
				- "settings"
			}
			- " when all of the following\n  conditions are true:"
		}
		- "\n\n  "
		ul {
			li {
				- "The user agent supports scripting."
			}
			li {
				- "\n   "
				a id="enabling-and-disabling-scripting:tracking-vector" title="There is a tracking vector here." href="https://infra.spec.whatwg.org/#tracking-vector" class="tracking-vector" data-x-internal="tracking-vector" {
					img width="46" alt="(This is a tracking vector.)" crossorigin="" src="https://resources.whatwg.org/tracking-vector.svg" height="64"
				}
				- "\n   The user has not disabled scripting for "
				var {
					- "settings"
				}
				- " at this time. (User agents may\n   provide users with the option to disable scripting globally, or in a finer-grained manner, e.g.,\n   on a per-origin basis, down to the level of individual "
				a href="#environment-settings-object" id="enabling-and-disabling-scripting:environment-settings-object-2" {
					- "environment settings objects"
				}
				- ".)"
			}
			li id="sandboxScriptBlocked" {
				- "Either "
				var {
					- "settings"
				}
				- "'s "
				a href="#concept-settings-object-global" id="enabling-and-disabling-scripting:concept-settings-object-global" {
					- "global object"
				}
				- " is not a "
				code id="enabling-and-disabling-scripting:window" {
					a href="#window" {
						- "Window"
					}
				}
				- " object,\n   or "
				var {
					- "settings"
				}
				- "'s "
				a href="#concept-settings-object-global" id="enabling-and-disabling-scripting:concept-settings-object-global-2" {
					- "global object"
				}
				- "'s\n   "
				a href="#concept-document-window" id="enabling-and-disabling-scripting:concept-document-window" {
					- "associated "
					code {
						- "Document"
					}
				}
				- "'s "
				a href="#active-sandboxing-flag-set" id="enabling-and-disabling-scripting:active-sandboxing-flag-set" {
					- "active\n   sandboxing flag set"
				}
				- " does not have its "
				a href="#sandboxed-scripts-browsing-context-flag" id="enabling-and-disabling-scripting:sandboxed-scripts-browsing-context-flag" {
					- "sandboxed scripts browsing context flag"
				}
				- "\n   set."
			}
		}
		- "\n\n  "
		p id="concept-bc-noscript" {
			dfn id="concept-environment-noscript" {
				- "Scripting is disabled"
			}
			- "\n  for an "
			a href="#environment-settings-object" id="enabling-and-disabling-scripting:environment-settings-object-3" {
				- "environment settings object"
			}
			- " when scripting is not "
			a href="#concept-environment-script" id="enabling-and-disabling-scripting:concept-environment-script" {
				- "enabled"
