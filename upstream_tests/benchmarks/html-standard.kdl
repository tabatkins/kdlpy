						- "rules\n    for updating the text track rendering"
					}
					- ". When a "
					a href="#text-track-cue" id="text-track-api:text-track-cue-2" {
						- "text track cue"
					}
					- " is added to it,\n    the "
					a href="#text-track-list-of-cues" id="text-track-api:text-track-list-of-cues-7" {
						- "text track list of cues"
					}
					- " has its rules permanently set accordingly."
