						- "value"
					}
					- " must be text that is a "
					a href="#valid-global-date-and-time-string" id="vcard:valid-global-date-and-time-string" {
						- "valid\n    global date and time string"
					}
					- "."
				}
				- "\n\n    \n    "
				p class="note" {
					- "The value distinguishes the current revision of the information for other\n    renditions of the information."
				}
				- "\n\n    "
				p {
					- "Any number of properties with the name "
					code id="vcard:md-vcard-rev" {
						a href="#md-vcard-rev" {
							- "rev"
						}
					}
					- " may be present\n    within each "
