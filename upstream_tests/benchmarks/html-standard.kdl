					- "Suffering from being too long"
				}
				- " "
			}
			dd {
				- "\n    "
				p {
					- "When a control has a "
					a href="#concept-fe-value" id="definitions:concept-fe-value-4" {
						- "value"
					}
					- " that is too long for the\n    "
					a href="#attr-fe-maxlength" id="definitions:attr-fe-maxlength" {
						- "form control "
						code {
							- "maxlength"
						}
						- " attribute"
					}
					- "\n    ("
					code id="definitions:the-input-element-2" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " "
					code id="definitions:attr-input-maxlength" {
						a href="#attr-input-maxlength" {
