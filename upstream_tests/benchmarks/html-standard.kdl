			a href="#concept-canvas-origin-clean" id="the-canvas-element:concept-canvas-origin-clean" {
				- "origin-clean"
			}
			- "\n  flag must be set to true."
		}
		- "\n\n  "
		p {
			- "A "
			code id="the-canvas-element:the-canvas-element-26" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element can have a rendering context bound to it. Initially, it does not\n  have a bound rendering context. To keep track of whether it has a rendering context or not, and\n  what kind of rendering context it is, a "
			code id="the-canvas-element:the-canvas-element-27" {
				a href="#the-canvas-element" {
					- "canvas"
