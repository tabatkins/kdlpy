							- "alt"
						}
						c- o="" {
							- "="
						}
						c- s="" {
							- "\"\""
						}
						- "\n        "
						c- e="" {
							- "title"
						}
						c- o="" {
							- "="
						}
						c- s="" {
							- "\"Flowchart representation of the parsing model.\""
						}
						c- p="" {
							- ">"
						}
					}
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- c="" {
						- "<!-- Using <figure> and <figcaption> -->"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "The Network passes data to the Input Stream Preprocessor, which\npasses it to the Tokenizer, which passes it to the Tree Construction\nstage. From there, data goes to both the DOM and to Script Execution.\nScript Execution is linked to the DOM, and, using document.write(),\npasses data to the Tokenizer."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "figure"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					strong {
						c- p="" {
							- "<"
						}
						c- f="" {
							- "img"
						}
						- " "
						c- e="" {
							- "src"
						}
						c- o="" {
							- "="
						}
						c- s="" {
							- "\"images/parsing-model-overview.svg\""
						}
						- " "
						c- e="" {
							- "alt"
						}
						c- o="" {
							- "="
						}
						c- s="" {
							- "\"The Network leads to"
						}
						- "\n"
						c- s="" {
							- " the Input Stream Preprocessor, which leads to the Tokenizer, which"
						}
						- "\n"
						c- s="" {
							- " leads to the Tree Construction stage. The Tree Construction stage"
						}
						- "\n"
						c- s="" {
							- " leads to two items. The first is Script Execution, which leads via"
						}
						- "\n"
						c- s="" {
							- " document.write() back to the Tokenizer. The second item from which"
						}
						- "\n"
						c- s="" {
							- " Tree Construction leads is the DOM. The DOM is related to the Script"
						}
						- "\n"
						c- s="" {
							- " Execution.\""
						}
						c- p="" {
							- ">"
						}
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "figcaption"
					}
					c- p="" {
						- ">"
					}
					- "Flowchart representation of the parsing model."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "figcaption"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "figure"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			pre class="bad" {
				code class="html" {
					c- c="" {
						- "<!-- This is WRONG. Do not do this. Instead, do what the above examples do. -->"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "The Network passes data to the Input Stream Preprocessor, which\npasses it to the Tokenizer, which passes it to the Tree Construction\nstage. From there, data goes to both the DOM and to Script Execution.\nScript Execution is linked to the DOM, and, using document.write(),\npasses data to the Tokenizer."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "img"
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"images/parsing-model-overview.svg\""
					}
					- "\n        "
					c- e="" {
						- "alt"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"Flowchart representation of the parsing model.\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- c="" {
						- "<!-- Never put the image's caption in the alt=\"\" attribute! -->"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "A graph that repeats the previous paragraph in graphical form:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "According to a study covering several billion pages,\nabout 62% of documents on the web in 2007 triggered the Quirks\nrendering mode of web browsers, about 30% triggered the Almost\nStandards mode, and about 9% triggered the Standards mode."
					c- p="" {
						- "</"
