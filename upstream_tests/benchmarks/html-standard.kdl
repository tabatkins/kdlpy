		- "\n\n\n  "
		h4 id="javascript-specification-host-hooks" {
			span class="secno" {
				- "8.1.6"
			}
			- " JavaScript specification host hooks"
			a href="#javascript-specification-host-hooks" class="self-link"
		}
		- "\n\n  "
		p {
			- "The JavaScript specification contains a number of "
			a id="javascript-specification-host-hooks:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " abstract\n  operations, that vary depending on the host environment. This section defines them for user\n  agent hosts."
		}
		- "\n\n  "
		h5 id="the-hostensurecanaddprivateelement-implementation" {
			span class="secno" {
				- "8.1.6.1"
			}
			- " "
			dfn {
				- "HostEnsureCanAddPrivateElement"
			}
			- "("
			var {
				- "O"
			}
			- ")"
			a href="#the-hostensurecanaddprivateelement-implementation" class="self-link"
		}
		- "\n\n  "
		p {
			- "JavaScript contains an "
			a id="the-hostensurecanaddprivateelement-implementation:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " "
			a href="https://tc39.es/ecma262/#sec-hostensurecanaddprivateelement" id="the-hostensurecanaddprivateelement-implementation:js-hostensurecanaddprivateelement" data-x-internal="js-hostensurecanaddprivateelement" {
				- "HostEnsureCanAddPrivateElement"
			}
			- "("
			var {
				- "O"
			}
			- ")\n  abstract operation. User agents must use the following implementation: "
			a href="#refsJAVASCRIPT" {
				- "[JAVASCRIPT]"
			}
			- "\n\n  "
		}
		ol {
			li {
				p {
					- "If "
					var {
						- "O"
					}
					- " is a "
					code id="the-hostensurecanaddprivateelement-implementation:windowproxy" {
						a href="#windowproxy" {
							- "WindowProxy"
						}
					}
					- " object, or "
					a id="the-hostensurecanaddprivateelement-implementation:implements" href="https://webidl.spec.whatwg.org/#implements" data-x-internal="implements" {
						- "implements"
					}
					- "\n   "
					code id="the-hostensurecanaddprivateelement-implementation:location" {
						a href="#location" {
							- "Location"
						}
					}
					- ", then return Completion { [[Type]]: throw, [[Value]]: a new\n   "
					code id="the-hostensurecanaddprivateelement-implementation:typeerror" {
						a data-x-internal="typeerror" href="https://tc39.es/ecma262/#sec-native-error-types-used-in-this-standard-typeerror" {
							- "TypeError"
						}
					}
					- " }."
				}
			}
			li {
				p {
					- "Return "
					a id="the-hostensurecanaddprivateelement-implementation:normalcompletion" href="https://tc39.es/ecma262/#sec-normalcompletion" data-x-internal="normalcompletion" {
						- "NormalCompletion"
					}
					- "(unused)."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "JavaScript private fields can be applied to arbitrary objects. Since this can\n  dramatically complicate implementation for particularly-exotic host objects, the JavaScript\n  language specification provides this hook to allow hosts to reject private fields on objects\n  meeting a host-defined criteria. In the case of HTML, "
			code id="the-hostensurecanaddprivateelement-implementation:windowproxy-2" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " and\n  "
			code id="the-hostensurecanaddprivateelement-implementation:location-2" {
				a href="#location" {
					- "Location"
				}
			}
			- " have complicated semantics — particularly around navigation and\n  security — that make implementation of private field semantics challenging, so our\n  implementation simply rejects those objects."
		}
