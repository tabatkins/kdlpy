			}
			- " "
			a href="#embedded-content-category" id="embedded-content-rendering-rules:embedded-content-category" {
				- "embedded content"
			}
			- " is\n  expected to be treated as a "
			a id="embedded-content-rendering-rules:replaced-element-2" href="https://drafts.csswg.org/css-display/#replaced-element" data-x-internal="replaced-element" {
				- "replaced element"
			}
			- "; the contents of such elements are the\n  element's bitmap, if any, or else a "
			a id="embedded-content-rendering-rules:transparent-black" href="https://drafts.csswg.org/css-color/#transparent-black" data-x-internal="transparent-black" {
