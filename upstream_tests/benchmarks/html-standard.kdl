					}
					- ", "
					var {
						- "minute"
					}
					- ", and "
					var {
						- "second"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h5 id="local-dates-and-times" {
			span class="secno" {
				- "2.3.5.5"
			}
			- " Local dates and times"
			a href="#local-dates-and-times" class="self-link"
