		p {
			- "Elements with an "
			code id="items:attr-itemscope-8" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute may have an "
			dfn data-dfn-for="html-global" id="attr-itemref" data-dfn-type="element-attr" {
				code {
					- "itemref"
				}
			}
			- " attribute\n  specified, to give a list of additional elements to crawl to find the name-value pairs of the\n  "
			a href="#concept-item" id="items:concept-item-11" {
				- "item"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="items:attr-itemref" {
				a href="#attr-itemref" {
					- "itemref"
				}
			}
			- " attribute, if specified, must have a value that\n  is an "
			a href="#unordered-set-of-unique-space-separated-tokens" id="items:unordered-set-of-unique-space-separated-tokens-2" {
				- "unordered set of unique space-separated tokens"
			}
			- " none of which are\n  "
			a id="items:identical-to-2" href="https://infra.spec.whatwg.org/#string-is" data-x-internal="identical-to" {
				- "identical to"
			}
			- " another token and consisting of "
			a href="https://dom.spec.whatwg.org/#concept-id" id="items:concept-id" data-x-internal="concept-id" {
