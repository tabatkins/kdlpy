		- "\n\n\n  "
		h6 id="the-before-html-insertion-mode" {
			span class="secno" {
				- "13.2.6.4.2"
			}
			- " The \""
			dfn {
				- "before html"
			}
			- "\" insertion mode"
			a href="#the-before-html-insertion-mode" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#the-before-html-insertion-mode" id="the-before-html-insertion-mode:the-before-html-insertion-mode" {
				- "before html"
			}
			- "\" "
			a href="#insertion-mode" id="the-before-html-insertion-mode:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as\n  follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A DOCTYPE token"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="the-before-html-insertion-mode:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "A comment token"
			}
			dd {
				- "\n    "
				p {
					a href="#insert-a-comment" id="the-before-html-insertion-mode:insert-a-comment" {
						- "Insert a comment"
					}
					- " as the last child of the "
					code id="the-before-html-insertion-mode:document" {
