							- "image"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "usability"
					}
					- " is "
					i {
						- "bad"
					}
					- ", then return (without drawing anything)."
				}
			}
			li {
				- "\n    "
				p {
					- "Establish the source and destination rectangles as follows:"
				}
				- "\n\n    "
				p {
					- "If not specified, the "
					var {
						- "dw"
					}
					- " and "
					var {
						- "dh"
					}
					- " arguments must default to the values of\n    "
					var {
						- "sw"
					}
					- " and "
					var {
						- "sh"
					}
