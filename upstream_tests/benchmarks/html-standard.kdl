		- "\n\n  "
		p {
			- "The "
			code id="the-script-element:the-script-element" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element allows authors to include dynamic script and data blocks in\n  their documents. The element does not "
			a href="#represents" id="the-script-element:represents" {
				- "represent"
			}
			- " content for the\n  user."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#attr-type" title="The <script> HTML element is used to embed executable code or data; this is typically used to embed or refer to JavaScript code. The <script> element can also be used with other languages, such as WebGL's GLSL shader programming language and JSON." {
						- "Element/script#attr-type"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "≤4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-type" data-dfn-type="element-attr" {
				code {
					- "type"
				}
			}
			- " attribute\n  allows customization of the type of script represented:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "Omitting the attribute, setting it to the empty string, or setting it to a\n    "
					a id="the-script-element:javascript-mime-type-essence-match" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type-essence-match" data-x-internal="javascript-mime-type-essence-match" {
						- "JavaScript MIME type essence match"
					}
					- ", means that the script is a "
					a href="#classic-script" id="the-script-element:classic-script" {
						- "classic\n    script"
					}
					- ", to be interpreted according to the JavaScript "
					i id="the-script-element:js-prod-script" {
						a data-x-internal="js-prod-script" href="https://tc39.es/ecma262/#prod-Script" {
							- "Script"
						}
					}
					- " top-level production. Classic scripts are affected by the\n    "
					code id="the-script-element:attr-script-async-2" {
						a href="#attr-script-async" {
							- "async"
						}
					}
					- " and "
					code id="the-script-element:attr-script-defer-2" {
						a href="#attr-script-defer" {
							- "defer"
						}
					}
					- "\n    attributes, but only when the "
					code id="the-script-element:attr-script-src-4" {
						a href="#attr-script-src" {
							- "src"
						}
					}
					- " attribute is set.\n    Authors should omit the "
					code id="the-script-element:attr-script-type-3" {
						a href="#attr-script-type" {
							- "type"
						}
					}
					- " attribute instead of\n    redundantly setting it."
				}
			}
			li {
				p {
					- "Setting the attribute to an "
					a id="the-script-element:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for \""
					code {
						- "module"
					}
					- "\" means that the script is a "
					a href="#javascript-module-script" id="the-script-element:javascript-module-script" {
						- "JavaScript module script"
					}
					- ", to\n    be interpreted according to the JavaScript "
					i id="the-script-element:js-prod-module" {
						a data-x-internal="js-prod-module" href="https://tc39.es/ecma262/#prod-Module" {
							- "Module"
						}
					}
					- " top-level\n    production. Module scripts are not affected by the "
					code id="the-script-element:attr-script-defer-3" {
						a href="#attr-script-defer" {
							- "defer"
						}
					}
					- " attribute, but are affected by the "
					code id="the-script-element:attr-script-async-3" {
						a href="#attr-script-async" {
							- "async"
						}
					}
					- " attribute (regardless of the state of the "
					code id="the-script-element:attr-script-src-5" {
						a href="#attr-script-src" {
							- "src"
						}
					}
					- " attribute)."
				}
			}
			li {
				p {
					- "Setting the attribute to an "
					a id="the-script-element:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for \""
					code {
						- "importmap"
					}
					- "\" means that the script is an "
					a href="#import-map" id="the-script-element:import-map" {
						- "import map"
					}
					- ", containing\n    JSON that will be used to control the behavior of "
					a href="#resolve-a-module-specifier" id="the-script-element:resolve-a-module-specifier" {
						- "module specifier resolution"
					}
					- ". Import maps can only be inline, i.e., the "
					code id="the-script-element:attr-script-src-6" {
						a href="#attr-script-src" {
							- "src"
						}
					}
					- " attribute and most other attributes are meaningless and not\n    to be used with them."
				}
			}
			li {
				p {
					- "Setting the attribute to any other value means that the script is a "
					dfn id="data-block" {
						- "data\n    block"
					}
					- ", which is not processed. None of the "
					code id="the-script-element:the-script-element-2" {
						a href="#the-script-element" {
							- "script"
						}
					}
					- " attributes (except "
					code id="the-script-element:attr-script-type-4" {
						a href="#attr-script-type" {
							- "type"
						}
					}
					- " itself) have any effect on data blocks. Authors must use\n    a "
					a id="the-script-element:valid-mime-type-string" href="https://mimesniff.spec.whatwg.org/#valid-mime-type" data-x-internal="valid-mime-type-string" {
						- "valid MIME type string"
					}
					- " that is not a "
					a id="the-script-element:javascript-mime-type-essence-match-2" href="https://mimesniff.spec.whatwg.org/#javascript-mime-type-essence-match" data-x-internal="javascript-mime-type-essence-match" {
						- "JavaScript MIME type essence\n    match"
					}
					- " to denote data blocks."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The requirement that "
			a href="#data-block" id="the-script-element:data-block" {
				- "data blocks"
			}
			- "\n  must be denoted using a "
			a id="the-script-element:valid-mime-type-string-2" href="https://mimesniff.spec.whatwg.org/#valid-mime-type" data-x-internal="valid-mime-type-string" {
				- "valid MIME type string"
			}
			- " is in place to\n  avoid potential future collisions. If this specification ever adds additional types of\n  "
			a href="#concept-script" id="the-script-element:concept-script" {
				- "script"
			}
			- ", they will be triggered by setting the "
			code id="the-script-element:attr-script-type-5" {
				a href="#attr-script-type" {
					- "type"
				}
			}
			- " attribute to something which is not a MIME type, like how\n  the \""
			code {
				- "module"
			}
			- "\" value denotes "
			a href="#module-script" id="the-script-element:module-script-2" {
				- "module\n  scripts"
			}
			- ". By using a valid MIME type string now, you ensure that your data block will not\n ever be reinterpreted as a different script type, even in future user agents."
		}
		- "\n\n  "
		p {
			a href="#classic-script" id="the-script-element:classic-script-2" {
				- "Classic scripts"
			}
			- " and "
			a href="#javascript-module-script" id="the-script-element:javascript-module-script-2" {
				- "JavaScript module scripts"
			}
			- " can be embedded inline, or be\n  imported from an external file using the "
			dfn data-dfn-for="script" id="attr-script-src" data-dfn-type="element-attr" {
				code {
					- "src"
				}
			}
			- " attribute, which if specified gives the "
			a id="the-script-element:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- "\n  of the external script resource to use. If "
			code id="the-script-element:attr-script-src-7" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- " is specified,\n  it must be a "
			a href="#valid-non-empty-url-potentially-surrounded-by-spaces" id="the-script-element:valid-non-empty-url-potentially-surrounded-by-spaces" {
				- "valid non-empty URL potentially surrounded by spaces"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The contents of inline "
			code id="the-script-element:the-script-element-3" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements, or the external script resource, must\n  conform with the requirements of the JavaScript specification's "
			i id="the-script-element:js-prod-script-2" {
				a data-x-internal="js-prod-script" href="https://tc39.es/ecma262/#prod-Script" {
					- "Script"
				}
			}
			- " or "
			i id="the-script-element:js-prod-module-2" {
				a data-x-internal="js-prod-module" href="https://tc39.es/ecma262/#prod-Module" {
					- "Module"
				}
			}
			- " productions, for "
			a href="#classic-script" id="the-script-element:classic-script-3" {
				- "classic scripts"
			}
			- " and "
			a href="#javascript-module-script" id="the-script-element:javascript-module-script-3" {
				- "JavaScript module scripts"
			}
			- " respectively. "
			a href="#refsJAVASCRIPT" {
				- "[JAVASCRIPT]"
			}
		}
		- "\n\n  "
		p {
			- "The contents of the external script resource for "
			a href="#css-module-script" id="the-script-element:css-module-script" {
				- "CSS module\n  scripts"
			}
			- " must conform to the requirements of the CSS specification. "
			a href="#refsCSS" {
				- "[CSS]"
			}
		}
		- "\n\n  "
		p {
			- "The contents of the external script resource for "
			a href="#json-module-script" id="the-script-element:json-module-script" {
				- "JSON module\n  scripts"
			}
			- " must conform to the requirements of the JSON specification. "
			a href="#refsJSON" {
				- "[JSON]"
			}
		}
		- "\n\n  "
		p {
			- "The contents of inline "
			code id="the-script-element:the-script-element-4" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements for "
			a href="#import-map" id="the-script-element:import-map-2" {
				- "import\n  maps"
			}
			- " must conform with the "
			a href="#import-map-authoring-requirements" id="the-script-element:import-map-authoring-requirements" {
				- "import map authoring requirements"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "For "
			a href="#import-map" id="the-script-element:import-map-3" {
				- "import map"
			}
			- " "
			code id="the-script-element:the-script-element-5" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements, the "
			code id="the-script-element:attr-script-src-8" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- ", "
			code id="the-script-element:attr-script-async-4" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- ", "
			code id="the-script-element:attr-script-nomodule-2" {
				a href="#attr-script-nomodule" {
					- "nomodule"
				}
			}
			- ", "
			code id="the-script-element:attr-script-defer-4" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- ",\n  "
			code id="the-script-element:attr-script-crossorigin-2" {
				a href="#attr-script-crossorigin" {
					- "crossorigin"
				}
			}
			- ", "
			code id="the-script-element:attr-script-integrity-2" {
				a href="#attr-script-integrity" {
					- "integrity"
				}
			}
			- ", and "
			code id="the-script-element:attr-script-referrerpolicy-2" {
				a href="#attr-script-referrerpolicy" {
					- "referrerpolicy"
				}
			}
			- " attributes must not be specified."
		}
		- "\n\n  "
		p {
			- "A document must not have more than one "
			a href="#import-map" id="the-script-element:import-map-4" {
				- "import map"
			}
			- " "
			code id="the-script-element:the-script-element-6" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element."
		}
		- "\n\n  "
		p {
			- "When used to include "
			a href="#data-block" id="the-script-element:data-block-2" {
				- "data blocks"
			}
			- ", the data must be embedded\n  inline, the format of the data must be given using the "
			code id="the-script-element:attr-script-type-6" {
				a href="#attr-script-type" {
					- "type"
				}
			}
			- "\n  attribute, and the contents of the "
			code id="the-script-element:the-script-element-7" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element must conform to the requirements\n  defined for the format used. The "
			code id="the-script-element:attr-script-src-9" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- ", "
			code id="the-script-element:attr-script-async-5" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- ", "
			code id="the-script-element:attr-script-nomodule-3" {
				a href="#attr-script-nomodule" {
					- "nomodule"
				}
			}
			- ",\n  "
			code id="the-script-element:attr-script-defer-5" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- ", "
			code id="the-script-element:attr-script-crossorigin-3" {
				a href="#attr-script-crossorigin" {
					- "crossorigin"
				}
			}
			- ", "
			code id="the-script-element:attr-script-integrity-3" {
				a href="#attr-script-integrity" {
					- "integrity"
				}
			}
			- ", "
			code id="the-script-element:attr-script-referrerpolicy-3" {
				a href="#attr-script-referrerpolicy" {
					- "referrerpolicy"
				}
			}
			- ", and "
			code id="the-script-element:attr-script-fetchpriority-2" {
				a href="#attr-script-fetchpriority" {
					- "fetchpriority"
				}
			}
			- " attributes must not be specified."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-nomodule" data-dfn-type="element-attr" {
				code {
					- "nomodule"
				}
			}
			- "\n  attribute is a "
			a href="#boolean-attribute" id="the-script-element:boolean-attribute" {
				- "boolean attribute"
			}
			- " that prevents a script from being executed in user\n  agents that support "
			a href="#module-script" id="the-script-element:module-script-3" {
				- "module scripts"
			}
			- ". This allows selective\n  execution of "
			a href="#module-script" id="the-script-element:module-script-4" {
				- "module scripts"
			}
			- " in modern user agents and "
			a href="#classic-script" id="the-script-element:classic-script-4" {
				- "classic scripts"
			}
			- " in older user agents, "
			a href="#script-nomodule-example" {
				- "as shown below"
			}
			- ". The "
			code id="the-script-element:attr-script-nomodule-4" {
				a href="#attr-script-nomodule" {
					- "nomodule"
				}
			}
			- " attribute must not be specified on "
			a href="#module-script" id="the-script-element:module-script-5" {
				- "module scripts"
			}
			- " (and will be ignored if it is)."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#attr-async" title="The <script> HTML element is used to embed executable code or data; this is typically used to embed or refer to JavaScript code. The <script> element can also be used with other languages, such as WebGL's GLSL shader programming language and JSON." {
						- "Element/script#attr-async"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "≤4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#attr-defer" title="The <script> HTML element is used to embed executable code or data; this is typically used to embed or refer to JavaScript code. The <script> element can also be used with other languages, such as WebGL's GLSL shader programming language and JSON." {
						- "Element/script#attr-defer"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "3.5+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "3+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "10+"
						}
					}
					hr
					span class="firefox_android yes" {
						span {
							- "Firefox Android"
						}
						span {
							- "4+"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-async" data-dfn-type="element-attr" {
				code {
					- "async"
				}
			}
			- " and\n  "
			dfn data-dfn-for="script" id="attr-script-defer" data-dfn-type="element-attr" {
				code {
					- "defer"
				}
			}
			- " attributes are\n  "
			a href="#boolean-attribute" id="the-script-element:boolean-attribute-2" {
				- "boolean attributes"
			}
			- " that indicate how the script should be\n  evaluated. "
			a href="#classic-script" id="the-script-element:classic-script-5" {
				- "Classic scripts"
			}
			- " may specify "
			code id="the-script-element:attr-script-defer-6" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " or "
			code id="the-script-element:attr-script-async-6" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- ", but must\n  not specify either unless the "
			code id="the-script-element:attr-script-src-10" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- " attribute is present.\n  "
			a href="#module-script" id="the-script-element:module-script-6" {
				- "Module scripts"
			}
			- " may specify the "
			code id="the-script-element:attr-script-async-7" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- " attribute, but must not specify the "
			code id="the-script-element:attr-script-defer-7" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		p {
			- "There are several possible modes that can be selected using these attributes, and depending on\n  the script's type."
		}
		- "\n\n  "
		p {
			- "For "
			a href="#classic-script" id="the-script-element:classic-script-6" {
				- "classic scripts"
			}
			- ", if the "
			code id="the-script-element:attr-script-async-8" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- " attribute is present, then the classic script will be\n  fetched "
			a href="#in-parallel" id="the-script-element:in-parallel" {
				- "in parallel"
			}
			- " to parsing and evaluated as soon as it is available (potentially\n  before parsing completes). If the "
			code id="the-script-element:attr-script-async-9" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- " attribute is not\n  present but the "
			code id="the-script-element:attr-script-defer-8" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " attribute is present, then the\n  classic script will be fetched "
			a href="#in-parallel" id="the-script-element:in-parallel-2" {
				- "in parallel"
			}
			- " and evaluated when the page has finished\n  parsing. If neither attribute is present, then the script is fetched and evaluated immediately,\n  blocking parsing until these are both complete."
		}
		- "\n\n  "
		p {
			- "For "
			a href="#module-script" id="the-script-element:module-script-7" {
				- "module scripts"
			}
			- ", if the "
			code id="the-script-element:attr-script-async-10" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- " attribute is present, then the module script and all its\n  dependencies will be fetched "
			a href="#in-parallel" id="the-script-element:in-parallel-3" {
				- "in parallel"
			}
			- " to parsing, and the module script will\n  be evaluated as soon as it is available (potentially before parsing completes). Otherwise, the\n  module script and its dependencies will be fetched "
			a href="#in-parallel" id="the-script-element:in-parallel-4" {
				- "in parallel"
			}
			- " to parsing and\n  evaluated when the page has finished parsing. (The "
			code id="the-script-element:attr-script-defer-9" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- "\n  attribute has no effect on module scripts.)"
		}
		- "\n\n  "
		p {
			- "This is all summarized in the following schematic diagram:"
		}
		- "\n\n  "
		p {
			img class="darkmode-aware" src="/images/asyncdefer.svg" alt="With <script>, parsing is interrupted by fetching and execution. With <script defer>, fetching is parallel to parsing and execution takes place after all parsing has finished. And with <script async>, fetching is parallel to parsing but once it finishes parsing is interrupted to execute the script. The story for <script type=\"module\"> is similar to <script defer>, but the dependencies will be fetched as well, and the story for <script type=\"module\" async> is similar to <script async> with the extra dependency fetching." style="width: 80%; min-width: 820px;"
		}
		- "\n\n  "
		p class="note" {
			- "The exact processing details for these attributes are, for mostly historical\n  reasons, somewhat non-trivial, involving a number of aspects of HTML. The implementation\n  requirements are therefore by necessity scattered throughout the specification. The algorithms\n  below (in this section) describe the core of this processing, but these algorithms reference and\n  are referenced by the parsing rules for "
			code id="the-script-element:the-script-element-8" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " "
			a href="#scriptTag" {
				- "start"
			}
			- " and "
			a href="#scriptEndTag" {
				- "end"
			}
			- " tags in HTML, "
			a href="#scriptForeignEndTag" {
				- "in foreign content"
			}
			- ",\n  and "
			a href="#scriptTagXML" {
				- "in XML"
			}
			- ", the rules for the "
			code id="the-script-element:dom-document-write" {
				a href="#dom-document-write" {
					- "document.write()"
				}
			}
			- " method, the handling of "
			a href="#scripting" {
				- "scripting"
			}
			- ", etc."
		}
		- "\n\n  "
		p class="note" {
			- "When inserted using the "
			code id="the-script-element:dom-document-write-2" {
				a href="#dom-document-write" {
					- "document.write()"
				}
			}
			- "\n  method, "
			code id="the-script-element:the-script-element-9" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " elements "
			a href="#document-written-scripts-intervention" {
				- "usually"
			}
			- "\n  execute (typically blocking further script execution or HTML parsing). When inserted using the\n  "
			code id="the-script-element:dom-element-innerhtml" {
				a href="#dom-element-innerhtml" {
					- "innerHTML"
				}
			}
			- " and "
			code id="the-script-element:dom-element-outerhtml" {
				a href="#dom-element-outerhtml" {
					- "outerHTML"
				}
			}
			- " attributes, they do not execute at all."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-script-element:attr-script-defer-10" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " attribute may be specified even if the "
			code id="the-script-element:attr-script-async-11" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- " attribute is specified, to cause legacy web browsers that\n  only support "
			code id="the-script-element:attr-script-defer-11" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " (and not "
			code id="the-script-element:attr-script-async-12" {
				a href="#attr-script-async" {
					- "async"
				}
			}
			- ") to fall back to the "
			code id="the-script-element:attr-script-defer-12" {
				a href="#attr-script-defer" {
					- "defer"
				}
			}
			- " behavior instead of the blocking behavior that\n  is the default."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-crossorigin" data-dfn-type="element-attr" {
				code {
					- "crossorigin"
				}
			}
			- " attribute is a "
			a href="#cors-settings-attribute" id="the-script-element:cors-settings-attribute" {
				- "CORS settings\n  attribute"
			}
			- ". For "
			a href="#classic-script" id="the-script-element:classic-script-7" {
				- "classic scripts"
			}
			- ", it controls whether\n  error information will be exposed, when the script is obtained from other "
			a href="#concept-origin" id="the-script-element:concept-origin" {
				- "origins"
			}
			- ". For "
			a href="#module-script" id="the-script-element:module-script-8" {
				- "module scripts"
			}
			- ", it\n  controls the "
			a href="https://fetch.spec.whatwg.org/#concept-request-credentials-mode" id="the-script-element:concept-request-credentials-mode" data-x-internal="concept-request-credentials-mode" {
				- "credentials mode"
			}
			- " used for\n  cross-origin requests."
		}
		- "\n\n  "
		p class="note" {
			- "Unlike "
			a href="#classic-script" id="the-script-element:classic-script-8" {
				- "classic scripts"
			}
			- ", "
			a href="#module-script" id="the-script-element:module-script-9" {
				- "module scripts"
			}
			- " require the use of the "
			a href="https://fetch.spec.whatwg.org/#http-cors-protocol" id="the-script-element:cors-protocol" data-x-internal="cors-protocol" {
				- "CORS protocol"
			}
			- " for cross-origin fetching."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-integrity" data-dfn-type="element-attr" {
				code {
					- "integrity"
				}
			}
			- "\n  attribute represents the "
			a href="https://fetch.spec.whatwg.org/#concept-request-integrity-metadata" id="the-script-element:concept-request-integrity-metadata" data-x-internal="concept-request-integrity-metadata" {
				- "integrity\n  metadata"
			}
			- " for requests which this element is responsible for. The value is text. The "
			code id="the-script-element:attr-script-integrity-4" {
				a href="#attr-script-integrity" {
					- "integrity"
				}
			}
			- " attribute must not be specified when the "
			code id="the-script-element:attr-script-src-11" {
				a href="#attr-script-src" {
					- "src"
				}
			}
			- " attribute is not specified. "
			a href="#refsSRI" {
				- "[SRI]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="script" id="attr-script-referrerpolicy" data-dfn-type="element-attr" {
				code {
					- "referrerpolicy"
				}
			}
			- " attribute is a "
			a href="#referrer-policy-attribute" id="the-script-element:referrer-policy-attribute" {
				- "referrer\n  policy attribute"
			}
			- ". Its purpose is to set the "
			a id="the-script-element:referrer-policy-2" href="https://w3c.github.io/webappsec-referrer-policy/#referrer-policy" data-x-internal="referrer-policy" {
				- "referrer policy"
			}
			- " used when "
			a href="https://fetch.spec.whatwg.org/#concept-fetch" id="the-script-element:concept-fetch-3" data-x-internal="concept-fetch" {
				- "fetching"
			}
			- " the script, as well as any scripts imported from it.\n  "
			a href="#refsREFERRERPOLICY" {
				- "[REFERRERPOLICY]"
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "An example of a "
				code id="the-script-element:the-script-element-10" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element's referrer policy being used when fetching\n   imported scripts but not other subresources:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					- " "
					c- e="" {
						- "referrerpolicy"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"origin\""
					}
					c- p="" {
						- ">"
					}
					- "\n  fetch"
					c- p="" {
						- "("
					}
					c- t="" {
