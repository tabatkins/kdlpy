											}
											- "'s "
											a href="#sandboxed-navigation-browsing-context-flag" id="navigable-target-names:sandboxed-navigation-browsing-context-flag" {
												- "sandboxed navigation browsing context\n         flag"
											}
											- " is set, then set "
											var {
												- "chosen"
											}
											- "'s "
											a href="#nav-bc" id="navigable-target-names:nav-bc-5" {
												- "active browsing\n         context"
											}
											- "'s "
											a href="#one-permitted-sandboxed-navigator" id="navigable-target-names:one-permitted-sandboxed-navigator-3" {
												- "one permitted sandboxed navigator"
											}
											- " to\n         "
											var {
												- "currentNavigable"
											}
											- "'s "
											a href="#nav-bc" id="navigable-target-names:nav-bc-6" {
												- "active browsing\n         context"
											}
											- "."
										}
									}
								}
								- "\n       "
							}
							li {
								p {
									- "If "
									var {
										- "sandboxingFlagSet"
									}
									- "'s "
									a href="#sandbox-propagates-to-auxiliary-browsing-contexts-flag" id="navigable-target-names:sandbox-propagates-to-auxiliary-browsing-contexts-flag" {
										- "sandbox propagates to auxiliary browsing\n       contexts flag"
									}
									- " is set, then all the flags that are set in "
									var {
										- "sandboxingFlagSet"
									}
									- "\n       must be set in "
									var {
										- "chosen"
									}
									- "'s "
									a href="#nav-bc" id="navigable-target-names:nav-bc-7" {
										- "active browsing context"
									}
									- "'s\n       "
									a href="#popup-sandboxing-flag-set" id="navigable-target-names:popup-sandboxing-flag-set" {
										- "popup sandboxing flag set"
									}
									- "."
								}
							}
						}
						- "\n\n      "
						p class="note" {
							- "If the newly created "
							a href="#navigable" id="navigable-target-names:navigable-8" {
								- "navigable"
							}
							- " "
							var {
								- "chosen"
							}
							- " is immediately\n      "
							a href="#navigate" id="navigable-target-names:navigate-3" {
								- "navigated"
							}
							- ", then the navigation will be done as a \""
							code id="navigable-target-names:navigationhistorybehavior-replace" {
								a href="#navigationhistorybehavior-replace" {
									- "replace"
								}
							}
							- "\" navigation."
						}
						- "\n     "
					}
					dt {
						- "If the user agent has been configured such that in this instance it will choose "
						var {
							- "currentNavigable"
						}
					}
					dd {
						p {
							- "Set "
							var {
								- "chosen"
							}
							- " to "
							var {
								- "currentNavigable"
							}
							- "."
						}
					}
					dt {
						- "If the user agent has been configured such that in this instance it will not find a navigable"
					}
					dd {
						p {
							- "Do nothing."
						}
					}
				}
				- "\n\n    "
				p class="note" {
					- "User agents are encouraged to provide a way for users to configure the user\n    agent to always choose "
					var {
						- "currentNavigable"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "chosen"
					}
					- " and "
					var {
						- "windowType"
					}
					- "."
				}
			}
		}
		- "\n\n\n  "
		h4 id="windows" {
			span class="secno" {
				- "7.3.2"
			}
			- " Browsing contexts"
			a href="#windows" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="browsing-context" data-export="" {
				- "browsing context"
			}
			- " is a programmatic representation of a series of documents,\n  multiple of which can live within a single "
			a href="#navigable" id="windows:navigable" {
				- "navigable"
			}
			- ". Each "
			a href="#browsing-context" id="windows:browsing-context" {
				- "browsing\n  context"
			}
			- " has a corresponding "
			code id="windows:windowproxy" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " object, as well as the following:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "An "
					dfn id="opener-browsing-context" data-export="" {
						- "opener browsing context"
					}
					- ", a "
					a href="#browsing-context" id="windows:browsing-context-2" {
						- "browsing context"
					}
					- " or null,\n   initially null."
				}
			}
			li {
				p {
					- "An "
					dfn id="opener-origin-at-creation" {
						- "opener origin at creation"
					}
					- ", an\n   "
					a href="#concept-origin" id="windows:concept-origin" {
						- "origin"
					}
					- " or null, initially null."
				}
				- "\n\n   "
			}
			li {
				- "\n    "
				p {
					- "An "
					dfn id="is-popup" {
						- "is popup"
					}
					- " boolean, initially false."
				}
				- "\n\n    "
				p class="note" {
					- "The only mandatory impact in this specification of "
					a href="#is-popup" id="windows:is-popup" {
						- "is popup"
					}
					- " is on\n    the "
					code id="windows:dom-barprop-visible" {
						a href="#dom-barprop-visible" {
							- "visible"
						}
					}
					- " getter of the relevant\n    "
					code id="windows:barprop" {
						a href="#barprop" {
							- "BarProp"
						}
					}
					- " objects. However, user agents might also use it for "
					a href="#nav-traversal-ui" {
						- "user interface considerations"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "An "
					dfn id="is-auxiliary" {
						- "is auxiliary"
					}
					- " boolean, initially false."
				}
			}
			li {
				p {
					- "An "
					dfn id="browsing-context-initial-url" {
						- "initial URL"
					}
					- ", a "
					a id="windows:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "URL"
					}
					- " or\n   null, initially null."
				}
			}
			li {
				p {
					- "A "
					dfn id="virtual-browsing-context-group-id" {
						- "virtual browsing context group ID"
					}
					- "\n   integer, initially 0. This is used by "
					a href="#coop-struct-report-only-value" id="windows:coop-struct-report-only-value" {
						- "opener policy\n   reporting"
					}
					- ", to keep track of the browsing context group switches that would have happened\n   if the report-only policy had been enforced."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context" id="windows:browsing-context-3" {
				- "browsing context"
			}
			- "'s "
			dfn id="active-window" {
				- "active window"
			}
			- " is its "
			code id="windows:windowproxy-2" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- "\n  object's "
			a href="#concept-windowproxy-window" id="windows:concept-windowproxy-window" {
				- "[[Window]]"
			}
			- " internal slot value. A\n  "
			a href="#browsing-context" id="windows:browsing-context-4" {
				- "browsing context"
			}
			- "'s "
			dfn id="active-document" {
				- "active document"
			}
			- " is its "
			a href="#active-window" id="windows:active-window" {
				- "active window"
			}
			- "'s\n  "
			a href="#concept-document-window" id="windows:concept-document-window" {
				- "associated "
				code {
					- "Document"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context" id="windows:browsing-context-5" {
				- "browsing context"
			}
			- "'s "
			dfn data-dfn-for="browsing context" id="bc-traversable" data-export="" {
				- "top-level traversable"
			}
			- " is its "
			a href="#active-document" id="windows:active-document" {
				- "active document"
			}
			- "'s\n  "
			a href="#node-navigable" id="windows:node-navigable" {
				- "node navigable"
			}
			- "'s "
			a href="#nav-top" id="windows:nav-top" {
				- "top-level traversable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#browsing-context" id="windows:browsing-context-6" {
				- "browsing context"
			}
			- " whose "
			a href="#is-auxiliary" id="windows:is-auxiliary" {
				- "is auxiliary"
			}
			- " is true is known as an "
			dfn id="auxiliary-browsing-context" data-export="" {
				- "auxiliary browsing context"
			}
			- ". Auxiliary browsing contexts are always "
			a href="#top-level-browsing-context" id="windows:top-level-browsing-context" {
				- "top-level browsing contexts"
			}
			- "."
		}
		- "\n\n  "
		p class="XXX" {
			- "It's unclear whether a separate "
			a href="#is-auxiliary" id="windows:is-auxiliary-2" {
				- "is auxiliary"
			}
			- " concept is necessary. In\n  "
			a href="https://github.com/whatwg/html/issues/5680" {
				- "issue #5680"
			}
			- ", it is indicated that we may\n  be able to simplify this by using whether or not the "
			a href="#opener-browsing-context" id="windows:opener-browsing-context" {
				- "opener browsing context"
			}
			- " is\n  null."
		}
		- "\n\n  "
		p id="warning-avoid-using-bcs" class="warning" {
			- "Modern specifications should avoid using the\n  "
			a href="#browsing-context" id="windows:browsing-context-7" {
				- "browsing context"
			}
			- " concept in most cases, unless they are dealing with the subtleties\n  of "
			a href="#browsing-context-group-switches-due-to-cross-origin-opener-policy" {
				- "browsing context\n  group switches"
			}
			- " and "
			a href="#agent-cluster-map" id="windows:agent-cluster-map" {
				- "agent cluster allocation"
			}
			- ". Instead,\n  the "
			code id="windows:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " and "
			a href="#navigable" id="windows:navigable-2" {
				- "navigable"
			}
			- " concepts are usually more appropriate."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn data-dfn-for="Document" id="concept-document-bc" data-lt="browsing context" data-export="" {
				code {
					- "Document"
				}
				- "'s browsing context"
			}
			- " is a "
			a href="#browsing-context" id="windows:browsing-context-8" {
				- "browsing context"
			}
			- " or null,\n  initially null."
		}
		- "\n\n  "
		p class="note" {
			- "A "
			code id="windows:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " does not necessarily have a non-null "
			a href="#concept-document-bc" id="windows:concept-document-bc" {
				- "browsing context"
			}
			- ". In particular, data mining tools are likely\n  to never instantiate browsing contexts. A "
			code id="windows:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- " created using an API such as "
			code id="windows:dom-domimplementation-createdocument" {
				a data-x-internal="dom-domimplementation-createdocument" href="https://dom.spec.whatwg.org/#dom-domimplementation-createdocument" {
					- "createDocument()"
				}
			}
			- " never has a non-null "
			a href="#concept-document-bc" id="windows:concept-document-bc-2" {
				- "browsing context"
			}
			- ". And the "
			code id="windows:document-4" {
				a href="#document" {
					- "Document"
				}
			}
			- " originally\n  created for an "
			code id="windows:the-iframe-element" {
				a href="#the-iframe-element" {
					- "iframe"
				}
			}
			- " element, which has since been "
			a href="#remove-an-element-from-a-document" id="windows:remove-an-element-from-a-document" {
				- "removed from the document"
			}
			- ", has no associated browsing context, since that\n  browsing context was "
			a href="#destroy-a-document" id="windows:destroy-a-document" {
				- "nulled out"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "In general, there is a 1-to-1 mapping from the "
			code id="windows:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " object to the\n  "
			code id="windows:document-5" {
				a href="#document" {
					- "Document"
				}
			}
			- " object, as long as the "
			code id="windows:document-6" {
				a href="#document" {
					- "Document"
				}
			}
			- " object has a non-null "
			a href="#concept-document-bc" id="windows:concept-document-bc-3" {
				- "browsing context"
			}
			- ". There is one exception. A\n  "
			code id="windows:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " can be reused for the presentation of a second "
			code id="windows:document-7" {
				a href="#document" {
					- "Document"
				}
			}
			- " in the\n  same "
			a href="#browsing-context" id="windows:browsing-context-9" {
				- "browsing context"
			}
			- ", such that the mapping is then 1-to-2. This occurs when a\n  "
			a href="#browsing-context" id="windows:browsing-context-10" {
				- "browsing context"
			}
			- " is "
			a href="#navigate" id="windows:navigate" {
				- "navigated"
			}
			- " from the "
			a href="#is-initial-about:blank" id="windows:is-initial-about:blank" {
				- "initial "
				code {
					- "about:blank"
				}
			}
			- " "
			code id="windows:document-8" {
				a href="#document" {
					- "Document"
				}
			}
			- " to\n  another, which will be done with "
			a href="#navigationhistorybehavior-replace" id="windows:navigationhistorybehavior-replace" {
				- "replacement"
			}
			- "."
		}
		- "\n\n  "
		h5 id="creating-browsing-contexts" {
			span class="secno" {
				- "7.3.2.1"
			}
			- " Creating browsing contexts"
			a href="#creating-browsing-contexts" class="self-link"
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="creating-a-new-browsing-context" {
				- "create a new browsing context and document"
			}
			- ", given null or a "
			code id="creating-browsing-contexts:document" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  object "
			var {
				- "creator"
			}
			- ", null or an element "
			var {
				- "embedder"
			}
			- ", and a "
			a href="#browsing-context-group" id="creating-browsing-contexts:browsing-context-group" {
				- "browsing context\n  group"
			}
			- " "
			var {
				- "group"
			}
			- ":"
		}
		- "\n\n  \n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "browsingContext"
					}
					- " be a new "
					a href="#browsing-context" id="creating-browsing-contexts:browsing-context" {
						- "browsing context"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "unsafeContextCreationTime"
					}
					- " be the\n   "
					a id="creating-browsing-contexts:unsafe-shared-current-time" href="https://w3c.github.io/hr-time/#dfn-unsafe-shared-current-time" data-x-internal="unsafe-shared-current-time" {
						- "unsafe shared current time"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "creatorOrigin"
					}
					- " be null."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "creatorBaseURL"
					}
					- " be null."
				}
			}
			li id="creator-browsing-context" {
				- "\n    "
				p {
					- "If "
					var {
						- "creator"
					}
					- " is non-null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Set "
							var {
								- "creatorOrigin"
							}
							- " to "
							var {
								- "creator"
							}
							- "'s "
							a href="https://dom.spec.whatwg.org/#concept-document-origin" id="creating-browsing-contexts:concept-document-origin" data-x-internal="concept-document-origin" {
								- "origin"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "creatorBaseURL"
							}
							- " to "
							var {
								- "creator"
							}
							- "'s "
							a href="#document-base-url" id="creating-browsing-contexts:document-base-url" {
								- "document base\n     URL"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "browsingContext"
							}
							- "'s "
							a href="#virtual-browsing-context-group-id" id="creating-browsing-contexts:virtual-browsing-context-group-id" {
								- "virtual browsing context group ID"
							}
							- " to\n     "
							var {
								- "creator"
							}
							- "'s "
							a href="#concept-document-bc" id="creating-browsing-contexts:concept-document-bc" {
								- "browsing context"
							}
							- "'s "
							a href="#bc-tlbc" id="creating-browsing-contexts:bc-tlbc" {
								- "top-level browsing context"
							}
							- "'s "
							a href="#virtual-browsing-context-group-id" id="creating-browsing-contexts:virtual-browsing-context-group-id-2" {
								- "virtual browsing context group ID"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "sandboxFlags"
					}
					- " be the result of "
					a href="#determining-the-creation-sandboxing-flags" id="creating-browsing-contexts:determining-the-creation-sandboxing-flags" {
						- "determining the creation sandboxing\n   flags"
					}
					- " given "
					var {
						- "browsingContext"
					}
					- " and "
					var {
						- "embedder"
					}
					- "."
				}
			}
			li id="about-blank-origin" {
				p {
					- "Let "
					var {
						- "origin"
					}
					- " be the result of "
					a href="#determining-the-origin" id="creating-browsing-contexts:determining-the-origin" {
						- "determining the\n   origin"
					}
					- " given "
					code id="creating-browsing-contexts:about:blank" {
						a href="#about:blank" {
							- "about:blank"
						}
					}
					- ", "
					var {
						- "sandboxFlags"
					}
					- ", and\n   "
					var {
						- "creatorOrigin"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "permissionsPolicy"
					}
					- " be the result of "
					a id="creating-browsing-contexts:creating-a-permissions-policy" href="https://w3c.github.io/webappsec-feature-policy/#create-for-navigable" data-x-internal="creating-a-permissions-policy" {
						- "creating a permissions policy"
					}
					- "\n    given "
					var {
						- "embedder"
					}
					- " and "
					var {
						- "origin"
					}
					- ". "
					a href="#refsPERMISSIONSPOLICY" {
						- "[PERMISSIONSPOLICY]"
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "agent"
					}
					- " be the result of "
					a href="#obtain-similar-origin-window-agent" id="creating-browsing-contexts:obtain-similar-origin-window-agent" {
						- "obtaining a similar-origin window agent"
					}
					- " given\n   "
					var {
						- "origin"
					}
					- ", "
					var {
						- "group"
					}
					- ", and false."
				}
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "realm execution context"
