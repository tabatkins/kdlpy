					a href="#stack-of-open-elements" id="parsing-main-intable:stack-of-open-elements-2" {
						- "stack of open elements"
					}
					- " does not "
					a href="#has-an-element-in-table-scope" id="parsing-main-intable:has-an-element-in-table-scope-2" {
						- "have a "
						code {
							- "table"
						}
						- " element in table scope"
					}
					- ", this is a "
					a href="#parse-errors" id="parsing-main-intable:parse-errors-3" {
						- "parse\n    error"
					}
					- "; ignore the token."
