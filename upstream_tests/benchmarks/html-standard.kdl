							}
						}
						tr {
							td {
								- "0x84 "
							}
							td {
								- "0x201E "
							}
							td {
								- "DOUBLE LOW-9 QUOTATION MARK („)\n      "
							}
						}
						tr {
							td {
								- "0x85 "
							}
							td {
								- "0x2026 "
							}
							td {
								- "HORIZONTAL ELLIPSIS (…)\n      "
							}
						}
						tr {
							td {
								- "0x86 "
							}
							td {
								- "0x2020 "
							}
							td {
								- "DAGGER (†)\n      "
							}
						}
						tr {
							td {
								- "0x87 "
							}
							td {
