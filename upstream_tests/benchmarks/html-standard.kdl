		- "\n\n  "
		p {
			- "To support the "
			a href="#custom-elements" {
				- "custom elements"
			}
			- " feature, all HTML elements have\n  special constructor behavior. This is indicated via the "
			dfn id="htmlconstructor" data-dfn-type="extended-attribute" data-lt="HTMLConstructor" {
				code {
					- "[HTMLConstructor]"
				}
			}
