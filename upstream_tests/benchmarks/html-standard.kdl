						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "USVString"
						}
						- " "
						a href="#dom-link-imagesrcset" id="the-link-element:dom-link-imagesrcset" {
							c- g="" {
								- "imageSrcset"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-link-element:cereactions-10" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-link-imagesizes" id="the-link-element:dom-link-imagesizes" {
							c- g="" {
								- "imageSizes"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-link-element:cereactions-11" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-link-referrerpolicy" id="the-link-element:dom-link-referrerpolicy" {
							c- g="" {
								- "referrerPolicy"
							}
						}
						- ";\n  ["
						c- g="" {
							- "SameObject"
						}
						- ", "
						c- g="" {
							- "PutForwards"
						}
						- "="
						a href="https://dom.spec.whatwg.org/#dom-domtokenlist-value" id="the-link-element:dom-domtokenlist-value-3" data-x-internal="dom-domtokenlist-value" {
							c- n="" {
								- "value"
							}
						}
						- "] "
						c- b="" {
							- "readonly"
						}
						- " "
						c- b="" {
							- "attribute"
						}
						- " "
						a id="the-link-element:domtokenlist-3" href="https://dom.spec.whatwg.org/#interface-domtokenlist" data-x-internal="domtokenlist" {
							c- n="" {
								- "DOMTokenList"
							}
						}
						- " "
						a href="#dom-link-blocking" id="the-link-element:dom-link-blocking" {
							c- g="" {
								- "blocking"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-link-element:cereactions-12" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "boolean"
						}
						- " "
						a href="#dom-link-disabled" id="the-link-element:dom-link-disabled" {
							c- g="" {
								- "disabled"
							}
						}
						- ";\n  ["
						a href="#cereactions" id="the-link-element:cereactions-13" {
							c- g="" {
								- "CEReactions"
							}
						}
						- "] "
						c- b="" {
							- "attribute"
						}
						- " "
						c- b="" {
							- "DOMString"
						}
						- " "
						a href="#dom-link-fetchpriority" id="the-link-element:dom-link-fetchpriority" {
							c- g="" {
								- "fetchPriority"
							}
						}
						- ";\n\n  // "
						a href="#HTMLLinkElement-partial" {
							- "also has obsolete members"
						}
						- "\n};\n"
						a href="#htmllinkelement" id="the-link-element:htmllinkelement" {
							c- n="" {
								- "HTMLLinkElement"
							}
						}
						- " "
						c- b="" {
							- "includes"
						}
						- " "
						a id="the-link-element:linkstyle" href="https://drafts.csswg.org/cssom/#the-linkstyle-interface" data-x-internal="linkstyle" {
							c- n="" {
								- "LinkStyle"
							}
						}
						- ";"
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-link-element:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element allows authors to link their document to other resources."
		}
		- "\n\n  "
		p {
			- "The address of the link(s) is given by the "
			dfn data-dfn-for="link" id="attr-link-href" data-dfn-type="element-attr" {
				code {
					- "href"
				}
			}
			- " attribute. If the "
			code id="the-link-element:attr-link-href-2" {
				a href="#attr-link-href" {
					- "href"
				}
			}
			- " attribute is present, then its value must be a "
			a href="#valid-non-empty-url-potentially-surrounded-by-spaces" id="the-link-element:valid-non-empty-url-potentially-surrounded-by-spaces" {
				- "valid\n  non-empty URL potentially surrounded by spaces"
			}
			- ". One or both of the "
			code id="the-link-element:attr-link-href-3" {
				a href="#attr-link-href" {
					- "href"
				}
			}
			- " or "
			code id="the-link-element:attr-link-imagesrcset-2" {
				a href="#attr-link-imagesrcset" {
					- "imagesrcset"
				}
			}
			- "\n  attributes must be present."
		}
		- "\n\n  "
		p {
			- "If both the "
			code id="the-link-element:attr-link-href-4" {
				a href="#attr-link-href" {
					- "href"
				}
			}
			- " and "
			code id="the-link-element:attr-link-imagesrcset-3" {
				a href="#attr-link-imagesrcset" {
					- "imagesrcset"
				}
			}
			- " attributes are absent, then the element does not\n  define a link."
		}
		- "\n\n  "
		p {
			- "The types of link indicated (the relationships) are given by the value of the "
			dfn data-dfn-for="link" id="attr-link-rel" data-dfn-type="element-attr" {
				code {
					- "rel"
				}
			}
			- " attribute, which, if present, must have a\n  value that is a "
			a href="#unordered-set-of-unique-space-separated-tokens" id="the-link-element:unordered-set-of-unique-space-separated-tokens" {
				- "unordered set of unique space-separated tokens"
			}
			- ". The "
			a href="#linkTypes" {
				- "allowed keywords and their meanings"
			}
			- " are defined in a later section. If the "
			code id="the-link-element:attr-link-rel-8" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute is absent, has no keywords, or if\n  none of the keywords used are allowed according to the definitions in this specification, then the\n  element does not create any links."
		}
		- "\n\n  \n\n  "
		p {
			code id="the-link-element:attr-link-rel-9" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- "'s\n  "
			a href="https://dom.spec.whatwg.org/#concept-supported-tokens" id="the-link-element:concept-supported-tokens" data-x-internal="concept-supported-tokens" {
				- "supported tokens"
			}
			- " are the keywords defined in\n  "
			a href="#linkTypes" {
				- "HTML link types"
			}
			- " which are allowed on "
			code id="the-link-element:the-link-element-2" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " elements, impact\n  the processing model, and are supported by the user agent. The possible "
			a href="https://dom.spec.whatwg.org/#concept-supported-tokens" id="the-link-element:concept-supported-tokens-2" data-x-internal="concept-supported-tokens" {
				- "supported tokens"
			}
			- " are\n  "
			code id="the-link-element:rel-alternate" {
				a href="#rel-alternate" {
					- "alternate"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-dns-prefetch" {
				a href="#link-type-dns-prefetch" {
					- "dns-prefetch"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-expect" {
				a href="#link-type-expect" {
					- "expect"
				}
			}
			- ",\n  "
			code id="the-link-element:rel-icon-2" {
				a href="#rel-icon" {
					- "icon"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-manifest" {
				a href="#link-type-manifest" {
					- "manifest"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-modulepreload-2" {
				a href="#link-type-modulepreload" {
					- "modulepreload"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-next" {
				a href="#link-type-next" {
					- "next"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-pingback" {
				a href="#link-type-pingback" {
					- "pingback"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-preconnect" {
				a href="#link-type-preconnect" {
					- "preconnect"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-prefetch" {
				a href="#link-type-prefetch" {
					- "prefetch"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-preload-4" {
				a href="#link-type-preload" {
					- "preload"
				}
			}
			- ",\n  "
			code id="the-link-element:link-type-search" {
				a href="#link-type-search" {
					- "search"
				}
			}
			- ", and\n  "
			code id="the-link-element:link-type-stylesheet" {
				a href="#link-type-stylesheet" {
					- "stylesheet"
				}
			}
			- ".\n  "
			code id="the-link-element:attr-link-rel-10" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- "'s "
			a href="https://dom.spec.whatwg.org/#concept-supported-tokens" id="the-link-element:concept-supported-tokens-3" data-x-internal="concept-supported-tokens" {
				- "supported\n  tokens"
			}
			- " must only include the tokens from this list that the user agent implements the\n  processing model for."
		}
		- "\n\n  "
		p class="note" {
			- "Theoretically a user agent could support the processing model for the "
			code id="the-link-element:link-type-canonical" {
				a href="#link-type-canonical" {
					- "canonical"
				}
			}
			- " keyword — if it were a search engine that executed\n  JavaScript. But in practice that's quite unlikely. So in most cases, "
			code id="the-link-element:link-type-canonical-2" {
				a href="#link-type-canonical" {
					- "canonical"
				}
			}
			- " ought not be included in "
			code id="the-link-element:attr-link-rel-11" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- "'s "
			a href="https://dom.spec.whatwg.org/#concept-supported-tokens" id="the-link-element:concept-supported-tokens-4" data-x-internal="concept-supported-tokens" {
				- "supported\n  tokens"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "A "
			code id="the-link-element:the-link-element-3" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element must have either a "
			code id="the-link-element:attr-link-rel-12" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- "\n  attribute or an "
			code id="the-link-element:names:-the-itemprop-attribute" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute, but not both."
		}
		- "\n\n  "
		p {
			- "If a "
			code id="the-link-element:the-link-element-4" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element has an "
			code id="the-link-element:names:-the-itemprop-attribute-2" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute,\n  or has a "
			code id="the-link-element:attr-link-rel-13" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute that contains only keywords that are\n  "
			a href="#body-ok" id="the-link-element:body-ok" {
				- "body-ok"
			}
			- ", then the element is said to be "
			dfn id="allowed-in-the-body" {
				- "allowed in the body"
			}
			- ". This means\n  that the element can be used where "
			a href="#phrasing-content-2" id="the-link-element:phrasing-content-2-3" {
				- "phrasing content"
			}
			- " is expected."
		}
		- "\n\n  "
		p class="note" {
			- "If the "
			code id="the-link-element:attr-link-rel-14" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute is used, the element can\n  only sometimes be used in the "
			code id="the-link-element:the-body-element" {
				a href="#the-body-element" {
					- "body"
				}
			}
			- " of the page. When used with the "
			code id="the-link-element:names:-the-itemprop-attribute-3" {
				a href="#names:-the-itemprop-attribute" {
					- "itemprop"
				}
			}
			- " attribute, the element can be used both in the\n  "
			code id="the-link-element:the-head-element-2" {
				a href="#the-head-element" {
					- "head"
				}
			}
			- " element and in the "
			code id="the-link-element:the-body-element-2" {
				a href="#the-body-element" {
					- "body"
				}
			}
			- " of the page, subject to the constraints of\n  the microdata model."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Two categories of links can be created using the "
			code id="the-link-element:the-link-element-5" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element: "
			a href="#external-resource-link" id="the-link-element:external-resource-link" {
				- "links to external resources"
			}
			- " and "
			a href="#hyperlink" id="the-link-element:hyperlink-3" {
				- "hyperlinks"
			}
			- ". The "
			a href="#linkTypes" {
				- "link types section"
			}
			- " defines\n  whether a particular link type is an external resource or a hyperlink. One "
			code id="the-link-element:the-link-element-6" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- "\n  element can create multiple links (of which some might be "
			a href="#external-resource-link" id="the-link-element:external-resource-link-2" {
				- "external resource links"
			}
			- " and some might be "
			a href="#hyperlink" id="the-link-element:hyperlink-4" {
				- "hyperlinks"
			}
			- "); exactly which and how many links are created depends on the\n  keywords given in the "
			code id="the-link-element:attr-link-rel-15" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute. User agents must process\n  the links on a per-link basis, not a per-element basis."
		}
		- "\n\n  "
		p class="note" {
			- "Each link created for a "
			code id="the-link-element:the-link-element-7" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element is handled separately. For\n  instance, if there are two "
			code id="the-link-element:the-link-element-8" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " elements with "
			code {
				- "rel=\"stylesheet\""
			}
			- ",\n  they each count as a separate external resource, and each is affected by its own attributes\n  independently. Similarly, if a single "
			code id="the-link-element:the-link-element-9" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element has a "
			code id="the-link-element:attr-link-rel-16" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute with the value "
			code {
				- "next stylesheet"
			}
			- ",\n  it creates both a "
			a href="#hyperlink" id="the-link-element:hyperlink-5" {
				- "hyperlink"
			}
			- " (for the "
			code id="the-link-element:link-type-next-2" {
				a href="#link-type-next" {
					- "next"
				}
			}
			- " keyword) and\n  an "
			a href="#external-resource-link" id="the-link-element:external-resource-link-3" {
				- "external resource link"
			}
			- " (for the "
			code id="the-link-element:link-type-stylesheet-2" {
				a href="#link-type-stylesheet" {
					- "stylesheet"
				}
			}
			- "\n  keyword), and they are affected by other attributes (such as "
			code id="the-link-element:attr-link-media-2" {
				a href="#attr-link-media" {
					- "media"
				}
			}
			- " or "
			code id="the-link-element:attr-link-title-3" {
				a href="#attr-link-title" {
					- "title"
				}
			}
			- ")\n  differently."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "For example, the following "
				code id="the-link-element:the-link-element-10" {
					a href="#the-link-element" {
						- "link"
					}
				}
				- " element creates two "
				a href="#hyperlink" id="the-link-element:hyperlink-6" {
					- "hyperlinks"
				}
				- " (to the same page):"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "link"
					}
					- " "
					c- e="" {
						- "rel"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"author license\""
					}
					- " "
					c- e="" {
						- "href"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"/about\""
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "The two links created by this element are one whose semantic is that the target page has\n   information about the current page's author, and one whose semantic is that the target page has\n   information regarding the license under which the current page is provided."
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			a href="#hyperlink" id="the-link-element:hyperlink-7" {
				- "Hyperlinks"
			}
			- " created with the "
			code id="the-link-element:the-link-element-11" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " element and its\n  "
			code id="the-link-element:attr-link-rel-17" {
				a href="#attr-link-rel" {
					- "rel"
				}
			}
			- " attribute apply to the whole document. This contrasts with\n  the "
			code id="the-link-element:attr-hyperlink-rel" {
				a href="#attr-hyperlink-rel" {
					- "rel"
				}
			}
			- " attribute of "
			code id="the-link-element:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " and "
			code id="the-link-element:the-area-element" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- "\n  elements, which indicates the type of a link whose context is given by the link's location within\n  the document."
		}
		- "\n\n  "
		p {
			- "Unlike those created by "
			code id="the-link-element:the-a-element-2" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " and "
			code id="the-link-element:the-area-element-2" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements, "
			a href="#hyperlink" id="the-link-element:hyperlink-8" {
				- "hyperlinks"
			}
			- " created by "
			code id="the-link-element:the-link-element-12" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- " elements are not displayed as\n  part of the document by default, in user agents that "
			a href="#renderingUA" {
				- "support the suggested\n  default rendering"
			}
			- ". And even if they are force-displayed using CSS, they have no\n  "
			a id="the-link-element:activation-behaviour" href="https://dom.spec.whatwg.org/#eventtarget-activation-behavior" data-x-internal="activation-behaviour" {
				- "activation behavior"
			}
			- ". Instead, they primarily provide semantic information which might\n  be used by the page or by other software that consumes the page's contents. Additionally, the user\n  agent can "
			a href="#providing-users-with-a-means-to-follow-hyperlinks-created-using-the-link-element" {
				- "provide\n  its own UI for following such hyperlinks"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The exact behavior for "
			a href="#external-resource-link" id="the-link-element:external-resource-link-4" {
				- "links to external resources"
			}
