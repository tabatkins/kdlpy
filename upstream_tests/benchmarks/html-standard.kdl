		- "\n\n  \n\n  "
		p {
			- "Every "
			code id="error-codes:mediaerror-3" {
				a href="#mediaerror" {
					- "MediaError"
				}
			}
			- " object has a "
			dfn id="concept-mediaerror-message" {
				- "message"
			}
			- ", which is a string, and a "
			dfn id="concept-mediaerror-code" {
				- "code"
			}
			- ", which is one of the following:"
		}
		- "\n\n  \n\n  "
		dl {
			dt {
				dfn data-dfn-for="MediaError" id="dom-mediaerror-media_err_aborted" data-dfn-type="const" {
					code {
						- "MEDIA_ERR_ABORTED"
					}
				}
				- " (numeric value 1)"
			}
			dd {
				- "The fetching process for the "
				a href="#media-resource" id="error-codes:media-resource" {
					- "media resource"
				}
				- " was aborted by the user agent at the\n   user's request."
			}
			dt {
				dfn data-dfn-for="MediaError" id="dom-mediaerror-media_err_network" data-dfn-type="const" {
					code {
						- "MEDIA_ERR_NETWORK"
					}
				}
				- " (numeric value 2)"
			}
			dd {
				- "A network error of some description caused the user agent to stop fetching the "
				a href="#media-resource" id="error-codes:media-resource-2" {
					- "media\n   resource"
				}
				- ", after the resource was established to be usable."
			}
			dt {
				dfn data-dfn-for="MediaError" id="dom-mediaerror-media_err_decode" data-dfn-type="const" {
					code {
