				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "q"
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "input"
				}
				- " "
				c- e="" {
					- "type"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "submit"
				}
				c- p="" {
					- ">"
				}
				- "\n"
				c- p="" {
					- "</"
				}
				c- f="" {
					- "form"
				}
				c- p="" {
					- ">"
				}
			}
		}
		- "\n\n  "
		p {
			- "Given the same user input, the result on submission is quite different: the user agent instead\n  does an HTTP POST to the given URL, with as the entity body something like the following text:"
		}
		- "\n\n  "
		pre {
			- "------kYFrd4jNJEgCervE\nContent-Disposition: form-data; name=\"t\"\n\ncats\n------kYFrd4jNJEgCervE\nContent-Disposition: form-data; name=\"q\"\n\nfur\n------kYFrd4jNJEgCervE--"
		}
		- "\n\n\n\n  \n\n  "
		h5 id="implicit-submission" {
			span class="secno" {
				- "4.10.21.2"
			}
			- " Implicit submission"
			a href="#implicit-submission" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			code id="implicit-submission:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element's "
			dfn id="default-button" {
				- "default button"
			}
			- " is the first "
			a href="#concept-submit-button" id="implicit-submission:concept-submit-button" {
				- "submit button"
			}
			- " in "
			a id="implicit-submission:tree-order" href="https://dom.spec.whatwg.org/#concept-tree-order" data-x-internal="tree-order" {
				- "tree order"
			}
			- " whose "
			a href="#form-owner" id="implicit-submission:form-owner" {
				- "form\n  owner"
			}
			- " is that "
			code id="implicit-submission:the-form-element-2" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element."
		}
		- "\n\n  "
		p {
			- "If the user agent supports letting the user submit a form implicitly (for example, on some\n  platforms hitting the \"enter\" key while a text control is "
			a href="#focused" id="implicit-submission:focused" {
				- "focused"
			}
			- " implicitly submits\n  the form), then doing so for a form, whose "
			a href="#default-button" id="implicit-submission:default-button" {
				- "default button"
			}
			- " has "
			a id="implicit-submission:activation-behaviour" href="https://dom.spec.whatwg.org/#eventtarget-activation-behavior" data-x-internal="activation-behaviour" {
				- "activation\n  behavior"
			}
			- " and is not "
			a href="#concept-fe-disabled" id="implicit-submission:concept-fe-disabled" {
				- "disabled"
			}
			- ", must cause the user\n  agent to "
			a href="#fire-a-click-event" id="implicit-submission:fire-a-click-event" {
				- "fire a "
				code {
					- "click"
				}
				- " event"
			}
			- " at that "
			a href="#default-button" id="implicit-submission:default-button-2" {
				- "default\n  button"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "There are pages on the web that are only usable if there is a way to implicitly\n  submit forms, so user agents are strongly encouraged to support this."
		}
		- "\n\n  "
		p {
			- "If the form has\n  no "
			a href="#concept-submit-button" id="implicit-submission:concept-submit-button-2" {
				- "submit button"
			}
			- ", then the implicit submission\n  mechanism must perform the following steps:\n\n  "
		}
		ol {
			li {
				p {
					- "If the form has more than one "
					a href="#field-that-blocks-implicit-submission" id="implicit-submission:field-that-blocks-implicit-submission" {
						- "field that blocks implicit submission"
					}
					- ", then\n   return."
				}
			}
			li {
				p {
					a href="#concept-form-submit" id="implicit-submission:concept-form-submit" {
						- "Submit"
					}
					- " the "
					code id="implicit-submission:the-form-element-3" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element from the\n   "
					code id="implicit-submission:the-form-element-4" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element itself with "
					i id="implicit-submission:submit-user-involvement" {
						a href="#submit-user-involvement" {
							- "userInvolvement"
						}
					}
					- " set\n   to \""
					code id="implicit-submission:uni-activation" {
						a href="#uni-activation" {
