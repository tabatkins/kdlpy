					- "Let "
					var {
						- "coopEnforcementResult"
					}
					- " be "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-coop-enforcement-result" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:navigation-params-coop-enforcement-result" {
						- "COOP enforcement result"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "swapGroup"
					}
					- " be "
					var {
						- "coopEnforcementResult"
					}
					- "'s "
					a href="#coop-enforcement-bcg-switch" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-enforcement-bcg-switch-4" {
						- "needs a browsing context group switch"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "sourceOrigin"
					}
					- " be "
					var {
						- "browsingContext"
					}
					- "'s\n   "
					a href="#active-document" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:active-document-2" {
						- "active document"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-document-origin" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "destinationOrigin"
					}
					- " be "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-origin" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:navigation-params-origin" {
						- "origin"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "sourceOrigin"
					}
					- " is not "
					a href="#same-site" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:same-site" {
						- "same site"
					}
					- " with\n    "
					var {
						- "destinationOrigin"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						- "\n      "
						p {
							- "If either of "
							var {
								- "sourceOrigin"
							}
							- " or "
							var {
								- "destinationOrigin"
							}
							- " have a "
							a href="#concept-origin-scheme" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-origin-scheme" {
								- "scheme"
							}
							- " that is not an "
							a id="browsing-context-group-switches-due-to-cross-origin-opener-policy:http(s)-scheme" href="https://fetch.spec.whatwg.org/#http-scheme" data-x-internal="http(s)-scheme" {
								- "HTTP(S) scheme"
							}
							- " and\n      the user agent considers it necessary for "
							var {
								- "sourceOrigin"
							}
							- " and\n      "
							var {
								- "destinationOrigin"
							}
							- " to be isolated from each other (for\n      "
							a id="browsing-context-group-switches-due-to-cross-origin-opener-policy:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
								- "implementation-defined"
							}
							- " reasons), optionally set "
							var {
								- "swapGroup"
							}
							- " to true."
						}
						- "\n\n      "
						p class="note" {
							- "For example, if a user navigates from "
							code {
								- "about:settings"
							}
							- " to\n      "
							code {
								- "https://example.com"
							}
							- ", the user agent could force a swap."
						}
						- "\n\n      "
						p class="XXX" {
							a href="https://github.com/whatwg/html/issues/10842" {
								- "Issue #10842"
							}
							- " tracks\n      settling on an interoperable behavior here, instead of letting this be optional."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "If "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#navigation-params-user-involvement" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:navigation-params-user-involvement" {
								- " user\n      involvement"
							}
							- " is \""
							code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:uni-browser-ui" {
								a href="#uni-browser-ui" {
									- "browser UI"
								}
							}
							- "\", optionally set\n      "
							var {
								- "swapGroup"
							}
							- " to true."
						}
						- "\n\n      "
						p class="XXX" {
							a href="https://github.com/whatwg/html/issues/6356" {
								- "Issue #6356"
							}
							- " tracks\n      settling on an interoperable behavior here, instead of letting this be optional."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:tlbc-group-3" {
						- "group"
					}
					- "'s "
					a href="#browsing-context-set" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:browsing-context-set-3" {
						- "browsing\n    context set"
					}
					- "'s "
					a href="https://infra.spec.whatwg.org/#list-size" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:list-size-3" data-x-internal="list-size" {
						- "size"
					}
					- " is 1, optionally set\n    "
					var {
						- "swapGroup"
					}
					- " to true."
				}
				- "\n\n    "
				p class="note" {
					- "Some implementations swap browsing context groups here for performance\n    reasons."
				}
				- "\n\n    "
				p class="note" {
					- "The check for other contexts that could script this one is not sufficient to\n    prevent differences in behavior that could affect a web page. Even if there are currently no\n    other contexts, the destination page could open a window, then if the user navigates back, the\n    previous page could expect to be able to script the opened window. Doing a swap here would break\n    that use case."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "swapGroup"
					}
					- " is false, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "coopEnforcementResult"
							}
							- "'s "
							a href="#coop-enforcement-bcg-switch-report-only" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-enforcement-bcg-switch-report-only-4" {
								- "would need a browsing context group switch\n     due to report-only"
							}
							- " is true, set "
							var {
								- "browsing context"
							}
							- "'s "
							a href="#virtual-browsing-context-group-id" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:virtual-browsing-context-group-id" {
								- "virtual browsing context group ID"
							}
							- " to a new\n     unique identifier."
						}
					}
					li {
						p {
							- "Return "
							var {
								- "browsingContext"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "newBrowsingContext"
					}
					- " be the first return value of "
					a href="#creating-a-new-top-level-browsing-context" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:creating-a-new-top-level-browsing-context" {
						- "creating a new\n    top-level browsing context and document"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "In this case we are going to perform a browsing context group swap.\n    "
					var {
						- "browsingContext"
					}
					- " will not be used by the new "
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:document" {
						a href="#document" {
							- "Document"
						}
					}
					- " that we are about\n    to "
					a href="#initialise-the-document-object" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:initialise-the-document-object" {
						- "create"
					}
					- ". If it is not used by other\n    "
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:document-2" {
						a href="#document" {
							- "Document"
						}
					}
					- "s either (such as ones in the back/forward cache), then the user agent\n    might "
					a href="#a-browsing-context-is-discarded" {
						- "destroy it"
					}
					- " at this point."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "navigationCOOP"
					}
					- " be "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-coop" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:navigation-params-coop" {
						- "cross-origin opener policy"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "navigationCOOP"
					}
					- "'s "
					a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-8" {
						- "value"
					}
					- " is \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-same-origin-plus-coep" {
						a href="#coop-same-origin-plus-coep" {
							- "same-origin-plus-COEP"
						}
					}
					- "\", then set\n    "
					var {
						- "newBrowsingContext"
					}
					- "'s "
					a href="#tlbc-group" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:tlbc-group-4" {
						- "group"
					}
					- "'s "
					a href="#bcg-cross-origin-isolation" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:bcg-cross-origin-isolation" {
						- "cross-origin isolation mode"
					}
					- " to either \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:cross-origin-isolation-logical" {
						a href="#cross-origin-isolation-logical" {
							- "logical"
						}
					}
					- "\" or \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:cross-origin-isolation-concrete" {
						a href="#cross-origin-isolation-concrete" {
							- "concrete"
						}
					}
					- "\". The choice of which is\n    "
					a id="browsing-context-group-switches-due-to-cross-origin-opener-policy:implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "It is difficult on some platforms to provide the security properties required\n    by the "
					a href="#concept-settings-object-cross-origin-isolated-capability" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:concept-settings-object-cross-origin-isolated-capability" {
						- "cross-origin\n    isolated capability"
					}
					- ". \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:cross-origin-isolation-concrete-2" {
						a href="#cross-origin-isolation-concrete" {
							- "concrete"
						}
					}
					- "\"\n    grants access to it and \""
					code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:cross-origin-isolation-logical-2" {
						a href="#cross-origin-isolation-logical" {
							- "logical"
						}
					}
					- "\" does\n    not."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "sandboxFlags"
					}
					- " be a "
					a href="https://infra.spec.whatwg.org/#list-clone" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:list-clone" data-x-internal="list-clone" {
						- "clone"
					}
					- " of\n   "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-sandboxing" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:navigation-params-sandboxing" {
						- "final sandboxing flag set"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "sandboxFlags"
					}
					- " is not empty, then:"
				}
				- "\n    "
				ol {
					li {
						p {
							a id="browsing-context-group-switches-due-to-cross-origin-opener-policy:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "navigationCOOP"
							}
							- "'s "
							a href="#coop-struct-value" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-struct-value-9" {
								- "value"
							}
							- " is\n     \""
							code id="browsing-context-group-switches-due-to-cross-origin-opener-policy:coop-unsafe-none-2" {
								a href="#coop-unsafe-none" {
									- "unsafe-none"
								}
							}
							- "\"."
						}
					}
					li {
						p {
							a id="browsing-context-group-switches-due-to-cross-origin-opener-policy:assert-2" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "newBrowsingContext"
							}
							- "'s "
							a href="#popup-sandboxing-flag-set" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:popup-sandboxing-flag-set" {
								- "popup sandboxing flag\n     set"
							}
							- " "
							a href="https://infra.spec.whatwg.org/#list-is-empty" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:list-is-empty" data-x-internal="list-is-empty" {
								- "is empty"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "newBrowsingContext"
							}
							- "'s "
							a href="#popup-sandboxing-flag-set" id="browsing-context-group-switches-due-to-cross-origin-opener-policy:popup-sandboxing-flag-set-2" {
								- "popup sandboxing flag set"
							}
							- " to\n     "
							var {
								- "sandboxFlags"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "newBrowsingContext"
					}
					- "."
				}
			}
		}
		- "\n\n\n  "
		h5 id="coop-reporting" {
			span class="secno" {
				- "7.1.3.3"
			}
			- " "
			span id="reporting"
			- "Reporting"
			a href="#coop-reporting" class="self-link"
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="accessor-accessed-relationship" {
				- "accessor-accessed relationship"
			}
			- " is an enum that describes the relationship\n  between two "
			a href="#browsing-context" id="coop-reporting:browsing-context" {
				- "browsing contexts"
			}
			- " between which an access\n  happened. It can take the following values:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="accessor-accessed-opener" {
					- "accessor is opener"
				}
			}
			dd {
				p {
					- "The accessor "
					a href="#browsing-context" id="coop-reporting:browsing-context-2" {
						- "browsing context"
					}
					- " or one of its "
					a href="#ancestor-browsing-context" id="coop-reporting:ancestor-browsing-context" {
						- "ancestors"
					}
					- " is the "
					a href="#opener-browsing-context" id="coop-reporting:opener-browsing-context" {
						- "opener browsing context"
					}
					- " of the accessed\n   "
					a href="#browsing-context" id="coop-reporting:browsing-context-3" {
						- "browsing context"
					}
					- "'s "
					a href="#bc-tlbc" id="coop-reporting:bc-tlbc" {
						- "top-level browsing\n   context"
					}
					- "."
				}
			}
			dt {
				dfn id="accessor-accessed-openee" {
					- "accessor is openee"
				}
			}
			dd {
				p {
					- "The accessed "
					a href="#browsing-context" id="coop-reporting:browsing-context-4" {
						- "browsing context"
					}
					- " or one of its "
					a href="#ancestor-browsing-context" id="coop-reporting:ancestor-browsing-context-2" {
						- "ancestors"
					}
					- " is the "
					a href="#opener-browsing-context" id="coop-reporting:opener-browsing-context-2" {
						- "opener browsing context"
					}
					- " of the accessor\n   "
					a href="#browsing-context" id="coop-reporting:browsing-context-5" {
						- "browsing context"
					}
					- "'s "
					a href="#bc-tlbc" id="coop-reporting:bc-tlbc-2" {
						- "top-level browsing\n   context"
					}
					- "."
				}
			}
			dt {
				dfn id="accessor-accessed-none" {
					- "none"
				}
			}
			dd {
				p {
					- "There is no opener relationship between the accessor "
					a href="#browsing-context" id="coop-reporting:browsing-context-6" {
						- "browsing context"
					}
					- ", the\n   accessor "
					a href="#browsing-context" id="coop-reporting:browsing-context-7" {
						- "browsing context"
					}
					- ", or any of their "
					a href="#ancestor-browsing-context" id="coop-reporting:ancestor-browsing-context-3" {
						- "ancestors"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="coop-check-access-report" {
				- "check if an access between two browsing contexts\n  should be reported"
			}
			- ", given two "
			a href="#browsing-context" id="coop-reporting:browsing-context-8" {
				- "browsing contexts"
			}
			- "\n  "
			var {
				- "accessor"
			}
			- " and "
			var {
				- "accessed"
			}
			- ", a JavaScript property name "
			var {
				- "P"
			}
			- ", and an\n  "
			a href="#environment-settings-object" id="coop-reporting:environment-settings-object" {
				- "environment settings object"
			}
			- " "
			var {
				- "environment"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "P"
					}
					- " is not a "
					a href="#cross-origin-accessible-window-property-name" id="coop-reporting:cross-origin-accessible-window-property-name" {
						- "cross-origin accessible window property name"
					}
					- ", then\n   return."
				}
			}
			li {
				p {
					a id="coop-reporting:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": "
					var {
						- "accessor"
					}
					- "'s "
					a href="#active-document" id="coop-reporting:active-document" {
						- "active document"
					}
					- " and\n   "
					var {
						- "accessed"
					}
					- "'s "
					a href="#active-document" id="coop-reporting:active-document-2" {
						- "active document"
					}
					- " are both "
					a href="#fully-active" id="coop-reporting:fully-active" {
						- "fully active"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "accessorTopDocument"
					}
					- " be "
					var {
						- "accessor"
					}
					- "'s "
					a href="#bc-tlbc" id="coop-reporting:bc-tlbc-3" {
						- "top-level browsing context"
					}
					- "'s "
					a href="#active-document" id="coop-reporting:active-document-3" {
						- "active document"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "accessorInclusiveAncestorOrigins"
					}
					- " be the list obtained by taking the "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="coop-reporting:concept-document-origin" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " of the "
					a href="#nav-document" id="coop-reporting:nav-document" {
						- "active\n   document"
					}
					- " of each of "
					var {
						- "accessor"
