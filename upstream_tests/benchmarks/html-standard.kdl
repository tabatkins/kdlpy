								- "fieldset"
							}
						}
						- " element itself."
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				p {
					- "The element is expected to be positioned in the block-flow direction such that its border\n   box is centered over the border on the block-start side of the "
					code id="the-fieldset-and-legend-elements:the-fieldset-element-14" {
						a href="#the-fieldset-element" {
							- "fieldset"
						}
					}
					- "\n   element."
