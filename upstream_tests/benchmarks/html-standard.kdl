							- "scripting flag"
						}
						- " is enabled, switch the tokenizer to the "
						a href="#rawtext-state" id="parsing-html-fragments:rawtext-state-2" {
							- "RAWTEXT\n     state"
						}
						- ". Otherwise, leave the tokenizer in the "
						a href="#data-state" id="parsing-html-fragments:data-state" {
							- "data state"
