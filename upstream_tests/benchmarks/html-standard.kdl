		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			code id="the-canvas-element:the-canvas-element-19" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element has two attributes to control the size of the element's bitmap:\n  "
			dfn data-dfn-for="canvas" id="attr-canvas-width" data-dfn-type="element-attr" {
				code {
					- "width"
				}
			}
			- " and "
			dfn data-dfn-for="canvas" id="attr-canvas-height" data-dfn-type="element-attr" {
				code {
					- "height"
				}
			}
			- ". These attributes,\n  when specified, must have values that are "
			a href="#valid-non-negative-integer" id="the-canvas-element:valid-non-negative-integer" {
				- "valid\n  non-negative integers"
			}
			- ".  The "
			a href="#rules-for-parsing-non-negative-integers" id="the-canvas-element:rules-for-parsing-non-negative-integers" {
				- "rules for parsing non-negative\n  integers"
			}
			- " must be used to "
			dfn id="obtain-numeric-values" {
				- "obtain their numeric\n  values"
			}
			- ". If an attribute is missing, or if parsing its value returns an error, then the\n  default value must be used instead. The "
			code id="the-canvas-element:attr-canvas-width-2" {
				a href="#attr-canvas-width" {
					- "width"
				}
			}
			- "\n  attribute defaults to 300, and the "
			code id="the-canvas-element:attr-canvas-height-2" {
				a href="#attr-canvas-height" {
					- "height"
				}
			}
			- " attribute\n  defaults to 150."
		}
		- "\n\n  "
		p {
			- "When setting the value of the "
			code id="the-canvas-element:attr-canvas-width-3" {
				a href="#attr-canvas-width" {
					- "width"
				}
			}
			- " or "
			code id="the-canvas-element:attr-canvas-height-3" {
				a href="#attr-canvas-height" {
					- "height"
				}
