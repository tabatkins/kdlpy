					}
					- "\" algorithm, with the "
					i {
						- "specified size"
					}
					- " having neither a definite width\n    nor height, nor any additional constraints, the object's natural properties being those of the\n    "
					var {
						- "image"
					}
					- " argument, and the "
					a id="drawing-images:default-object-size" href="https://drafts.csswg.org/css-images/#default-object-size" data-x-internal="default-object-size" {
						- "default object size"
					}
					- " being the size of the\n    "
					a href="#output-bitmap" id="drawing-images:output-bitmap-2" {
						- "output bitmap"
					}
					- ". "
					a href="#refsCSSIMAGES" {
						- "[CSSIMAGES]"
					}
				}
				- "\n\n    "
				p {
					- "The source rectangle is the rectangle whose corners are the four points ("
					var {
						- "sx"
					}
					- ", "
					var {
						- "sy"
					}
					- "), ("
					var {
						- "sx"
					}
					- "+"
					var {
						- "sw"
					}
					- ", "
					var {
						- "sy"
					}
					- "), ("
					var {
						- "sx"
					}
					- "+"
					var {
