		- "\n\n  "
		p class="note" {
			- "The "
			a href="#hide-all-popovers-until" id="the-popover-attribute:hide-all-popovers-until-8" {
				- "hide all popovers until\n  algorithm"
			}
			- " is used in several cases to hide all popovers that don't stay open when something\n  happens. For example, during light-dismiss of a popover, this algorithm ensures that we close only\n  the popovers that aren't related to the node clicked by the user."
		}
		- "\n\n  "
		p {
			- "To find the "
			dfn id="topmost-popover-ancestor" data-export="" {
				- "topmost popover ancestor"
			}
			- ", given a "
			code id="the-popover-attribute:node" {
				a data-x-internal="node" href="https://dom.spec.whatwg.org/#interface-node" {
					- "Node"
				}
			}
			- "\n  "
			var {
				- "newPopoverOrTopLayerElement"
			}
			- ", a "
			a id="the-popover-attribute:list-2" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
				- "list"
			}
			- " "
			var {
				- "popoverList"
			}
			- ", an "
			a href="#html-elements" id="the-popover-attribute:html-elements-17" {
