					}
					c- p="" {
						- ">"
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "To let the user select the size of the pizza, we can use a set of radio buttons. Radio buttons\n  also use the "
			code id="writing-a-form's-user-interface:the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " element, this time with a "
			code id="writing-a-form's-user-interface:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute with the value "
			code id="writing-a-form's-user-interface:radio-button-state-(type=radio)" {
				a href="#radio-button-state-(type=radio)" {
					- "radio"
				}
			}
			- ". To make the radio buttons work as a group, they are\n  given a common name using the "
			code id="writing-a-form's-user-interface:attr-fe-name" {
				a href="#attr-fe-name" {
					- "name"
				}
			}
			- " attribute. To group a batch\n  of controls together, such as, in this case, the radio buttons, one can use the\n  "
			code id="writing-a-form's-user-interface:the-fieldset-element" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- " element. The title of such a group of controls is given by the first element\n  in the "
			code id="writing-a-form's-user-interface:the-fieldset-element-2" {
				a href="#the-fieldset-element" {
					- "fieldset"
				}
			}
			- ", which has to be a "
			code id="writing-a-form's-user-interface:the-legend-element" {
				a href="#the-legend-element" {
					- "legend"
				}
			}
			- " element."
		}
