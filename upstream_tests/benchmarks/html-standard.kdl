			}
		}
		- "\n\n  "
		p {
			- "Adding a static "
			code {
				- "formAssociated"
			}
			- " property, with a true value, makes an\n  "
			a href="#autonomous-custom-element" id="custom-elements-face-example:autonomous-custom-element" {
