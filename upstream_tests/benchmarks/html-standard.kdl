			- " for a "
			a id="relevant:platform-object-2" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
				- "platform object"
			}
			- "\n  "
			var {
				- "o"
			}
			- " is the "
			a href="#concept-realm-settings-object" id="relevant:concept-realm-settings-object" {
				- "environment settings\n  object"
			}
			- " of the "
			a href="#concept-relevant-realm" id="relevant:concept-relevant-realm" {
				- "relevant realm"
			}
			- " for\n  "
			var {
				- "o"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Similarly, the "
			dfn id="concept-relevant-global" data-export="" {
				- "relevant global object"
			}
			- " for a\n  "
			a id="relevant:platform-object-3" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
				- "platform object"
			}
			- " "
			var {
				- "o"
			}
			- " is the "
			a href="#concept-realm-global" id="relevant:concept-realm-global" {
