								- "insertion mode"
							}
							- " to \""
							a href="#parsing-main-inselect" id="the-insertion-mode:parsing-main-inselect-3" {
								- "in select"
							}
							- "\" and return."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "node"
					}
					- " is a "
