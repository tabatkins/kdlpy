					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-none" data-dfn-type="attr-value" {
							code {
								- "none"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should not display a virtual keyboard. This keyword is useful for content\n     that renders its own keyboard control.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-text" data-dfn-type="attr-value" {
							code {
								- "text"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should display a virtual keyboard capable of text input in the user's locale.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-tel" data-dfn-type="attr-value" {
							code {
								- "tel"
							}
						}
						- "\n\n     "
					}
					td {
						- " The user agent should display a virtual keyboard capable of telephone number input. This\n     should including keys for the digits 0 to 9, the \"#\" character, and the \"*\" character. In some\n     locales, this can also include alphabetic mnemonic labels (e.g., in the US, the key labeled\n     \"2\" is historically also labeled with the letters A, B, and C).\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-url" data-dfn-type="attr-value" {
							code {
								- "url"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should display a virtual keyboard capable of text input in the user's locale,\n     with keys for aiding in the input of "
						a href="https://url.spec.whatwg.org/#concept-url" id="input-modalities:-the-inputmode-attribute:url" data-x-internal="url" {
							- "URLs"
						}
						- ", such as that for the \"/\"\n     and \".\" characters and for quick input of strings commonly found in domain names such as\n     \"www.\" or \".com\".\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-email" data-dfn-type="attr-value" {
							code {
								- "email"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should display a virtual keyboard capable of text input in the user's locale,\n     with keys for aiding in the input of email addresses, such as that for the \"@\" character\n     and the \".\" character.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-numeric" data-dfn-type="attr-value" {
							code {
								- "numeric"
							}
						}
						- "\n\n     "
					}
					td {
						- " The user agent should display a virtual keyboard capable of numeric input. This keyword\n     is useful for PIN entry.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-decimal" data-dfn-type="attr-value" {
							code {
								- "decimal"
							}
						}
						- "\n\n     "
					}
					td {
						- " The user agent should display a virtual keyboard capable of fractional numeric input.\n     Numeric keys and the format separator for the locale should be shown.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" id="attr-inputmode-keyword-search" data-dfn-type="attr-value" {
							code {
								- "search"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should display a virtual keyboard optimized for search.\n  "
					}
				}
			}
		}
