								- "coarsening"
							}
							- "\n     "
							var {
								- "unsafeWorkerCreationTime"
							}
							- " with "
							var {
								- "worker global scope"
							}
							- "'s "
							a href="#concept-workerglobalscope-cross-origin-isolated-capability" id="script-settings-for-workers:concept-workerglobalscope-cross-origin-isolated-capability-2" {
								- "cross-origin isolated\n     capability"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Set "
					var {
						- "settings object"
					}
					- "'s "
					a href="#concept-environment-id" id="script-settings-for-workers:concept-environment-id" {
						- "id"
					}
					- " to a new\n   unique opaque string, "
					a href="#concept-environment-creation-url" id="script-settings-for-workers:concept-environment-creation-url" {
						- "creation URL"
					}
					- " to\n   "
					var {
						- "worker global scope"
					}
					- "'s "
					a id="script-settings-for-workers:url" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
						- "url"
					}
					- ", "
					a href="#concept-environment-top-level-creation-url" id="script-settings-for-workers:concept-environment-top-level-creation-url" {
						- "top-level creation URL"
					}
					- " to null,\n   "
					a href="#concept-environment-target-browsing-context" id="script-settings-for-workers:concept-environment-target-browsing-context" {
						- "target browsing context"
					}
					- " to\n   null, and "
					a href="#concept-environment-active-service-worker" id="script-settings-for-workers:concept-environment-active-service-worker" {
						- "active service worker"
					}
					- "\n   to null."
