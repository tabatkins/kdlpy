						- "\n     "
					}
					li {
						p {
							- "Let "
							var {
								- "candidatePosition"
							}
							- " be\n     "
							var {
								- "popoverPositions"
							}
							- "["
							var {
								- "candidateAncestor"
							}
							- "]."
						}
					}
					li {
						p {
							- "If "
							var {
								- "topmostPopoverAncestor"
							}
							- " is null or\n     "
							var {
								- "popoverPositions"
							}
							- "["
							var {
								- "topmostPopoverAncestor"
							}
							- "] is less than\n     "
							var {
								- "candidatePosition"
							}
							- ", then set "
							var {
								- "topmostPopoverAncestor"
							}
							- " to\n     "
