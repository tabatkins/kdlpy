				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- " element can be sized arbitrarily by a style sheet, its\n  bitmap is then subject to the "
			a id="the-canvas-element:'object-fit'" href="https://drafts.csswg.org/css-images/#the-object-fit" data-x-internal="'object-fit'" {
