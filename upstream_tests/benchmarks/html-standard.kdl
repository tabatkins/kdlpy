							- "If "
							var {
								- "policy"
							}
							- "'s "
							a href="https://w3c.github.io/webappsec-csp/#policy-directive-set" id="sandboxing:csp-directive-set" data-x-internal="csp-directive-set" {
								- "directive set"
							}
							- " "
							a href="https://infra.spec.whatwg.org/#list-contain" id="sandboxing:list-contains" data-x-internal="list-contains" {
								- "contains"
							}
							- " a "
							a href="https://w3c.github.io/webappsec-csp/#directives" id="sandboxing:content-security-policy-directive" data-x-internal="content-security-policy-directive" {
