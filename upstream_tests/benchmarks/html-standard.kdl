						- "="
					}
					c- s="" {
						- "\"https://en.wikipedia.org/wiki/Rhaetian_Railway_Gem_4/4\""
					}
					c- p="" {
						- ">"
					}
					- "Gem 4/4"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "a"
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "</"
					}
					c- f="" {
						- "body"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "html"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h5 id="link-type-terms-of-service" {
			span class="secno" {
				- "4.6.7.25"
			}
			- " Link Type \""
			dfn data-dfn-for="link/rel,a/rel,area/rel" data-dfn-type="attr-value" {
				code {
					- "terms-of-service"
				}
			}
			- "\""
			a href="#link-type-terms-of-service" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-terms-of-service:link-type-terms-of-service" {
				a href="#link-type-terms-of-service" {
					- "terms-of-service"
				}
			}
			- " keyword may be used with\n  "
			code id="link-type-terms-of-service:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ", "
			code id="link-type-terms-of-service:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- ", and "
			code id="link-type-terms-of-service:the-area-element" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements. This keyword creates a\n  "
			a href="#hyperlink" id="link-type-terms-of-service:hyperlink" {
				- "hyperlink"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-terms-of-service:link-type-terms-of-service-2" {
				a href="#link-type-terms-of-service" {
					- "terms-of-service"
				}
			}
			- " keyword indicates that the\n  referenced document contains information about the agreements between the current document's\n  provider and users who wish to use the current document, as described in more detail in\n  "
			cite {
				- "Additional Link Relation Types"
			}
			- ". "
			a href="#refsRFC6903" {
				- "[RFC6903]"
			}
		}
		- "\n\n\n  "
		h5 id="sequential-link-types" {
			span class="secno" {
				- "4.6.7.26"
			}
			- " Sequential link types"
			a href="#sequential-link-types" class="self-link"
		}
		- "\n\n  "
		p {
			- "Some documents form part of a sequence of documents."
		}
		- "\n\n  "
		p {
			- "A sequence of documents is one where each document can have a "
			em {
				- "previous sibling"
			}
			- " and a\n  "
			em {
				- "next sibling"
			}
			- ". A document with no previous sibling is the start of its sequence, a\n  document with no next sibling is the end of its sequence."
		}
		- "\n\n  "
		p {
			- "A document may be part of multiple sequences."
		}
		- "\n\n\n  "
		h6 id="link-type-next" {
			span class="secno" {
				- "4.6.7.26.1"
			}
			- " Link type \""
			dfn data-dfn-for="link/rel,a/rel,area/rel,form/rel" data-dfn-type="attr-value" {
				code {
					- "next"
				}
			}
			- "\""
			a href="#link-type-next" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-next:link-type-next" {
				a href="#link-type-next" {
					- "next"
				}
			}
			- " keyword may be used with "
			code id="link-type-next:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ",\n  "
			code id="link-type-next:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- ", "
			code id="link-type-next:the-area-element" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- ", and "
			code id="link-type-next:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " elements. This keyword creates a\n  "
			a href="#hyperlink" id="link-type-next:hyperlink" {
				- "hyperlink"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-next:link-type-next-2" {
				a href="#link-type-next" {
					- "next"
				}
			}
			- " keyword indicates that the document is part of a\n  sequence, and that the link is leading to the document that is the next logical document in the\n  sequence."
		}
		- "\n\n  "
		p {
			- "When the "
			code id="link-type-next:link-type-next-3" {
				a href="#link-type-next" {
					- "next"
				}
			}
			- " keyword is used with a "
			code id="link-type-next:the-link-element-2" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- "\n  element, user agents should process such links as if they were using one of the "
			code id="link-type-next:link-type-dns-prefetch" {
				a href="#link-type-dns-prefetch" {
					- "dns-prefetch"
				}
			}
			- ", "
			code id="link-type-next:link-type-preconnect" {
				a href="#link-type-preconnect" {
					- "preconnect"
				}
			}
			- ", or\n  "
			code id="link-type-next:link-type-prefetch" {
				a href="#link-type-prefetch" {
					- "prefetch"
				}
			}
			- " keywords. Which keyword the user agent wishes to use\n  is implementation-dependent; for example, a user agent may wish to use the less-costly "
			code id="link-type-next:link-type-preconnect-2" {
				a href="#link-type-preconnect" {
					- "preconnect"
				}
			}
			- " processing model when trying to conserve data, battery\n  power, or processing power, or may wish to pick a keyword depending on heuristic analysis of past\n  user behavior in similar scenarios."
		}
		- "\n\n  "
		h6 id="link-type-prev" {
			span class="secno" {
				- "4.6.7.26.2"
			}
			- " Link type \""
			dfn data-dfn-for="link/rel,a/rel,area/rel,form/rel" data-dfn-type="attr-value" {
				code {
					- "prev"
				}
			}
			- "\""
			a href="#link-type-prev" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-prev:link-type-prev" {
				a href="#link-type-prev" {
					- "prev"
				}
			}
			- " keyword may be used with "
			code id="link-type-prev:the-link-element" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ",\n  "
			code id="link-type-prev:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- ", "
			code id="link-type-prev:the-area-element" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- ", and "
			code id="link-type-prev:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " elements. This keyword creates a\n  "
			a href="#hyperlink" id="link-type-prev:hyperlink" {
				- "hyperlink"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="link-type-prev:link-type-prev-2" {
				a href="#link-type-prev" {
					- "prev"
				}
			}
			- " keyword indicates that the document is part of a\n  sequence, and that the link is leading to the document that is the previous logical document in\n  the sequence."
		}
		- "\n\n  \n\n  "
		p {
			strong {
				- "Synonyms"
			}
			- ": For historical reasons, user agents must also treat the keyword\n  \""
			code {
				- "previous"
			}
			- "\" like the "
			code id="link-type-prev:link-type-prev-3" {
				a href="#link-type-prev" {
					- "prev"
				}
			}
			- " keyword."
		}
		- "\n\n  \n\n\n  "
		h5 id="other-link-types" {
			span class="secno" {
				- "4.6.7.27"
			}
			- " Other link types"
			a href="#other-link-types" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="concept-rel-extensions" {
				- "Extensions to the predefined set of link types"
			}
			- " may\n  be registered on the "
			a href="https://microformats.org/wiki/existing-rel-values#HTML5_link_type_extensions" {
				- "microformats\n  page for existing rel values"
			}
			- ". "
			a href="#refsMFREL" {
				- "[MFREL]"
			}
		}
		- "\n\n  "
		p {
			- "Anyone is free to edit the "
			span {
				- "microformats page for existing rel values"
			}
			- " at\n  any time to add a type. Extension types must be specified with the following information:"
		}
		- "\n\n  "
		dl {
			dt {
				- "Keyword"
			}
			dd {
				- "\n    "
				p {
					- "The actual value being defined. The value should not be confusingly similar to any other\n    defined value (e.g. differing only in case)."
				}
				- "\n\n    "
				p {
					- "If the value contains a U+003A COLON character (:), it must also be an "
					a id="other-link-types:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
						- "absolute\n    URL"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "Effect on... "
				code id="other-link-types:the-link-element" {
					a href="#the-link-element" {
						- "link"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						- "Not allowed"
					}
					dd {
						- "The keyword must not be specified on "
						code id="other-link-types:the-link-element-2" {
							a href="#the-link-element" {
								- "link"
							}
						}
						- " elements."
					}
					dt {
						- "Hyperlink"
					}
					dd {
						- "The keyword may be specified on a "
						code id="other-link-types:the-link-element-3" {
							a href="#the-link-element" {
								- "link"
							}
						}
						- " element; it creates a\n     "
						a href="#hyperlink" id="other-link-types:hyperlink" {
							- "hyperlink"
						}
						- "."
					}
					dt {
						- "External Resource"
					}
					dd {
						- "The keyword may be specified on a "
						code id="other-link-types:the-link-element-4" {
							a href="#the-link-element" {
								- "link"
							}
						}
						- " element; it creates an "
						a href="#external-resource-link" id="other-link-types:external-resource-link" {
							- "external\n     resource link"
						}
						- "."
					}
				}
				- "\n   "
			}
			dt {
				- "Effect on... "
				code id="other-link-types:the-a-element" {
					a href="#the-a-element" {
						- "a"
					}
				}
				- " and "
				code id="other-link-types:the-area-element" {
					a href="#the-area-element" {
						- "area"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						- "Not allowed"
					}
					dd {
						- "The keyword must not be specified on "
						code id="other-link-types:the-a-element-2" {
							a href="#the-a-element" {
								- "a"
							}
						}
						- " and "
						code id="other-link-types:the-area-element-2" {
							a href="#the-area-element" {
								- "area"
							}
						}
						- " elements."
					}
					dt {
						- "Hyperlink"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-a-element-3" {
							a href="#the-a-element" {
								- "a"
							}
						}
						- " and "
						code id="other-link-types:the-area-element-3" {
							a href="#the-area-element" {
								- "area"
							}
						}
						- " elements; it creates a\n     "
						a href="#hyperlink" id="other-link-types:hyperlink-2" {
							- "hyperlink"
						}
						- "."
					}
					dt {
						- "External Resource"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-a-element-4" {
							a href="#the-a-element" {
								- "a"
							}
						}
						- " and "
						code id="other-link-types:the-area-element-4" {
							a href="#the-area-element" {
								- "area"
							}
						}
						- " elements; it creates\n     an "
						a href="#external-resource-link" id="other-link-types:external-resource-link-2" {
							- "external resource link"
						}
						- "."
					}
					dt {
						- "Hyperlink Annotation"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-a-element-5" {
							a href="#the-a-element" {
								- "a"
							}
						}
						- " and "
						code id="other-link-types:the-area-element-5" {
							a href="#the-area-element" {
								- "area"
							}
						}
						- " elements; it "
						a href="#hyperlink-annotation" id="other-link-types:hyperlink-annotation" {
							- "annotates"
						}
						- " other "
						a href="#hyperlink" id="other-link-types:hyperlink-3" {
							- "hyperlinks"
						}
						- "\n     created by the element."
					}
				}
				- "\n   "
			}
			dt {
				- "Effect on... "
				code id="other-link-types:the-form-element" {
					a href="#the-form-element" {
						- "form"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						- "Not allowed"
					}
					dd {
						- "The keyword must not be specified on "
						code id="other-link-types:the-form-element-2" {
							a href="#the-form-element" {
								- "form"
							}
						}
						- " elements."
					}
					dt {
						- "Hyperlink"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-form-element-3" {
							a href="#the-form-element" {
								- "form"
							}
						}
						- " elements; it creates a\n     "
						a href="#hyperlink" id="other-link-types:hyperlink-4" {
							- "hyperlink"
						}
						- "."
					}
					dt {
						- "External Resource"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-form-element-4" {
							a href="#the-form-element" {
								- "form"
							}
						}
						- " elements; it creates an "
						a href="#external-resource-link" id="other-link-types:external-resource-link-3" {
							- "external\n     resource link"
						}
						- "."
					}
					dt {
						- "Hyperlink Annotation"
					}
					dd {
						- "The keyword may be specified on "
						code id="other-link-types:the-form-element-5" {
							a href="#the-form-element" {
								- "form"
							}
						}
						- " elements; it "
						a href="#hyperlink-annotation" id="other-link-types:hyperlink-annotation-2" {
							- "annotates"
						}
						- " other "
						a href="#hyperlink" id="other-link-types:hyperlink-5" {
							- "hyperlinks"
						}
						- " created by the\n     element."
					}
				}
				- "\n   "
			}
			dt {
				- "Brief description"
			}
			dd {
				p {
					- "A short non-normative description of what the keyword's meaning is."
				}
			}
			dt {
				- "Specification"
			}
			dd {
				p {
					- "A link to a more detailed description of the keyword's semantics and requirements. It\n   could be another page on the wiki, or a link to an external page."
				}
			}
			dt {
				- "Synonyms"
			}
			dd {
				p {
					- "A list of other keyword values that have exactly the same processing requirements. Authors\n   should not use the values defined to be synonyms, they are only intended to allow user agents to\n   support legacy content. Anyone may remove synonyms that are not used in practice; only names that\n   need to be processed as synonyms for compatibility with legacy content are to be registered in\n   this way."
				}
			}
			dt {
				- "Status"
			}
			dd {
				- "\n    "
				p {
					- "One of the following:"
				}
				- "\n\n    "
				dl {
					dt {
						- "Proposed"
					}
					dd {
						- "The keyword has not received wide peer review and approval. Someone has proposed it and is,\n     or soon will be, using it."
					}
					dt {
						- "Ratified"
					}
					dd {
						- "The keyword has received wide peer review and approval. It has a specification that\n     unambiguously defines how to handle pages that use the keyword, including when they use it in\n     incorrect ways."
					}
					dt {
						- "Discontinued"
					}
					dd {
						- "The keyword has received wide peer review and it has been found wanting. Existing pages are\n     using this keyword, but new pages should avoid it. The \"brief description\" and \"specification\"\n     entries will give details of what authors should use instead, if anything."
					}
				}
				- "\n\n    "
				p {
					- "If a keyword is found to be redundant with existing values, it should be removed and listed\n    as a synonym for the existing value."
				}
				- "\n\n    "
				p {
					- "If a keyword is registered in the \"proposed\" state for a period of a month or more without\n    being used or specified, then it may be removed from the registry."
				}
				- "\n\n    "
				p {
					- "If a keyword is added with the \"proposed\" status and found to be redundant with existing\n    values, it should be removed and listed as a synonym for the existing value. If a keyword is\n    added with the \"proposed\" status and found to be harmful, then it should be changed to\n    \"discontinued\" status."
				}
				- "\n\n    "
				p {
					- "Anyone can change the status at any time, but should only do so in accordance with the\n    definitions above."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "Conformance checkers must use the information given on the "
			span {
				- "microformats page\n  for existing rel values"
			}
			- " to establish if a value is allowed or not: values defined in this\n  specification or marked as \"proposed\" or \"ratified\" must be accepted when used on the elements for\n  which they apply as described in the \"Effect on...\" field, whereas values marked as \"discontinued\"\n  or not listed in either this specification or on the aforementioned page must be rejected as\n  invalid. Conformance checkers may cache this information (e.g. for performance reasons or to avoid\n  the use of unreliable network connectivity)."
		}
		- "\n\n  "
		p {
			- "When an author uses a new type not defined by either this specification or the wiki page,\n  conformance checkers should offer to add the value to the wiki, with the details described above,\n  with the \"proposed\" status."
		}
		- "\n\n  \n\n  "
		p {
			- "Types defined as extensions in the "
			a href="https://microformats.org/wiki/existing-rel-values#HTML5_link_type_extensions" {
				- "microformats\n  page for existing rel values"
			}
			- " with the status \"proposed\" or \"ratified\" may be used with the\n  "
			code {
				- "rel"
			}
			- " attribute on "
			code id="other-link-types:the-link-element-5" {
				a href="#the-link-element" {
					- "link"
				}
			}
			- ", "
			code id="other-link-types:the-a-element-6" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- ", and "
			code id="other-link-types:the-area-element-6" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- "\n  elements in accordance to the \"Effect on...\" field. "
			a href="#refsMFREL" {
				- "[MFREL]"
			}
		}
		- "\n\n\n\n  "
		h3 id="edits" {
			span class="secno" {
				- "4.7"
			}
			- " Edits"
			a href="#edits" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
