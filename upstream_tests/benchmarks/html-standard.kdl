					- " element, then switch the\n   "
					a href="#insertion-mode" id="the-insertion-mode:insertion-mode-15" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-inbody" id="the-insertion-mode:parsing-main-inbody-3" {
