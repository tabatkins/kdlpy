					}
					- ", then return the parent's\n   "
					a href="https://dom.spec.whatwg.org/#concept-documentfragment-host" id="data-model:concept-documentfragment-host" data-x-internal="concept-documentfragment-host" {
						- "host"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s parent is the "
					a id="data-model:document-element" href="https://dom.spec.whatwg.org/#document-element" data-x-internal="document-element" {
						- "document element"
					}
					- ", then return the\n   parent's "
					a id="data-model:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is in the "
					a href="#popover-showing-state" id="data-model:popover-showing-state-2" {
						- "popover showing\n   state"
					}
					- " and has a "
					a href="#popover-invoker" id="data-model:popover-invoker-2" {
						- "popover invoker"
					}
					- " set, then return "
					var {
						- "element"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "element"
					}
					- "'s parent's "
					a href="#associated-focus-navigation-owner" id="data-model:associated-focus-navigation-owner" {
						- "associated focus navigation owner"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "Then, the contents of a given "
			a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-3" {
				- "focus navigation scope owner"
			}
			- " "
			var {
				- "owner"
			}
			- "'s\n  "
			a href="#focus-navigation-scope" id="data-model:focus-navigation-scope" {
				- "focus navigation scope"
			}
			- " are all elements whose "
			a href="#associated-focus-navigation-owner" id="data-model:associated-focus-navigation-owner-2" {
				- "associated focus navigation\n  owner"
			}
			- " is "
			var {
				- "owner"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "The order of elements within a "
			a href="#focus-navigation-scope" id="data-model:focus-navigation-scope-2" {
				- "focus navigation scope"
			}
			- " does not impact\n  any of the algorithms in this specification. Ordering only becomes important for the\n  "
			a href="#tabindex-ordered-focus-navigation-scope" id="data-model:tabindex-ordered-focus-navigation-scope" {
				- "tabindex-ordered focus navigation scope"
			}
			- " and "
			a href="#flattened-tabindex-ordered-focus-navigation-scope" id="data-model:flattened-tabindex-ordered-focus-navigation-scope" {
				- "flattened tabindex-ordered focus\n  navigation scope"
			}
			- " concepts defined below."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="tabindex-ordered-focus-navigation-scope" {
				- "tabindex-ordered focus navigation scope"
			}
			- " is a list of "
			a href="#focusable-area" id="data-model:focusable-area-25" {
				- "focusable areas"
			}
			- " and "
			a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-4" {
				- "focus navigation\n  scope owners"
			}
			- ". Every "
			a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-5" {
				- "focus navigation scope owner"
			}
			- " "
			var {
				- "owner"
			}
			- " has\n  "
			a href="#tabindex-ordered-focus-navigation-scope" id="data-model:tabindex-ordered-focus-navigation-scope-2" {
				- "tabindex-ordered focus navigation scope"
			}
			- ", whose contents are determined as\n  follows:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "It contains all elements in "
					var {
						- "owner"
					}
					- "'s "
					a href="#focus-navigation-scope" id="data-model:focus-navigation-scope-3" {
						- "focus navigation scope"
					}
					- " that\n   are themselves "
					a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-6" {
						- "focus navigation scope owners"
					}
					- ",\n   except the elements whose "
					a href="#tabindex-value" id="data-model:tabindex-value-4" {
						- "tabindex value"
					}
					- " is a negative integer."
				}
			}
			li {
				p {
					- "It contains all of the "
					a href="#focusable-area" id="data-model:focusable-area-26" {
						- "focusable areas"
					}
					- " whose\n   "
					a href="#dom-anchor" id="data-model:dom-anchor-12" {
						- "DOM anchor"
					}
					- " is an element in "
					var {
						- "owner"
					}
					- "'s "
					a href="#focus-navigation-scope" id="data-model:focus-navigation-scope-4" {
						- "focus navigation scope"
					}
					- ",\n   except the "
					a href="#focusable-area" id="data-model:focusable-area-27" {
						- "focusable areas"
					}
					- " whose "
					a href="#tabindex-value" id="data-model:tabindex-value-5" {
						- "tabindex value"
					}
					- "\n   is a negative integer."
				}
			}
		}
		- "\n\n  "
		p {
			- "The order within a "
			a href="#tabindex-ordered-focus-navigation-scope" id="data-model:tabindex-ordered-focus-navigation-scope-3" {
				- "tabindex-ordered focus navigation scope"
			}
			- " is determined by each\n  element's "
			a href="#tabindex-value" id="data-model:tabindex-value-6" {
				- "tabindex value"
			}
			- ", as described in the section below."
		}
		- "\n\n  "
		p class="note" {
			- "The rules there do not give a precise ordering, as they are composed mostly of\n  \"should\" statements and relative orderings."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="flattened-tabindex-ordered-focus-navigation-scope" {
				- "flattened tabindex-ordered focus navigation scope"
			}
			- " is a list of "
			a href="#focusable-area" id="data-model:focusable-area-28" {
				- "focusable areas"
			}
			- ". Every "
			a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-7" {
				- "focus navigation scope owner"
			}
			- "\n  "
			var {
				- "owner"
			}
			- " owns a distinct "
			a href="#flattened-tabindex-ordered-focus-navigation-scope" id="data-model:flattened-tabindex-ordered-focus-navigation-scope-2" {
				- "flattened tabindex-ordered focus navigation scope"
			}
			- ",\n  whose contents are determined by the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "result"
					}
					- " be a "
					a href="https://infra.spec.whatwg.org/#list-clone" id="data-model:list-clone" data-x-internal="list-clone" {
						- "clone"
					}
					- " of "
					var {
						- "owner"
					}
					- "'s\n   "
					a href="#tabindex-ordered-focus-navigation-scope" id="data-model:tabindex-ordered-focus-navigation-scope-4" {
						- "tabindex-ordered focus navigation scope"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "For each "
					var {
						- "item"
					}
					- " of "
					var {
						- "result"
					}
					- ":"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "item"
							}
							- " is not a "
							a href="#focus-navigation-scope-owner" id="data-model:focus-navigation-scope-owner-8" {
								- "focus navigation scope owner"
							}
							- ", then\n     "
							a id="data-model:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
								- "continue"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "item"
							}
							- " is not a "
							a href="#focusable-area" id="data-model:focusable-area-29" {
								- "focusable area"
							}
							- ", then replace "
							var {
								- "item"
							}
							- "\n     with all of the items in "
							var {
								- "item"
							}
							- "'s "
							a href="#flattened-tabindex-ordered-focus-navigation-scope" id="data-model:flattened-tabindex-ordered-focus-navigation-scope-3" {
								- "flattened tabindex-ordered focus navigation\n     scope"
							}
							- "."
						}
					}
					li {
						p {
							- "Otherwise, insert the contents of "
							var {
								- "item"
							}
							- "'s "
							a href="#flattened-tabindex-ordered-focus-navigation-scope" id="data-model:flattened-tabindex-ordered-focus-navigation-scope-4" {
								- "flattened tabindex-ordered\n     focus navigation scope"
							}
							- " after "
							var {
								- "item"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		h4 id="the-tabindex-attribute" {
			span class="secno" {
				- "6.6.3"
			}
			- " The "
			code id="the-tabindex-attribute:attr-tabindex" {
				a href="#attr-tabindex" {
					- "tabindex"
				}
			}
			- " attribute"
			a href="#the-tabindex-attribute" class="self-link"
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/tabindex" title="The tabindex global attribute allows developers to make HTML elements focusable, allow or prevent them from being sequentially focusable (usually with the Tab key, hence the name) and determine their relative ordering for sequential focus navigation." {
						- "Global_attributes/tabindex"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1.5+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="htmlsvg-global" id="attr-tabindex" data-dfn-type="element-attr" {
				code {
					- "tabindex"
				}
			}
			- "\n  content attribute allows authors to make an element and regions that have the element as its\n  "
			a href="#dom-anchor" id="the-tabindex-attribute:dom-anchor" {
				- "DOM anchor"
			}
			- " be "
			a href="#focusable-area" id="the-tabindex-attribute:focusable-area" {
				- "focusable areas"
			}
			- ", allow or prevent\n  them from being "
			a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable" {
				- "sequentially focusable"
			}
			- ", and determine their relative ordering for\n  "
			a href="#sequential-focus-navigation" id="the-tabindex-attribute:sequential-focus-navigation" {
				- "sequential focus navigation"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The name \"tab index\" comes from the common use of the "
			kbd {
				- "Tab"
			}
			- " key to navigate through\n  the focusable elements. The term \"tabbing\" refers to moving forward through "
			a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-2" {
				- "sequentially\n  focusable"
			}
			- " "
			a href="#focusable-area" id="the-tabindex-attribute:focusable-area-2" {
				- "focusable areas"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-tabindex-attribute:attr-tabindex-2" {
				a href="#attr-tabindex" {
					- "tabindex"
				}
			}
			- " attribute, if specified, must have a value\n  that is a "
			a href="#valid-integer" id="the-tabindex-attribute:valid-integer" {
				- "valid integer"
			}
			- ". Positive numbers specify the relative position of the\n  element's "
			a href="#focusable-area" id="the-tabindex-attribute:focusable-area-3" {
				- "focusable areas"
			}
			- " in the "
			a href="#sequential-focus-navigation-order" id="the-tabindex-attribute:sequential-focus-navigation-order" {
				- "sequential focus\n  navigation order"
			}
			- ", and negative numbers indicate that the control is not\n  "
			a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-3" {
				- "sequentially focusable"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Developers should use caution when using values other than 0 or −1 for their "
			code id="the-tabindex-attribute:attr-tabindex-3" {
				a href="#attr-tabindex" {
					- "tabindex"
				}
			}
			- " attributes as this is complicated to do correctly."
		}
		- "\n\n  "
		div class="note" {
			- "\n   "
			p {
				- "The following provides a non-normative summary of the behaviors of the\n   possible "
				code id="the-tabindex-attribute:attr-tabindex-4" {
					a href="#attr-tabindex" {
						- "tabindex"
					}
				}
				- " attribute values. The below\n   processing model gives the more precise rules."
			}
			- "\n\n   "
			dl {
				dt {
					- "omitted (or non-integer values)"
				}
				dd {
					- "The user agent will decide whether the element is "
					a href="#focusable" id="the-tabindex-attribute:focusable" {
						- "focusable"
					}
					- ", and if it is,\n    whether it is "
					a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-4" {
						- "sequentially focusable"
					}
					- " or "
					a href="#click-focusable" id="the-tabindex-attribute:click-focusable" {
						- "click focusable"
					}
					- " (or both)."
				}
				dt {
					- "−1 (or other negative integer values)"
				}
				dd {
					- "Causes the element to be "
					a href="#focusable" id="the-tabindex-attribute:focusable-2" {
						- "focusable"
					}
					- ", and indicates that the author would prefer\n    the element to be "
					a href="#click-focusable" id="the-tabindex-attribute:click-focusable-2" {
						- "click focusable"
					}
					- " but not "
					a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-5" {
						- "sequentially focusable"
					}
					- ". The\n    user agent might ignore this preference for click and sequential focusability, e.g., for\n    specific element types according to platform conventions, or for keyboard-only users."
				}
				dt {
					- "0"
				}
				dd {
					- "Causes the element to be "
					a href="#focusable" id="the-tabindex-attribute:focusable-3" {
						- "focusable"
					}
					- ", and indicates that the author would prefer\n    the element to be both "
					a href="#click-focusable" id="the-tabindex-attribute:click-focusable-3" {
						- "click focusable"
					}
					- " and "
					a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-6" {
						- "sequentially focusable"
					}
					- ". The\n    user agent might ignore this preference for click and sequential focusability."
				}
				dt {
					- "positive integer values"
				}
				dd {
					- "Behaves the same as 0, but in addition creates a relative ordering within a\n    "
					a href="#tabindex-ordered-focus-navigation-scope" id="the-tabindex-attribute:tabindex-ordered-focus-navigation-scope" {
						- "tabindex-ordered focus navigation scope"
					}
					- ", so that elements with higher "
					code id="the-tabindex-attribute:attr-tabindex-5" {
						a href="#attr-tabindex" {
							- "tabindex"
						}
					}
					- " attribute value come later."
				}
			}
			- "\n\n   "
			p {
				- "Note that the "
				code id="the-tabindex-attribute:attr-tabindex-6" {
					a href="#attr-tabindex" {
						- "tabindex"
					}
				}
				- " attribute cannot be used to make\n   an element non-focusable. The only way a page author can do that is by "
				a href="#concept-element-disabled" id="the-tabindex-attribute:concept-element-disabled" {
					- "disabling"
				}
				- " the element, or making it\n   "
				a href="#inert" id="the-tabindex-attribute:inert" {
					- "inert"
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			dfn id="tabindex-value" {
				- "tabindex value"
			}
			- " of an element is the value of its "
			code id="the-tabindex-attribute:attr-tabindex-7" {
				a href="#attr-tabindex" {
					- "tabindex"
				}
			}
			- " attribute, parsed using the "
			a href="#rules-for-parsing-integers" id="the-tabindex-attribute:rules-for-parsing-integers" {
				- "rules for parsing\n  integers"
			}
			- ". If parsing fails or the attribute is not specified, then the "
			a href="#tabindex-value" id="the-tabindex-attribute:tabindex-value" {
				- "tabindex\n  value"
			}
			- " is null."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#tabindex-value" id="the-tabindex-attribute:tabindex-value-2" {
				- "tabindex value"
			}
			- " of a "
			a href="#focusable-area" id="the-tabindex-attribute:focusable-area-4" {
				- "focusable area"
			}
			- " is the "
			a href="#tabindex-value" id="the-tabindex-attribute:tabindex-value-3" {
				- "tabindex\n  value"
			}
			- " of its "
			a href="#dom-anchor" id="the-tabindex-attribute:dom-anchor-2" {
				- "DOM anchor"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#tabindex-value" id="the-tabindex-attribute:tabindex-value-4" {
				- "tabindex value"
			}
			- " of an element must be interpreted as follows:"
		}
		- "\n\n  "
		dl {
			dt {
				- "If the value is null"
			}
			dd {
				- "\n    "
				p {
					- "The user agent should follow platform conventions to determine if the element should be\n    considered as a "
					a href="#focusable-area" id="the-tabindex-attribute:focusable-area-5" {
						- "focusable area"
					}
					- " and if so, whether the element and any "
					a href="#focusable-area" id="the-tabindex-attribute:focusable-area-6" {
						- "focusable areas"
					}
					- " that have the element as their\n    "
					a href="#dom-anchor" id="the-tabindex-attribute:dom-anchor-3" {
						- "DOM anchor"
					}
					- " are "
					a href="#sequentially-focusable" id="the-tabindex-attribute:sequentially-focusable-7" {
						- "sequentially focusable"
					}
					- ", and if so, what their relative\n    position in their "
					a href="#tabindex-ordered-focus-navigation-scope" id="the-tabindex-attribute:tabindex-ordered-focus-navigation-scope-2" {
						- "tabindex-ordered focus navigation scope"
					}
					- " is to be. If the element\n    is a "
					a href="#focus-navigation-scope-owner" id="the-tabindex-attribute:focus-navigation-scope-owner" {
						- "focus navigation scope owner"
					}
					- ", it must be included in its\n    "
					a href="#tabindex-ordered-focus-navigation-scope" id="the-tabindex-attribute:tabindex-ordered-focus-navigation-scope-3" {
						- "tabindex-ordered focus navigation scope"
					}
					- " even if it is not a "
