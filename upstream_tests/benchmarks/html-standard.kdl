									}
									- "."
								}
							}
							li {
								p {
									a href="https://dom.spec.whatwg.org/#concept-node-append" id="the-innertext-idl-attribute:concept-node-append-3" data-x-internal="concept-node-append" {
										- "Append"
									}
									- " the result of "
									a href="https://dom.spec.whatwg.org/#concept-create-element" id="the-innertext-idl-attribute:create-an-element" data-x-internal="create-an-element" {
										- "creating an element"
									}
									- " given "
									var {
										- "document"
									}
									- ", \""
									code {
										- "br"
									}
									- "\",\n       and the "
									a id="the-innertext-idl-attribute:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
										- "HTML namespace"
									}
									- " to "
									var {
										- "fragment"
									}
									- "."
								}
							}
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Return "
					var {
						- "fragment"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="merge-with-the-next-text-node" {
				- "merge with the next text node"
			}
			- " given a "
			code id="the-innertext-idl-attribute:text-6" {
				a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
					- "Text"
				}
			}
			- " node "
			var {
				- "node"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "next"
					}
					- " be "
					var {
						- "node"
					}
					- "'s "
					a id="the-innertext-idl-attribute:next-sibling-2" href="https://dom.spec.whatwg.org/#concept-tree-next-sibling" data-x-internal="next-sibling" {
						- "next sibling"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "next"
					}
					- " is not a "
					code id="the-innertext-idl-attribute:text-7" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node, then return."
				}
			}
			li {
				p {
					a id="the-innertext-idl-attribute:replace-data" href="https://dom.spec.whatwg.org/#concept-cd-replace" data-x-internal="replace-data" {
						- "Replace data"
					}
					- " with "
					var {
						- "node"
					}
					- ", "
					var {
						- "node"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-cd-data" id="the-innertext-idl-attribute:concept-cd-data-3" data-x-internal="concept-cd-data" {
						- "data"
					}
					- "'s "
					a id="the-innertext-idl-attribute:length" href="https://infra.spec.whatwg.org/#string-length" data-x-internal="length" {
						- "length"
					}
					- ", 0, and "
					var {
						- "next"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-cd-data" id="the-innertext-idl-attribute:concept-cd-data-4" data-x-internal="concept-cd-data" {
						- "data"
					}
					- "."
				}
			}
			li {
				p {
					a href="https://dom.spec.whatwg.org/#concept-node-remove" id="the-innertext-idl-attribute:concept-node-remove" data-x-internal="concept-node-remove" {
						- "Remove"
					}
					- " "
					var {
						- "next"
					}
					- "."
				}
			}
		}
		- "\n\n  \n\n  "
		h4 id="requirements-relating-to-the-bidirectional-algorithm" {
			span class="secno" {
				- "3.2.8"
			}
			- " Requirements relating to the bidirectional algorithm"
			a href="#requirements-relating-to-the-bidirectional-algorithm" class="self-link"
		}
		- "\n\n  \n  "
		h5 id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters" {
			span class="secno" {
				- "3.2.8.1"
			}
			- " Authoring conformance criteria for bidirectional-algorithm formatting characters"
			a href="#authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters" class="self-link"
		}
		- "\n  \n\n  "
		p {
			a href="#text-content" id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:text-content" {
				- "Text content"
			}
			- " in "
			a href="#html-elements" id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:html-elements" {
				- "HTML elements"
			}
			- " with "
			code id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:text" {
				a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
					- "Text"
				}
			}
			- " nodes in their\n  "
			a href="#concept-html-contents" id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:concept-html-contents" {
				- "contents"
			}
			- ", and text in attributes of "
			a href="#html-elements" id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:html-elements-2" {
				- "HTML\n  elements"
			}
			- " that allow free-form text, may contain characters in the ranges U+202A to U+202E\n  and U+2066 to U+2069 (the bidirectional-algorithm formatting characters). "
			a href="#refsBIDI" {
				- "[BIDI]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "Authors are encouraged to use the "
			code id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:attr-dir" {
				a href="#attr-dir" {
					- "dir"
				}
			}
			- " attribute, the\n  "
			code id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:the-bdo-element" {
				a href="#the-bdo-element" {
					- "bdo"
				}
			}
			- " element, and the "
			code id="authoring-conformance-criteria-for-bidirectional-algorithm-formatting-characters:the-bdi-element" {
				a href="#the-bdi-element" {
					- "bdi"
				}
			}
			- " element, rather than maintaining the\n  bidirectional-algorithm formatting characters manually. The bidirectional-algorithm formatting\n  characters interact poorly with CSS."
		}
		- "\n\n\n  \n\n  "
		h5 id="user-agent-conformance-criteria" {
			span class="secno" {
				- "3.2.8.2"
			}
			- " User agent conformance criteria"
			a href="#user-agent-conformance-criteria" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agents must implement the Unicode bidirectional algorithm to determine the proper ordering\n  of characters when rendering documents and parts of documents. "
			a href="#refsBIDI" {
				- "[BIDI]"
			}
		}
		- "\n\n  "
		p {
			- "The mapping of HTML to the Unicode bidirectional algorithm must be done in one of three ways.\n  Either the user agent must implement CSS, including in particular the CSS\n  "
			a id="user-agent-conformance-criteria:'unicode-bidi'" href="https://drafts.csswg.org/css-writing-modes/#unicode-bidi" data-x-internal="'unicode-bidi'" {
				- "'unicode-bidi'"
			}
			- ", "
			a id="user-agent-conformance-criteria:'direction'" href="https://drafts.csswg.org/css-writing-modes/#direction" data-x-internal="'direction'" {
				- "'direction'"
			}
			- ", and "
			a id="user-agent-conformance-criteria:'content'" href="https://drafts.csswg.org/css2/#content%E2%91%A0" data-x-internal="'content'" {
				- "'content'"
			}
			- " properties, and\n  must have, in its user agent style sheet, the rules using those properties given in this\n  specification's "
			a href="#rendering" {
				- "rendering"
			}
			- " section, or, alternatively, the user agent must\n  act as if it implemented just the aforementioned properties and had a user agent style sheet that\n  included all the aforementioned rules, but without letting style sheets specified in documents\n  override them, or, alternatively, the user agent must implement another styling language with\n  equivalent semantics. "
			a href="#refsCSSGC" {
				- "[CSSGC]"
			}
		}
		- "\n\n  "
		p id="bidireq" {
			- "The following elements and attributes have requirements defined by the "
			a href="#rendering" {
				- "rendering"
			}
			- " section that, due to the requirements in this section, are\n  requirements on all user agents (not just those that "
			a href="#renderingUA" {
				- "support the suggested\n  default rendering"
			}
			- "):"
		}
		- "\n\n  "
		ul class="brief" {
			li {
				code id="user-agent-conformance-criteria:attr-dir" {
					a href="#attr-dir" {
						- "dir"
					}
				}
				- " attribute"
			}
			li {
				code id="user-agent-conformance-criteria:the-bdi-element" {
					a href="#the-bdi-element" {
						- "bdi"
					}
				}
				- " element"
			}
			li {
				code id="user-agent-conformance-criteria:the-bdo-element" {
					a href="#the-bdo-element" {
						- "bdo"
					}
				}
				- " element"
			}
			li {
				code id="user-agent-conformance-criteria:the-br-element" {
					a href="#the-br-element" {
						- "br"
					}
				}
				- " element"
			}
			li {
				code id="user-agent-conformance-criteria:the-pre-element" {
					a href="#the-pre-element" {
						- "pre"
					}
				}
				- " element"
			}
			li {
				code id="user-agent-conformance-criteria:the-textarea-element" {
					a href="#the-textarea-element" {
						- "textarea"
					}
				}
				- " element"
			}
			li {
				code id="user-agent-conformance-criteria:the-wbr-element" {
					a href="#the-wbr-element" {
						- "wbr"
					}
				}
				- " element"
			}
		}
		- "\n\n  \n\n  \n\n  "
		h4 id="wai-aria" {
			span class="secno" {
				- "3.2.9"
			}
			- " Requirements related to ARIA and to platform accessibility APIs"
			a href="#wai-aria" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agent requirements for implementing Accessibility API semantics on "
			a href="#html-elements" id="wai-aria:html-elements" {
				- "HTML\n  elements"
			}
			- " are defined in "
			cite {
				- "HTML Accessibility API Mappings"
			}
			- ". In addition to the\n  rules there, for a "
			a href="#custom-element" id="wai-aria:custom-element" {
				- "custom element"
			}
			- " "
			var {
				- "element"
			}
			- ", the default ARIA role semantics\n  are determined as follows: "
			a href="#refsHTMLAAM" {
				- "[HTMLAAM]"
			}
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "map"
					}
					- " be "
					var {
						- "element"
					}
					- "'s "
					a href="#internal-content-attribute-map" id="wai-aria:internal-content-attribute-map" {
						- "internal content attribute\n   map"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "map"
					}
					- "[\""
					code {
						- "role"
					}
					- "\"] "
					a href="https://infra.spec.whatwg.org/#map-exists" id="wai-aria:map-exists" data-x-internal="map-exists" {
						- "exists"
					}
					- ",\n   then return it."
				}
			}
			li {
				p {
					- "Return no role."
				}
			}
		}
		- "\n\n  "
		p {
			- "Similarly, for a "
			a href="#custom-element" id="wai-aria:custom-element-2" {
				- "custom element"
			}
			- " "
			var {
				- "element"
			}
			- ", the default ARIA state and\n  property semantics, for a state or property named "
			var {
				- "stateOrProperty"
			}
			- ", are determined as\n  follows:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					a href="#attached-internals" id="wai-aria:attached-internals" {
						- "attached internals"
					}
					- " is non-null:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "element"
							}
							- "'s "
							a href="#attached-internals" id="wai-aria:attached-internals-2" {
								- "attached internals"
							}
							- "'s "
							a href="#attr-associated-element" id="wai-aria:attr-associated-element" {
								- "get the "
								var {
									- "stateOrProperty"
								}
								- "-associated element"
							}
							- " exists,\n     then return the result of running it."
						}
					}
					li {
						p {
							- "If "
							var {
								- "element"
							}
							- "'s "
							a href="#attached-internals" id="wai-aria:attached-internals-3" {
								- "attached internals"
							}
							- "'s "
							a href="#attr-associated-elements" id="wai-aria:attr-associated-elements" {
								- "get the "
								var {
									- "stateOrProperty"
								}
								- "-associated elements"
							}
							- " exists,\n     then return the result of running it."
						}
					}
				}
				- "\n    \n\n   "
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					a href="#internal-content-attribute-map" id="wai-aria:internal-content-attribute-map-2" {
						- "internal content attribute\n   map"
					}
					- "["
					var {
						- "stateOrProperty"
					}
					- "] "
					a href="https://infra.spec.whatwg.org/#map-exists" id="wai-aria:map-exists-2" data-x-internal="map-exists" {
						- "exists"
					}
					- ", then return\n   it."
				}
			}
			li {
				p {
					- "Return the default value for "
					var {
						- "stateOrProperty"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The \"default semantics\" referred to here are sometimes also called \"native\",\n  \"implicit\", or \"host language\" semantics in "
			cite {
				- "ARIA"
			}
			- ". "
			a href="#refsARIA" {
				- "[ARIA]"
			}
		}
		- "\n\n  "
		p class="note" {
			- "One implication of these definitions is that the default semantics can change over\n  time. This allows custom elements the same expressivity as built-in elements; e.g., compare to how\n  the default ARIA role semantics of an "
			code id="wai-aria:the-a-element" {
				a href="#the-a-element" {
					- "a"
				}
			}
			- " element change as the "
			code id="wai-aria:attr-hyperlink-href" {
				a href="#attr-hyperlink-href" {
					- "href"
				}
			}
			- " attribute is added or removed."
		}
		- "\n\n  "
		p {
			- "For an example of this in action, see "
			a href="#custom-elements-accessibility-example" {
				- "the\n  custom elements section"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Conformance checker requirements for checking use of ARIA "
			code id="wai-aria:attr-aria-role" {
				a href="#attr-aria-role" {
					- "role"
				}
			}
			- " and "
			code id="wai-aria:attr-aria-*" {
				a href="#attr-aria-*" {
					- "aria-*"
				}
			}
			- " attributes on\n  "
			a href="#html-elements" id="wai-aria:html-elements-2" {
				- "HTML elements"
			}
			- " are defined in "
			cite {
				- "ARIA in HTML"
			}
			- ". "
			a href="#refsARIAHTML" {
				- "[ARIAHTML]"
			}
		}
		- "\n\n  \n\n\n\n  "
		h2 id="semantics" {
			span class="secno" {
				- "4"
			}
			- " The elements of HTML"
			a href="#semantics" class="self-link"
		}
		- "\n\n  "
		h3 id="the-root-element" {
			span class="secno" {
				- "4.1"
			}
			- " The document element"
			a href="#the-root-element" class="self-link"
		}
		- "\n\n  "
		h4 id="the-html-element" {
			span class="secno" {
				- "4.1.1"
			}
			- " The "
			dfn data-dfn-type="element" {
				code {
					- "html"
				}
			}
			- " element"
			a href="#the-html-element" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/html" title="The <html> HTML element represents the root (top-level element) of an HTML document, so it is also referred to as the root element. All other elements must be descendants of this element." {
						- "Element/html"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
