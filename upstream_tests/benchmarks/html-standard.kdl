					}
					li {
						p {
							- "Let "
							var {
								- "candidateAncestor"
							}
							- " be null."
						}
					}
					li {
						- "\n      "
						p {
							a id="the-popover-attribute:while-3" href="https://infra.spec.whatwg.org/#iteration-while" data-x-internal="while" {
								- "While"
							}
							- " "
							var {
								- "okNesting"
							}
							- " is false:"
						}
						- "\n\n      "
						ol {
							li {
								p {
									- "Set "
									var {
										- "candidateAncestor"
									}
									- " to the result of running "
									a href="#nearest-inclusive-open-popover" id="the-popover-attribute:nearest-inclusive-open-popover" {
										- "nearest inclusive open\n       popover"
									}
									- " given "
									var {
										- "candidate"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "candidateAncestor"
									}
									- " is null or "
									var {
