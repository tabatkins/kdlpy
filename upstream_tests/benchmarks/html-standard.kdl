						- "\n\n      "
						ol {
							li {
								p {
									a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-14" {
										- "Generate implied end tags"
									}
									- ", except for "
									a href="#html-elements" id="parsing-main-inbody:html-elements-16" {
										- "HTML elements"
									}
									- " with the\n       same tag name as the token."
								}
							}
							li {
								p {
									- "If "
									var {
										- "node"
									}
									- " is not the "
									a href="#current-node" id="parsing-main-inbody:current-node-27" {
										- "current node"
									}
									- ", then this is a\n       "
									a href="#parse-errors" id="parsing-main-inbody:parse-errors-39" {
										- "parse error"
									}
									- "."
								}
							}
							li {
								p {
									- "Pop all the nodes from the "
									a href="#current-node" id="parsing-main-inbody:current-node-28" {
										- "current node"
									}
									- " up to "
									var {
										- "node"
									}
									- ",\n       including "
									var {
										- "node"
									}
									- ", then stop these steps."
								}
