		- "\n\n  \n\n  "
		p {
			- "Each "
			code id="the-navigationhistoryentry-interface:navigationhistoryentry-5" {
				a href="#navigationhistoryentry" {
					- "NavigationHistoryEntry"
				}
			}
			- " has an associated "
			dfn id="nhe-she" {
				- "session\n  history entry"
