			}
			li {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a id="the-popover-attribute:assert-15" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
								- "Assert"
							}
							- ": "
							var {
								- "invoker"
							}
							- " is null."
						}
					}
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "popoverPositions"
					}
					- " be an empty "
