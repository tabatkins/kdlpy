		- "\n\n  "
		p {
			- "To "
			dfn id="get-the-popover-stack-position" {
				- "get the popover stack position"
			}
			- ", given an "
			a href="#html-elements" id="popover-light-dismiss:html-elements" {
				- "HTML\n  element"
			}
