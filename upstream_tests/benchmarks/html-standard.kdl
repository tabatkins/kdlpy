			}
			- ", "
			a id="the-select-element-2:'background-color'" href="https://drafts.csswg.org/css-backgrounds/#propdef-background-color" data-x-internal="'background-color'" {
				- "'background-color'"
			}
			- ", and 'border' should\n  not be disregarded (as is generally permissible when rendering an element according to its\n  "
			a id="the-select-element-2:native-appearance" href="https://drafts.csswg.org/css-ui/#native-appearance" data-x-internal="native-appearance" {
				- "native appearance"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "In either case ("
			a href="#list-box" id="the-select-element-2:list-box-4" {
