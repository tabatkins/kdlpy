				p {
					- "Otherwise, if "
					var {
						- "userPromptHandler"
					}
					- " is \""
					code {
						- "accept"
					}
					- "\", then set\n   "
					var {
						- "result"
					}
					- " to the empty string."
				}
			}
			li {
				p {
					- "Invoke "
					a id="simple-dialogs:webdriver-bidi-user-prompt-closed-3" href="https://w3c.github.io/webdriver-bidi/#webdriver-bidi-user-prompt-closed" data-x-internal="webdriver-bidi-user-prompt-closed" {
						- "WebDriver BiDi user prompt closed"
					}
					- " with "
					a id="simple-dialogs:this-9" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- ",\n   \""
					code {
						- "prompt"
					}
					- "\", false if "
					var {
						- "result"
					}
					- " is null or true otherwise,\n   and "
					var {
						- "result"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					var {
						- "result"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="optionally-truncate-a-simple-dialog-string" {
				- "optionally truncate a simple dialog string"
			}
			- " "
			var {
				- "s"
			}
			- ", return either\n  "
			var {
				- "s"
			}
			- " itself or some string derived from "
			var {
				- "s"
			}
			- " that is shorter. User agents should\n  not provide UI for displaying the elided portion of "
			var {
				- "s"
			}
			- ", as this makes it too easy for\n  abusers to create dialogs of the form \"Important security alert! Click 'Show More' for full\n  details!\"."
