						}
					}
					li {
						p {
							a href="#generate-implied-end-tags" id="parsing-main-inbody:generate-implied-end-tags-6" {
								- "Generate implied end tags"
							}
							- "."
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id="parsing-main-inbody:current-node-10" {
								- "current node"
							}
							- " is not "
							var {
								- "node"
							}
							- ", then this is a\n     "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-20" {
								- "parse error"
							}
							- "."
						}
					}
					li {
						p {
							- "Remove "
							var {
								- "node"
							}
							- " from the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-37" {
								- "stack of open elements"
							}
							- "."
						}
					}
				}
				- "\n\n    "
				p {
					- "If there "
					em {
						- "is"
					}
					- " a "
					code id="parsing-main-inbody:the-template-element-8" {
						a href="#the-template-element" {
							- "template"
						}
					}
					- " element on the "
					a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-38" {
						- "stack of open\n    elements"
					}
					- ", then run these substeps instead:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							a href="#stack-of-open-elements" id="parsing-main-inbody:stack-of-open-elements-39" {
								- "stack of open elements"
							}
							- " does not "
							a href="#has-an-element-in-scope" id="parsing-main-inbody:has-an-element-in-scope-6" {
								- "have a "
								code {
									- "form"
								}
								- " element in scope"
							}
							- ", then this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-21" {
								- "parse\n     error"
