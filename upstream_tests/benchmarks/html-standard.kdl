		- "\n\n  \n\n  "
		p {
			- "The "
			dfn id="machine-readable-equivalent-of-the-element's-contents" {
				- "machine-readable equivalent of the element's contents"
			}
			- " must be obtained from the\n  element's "
			a href="#datetime-value" id="the-time-element:datetime-value-2" {
				- "datetime value"
			}
			- " by using the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a href="#parse-a-month-string" id="the-time-element:parse-a-month-string" {
