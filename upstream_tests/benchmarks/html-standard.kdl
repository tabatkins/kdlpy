									dt {
										- "If the attribute is in the "
										a id="serialising-html-fragments:xmlns-namespace-2" href="https://infra.spec.whatwg.org/#xmlns-namespace" data-x-internal="xmlns-namespace" {
											- "XMLNS namespace"
										}
										- " and the attribute's local name\n         is not "
