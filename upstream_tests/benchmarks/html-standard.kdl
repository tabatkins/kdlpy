					}
					- "\n    within its "
					a href="#nav-parent" id="focus-management-apis:nav-parent" {
						- "parent"
					}
					- "'s "
					a href="#nav-document" id="focus-management-apis:nav-document" {
						- "active\n    document"
					}
					- ". For example, if the user moves the focus to a text control in an\n    "
					code id="focus-management-apis:the-iframe-element" {
						a href="#the-iframe-element" {
							- "iframe"
						}
