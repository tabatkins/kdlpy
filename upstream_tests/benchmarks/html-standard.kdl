			a id="the-object-element:valid-mime-type-string" href="https://mimesniff.spec.whatwg.org/#valid-mime-type" data-x-internal="valid-mime-type-string" {
				- "valid\n  MIME type string"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="object" id="attr-object-name" data-dfn-type="element-attr" {
				code {
					- "name"
				}
			}
			- "\n  attribute, if present, must be a "
			a href="#valid-navigable-target-name" id="the-object-element:valid-navigable-target-name" {
				- "valid navigable target name"
			}
			- ". The given value is\n  used to name the element's "
			a href="#content-navigable" id="the-object-element:content-navigable-2" {
				- "content navigable"
			}
			- ", if applicable, and if present when the\n  element's "
			a href="#content-navigable" id="the-object-element:content-navigable-3" {
				- "content navigable"
			}
			- " is "
			a href="#create-a-new-child-navigable" id="the-object-element:create-a-new-child-navigable" {
				- "created"
			}
			- "."
		}
		- "\n\n  \n\n  "
		p {
			- "Whenever one of the following conditions occur:"
		}
		- "\n\n  "
		ul {
			li {
				- "the element is created,\n\n   "
			}
			li {
				- "the element is popped off the "
				a href="#stack-of-open-elements" id="the-object-element:stack-of-open-elements" {
					- "stack of open elements"
				}
				- " of an "
				a href="#html-parser" id="the-object-element:html-parser" {
					- "HTML\n   parser"
				}
				- " or "
				a href="#xml-parser" id="the-object-element:xml-parser" {
					- "XML parser"
				}
				- ",\n\n   "
			}
			li {
				- "the element is not on the "
				a href="#stack-of-open-elements" id="the-object-element:stack-of-open-elements-2" {
					- "stack of open elements"
				}
				- " of an "
				a href="#html-parser" id="the-object-element:html-parser-2" {
					- "HTML parser"
				}
				- "\n   or "
				a href="#xml-parser" id="the-object-element:xml-parser-2" {
					- "XML parser"
				}
				- ", and it is either "
				a href="#insert-an-element-into-a-document" id="the-object-element:insert-an-element-into-a-document" {
					- "inserted into a document"
				}
				- " or "
				a href="#remove-an-element-from-a-document" id="the-object-element:remove-an-element-from-a-document" {
					- "removed from a document"
				}
				- ",\n\n   "
			}
			li {
				- "the element's "
				a id="the-object-element:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
					- "node document"
				}
				- " changes whether it is "
				a href="#fully-active" id="the-object-element:fully-active" {
					- "fully active"
				}
				- ",\n\n   "
			}
			li {
				- "one of the element's ancestor "
				code id="the-object-element:the-object-element-3" {
					a href="#the-object-element" {
						- "object"
					}
				}
				- " elements changes to or from showing its\n   "
				a href="#fallback-content" id="the-object-element:fallback-content" {
					- "fallback content"
				}
				- ",\n\n   "
			}
			li {
				- "the element's "
				code id="the-object-element:attr-object-classid" {
					a href="#attr-object-classid" {
						- "classid"
					}
				}
				- " attribute is set, changed, or\n   removed,\n\n   "
			}
			li {
				- "the element's "
				code id="the-object-element:attr-object-classid-2" {
					a href="#attr-object-classid" {
						- "classid"
					}
				}
				- " attribute is not present, and\n   its "
				code id="the-object-element:attr-object-data-2" {
					a href="#attr-object-data" {
						- "data"
					}
				}
				- " attribute is set, changed, or removed,\n\n   "
			}
			li {
				- "neither the element's "
				code id="the-object-element:attr-object-classid-3" {
					a href="#attr-object-classid" {
						- "classid"
					}
				}
				- " attribute nor its\n   "
				code id="the-object-element:attr-object-data-3" {
					a href="#attr-object-data" {
						- "data"
					}
				}
				- " attribute are present, and its "
				code id="the-object-element:attr-object-type-2" {
					a href="#attr-object-type" {
						- "type"
					}
				}
				- " attribute is set, changed, or removed,\n\n   "
			}
			li {
				- "the element changes from "
				a href="#being-rendered" id="the-object-element:being-rendered" {
					- "being rendered"
				}
				- " to not being rendered, or vice versa,\n  "
			}
		}
		- " \n\n  "
		p {
			- "...the user agent must "
			a href="#queue-an-element-task" id="the-object-element:queue-an-element-task" {
				- "queue an element task"
			}
			- " on the "
			a href="#dom-manipulation-task-source" id="the-object-element:dom-manipulation-task-source" {
				- "DOM manipulation task\n  source"
			}
			- " given the "
			code id="the-object-element:the-object-element-4" {
				a href="#the-object-element" {
					- "object"
				}
			}
			- " element to run the following steps to (re)determine\n  what the "
			code id="the-object-element:the-object-element-5" {
				a href="#the-object-element" {
					- "object"
				}
			}
			- " element represents. This "
			a href="#concept-task" id="the-object-element:concept-task" {
				- "task"
			}
			- "\n  being "
			a href="#queue-a-task" id="the-object-element:queue-a-task" {
				- "queued"
			}
			- " or actively running must "
			a href="#delay-the-load-event" id="the-object-element:delay-the-load-event" {
				- "delay the load\n  event"
			}
			- " of the element's "
			a id="the-object-element:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
				- "node document"
			}
			- ". "
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If the user has indicated a preference that this "
					code id="the-object-element:the-object-element-6" {
						a href="#the-object-element" {
							- "object"
						}
					}
					- " element's "
					a href="#fallback-content" id="the-object-element:fallback-content-2" {
						- "fallback\n    content"
					}
					- " be shown instead of the element's usual behavior, then jump to the step below\n    labeled "
					i {
						- "fallback"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "For example, a user could ask for the element's "
					a href="#fallback-content" id="the-object-element:fallback-content-3" {
						- "fallback content"
					}
					- " to\n    be shown because that content uses a format that the user finds more accessible."
				}
				- "\n   "
			}
			li {
				p {
					- "If the element has an ancestor "
					a href="#media-element" id="the-object-element:media-element" {
						- "media element"
					}
					- ", or has an ancestor\n   "
					code id="the-object-element:the-object-element-7" {
						a href="#the-object-element" {
							- "object"
						}
					}
					- " element that is "
					em {
						- "not"
					}
					- " showing its "
					a href="#fallback-content" id="the-object-element:fallback-content-4" {
						- "fallback content"
					}
					- ", or if\n   the element is not "
					a id="the-object-element:in-a-document" href="https://dom.spec.whatwg.org/#in-a-document" data-x-internal="in-a-document" {
						- "in a document"
					}
					- " whose "
					a href="#concept-document-bc" id="the-object-element:concept-document-bc" {
						- "browsing\n   context"
					}
					- " is non-null, or if the element's "
					a id="the-object-element:node-document-3" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- " is not "
					a href="#fully-active" id="the-object-element:fully-active-2" {
						- "fully\n   active"
					}
					- ", or if the element is still in the "
					a href="#stack-of-open-elements" id="the-object-element:stack-of-open-elements-3" {
						- "stack of open elements"
					}
					- " of an\n   "
					a href="#html-parser" id="the-object-element:html-parser-3" {
						- "HTML parser"
					}
					- " or "
					a href="#xml-parser" id="the-object-element:xml-parser-3" {
						- "XML parser"
					}
					- ", or if the element is not "
					a href="#being-rendered" id="the-object-element:being-rendered-2" {
						- "being\n   rendered"
					}
					- ", then jump to the step below labeled "
					i {
						- "fallback"
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					code id="the-object-element:attr-object-data-4" {
						a href="#attr-object-data" {
							- "data"
						}
					}
					- " attribute is present and its value is\n   not the empty string, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If the "
							code id="the-object-element:attr-object-type-3" {
								a href="#attr-object-type" {
									- "type"
								}
							}
							- " attribute is present and its value is\n     not a type that the user agent supports, then the user agent may jump to the step below labeled\n     "
							i {
								- "fallback"
							}
							- " without fetching the content to examine its real type."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "url"
							}
							- " be the result of "
							a href="#encoding-parsing-a-url" id="the-object-element:encoding-parsing-a-url" {
								- "encoding-parsing a URL"
							}
							- " given the "
							code id="the-object-element:attr-object-data-5" {
								a href="#attr-object-data" {
									- "data"
								}
							}
							- " attribute's value, relative to the element's "
							a id="the-object-element:node-document-4" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node\n     document"
							}
							- "."
						}
					}
					li {
						p {
							- "If "
							var {
								- "url"
							}
							- " is failure, then "
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-object-element:concept-event-fire" data-x-internal="concept-event-fire" {
								- "fire an\n     event"
							}
							- " named "
							code id="the-object-element:event-error" {
								a href="#event-error" {
									- "error"
								}
							}
							- " at the element and jump to the step\n     below labeled "
							i {
								- "fallback"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "request"
							}
							- " be a new "
							a href="https://fetch.spec.whatwg.org/#concept-request" id="the-object-element:concept-request" data-x-internal="concept-request" {
								- "request"
							}
							- " whose\n     "
							a href="https://fetch.spec.whatwg.org/#concept-request-url" id="the-object-element:concept-request-url" data-x-internal="concept-request-url" {
								- "URL"
							}
							- " is "
							var {
								- "url"
							}
							- ", "
							a href="https://fetch.spec.whatwg.org/#concept-request-client" id="the-object-element:concept-request-client" data-x-internal="concept-request-client" {
								- "client"
							}
							- " is the element's "
							a id="the-object-element:node-document-5" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node document"
							}
							- "'s\n     "
							a href="#relevant-settings-object" id="the-object-element:relevant-settings-object" {
								- "relevant settings object"
							}
							- ", "
							a href="https://fetch.spec.whatwg.org/#concept-request-destination" id="the-object-element:concept-request-destination" data-x-internal="concept-request-destination" {
								- "destination"
							}
							- " is \""
							code {
								- "object"
							}
							- "\",\n     "
							a href="https://fetch.spec.whatwg.org/#concept-request-credentials-mode" id="the-object-element:concept-request-credentials-mode" data-x-internal="concept-request-credentials-mode" {
								- "credentials mode"
							}
							- " is \""
							code {
								- "include"
							}
							- "\", "
							a href="https://fetch.spec.whatwg.org/#concept-request-mode" id="the-object-element:concept-request-mode" data-x-internal="concept-request-mode" {
								- "mode"
							}
							- " is \""
							code {
								- "navigate"
							}
							- "\", "
							a href="https://fetch.spec.whatwg.org/#request-initiator-type" id="the-object-element:concept-request-initiator-type" data-x-internal="concept-request-initiator-type" {
								- "initiator\n     type"
							}
							- " is \""
							code {
								- "object"
							}
							- "\", and whose "
							a id="the-object-element:use-url-credentials-flag" href="https://fetch.spec.whatwg.org/#concept-request-use-url-credentials-flag" data-x-internal="use-url-credentials-flag" {
								- "use-URL-credentials\n     flag"
							}
							- " is set."
						}
					}
					li {
						- "\n      "
						p {
							a href="https://fetch.spec.whatwg.org/#concept-fetch" id="the-object-element:concept-fetch" data-x-internal="concept-fetch" {
								- "Fetch"
							}
							- " "
							var {
								- "request"
							}
							- "."
						}
						- "\n\n      \n      "
						p {
							- "Fetching the resource must "
							a href="#delay-the-load-event" id="the-object-element:delay-the-load-event-2" {
								- "delay the load event"
							}
							- " of the element's "
							a id="the-object-element:node-document-6" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
								- "node\n      document"
							}
							- " until the "
							a href="#concept-task" id="the-object-element:concept-task-2" {
								- "task"
							}
							- " that is "
							a href="#queue-a-task" id="the-object-element:queue-a-task-2" {
								- "queued"
							}
							- " by the "
							a href="#networking-task-source" id="the-object-element:networking-task-source" {
								- "networking task source"
							}
							- " once the resource has been\n      fetched (defined next) has been run."
						}
						- "\n     "
					}
					li {
						p {
							- "If the resource is not yet available (e.g. because the resource was not available in the\n     cache, so that loading the resource required making a request over the network), then jump to\n     the step below labeled "
							i {
								- "fallback"
							}
							- ". The "
							a href="#concept-task" id="the-object-element:concept-task-3" {
								- "task"
							}
							- " that is\n     "
							a href="#queue-a-task" id="the-object-element:queue-a-task-3" {
								- "queued"
							}
							- " by the "
							a href="#networking-task-source" id="the-object-element:networking-task-source-2" {
								- "networking task source"
							}
							- " once the\n     resource is available must restart this algorithm from this step. Resources can load\n     incrementally; user agents may opt to consider a resource \"available\" whenever enough data has\n     been obtained to begin processing the resource."
						}
					}
					li {
						p {
							- "If the load failed (e.g. there was an HTTP 404 error, there was a DNS error), "
							a href="https://dom.spec.whatwg.org/#concept-event-fire" id="the-object-element:concept-event-fire-2" data-x-internal="concept-event-fire" {
								- "fire an event"
							}
							- " named "
							code id="the-object-element:event-error-2" {
								a href="#event-error" {
									- "error"
								}
							}
							- "\n     at the element, then jump to the step below labeled "
							i {
								- "fallback"
							}
							- "."
						}
					}
					li id="object-type-detection" {
						- "\n\n      "
						p {
							- "Determine the "
							var {
								- "resource type"
							}
							- ", as follows:"
						}
						- "\n\n\n\n      "
						ol {
							li {
								- "\n        "
								p {
									- "Let the "
									var {
										- "resource type"
									}
									- " be unknown."
								}
								- "\n       "
							}
							li {
								- "\n        \n\n        "
								p {
									- "If the user agent is configured to strictly obey Content-Type headers for this resource,\n        and the resource has "
									a href="#content-type" id="the-object-element:content-type" {
										- "associated Content-Type metadata"
									}
									- ",\n        then let the "
									var {
										- "resource type"
									}
									- " be the type specified in "
									a href="#content-type" id="the-object-element:content-type-2" {
										- "the resource's Content-Type metadata"
									}
									- ", and jump to the step below\n        labeled "
									i {
										- "handler"
									}
									- "."
								}
								- "\n\n        "
								p class="warning" {
									- "This can introduce a vulnerability, wherein a site is trying to embed a\n        resource that uses a particular type, but the remote site overrides that and instead\n        furnishes the user agent with a resource that triggers a different type of content with different\n        security characteristics. "
								}
								- "\n       "
							}
							li {
								- "\n        "
								p {
									- "Run the appropriate set of steps from the following\n        list:"
								}
								- "\n\n        "
								dl class="switch" {
									dt {
										- "If the resource has "
										a href="#content-type" id="the-object-element:content-type-3" {
											- "associated Content-Type\n         metadata"
										}
									}
									dd {
										- "\n          "
										ol {
											li {
												- "\n            "
												p {
													- "Let "
													var {
														- "binary"
													}
													- " be false."
												}
												- "\n           "
											}
											li {
												- "\n            "
												p {
													- "If the type specified in "
													a href="#content-type" id="the-object-element:content-type-4" {
														- "the resource's Content-Type\n            metadata"
													}
													- " is \""
													code id="the-object-element:text/plain" {
														a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
															- "text/plain"
														}
													}
													- "\", and the result of applying the "
													a href="https://mimesniff.spec.whatwg.org/#rules-for-text-or-binary" id="the-object-element:content-type-sniffing:-text-or-binary" data-x-internal="content-type-sniffing:-text-or-binary" {
														- "rules for distinguishing if a resource is\n            text or binary"
													}
													- " to the resource is that the resource is not\n            "
													code id="the-object-element:text/plain-2" {
														a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
															- "text/plain"
														}
													}
													- ", then set "
													var {
														- "binary"
													}
													- " to true."
												}
												- "\n           "
											}
											li {
												- "\n            "
												p {
													- "If the type specified in "
													a href="#content-type" id="the-object-element:content-type-5" {
														- "the resource's Content-Type\n            metadata"
													}
													- " is \""
													code id="the-object-element:application/octet-stream" {
														a data-x-internal="application/octet-stream" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.5.1" {
															- "application/octet-stream"
														}
													}
													- "\", then set "
													var {
														- "binary"
													}
													- " to true."
												}
												- "\n           "
											}
											li {
												- "\n            "
												p {
													- "If "
													var {
														- "binary"
													}
													- " is false, then let the "
													var {
														- "resource\n            type"
													}
													- " be the type specified in "
													a href="#content-type" id="the-object-element:content-type-6" {
														- "the resource's\n            Content-Type metadata"
													}
													- ", and jump to the step below labeled "
													i {
														- "handler"
													}
													- "."
												}
												- "\n           "
											}
											li {
												- "\n            "
												p {
													- "If there is a "
													code id="the-object-element:attr-object-type-4" {
														a href="#attr-object-type" {
															- "type"
														}
													}
													- " attribute present on the\n            "
