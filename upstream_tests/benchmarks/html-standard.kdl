				}
				- "  "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "\"<!--\""
				}
				- "\n"
				c- nc="" {
					- "comment-close"
				}
				- " "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "\"-->\""
				}
				- "\n"
				c- nc="" {
					- "script-open"
				}
				- "   "
				c- o="" {
					- "="
				}
				- " "
				c- l="" {
					- "\"<\""
				}
				- " s c r i p t "
				c- nc="" {
					- "tag-end"
				}
				- "\n\ns             "
				c- o="" {
