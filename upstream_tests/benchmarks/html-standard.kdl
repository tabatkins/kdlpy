					a href="#sandboxLinks" {
						- "prevents content from navigating browsing contexts other\n    than the sandboxed browsing context itself"
					}
					- " (or browsing contexts further nested inside it),\n    "
					a href="#auxiliary-browsing-context" id="sandboxing:auxiliary-browsing-context" {
						- "auxiliary browsing contexts"
					}
					- " (which are protected\n    by the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id="sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag" {
						- "sandboxed auxiliary navigation browsing context flag"
					}
					- " defined next), and the\n    "
					a href="#top-level-browsing-context" id="sandboxing:top-level-browsing-context" {
						- "top-level browsing context"
					}
					- " (which is protected by the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" {
						- "sandboxed top-level\n    navigation without user activation browsing context flag"
					}
					- " and "
					a href="#sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" {
						- "sandboxed top-level\n    navigation with user activation browsing context flag"
					}
					- " defined below)."
				}
				- "\n\n    "
				p {
					- "If the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id="sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-2" {
						- "sandboxed auxiliary navigation browsing context flag"
					}
					- " is not set, then in\n    certain cases the restrictions nonetheless allow popups (new "
					a href="#top-level-browsing-context" id="sandboxing:top-level-browsing-context-2" {
						- "top-level browsing contexts"
					}
					- ") to be opened. These "
					a href="#browsing-context" id="sandboxing:browsing-context" {
						- "browsing contexts"
					}
					- " always have "
					dfn id="one-permitted-sandboxed-navigator" {
						- "one permitted sandboxed navigator"
					}
					- ", set\n    when the browsing context is created, which allows the "
					a href="#browsing-context" id="sandboxing:browsing-context-2" {
						- "browsing context"
					}
					- " that\n    created them to actually navigate them. (Otherwise, the "
					a href="#sandboxed-navigation-browsing-context-flag" id="sandboxing:sandboxed-navigation-browsing-context-flag" {
						- "sandboxed navigation browsing\n    context flag"
					}
					- " would prevent them from being navigated even if they were opened.)"
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-auxiliary-navigation-browsing-context-flag" data-export="" {
					- "sandboxed auxiliary navigation browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxWindowOpen" {
						- "prevents content from creating new auxiliary browsing\n    contexts"
					}
					- ", e.g. using the "
					code id="sandboxing:attr-hyperlink-target" {
						a href="#attr-hyperlink-target" {
							- "target"
						}
					}
					- " attribute or\n    the "
					code id="sandboxing:dom-open" {
						a href="#dom-open" {
							- "window.open()"
						}
					}
					- " method."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" data-export="" {
					- "sandboxed top-level navigation without user activation browsing\n   context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxLinks" {
						- "prevents content from navigating their "
						span {
							- "top-level\n    browsing context"
						}
					}
					- " and "
					a href="#sandboxClose" {
						- "prevents content from closing their\n    "
						span {
							- "top-level browsing context"
						}
					}
					- ". It is consulted only when the sandboxed browsing\n    context's "
					a href="#active-window" id="sandboxing:active-window" {
						- "active window"
					}
					- " does not have "
					a href="#transient-activation" id="sandboxing:transient-activation" {
						- "transient activation"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "When the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-2" {
						- "sandboxed top-level navigation without user activation browsing context\n    flag"
					}
					- " is "
					em {
						- "not"
					}
					- " set, content can navigate its "
					a href="#top-level-browsing-context" id="sandboxing:top-level-browsing-context-3" {
						- "top-level browsing\n    context"
					}
					- ", but other "
					a href="#browsing-context" id="sandboxing:browsing-context-3" {
						- "browsing contexts"
					}
					- " are still\n    protected by the "
					a href="#sandboxed-navigation-browsing-context-flag" id="sandboxing:sandboxed-navigation-browsing-context-flag-2" {
						- "sandboxed navigation browsing context flag"
					}
					- " and possibly\n    the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id="sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-3" {
						- "sandboxed auxiliary navigation browsing context flag"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" data-export="" {
					- "sandboxed top-level navigation with user activation browsing context\n   flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxLinks" {
						- "prevents content from navigating their "
						span {
							- "top-level\n    browsing context"
						}
					}
					- " and "
					a href="#sandboxClose" {
						- "prevents content from closing their\n    "
						span {
							- "top-level browsing context"
						}
					}
					- ". It is consulted only when the sandboxed browsing\n    context's "
					a href="#active-window" id="sandboxing:active-window-2" {
						- "active window"
					}
					- " has "
					a href="#transient-activation" id="sandboxing:transient-activation-2" {
						- "transient activation"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "As with the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-3" {
						- "sandboxed top-level navigation without user activation browsing context\n    flag"
					}
					- ", this flag only affects the "
					a href="#top-level-browsing-context" id="sandboxing:top-level-browsing-context-4" {
						- "top-level browsing context"
					}
					- "; if it is not\n    set, other "
					a href="#browsing-context" id="sandboxing:browsing-context-4" {
						- "browsing contexts"
					}
					- " might still be protected by\n    other flags."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-origin-browsing-context-flag" data-export="" {
					- "sandboxed origin browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxOrigin" {
						- "forces content into an opaque origin"
					}
					- ", thus preventing\n    it from accessing other content from the same "
					a href="#concept-origin" id="sandboxing:concept-origin" {
						- "origin"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "This flag also "
					a href="#sandboxCookies" {
						- "prevents script from reading from or writing to the\n    "
						code {
							- "document.cookie"
						}
						- " IDL attribute"
					}
					- ", and blocks access\n    to "
					code id="sandboxing:dom-localstorage" {
						a href="#dom-localstorage" {
							- "localStorage"
						}
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-forms-browsing-context-flag" data-export="" {
					- "sandboxed forms browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxSubmitBlocked" {
						- "blocks form submission"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-pointer-lock-browsing-context-flag" data-export="" {
					- "sandboxed pointer lock browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag disables the Pointer Lock API. "
					a href="#refsPOINTERLOCK" {
						- "[POINTERLOCK]"
					}
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-scripts-browsing-context-flag" data-export="" {
					- "sandboxed scripts browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag "
					a href="#sandboxScriptBlocked" {
						- "blocks script execution"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-automatic-features-browsing-context-flag" data-export="" {
					- "sandboxed automatic features browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag blocks features that trigger automatically, such as "
					a href="#attr-media-autoplay" id="sandboxing:attr-media-autoplay" {
						- "automatically playing a video"
					}
					- " or "
					a href="#attr-fe-autofocus" id="sandboxing:attr-fe-autofocus" {
						- "automatically focusing a form control"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-document.domain-browsing-context-flag" data-export="" {
					- "sandboxed "
					code {
						- "document.domain"
					}
					- "\n   browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag prevents content from using the\n    "
					code id="sandboxing:dom-document-domain" {
						a href="#dom-document-domain" {
							- "document.domain"
						}
					}
					- " setter."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandbox-propagates-to-auxiliary-browsing-contexts-flag" data-export="" {
					- "sandbox propagates to auxiliary browsing contexts flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag prevents content from escaping the sandbox by ensuring that any\n    "
					a href="#auxiliary-browsing-context" id="sandboxing:auxiliary-browsing-context-2" {
						- "auxiliary browsing context"
					}
					- " it creates inherits the content's\n    "
					a href="#active-sandboxing-flag-set" id="sandboxing:active-sandboxing-flag-set" {
						- "active sandboxing flag set"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-modals-flag" data-export="" {
					- "sandboxed modals flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag prevents content from using any of the following features to produce modal\n    dialogs:"
				}
				- "\n\n    "
				ul {
					li {
						code id="sandboxing:dom-alert" {
							a href="#dom-alert" {
								- "window.alert()"
							}
						}
					}
					li {
						code id="sandboxing:dom-confirm" {
							a href="#dom-confirm" {
								- "window.confirm()"
							}
						}
					}
					li {
						code id="sandboxing:dom-print" {
							a href="#dom-print" {
								- "window.print()"
							}
						}
					}
					li {
						code id="sandboxing:dom-prompt" {
							a href="#dom-prompt" {
								- "window.prompt()"
							}
						}
					}
					li {
						- "the "
						code id="sandboxing:event-beforeunload" {
							a href="#event-beforeunload" {
								- "beforeunload"
							}
						}
						- " event"
					}
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-orientation-lock-browsing-context-flag" data-export="" {
					- "sandboxed orientation lock browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag disables the ability to lock the screen orientation.\n    "
					a href="#refsSCREENORIENTATION" {
						- "[SCREENORIENTATION]"
					}
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-presentation-browsing-context-flag" data-export="" {
					- "sandboxed presentation browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag disables the Presentation API. "
					a href="#refsPRESENTATION" {
						- "[PRESENTATION]"
					}
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-downloads-browsing-context-flag" data-export="" {
					- "sandboxed downloads browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag prevents content from initiating or instantiating downloads, whether through "
					a href="#downloading-hyperlinks" id="sandboxing:downloading-hyperlinks" {
						- "downloading hyperlinks"
					}
					- " or through "
					a href="#navigation-as-a-download" {
						- "navigation"
					}
					- " that gets handled "
					a href="#as-a-download" id="sandboxing:as-a-download" {
						- "as a\n    download"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- "The "
				dfn id="sandboxed-custom-protocols-navigation-browsing-context-flag" data-export="" {
					- "sandboxed custom protocols navigation browsing context flag"
				}
			}
			dd {
				- "\n    "
				p {
					- "This flag prevents navigations toward non "
					a href="https://fetch.spec.whatwg.org/#fetch-scheme" id="sandboxing:fetch-scheme" data-x-internal="fetch-scheme" {
						- "fetch schemes"
					}
					- "\n    from being "
					a href="#hand-off-to-external-software" id="sandboxing:hand-off-to-external-software" {
						- "handed off to external\n    software"
					}
					- "."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "When the user agent is to "
			dfn id="parse-a-sandboxing-directive" data-export="" {
				- "parse a sandboxing directive"
			}
			- ", given a string\n  "
			var {
				- "input"
			}
			- ", a "
			a href="#sandboxing-flag-set" id="sandboxing:sandboxing-flag-set" {
				- "sandboxing flag set"
			}
			- " "
			var {
				- "output"
			}
			- ", it must run the following\n  steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					a href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id="sandboxing:split-a-string-on-spaces" data-x-internal="split-a-string-on-spaces" {
						- "Split "
						var {
							- "input"
						}
						- " on ASCII\n   whitespace"
					}
					- ", to obtain "
					var {
						- "tokens"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "output"
					}
					- " be empty."
				}
			}
			li {
				- "\n    "
				p {
					- "Add the following flags to "
					var {
						- "output"
					}
					- ":"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "The "
							a href="#sandboxed-navigation-browsing-context-flag" id="sandboxing:sandboxed-navigation-browsing-context-flag-3" {
								- "sandboxed navigation browsing context flag"
							}
							- "."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id="sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-4" {
								- "sandboxed auxiliary navigation browsing context flag"
							}
							- ", unless\n     "
							var {
								- "tokens"
							}
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-popups" data-dfn-type="attr-value" {
								code {
									- "allow-popups"
								}
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-4" {
								- "sandboxed top-level navigation without user activation browsing context\n     flag"
							}
							- ", unless "
							var {
								- "tokens"
							}
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-top-navigation" data-dfn-type="attr-value" {
								code {
									- "allow-top-navigation"
								}
							}
							- "\n     keyword."
						}
					}
					li {
						- "\n      "
						p {
							- "The "
							a href="#sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" id="sandboxing:sandboxed-top-level-navigation-with-user-activation-browsing-context-flag-2" {
								- "sandboxed top-level navigation with user activation browsing context flag"
							}
							- ",\n      unless "
							var {
								- "tokens"
							}
							- " contains either the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-top-navigation-by-user-activation" data-dfn-type="attr-value" {
								code {
									- "allow-top-navigation-by-user-activation"
								}
							}
							- "\n      keyword or the "
							code id="sandboxing:attr-iframe-sandbox-allow-top-navigation" {
								a href="#attr-iframe-sandbox-allow-top-navigation" {
									- "allow-top-navigation"
								}
							}
							- " keyword."
						}
						- "\n\n      "
						p class="note" {
							- "This means that if the "
							code id="sandboxing:attr-iframe-sandbox-allow-top-navigation-2" {
								a href="#attr-iframe-sandbox-allow-top-navigation" {
									- "allow-top-navigation"
								}
							}
							- " is present, the "
							code id="sandboxing:attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
								a href="#attr-iframe-sandbox-allow-top-navigation-by-user-activation" {
									- "allow-top-navigation-by-user-activation"
								}
							}
							- "\n      keyword will have no effect. For this reason, specifying both is a document conformance error."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "The "
							a href="#sandboxed-origin-browsing-context-flag" id="sandboxing:sandboxed-origin-browsing-context-flag" {
								- "sandboxed origin browsing context flag"
							}
							- ", unless the "
							var {
								- "tokens"
							}
							- "\n      contains the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-same-origin" data-dfn-type="attr-value" {
								code {
									- "allow-same-origin"
								}
							}
							- " keyword."
						}
						- "\n\n      "
						div class="note" {
							- "\n       "
							p {
								- "The "
								code id="sandboxing:attr-iframe-sandbox-allow-same-origin" {
									a href="#attr-iframe-sandbox-allow-same-origin" {
										- "allow-same-origin"
									}
								}
								- " keyword\n       is intended for two cases."
							}
							- "\n\n       "
							p {
								- "First, it can be used to allow content from the same site to be sandboxed to disable\n       scripting, while still allowing access to the DOM of the sandboxed content."
							}
							- "\n\n       "
							p {
								- "Second, it can be used to embed content from a third-party site, sandboxed to prevent that\n       site from opening popups, etc, without preventing the embedded page from communicating back\n       to its originating site, using the database APIs to store data, etc."
							}
							- "\n      "
						}
						- "\n     "
					}
					li {
						p {
							- "The "
							a href="#sandboxed-forms-browsing-context-flag" id="sandboxing:sandboxed-forms-browsing-context-flag" {
								- "sandboxed forms browsing context flag"
							}
							- ", unless "
							var {
								- "tokens"
							}
							- "\n     contains the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-forms" data-dfn-type="attr-value" {
								code {
									- "allow-forms"
								}
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-pointer-lock-browsing-context-flag" id="sandboxing:sandboxed-pointer-lock-browsing-context-flag" {
								- "sandboxed pointer lock browsing context flag"
							}
							- ", unless "
							var {
								- "tokens"
							}
							- "\n     contains the "
							dfn data-dfn-for="iframe/sandbox" id="attr-iframe-sandbox-allow-pointer-lock" data-dfn-type="attr-value" {
								code {
									- "allow-pointer-lock"
								}
							}
							- "\n     keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-scripts-browsing-context-flag" id="sandboxing:sandboxed-scripts-browsing-context-flag" {
								- "sandboxed scripts browsing context flag"
							}
