		- "\n  \n\n  "
		p {
			- "The "
			code id="the-select-element:the-select-element" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element represents a control for selecting amongst a set of\n  options."
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Attributes/multiple" title="The Boolean multiple attribute, if set, means the form control accepts one or more values. Valid for the email and file input types and the <select>, the manner by which the user opts for multiple values depends on the form control." {
						- "Attributes/multiple"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "3+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="select" id="attr-select-multiple" data-dfn-type="element-attr" {
				code {
					- "multiple"
				}
			}
			- "\n  attribute is a "
			a href="#boolean-attribute" id="the-select-element:boolean-attribute" {
				- "boolean attribute"
			}
			- ". If the attribute is present, then the\n  "
			code id="the-select-element:the-select-element-2" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element "
			a href="#represents" id="the-select-element:represents" {
				- "represents"
			}
			- " a control for selecting zero or more options\n  from the "
			a href="#concept-select-option-list" id="the-select-element:concept-select-option-list" {
				- "list of options"
			}
			- ". If the attribute is\n  absent, then the "
			code id="the-select-element:the-select-element-3" {
				a href="#the-select-element" {
					- "select"
				}
			}
			- " element "
			a href="#represents" id="the-select-element:represents-2" {
				- "represents"
			}
			- " a control for selecting a\n  single option from the "
			a href="#concept-select-option-list" id="the-select-element:concept-select-option-list-2" {
				- "list of options"
