				}
				- " attribute and the "
				code id="optional-tags:the-html-element-8" {
					a href="#the-html-element" {
						- "html"
					}
				}
				- " element had to have a "
				code id="optional-tags:attr-lang" {
					a href="#attr-lang" {
						- "lang"
					}
				}
				- " attribute, the markup would have to become:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- cp="" {
						- "<!DOCTYPE HTML>"
					}
					c- p="" {
						- "<"
					}
					c- f="" {
						- "html"
					}
					- " "
					c- e="" {
						- "lang"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"en\""
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "title"
					}
					c- p="" {
						- ">"
					}
					- "Hello"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "title"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "body"
					}
					- " "
					c- e="" {
						- "class"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"demo\""
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "Welcome to this example."
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		p class="note" {
			- "This section assumes that the document is conforming, in particular, that there\n  are no "
			a href="#content-models" id="optional-tags:content-models" {
				- "content model"
			}
			- " violations. Omitting tags in the fashion\n  described in this section in a document that does not conform to the "
			a href="#content-models" id="optional-tags:content-models-2" {
				- "content models"
			}
			- "\n  described in this specification is likely to result in unexpected DOM differences (this is, in\n  part, what the content models are designed to avoid)."
		}
		- "\n\n\n  "
		h5 id="element-restrictions" {
			span class="secno" {
				- "13.1.2.5"
			}
			- " Restrictions on content models"
			a href="#element-restrictions" class="self-link"
		}
		- "\n\n  "
		p {
			- "For historical reasons, certain elements have extra restrictions beyond even the restrictions\n  given by their content model."
		}
		- "\n\n  "
		p {
			- "A "
			code id="element-restrictions:the-table-element" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- " element must not contain "
			code id="element-restrictions:the-tr-element" {
				a href="#the-tr-element" {
					- "tr"
				}
			}
			- " elements, even though these\n  elements are technically allowed inside "
			code id="element-restrictions:the-table-element-2" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- " elements according to the content\n  models described in this specification. (If a "
			code id="element-restrictions:the-tr-element-2" {
				a href="#the-tr-element" {
					- "tr"
				}
			}
			- " element is put inside a\n  "
			code id="element-restrictions:the-table-element-3" {
				a href="#the-table-element" {
					- "table"
				}
			}
			- " in the markup, it will in fact imply a "
			code id="element-restrictions:the-tbody-element" {
				a href="#the-tbody-element" {
					- "tbody"
				}
			}
			- " start tag before\n  it.)"
		}
		- "\n\n  "
		p {
			- "A single "
			a href="#syntax-newlines" id="element-restrictions:syntax-newlines" {
				- "newline"
			}
			- " may be placed immediately after the "
			a href="#syntax-start-tag" id="element-restrictions:syntax-start-tag" {
				- "start tag"
			}
			- " of "
			code id="element-restrictions:the-pre-element" {
				a href="#the-pre-element" {
					- "pre"
				}
			}
			- " and "
			code id="element-restrictions:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements.\n  This does not affect the processing of the element. The otherwise optional "
			a href="#syntax-newlines" id="element-restrictions:syntax-newlines-2" {
				- "newline"
			}
			- " "
			em {
				- "must"
			}
			- " be included if the element's contents\n  themselves start with a "
			a href="#syntax-newlines" id="element-restrictions:syntax-newlines-3" {
				- "newline"
			}
			- " (because otherwise the\n  leading newline in the contents would be treated like the optional newline, and ignored)."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The following two "
				code id="element-restrictions:the-pre-element-2" {
					a href="#the-pre-element" {
						- "pre"
					}
				}
				- " blocks are equivalent:"
			}
			- "\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "pre"
					}
					c- p="" {
						- ">"
					}
					- "Hello"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "pre"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "pre"
					}
					c- p="" {
						- ">"
					}
					br
					- "Hello"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "pre"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n  "
		}
		- "\n\n\n  "
		h5 id="cdata-rcdata-restrictions" {
			span class="secno" {
				- "13.1.2.6"
			}
			- " Restrictions on the contents of raw text and escapable raw text elements"
			a href="#cdata-rcdata-restrictions" class="self-link"
		}
		- "\n\n  "
		p {
			- "The text in "
			a href="#raw-text-elements" id="cdata-rcdata-restrictions:raw-text-elements" {
				- "raw text"
			}
			- " and "
			a href="#escapable-raw-text-elements" id="cdata-rcdata-restrictions:escapable-raw-text-elements" {
				- "escapable raw text\n  elements"
			}
			- " must not contain any occurrences of the string \""
			code {
				- "</"
			}
			- "\"\n  (U+003C LESS-THAN SIGN, U+002F SOLIDUS) followed by characters that case-insensitively match the\n  tag name of the element followed by one of U+0009 CHARACTER TABULATION (tab), U+000A LINE FEED\n  (LF), U+000C FORM FEED (FF), U+000D CARRIAGE RETURN (CR), U+0020 SPACE, U+003E GREATER-THAN SIGN\n  (>), or U+002F SOLIDUS (/)."
		}
		- "\n\n\n  "
		h4 id="text-2" {
			span class="secno" {
				- "13.1.3"
			}
			- " Text"
			a href="#text-2" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-text" {
				- "Text"
			}
			- " is allowed inside elements, attribute values, and comments.\n  Extra constraints are placed on what is and what is not allowed in text based on where the text is\n  to be put, as described in the other sections."
		}
		- "\n\n\n  "
		h5 id="newlines" {
			span class="secno" {
				- "13.1.3.1"
			}
			- " Newlines"
			a href="#newlines" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-newlines" {
				- "Newlines"
			}
			- " in HTML may be represented either as U+000D\n  CARRIAGE RETURN (CR) characters, U+000A LINE FEED (LF) characters, or pairs of U+000D CARRIAGE\n  RETURN (CR), U+000A LINE FEED (LF) characters in that order."
		}
		- "\n\n  "
		p {
			- "Where "
			a href="#syntax-charref" id="newlines:syntax-charref" {
				- "character references"
			}
			- " are allowed, a character\n  reference of a U+000A LINE FEED (LF) character (but not a U+000D CARRIAGE RETURN (CR) character)\n  also represents a "
			a href="#syntax-newlines" id="newlines:syntax-newlines" {
				- "newline"
			}
			- "."
		}
		- "\n\n\n  "
		h4 id="character-references" {
			span class="secno" {
				- "13.1.4"
			}
			- " Character references"
			a href="#character-references" class="self-link"
		}
		- "\n\n  "
		p {
			- "In certain cases described in other sections, "
			a href="#syntax-text" id="character-references:syntax-text" {
				- "text"
			}
			- " may be\n  mixed with "
			dfn id="syntax-charref" {
				- "character references"
			}
			- ". These can be used to escape\n  characters that couldn't otherwise legally be included in "
			a href="#syntax-text" id="character-references:syntax-text-2" {
				- "text"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Character references must start with a U+0026 AMPERSAND character (&). Following this,\n  there are three possible kinds of character references:"
		}
		- "\n\n  "
		dl {
			dt {
				- "Named character references"
			}
			dd {
				- "The ampersand must be followed by one of the names given in the "
				a href="#named-character-references" id="character-references:named-character-references" {
					- "named character\n   references"
				}
				- " section, using the same case. The name must be one that is\n   terminated by a U+003B SEMICOLON character (;)."
			}
			dt {
				- "Decimal numeric character reference"
			}
			dd {
				- "The ampersand must be followed by a U+0023 NUMBER SIGN character (#), followed by one or more\n   "
				a id="character-references:ascii-digits" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
					- "ASCII digits"
				}
				- ", representing a base-ten integer that corresponds to a code point that\n   is allowed according to the definition below. The digits must then be followed by a U+003B\n   SEMICOLON character (;)."
			}
			dt {
				- "Hexadecimal numeric character reference"
			}
			dd {
				- "The ampersand must be followed by a U+0023 NUMBER SIGN character (#), which must be followed\n   by either a U+0078 LATIN SMALL LETTER X character (x) or a U+0058 LATIN CAPITAL LETTER X\n   character (X), which must then be followed by one or more "
				a id="character-references:ascii-hex-digits" href="https://infra.spec.whatwg.org/#ascii-hex-digit" data-x-internal="ascii-hex-digits" {
					- "ASCII hex digits"
				}
				- ",\n   representing a hexadecimal integer that corresponds to a code point that is allowed according to\n   the definition below. The digits must then be followed by a U+003B SEMICOLON character (;)."
			}
		}
		- "\n\n  "
		p {
			- "The numeric character reference forms described above are allowed to reference any code point\n  excluding U+000D CR, "
			a href="https://infra.spec.whatwg.org/#noncharacter" id="character-references:noncharacter" data-x-internal="noncharacter" {
				- "noncharacters"
			}
			- ", and "
			a href="https://infra.spec.whatwg.org/#control" id="character-references:control" data-x-internal="control" {
				- "controls"
			}
			- " other than "
			a id="character-references:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
				- "ASCII whitespace"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="syntax-ambiguous-ampersand" {
				- "ambiguous ampersand"
			}
			- " is a U+0026 AMPERSAND\n  character (&) that is followed by one or more "
			a href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id="character-references:alphanumeric-ascii-characters" data-x-internal="alphanumeric-ascii-characters" {
				- "ASCII\n  alphanumerics"
			}
			- ", followed by a U+003B SEMICOLON character (;), where these characters do not\n  match any of the names given in the "
			a href="#named-character-references" id="character-references:named-character-references-2" {
				- "named character references"
			}
			- " section."
		}
		- "\n\n\n  "
		h4 id="cdata-sections" {
			span class="secno" {
				- "13.1.5"
			}
			- " CDATA sections"
			a href="#cdata-sections" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-cdata" {
				- "CDATA sections"
			}
			- " must consist of the following components, in\n  this order:"
		}
		- "\n\n  "
		ol {
			li {
				- "The string \""
				code {
					- "<![CDATA["
				}
				- "\"."
			}
			li {
				- "Optionally, "
				a href="#syntax-text" id="cdata-sections:syntax-text" {
					- "text"
				}
				- ", with the additional restriction that the\n   text must not contain the string \""
				code {
					- "]]>"
				}
				- "\"."
			}
			li {
				- "The string \""
				code {
					- "]]>"
				}
				- "\"."
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "CDATA sections can only be used in foreign content (MathML or SVG). In this example, a CDATA\n   section is used to escape the contents of a "
				a id="cdata-sections:mathml-ms" href="https://w3c.github.io/mathml-core/#string-literal-ms" data-x-internal="mathml-ms" {
					- "MathML "
					code {
						- "ms"
					}
				}
				- " element:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "You can add a string to a number, but this stringifies the number:"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "math"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "ms"
					}
					c- p="" {
						- ">"
					}
					c- cp="" {
						- "<![CDATA[x<y]]>"
					}
					c- p="" {
						- "</"
					}
					c- f="" {
						- "ms"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "mo"
					}
					c- p="" {
						- ">"
					}
					- "+"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "mo"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "mn"
					}
					c- p="" {
						- ">"
					}
					- "3"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "mn"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "mo"
					}
					c- p="" {
						- ">"
					}
					- "="
					c- p="" {
						- "</"
					}
					c- f="" {
						- "mo"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "ms"
					}
					c- p="" {
						- ">"
					}
					c- cp="" {
						- "<![CDATA[x<y3]]>"
					}
					c- p="" {
						- "</"
					}
					c- f="" {
						- "ms"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "math"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h4 id="comments" {
			span class="secno" {
				- "13.1.6"
			}
			- " Comments"
			a href="#comments" class="self-link"
		}
		- "\n\n  "
		p {
			dfn id="syntax-comments" {
				- "Comments"
			}
			- " must have the following format:"
		}
		- "\n\n  "
		ol {
			li {
				- "The string \""
				code {
					- "<!--"
				}
				- "\"."
			}
			li {
				- "Optionally, "
				a href="#syntax-text" id="comments:syntax-text" {
					- "text"
				}
				- ", with the additional restriction that the\n   text must not start with the string \""
				code {
					- ">"
				}
				- "\", nor start with the string\n   \""
				code {
					- "->"
				}
				- "\", nor contain the strings \""
				code {
					- "<!--"
				}
				- "\", \""
				code {
					- "-->"
				}
				- "\", or \""
				code {
					- "--!>"
				}
				- "\", nor end with the string \""
				code {
					- "<!-"
				}
				- "\"."
			}
			li {
				- "The string \""
				code {
					- "-->"
				}
				- "\"."
			}
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#syntax-text" id="comments:syntax-text-2" {
				- "text"
			}
			- " is allowed to end with the string\n  \""
			code {
				- "<!"
			}
			- "\", as in "
			code {
				- "<!--My favorite operators are > and\n  <!-->"
			}
			- "."
		}
		- "\n\n\n\n\n  \n\n  "
		h3 id="parsing" {
			span class="secno" {
				- "13.2"
			}
			- " Parsing HTML documents"
			a href="#parsing" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section only applies to user agents, data mining tools, and conformance\n  checkers."
			}
		}
		- "\n\n  "
		p class="note" {
			- "The rules for parsing XML documents into DOM trees are covered by the next\n  section, entitled \""
			a href="#the-xhtml-syntax" id="parsing:the-xhtml-syntax" {
				- "The XML syntax"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "User agents must use the parsing rules described in this section to generate the DOM trees from\n  "
			code id="parsing:text/html" {
				a href="#text/html" {
					- "text/html"
				}
			}
			- " resources. Together, these rules define what is referred to as the\n  "
			dfn id="html-parser" data-export="" {
				- "HTML parser"
			}
			- "."
		}
		- "\n\n  "
		div class="note" {
			- "\n\n   "
			p {
				- "While the HTML syntax described in this specification bears a close resemblance to SGML and\n   XML, it is a separate language with its own parsing rules."
			}
			- "\n\n   "
			p {
				- "Some earlier versions of HTML (in particular from HTML2 to HTML4) were based on SGML and used\n   SGML parsing rules. However, few (if any) web browsers ever implemented true SGML parsing for\n   HTML documents; the only user agents to strictly handle HTML as an SGML application have\n   historically been validators. The resulting confusion — with validators claiming documents\n   to have one representation while widely deployed web browsers interoperably implemented a\n   different representation — has wasted decades of productivity. This version of HTML thus\n   returns to a non-SGML basis."
			}
			- "\n\n   "
			p {
				- "Authors interested in using SGML tools in their authoring pipeline are encouraged to use XML\n   tools and the XML serialization of HTML."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "For the purposes of conformance checkers, if a resource is determined to be in "
			a href="#syntax" id="parsing:syntax" {
				- "the HTML\n  syntax"
			}
			- ", then it is an "
			a href="https://dom.spec.whatwg.org/#html-document" id="parsing:html-documents" data-x-internal="html-documents" {
				- "HTML document"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "As stated "
			a href="#html-elements" id="parsing:html-elements" {
				- "in the terminology section"
			}
			- ",\n  references to "
			a href="#element-type" id="parsing:element-type" {
				- "element types"
			}
			- " that do not explicitly specify a\n  namespace always refer to elements in the "
			a id="parsing:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
				- "HTML namespace"
			}
			- ". For example, if the spec\n  talks about \"a "
			code id="parsing:the-menu-element" {
				a href="#the-menu-element" {
					- "menu"
				}
			}
			- " element\", then that is an element with the local name \""
			code {
				- "menu"
			}
			- "\", the namespace \""
			code {
				- "http://www.w3.org/1999/xhtml"
			}
			- "\", and\n  the interface "
			code id="parsing:htmlmenuelement" {
				a href="#htmlmenuelement" {
					- "HTMLMenuElement"
				}
			}
			- ". Where possible, references to such elements are\n  hyperlinked to their definition."
		}
		- "\n\n  \n\n\n  \n\n  "
		h4 id="overview-of-the-parsing-model" {
			span class="secno" {
				- "13.2.1"
			}
			- " Overview of the parsing model"
			a href="#overview-of-the-parsing-model" class="self-link"
		}
		- "\n\n  "
		p class="overview" {
			img class="darkmode-aware" src="/images/parsing-model-overview.svg" width="345" alt="" height="535"
		}
		- "\n\n  "
		p {
			- "The input to the HTML parsing process consists of a stream of "
			a href="https://infra.spec.whatwg.org/#code-point" id="overview-of-the-parsing-model:code-point" data-x-internal="code-point" {
				- "code\n  points"
			}
			- ", which is passed through a "
			a href="#tokenization" id="overview-of-the-parsing-model:tokenization" {
				- "tokenization"
			}
			- " stage followed by a "
			a href="#tree-construction" id="overview-of-the-parsing-model:tree-construction" {
				- "tree\n  construction"
			}
			- " stage. The output is a "
			code id="overview-of-the-parsing-model:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " object."
		}
		- "\n\n  "
		p class="note" {
			- "Implementations that "
			a href="#non-scripted" {
				- "do not support scripting"
			}
			- " do not\n  have to actually create a DOM "
			code id="overview-of-the-parsing-model:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " object, but the DOM tree in such cases is\n  still used as the model for the rest of the specification."
		}
		- "\n\n  "
		p {
			- "In the common case, the data handled by the tokenization stage comes from the network, but\n  "
			a href="#dynamic-markup-insertion" id="overview-of-the-parsing-model:dynamic-markup-insertion" {
				- "it can also come from script"
			}
			- " running in the user\n  agent, e.g. using the "
			code id="overview-of-the-parsing-model:dom-document-write" {
				a href="#dom-document-write" {
					- "document.write()"
				}
			}
			- " API."
		}
		- "\n\n  "
		p id="nestedParsing" {
			- "There is only one set of states for the tokenizer stage and the tree\n  construction stage, but the tree construction stage is reentrant, meaning that while the tree\n  construction stage is handling one token, the tokenizer might be resumed, causing further tokens\n  to be emitted and processed before the first token's processing is complete."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In the following example, the tree construction stage will be called upon to handle a \"p\"\n   start tag token while handling the \"script\" end tag token:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					- "...\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n document"
					c- p="" {
						- "."
					}
					- "write"
					c- p="" {
						- "("
					}
					c- t="" {
						- "'<p>'"
					}
					c- p="" {
						- ");"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n..."
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "To handle these cases, parsers have a "
			dfn id="script-nesting-level" {
				- "script nesting level"
			}
			- ", which must be initially\n  set to zero, and a "
			dfn id="parser-pause-flag" {
				- "parser pause flag"
			}
			- ", which must be initially set to false."
		}
		- "\n\n  \n\n\n\n  \n\n  "
		h4 id="parse-errors" {
			span class="secno" {
				- "13.2.2"
			}
			- " "
			dfn {
				- "Parse errors"
			}
			a href="#parse-errors" class="self-link"
		}
		- "\n\n  "
		p {
			- "This specification defines the parsing rules for HTML documents, whether they are syntactically\n  correct or not. Certain points in the parsing algorithm are said to be "
			a href="#parse-errors" id="parse-errors:parse-errors" {
				- "parse errors"
			}
			- ". The error handling for parse errors is well-defined (that's the\n  processing rules described throughout this specification), but user agents, while parsing an HTML\n  document, may "
			a href="#abort-a-parser" id="parse-errors:abort-a-parser" {
				- "abort the parser"
			}
			- " at the first "
			a href="#parse-errors" id="parse-errors:parse-errors-2" {
				- "parse\n  error"
			}
			- " that they encounter for which they do not wish to apply the rules described in this\n  specification."
		}
		- "\n\n  "
		p {
			- "Conformance checkers must report at least one parse error condition to the user if one or more\n  parse error conditions exist in the document and must not report parse error conditions if none\n  exist in the document. Conformance checkers may report more than one parse error condition if more\n  than one parse error condition exists in the document."
		}
		- "\n\n  "
		p class="note" {
			- "Parse errors are only errors with the "
			em {
				- "syntax"
			}
			- " of HTML. In addition to\n  checking for parse errors, conformance checkers will also verify that the document obeys all the\n  other conformance requirements described in this specification."
		}
		- "\n\n  "
		p {
			- "Some parse errors have dedicated codes outlined in the table below that should be used by\n  conformance checkers in reports."
		}
		- "\n\n  "
		p {
			i {
				- "Error descriptions in the table below are non-normative."
			}
		}
		- "\n\n  "
		table class="parse-error-table" {
			thead {
				tr {
					th {
						- "Code\n     "
					}
					th {
						- "Description\n    "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn id="parse-error-abrupt-closing-of-empty-comment" {
							- "abrupt-closing-of-empty-comment"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters an empty "
							a href="#syntax-comments" id="parse-errors:syntax-comments" {
								- "comment"
							}
							- " that is abruptly closed by a U+003E (>) "
							a id="parse-errors:code-point" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code\n     point"
							}
							- " (i.e., "
							code {
								- "<!-->"
							}
							- " or "
							code {
								- "<!--->"
							}
							- "). The\n     parser behaves as if the comment is closed correctly."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-abrupt-doctype-public-identifier" {
							- "abrupt-doctype-public-identifier"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a U+003E (>) "
							a id="parse-errors:code-point-2" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " in the\n     "
							a href="#syntax-doctype" id="parse-errors:syntax-doctype" {
								- "DOCTYPE"
							}
							- " public identifier (e.g., "
							code {
								- "<!DOCTYPE html PUBLIC \"foo>"
							}
							- "). In such a case, if the DOCTYPE is correctly\n     placed as a document preamble, the parser sets the "
							code id="parse-errors:document" {
								a href="#document" {
									- "Document"
								}
							}
							- " to "
							a id="parse-errors:quirks-mode" href="https://dom.spec.whatwg.org/#concept-document-quirks" data-x-internal="quirks-mode" {
								- "quirks\n     mode"
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-abrupt-doctype-system-identifier" {
							- "abrupt-doctype-system-identifier"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a U+003E (>) "
							a id="parse-errors:code-point-3" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " in the\n     "
							a href="#syntax-doctype" id="parse-errors:syntax-doctype-2" {
								- "DOCTYPE"
							}
							- " system identifier (e.g., "
							code {
								- "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"foo>"
							}
							- "). In such a case,\n     if the DOCTYPE is correctly placed as a document preamble, the parser sets the\n     "
							code id="parse-errors:document-2" {
								a href="#document" {
									- "Document"
								}
							}
							- " to "
							a id="parse-errors:quirks-mode-2" href="https://dom.spec.whatwg.org/#concept-document-quirks" data-x-internal="quirks-mode" {
								- "quirks mode"
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-absence-of-digits-in-numeric-character-reference" {
							- "absence-of-digits-in-numeric-character-reference"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a numeric "
							a href="#syntax-charref" id="parse-errors:syntax-charref" {
								- "character reference"
							}
							- " that doesn't contain any digits (e.g., "
							code {
								- "&#qux;"
							}
							- "). In this case the parser doesn't resolve the character\n     reference."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-cdata-in-html-content" {
							- "cdata-in-html-content"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a "
							a href="#syntax-cdata" id="parse-errors:syntax-cdata" {
								- "CDATA\n     section"
							}
							- " outside of foreign content (SVG or MathML). The parser treats such CDATA\n     sections (including leading \""
							code {
								- "[CDATA["
							}
							- "\" and trailing \""
							code {
								- "]]"
							}
							- "\" strings) as comments."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-character-reference-outside-unicode-range" {
							- "character-reference-outside-unicode-range"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a numeric "
							a href="#syntax-charref" id="parse-errors:syntax-charref-2" {
								- "character reference"
							}
							- " that references a "
							a id="parse-errors:code-point-4" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- "\n     that is greater than the valid Unicode range. The parser resolves such a character reference to\n     a U+FFFD REPLACEMENT CHARACTER."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-control-character-in-input-stream" {
							- "control-character-in-input-stream"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the "
							a href="#input-stream" id="parse-errors:input-stream" {
								- "input stream"
							}
							- " contains a "
							a href="https://infra.spec.whatwg.org/#control" id="parse-errors:control" data-x-internal="control" {
								- "control"
							}
							- " "
							a id="parse-errors:code-point-5" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " that is not "
							a id="parse-errors:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII\n     whitespace"
							}
							- " or U+0000 NULL. Such code points are parsed as-is and usually, where parsing\n     rules don't apply any additional restrictions, make their way into the DOM."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-control-character-reference" {
							- "control-character-reference"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters a numeric "
							a href="#syntax-charref" id="parse-errors:syntax-charref-3" {
								- "character reference"
							}
							- " that references a "
							a href="https://infra.spec.whatwg.org/#control" id="parse-errors:control-2" data-x-internal="control" {
								- "control"
							}
							- " "
							a id="parse-errors:code-point-6" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " that is not "
							a id="parse-errors:space-characters-2" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII\n     whitespace"
							}
							- " or is a U+000D CARRIAGE RETURN. The parser resolves such character references\n     as-is except C1 control references that are replaced according to the "
							a href="#numeric-character-reference-end-state" id="parse-errors:numeric-character-reference-end-state" {
								- "numeric character\n     reference end state"
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-duplicate-attribute" {
							- "duplicate-attribute"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters an "
							a href="#syntax-attributes" id="parse-errors:syntax-attributes" {
								- "attribute"
							}
							- " in a tag that already has an attribute with the\n     same name. The parser ignores all such duplicate occurrences of the attribute.\n\n    "
						}
					}
				}
				tr {
					td {
						dfn id="parse-error-end-tag-with-attributes" {
							- "end-tag-with-attributes"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters an "
							a href="#syntax-end-tag" id="parse-errors:syntax-end-tag" {
								- "end\n     tag"
							}
							- " with "
							a href="#syntax-attributes" id="parse-errors:syntax-attributes-2" {
								- "attributes"
							}
							- ". Attributes in end tags are\n     ignored and do not make their way into the DOM."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-end-tag-with-trailing-solidus" {
							- "end-tag-with-trailing-solidus"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters an "
							a href="#syntax-end-tag" id="parse-errors:syntax-end-tag-2" {
								- "end\n     tag"
							}
							- " that has a U+002F (/) "
							a id="parse-errors:code-point-7" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " right before the closing U+003E (>)\n     code point (e.g., "
							code {
								- "</div/>"
							}
							- "). Such a tag is treated as a regular end\n     tag."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-before-tag-name" {
							- "eof-before-tag-name"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters the end of the "
							a href="#input-stream" id="parse-errors:input-stream-2" {
								- "input stream"
							}
							- "\n     where a tag name is expected. In this case the parser treats the beginning of a "
							a href="#syntax-start-tag" id="parse-errors:syntax-start-tag" {
								- "start tag"
							}
							- " (i.e., "
							code {
								- "<"
							}
							- ") or an "
							a href="#syntax-end-tag" id="parse-errors:syntax-end-tag-3" {
								- "end tag"
							}
							- " (i.e., "
							code {
								- "</"
							}
							- ") as text\n     content."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-in-cdata" {
							- "eof-in-cdata"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters the end of the "
							a href="#input-stream" id="parse-errors:input-stream-3" {
								- "input stream"
							}
							- " in a\n     "
							a href="#syntax-cdata" id="parse-errors:syntax-cdata-2" {
								- "CDATA section"
							}
							- ". The parser treats such CDATA sections as if\n     they are closed immediately before the end of the input stream."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-in-comment" {
							- "eof-in-comment"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters the end of the "
							a href="#input-stream" id="parse-errors:input-stream-4" {
								- "input stream"
							}
							- " in a\n     "
							a href="#syntax-comments" id="parse-errors:syntax-comments-2" {
								- "comment"
							}
							- ". The parser treats such comments as if they are\n     closed immediately before the end of the input stream."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-in-doctype" {
							- "eof-in-doctype"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters the end of the input stream in a "
							a href="#syntax-doctype" id="parse-errors:syntax-doctype-3" {
								- "DOCTYPE"
							}
							- ". In such a case, if the DOCTYPE is correctly placed as a\n     document preamble, the parser sets the "
							code id="parse-errors:document-3" {
								a href="#document" {
									- "Document"
								}
							}
							- " to "
							a id="parse-errors:quirks-mode-3" href="https://dom.spec.whatwg.org/#concept-document-quirks" data-x-internal="quirks-mode" {
								- "quirks mode"
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-in-script-html-comment-like-text" {
							- "eof-in-script-html-comment-like-text"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters the end of the "
							a href="#input-stream" id="parse-errors:input-stream-5" {
								- "input stream"
							}
							- " in text\n      that resembles an "
							a href="#syntax-comments" id="parse-errors:syntax-comments-3" {
								- "HTML comment"
							}
							- " inside\n      "
							code id="parse-errors:the-script-element" {
								a href="#the-script-element" {
									- "script"
								}
							}
							- " element content (e.g., "
							code {
								- "<script><!-- foo"
							}
							- ")."
						}
						- "\n\n      "
						p class="note" {
							- "Syntactic structures that resemble HTML comments in "
							code id="parse-errors:the-script-element-2" {
								a href="#the-script-element" {
									- "script"
								}
							}
							- "\n      elements are parsed as text content. They can be a part of a scripting language-specific\n      syntactic structure or be treated as an HTML-like comment, if the scripting language supports\n      them (e.g., parsing rules for HTML-like comments can be found in Annex B of the JavaScript\n      specification). The common reason for this error is a violation of the "
							a href="#restrictions-for-contents-of-script-elements" id="parse-errors:restrictions-for-contents-of-script-elements" {
								- "restrictions for contents of "
								code {
									- "script"
								}
								- " elements"
							}
							- ". "
							a href="#refsJAVASCRIPT" {
								- "[JAVASCRIPT]"
							}
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-eof-in-tag" {
							- "eof-in-tag"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters the end of the "
							a href="#input-stream" id="parse-errors:input-stream-6" {
								- "input stream"
							}
							- " in a\n     "
							a href="#syntax-start-tag" id="parse-errors:syntax-start-tag-2" {
								- "start tag"
							}
							- " or an "
							a href="#syntax-end-tag" id="parse-errors:syntax-end-tag-4" {
								- "end\n     tag"
							}
							- " (e.g., "
							code {
								- "<div id="
