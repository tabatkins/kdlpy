						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "8+"
						}
					}
					hr
					span class="firefox_android yes" {
						span {
							- "Firefox Android"
						}
						span {
							- "6+"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android yes" {
						span {
							- "WebView Android"
						}
						span {
							- "37+"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "11+"
						}
					}
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_Storage_API/Using_the_Web_Storage_API" title="The Web Storage API provides mechanisms by which browsers can securely store key/value pairs." {
						- "Web_Storage_API/Using_the_Web_Storage_API"
					}
				}
			}
		}
		- "\n\n  "
		h3 id="introduction-15" {
			span class="secno" {
				- "12.1"
			}
			- " Introduction"
			a href="#introduction-15" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "This specification introduces two related mechanisms, similar to HTTP session cookies, for\n  storing name-value pairs on the client side. "
			a href="#refsCOOKIES" {
				- "[COOKIES]"
			}
		}
		- "\n\n  "
		p {
			- "The first is designed for scenarios where the user is carrying out a single transaction, but\n  could be carrying out multiple transactions in different windows at the same time."
		}
		- "\n\n  "
		p {
			- "Cookies don't really handle this case well. For example, a user could be buying plane tickets\n  in two different windows, using the same site. If the site used cookies to keep track of which\n  ticket the user was buying, then as the user clicked from page to page in both windows, the ticket\n  currently being purchased would \"leak\" from one window to the other, potentially causing the user\n  to buy two tickets for the same flight without noticing."
		}
		- "\n\n  "
		p {
			- "To address this, this specification introduces the "
			code id="introduction-15:dom-sessionstorage" {
				a href="#dom-sessionstorage" {
					- "sessionStorage"
				}
			}
			- " getter. Sites can add data to the session\n  storage, and it will be accessible to any page from the same site opened in that window."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "For example, a page could have a checkbox that the user ticks to\n   indicate that they want insurance:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "label"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"checkbox\""
					}
					- " "
					c- e="" {
						- "onchange"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"sessionStorage.insurance = checked ? 'true' : ''\""
					}
					c- p="" {
						- ">"
					}
					- "\n  I want insurance on this trip.\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "label"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "A later page could then check, from script, whether the user had checked the checkbox or\n   not:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					c- k="" {
						- "if"
					}
					- " "
					c- p="" {
						- "("
					}
					- "sessionStorage"
					c- p="" {
						- "."
					}
					- "insurance"
					c- p="" {
						- ")"
					}
					- " "
					c- p="" {
						- "{"
					}
					- " "
					c- p="" {
						- "..."
					}
					- " "
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "If the user had multiple windows opened on the site, each one would have its own individual\n   copy of the session storage object."
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		p {
			- "The second storage mechanism is designed for storage that spans multiple windows, and lasts\n  beyond the current session. In particular, web applications might wish to store megabytes of user\n  data, such as entire user-authored documents or a user's mailbox, on the client side for\n  performance reasons."
		}
		- "\n\n  "
		p {
			- "Again, cookies do not handle this case well, because they are transmitted with every\n  request."
		}
		- "\n\n  "
		p {
			- "The "
			code id="introduction-15:dom-localstorage" {
				a href="#dom-localstorage" {
					- "localStorage"
				}
			}
			- " getter is used to access a page's local\n  storage area."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The site at example.com can display a count of how many times the user has loaded its page by\n   putting the following at the bottom of its page:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n  You have viewed this page\n  "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "span"
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"count\""
					}
					c- p="" {
						- ">"
					}
					- "an untold number of"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "span"
					}
					c- p="" {
						- ">"
					}
					- "\n  time(s).\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
					- "\n  "
					c- k="" {
						- "if"
					}
					- " "
					c- p="" {
						- "("
					}
					c- o="" {
						- "!"
					}
					- "localStorage"
					c- p="" {
						- "."
					}
					- "pageLoadCount"
					c- p="" {
