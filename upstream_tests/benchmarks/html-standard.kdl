		}
		p {
			- "The "
			dfn data-dfn-for="output" id="attr-output-for" data-dfn-type="element-attr" {
				code {
					- "for"
				}
			}
			- " content\n  attribute allows an explicit relationship to be made between the result of a calculation and the\n  elements that represent the values that went into the calculation or that otherwise influenced the\n  calculation. The "
			code id="the-output-element:attr-output-for-2" {
				a href="#attr-output-for" {
					- "for"
				}
			}
			- " attribute, if specified, must contain a\n  string consisting of an "
			a href="#unordered-set-of-unique-space-separated-tokens" id="the-output-element:unordered-set-of-unique-space-separated-tokens" {
				- "unordered set of unique space-separated tokens"
			}
			- ", none of which\n  are "
			a id="the-output-element:identical-to" href="https://infra.spec.whatwg.org/#string-is" data-x-internal="identical-to" {
				- "identical to"
			}
			- " another token and each of which must have the value of an "
			a href="https://dom.spec.whatwg.org/#concept-id" id="the-output-element:concept-id" data-x-internal="concept-id" {
				- "ID"
			}
			- " of an element in the same "
			a id="the-output-element:tree" href="https://dom.spec.whatwg.org/#concept-tree" data-x-internal="tree" {
				- "tree"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-output-element:attr-fae-form-2" {
				a href="#attr-fae-form" {
					- "form"
				}
			}
			- " attribute is used to explicitly associate the\n  "
			code id="the-output-element:the-output-element-2" {
				a href="#the-output-element" {
					- "output"
				}
			}
			- " element with its "
			a href="#form-owner" id="the-output-element:form-owner" {
				- "form owner"
			}
			- ". The "
			code id="the-output-element:attr-fe-name-2" {
				a href="#attr-fe-name" {
					- "name"
				}
			}
			- " attribute represents the element's name. The "
			code id="the-output-element:the-output-element-3" {
				a href="#the-output-element" {
					- "output"
				}
			}
			- "\n  element is associated with a form so that it can be easily "
			a href="#referenced" id="the-output-element:referenced" {
				- "referenced"
			}
			- " from the event\n  handlers of form controls; the element's value itself is not submitted when the form is\n  submitted."
		}
		- "\n\n  \n\n  "
