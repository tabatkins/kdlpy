					- "Document"
				}
			}
			- "'s "
			code id="early-hints:the-head-element" {
				a href="#the-head-element" {
					- "head"
				}
			}
			- " element,\n  in respective order."
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "earlyPolicyContainer"
					}
