											}
											- " given the "
											a href="#media-element" id="loading-the-media-resource:media-element-37" {
												- "media element"
											}
											- " to\n         "
											a href="https://dom.spec.whatwg.org/#concept-event-fire" id="loading-the-media-resource:concept-event-fire-7" data-x-internal="concept-event-fire" {
												- "fire an event"
											}
											- " named "
