		- "\n\n\n\n\n  "
		h5 id="the-imagebitmap-rendering-context" {
			span class="secno" {
				- "4.12.5.2"
			}
			- " The "
			code id="the-imagebitmap-rendering-context:imagebitmap" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " rendering context"
			a href="#the-imagebitmap-rendering-context" class="self-link"
		}
		- "\n\n  "
		h6 id="introduction-6" {
			span class="secno" {
				- "4.12.5.2.1"
			}
			- " Introduction"
			a href="#introduction-6" class="self-link"
		}
		- "\n\n  "
		p {
			code id="introduction-6:imagebitmaprenderingcontext" {
				a href="#imagebitmaprenderingcontext" {
					- "ImageBitmapRenderingContext"
				}
			}
			- " is a performance-oriented interface that provides a\n  low overhead method for displaying the contents of "
			code id="introduction-6:imagebitmap" {
				a href="#imagebitmap" {
					- "ImageBitmap"
				}
			}
			- " objects. It uses\n  transfer semantics to reduce overall memory consumption. It also streamlines performance by\n  avoiding intermediate compositing, unlike the "
			code id="introduction-6:dom-context-2d-drawimage" {
				a href="#dom-context-2d-drawimage" {
					- "drawImage()"
				}
			}
			- " method of\n  "
			code id="introduction-6:canvasrenderingcontext2d" {
				a href="#canvasrenderingcontext2d" {
					- "CanvasRenderingContext2D"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Using an "
			code id="introduction-6:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element as an intermediate for getting an image resource into a\n  canvas, for example, would result in two copies of the decoded image existing in memory at the\n  same time: the "
			code id="introduction-6:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element's copy, and the one in the canvas's backing store. This\n  memory cost can be prohibitive when dealing with extremely large images. This can be avoided by\n  using "
			code id="introduction-6:imagebitmaprenderingcontext-2" {
				a href="#imagebitmaprenderingcontext" {
					- "ImageBitmapRenderingContext"
				}
			}
			- "."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Using "
				code id="introduction-6:imagebitmaprenderingcontext-3" {
					a href="#imagebitmaprenderingcontext" {
						- "ImageBitmapRenderingContext"
					}
				}
				- ", here is how to transcode an image to the JPEG\n   format in a memory- and CPU-efficient way:"
			}
			- "\n\n   "
			pre {
				code class="js" {
					- "createImageBitmap"
					c- p="" {
