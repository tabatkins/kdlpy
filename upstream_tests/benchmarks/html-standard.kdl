			li {
				- "\n    "
				p {
					- "Create a new "
					a href="#text-track" id="text-track-api:text-track-10" {
						- "text track"
					}
					- " corresponding to the new object, and set its "
					a href="#text-track-kind" id="text-track-api:text-track-kind-2" {
						- "text\n    track kind"
					}
					- " to "
					var {
						- "kind"
					}
					- ", its "
					a href="#text-track-label" id="text-track-api:text-track-label-2" {
						- "text track label"
					}
					- " to "
					var {
						- "label"
					}
					- ", its "
					a href="#text-track-language" id="text-track-api:text-track-language-2" {
						- "text track language"
					}
					- " to "
					var {
						- "language"
					}
					- ", its\n    "
