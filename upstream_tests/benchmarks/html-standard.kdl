						}
					}
					- " attribute of the "
					code id="non-conforming-features:the-object-element-3" {
						a href="#the-object-element" {
							- "object"
						}
					}
					- " element to set the\n   URL of the external resource."
				}
			}
			dt {
				dfn id="plaintext" data-dfn-type="element" {
					code {
						- "plaintext"
					}
				}
			}
			dd {
				p {
					- "Use the \""
					code id="non-conforming-features:text/plain" {
						a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
							- "text/plain"
						}
					}
					- "\" "
					a id="non-conforming-features:mime-type" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
						- "MIME type"
					}
					- " instead."
				}
			}
			dt {
				dfn id="rb" data-dfn-type="element" {
					code {
						- "rb"
					}
