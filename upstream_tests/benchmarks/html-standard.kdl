			- "The "
			dfn data-dfn-for="MediaError" id="dom-mediaerror-code" data-dfn-type="attribute" {
				code {
					- "code"
				}
			}
			- "\n  getter steps are to return "
			a id="error-codes:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
				- "this"
			}
			- "'s "
			a href="#concept-mediaerror-code" id="error-codes:concept-mediaerror-code-2" {
				- "code"
			}
