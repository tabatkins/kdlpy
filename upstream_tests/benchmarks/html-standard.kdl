		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The following attributes are obsolete (though the elements are still part of the language), and\n  must not be used by authors:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn data-dfn-for="a" id="attr-a-charset" data-dfn-type="element-attr" {
					code {
						- "charset"
					}
				}
				- " on "
				code id="non-conforming-features:the-a-element" {
					a href="#the-a-element" {
						- "a"
					}
				}
				- " elements"
			}
			dt {
				dfn data-dfn-for="link" id="attr-link-charset" data-dfn-type="element-attr" {
					code {
						- "charset"
					}
				}
				- " on "
				code id="non-conforming-features:the-link-element" {
					a href="#the-link-element" {
						- "link"
					}
				}
				- " elements"
			}
			dd {
				p {
					- "Use an HTTP `"
					code id="non-conforming-features:content-type" {
						a href="#content-type" {
							- "Content-Type"
						}
					}
					- "` header on the linked resource instead."
				}
			}
			dt {
				dfn data-dfn-for="script" id="attr-script-charset" data-dfn-type="element-attr" {
					code {
						- "charset"
					}
				}
				- " on "
				code id="non-conforming-features:the-script-element" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- "\n   elements (except as noted in the previous section)"
			}
			dd {
				p {
					- "Omit the attribute. Both documents and scripts are required to use "
					a id="non-conforming-features:utf-8" href="https://encoding.spec.whatwg.org/#utf-8" data-x-internal="utf-8" {
						- "UTF-8"
					}
					- ", so\n   it is redundant to specify it on the "
					code id="non-conforming-features:the-script-element-2" {
						a href="#the-script-element" {
							- "script"
						}
					}
					- " element since it inherits from the\n   document."
				}
			}
			dt {
				dfn data-dfn-for="a" id="attr-a-coords" data-dfn-type="element-attr" {
					code {
						- "coords"
					}
				}
				- " on "
				code id="non-conforming-features:the-a-element-2" {
