						a id="navigate-event-firing:javascript-execution-context-stack-2" href="https://tc39.es/ecma262/#execution-context-stack" data-x-internal="javascript-execution-context-stack" {
							- "JavaScript execution context\n     stack"
						}
						- " (e.g., because the navigation was user-initiated) or with a nonempty one (e.g.,\n     because the navigation was caused by a JavaScript API call)."
