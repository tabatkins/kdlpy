					c- p="" {
						- "</"
					}
					c- f="" {
						- "h1"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "In the following example, a rating is shown as three filled stars and two empty stars. While\n   the alternative text could have been \"★★★☆☆\", the author has\n   instead decided to more helpfully give the rating in the form \"3 out of 5\". That is the\n   alternative text of the first image, and the rest have blank alternative text."
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "Rating: "
					c- p="" {
