			}
			- ". However, it was never widely adopted."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Two "
			a href="#concept-origin" id="origin:concept-origin-5" {
				- "origins"
			}
			- ", "
			var {
				- "A"
			}
			- " and "
			var {
				- "B"
			}
			- ", are said to be "
			dfn id="same-origin" data-export="" {
				- "same origin"
			}
			- " if the following algorithm returns true:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "A"
					}
					- " and "
					var {
						- "B"
					}
					- " are the same "
					a href="#concept-origin-opaque" id="origin:concept-origin-opaque-3" {
						- "opaque\n   origin"
