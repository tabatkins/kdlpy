			- " attribute). Since the element was not in the parser's\n  "
			code id="the-execution-of-scripts-that-are-moving-across-multiple-documents:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " when it was created, that external script is not even downloaded."
		}
		- "\n\n  "
		p {
			- "In a case where a "
			code id="the-execution-of-scripts-that-are-moving-across-multiple-documents:the-script-element-2" {
				a href="#the-script-element" {
					- "script"
				}
