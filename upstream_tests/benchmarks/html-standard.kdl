							}
							- "'s "
							a href="#concept-workerglobalscope-policy-container" id="script-settings-for-workers:concept-workerglobalscope-policy-container" {
								- "policy container"
							}
							- "."
						}
						- "\n     "
					}
					dt {
						- "The "
						a href="#concept-settings-object-cross-origin-isolated-capability" id="script-settings-for-workers:concept-settings-object-cross-origin-isolated-capability" {
							- "cross-origin\n     isolated capability"
						}
					}
