							a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasGradient/addColorStop" title="The CanvasGradient.addColorStop() method adds a new color stop, defined by an offset and a color, to a given canvas gradient." {
								- "CanvasGradient/addColorStop"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
