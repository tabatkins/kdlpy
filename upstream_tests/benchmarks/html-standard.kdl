					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/datetime-local" title="<input> elements of type datetime-local create input controls that let the user easily enter both a date and a time, including the year, month, and day as well as the time in hours and minutes." {
						- "Element/input/datetime-local"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "93+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
