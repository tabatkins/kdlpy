								- "input"
							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"alt2421\""
							}
							c- p="" {
								- ">"
							}
							- "\n  "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "tr"
							}
							c- p="" {
								- ">"
							}
							- "\n   "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "td"
							}
							c- p="" {
								- ">"
							}
							- " "
							strong {
								c- p="" {
									- "<"
								}
								c- f="" {
									- "img"
								}
								- " "
								c- e="" {
									- "src"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "\"2422.png\""
								}
								- " "
								c- e="" {
									- "title"
								}
								c- o="" {
									- "="
								}
								c- s="" {
									- "\"Image 200 by 480, filename 'ad3.gif'\""
								}
								c- p="" {
									- ">"
								}
							}
							- "\n   "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "td"
							}
							c- p="" {
								- ">"
							}
							- " "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "input"
							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"alt2422\""
							}
							c- p="" {
								- ">"
							}
							- "\n"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "table"
							}
							c- p="" {
								- ">"
							}
						}
					}
					- "\n\n     "
					p {
						- "Notice that even in this example, as much useful information as possible is still included\n     in the "
						code id="a-key-part-of-the-content:attr-title-4" {
							a href="#attr-title" {
								- "title"
							}
						}
						- " attribute."
					}
					- "\n\n    "
				}
				- "\n\n    "
				p class="note" {
					- "Since some users cannot use images at all (e.g. because they have a very slow\n    connection, or because they are using a text-only browser, or because they are listening to the\n    page being read out by a hands-free automobile voice web browser, or simply because they are\n    blind), the "
					code id="a-key-part-of-the-content:attr-img-alt-5" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute is only allowed to be omitted rather\n    than being provided with replacement text when no alternative text is available and none can be\n    made available, as in the above examples. Lack of effort from the part of the author is not an\n    acceptable reason for omitting the "
					code id="a-key-part-of-the-content:attr-img-alt-6" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute."
				}
				- "\n   "
			}
		}
		- "\n\n\n\n  "
		h6 id="an-image-not-intended-for-the-user" {
			span class="secno" {
				- "4.8.4.4.12"
			}
			- " An image not intended for the user"
			a href="#an-image-not-intended-for-the-user" class="self-link"
		}
		- "\n\n  "
		p {
			- "Generally authors should avoid using "
			code id="an-image-not-intended-for-the-user:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements for purposes other than showing\n  images."
		}
		- "\n\n  "
		p {
			- "If an "
			code id="an-image-not-intended-for-the-user:the-img-element-2" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element is being used for purposes other than showing an image, e.g. as\n  part of a service to count page views, then the "
			code id="an-image-not-intended-for-the-user:attr-img-alt" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- " attribute\n  must be the empty string."
		}
		- "\n\n  "
		p {
			- "In such cases, the "
			code id="an-image-not-intended-for-the-user:attr-dim-width" {
				a href="#attr-dim-width" {
					- "width"
				}
			}
			- " and "
			code id="an-image-not-intended-for-the-user:attr-dim-height" {
				a href="#attr-dim-height" {
					- "height"
				}
			}
			- " attributes should both be set to zero."
		}
		- "\n\n\n  "
		h6 id="an-image-in-an-e-mail-or-private-document-intended-for-a-specific-person-who-is-known-to-be-able-to-view-images" {
			span class="secno" {
				- "4.8.4.4.13"
			}
			- " An image in an email or private document intended for a specific person who is known to be able to view images"
			a href="#an-image-in-an-e-mail-or-private-document-intended-for-a-specific-person-who-is-known-to-be-able-to-view-images" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section does not apply to documents that are publicly accessible, or whose target\n  audience is not necessarily personally known to the author, such as documents on a web site,\n  emails sent to public mailing lists, or software documentation."
			}
		}
		- "\n\n  "
		p {
			- "When an image is included in a private communication (such as an HTML email) aimed at a\n  specific person who is known to be able to view images, the "
			code id="an-image-in-an-e-mail-or-private-document-intended-for-a-specific-person-who-is-known-to-be-able-to-view-images:attr-img-alt" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- "\n  attribute may be omitted. However, even in such cases authors are strongly urged to include\n  alternative text (as appropriate according to the kind of image involved, as described in the\n  above entries), so that the email is still usable should the user use a mail client that does not\n  support images, or should the document be forwarded on to other users whose abilities might not\n  include easily seeing images."
		}
		- "\n\n\n\n\n  \n\n  "
		h6 id="guidance-for-markup-generators" {
			span class="secno" {
				- "4.8.4.4.14"
			}
			- " Guidance for markup generators"
			a href="#guidance-for-markup-generators" class="self-link"
		}
		- "\n\n  "
		p {
			- "Markup generators (such as WYSIWYG authoring tools) should, wherever possible, obtain\n  alternative text from their users. However, it is recognized that in many cases, this will not be\n  possible."
		}
		- "\n\n  "
		p {
			- "For images that are the sole contents of links, markup generators should examine the link\n  target to determine the title of the target, or the URL of the target, and use information\n  obtained in this manner as the alternative text."
		}
		- "\n\n  "
		p {
			- "For images that have captions, markup generators should use the "
			code id="guidance-for-markup-generators:the-figure-element" {
				a href="#the-figure-element" {
					- "figure"
				}
			}
			- " and\n  "
			code id="guidance-for-markup-generators:the-figcaption-element" {
				a href="#the-figcaption-element" {
					- "figcaption"
				}
			}
			- " elements, or the "
			code id="guidance-for-markup-generators:attr-title" {
				a href="#attr-title" {
					- "title"
				}
			}
			- " attribute, to\n  provide the image's caption."
		}
		- "\n\n  "
		p {
			- "As a last resort, implementers should either set the "
			code id="guidance-for-markup-generators:attr-img-alt" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- "\n  attribute to the empty string, under the assumption that the image is a purely decorative image\n  that doesn't add any information but is still specific to the surrounding content, or omit the\n  "
			code id="guidance-for-markup-generators:attr-img-alt-2" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- " attribute altogether, under the assumption that the image is\n  a key part of the content."
		}
		- "\n\n  "
		p {
			- "Markup generators may specify a "
			dfn id="attr-img-generator-unable-to-provide-required-alt" {
				code {
					- "generator-unable-to-provide-required-alt"
				}
			}
			- "\n  attribute on "
			code id="guidance-for-markup-generators:the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements for which they have been unable to obtain alternative text\n  and for which they have therefore omitted the "
			code id="guidance-for-markup-generators:attr-img-alt-3" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- " attribute. The\n  value of this attribute must be the empty string. Documents containing such attributes are not\n  conforming, but conformance checkers will "
			a href="#guidance-for-conformance-checkers" {
				- "silently\n  ignore"
			}
			- " this error."
		}
		- "\n\n  "
		p class="note" {
			- "This is intended to avoid markup generators from being pressured into replacing\n  the error of omitting the "
			code id="guidance-for-markup-generators:attr-img-alt-4" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- " attribute with the even more\n  egregious error of providing phony alternative text, because state-of-the-art automated\n  conformance checkers cannot distinguish phony alternative text from correct alternative text."
		}
		- "\n\n  "
		p {
			- "Markup generators should generally avoid using the image's own filename as the alternative\n  text. Similarly, markup generators should avoid generating alternative text from any content that\n  will be equally available to presentation user agents (e.g., web browsers)."
		}
		- "\n\n  "
		p class="note" {
			- "This is because once a page is generated, it will typically not be updated,\n  whereas the browsers that later read the page can be updated by the user, therefore the browser is\n  likely to have more up-to-date and finely-tuned heuristics than the markup generator did when\n  generating the page."
		}
		- "\n\n  \n\n  \n\n  "
		h6 id="guidance-for-conformance-checkers" {
			span class="secno" {
				- "4.8.4.4.15"
			}
			- " Guidance for conformance checkers"
			a href="#guidance-for-conformance-checkers" class="self-link"
		}
		- "\n\n  "
		p {
			- "A conformance checker must report the lack of an "
			code id="guidance-for-conformance-checkers:attr-img-alt" {
				a href="#attr-img-alt" {
					- "alt"
				}
			}
			- "\n  attribute as an error unless one of the conditions listed below applies:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "The "
					code id="guidance-for-conformance-checkers:the-img-element" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element is in a "
					code id="guidance-for-conformance-checkers:the-figure-element" {
						a href="#the-figure-element" {
							- "figure"
						}
					}
					- " element that satisfies "
					a href="#figcaption-as-alt-condition" {
						- "the conditions described above"
					}
					- "."
				}
			}
			li {
				p {
					- "The "
					code id="guidance-for-conformance-checkers:the-img-element-2" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element has a "
					code id="guidance-for-conformance-checkers:attr-title" {
						a href="#attr-title" {
							- "title"
						}
					}
					- " attribute with a\n   value that is not the empty string (also as "
					a href="#unknown-images" {
						- "described\n   above"
					}
					- ")."
				}
			}
			li {
				p {
					- "The conformance checker has been configured to assume that the document is an email or\n   document intended for a specific person who is known to be able to view images."
				}
			}
			li {
				p {
					- "The "
					code id="guidance-for-conformance-checkers:the-img-element-3" {
						a href="#the-img-element" {
							- "img"
						}
					}
					- " element has a (non-conforming) "
					code id="guidance-for-conformance-checkers:attr-img-generator-unable-to-provide-required-alt" {
						a href="#attr-img-generator-unable-to-provide-required-alt" {
							- "generator-unable-to-provide-required-alt"
						}
					}
					- "\n   attribute whose value is the empty string. A conformance checker that is not reporting the lack\n   of an "
					code id="guidance-for-conformance-checkers:attr-img-alt-2" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute as an error must also not report the\n   presence of the empty "
					code id="guidance-for-conformance-checkers:attr-img-generator-unable-to-provide-required-alt-2" {
						a href="#attr-img-generator-unable-to-provide-required-alt" {
							- "generator-unable-to-provide-required-alt"
						}
					}
					- "\n   attribute as an error. (This case does not represent a case where the document is conforming,\n   only that the generator could not determine appropriate alternative text — validators are\n   not required to show an error in this case, because such an error might encourage markup\n   generators to include bogus alternative text purely in an attempt to silence validators.\n   Naturally, conformance checkers "
					em {
						- "may"
					}
					- " report the lack of an "
					code id="guidance-for-conformance-checkers:attr-img-alt-3" {
						a href="#attr-img-alt" {
							- "alt"
						}
					}
					- " attribute as an error even in the presence of the "
					code id="guidance-for-conformance-checkers:attr-img-generator-unable-to-provide-required-alt-3" {
						a href="#attr-img-generator-unable-to-provide-required-alt" {
							- "generator-unable-to-provide-required-alt"
						}
					}
					- "\n   attribute; for example, there could be a user option to report "
					em {
						- "all"
					}
					- " conformance errors\n   even those that might be the more or less inevitable result of using a markup\n   generator.)"
				}
			}
		}
		- "\n\n  \n\n\n  "
		h4 id="the-iframe-element" {
			span class="secno" {
				- "4.8.5"
			}
			- " The\n  "
			dfn data-dfn-type="element" {
				code {
					- "iframe"
				}
			}
			- " element"
			a href="#the-iframe-element" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
