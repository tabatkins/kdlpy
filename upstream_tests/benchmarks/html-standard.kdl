				}
				- ";\n};"
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLModElement" id="dom-mod-cite" data-dfn-type="attribute" {
				code {
					- "cite"
				}
			}
			- " IDL\n  attribute must "
			a href="#reflect" id="attributes-common-to-ins-and-del-elements:reflect" {
				- "reflect"
			}
			- " the element's "
			code id="attributes-common-to-ins-and-del-elements:attr-mod-cite-2" {
				a href="#attr-mod-cite" {
					- "cite"
				}
			}
			- " content\n  attribute. The "
			dfn data-dfn-for="HTMLModElement" id="dom-mod-datetime" data-dfn-type="attribute" {
				code {
					- "dateTime"
				}
			}
			- " IDL attribute must "
			a href="#reflect" id="attributes-common-to-ins-and-del-elements:reflect-2" {
				- "reflect"
			}
			- " the\n  element's "
			code id="attributes-common-to-ins-and-del-elements:attr-mod-datetime-3" {
				a href="#attr-mod-datetime" {
					- "datetime"
				}
			}
			- " content attribute."
		}
		- "\n\n  \n\n\n\n  "
		h4 id="edits-and-paragraphs" {
			span class="secno" {
				- "4.7.4"
			}
			- " Edits and paragraphs"
			a href="#edits-and-paragraphs" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "Since the "
			code id="edits-and-paragraphs:the-ins-element" {
				a href="#the-ins-element" {
					- "ins"
				}
			}
			- " and "
			code id="edits-and-paragraphs:the-del-element" {
				a href="#the-del-element" {
					- "del"
				}
			}
			- " elements do not affect "
			a href="#paragraph" id="edits-and-paragraphs:paragraph" {
				- "paragraphing"
			}
			- ", it is possible, in some cases where paragraphs are "
			a href="#paragraph" id="edits-and-paragraphs:paragraph-2" {
				- "implied"
			}
			- " (without explicit "
			code id="edits-and-paragraphs:the-p-element" {
				a href="#the-p-element" {
					- "p"
				}
			}
			- " elements), for an\n  "
			code id="edits-and-paragraphs:the-ins-element-2" {
				a href="#the-ins-element" {
					- "ins"
				}
			}
			- " or "
			code id="edits-and-paragraphs:the-del-element-2" {
				a href="#the-del-element" {
					- "del"
				}
			}
			- " element to span both an entire paragraph or other\n  non-"
			a href="#phrasing-content-2" id="edits-and-paragraphs:phrasing-content-2" {
				- "phrasing content"
			}
			- " elements and part of another paragraph. For example:"
		}
		- "\n\n  "
		pre {
			code class="html" {
				c- p="" {
					- "<"
				}
				c- f="" {
					- "section"
				}
				c- p="" {
					- ">"
				}
				- "\n "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "ins"
				}
				c- p="" {
					- ">"
				}
				- "\n  "
				c- p="" {
					- "<"
				}
				c- f="" {
					- "p"
				}
				c- p="" {
					- ">"
				}
				- "\n   This is a paragraph that was inserted.\n  "
				c- p="" {
					- "</"
				}
				c- f="" {
					- "p"
				}
				c- p="" {
					- ">"
				}
				- "\n  This is another paragraph whose first sentence was inserted\n  at the same time as the paragraph above.\n "
				c- p="" {
					- "</"
				}
				c- f="" {
					- "ins"
				}
				c- p="" {
					- ">"
				}
				- "\n This is a second sentence, which was there all along.\n"
				c- p="" {
					- "</"
				}
				c- f="" {
					- "section"
				}
				c- p="" {
					- ">"
				}
			}
		}
		- "\n\n  "
		p {
			- "By only wrapping some paragraphs in "
			code id="edits-and-paragraphs:the-p-element-2" {
				a href="#the-p-element" {
					- "p"
				}
			}
			- " elements, one can even get the end of one\n  paragraph, a whole second paragraph, and the start of a third paragraph to be covered by the same\n  "
			code id="edits-and-paragraphs:the-ins-element-3" {
				a href="#the-ins-element" {
					- "ins"
				}
			}
