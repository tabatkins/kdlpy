							}
							- "'s "
							a href="#concept-workerglobalscope-url" id="script-settings-for-workers:concept-workerglobalscope-url-2" {
								- "url"
							}
							- "'s "
							a href="https://url.spec.whatwg.org/#concept-url-scheme" id="script-settings-for-workers:concept-url-scheme" data-x-internal="concept-url-scheme" {
								- "scheme"
							}
							- " is \""
							code {
								- "data"
							}
							- "\", and "
							var {
								- "inherited\n      origin"
							}
							- " otherwise."
						}
						- "\n     "
					}
					dt {
						- "The "
						a href="#concept-settings-object-policy-container" id="script-settings-for-workers:concept-settings-object-policy-container" {
							- "policy container"
						}
					}
					dd {
