		- "\n\n  "
		p {
			- "If the "
			a href="#text-track-mode" id="text-track-api:text-track-mode-7" {
				- "text track mode"
			}
			- " of the "
			a href="#text-track" id="text-track-api:text-track-21" {
				- "text track"
			}
			- " that the\n  "
			code id="text-track-api:texttrack-20" {
