			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="ImageBitmap" id="dom-imagebitmap-width" data-dfn-type="attribute" {
				code {
					- "width"
				}
			}
			- "\n  getter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a id="images-2:this-3" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#detached" id="images-2:detached-4" {
						- "[[Detached]]"
					}
					- " internal slot's value is true, then\n   return 0."
				}
			}
			li {
				p {
					- "Return "
					a id="images-2:this-4" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s width, in "
					a href="https://drafts.csswg.org/css-values/#px" id="images-2:'px'-4" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="ImageBitmap" id="dom-imagebitmap-height" data-dfn-type="attribute" {
				code {
					- "height"
				}
			}
			- "\n  getter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					a id="images-2:this-5" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#detached" id="images-2:detached-5" {
						- "[[Detached]]"
					}
					- " internal slot's value is true, then\n   return 0."
				}
			}
			li {
				p {
					- "Return "
					a id="images-2:this-6" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s height, in "
					a href="https://drafts.csswg.org/css-values/#px" id="images-2:'px'-5" data-x-internal="'px'" {
						- "CSS pixels"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="images-2:resizequality-2" {
				a href="#resizequality" {
					- "ResizeQuality"
				}
			}
			- " enumeration is used to express a preference for the\n  interpolation quality to use when scaling images."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ResizeQuality" id="dom-resizequality-pixelated" data-dfn-type="enum-value" {
				code {
					- "pixelated"
				}
			}
			- "\" value indicates a preference for\n  scaling the image to preserve the pixelation of the original as much as possible, with minor\n  smoothing as necessary to avoid distorting the image when the target size is not a clean multiple\n  of the original."
		}
		- "\n\n  "
		p {
			- "To implement \""
			code id="images-2:dom-resizequality-pixelated-2" {
				a href="#dom-resizequality-pixelated" {
					- "pixelated"
				}
			}
			- "\", for each axis\n  independently, first determine the integer multiple of its natural size that puts it closest to\n  the target size and is greater than zero. Scale it to this integer-multiple-size using nearest\n  neighbor, then scale it the rest of the way to the target size using bilinear interpolation."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ResizeQuality" id="dom-resizequality-low" data-dfn-type="enum-value" {
				code {
					- "low"
				}
			}
			- "\"\n  value indicates a preference for a low level of image interpolation quality. Low-quality image\n  interpolation may be more computationally efficient than higher settings."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ResizeQuality" id="dom-resizequality-medium" data-dfn-type="enum-value" {
				code {
					- "medium"
				}
			}
			- "\" value indicates a preference for a medium\n  level of image interpolation quality."
		}
		- "\n\n  "
		p {
			- "The \""
			dfn data-dfn-for="ResizeQuality" id="dom-resizequality-high" data-dfn-type="enum-value" {
				code {
					- "high"
				}
			}
			- "\" value indicates a preference for a high level\n  of image interpolation quality. High-quality image interpolation may be more computationally\n  expensive than lower settings."
		}
		- "\n\n  "
		p class="note" {
			- "Bilinear scaling is an example of a relatively fast, lower-quality image-smoothing\n  algorithm. Bicubic or Lanczos scaling are examples of image-scaling algorithms that produce\n  higher-quality output. This specification does not mandate that specific interpolation algorithms\n  be used, except for \""
			code id="images-2:dom-resizequality-pixelated-3" {
				a href="#dom-resizequality-pixelated" {
					- "pixelated"
				}
			}
			- "\" as described\n  above."
		}
