		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			code id="the-img-element:the-img-element-9" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element must not be used as a layout tool. In particular, "
			code id="the-img-element:the-img-element-10" {
				a href="#the-img-element" {
					- "img"
				}
