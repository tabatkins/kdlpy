					}
					- " "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "User agents are encouraged to allow users to disable scripting whenever the user is prompted\n  either by a script (e.g. using the "
			code id="killing-scripts:dom-alert" {
				a href="#dom-alert" {
					- "window.alert()"
				}
			}
			- " API) or because\n  of a script's actions (e.g. because it has exceeded a time limit)."
		}
		- "\n\n  "
		p {
			- "If scripting is disabled while a script is executing, the script should be terminated\n  immediately."
		}
		- "\n\n  "
		p {
			- "User agents may allow users to specifically disable scripts just for the purposes of closing a\n  "
			a href="#browsing-context" id="killing-scripts:browsing-context" {
