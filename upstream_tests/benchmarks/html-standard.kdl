						}
					}
					dd {
						- "\n      "
						p {
							- "Return "
							var {
								- "worker global scope"
							}
							- "'s "
							a href="#concept-workerglobalscope-url" id="script-settings-for-workers:concept-workerglobalscope-url" {
								- "url"
							}
							- "."
						}
						- "\n     "
					}
					dt {
						- "The "
						a href="#concept-settings-object-origin" id="script-settings-for-workers:concept-settings-object-origin-2" {
							- "origin"
						}
					}
					dd {
						- "\n      "
						p {
