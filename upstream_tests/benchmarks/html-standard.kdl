			}
			li {
				- "If "
				var {
					- "window"
				}
				- "'s "
				a href="#relevant-agent" id="simple-dialogs:relevant-agent" {
					- "relevant agent"
				}
				- "'s "
				a href="#concept-agent-event-loop" id="simple-dialogs:concept-agent-event-loop" {
