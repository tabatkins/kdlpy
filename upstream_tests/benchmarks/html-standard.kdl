		- "\n\n  "
		h4 id="unloading-documents" {
			span class="secno" {
				- "7.5.9"
			}
			- " Unloading documents"
			a href="#unloading-documents" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			code id="unloading-documents:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " has a "
			dfn id="concept-document-salvageable" {
				i {
					- "salvageable"
				}
			}
			- " state, which must initially be\n  true, and a "
			dfn id="page-showing" {
