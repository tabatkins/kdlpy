						- "agent cluster map"
					}
					- "["
					var {
						- "key"
					}
					- "] "
					a href="https://infra.spec.whatwg.org/#map-exists" id="integration-with-the-javascript-agent-cluster-formalism:map-exists-2" data-x-internal="map-exists" {
						- "does not exist"
					}
					- ", then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "agentCluster"
							}
							- " be a new "
							a id="integration-with-the-javascript-agent-cluster-formalism:agent-cluster-8" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
								- "agent cluster"
							}
							- "."
						}
					}
					li {
						p {
							- "Set "
							var {
								- "agentCluster"
							}
							- "'s "
							a href="#agent-cluster-cross-origin-isolation" id="integration-with-the-javascript-agent-cluster-formalism:agent-cluster-cross-origin-isolation" {
								- "cross-origin isolation mode"
							}
							- " to\n     "
							var {
								- "group"
							}
							- "'s "
							a href="#bcg-cross-origin-isolation" id="integration-with-the-javascript-agent-cluster-formalism:bcg-cross-origin-isolation-2" {
								- "cross-origin isolation\n     mode"
