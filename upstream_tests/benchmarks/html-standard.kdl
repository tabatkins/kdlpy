			}
			- " "
			dfn id="is-a-registrable-domain-suffix-of-or-is-equal-to" data-lt="is a registrable domain suffix of or is equal to|is not a registrable domain suffix of\n  and is not equal to" data-export="" {
				- "is a registrable domain suffix of or is equal to"
			}
			- " a "
			a href="https://url.spec.whatwg.org/#concept-host" id="relaxing-the-same-origin-restriction:concept-host" data-x-internal="concept-host" {
				- "host"
			}
