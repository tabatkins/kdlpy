			code id="the-embed-element:attr-embed-type-3" {
				a href="#attr-embed-type" {
					- "type"
				}
			}
			- " attribute must specify\n  the same type as the "
			a href="#content-type" id="the-embed-element:content-type" {
				- "explicit Content-Type metadata"
