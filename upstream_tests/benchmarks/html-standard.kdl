						- "Text"
					}
					- ", "
					a href="#text-(type=text)-state-and-search-state-(type=search)" id="persisted-user-state-restoration:text-(type=text)-state-and-search-state-(type=search)-2" {
						- "Search"
					}
					- ",\n    "
