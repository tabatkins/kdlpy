			}
		}
		- "\n\n  "
		table {
			caption {
				- "For \""
				code id="ongoing-navigation-tracking:dom-navigationtype-traverse-2" {
					a href="#dom-navigationtype-traverse" {
						- "traverse"
					}
				}
				- "\" navigations"
			}
			thead {
				tr {
					th {
						- "State\n     "
					}
					th {
						- "Duration\n     "
					}
					th {
						- "Explanation\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						- "Any "
