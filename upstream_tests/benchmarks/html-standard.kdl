		- "\n\n  "
		p id="concept-link-type-sniffing" {
			- "If the "
			a href="#external-resource-link" id="processing-the-type-attribute:external-resource-link-4" {
				- "external resource link"
			}
			- " type defines rules\n  for processing the resource's "
			a href="#content-type" id="processing-the-type-attribute:content-type" {
