		- "\n\n  "
		p {
			- "User agents may limit the number of state objects added to the session history per page. If a\n  page hits the "
			a id="the-history-interface:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " limit, user agents must remove the entry\n  immediately after the first entry for that "
			code id="the-history-interface:document-5" {
				a href="#document" {
					- "Document"
				}
			}
			- " object in the session history\n  after having added the new entry. (Thus the state history acts as a FIFO buffer for eviction, but\n  as a LIFO buffer for navigation.)"
		}
