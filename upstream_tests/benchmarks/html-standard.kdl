			}
			- "'s "
			a id="persisted-user-state-restoration:viewport" href="https://drafts.csswg.org/css2/#viewport" data-x-internal="viewport" {
				- "viewport"
			}
			- ", and all of "
			var {
				- "document"
			}
			- "'s scrollable\n  regions excepting any "
			a href="#navigable-container" id="persisted-user-state-restoration:navigable-container" {
				- "navigable containers"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			a href="#child-navigable" id="persisted-user-state-restoration:child-navigable" {
				- "Child navigable"
			}
			- " scroll restoration is handled as part of state\n  restoration for the "
			a href="#session-history-entry" id="persisted-user-state-restoration:session-history-entry-3" {
				- "session history entry"
			}
			- " for those "
			a href="#navigable" id="persisted-user-state-restoration:navigable" {
				- "navigables"
			}
			- "' "
			code id="persisted-user-state-restoration:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- "s."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="restore-scroll-position-data" {
				- "restore scroll position data"
			}
			- " given a "
			a href="#session-history-entry" id="persisted-user-state-restoration:session-history-entry-4" {
				- "session history entry"
			}
			- "\n  "
			var {
				- "entry"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "document"
					}
					- " be "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-document" id="persisted-user-state-restoration:she-document-4" {
						- "document"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "document"
					}
					- "'s "
					a href="#has-been-scrolled-by-the-user" id="persisted-user-state-restoration:has-been-scrolled-by-the-user-2" {
						- "has been scrolled by the user"
					}
					- " is true, then the\n   user agent should return."
				}
			}
			li {
				- "\n    "
				p {
					- "The user agent should attempt to use "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-scroll-position" id="persisted-user-state-restoration:she-scroll-position-2" {
						- "scroll position data"
					}
					- " to restore the scroll positions of\n    "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-document" id="persisted-user-state-restoration:she-document-5" {
						- "document"
					}
					- "'s "
					a href="#restorable-scrollable-regions" id="persisted-user-state-restoration:restorable-scrollable-regions-2" {
						- "restorable scrollable\n    regions"
					}
					- ". The user agent may continue to attempt to do so periodically, until\n    "
					var {
						- "document"
					}
					- "'s "
					a href="#has-been-scrolled-by-the-user" id="persisted-user-state-restoration:has-been-scrolled-by-the-user-3" {
						- "has been scrolled by the user"
					}
					- " becomes true."
				}
				- "\n\n    "
				p class="note" {
					- "This is formulated as an "
					em {
						- "attempt"
					}
					- ", which is potentially repeated until\n    success or until the user scrolls, due to the fact that relevant content indicated by the "
					a href="#she-scroll-position" id="persisted-user-state-restoration:she-scroll-position-3" {
						- "scroll position data"
					}
					- " might take some time to load from the\n    network."
				}
				- "\n\n    "
				p class="note" {
					- "Scroll restoration might be affected by scroll anchoring.\n    "
					a href="#refsCSSSCROLLANCHORING" {
						- "[CSSSCROLLANCHORING]"
					}
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h3 id="document-lifecycle" {
			span class="secno" {
				- "7.5"
			}
			- " Document lifecycle"
			a href="#document-lifecycle" class="self-link"
		}
		- "\n\n  "
		h4 id="shared-document-creation-infrastructure" {
			span class="secno" {
				- "7.5.1"
			}
			- " Shared document creation infrastructure"
			a href="#shared-document-creation-infrastructure" class="self-link"
		}
		- "\n\n  "
		p {
			- "When loading a document using one of the below algorithms, we use the\n  following steps to "
			dfn id="initialise-the-document-object" {
				- "create and initialize a "
				code {
					- "Document"
				}
				- " object"
			}
			- ",\n  given a "
			a href="https://dom.spec.whatwg.org/#concept-document-type" id="shared-document-creation-infrastructure:concept-document-type" data-x-internal="concept-document-type" {
				- "type"
			}
			- " "
			var {
				- "type"
			}
			- ", "
			a href="https://dom.spec.whatwg.org/#concept-document-content-type" id="shared-document-creation-infrastructure:concept-document-content-type" data-x-internal="concept-document-content-type" {
				- "content type"
			}
			- " "
			var {
				- "contentType"
			}
			- ", and\n  "
			a href="#navigation-params" id="shared-document-creation-infrastructure:navigation-params" {
				- "navigation params"
			}
			- " "
			var {
				- "navigationParams"
			}
			- ":"
		}
		- "\n\n  "
		p class="note" {
			code id="shared-document-creation-infrastructure:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " objects are also created when "
			a href="#creating-a-new-browsing-context" id="shared-document-creation-infrastructure:creating-a-new-browsing-context" {
				- "creating a new browsing\n  context and document"
			}
			- "; such "
			a href="#is-initial-about:blank" id="shared-document-creation-infrastructure:is-initial-about:blank" {
				- "initial\n  "
				code {
					- "about:blank"
				}
			}
			- " "
			code id="shared-document-creation-infrastructure:document-2" {
				a href="#document" {
					- "Document"
				}
			}
			- " are never created by this algorithm. Also,\n  "
			a href="#concept-document-bc" id="shared-document-creation-infrastructure:concept-document-bc" {
				- "browsing context"
			}
			- "-less "
			code id="shared-document-creation-infrastructure:document-3" {
				a href="#document" {
					- "Document"
				}
			}
			- " objects can\n  be created via various APIs, such as "
			code id="shared-document-creation-infrastructure:dom-domimplementation-createhtmldocument" {
				a data-x-internal="dom-domimplementation-createhtmldocument" href="https://dom.spec.whatwg.org/#dom-domimplementation-createhtmldocument" {
					- "document.implementation.createHTMLDocument()"
				}
			}
			- "."
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "browsingContext"
					}
					- " be the result of "
					a href="#obtain-browsing-context-navigation" id="shared-document-creation-infrastructure:obtain-browsing-context-navigation" {
						- "obtaining a browsing context to use for a\n    navigation response"
					}
					- " given "
					var {
						- "navigationParams"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This can result in a "
					a href="#browsing-context-group-switches-due-to-cross-origin-opener-policy" {
						- "browsing context\n    group switch"
					}
					- ", in which case "
					var {
						- "browsingContext"
					}
					- " will be a "
					a href="#creating-a-new-browsing-context" id="shared-document-creation-infrastructure:creating-a-new-browsing-context-2" {
						- "newly-created"
					}
					- " "
					a href="#browsing-context" id="shared-document-creation-infrastructure:browsing-context" {
						- "browsing context"
					}
					- " instead\n    of being "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="shared-document-creation-infrastructure:navigation-params-navigable" {
						- "navigable"
					}
					- "'s "
					a href="#nav-bc" id="shared-document-creation-infrastructure:nav-bc" {
						- "active browsing\n    context"
					}
					- ". In such a case, the created "
					code id="shared-document-creation-infrastructure:window" {
						a href="#window" {
							- "Window"
						}
					}
					- ", "
					code id="shared-document-creation-infrastructure:document-4" {
						a href="#document" {
							- "Document"
						}
					}
					- ", and\n    "
					a id="shared-document-creation-infrastructure:agent" href="https://tc39.es/ecma262/#sec-agents" data-x-internal="agent" {
						- "agent"
					}
					- " will not end up being used; because the created "
					code id="shared-document-creation-infrastructure:document-5" {
						a href="#document" {
							- "Document"
						}
					}
					- "'s\n    "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="shared-document-creation-infrastructure:concept-document-origin" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " is "
					a href="#concept-origin-opaque" id="shared-document-creation-infrastructure:concept-origin-opaque" {
						- "opaque"
					}
					- ", we will end up creating a new "
					a id="shared-document-creation-infrastructure:agent-2" href="https://tc39.es/ecma262/#sec-agents" data-x-internal="agent" {
						- "agent"
					}
					- "\n    and "
					code id="shared-document-creation-infrastructure:window-2" {
						a href="#window" {
							- "Window"
						}
					}
					- " "
					a href="#create-new-agent-and-window" {
						- "later in this algorithm"
					}
					- " to\n    go along with the new "
					code id="shared-document-creation-infrastructure:document-6" {
						a href="#document" {
							- "Document"
						}
					}
					- "."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Let "
					var {
						- "permissionsPolicy"
					}
					- " be the result of "
					a id="shared-document-creation-infrastructure:creating-a-permissions-policy-from-a-response" href="https://w3c.github.io/webappsec-feature-policy/#create-from-response" data-x-internal="creating-a-permissions-policy-from-a-response" {
						- "creating a permissions policy from a\n    response"
					}
					- " given "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-navigable" id="shared-document-creation-infrastructure:navigation-params-navigable-2" {
						- "navigable"
					}
					- "'s "
					a href="#nav-container" id="shared-document-creation-infrastructure:nav-container" {
						- "container"
					}
					- ", "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-origin" id="shared-document-creation-infrastructure:navigation-params-origin" {
						- "origin"
					}
					- ", and "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-response" id="shared-document-creation-infrastructure:navigation-params-response" {
						- "response"
					}
					- ". "
					a href="#refsPERMISSIONSPOLICY" {
						- "[PERMISSIONSPOLICY]"
					}
				}
				- "\n\n    "
				div class="note" {
					- "\n     "
					p {
						- "The "
						a id="shared-document-creation-infrastructure:creating-a-permissions-policy-from-a-response-2" href="https://w3c.github.io/webappsec-feature-policy/#create-from-response" data-x-internal="creating-a-permissions-policy-from-a-response" {
							- "creating a permissions policy from a response"
						}
						- " algorithm makes use of the\n     passed "
						a href="#concept-origin" id="shared-document-creation-infrastructure:concept-origin" {
							- "origin"
						}
						- ". If "
						code id="shared-document-creation-infrastructure:dom-document-domain" {
							a href="#dom-document-domain" {
								- "document.domain"
							}
						}
						- " has\n     been used for "
						var {
							- "navigationParams"
						}
						- "'s "
						a href="#navigation-params-navigable" id="shared-document-creation-infrastructure:navigation-params-navigable-3" {
							- "navigable"
						}
						- "'s "
						a href="#nav-container-document" id="shared-document-creation-infrastructure:nav-container-document" {
							- "container document"
						}
						- ", then its "
						a href="https://dom.spec.whatwg.org/#concept-document-origin" id="shared-document-creation-infrastructure:concept-document-origin-2" data-x-internal="concept-document-origin" {
							- "origin"
						}
						- " cannot be "
						a href="#same-origin-domain" id="shared-document-creation-infrastructure:same-origin-domain" {
							- "same origin-domain"
						}
						- " with\n     the passed origin, because these steps run before the "
						var {
							- "document"
						}
						- " is created, so it\n     cannot itself yet have used "
						code id="shared-document-creation-infrastructure:dom-document-domain-2" {
							a href="#dom-document-domain" {
								- "document.domain"
							}
						}
						- ". Note\n     that this means that Permissions Policy checks are less permissive compared to doing a\n     "
						a href="#same-origin" id="shared-document-creation-infrastructure:same-origin" {
							- "same origin"
						}
						- " check instead."
					}
					- "\n\n     "
					p {
						- "See below for some examples of this in action."
					}
					- "\n    "
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "creationURL"
					}
					- " be "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-response" id="shared-document-creation-infrastructure:navigation-params-response-2" {
						- "response"
					}
					- "'s "
					a href="https://fetch.spec.whatwg.org/#concept-response-url" id="shared-document-creation-infrastructure:concept-response-url" data-x-internal="concept-response-url" {
						- "URL"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-request" id="shared-document-creation-infrastructure:navigation-params-request" {
						- "request"
					}
					- "\n   is non-null, then set "
					var {
						- "creationURL"
					}
					- " to "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-request" id="shared-document-creation-infrastructure:navigation-params-request-2" {
						- "request"
					}
					- "'s "
					a href="https://fetch.spec.whatwg.org/#concept-request-current-url" id="shared-document-creation-infrastructure:concept-request-current-url" data-x-internal="concept-request-current-url" {
						- "current URL"
					}
					- "."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "window"
					}
					- " be null."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#active-document" id="shared-document-creation-infrastructure:active-document" {
						- "active document"
					}
					- "'s "
					a href="#is-initial-about:blank" id="shared-document-creation-infrastructure:is-initial-about:blank-2" {
						- "is initial\n    "
						code {
							- "about:blank"
						}
					}
					- " is true, and "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#active-document" id="shared-document-creation-infrastructure:active-document-2" {
						- "active\n    document"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-document-origin" id="shared-document-creation-infrastructure:concept-document-origin-3" data-x-internal="concept-document-origin" {
						- "origin"
					}
					- " is "
					a href="#same-origin-domain" id="shared-document-creation-infrastructure:same-origin-domain-2" {
						- "same\n    origin-domain"
					}
					- " with "
					var {
						- "navigationParams"
					}
					- "'s "
					a href="#navigation-params-origin" id="shared-document-creation-infrastructure:navigation-params-origin-2" {
						- "origin"
					}
					- ", then set "
					var {
						- "window"
					}
					- " to\n    "
					var {
						- "browsingContext"
					}
					- "'s "
					a href="#active-window" id="shared-document-creation-infrastructure:active-window" {
						- "active window"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "This means that both the "
					a href="#is-initial-about:blank" id="shared-document-creation-infrastructure:is-initial-about:blank-3" {
						- "initial\n    "
						code {
							- "about:blank"
						}
					}
					- " "
					code id="shared-document-creation-infrastructure:document-7" {
						a href="#document" {
							- "Document"
						}
					}
					- ", and the new "
					code id="shared-document-creation-infrastructure:document-8" {
						a href="#document" {
							- "Document"
						}
					}
					- " that\n    is about to be created, will share the same "
					code id="shared-document-creation-infrastructure:window-3" {
						a href="#window" {
							- "Window"
						}
					}
					- " object."
				}
				- "\n  "
			}
			li id="create-new-agent-and-window" {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Let "
							var {
								- "oacHeader"
							}
							- " be the result of "
							a id="shared-document-creation-infrastructure:getting-a-structured-field-value" href="https://fetch.spec.whatwg.org/#concept-header-list-get-structured-header" data-x-internal="getting-a-structured-field-value" {
								- "getting a structured field value"
							}
							- "\n     given `"
							code id="shared-document-creation-infrastructure:origin-agent-cluster" {
								a href="#origin-agent-cluster" {
									- "Origin-Agent-Cluster"
								}
							}
							- "` and \""
							code {
								- "item"
							}
							- "\" from\n     "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#navigation-params-response" id="shared-document-creation-infrastructure:navigation-params-response-3" {
								- "response"
							}
							- "'s\n     "
							a href="https://fetch.spec.whatwg.org/#concept-response-header-list" id="shared-document-creation-infrastructure:concept-response-header-list" data-x-internal="concept-response-header-list" {
								- "header list"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "requestsOAC"
							}
							- " be true if "
							var {
								- "oacHeader"
							}
							- " is not\n     null and "
							var {
								- "oacHeader"
							}
							- "[0] is the "
							a href="https://httpwg.org/specs/rfc8941.html#boolean" id="shared-document-creation-infrastructure:http-structured-header-boolean" data-x-internal="http-structured-header-boolean" {
								- "boolean"
							}
							- " true; otherwise false."
						}
					}
					li {
						p {
							- "If "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#navigation-params-reserved-environment" id="shared-document-creation-infrastructure:navigation-params-reserved-environment" {
								- "reserved environment"
							}
							- " is a\n     "
							a href="#non-secure-context" id="shared-document-creation-infrastructure:non-secure-context" {
								- "non-secure context"
							}
							- ", then set "
							var {
								- "requestsOAC"
							}
							- " to false."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "agent"
							}
							- " be the result of "
							a href="#obtain-similar-origin-window-agent" id="shared-document-creation-infrastructure:obtain-similar-origin-window-agent" {
								- "obtaining a similar-origin window agent"
							}
							- "\n     given "
							var {
								- "navigationParams"
							}
							- "'s "
							a href="#navigation-params-origin" id="shared-document-creation-infrastructure:navigation-params-origin-3" {
								- "origin"
							}
							- ",\n     "
							var {
								- "browsingContext"
							}
							- "'s "
							a href="#tlbc-group" id="shared-document-creation-infrastructure:tlbc-group" {
								- "group"
							}
							- ", and\n     "
							var {
								- "requestsOAC"
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Let "
							var {
								- "realmExecutionContext"
							}
							- " be the result of "
							a href="#creating-a-new-javascript-realm" id="shared-document-creation-infrastructure:creating-a-new-javascript-realm" {
								- "creating a new realm"
							}
							- "\n      given "
							var {
								- "agent"
							}
							- " and the following customizations:"
						}
						- "\n\n      "
						ul {
							li {
