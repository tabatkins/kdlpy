			a id="html-element-constructors:extended-attribute" href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" data-x-internal="extended-attribute" {
				- "extended attribute"
			}
			- ".  It indicates that the interface object for the given interface\n  will have a specific behavior when called, as defined in detail below."
		}
		- "\n\n  "
		p {
			- "The "
			code id="html-element-constructors:htmlconstructor" {
				a href="#htmlconstructor" {
					- "[HTMLConstructor]"
				}
			}
