											a href="#queue-a-global-task" id="worklets-worklet:queue-a-global-task-2" {
												- "Queue a global task"
											}
											- " on the "
											a href="#networking-task-source" id="worklets-worklet:networking-task-source-2" {
												- "networking task source"
											}
											- " given\n          "
											a id="worklets-worklet:this-10" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
												- "this"
											}
											- "'s "
											a href="#concept-relevant-global" id="worklets-worklet:concept-relevant-global" {
												- "relevant global object"
											}
											- " to perform the following\n          steps:"
										}
										- "\n\n          "
										ol {
											li {
												- "\n            "
												p {
													- "If "
													var {
														- "pendingTasks"
													}
													- " is not −1, then:"
												}
												- "\n\n            "
												ol {
													li {
														p {
															- "Set "
															var {
																- "pendingTasks"
															}
															- " to −1."
														}
													}
													li {
														p {
															- "Reject "
															var {
																- "promise"
															}
															- " with an "
															a id="worklets-worklet:aborterror-2" href="https://webidl.spec.whatwg.org/#aborterror" data-x-internal="aborterror" {
																- "\""
																code {
																	- "AbortError"
																}
																- "\""
															}
															- "\n             "
															code id="worklets-worklet:domexception-3" {
																a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
																	- "DOMException"
																}
															}
															- "."
														}
													}
												}
												- "\n           "
											}
										}
										- "\n         "
									}
									li {
										p {
											- "Abort these steps."
										}
									}
								}
								- "\n       "
							}
							li {
								- "\n        "
								p {
									- "If "
									var {
										- "script"
									}
									- "'s "
									a href="#concept-script-error-to-rethrow" id="worklets-worklet:concept-script-error-to-rethrow" {
										- "error to\n        rethrow"
									}
									- " is not null, then:"
								}
								- "\n\n        "
								ol {
									li {
										- "\n          "
										p {
											a href="#queue-a-global-task" id="worklets-worklet:queue-a-global-task-3" {
												- "Queue a global task"
											}
											- " on the "
											a href="#networking-task-source" id="worklets-worklet:networking-task-source-3" {
												- "networking task source"
											}
											- " given\n          "
											a id="worklets-worklet:this-11" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
												- "this"
											}
											- "'s "
											a href="#concept-relevant-global" id="worklets-worklet:concept-relevant-global-2" {
												- "relevant global object"
											}
											- " to perform the following\n          steps:"
										}
										- "\n\n          "
										ol {
											li {
												- "\n            "
												p {
													- "If "
													var {
														- "pendingTasks"
													}
													- " is not −1, then:"
												}
												- "\n\n            "
												ol {
													li {
														p {
															- "Set "
															var {
																- "pendingTasks"
															}
															- " to −1."
														}
													}
													li {
														p {
															- "Reject "
															var {
																- "promise"
															}
															- " with "
															var {
																- "script"
															}
															- "'s "
															a href="#concept-script-error-to-rethrow" id="worklets-worklet:concept-script-error-to-rethrow-2" {
																- "error to rethrow"
															}
															- "."
														}
													}
												}
												- "\n           "
											}
										}
										- "\n         "
									}
									li {
										p {
											- "Abort these steps."
										}
									}
								}
								- "\n       "
							}
							li {
								- "\n        "
								p {
									- "If "
									var {
										- "addedSuccessfully"
									}
									- " is false, then:"
								}
								- "\n\n        "
								ol {
									li {
										p {
											a href="https://infra.spec.whatwg.org/#list-append" id="worklets-worklet:list-append" data-x-internal="list-append" {
												- "Append"
											}
											- " "
											var {
												- "moduleURLRecord"
											}
											- " to\n         "
											a id="worklets-worklet:this-12" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
												- "this"
											}
											- "'s "
											a href="#concept-worklet-added-modules-list" id="worklets-worklet:concept-worklet-added-modules-list-2" {
												- "added modules\n         list"
											}
											- "."
										}
									}
									li {
										p {
											- "Set "
											var {
												- "addedSuccessfully"
											}
											- " to true."
										}
									}
								}
								- "\n       "
							}
							li {
								p {
									a href="#run-a-module-script" id="worklets-worklet:run-a-module-script" {
										- "Run a module script"
									}
									- " given "
									var {
										- "script"
									}
									- "."
								}
							}
							li {
								- "\n        "
								p {
									a href="#queue-a-global-task" id="worklets-worklet:queue-a-global-task-4" {
										- "Queue a global task"
									}
									- " on the\n        "
									a href="#networking-task-source" id="worklets-worklet:networking-task-source-4" {
										- "networking task source"
									}
									- " given "
									a id="worklets-worklet:this-13" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
										- "this"
									}
									- "'s "
									a href="#concept-relevant-global" id="worklets-worklet:concept-relevant-global-3" {
										- "relevant global\n        object"
									}
									- " to perform the following steps:"
								}
								- "\n\n        "
								ol {
									li {
										- "\n          "
										p {
											- "If "
											var {
												- "pendingTasks"
											}
											- " is not −1, then:"
										}
										- "\n\n          "
										ol {
											li {
												p {
													- "Set "
													var {
														- "pendingTasks"
													}
													- " to "
													var {
														- "pendingTasks"
													}
													- " − 1."
												}
											}
											li {
												p {
													- "If "
													var {
														- "pendingTasks"
													}
													- " is 0, then resolve "
													var {
														- "promise"
													}
													- "."
												}
