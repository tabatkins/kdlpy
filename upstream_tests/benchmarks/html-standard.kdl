			}
			- " of the "
			code id="the-canvas-element:the-canvas-element-20" {
				a href="#the-canvas-element" {
					- "canvas"
				}
			}
			- "\n  element is set to "
			a href="#concept-canvas-placeholder" id="the-canvas-element:concept-canvas-placeholder" {
