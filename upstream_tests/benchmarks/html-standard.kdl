		- "\n\n  "
		ol {
			li {
				p {
					a id="times:collect-a-sequence-of-code-points" href="https://infra.spec.whatwg.org/#collect-a-sequence-of-code-points" data-x-internal="collect-a-sequence-of-code-points" {
						- "Collect a sequence of code points"
					}
					- " that are "
					a id="times:ascii-digits-5" href="https://infra.spec.whatwg.org/#ascii-digit" data-x-internal="ascii-digits" {
						- "ASCII digits"
					}
					- " from\n   "
					var {
						- "input"
					}
					- " given "
					var {
						- "position"
					}
					- ". If the collected sequence is not exactly two\n   characters long, then fail. Otherwise, interpret the resulting sequence as a base-ten integer.\n   Let that number be the "
					var {
						- "hour"
					}
					- "."
				}
			}
			li {
				- "If "
				var {
					- "hour"
				}
				- " is not a number in the range 0 ≤ "
				var {
					- "hour"
				}
				- " ≤ 23, then fail."
			}
			li {
				p {
					- "If "
					var {
						- "position"
					}
					- " is beyond the end of "
					var {
						- "input"
					}
					- " or if the\n   character at "
					var {
						- "position"
					}
					- " is not a U+003A COLON character, then fail. Otherwise,\n   move "
					var {
						- "position"
