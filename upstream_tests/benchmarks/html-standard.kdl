		- "\n\n  "
		p class="note" {
			- "Many aspects of this state's behavior are similar to the behavior of the\n  "
			code id="image-button-state-(type=image):the-img-element" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " element. Readers are encouraged to read that section, where many of the same\n  requirements are described in more detail."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Take the following form:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "form"
					}
					- " "
					c- e="" {
						- "action"
					}
					c- o="" {
						- "="
					}
					c- s="" {
