		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "current"
					}
					- " be the "
					a href="#navigation-current-entry" id="the-history-entry-list:navigation-current-entry-2" {
						- "current entry"
					}
					- "\n   of "
					a id="the-history-entry-list:this-4" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "current"
					}
					- " is null, then throw an "
					a id="the-history-entry-list:invalidstateerror" href="https://webidl.spec.whatwg.org/#invalidstateerror" data-x-internal="invalidstateerror" {
						- "\""
						code {
