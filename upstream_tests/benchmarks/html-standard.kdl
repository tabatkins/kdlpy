		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLInputElement,HTMLSelectElement,HTMLTextAreaElement" id="dom-fe-autocomplete" data-dfn-type="attribute" {
				code {
					- "autocomplete"
				}
			}
			- " IDL attribute, on getting, must return the\n  element's "
			a href="#idl-exposed-autofill-value" id="autofill-processing-model:idl-exposed-autofill-value-5" {
				- "IDL-exposed autofill value"
			}
			- ", and on setting, must "
			a href="#reflect" id="autofill-processing-model:reflect" {
				- "reflect"
			}
			- " the\n  content attribute of the same name."
		}
		- "\n\n  \n\n\n  "
		h4 id="textFieldSelection" {
			span class="secno" {
				- "4.10.19"
			}
			- " APIs for the text control selections"
			a href="#textFieldSelection" class="self-link"
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="textFieldSelection:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " and "
			code id="textFieldSelection:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements define several attributes and methods\n  for handling their selection. Their shared algorithms are defined here."
		}
		- "\n\n  \n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "element"
					}
					- "."
					a href="#dom-textarea/input-select" id="dom-textarea/input-select-dev" {
						- "select"
					}
					- "()"
				}
			}
			dd {
				p {
					- "Selects everything in the text control."
				}
			}
			dt {
				code {
					var {
						- "element"
					}
					- "."
					a href="#dom-textarea/input-selectionstart" id="dom-textarea/input-selectionstart-dev" {
						- "selectionStart"
					}
					- " [ = "
					var {
						- "value"
					}
					- " ]"
				}
			}
			dd {
				- "\n    "
