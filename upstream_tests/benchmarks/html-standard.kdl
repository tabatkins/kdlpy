		div id="script-type-module-example-1" class="example" {
			- "\n\n   "
			p {
				- "The following sample shows how a "
				code id="the-script-element:the-script-element-16" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element can be used to include an\n   external "
				a href="#javascript-module-script" id="the-script-element:javascript-module-script-4" {
					- "JavaScript module script"
				}
				- ".\n\n   "
			}
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "script"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"module\""
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"app.mjs\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "script"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "This module, and all its dependencies (expressed through JavaScript "
				code {
					- "import"
				}
				- " statements in the source file), will be fetched. Once the entire\n   resulting module graph has been imported, and the document has finished parsing, the contents of\n   "
				code {
					- "app.mjs"
				}
				- " will be evaluated."
			}
			- "\n\n   "
			p {
				- "Additionally, if code from another "
				code id="the-script-element:the-script-element-17" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element in the same "
				code id="the-script-element:window" {
					a href="#window" {
						- "Window"
					}
				}
				- "\n   imports the module from "
				code {
					- "app.mjs"
				}
				- " (e.g. via "
				code {
					- "import\n   \"./app.mjs\";"
				}
				- "), then the same "
				a href="#javascript-module-script" id="the-script-element:javascript-module-script-5" {
					- "JavaScript module script"
				}
				- " created by the\n   former "
				code id="the-script-element:the-script-element-18" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element will be imported."
			}
			- "\n\n  "
		}
