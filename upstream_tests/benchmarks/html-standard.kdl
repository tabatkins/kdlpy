						- "><"
					}
					c- f="" {
						- "meta"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"name\""
					}
					- " "
					c- e="" {
						- "content"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"The Castle\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "span"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "<"
					}
					c- f="" {
						- "figure"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "img"
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"castle.jpeg\""
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "figcaption"
					}
					c- p="" {
						- ">"
					}
					- "The Castle (1986)"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "figcaption"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "figure"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "Both have a figure with a caption, and both, completely unrelated to the figure, have an item\n   with a name-value pair with the name \"name\" and the value \"The Castle\". The only difference is\n   that if the user drags the caption out of the document, in the former case, the item will be\n   included in the drag-and-drop data. In neither case is the image in any way associated with the\n   item."
			}
			- "\n\n  "
		}
		- "\n\n\n  "
		h4 id="typed-items" {
			span class="secno" {
				- "5.1.3"
			}
			- " Typed items"
			a href="#typed-items" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "The examples in the previous section show how information could be marked up on a page that\n  doesn't expect its microdata to be re-used. Microdata is most useful, though, when it is used in\n  contexts where other authors and readers are able to cooperate to make new uses of the markup."
		}
		- "\n\n  "
		p {
			- "For this purpose, it is necessary to give each "
			a href="#concept-item" id="typed-items:concept-item" {
				- "item"
			}
			- " a type,\n  such as \"https://example.com/person\", or \"https://example.org/cat\", or\n  \"https://band.example.net/\". Types are identified as "
			a href="https://url.spec.whatwg.org/#concept-url" id="typed-items:url" data-x-internal="url" {
				- "URLs"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The type for an "
			a href="#concept-item" id="typed-items:concept-item-2" {
				- "item"
			}
			- " is given as the value of an "
			code id="typed-items:attr-itemtype" {
				a href="#attr-itemtype" {
					- "itemtype"
				}
			}
			- " attribute on the same element as the "
			code id="typed-items:attr-itemscope" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Here, the item's type is \"https://example.org/animals#cat\":"
			}
			- "\n\n"
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "section"
					}
					- " "
					c- e="" {
						- "itemscope"
					}
					- " "
					c- e="" {
						- "itemtype"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://example.org/animals#cat\""
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "h1"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"name\""
					}
					c- p="" {
						- ">"
					}
					- "Hedral"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "h1"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"desc\""
					}
					c- p="" {
						- ">"
					}
					- "Hedral is a male american domestic\n shorthair, with a fluffy black fur with white paws and belly."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "img"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"img\""
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"hedral.jpeg\""
					}
					- " "
					c- e="" {
						- "alt"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"\""
					}
					- " "
					c- e="" {
						- "title"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"Hedral, age 18 months\""
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "section"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "In this example the \"https://example.org/animals#cat\" item has three properties, a \"name\"\n   (\"Hedral\"), a \"desc\" (\"Hedral is...\"), and an \"img\" (\"hedral.jpeg\")."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "The type gives the context for the properties, thus selecting a vocabulary: a property named\n  \"class\" given for an item with the type \"https://census.example/person\" might refer to the economic\n  class of an individual, while a property named \"class\" given for an item with the type\n  \"https://example.com/school/teacher\" might refer to the classroom a teacher has been assigned.\n  Several types can share a vocabulary. For example, the types \""
			code {
				- "https://example.org/people/teacher"
			}
			- "\" and \""
			code {
				- "https://example.org/people/engineer"
			}
			- "\" could be defined to use the same vocabulary\n  (though maybe some properties would not be especially useful in both cases, e.g. maybe the \""
			code {
				- "https://example.org/people/engineer"
			}
			- "\" type might not typically be used with the\n  \""
			code {
				- "classroom"
			}
			- "\" property). Multiple types defined to use the same vocabulary can\n  be given for a single item by listing the URLs as a space-separated list in the attribute' value.\n  An item cannot be given two types if they do not use the same vocabulary, however."
		}
		- "\n\n\n  "
		h4 id="global-identifiers-for-items" {
			span class="secno" {
				- "5.1.4"
			}
			- " Global identifiers for items"
			a href="#global-identifiers-for-items" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "Sometimes, an "
			a href="#concept-item" id="global-identifiers-for-items:concept-item" {
				- "item"
			}
			- " gives information about a topic that has a\n  global identifier. For example, books can be identified by their ISBN number."
		}
		- "\n\n  "
		p {
			- "Vocabularies (as identified by the "
			code id="global-identifiers-for-items:attr-itemtype" {
				a href="#attr-itemtype" {
					- "itemtype"
				}
			}
			- " attribute) can\n  be designed such that "
			a href="#concept-item" id="global-identifiers-for-items:concept-item-2" {
				- "items"
			}
			- " get associated with their global\n  identifier in an unambiguous way by expressing the global identifiers as "
			a href="https://url.spec.whatwg.org/#concept-url" id="global-identifiers-for-items:url" data-x-internal="url" {
				- "URLs"
			}
			- " given in an "
			code id="global-identifiers-for-items:attr-itemid" {
				a href="#attr-itemid" {
					- "itemid"
				}
			}
			- " attribute."
		}
		- "\n\n  "
		p {
			- "The exact meaning of the "
			a href="https://url.spec.whatwg.org/#concept-url" id="global-identifiers-for-items:url-2" data-x-internal="url" {
				- "URLs"
			}
			- " given in "
			code id="global-identifiers-for-items:attr-itemid-2" {
				a href="#attr-itemid" {
					- "itemid"
				}
			}
			- " attributes depends on the vocabulary used."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Here, an item is talking about a particular book:"
			}
			- "\n\n"
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dl"
					}
					- " "
					c- e="" {
						- "itemscope"
					}
					- "\n    "
					c- e="" {
						- "itemtype"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://vocab.example.net/book\""
					}
					- "\n    "
					strong {
						c- e="" {
							- "itemid"
						}
						c- o="" {
							- "="
						}
						c- s="" {
							- "\"urn:isbn:0-330-34032-8\""
						}
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dt"
					}
					c- p="" {
						- ">"
					}
					- "Title\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dd"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"title\""
					}
					c- p="" {
						- ">"
					}
					- "The Reality Dysfunction\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dt"
					}
					c- p="" {
						- ">"
					}
					- "Author\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dd"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"author\""
					}
					c- p="" {
						- ">"
					}
					- "Peter F. Hamilton\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dt"
					}
					c- p="" {
						- ">"
					}
					- "Publication date\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "dd"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "time"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"pubdate\""
					}
					- " "
					c- e="" {
						- "datetime"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"1996-01-26\""
					}
					c- p="" {
						- ">"
					}
					- "26 January 1996"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "time"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "dl"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "The \""
				code {
					- "https://vocab.example.net/book"
				}
				- "\" vocabulary in this example would\n   define that the "
				code id="global-identifiers-for-items:attr-itemid-3" {
					a href="#attr-itemid" {
						- "itemid"
					}
				}
				- " attribute takes a "
				code id="global-identifiers-for-items:urn-protocol" {
					a data-x-internal="urn-protocol" href="https://www.rfc-editor.org/rfc/rfc2141#section-2" {
						- "urn:"
					}
				}
				- " "
				a id="global-identifiers-for-items:url-3" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
					- "URL"
				}
				- " pointing to the ISBN of the book."
			}
			- "\n\n  "
		}
		- "\n\n  \n\n\n\n  "
		h4 id="selecting-names-when-defining-vocabularies" {
			span class="secno" {
				- "5.1.5"
			}
			- " Selecting names when defining vocabularies"
			a href="#selecting-names-when-defining-vocabularies" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "Using microdata means using a vocabulary. For some purposes, an ad-hoc vocabulary is adequate.\n  For others, a vocabulary will need to be designed. Where possible, authors are encouraged to\n  re-use existing vocabularies, as this makes content re-use easier."
		}
		- "\n\n  "
		p {
			- "When designing new vocabularies, identifiers can be created either using "
			a href="https://url.spec.whatwg.org/#concept-url" id="selecting-names-when-defining-vocabularies:url" data-x-internal="url" {
				- "URLs"
			}
			- ", or, for properties, as plain words (with no dots or colons). For URLs,\n  conflicts with other vocabularies can be avoided by only using identifiers that correspond to\n  pages that the author has control over."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "For instance, if Jon and Adam both write content at "
				code {
					- "example.com"
				}
				- ", at "
				code {
					- "https://example.com/~jon/..."
				}
				- " and "
				code {
					- "https://example.com/~adam/..."
				}
				- " respectively, then\n   they could select identifiers of the form\n   \"https://example.com/~jon/name\" and \"https://example.com/~adam/name\"\n   respectively."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "Properties whose names are just plain words can only be used within the context of the types\n  for which they are intended; properties named using URLs can be reused in items of any type. If an\n  item has no type, and is not part of another item, then if its properties have names that are just\n  plain words, they are not intended to be globally unique, and are instead only intended for\n  limited use. Generally speaking, authors are encouraged to use either properties with globally\n  unique names (URLs) or ensure that their items are typed."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Here, an item is an \"https://example.org/animals#cat\", and most of the properties have names\n   that are words defined in the context of that type. There are also a few additional properties\n   whose names come from other vocabularies."
			}
			- "\n\n"
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "section"
					}
					- " "
					c- e="" {
						- "itemscope"
					}
					- " "
					c- e="" {
						- "itemtype"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://example.org/animals#cat\""
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "h1"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"name https://example.com/fn\""
					}
					c- p="" {
						- ">"
					}
					- "Hedral"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "h1"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"desc\""
					}
					c- p="" {
						- ">"
					}
					- "Hedral is a male American domestic\n shorthair, with a fluffy "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "span"
					}
					- "\n "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://example.com/color\""
					}
					c- p="" {
						- ">"
					}
					- "black"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "span"
					}
					c- p="" {
						- ">"
					}
					- " fur with "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "span"
					}
					- "\n "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"https://example.com/color\""
					}
					c- p="" {
						- ">"
					}
					- "white"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "span"
					}
					c- p="" {
						- ">"
					}
					- " paws and belly."
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "img"
					}
					- " "
					c- e="" {
						- "itemprop"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"img\""
					}
					- " "
					c- e="" {
						- "src"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"hedral.jpeg\""
					}
					- " "
					c- e="" {
						- "alt"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"\""
					}
					- " "
					c- e="" {
						- "title"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"Hedral, age 18 months\""
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "section"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "This example has one item with the type \"https://example.org/animals#cat\" and the following\n   properties:"
			}
			- "\n\n   "
			table {
				thead {
					tr {
						td {
							- "Property\n      "
						}
						td {
							- "Value\n    "
						}
					}
				}
				tbody {
					tr {
						td {
							- "name\n      "
						}
						td {
							- "Hedral\n     "
						}
					}
					tr {
						td {
							- "https://example.com/fn\n      "
						}
						td {
							- "Hedral\n     "
						}
					}
					tr {
						td {
							- "desc\n      "
						}
						td {
							- "Hedral is a male American domestic shorthair, with a fluffy black fur with white paws and belly.\n     "
						}
					}
					tr {
						td {
							- "https://example.com/color\n      "
						}
						td {
							- "black\n     "
						}
					}
					tr {
						td {
							- "https://example.com/color\n      "
						}
						td {
							- "white\n     "
						}
					}
					tr {
						td {
							- "img\n      "
						}
						td {
							- ".../hedral.jpeg\n   "
						}
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n\n\n  "
		h3 id="encoding-microdata" {
			span class="secno" {
				- "5.2"
			}
			- " Encoding microdata"
			a href="#encoding-microdata" class="self-link"
		}
		- "\n\n\n  "
		h4 id="the-microdata-model" {
			span class="secno" {
				- "5.2.1"
			}
			- " The microdata model"
			a href="#the-microdata-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "The microdata model consists of groups of name-value pairs known as "
			a href="#concept-item" id="the-microdata-model:concept-item" {
				- "items"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Each group is known as an "
			a href="#concept-item" id="the-microdata-model:concept-item-2" {
				- "item"
			}
			- ". Each "
			a href="#concept-item" id="the-microdata-model:concept-item-3" {
				- "item"
			}
			- " can have "
			a href="#item-types" id="the-microdata-model:item-types" {
				- "item types"
			}
			- ", a "
			a href="#global-identifier" id="the-microdata-model:global-identifier" {
				- "global\n  identifier"
			}
			- " (if the vocabulary specified by the "
			a href="#item-types" id="the-microdata-model:item-types-2" {
				- "item types"
			}
			- " "
			a href="#support-global-identifiers-for-items" id="the-microdata-model:support-global-identifiers-for-items" {
				- "support global\n  identifiers for items"
			}
			- "), and a list of name-value pairs. Each name in the name-value pair is\n  known as a "
			a href="#the-properties-of-an-item" id="the-microdata-model:the-properties-of-an-item" {
				- "property"
			}
			- ", and each "
			a href="#the-properties-of-an-item" id="the-microdata-model:the-properties-of-an-item-2" {
				- "property"
			}
			- " has one or more "
			a href="#concept-property-value" id="the-microdata-model:concept-property-value" {
				- "values"
			}
			- ". Each "
			a href="#concept-property-value" id="the-microdata-model:concept-property-value-2" {
				- "value"
			}
			- " is either a string or itself a group of name-value\n  pairs (an "
			a href="#concept-item" id="the-microdata-model:concept-item-4" {
				- "item"
			}
			- "). The names are unordered relative to each other,\n  but if a particular name has multiple values, they do have a relative order."
		}
		- "\n\n\n\n  "
		h4 id="items" {
			span class="secno" {
				- "5.2.2"
			}
			- " Items"
			a href="#items" class="self-link"
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/itemscope" title="itemscope is a boolean global attribute that defines the scope of associated metadata. Specifying the itemscope attribute for an element creates a new item, which results in a number of name-value pairs that are associated with the element." {
						- "Global_attributes/itemscope"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "Yes"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "Yes"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "Every "
			a href="#html-elements" id="items:html-elements" {
				- "HTML element"
			}
			- " may have an "
			dfn data-dfn-for="html-global" id="attr-itemscope" data-dfn-type="element-attr" {
				code {
					- "itemscope"
				}
			}
			- " attribute specified. The\n  "
			code id="items:attr-itemscope" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute is a "
			a href="#boolean-attribute" id="items:boolean-attribute" {
				- "boolean attribute"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An element with the "
			code id="items:attr-itemscope-2" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute specified creates a\n  new "
			dfn id="concept-item" {
				- "item"
			}
			- ", a group of name-value pairs."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/itemtype" title="The global attribute itemtype specifies the URL of the vocabulary that will be used to define itemprop's (item properties) in the data structure." {
						- "Global_attributes/itemtype"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "Yes"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "Yes"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "Elements with an "
			code id="items:attr-itemscope-3" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute may have an "
			dfn data-dfn-for="html-global" id="attr-itemtype" data-dfn-type="element-attr" {
				code {
					- "itemtype"
				}
			}
			- " attribute\n  specified, to give the "
			a href="#item-types" id="items:item-types" {
				- "item types"
			}
			- " of the "
			a href="#concept-item" id="items:concept-item" {
				- "item"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			code id="items:attr-itemtype" {
				a href="#attr-itemtype" {
					- "itemtype"
				}
			}
			- " attribute, if specified, must have a value that\n  is an "
			a href="#unordered-set-of-unique-space-separated-tokens" id="items:unordered-set-of-unique-space-separated-tokens" {
				- "unordered set of unique space-separated tokens"
			}
			- ", none of which are\n  "
			a id="items:identical-to" href="https://infra.spec.whatwg.org/#string-is" data-x-internal="identical-to" {
				- "identical to"
			}
			- " another token and each of which is a "
			a id="items:valid-url-string" href="https://url.spec.whatwg.org/#valid-url-string" data-x-internal="valid-url-string" {
				- "valid URL string"
			}
			- " that\n  is an "
			a id="items:absolute-url" href="https://url.spec.whatwg.org/#syntax-url-absolute" data-x-internal="absolute-url" {
				- "absolute URL"
			}
			- ", and all of which are defined to use the same vocabulary. The\n  attribute's value must have at least one token."
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="item-types" {
				- "item types"
			}
			- " of an "
			a href="#concept-item" id="items:concept-item-2" {
				- "item"
			}
			- " are the tokens obtained\n  by "
			a href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id="items:split-a-string-on-spaces" data-x-internal="split-a-string-on-spaces" {
				- "splitting the element's "
				code {
					- "itemtype"
				}
				- " attribute's value on ASCII whitespace"
			}
			- ". If the "
			code id="items:attr-itemtype-2" {
				a href="#attr-itemtype" {
					- "itemtype"
				}
			}
			- " attribute is missing or parsing it in this way finds no\n  tokens, the "
			a href="#concept-item" id="items:concept-item-3" {
				- "item"
			}
			- " is said to have no "
			a href="#item-types" id="items:item-types-2" {
				- "item types"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#item-types" id="items:item-types-3" {
				- "item types"
			}
			- " must all be types defined in "
			a href="#other-applicable-specifications" id="items:other-applicable-specifications" {
				- "applicable specifications"
			}
			- " and must all be defined to use the same\n  vocabulary."
		}
		- "\n\n  \n\n   "
		p {
			- "Except if otherwise specified by that specification, the "
			a href="https://url.spec.whatwg.org/#concept-url" id="items:url" data-x-internal="url" {
				- "URLs"
			}
			- " given\n   as the "
			a href="#item-types" id="items:item-types-4" {
				- "item types"
			}
			- " should not be automatically dereferenced."
		}
		- "\n\n   "
		p class="note" {
			- "A specification could define that its "
			a href="#item-types" id="items:item-types-5" {
				- "item type"
			}
			- "\n   can be dereferenced to provide the user with help information, for example. In fact, vocabulary\n   authors are encouraged to provide useful information at the given "
			a id="items:url-2" href="https://url.spec.whatwg.org/#concept-url" data-x-internal="url" {
				- "URL"
			}
			- "."
		}
		- "\n\n   "
		p {
			a href="#item-types" id="items:item-types-6" {
				- "Item types"
			}
			- " are opaque identifiers, and user agents must not dereference unknown\n   "
			a href="#item-types" id="items:item-types-7" {
				- "item types"
			}
			- ", or otherwise deconstruct them, in order to determine how to process\n   "
			a href="#concept-item" id="items:concept-item-4" {
				- "items"
			}
			- " that use them."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="items:attr-itemtype-3" {
				a href="#attr-itemtype" {
					- "itemtype"
				}
			}
			- " attribute must not be specified on elements\n  that do not have an "
			code id="items:attr-itemscope-4" {
				a href="#attr-itemscope" {
					- "itemscope"
				}
			}
			- " attribute specified."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "An "
			a href="#concept-item" id="items:concept-item-5" {
				- "item"
			}
			- " is said to be a "
			dfn id="typed-item" {
				- "typed item"
			}
			- " when either it\n  has an "
			a href="#item-types" id="items:item-types-8" {
				- "item type"
			}
			- ", or it is the "
			a href="#concept-property-value" id="items:concept-property-value" {
				- "value"
			}
			- " of a "
			a href="#the-properties-of-an-item" id="items:the-properties-of-an-item" {
				- "property"
			}
			- " of a "
			a href="#typed-item" id="items:typed-item" {
				- "typed item"
			}
			- ". The "
			dfn id="relevant-types" {
				- "relevant types"
			}
			- " for a\n  "
			a href="#typed-item" id="items:typed-item-2" {
				- "typed item"
			}
			- " is the "
			a href="#concept-item" id="items:concept-item-6" {
				- "item"
			}
			- "'s "
			a href="#item-types" id="items:item-types-9" {
				- "item types"
			}
			- ",\n  if it has any, or else is the "
			a href="#relevant-types" id="items:relevant-types" {
				- "relevant types"
			}
			- " of the "
			a href="#concept-item" id="items:concept-item-7" {
				- "item"
			}
			- " for which it is a "
			a href="#the-properties-of-an-item" id="items:the-properties-of-an-item-2" {
				- "property"
			}
			- "'s "
			a href="#concept-property-value" id="items:concept-property-value-2" {
				- "value"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
