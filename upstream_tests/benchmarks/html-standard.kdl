						- "option"
					}
				}
				- " in the "
				a id="the-stack-of-open-elements:html-namespace-2-8" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
					- "HTML namespace"
				}
			}
		}
		- "\n\n  "
		p {
			- "Nothing happens if at any time any of the elements in the "
			a href="#stack-of-open-elements" id="the-stack-of-open-elements:stack-of-open-elements-14" {
				- "stack of open elements"
			}
			- "\n  are moved to a new location in, or removed from, the "
			code id="the-stack-of-open-elements:document" {
				a href="#document" {
					- "Document"
				}
			}
			- " tree. In particular,\n  the stack is not changed in this situation. This can cause, amongst other strange effects, content\n  to be appended to nodes that are no longer in the DOM."
		}
		- "\n\n  "
		p class="note" {
			- "In some cases (namely, when "
			a href="#adoptionAgency" {
				- "closing misnested formatting\n  elements"
			}
			- "), the stack is manipulated in a random-access fashion."
		}
		- "\n\n\n  "
		h5 id="the-list-of-active-formatting-elements" {
			span class="secno" {
				- "13.2.4.3"
			}
			- " The list of active formatting elements"
			a href="#the-list-of-active-formatting-elements" class="self-link"
		}
		- "\n\n  "
		p {
			- "Initially, the "
			dfn id="list-of-active-formatting-elements" {
				- "list of active formatting elements"
			}
			- " is empty. It is used to handle\n  mis-nested "
			a href="#formatting" id="the-list-of-active-formatting-elements:formatting" {
				- "formatting element tags"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The list contains elements in the "
			a href="#formatting" id="the-list-of-active-formatting-elements:formatting-2" {
				- "formatting"
			}
			- " category, and "
			a href="#concept-parser-marker" id="the-list-of-active-formatting-elements:concept-parser-marker" {
				- "markers"
			}
			- ". The "
			dfn id="concept-parser-marker" {
				- "markers"
			}
			- " are inserted when entering "
			code id="the-list-of-active-formatting-elements:applet" {
				a href="#applet" {
					- "applet"
				}
			}
			- ",\n  "
			code id="the-list-of-active-formatting-elements:the-object-element" {
				a href="#the-object-element" {
					- "object"
				}
			}
			- ", "
			code id="the-list-of-active-formatting-elements:the-marquee-element" {
				a href="#the-marquee-element" {
					- "marquee"
				}
			}
			- ", "
			code id="the-list-of-active-formatting-elements:the-template-element" {
				a href="#the-template-element" {
					- "template"
				}
			}
			- ", "
			code id="the-list-of-active-formatting-elements:the-td-element" {
				a href="#the-td-element" {
					- "td"
				}
			}
			- ",\n  "
			code id="the-list-of-active-formatting-elements:the-th-element" {
				a href="#the-th-element" {
					- "th"
				}
			}
			- ", and "
			code id="the-list-of-active-formatting-elements:the-caption-element" {
				a href="#the-caption-element" {
					- "caption"
				}
			}
			- " elements, and are used to prevent formatting from\n  \"leaking\" "
			em {
				- "into"
			}
			- " "
			code id="the-list-of-active-formatting-elements:applet-2" {
				a href="#applet" {
					- "applet"
				}
			}
			- ", "
			code id="the-list-of-active-formatting-elements:the-object-element-2" {
