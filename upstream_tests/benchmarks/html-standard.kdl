					code {
						- "keywords"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "The value must be a "
					a href="#set-of-comma-separated-tokens" id="standard-metadata-names:set-of-comma-separated-tokens" {
						- "set of comma-separated tokens"
					}
					- ", each of which is a keyword\n    relevant to the page."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n     "
					p {
						- "This page about typefaces on British motorways uses a "
						code id="standard-metadata-names:the-meta-element-7" {
							a href="#the-meta-element" {
								- "meta"
							}
						}
						- " element to specify\n     some keywords that users might use to look for the page:"
					}
					- "\n\n     "
					pre {
						code class="html" {
							c- cp="" {
								- "<!DOCTYPE HTML>"
							}
							- "\n"
							c- p="" {
								- "<"
							}
							c- f="" {
								- "html"
							}
							- " "
							c- e="" {
								- "lang"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"en-GB\""
							}
							c- p="" {
								- ">"
							}
							- "\n "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "head"
							}
							c- p="" {
								- ">"
							}
							- "\n  "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "title"
							}
							c- p="" {
								- ">"
							}
							- "Typefaces on UK motorways"
							c- p="" {
								- "</"
							}
							c- f="" {
								- "title"
							}
							c- p="" {
								- ">"
							}
							- "\n  "
							c- p="" {
								- "<"
							}
							c- f="" {
								- "meta"
							}
							- " "
							c- e="" {
								- "name"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"keywords\""
							}
							- " "
							c- e="" {
								- "content"
							}
							c- o="" {
								- "="
							}
							c- s="" {
								- "\"british,type face,font,fonts,highway,highways\""
							}
							c- p="" {
								- ">"
							}
							- "\n "
							c- p="" {
								- "</"
							}
							c- f="" {
								- "head"
							}
							c- p="" {
								- ">"
							}
							- "\n "
