		}
		- "\n\n  "
		p {
			a href="#serializable-objects" id="serializable-objects:serializable-objects" {
				- "Serializable objects"
			}
			- " support being serialized, and later deserialized, in a way\n  that is independent of any given "
			a id="serializable-objects:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- ". This allows them to be stored on disk and\n  later restored, or cloned across "
			a id="serializable-objects:agent" href="https://tc39.es/ecma262/#sec-agents" data-x-internal="agent" {
				- "agent"
			}
			- " and even "
			a id="serializable-objects:agent-cluster" href="https://tc39.es/ecma262/#sec-agent-clusters" data-x-internal="agent-cluster" {
				- "agent cluster"
			}
			- "\n  boundaries."
		}
		- "\n\n  "
		p {
			- "Not all objects are "
			a href="#serializable-objects" id="serializable-objects:serializable-objects-2" {
				- "serializable objects"
			}
			- ", and not all aspects of objects that are\n  "
			a href="#serializable-objects" id="serializable-objects:serializable-objects-3" {
				- "serializable objects"
			}
			- " are necessarily preserved when they are serialized."
		}
		- "\n\n  \n\n  "
		p {
			a href="https://webidl.spec.whatwg.org/#dfn-platform-object" id="serializable-objects:platform-object" data-x-internal="platform-object" {
				- "Platform objects"
			}
			- " can be "
			a href="#serializable-objects" id="serializable-objects:serializable-objects-4" {
				- "serializable objects"
			}
			- "\n  if their "
			a id="serializable-objects:primary-interface" href="https://webidl.spec.whatwg.org/#dfn-primary-interface" data-x-internal="primary-interface" {
				- "primary interface"
			}
			- " is decorated with the "
			dfn id="serializable" data-dfn-type="extended-attribute" data-lt="Serializable" {
				code {
					- "[Serializable]"
				}
			}
			- " IDL "
			a id="serializable-objects:extended-attribute" href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" data-x-internal="extended-attribute" {
				- "extended\n  attribute"
			}
			- ". Such interfaces must also define the following algorithms:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="serialization-steps" data-export="" {
					- "serialization steps"
				}
				- ", taking a "
				a id="serializable-objects:platform-object-2" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- "\n   "
				var {
					- "value"
				}
				- ", a "
				a id="serializable-objects:record" href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" data-x-internal="record" {
					- "Record"
				}
				- " "
				var {
					- "serialized"
				}
				- ", and a boolean\n   "
				var {
					- "forStorage"
				}
			}
			dd {
				- "\n    "
				p {
					- "A set of steps that serializes the data in "
					var {
						- "value"
					}
					- " into fields of\n    "
					var {
						- "serialized"
					}
					- ". The resulting data serialized into "
					var {
						- "serialized"
					}
					- " must be\n    independent of any "
					a id="serializable-objects:realm-2" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "These steps may throw an exception if serialization is not possible."
				}
				- "\n\n    "
				p {
					- "These steps may perform a "
					a href="#sub-serialization" id="serializable-objects:sub-serialization" {
						- "sub-serialization"
					}
					- " to serialize nested data\n    structures. They should not call "
					a href="#structuredserialize" id="serializable-objects:structuredserialize" {
						- "StructuredSerialize"
					}
					- " directly, as doing so will\n    omit the important "
					var {
						- "memory"
					}
					- " argument."
				}
				- "\n\n    "
				p {
					- "The introduction of these steps should omit mention of the "
					var {
						- "forStorage"
					}
					- " argument if\n    it is not relevant to the algorithm."
				}
				- "\n   "
			}
			dt {
				dfn id="deserialization-steps" data-export="" {
					- "deserialization steps"
				}
				- ", taking a "
				a id="serializable-objects:record-2" href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" data-x-internal="record" {
					- "Record"
				}
				- " "
				var {
					- "serialized"
				}
				- ",\n   a "
				a id="serializable-objects:platform-object-3" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- " "
				var {
					- "value"
				}
				- ", and a "
				a id="serializable-objects:realm-3" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
					- "realm"
				}
				- "\n   "
				var {
					- "targetRealm"
				}
			}
			dd {
				- "\n    "
				p {
					- "A set of steps that deserializes the data in "
					var {
						- "serialized"
					}
					- ", using it to set up\n    "
					var {
						- "value"
					}
					- " as appropriate. "
					var {
						- "value"
					}
					- " will be a newly-created instance of the\n    "
					a id="serializable-objects:platform-object-4" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
						- "platform object"
					}
					- " type in question, with none of its internal data set up; setting\n    that up is the job of these steps."
				}
				- "\n\n    "
				p {
					- "These steps may throw an exception if deserialization is not possible."
				}
				- "\n\n    "
				p {
					- "These steps may perform a "
					a href="#sub-deserialization" id="serializable-objects:sub-deserialization" {
						- "sub-deserialization"
					}
					- " to deserialize nested data\n    structures. They should not call "
					a href="#structureddeserialize" id="serializable-objects:structureddeserialize" {
						- "StructuredDeserialize"
					}
					- " directly, as doing so will\n    omit the important "
					var {
						- "targetRealm"
					}
					- " and "
					var {
						- "memory"
					}
					- " arguments."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "It is up to the definition of individual platform objects to determine what data is serialized\n  and deserialized by these steps. Typically the steps are very symmetric."
		}
		- "\n\n  "
		p {
			- "The "
			code id="serializable-objects:serializable" {
				a href="#serializable" {
					- "[Serializable]"
				}
			}
			- " extended attribute must take no\n  arguments, and must only appear on an interface. It must not appear more than once on an\n  interface."
		}
		- "\n\n  "
		p {
			- "For a given "
			a id="serializable-objects:platform-object-5" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
				- "platform object"
			}
			- ", only the object's "
			a id="serializable-objects:primary-interface-2" href="https://webidl.spec.whatwg.org/#dfn-primary-interface" data-x-internal="primary-interface" {
				- "primary interface"
			}
			- " is\n  considered during the (de)serialization process. Thus, if inheritance is involved in defining the\n  interface, each "
			code id="serializable-objects:serializable-2" {
				a href="#serializable" {
					- "[Serializable]"
				}
			}
			- "-annotated interface in the\n  inheritance chain needs to define standalone "
			a href="#serialization-steps" id="serializable-objects:serialization-steps" {
				- "serialization steps"
			}
			- " and\n  "
			a href="#deserialization-steps" id="serializable-objects:deserialization-steps" {
				- "deserialization steps"
			}
			- ", including taking into account any important data that might\n  come from inherited interfaces."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Let's say we were defining a platform object "
				code {
					- "Person"
				}
				- ", which had\n   associated with it two pieces of associated data:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "a name value, which is a string; and"
					}
				}
				li {
					p {
						- "a best friend value, which is either another "
						code {
							- "Person"
						}
						- " instance\n    or null."
					}
				}
			}
			- "\n\n   "
			p {
				- "We could then define "
				code {
					- "Person"
				}
				- " instances to be "
				a href="#serializable-objects" id="serializable-objects:serializable-objects-5" {
					- "serializable\n   objects"
				}
				- " by annotating the "
				code {
					- "Person"
				}
				- " interface with the "
				code id="serializable-objects:serializable-3" {
					a href="#serializable" {
						- "[Serializable]"
					}
				}
				- " "
				a id="serializable-objects:extended-attribute-2" href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" data-x-internal="extended-attribute" {
					- "extended attribute"
				}
				- ", and defining the\n   following accompanying algorithms:"
			}
			- "\n\n   "
			dl {
				dt {
					a href="#serialization-steps" id="serializable-objects:serialization-steps-2" {
						- "serialization steps"
					}
				}
				dd {
					- "\n     "
					ol {
						li {
							p {
								- "Set "
								var {
									- "serialized"
								}
								- ".[[Name]] to "
								var {
									- "value"
								}
								- "'s associated name\n      value."
							}
						}
						li {
							p {
								- "Let "
								var {
									- "serializedBestFriend"
								}
								- " be the "
								a href="#sub-serialization" id="serializable-objects:sub-serialization-2" {
									- "sub-serialization"
								}
								- " of\n      "
								var {
									- "value"
								}
								- "'s associated best friend value."
							}
						}
						li {
							p {
								- "Set "
								var {
									- "serialized"
								}
								- ".[[BestFriend]] to "
								var {
									- "serializedBestFriend"
								}
								- "."
							}
						}
					}
					- "\n    "
				}
				dt {
					a href="#deserialization-steps" id="serializable-objects:deserialization-steps-2" {
						- "deserialization steps"
					}
				}
				dd {
					- "\n     "
					ol {
						li {
							p {
								- "Set "
								var {
									- "value"
								}
								- "'s associated name value to\n      "
								var {
									- "serialized"
								}
								- ".[[Name]]."
							}
						}
						li {
							p {
								- "Let "
								var {
									- "deserializedBestFriend"
								}
								- " be the "
								a href="#sub-deserialization" id="serializable-objects:sub-deserialization-2" {
									- "sub-deserialization"
								}
								- " of\n      "
								var {
									- "serialized"
								}
								- ".[[BestFriend]]."
							}
						}
						li {
							p {
								- "Set "
								var {
									- "value"
								}
								- "'s associated best friend value to\n      "
								var {
									- "deserializedBestFriend"
								}
								- "."
							}
						}
					}
					- "\n    "
				}
			}
			- "\n  "
		}
		- "\n\n  "
		p {
			- "Objects defined in the JavaScript specification are handled by the\n  "
			a href="#structuredserialize" id="serializable-objects:structuredserialize-2" {
				- "StructuredSerialize"
			}
			- " abstract operation directly."
		}
		- "\n\n  "
		p id="cloneable-objects" class="note" {
			- "Originally, this specification defined the concept of\n  \"cloneable objects\", which could be cloned from one "
			a id="serializable-objects:realm-4" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- " to another. However, to\n  better specify the behavior of certain more complex situations, the model was updated to make the\n  serialization and deserialization explicit."
		}
		- "\n\n  \n\n  "
		h4 id="transferable-objects" data-lt="transferable object" data-export="" {
			span class="secno" {
				- "2.7.2"
			}
			- " "
			dfn {
				- "Transferable objects"
			}
			a href="#transferable-objects" class="self-link"
		}
		- "\n\n  "
		p {
			a href="#transferable-objects" id="transferable-objects:transferable-objects" {
				- "Transferable objects"
			}
			- " support being transferred across "
			a href="https://tc39.es/ecma262/#sec-agents" id="transferable-objects:agent" data-x-internal="agent" {
				- "agents"
			}
			- ". Transferring is effectively recreating the object while sharing a\n  reference to the underlying data and then detaching the object being transferred. This is useful\n  to transfer ownership of expensive resources. Not all objects are "
			a href="#transferable-objects" id="transferable-objects:transferable-objects-2" {
				- "transferable\n  objects"
			}
			- " and not all aspects of objects that are "
			a href="#transferable-objects" id="transferable-objects:transferable-objects-3" {
				- "transferable objects"
			}
			- " are\n  necessarily preserved when transferred."
		}
		- "\n\n  "
		p class="note" {
			- "Transferring is an irreversible and non-idempotent operation. Once an object has\n  been transferred, it cannot be transferred, or indeed used, again."
		}
		- "\n\n  \n\n  "
		p {
			a href="https://webidl.spec.whatwg.org/#dfn-platform-object" id="transferable-objects:platform-object" data-x-internal="platform-object" {
				- "Platform objects"
			}
			- " can be "
			a href="#transferable-objects" id="transferable-objects:transferable-objects-4" {
				- "transferable objects"
			}
			- "\n  if their "
			a id="transferable-objects:primary-interface" href="https://webidl.spec.whatwg.org/#dfn-primary-interface" data-x-internal="primary-interface" {
				- "primary interface"
			}
			- " is decorated with the "
			dfn id="transferable" data-dfn-type="extended-attribute" data-lt="Transferable" {
				code {
					- "[Transferable]"
				}
			}
			- " IDL "
			a id="transferable-objects:extended-attribute" href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" data-x-internal="extended-attribute" {
				- "extended\n  attribute"
			}
			- ". Such interfaces must also define the following algorithms:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="transfer-steps" data-export="" {
					- "transfer steps"
				}
				- ", taking a "
				a id="transferable-objects:platform-object-2" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- "\n   "
				var {
					- "value"
				}
				- " and a "
				a id="transferable-objects:record" href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" data-x-internal="record" {
					- "Record"
				}
				- " "
				var {
					- "dataHolder"
				}
			}
			dd {
				- "\n    "
				p {
					- "A set of steps that transfers the data in "
					var {
						- "value"
					}
					- " into fields of\n    "
					var {
						- "dataHolder"
					}
					- ". The resulting data held in "
					var {
						- "dataHolder"
					}
					- " must be\n    independent of any "
					a id="transferable-objects:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
						- "realm"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "These steps may throw an exception if transferral is not possible."
				}
				- "\n   "
			}
			dt {
				dfn id="transfer-receiving-steps" data-export="" {
					- "transfer-receiving steps"
				}
				- ", taking a "
				a id="transferable-objects:record-2" href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" data-x-internal="record" {
					- "Record"
				}
				- "\n   "
				var {
					- "dataHolder"
				}
				- " and a "
				a id="transferable-objects:platform-object-3" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
					- "platform object"
				}
				- " "
				var {
					- "value"
				}
			}
			dd {
				- "\n    "
				p {
					- "A set of steps that receives the data in "
					var {
						- "dataHolder"
					}
					- ", using it to set up\n    "
					var {
						- "value"
					}
					- " as appropriate. "
					var {
						- "value"
					}
					- " will be a newly-created instance of the\n    "
					a id="transferable-objects:platform-object-4" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
						- "platform object"
					}
					- " type in question, with none of its internal data set up; setting\n    that up is the job of these steps."
				}
				- "\n\n    "
				p {
					- "These steps may throw an exception if it is not possible to receive the transfer."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "It is up to the definition of individual platform objects to determine what data is transferred\n  by these steps. Typically the steps are very symmetric."
		}
		- "\n\n  "
		p {
			- "The "
			code id="transferable-objects:transferable" {
				a href="#transferable" {
					- "[Transferable]"
				}
			}
			- " extended attribute must take no\n  arguments, and must only appear on an interface. It must not appear more than once on an\n  interface."
		}
		- "\n\n  "
		p {
			- "For a given "
			a id="transferable-objects:platform-object-5" href="https://webidl.spec.whatwg.org/#dfn-platform-object" data-x-internal="platform-object" {
				- "platform object"
			}
			- ", only the object's "
			a id="transferable-objects:primary-interface-2" href="https://webidl.spec.whatwg.org/#dfn-primary-interface" data-x-internal="primary-interface" {
				- "primary interface"
			}
			- " is\n  considered during the transferring process. Thus, if inheritance is involved in defining the\n  interface, each "
			code id="transferable-objects:transferable-2" {
				a href="#transferable" {
					- "[Transferable]"
				}
			}
			- "-annotated interface in the\n  inheritance chain needs to define standalone "
			a href="#transfer-steps" id="transferable-objects:transfer-steps" {
				- "transfer steps"
			}
			- " and\n  "
			a href="#transfer-receiving-steps" id="transferable-objects:transfer-receiving-steps" {
				- "transfer-receiving steps"
			}
			- ", including taking into account any important data that might\n  come from inherited interfaces."
		}
		- "\n\n  "
		p {
			a href="https://webidl.spec.whatwg.org/#dfn-platform-object" id="transferable-objects:platform-object-6" data-x-internal="platform-object" {
				- "Platform objects"
			}
			- " that are "
			a href="#transferable-objects" id="transferable-objects:transferable-objects-5" {
				- "transferable\n  objects"
			}
			- " have a "
			dfn data-dfn-for="platform object" id="detached" data-dfn-type="attribute" {
				- "[[Detached]]"
			}
			- " internal slot. This\n  is used to ensure that once a platform object has been transferred, it cannot be transferred\n  again."
		}
		- "\n\n  "
		p {
			- "Objects defined in the JavaScript specification are handled by the\n  "
			a href="#structuredserializewithtransfer" id="transferable-objects:structuredserializewithtransfer" {
				- "StructuredSerializeWithTransfer"
			}
			- " abstract operation directly."
		}
		- "\n\n  "
		h4 id="structuredserializeinternal" data-dfn-type="abstract-op" data-noexport="" data-lt="StructuredSerializeInternal" {
			span class="secno" {
				- "2.7.3"
			}
			- " "
			dfn {
				- "StructuredSerializeInternal"
			}
			- " ( "
			var {
				- "value"
			}
			- ", "
			var {
				- "forStorage"
			}
			- " [ ,\n  "
			var {
				- "memory"
			}
			- " ] )"
			a href="#structuredserializeinternal" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			a href="#structuredserializeinternal" id="structuredserializeinternal:structuredserializeinternal" {
				- "StructuredSerializeInternal"
			}
			- " abstract operation takes as input a JavaScript\n  value "
			var {
				- "value"
			}
			- " and serializes it to a "
			a id="structuredserializeinternal:realm" href="https://tc39.es/ecma262/#sec-code-realms" data-x-internal="realm" {
				- "realm"
			}
			- "-independent form, represented\n  here as a "
			a id="structuredserializeinternal:record" href="https://tc39.es/ecma262/#sec-list-and-record-specification-type" data-x-internal="record" {
				- "Record"
			}
			- ". This serialized form has all the information necessary to later\n  deserialize into a new JavaScript value in a different realm."
		}
		- "\n\n  "
		p {
			- "This process can throw an exception, for example when trying to serialize un-serializable\n  objects."
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "memory"
					}
					- " was not supplied, let "
					var {
						- "memory"
					}
					- " be an empty "
					a href="https://infra.spec.whatwg.org/#ordered-map" id="structuredserializeinternal:ordered-map" data-x-internal="ordered-map" {
						- "map"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "The purpose of the "
					var {
						- "memory"
					}
					- " map is to avoid serializing objects twice.\n    This ends up preserving cycles and the identity of duplicate objects in graphs."
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "memory"
					}
					- "["
					var {
						- "value"
					}
					- "] "
					a href="https://infra.spec.whatwg.org/#map-exists" id="structuredserializeinternal:map-exists" data-x-internal="map-exists" {
						- "exists"
					}
					- ", then\n   return "
					var {
						- "memory"
					}
					- "["
					var {
						- "value"
					}
					- "]."
				}
			}
			li {
				p {
					- "Let "
					var {
						- "deep"
					}
					- " be false."
				}
			}
			li {
				p {
					- "If "
					var {
						- "value"
					}
					- " is undefined, null, "
					a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-boolean-type" id="structuredserializeinternal:js-boolean" data-x-internal="js-boolean" {
						- "a Boolean"
					}
					- ", "
					a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-number-type" id="structuredserializeinternal:js-number" data-x-internal="js-number" {
