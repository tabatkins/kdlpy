					- " element, then switch the\n   "
					a href="#insertion-mode" id="the-insertion-mode:insertion-mode-10" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-incaption" id="the-insertion-mode:parsing-main-incaption-2" {
						- "in caption"
					}
					- "\" and\n   return."
				}
