			- " a "
			a href="#form-associated-custom-element" id="custom-elements-face-example:form-associated-custom-element" {
				- "form-associated custom element"
			}
			- ". The\n  "
			code id="custom-elements-face-example:elementinternals" {
				a href="#elementinternals" {
					- "ElementInternals"
