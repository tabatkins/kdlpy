		- "\n\n  "
		p class="note" {
			a href="#run-steps-after-a-timeout" id="timers:run-steps-after-a-timeout-2" {
				- "Run steps after a timeout"
			}
			- " is meant to be used by other\n  specifications that want to execute developer-supplied code after a developer-supplied timeout,\n  in a similar manner to "
			code id="timers:dom-settimeout-11" {
