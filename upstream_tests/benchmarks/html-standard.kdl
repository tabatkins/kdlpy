								}
								- "\" attribute to \""
								code {
									- "b'ar'"
								}
								- "\"."
							}
							- "\n     "
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-equals-sign-before-attribute-name" {
							- "unexpected-equals-sign-before-attribute-name"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters a U+003D (=) "
							a id="parse-errors:code-point-25" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " before an\n      attribute name. In this case the parser treats U+003D (=) as the first code point of the\n      attribute name."
						}
						- "\n\n      "
						p class="note" {
							- "The common reason for this error is a forgotten attribute name."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "For example, consider the following markup:"
							}
							- "\n\n       "
