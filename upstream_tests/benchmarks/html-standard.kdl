							}
							- " at the\n      "
							a href="#source-node" id="drag-and-drop-processing-model:source-node-11" {
								- "source node"
							}
							- "."
						}
						- "\n     "
					}
					li {
						- "\n      "
						p {
							- "Run the appropriate steps from the following list as the default action of the "
							code id="drag-and-drop-processing-model:event-dnd-dragend-2" {
								a href="#event-dnd-dragend" {
									- "dragend"
								}
							}
							- " event:"
						}
						- "\n\n      "
						dl class="switch" {
							dt {
								- "If "
								var {
									- "dropped"
								}
								- " is true, the "
								a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-22" {
									- "current target element"
								}
								- " is a "
								i {
									- "text\n       control"
								}
								- " (see below), the "
								a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation-11" {
									- "current drag operation"
								}
								- " is \""
								code id="drag-and-drop-processing-model:concept-current-drag-operation-move-4" {
									a href="#concept-current-drag-operation-move" {
										- "move"
									}
								}
								- "\", and the source of the\n       drag-and-drop operation is a selection in the DOM that is entirely contained within an\n       "
								a href="#editing-host" id="drag-and-drop-processing-model:editing-host-5" {
									- "editing host"
								}
							}
							dd {
								p {
									a id="drag-and-drop-processing-model:delete-the-selection" href="https://w3c.github.io/editing/docs/execCommand/#delete-the-selection" data-x-internal="delete-the-selection" {
										- "Delete the selection"
									}
									- "."
								}
							}
							dt {
								- "If "
								var {
									- "dropped"
								}
								- " is true, the "
								a href="#current-target-element" id="drag-and-drop-processing-model:current-target-element-23" {
									- "current target element"
								}
								- " is a "
								i {
									- "text\n       control"
								}
								- " (see below), the "
								a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation-12" {
									- "current drag operation"
								}
								- " is \""
								code id="drag-and-drop-processing-model:concept-current-drag-operation-move-5" {
									a href="#concept-current-drag-operation-move" {
										- "move"
									}
								}
								- "\", and the source of the\n       drag-and-drop operation is a selection in a text control"
							}
							dd {
								p {
									- "The user agent should delete the dragged selection from the relevant text\n       control."
								}
							}
							dt {
								- "If "
								var {
									- "dropped"
								}
								- " is false or if the "
								a href="#current-drag-operation" id="drag-and-drop-processing-model:current-drag-operation-13" {
									- "current drag operation"
								}
								- " is \""
