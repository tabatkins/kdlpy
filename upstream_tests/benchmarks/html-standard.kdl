					}
				}
			}
			- "\n\n   "
			p {
				- "...then a compliant UA that supported only CSS style sheets would fetch the B and C files, and\n   skip the A file (since "
				code id="processing-the-type-attribute:text/plain" {
					a data-x-internal="text/plain" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
						- "text/plain"
					}
				}
				- " is not the "
				a id="processing-the-type-attribute:mime-type-3" href="https://mimesniff.spec.whatwg.org/#mime-type" data-x-internal="mime-type" {
					- "MIME type"
				}
				- " for CSS style\n   sheets)."
			}
			- "\n\n   "
			p {
				- "For files B and C, it would then check the actual types returned by the server. For those that\n   are sent as "
				code id="processing-the-type-attribute:text/css" {
					a href="#text/css" {
						- "text/css"
					}
				}
