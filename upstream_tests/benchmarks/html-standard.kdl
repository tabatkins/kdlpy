			dd {
				- "\n    "
				p {
					- "A "
					code id="navigation-activation-interface:navigationhistoryentry-4" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- ", representing the "
					code id="navigation-activation-interface:document-5" {
						a href="#document" {
							- "Document"
						}
					}
					- " that was active\n    right before the current "
					code id="navigation-activation-interface:document-6" {
						a href="#document" {
							- "Document"
						}
					}
					- ". This will have a value null in case the\n    previous "
					code id="navigation-activation-interface:document-7" {
						a href="#document" {
							- "Document"
						}
					}
					- " was not "
					a href="#same-origin" id="navigation-activation-interface:same-origin" {
						- "same origin"
					}
