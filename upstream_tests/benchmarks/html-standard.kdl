										p {
											- "Let "
											var {
												- "resumptionSteps"
											}
											- " be null."
										}
									}
									li {
										p {
											- "If "
											var {
												- "entry"
											}
											- "."
											code id="lazy-loading-attributes:dom-intersectionobserverentry-isintersecting" {
												a data-x-internal="dom-intersectionobserverentry-isintersecting" href="https://w3c.github.io/IntersectionObserver/#dom-intersectionobserverentry-isintersecting" {
													- "isIntersecting"
												}
											}
											- " is true, then\n         set "
