		- "\n\n  "
		h5 id="event-firing" {
			span class="secno" {
				- "8.1.8.3"
			}
			- " Event firing"
			a href="#event-firing" class="self-link"
		}
		- "\n\n  "
		p {
			- "Certain operations and methods are defined as firing events on elements. For example, the "
			code id="event-firing:dom-click" {
				a href="#dom-click" {
					- "click()"
				}
			}
			- " method on the "
			code id="event-firing:htmlelement" {
				a href="#htmlelement" {
					- "HTMLElement"
				}
			}
			- " interface is defined as\n  firing a "
			code id="event-firing:event-click" {
				a data-x-internal="event-click" href="https://w3c.github.io/uievents/#event-type-click" {
					- "click"
				}
			}
			- " event on the element. "
			a href="#refsUIEVENTS" {
				- "[UIEVENTS]"
			}
		}
		- "\n\n  "
		p {
			dfn id="fire-a-synthetic-pointer-event" {
				- "Firing a synthetic pointer event named\n  "
				var {
					- "e"
				}
			}
			- " at "
			var {
				- "target"
			}
			- ", with an optional "
			var {
				- "not trusted flag"
			}
			- ", means\n  running these steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "event"
					}
					- " be the result of "
					a id="event-firing:creating-an-event" href="https://dom.spec.whatwg.org/#concept-event-create" data-x-internal="creating-an-event" {
						- "creating an event"
					}
					- " using\n   "
					code id="event-firing:pointerevent" {
						a data-x-internal="pointerevent" href="https://w3c.github.io/pointerevents/#pointerevent-interface" {
							- "PointerEvent"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code id="event-firing:dom-event-type" {
						a data-x-internal="dom-event-type" href="https://dom.spec.whatwg.org/#dom-event-type" {
							- "type"
						}
					}
					- " attribute to\n   "
					var {
						- "e"
					}
					- "."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code id="event-firing:dom-event-bubbles" {
						a data-x-internal="dom-event-bubbles" href="https://dom.spec.whatwg.org/#dom-event-bubbles" {
							- "bubbles"
						}
					}
					- " and "
					code id="event-firing:dom-event-cancelable" {
						a data-x-internal="dom-event-cancelable" href="https://dom.spec.whatwg.org/#dom-event-cancelable" {
							- "cancelable"
						}
					}
					- " attributes to true."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "event"
					}
					- "'s "
					a id="event-firing:composed-flag" href="https://dom.spec.whatwg.org/#composed-flag" data-x-internal="composed-flag" {
						- "composed flag"
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					var {
						- "not trusted flag"
					}
					- " is set, initialize "
					var {
						- "event"
					}
					- "'s "
					code id="event-firing:dom-event-istrusted" {
						a data-x-internal="dom-event-istrusted" href="https://dom.spec.whatwg.org/#dom-event-istrusted" {
							- "isTrusted"
						}
					}
					- " attribute to false."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code {
						- "ctrlKey"
					}
					- ", "
					code {
						- "shiftKey"
					}
					- ", "
					code {
						- "altKey"
					}
					- ", and "
					code {
						- "metaKey"
					}
					- "\n   attributes according to the current state of the key input device, if any (false for any keys\n   that are not available)."
				}
			}
			li {
				p {
					- "Initialize "
					var {
						- "event"
					}
					- "'s "
					code id="event-firing:dom-uievent-view" {
						a data-x-internal="dom-uievent-view" href="https://w3c.github.io/uievents/#dom-uievent-view" {
							- "view"
						}
					}
					- " attribute to\n   "
					var {
						- "target"
					}
					- "'s "
					a id="event-firing:node-document" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- "'s "
					code id="event-firing:window" {
						a href="#window" {
							- "Window"
						}
					}
					- " object, if any, and null\n   otherwise."
				}
			}
			li {
				p {
					var {
						- "event"
					}
					- "'s "
					code {
						- "getModifierState()"
					}
					- " method is to return values\n   appropriately describing the current state of the key input device."
				}
			}
			li {
				p {
					- "Return the result of "
					a href="https://dom.spec.whatwg.org/#concept-event-dispatch" id="event-firing:concept-event-dispatch" data-x-internal="concept-event-dispatch" {
						- "dispatching"
					}
					- "\n   "
					var {
						- "event"
					}
					- " at "
					var {
						- "target"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			dfn id="fire-a-click-event" {
				- "Firing a "
				code {
					- "click"
				}
				- " event"
			}
			- "\n  at "
			var {
				- "target"
			}
			- " means "
			a href="#fire-a-synthetic-pointer-event" id="event-firing:fire-a-synthetic-pointer-event" {
				- "firing a synthetic\n  pointer event named "
				code {
					- "click"
				}
			}
			- " at "
			var {
				- "target"
			}
			- "."
		}
		- "\n\n  \n\n\n  "
		h3 id="windoworworkerglobalscope-mixin" {
			span class="secno" {
				- "8.2"
			}
			- " The "
			code id="windoworworkerglobalscope-mixin:windoworworkerglobalscope" {
				a href="#windoworworkerglobalscope" {
					- "WindowOrWorkerGlobalScope"
				}
			}
			- " mixin"
			a href="#windoworworkerglobalscope-mixin" class="self-link"
		}
		- "\n\n  "
		p {
			- "The "
			code id="windoworworkerglobalscope-mixin:windoworworkerglobalscope-2" {
				a href="#windoworworkerglobalscope" {
					- "WindowOrWorkerGlobalScope"
				}
			}
			- " mixin is for use of APIs that are to be exposed on\n  "
			code id="windoworworkerglobalscope-mixin:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " and "
			code id="windoworworkerglobalscope-mixin:workerglobalscope" {
				a href="#workerglobalscope" {
					- "WorkerGlobalScope"
				}
			}
			- " objects."
		}
		- "\n\n  "
		p class="note" {
			- "Other standards are encouraged to further extend it using "
			code {
				- "partial\n  interface mixin "
				a href="#windoworworkerglobalscope" id="windoworworkerglobalscope-mixin:windoworworkerglobalscope-3" {
					- "WindowOrWorkerGlobalScope"
				}
				- " { … };"
			}
			- " along with an\n  appropriate reference."
		}
		- "\n\n  "
		pre {
			code class="idl" {
				c- b="" {
					- "typedef"
				}
				- " ("
				c- b="" {
					- "DOMString"
				}
				- " "
				c- b="" {
					- "or"
				}
				- " "
				a href="https://webidl.spec.whatwg.org/#common-Function" id="windoworworkerglobalscope-mixin:idl-function" data-x-internal="idl-function" {
					c- n="" {
						- "Function"
					}
				}
				- " "
