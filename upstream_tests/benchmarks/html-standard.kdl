		- "\n\n  "
		p {
			- "To "
			dfn id="set-up-a-worker-environment-settings-object" {
				- "set up a worker environment settings object"
			}
			- ", given a "
			a id="script-settings-for-workers:javascript-execution-context" href="https://tc39.es/ecma262/#sec-execution-contexts" data-x-internal="javascript-execution-context" {
