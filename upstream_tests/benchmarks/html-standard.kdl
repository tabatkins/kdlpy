		- "\n\n  \n\n\n  "
		h4 id="the-windowproxy-exotic-object" {
			span class="secno" {
				- "7.2.3"
			}
			- " The "
			code id="the-windowproxy-exotic-object:windowproxy" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " exotic object"
			a href="#the-windowproxy-exotic-object" class="self-link"
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="windowproxy" data-dfn-type="interface" {
				code {
					- "WindowProxy"
				}
			}
			- " is an exotic object that wraps a\n  "
			code id="the-windowproxy-exotic-object:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " ordinary object, indirecting most operations through to the wrapped object.\n  Each "
			a href="#browsing-context" id="the-windowproxy-exotic-object:browsing-context" {
				- "browsing context"
			}
			- " has an associated "
			code id="the-windowproxy-exotic-object:windowproxy-2" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " object. When the\n  "
			a href="#browsing-context" id="the-windowproxy-exotic-object:browsing-context-2" {
				- "browsing context"
			}
			- " is "
			a href="#navigate" id="the-windowproxy-exotic-object:navigate" {
				- "navigated"
			}
			- ", the "
			code id="the-windowproxy-exotic-object:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- "\n  object wrapped by the "
			a href="#browsing-context" id="the-windowproxy-exotic-object:browsing-context-3" {
				- "browsing context"
			}
			- "'s associated "
			code id="the-windowproxy-exotic-object:windowproxy-3" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " object\n  is changed."
		}
		- "\n\n  \n\n  "
		p {
			- "The "
			code id="the-windowproxy-exotic-object:windowproxy-4" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " exotic object must use the ordinary internal methods except where\n  it is explicitly specified otherwise below."
		}
		- "\n\n  "
		p {
			- "There is no "
			code id="the-windowproxy-exotic-object:windowproxy-5" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " "
			a id="the-windowproxy-exotic-object:interface-object" href="https://webidl.spec.whatwg.org/#dfn-interface-object" data-x-internal="interface-object" {
				- "interface object"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Every "
			code id="the-windowproxy-exotic-object:windowproxy-6" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " object has a "
			dfn id="concept-windowproxy-window" data-export="" {
				- "[[Window]]"
			}
			- " internal slot representing the wrapped "
			code id="the-windowproxy-exotic-object:window-3" {
				a href="#window" {
					- "Window"
				}
			}
			- " object."
		}
		- "\n\n  "
		p class="note" {
			- "Although "
			code id="the-windowproxy-exotic-object:windowproxy-7" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " is named as a \"proxy\", it does not do\n  polymorphic dispatch on its target's internal methods as a real proxy would, due to a desire to\n  reuse machinery between "
			code id="the-windowproxy-exotic-object:windowproxy-8" {
				a href="#windowproxy" {
					- "WindowProxy"
				}
			}
			- " and "
			code id="the-windowproxy-exotic-object:location" {
				a href="#location" {
					- "Location"
				}
			}
			- " objects. As long as the\n  "
			code id="the-windowproxy-exotic-object:window-4" {
				a href="#window" {
					- "Window"
				}
			}
			- " object remains an ordinary object this is unobservable and can be implemented\n  either way."
		}
		- "\n\n  "
		h5 id="windowproxy-getprototypeof" {
			span class="secno" {
				- "7.2.3.1"
			}
			- " [[GetPrototypeOf]] ( )"
			a href="#windowproxy-getprototypeof" class="self-link"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "W"
					}
					- " be the value of the\n   "
					a href="#concept-windowproxy-window" id="windowproxy-getprototypeof:concept-windowproxy-window" {
						- "[[Window]]"
					}
					- " internal slot of\n   "
					b {
						- "this"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					a href="#isplatformobjectsameorigin-(-o-)" id="windowproxy-getprototypeof:isplatformobjectsameorigin-(-o-)" {
						- "IsPlatformObjectSameOrigin"
					}
					- "("
					var {
						- "W"
					}
					- ") is true, then return !\n   "
					a id="windowproxy-getprototypeof:ordinarygetprototypeof" href="https://tc39.es/ecma262/#sec-ordinarygetprototypeof" data-x-internal="ordinarygetprototypeof" {
						- "OrdinaryGetPrototypeOf"
					}
					- "("
					var {
						- "W"
