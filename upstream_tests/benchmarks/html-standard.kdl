		- "\n\n  "
		p {
			- "The "
			code id="the-data-element:the-data-element" {
				a href="#the-data-element" {
					- "data"
				}
			}
			- " element "
			a href="#represents" id="the-data-element:represents" {
				- "represents"
			}
			- " its contents, along with a\n  machine-readable form of those contents in the "
			code id="the-data-element:attr-data-value-2" {
				a href="#attr-data-value" {
					- "value"
