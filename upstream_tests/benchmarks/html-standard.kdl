					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "span"
					}
					- " "
					c- e="" {
						- "spellcheck"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"false\""
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"a\""
					}
					c- p="" {
						- ">"
					}
					- "Hell"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "span"
					}
					c- p="" {
						- "><"
					}
					c- f="" {
						- "em"
					}
					c- p="" {
						- ">"
					}
					- "o!"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "em"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "div"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n   "
			p {
				- "The element with ID \"b\" in the following example would have checking enabled (the leading\n   space character in the attribute's value on the "
				code id="spelling-and-grammar-checking:the-input-element-4" {
					a href="#the-input-element" {
						- "input"
					}
				}
				- " element causes the attribute\n   to be ignored, so the ancestor's value is used instead, regardless of the default)."
			}
			- "\n\n   "
			pre class="bad" {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "p"
					}
					- " "
					c- e="" {
						- "spellcheck"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"true\""
					}
					c- p="" {
						- ">"
					}
					- "\n "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "label"
					}
					c- p="" {
						- ">"
					}
					- "Name: "
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "spellcheck"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\" false\""
					}
					- " "
					c- e="" {
						- "id"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "\"b\""
					}
					c- p="" {
						- "></"
					}
					c- f="" {
						- "label"
					}
					c- p="" {
						- ">"
					}
					- "\n"
					c- p="" {
						- "</"
					}
					c- f="" {
						- "p"
					}
					c- p="" {
						- ">"
