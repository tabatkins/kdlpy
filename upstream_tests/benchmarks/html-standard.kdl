									}
								}
								- " element creates two shapes, one on each\n      image. The "
								a href="#dom-anchor" id="data-model:dom-anchor-5" {
									- "DOM anchor"
								}
								- " of the first shape is the first "
								code id="data-model:the-img-element-3" {
									a href="#the-img-element" {
										- "img"
									}
								}
								- " element, and the\n      "
								a href="#dom-anchor" id="data-model:dom-anchor-6" {
									- "DOM anchor"
								}
								- " of the second shape is the second "
								code id="data-model:the-img-element-4" {
