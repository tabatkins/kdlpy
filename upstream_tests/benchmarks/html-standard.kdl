			a href="#stack-of-open-elements" id="parsing-main-intable:stack-of-open-elements-6" {
				- "stack of open\n  elements"
			}
			- "."
		}
		- "\n\n  "
		p class="note" {
			- "This is the same list of elements as used in the "
			i id="parsing-main-intable:has-an-element-in-table-scope-3" {
				a href="#has-an-element-in-table-scope" {
					- "has an element in table scope"
				}
			}
			- " steps."
		}
		- "\n\n  "
		p class="note" {
			- "The "
			a href="#current-node" id="parsing-main-intable:current-node-3" {
				- "current node"
			}
			- " being an "
			code id="parsing-main-intable:the-html-element-2" {
				a href="#the-html-element" {
					- "html"
				}
			}
			- " element after this\n  process is a "
			a href="#fragment-case" id="parsing-main-intable:fragment-case" {
				- "fragment case"
			}
			- "."
		}
		- "\n\n\n\n  "
		h6 id="parsing-main-intabletext" {
			span class="secno" {
				- "13.2.6.4.10"
			}
			- " The \""
			dfn {
				- "in table text"
			}
			- "\" insertion mode"
			a href="#parsing-main-intabletext" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-intabletext" id="parsing-main-intabletext:parsing-main-intabletext" {
				- "in table text"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-intabletext:insertion-mode" {
				- "insertion mode"
			}
			- ", the user agent must handle the token as\n  follows:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "A character token that is U+0000 NULL"
			}
			dd {
				- "\n    "
				p {
					a href="#parse-errors" id="parsing-main-intabletext:parse-errors" {
						- "Parse error"
					}
					- ". Ignore the token."
				}
				- "\n   "
			}
			dt {
				- "Any other character token"
			}
			dd {
				- "\n    "
				p {
					- "Append the character token to the "
					var id="parsing-main-intabletext:concept-pending-table-char-tokens" {
						a href="#concept-pending-table-char-tokens" {
							- "pending\n    table character tokens"
						}
					}
					- " list."
				}
				- "\n   "
			}
			dt {
				- "Anything else"
			}
			dd {
				- "\n    \n\n    "
				p {
					- "If any of the tokens in the "
					var id="parsing-main-intabletext:concept-pending-table-char-tokens-2" {
						a href="#concept-pending-table-char-tokens" {
							- "pending table\n    character tokens"
						}
					}
					- " list are character tokens that are not "
					a id="parsing-main-intabletext:space-characters" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
						- "ASCII whitespace"
					}
					- ",\n    then this is a "
					a href="#parse-errors" id="parsing-main-intabletext:parse-errors-2" {
						- "parse error"
					}
					- ": reprocess the character tokens in the "
					var id="parsing-main-intabletext:concept-pending-table-char-tokens-3" {
						a href="#concept-pending-table-char-tokens" {
							- "pending table character tokens"
						}
					}
					- " list using the\n    rules given in the \"anything else\" entry in the \""
					a href="#parsing-main-intable" id="parsing-main-intabletext:parsing-main-intable" {
						- "in\n    table"
					}
					- "\" insertion mode."
				}
				- "\n\n    \n\n    "
				p {
					- "Otherwise, "
					a href="#insert-a-character" id="parsing-main-intabletext:insert-a-character" {
						- "insert the characters"
					}
					- " given by the "
					var id="parsing-main-intabletext:concept-pending-table-char-tokens-4" {
						a href="#concept-pending-table-char-tokens" {
							- "pending table character tokens"
						}
					}
					- " list."
				}
				- " \n\n    \n\n    "
				p {
					- "Switch the "
					a href="#insertion-mode" id="parsing-main-intabletext:insertion-mode-2" {
						- "insertion mode"
					}
					- " to the "
					a href="#original-insertion-mode" id="parsing-main-intabletext:original-insertion-mode" {
						- "original insertion mode"
					}
					- " and\n    reprocess the token."
				}
				- "\n   "
			}
		}
		- "\n\n\n  "
		h6 id="parsing-main-incaption" {
			span class="secno" {
				- "13.2.6.4.11"
			}
			- " The \""
			dfn {
				- "in caption"
			}
			- "\" insertion mode"
			a href="#parsing-main-incaption" class="self-link"
		}
		- "\n\n  "
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-incaption" id="parsing-main-incaption:parsing-main-incaption" {
				- "in\n  caption"
			}
			- "\" "
			a href="#insertion-mode" id="parsing-main-incaption:insertion-mode" {
