				- "\n\n    "
				p {
					- "If "
					var {
						- "w"
					}
					- " and "
					var {
						- "h"
					}
					- " are both greater than or equal to 0, or if both are smaller\n    than 0, then the path is drawn clockwise. Otherwise, it is drawn counterclockwise."
				}
				- "\n\n    "
				p {
					- "When "
					var {
						- "w"
					}
					- " is negative, the rounded rectangle is flipped horizontally, which means\n    that the radius values that normally apply to the left corners are used on the right and vice\n    versa. Similarly, when "
					var {
