				}
			}
			- "\n\n  "
		}
		- "\n\n  \n\n  "
		p class="note" {
			- "This specification does not define the user interface for spelling and grammar\n  checkers. A user agent could offer on-demand checking, could perform continuous checking while the\n  checking is enabled, or could use other interfaces."
		}
		- "\n\n  "
		h4 id="writing-suggestions" {
			span class="secno" {
				- "6.8.6"
			}
			- " Writing suggestions"
			a href="#writing-suggestions" class="self-link"
		}
		- "\n\n  "
		p {
			- "User agents offer writing suggestions as users type into editable regions, either in form\n  controls (e.g., the "
			code id="writing-suggestions:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element) or in elements in an "
			a href="#editing-host" id="writing-suggestions:editing-host" {
				- " editing host"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-writingsuggestions" data-dfn-type="element-attr" {
				code {
					- "writingsuggestions"
				}
			}
			- " content attribute is an\n  "
			a href="#enumerated-attribute" id="writing-suggestions:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/writingsuggestions" id="attr-writingsuggestions-true" data-dfn-type="attr-value" {
							code {
								- "true"
							}
						}
						- "\n     "
					}
					td rowspan="2" {
						dfn id="attr-writingsuggestions-true-state" {
							- "true"
						}
						- "\n     "
					}
					td rowspan="2" {
						- "Writing suggestions should be offered on this element.\n    "
					}
				}
				tr {
					td {
						- "(the empty string)\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/writingsuggestions" id="attr-writingsuggestions-false" data-dfn-type="attr-value" {
							code {
								- "false"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-writingsuggestions-false-state" {
							- "false"
						}
						- "\n     "
					}
					td {
						- "Writing suggestions should not be offered on this element.\n    "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="writing-suggestions:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " is the "
			dfn id="attr-writingsuggestions-default-state" {
				- "default"
			}
			- " state. The default state indicates\n  that the element is to act according to a default behavior, possibly based on the parent\n  element's own "
			code id="writing-suggestions:attr-writingsuggestions" {
				a href="#attr-writingsuggestions" {
					- "writingsuggestions"
				}
			}
			- " state, as defined\n  below."
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="writing-suggestions:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " is the "
			a href="#attr-writingsuggestions-true-state" id="writing-suggestions:attr-writingsuggestions-true-state" {
				- "true"
			}
			- " state."
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				code {
					var {
						- "element"
					}
					- "."
					a href="#dom-writingsuggestions" id="dom-writingsuggestions-dev" {
						- "writingSuggestions"
					}
					- " [ = "
					var {
						- "value"
					}
					- " ]"
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns \""
					code {
						- "true"
					}
					- "\" if the user agent is to offer writing suggestions under\n    the scope of the element; otherwise, returns \""
					code {
						- "false"
					}
					- "\"."
				}
				- "\n\n    "
				p {
					- "Can be set, to override the default and set the "
					code id="writing-suggestions:attr-writingsuggestions-2" {
						a href="#attr-writingsuggestions" {
							- "\n    writingsuggestions"
						}
					}
					- " content attribute."
				}
				- "\n   "
			}
		}
		- "\n\n  \n  "
		p {
			- "The "
			dfn id="computed-writing-suggestions-value" {
				- "computed writing suggestions value"
			}
			- " of a given "
			var {
				- "element"
			}
			- " is\n  determined  by running the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					code id="writing-suggestions:attr-writingsuggestions-3" {
						a href="#attr-writingsuggestions" {
							- "writingsuggestions"
						}
					}
					- "\n   content attribute is in the "
					a href="#attr-writingsuggestions-false-state" id="writing-suggestions:attr-writingsuggestions-false-state" {
						- "false"
					}
					- "\n   state, return \""
					code {
						- "false"
					}
					- "\"."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- "'s "
					code id="writing-suggestions:attr-writingsuggestions-4" {
						a href="#attr-writingsuggestions" {
							- "writingsuggestions"
						}
					}
					- " content attribute is in the "
					a href="#attr-writingsuggestions-default-state" id="writing-suggestions:attr-writingsuggestions-default-state" {
						- "default"
					}
					- " state, "
					var {
						- "element"
					}
					- " has a\n   parent element, and the "
					a href="#computed-writing-suggestions-value" id="writing-suggestions:computed-writing-suggestions-value" {
						- "computed writing suggestions value"
					}
					- " of\n   "
					var {
						- "element"
					}
					- "'s parent element is \""
					code {
						- "false"
					}
					- "\", then return\n   \""
					code {
						- "false"
					}
					- "\"."
				}
			}
			li {
				p {
					- "Return \""
					code {
						- "true"
					}
					- "\"."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLElement" id="dom-writingsuggestions" data-dfn-type="attribute" {
				code {
					- "writingSuggestions"
				}
			}
			- " getter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Return "
					a id="writing-suggestions:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					a href="#computed-writing-suggestions-value" id="writing-suggestions:computed-writing-suggestions-value-2" {
						- "computed writing suggestions value"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "The "
			code id="writing-suggestions:dom-writingsuggestions" {
				a href="#dom-writingsuggestions" {
					- "writingSuggestions"
				}
			}
			- " IDL\n  attribute is not affected by user preferences that override the "
			code id="writing-suggestions:attr-writingsuggestions-5" {
				a href="#attr-writingsuggestions" {
					- "writingsuggestions"
				}
			}
			- " content attribute, and therefore\n  might not reflect the actual writing suggestions state."
		}
		- "\n\n  "
		p {
			- "The "
			code id="writing-suggestions:dom-writingsuggestions-2" {
				a href="#dom-writingsuggestions" {
					- "writingSuggestions"
				}
			}
			- " setter steps are:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Set "
					a id="writing-suggestions:this-2" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "'s "
					code id="writing-suggestions:attr-writingsuggestions-6" {
						a href="#attr-writingsuggestions" {
							- "writingsuggestions"
						}
					}
					- "\n   content attribute to the given value."
				}
			}
		}
		- "\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "User agents should only offer suggestions within an element's scope if the\n  result of running the following algorithm given "
			var {
				- "element"
			}
			- " returns true:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the user has disabled writing suggestions, then return false."
				}
			}
			li {
				- "\n    "
				p {
					- "If none of the following conditions are true:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							var {
								- "element"
							}
							- " is an "
							code id="writing-suggestions:the-input-element" {
								a href="#the-input-element" {
									- "input"
								}
							}
							- " element whose "
							code id="writing-suggestions:attr-input-type" {
								a href="#attr-input-type" {
									- "type"
								}
							}
							- " attribute is in either the "
							a href="#text-(type=text)-state-and-search-state-(type=search)" id="writing-suggestions:text-(type=text)-state-and-search-state-(type=search)" {
								- "Text"
							}
							- ", "
							a href="#text-(type=text)-state-and-search-state-(type=search)" id="writing-suggestions:text-(type=text)-state-and-search-state-(type=search)-2" {
								- "Search"
							}
							- ", "
							a href="#telephone-state-(type=tel)" id="writing-suggestions:telephone-state-(type=tel)" {
								- "Telephone"
							}
							- ", "
							a href="#url-state-(type=url)" id="writing-suggestions:url-state-(type=url)" {
								- "URL"
							}
							- ",\n     or "
							a href="#email-state-(type=email)" id="writing-suggestions:email-state-(type=email)" {
								- "Email"
							}
							- " state and is "
							i id="writing-suggestions:concept-fe-mutable" {
								a href="#concept-fe-mutable" {
									- "mutable"
								}
							}
							- ";"
						}
					}
					li {
						p {
							var {
								- "element"
							}
							- " is a "
							code id="writing-suggestions:the-textarea-element-2" {
								a href="#the-textarea-element" {
									- "textarea"
								}
							}
							- " element that is "
							i id="writing-suggestions:concept-fe-mutable-2" {
								a href="#concept-fe-mutable" {
									- "mutable"
								}
							}
							- "; or"
						}
					}
					li {
						p {
							var {
								- "element"
							}
							- " is an "
							a href="#editing-host" id="writing-suggestions:editing-host-2" {
								- "editing host"
							}
							- " or is\n     "
							a id="writing-suggestions:editable" href="https://w3c.github.io/editing/docs/execCommand/#editable" data-x-internal="editable" {
								- "editable"
							}
							- ","
						}
					}
				}
				- "\n\n    "
				p {
					- "then return false."
				}
				- "\n   "
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " has an "
					a id="writing-suggestions:inclusive-ancestor" href="https://dom.spec.whatwg.org/#concept-tree-inclusive-ancestor" data-x-internal="inclusive-ancestor" {
						- "inclusive ancestor"
					}
					- " with a "
					code id="writing-suggestions:attr-writingsuggestions-7" {
						a href="#attr-writingsuggestions" {
							- "writingsuggestions"
						}
					}
					- " content attribute that's not in the\n   "
					a href="#attr-writingsuggestions-default-state" id="writing-suggestions:attr-writingsuggestions-default-state-2" {
						- "default"
					}
					- " and the nearest such\n   ancestor's "
					code id="writing-suggestions:attr-writingsuggestions-8" {
						a href="#attr-writingsuggestions" {
							- "writingsuggestions"
						}
					}
					- " content attribute is\n   in the "
					a href="#attr-writingsuggestions-false-state" id="writing-suggestions:attr-writingsuggestions-false-state-2" {
						- "false"
					}
					- " state, then return\n   false."
				}
			}
			li {
				p {
					- "Otherwise, return true."
				}
			}
		}
		- "\n\n  "
		p class="note" {
			- "This specification does not define the user interface for writing suggestions.\n  A user agent could offer on-demand suggestions, continuous suggestions as the user types, inline\n  suggestions, autofill-like suggestions in a popup, or could use other interfaces."
		}
		- "\n\n  "
		h4 id="autocapitalization" {
			span class="secno" {
				- "6.8.7"
			}
			- " Autocapitalization"
			a href="#autocapitalization" class="self-link"
		}
		- "\n\n  "
		p {
			- "Some methods of entering text, for example virtual keyboards on mobile devices, and also voice\n  input, often assist users by automatically capitalizing the first letter of sentences (when\n  composing text in a language with this convention). A virtual keyboard that implements\n  autocapitalization might automatically switch to showing uppercase letters (but allow the user to\n  toggle it back to lowercase) when a letter that should be autocapitalized is about to be typed.\n  Other types of input, for example voice input, may perform autocapitalization in a way that does\n  not give users an option to intervene first. The "
			code id="autocapitalization:attr-autocapitalize" {
				a href="#attr-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " attribute allows authors to control such\n  behavior."
		}
		- "\n\n  "
		p {
			- "The "
			code id="autocapitalization:attr-autocapitalize-2" {
				a href="#attr-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " attribute, as typically\n  implemented, does not affect behavior when typing on a physical keyboard. (For this reason, as\n  well as the ability for users to override the autocapitalization behavior in some cases or edit\n  the text after initial input, the attribute must not be relied on for any sort of input\n  validation.)"
		}
		- "\n\n  "
		p {
			- "The "
			code id="autocapitalization:attr-autocapitalize-3" {
				a href="#attr-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " attribute can be used on an "
			a href="#editing-host" id="autocapitalization:editing-host" {
				- "editing host"
			}
			- " to control autocapitalization behavior for the hosted\n  editable region, on an "
			code id="autocapitalization:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " or "
			code id="autocapitalization:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element to control the behavior\n  for inputting text into that element, or on a "
			code id="autocapitalization:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element to control the default\n  behavior for all "
			a href="#category-autocapitalize" id="autocapitalization:category-autocapitalize" {
				- "autocapitalize-and-autocorrect inheriting\n  elements"
			}
			- " associated with the "
			code id="autocapitalization:the-form-element-2" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element.\n\n  "
		}
		p {
			- "The "
			code id="autocapitalization:attr-autocapitalize-4" {
				a href="#attr-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " attribute never causes\n  autocapitalization to be enabled for "
			code id="autocapitalization:the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " elements whose "
			code id="autocapitalization:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute is in one of the "
			a href="#url-state-(type=url)" id="autocapitalization:url-state-(type=url)" {
				- "URL"
			}
			- ", "
			a href="#email-state-(type=email)" id="autocapitalization:email-state-(type=email)" {
				- "Email"
			}
			- ", or "
			a href="#password-state-(type=password)" id="autocapitalization:password-state-(type=password)" {
				- "Password"
			}
			- " states. (This behavior is included\n  in the "
			a href="#used-autocapitalization-hint" id="autocapitalization:used-autocapitalization-hint" {
				- "used autocapitalization hint"
			}
			- " algorithm\n  below.)"
		}
		- "\n\n  "
		p {
			- "The autocapitalization processing model is based on selecting among five\n  "
			dfn id="autocapitalization-hint" {
				- "autocapitalization hints"
			}
			- ", defined as follows:"
		}
		- "\n\n  "
		dl {
			dt {
				dfn id="autocap-hint-default" {
					- "default"
				}
			}
			dd {
				p {
					- "The user agent and input method should make their own determination of whether or not to\n   enable autocapitalization."
				}
			}
			dt {
				dfn id="autocap-hint-none" {
					- "none"
				}
			}
			dd {
				p {
					- "No autocapitalization should be applied (all letters should default to\n   lowercase)."
				}
			}
			dt {
				dfn id="autocap-hint-sentences" {
					- "sentences"
				}
			}
			dd {
				p {
					- "The first letter of each sentence should default to a capital letter; all other letters\n   should default to lowercase."
				}
			}
			dt {
				dfn id="autocap-hint-words" {
					- "words"
				}
			}
			dd {
				p {
					- "The first letter of each word should default to a capital letter; all other letters should\n   default to lowercase."
				}
			}
			dt {
				dfn id="autocap-hint-characters" {
					- "characters"
				}
			}
			dd {
				p {
					- "All letters should default to uppercase."
				}
			}
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/autocapitalize" title="The autocapitalize global attribute is an enumerated attribute that controls whether and how text input is automatically capitalized as it is entered/edited by the user." {
						- "Global_attributes/autocapitalize"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "111+"
						}
					}
					span class="safari no" {
						span {
							- "Safari"
						}
						span {
							- "No"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "43+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie unknown" {
						span {
							- "Internet Explorer"
						}
						span {
							- "?"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "5+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-autocapitalize" data-dfn-type="element-attr" {
				code {
					- "autocapitalize"
				}
			}
			- " attribute is an "
			a href="#enumerated-attribute" id="autocapitalization:enumerated-attribute" {
				- "enumerated\n  attribute"
			}
			- " whose states are the possible "
			a href="#autocapitalization-hint" id="autocapitalization:autocapitalization-hint" {
				- "autocapitalization hints"
			}
			- ". The "
			a href="#autocapitalization-hint" id="autocapitalization:autocapitalization-hint-2" {
				- "autocapitalization hint"
			}
			- " specified by the\n  attribute's state combines with other considerations to form the "
			a href="#used-autocapitalization-hint" id="autocapitalization:used-autocapitalization-hint-2" {
				- "used autocapitalization\n  hint"
			}
			- ", which informs the behavior of the user agent. The keywords for this attribute and\n  their state mappings are as follows:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- " Keyword\n     "
					}
					th {
						- " State\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-off" data-dfn-type="attr-value" {
							code {
								- "off"
							}
						}
						- "\n\n     "
					}
					td rowspan="2" {
						a href="#autocap-hint-none" id="autocapitalization:autocap-hint-none" {
							- "none"
						}
						- "\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-none" data-dfn-type="attr-value" {
							code {
								- "none"
							}
						}
						- "\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-on" data-dfn-type="attr-value" {
							code {
								- "on"
							}
						}
						- "\n\n     "
					}
					td rowspan="2" {
						a href="#autocap-hint-sentences" id="autocapitalization:autocap-hint-sentences" {
							- "sentences"
						}
						- "\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-sentences" data-dfn-type="attr-value" {
							code {
								- "sentences"
							}
						}
						- "\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-words" data-dfn-type="attr-value" {
							code {
								- "words"
							}
						}
						- "\n\n     "
					}
					td {
						a href="#autocap-hint-words" id="autocapitalization:autocap-hint-words" {
							- "words"
						}
						- "\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" id="attr-autocapitalize-characters" data-dfn-type="attr-value" {
							code {
								- "characters"
							}
						}
						- "\n\n     "
					}
					td {
						a href="#autocap-hint-characters" id="autocapitalization:autocap-hint-characters" {
							- "characters"
						}
						- "\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="autocapitalization:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " is the "
			a href="#autocap-hint-default" id="autocapitalization:autocap-hint-default" {
				- "default"
			}
			- " state, and its "
			i id="autocapitalization:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " is the "
			a href="#autocap-hint-sentences" id="autocapitalization:autocap-hint-sentences-2" {
				- "sentences"
			}
			- "\n  state.\n\n  "
		}
		dl class="domintro" {
			dt {
				code {
					var {
						- "element"
					}
					- "."
					a href="#dom-autocapitalize" id="dom-autocapitalize-dev" {
						- "autocapitalize"
					}
					- " [ = "
					var {
						- "value"
					}
					- " ]"
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the current autocapitalization state for the element, or an empty string if it hasn't\n    been set. Note that for "
					code id="autocapitalization:the-input-element-3" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " and "
					code id="autocapitalization:the-textarea-element-2" {
						a href="#the-textarea-element" {
							- "textarea"
						}
					}
					- " elements that inherit their\n    state from a "
					code id="autocapitalization:the-form-element-3" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, this will return the autocapitalization state of the\n    "
					code id="autocapitalization:the-form-element-4" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, but for an element in an editable region, this will not return the\n    autocapitalization state of the editing host (unless this element is, in fact, the "
					a href="#editing-host" id="autocapitalization:editing-host-2" {
						- "editing\n    host"
					}
					- ")."
				}
				- "\n\n    "
				p {
					- "Can be set, to set the "
					code id="autocapitalization:attr-autocapitalize-5" {
						a href="#attr-autocapitalize" {
							- "autocapitalize"
						}
					}
					- " content\n    attribute (and thereby change the autocapitalization behavior for the element)."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "To compute the "
			dfn id="own-autocapitalization-hint" {
				- "own autocapitalization hint"
			}
			- " of an element "
			var {
				- "element"
			}
			- ", run the\n  following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the "
					code id="autocapitalization:attr-autocapitalize-6" {
						a href="#attr-autocapitalize" {
							- "autocapitalize"
						}
					}
					- " content attribute is\n   present on "
					var {
						- "element"
					}
					- ", and its value is not the empty string, return the state of the\n   attribute."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					a href="#category-autocapitalize" id="autocapitalization:category-autocapitalize-2" {
						- "autocapitalize-and-autocorrect inheriting\n   element"
					}
					- " and has a non-null "
					a href="#form-owner" id="autocapitalization:form-owner" {
						- "form owner"
					}
					- ", return the "
					a href="#own-autocapitalization-hint" id="autocapitalization:own-autocapitalization-hint" {
						- "own\n   autocapitalization hint"
					}
					- " of "
					var {
						- "element"
					}
					- "'s "
					a href="#form-owner" id="autocapitalization:form-owner-2" {
						- "form owner"
					}
					- "."
				}
			}
			li {
				p {
					- "Return "
					a href="#autocap-hint-default" id="autocapitalization:autocap-hint-default-2" {
						- "default"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLElement" id="dom-autocapitalize" data-dfn-type="attribute" {
				code {
					- "autocapitalize"
				}
			}
			- " getter steps are to:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "state"
					}
					- " be the "
					a href="#own-autocapitalization-hint" id="autocapitalization:own-autocapitalization-hint-2" {
						- "own autocapitalization hint"
					}
					- " of\n   "
					a id="autocapitalization:this" href="https://webidl.spec.whatwg.org/#this" data-x-internal="this" {
						- "this"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "state"
					}
					- " is "
					a href="#autocap-hint-default" id="autocapitalization:autocap-hint-default-3" {
						- "default"
					}
					- ", then return the\n   empty string."
				}
			}
			li {
				p {
					- "If "
					var {
						- "state"
					}
					- " is "
					a href="#autocap-hint-none" id="autocapitalization:autocap-hint-none-2" {
						- "none"
					}
					- ", then return \""
					code id="autocapitalization:attr-autocapitalize-none" {
						a href="#attr-autocapitalize-none" {
							- "none"
						}
					}
					- "\"."
				}
			}
			li {
				p {
					- "If "
					var {
						- "state"
					}
					- " is "
					a href="#autocap-hint-sentences" id="autocapitalization:autocap-hint-sentences-3" {
						- "sentences"
					}
					- ", then return\n   \""
					code id="autocapitalization:attr-autocapitalize-sentences" {
						a href="#attr-autocapitalize-sentences" {
							- "sentences"
						}
					}
					- "\"."
				}
			}
			li {
				p {
					- "Return the keyword value corresponding to "
					var {
						- "state"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			code id="autocapitalization:dom-autocapitalize" {
				a href="#dom-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " setter steps are to set the "
			code id="autocapitalization:attr-autocapitalize-7" {
				a href="#attr-autocapitalize" {
					- "autocapitalize"
				}
			}
			- " content attribute to the given value."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "User agents that support customizable autocapitalization behavior for a text input method and\n  wish to allow web developers to control this functionality should, during text input into an\n  element, compute the "
			dfn id="used-autocapitalization-hint" {
				- "used autocapitalization hint"
			}
			- " for the element. This will be an\n  "
			a href="#autocapitalization-hint" id="autocapitalization:autocapitalization-hint-3" {
				- "autocapitalization hint"
			}
			- " that describes the recommended autocapitalization behavior\n  for text input into the element."
		}
		- "\n\n  "
		p {
			- "User agents or input methods may choose to ignore or override the "
			a href="#used-autocapitalization-hint" id="autocapitalization:used-autocapitalization-hint-3" {
				- "used autocapitalization\n  hint"
			}
			- " in certain circumstances."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#used-autocapitalization-hint" id="autocapitalization:used-autocapitalization-hint-4" {
				- "used autocapitalization hint"
			}
			- " for an element "
			var {
				- "element"
			}
			- " is computed\n  using the following algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					code id="autocapitalization:the-input-element-4" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " element whose "
					code id="autocapitalization:attr-input-type-2" {
						a href="#attr-input-type" {
							- "type"
						}
					}
					- " attribute is in one of the "
					a href="#url-state-(type=url)" id="autocapitalization:url-state-(type=url)-2" {
						- "URL"
					}
					- ", "
					a href="#email-state-(type=email)" id="autocapitalization:email-state-(type=email)-2" {
						- "Email"
					}
					- ", or\n   "
					a href="#password-state-(type=password)" id="autocapitalization:password-state-(type=password)-2" {
						- "Password"
					}
					- " states, then return "
					a href="#autocap-hint-default" id="autocapitalization:autocap-hint-default-4" {
						- "default"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					code id="autocapitalization:the-input-element-5" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " element or a "
					code id="autocapitalization:the-textarea-element-3" {
						a href="#the-textarea-element" {
							- "textarea"
						}
					}
					- " element,\n   then return "
					var {
						- "element"
					}
					- "'s "
					a href="#own-autocapitalization-hint" id="autocapitalization:own-autocapitalization-hint-3" {
						- "own autocapitalization hint"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					a href="#editing-host" id="autocapitalization:editing-host-3" {
						- "editing host"
					}
					- " or an "
					a id="autocapitalization:editable" href="https://w3c.github.io/editing/docs/execCommand/#editable" data-x-internal="editable" {
						- "editable"
					}
					- " element,\n   then return the "
					a href="#own-autocapitalization-hint" id="autocapitalization:own-autocapitalization-hint-4" {
						- "own autocapitalization hint"
					}
					- " of the "
					a id="autocapitalization:editing-host-of" href="https://w3c.github.io/editing/docs/execCommand/#editing-host-of" data-x-internal="editing-host-of" {
						- "editing host of"
					}
					- "\n   "
					var {
						- "element"
					}
					- "."
				}
			}
			li {
				p {
					a id="autocapitalization:assert" href="https://infra.spec.whatwg.org/#assert" data-x-internal="assert" {
						- "Assert"
					}
					- ": this step is never reached, since text input only occurs in elements\n   that meet one of the above criteria."
				}
			}
		}
		- "\n\n  \n\n\n  "
		h4 id="autocorrection" {
			span class="secno" {
				- "6.8.8"
			}
			- " Autocorrection"
			a href="#autocorrection" class="self-link"
		}
		- "\n\n  "
		p {
			- "Some methods of entering text assist users by automatically correcting misspelled words while\n  typing, a process also known as autocorrection. User agents can support autocorrection of editable\n  text, either in form controls (such as the value of "
			code id="autocorrection:the-textarea-element" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " elements), or in\n  elements in an "
			a href="#editing-host" id="autocorrection:editing-host" {
				- "editing host"
			}
			- " (e.g., using "
			code id="autocorrection:attr-contenteditable" {
				a href="#attr-contenteditable" {
					- "contenteditable"
				}
			}
			- "). Autocorrection may be accompanied by user\n  interfaces indicating that text is about to be autocorrected or has been autocorrected, and is\n  commonly performed when inserting punctuation characters, spaces, or new paragraphs after\n  misspelled words. The "
			code id="autocorrection:attr-autocorrect" {
				a href="#attr-autocorrect" {
					- "autocorrect"
				}
			}
			- " attribute allows authors\n  to control such behavior."
		}
		- "\n\n  "
		p {
			- "The "
			code id="autocorrection:attr-autocorrect-2" {
				a href="#attr-autocorrect" {
					- "autocorrect"
				}
			}
			- " attribute can be used on an editing host\n  to control autocorrection behavior for the hosted editable region, on an "
			code id="autocorrection:the-input-element" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " or\n  "
			code id="autocorrection:the-textarea-element-2" {
				a href="#the-textarea-element" {
					- "textarea"
				}
			}
			- " element to control the behavior when inserting text into that element, or on\n  a "
			code id="autocorrection:the-form-element" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element to control the default behavior for all "
			a href="#category-autocapitalize" id="autocorrection:category-autocapitalize" {
				- "autocapitalize-and-autocorrect inheriting\n  elements"
			}
			- " associated with the "
			code id="autocorrection:the-form-element-2" {
				a href="#the-form-element" {
					- "form"
				}
			}
			- " element."
		}
		- "\n\n  "
		p {
			- "The "
			code id="autocorrection:attr-autocorrect-3" {
				a href="#attr-autocorrect" {
					- "autocorrect"
				}
			}
			- " attribute never causes autocorrection to\n  be enabled for "
			code id="autocorrection:the-input-element-2" {
				a href="#the-input-element" {
					- "input"
				}
			}
			- " elements whose "
			code id="autocorrection:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- "\n  attribute is in one of the "
			a href="#url-state-(type=url)" id="autocorrection:url-state-(type=url)" {
				- "URL"
			}
			- ", "
			a href="#email-state-(type=email)" id="autocorrection:email-state-(type=email)" {
				- "E-mail"
			}
			- ", or "
			a href="#password-state-(type=password)" id="autocorrection:password-state-(type=password)" {
				- "Password"
			}
			- " states. (This behavior is included\n  in the "
			a href="#used-autocorrection-state" id="autocorrection:used-autocorrection-state" {
				- "used autocorrection state"
			}
			- " algorithm below.)"
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-autocorrect" data-dfn-type="element-attr" {
				code {
					- "autocorrect"
				}
			}
			- " attribute is an enumerated attribute with the\n  following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/autocorrect" id="attr-autocorrect-on" data-dfn-type="attr-value" {
							code {
								- "on"
							}
						}
						- "\n     "
					}
					td rowspan="2" {
						dfn id="concept-autocorrection-on" {
							- "on"
						}
						- "\n     "
					}
					td rowspan="2" {
						- "The user agent is permitted to automatically correct spelling errors while the user types.\n     Whether spelling is automatically corrected while typing left is for the user agent to decide,\n     and may depend on the element as well as the user's preferences.\n    "
					}
				}
				tr {
					td {
						- "(the empty string)\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocorrect" id="attr-autocorrect-off" data-dfn-type="attr-value" {
							code {
								- "off"
							}
						}
						- "\n     "
					}
					td {
						dfn id="concept-autocorrection-off" {
							- "off"
						}
						- "\n     "
					}
					td {
						- "The user agent is not allowed to automatically correct spelling while the user types.\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="autocorrection:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " and "
			i id="autocorrection:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " are both the "
			a href="#concept-autocorrection-on" id="autocorrection:concept-autocorrection-on" {
				- "on"
			}
			- " state."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLElement" id="dom-autocorrect" data-dfn-type="attribute" {
				code {
					- "autocorrect"
				}
			}
			- "\n  getter steps are: return true if the element's "
			a href="#used-autocorrection-state" id="autocorrection:used-autocorrection-state-2" {
				- "used autocorrection state"
			}
			- " is "
			a href="#concept-autocorrection-on" id="autocorrection:concept-autocorrection-on-2" {
				- "on"
			}
			- " and false if the element's "
			a href="#used-autocorrection-state" id="autocorrection:used-autocorrection-state-3" {
				- "used autocorrection\n  state"
			}
			- " is "
			a href="#concept-autocorrection-off" id="autocorrection:concept-autocorrection-off" {
				- "off"
			}
			- ". The setter steps are: if the\n  given value is true, then the element's "
			code id="autocorrection:attr-autocorrect-4" {
				a href="#attr-autocorrect" {
					- "autocorrect"
				}
			}
			- "\n  attribute must be set to \""
			code {
				- "on"
			}
			- "\"; otherwise it must be set to \""
			code {
				- "off"
			}
			- "\"."
		}
		- "\n\n  "
		p {
			- "To compute the "
			dfn id="used-autocorrection-state" {
				- "used autocorrection state"
			}
			- " of an element "
			var {
				- "element"
			}
			- ", run these\n  steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					code id="autocorrection:the-input-element-3" {
						a href="#the-input-element" {
							- "input"
						}
					}
					- " element whose "
					code id="autocorrection:attr-input-type-2" {
						a href="#attr-input-type" {
							- "type"
						}
					}
					- " attribute is in one of the "
					a href="#url-state-(type=url)" id="autocorrection:url-state-(type=url)-2" {
						- "URL"
					}
					- ", "
					a href="#email-state-(type=email)" id="autocorrection:email-state-(type=email)-2" {
						- "E-mail"
					}
					- ", or\n   "
					a href="#password-state-(type=password)" id="autocorrection:password-state-(type=password)-2" {
						- "Password"
					}
					- " states, then return "
					a href="#concept-autocorrection-off" id="autocorrection:concept-autocorrection-off-2" {
						- "off"
					}
					- "."
				}
			}
			li {
				p {
					- "If the "
					code id="autocorrection:attr-autocorrect-5" {
						a href="#attr-autocorrect" {
							- "autocorrect"
						}
					}
					- " content attribute is present on\n   "
					var {
						- "element"
					}
					- ", then return the state of the attribute."
				}
			}
			li {
				p {
					- "If "
					var {
						- "element"
					}
					- " is an "
					a href="#category-autocapitalize" id="autocorrection:category-autocapitalize-2" {
						- "autocapitalize-and-autocorrect inheriting\n   element"
					}
					- " and has a non-null "
					a href="#form-owner" id="autocorrection:form-owner" {
						- "form owner"
					}
					- ", then return the state of\n   "
					var {
						- "element"
					}
					- "'s "
					a href="#form-owner" id="autocorrection:form-owner-2" {
						- "form owner"
					}
					- "'s "
					code id="autocorrection:attr-autocorrect-6" {
						a href="#attr-autocorrect" {
							- "autocorrect"
						}
					}
					- "\n   attribute."
				}
			}
			li {
				p {
					- "Return "
					a href="#concept-autocorrection-on" id="autocorrection:concept-autocorrection-on-3" {
						- "on"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		dl class="domintro" {
			dt {
				var {
					- "element"
				}
				- " . "
				code id="dom-autocorrect-dev" {
					a href="#dom-autocorrect" {
						- "autocorrect"
					}
				}
			}
			dd {
				p {
					- "Returns the autocorrection behavior of the element. Note that for "
					a href="#category-autocapitalize" id="autocorrection:category-autocapitalize-3" {
						- "autocapitalize-and-autocorrect inheriting\n   elements"
					}
					- " that inherit their state from a "
					code id="autocorrection:the-form-element-3" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, this will return the\n   autocorrection behavior of the "
					code id="autocorrection:the-form-element-4" {
						a href="#the-form-element" {
							- "form"
						}
					}
					- " element, but for an element in an editable\n   region, this will not return the autocorrection behavior of the "
					a href="#editing-host" id="autocorrection:editing-host-2" {
						- "editing host"
					}
					- " (unless\n   this element is, in fact, the "
					a href="#editing-host" id="autocorrection:editing-host-3" {
						- "editing host"
					}
					- ")."
				}
			}
			dt {
				var {
					- "element"
				}
				- " . "
				code id="autocorrection:dom-autocorrect" {
					a href="#dom-autocorrect" {
						- "autocorrect"
					}
				}
				- " =\n   "
				var {
					- "value"
				}
			}
			dd {
				p {
					- "Updates the "
					code id="autocorrection:attr-autocorrect-7" {
						a href="#attr-autocorrect" {
							- "autocorrect"
						}
					}
					- " content attribute (and\n   thereby changes the autocorrection behavior of the element)."
				}
			}
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "The "
				code id="autocorrection:the-input-element-4" {
					a href="#the-input-element" {
						- "input"
					}
				}
				- " element in the following example would not allow autocorrection, since\n   it does not have an "
				code id="autocorrection:attr-autocorrect-8" {
					a href="#attr-autocorrect" {
						- "autocorrect"
					}
				}
				- " content attribute and\n   therefore inherits from the "
				code id="autocorrection:the-form-element-5" {
					a href="#the-form-element" {
						- "form"
					}
				}
				- " element, which has an attribute of \""
				code id="autocorrection:attr-autocorrect-off" {
					a href="#attr-autocorrect-off" {
						- "off"
					}
				}
				- "\". However, the "
				code id="autocorrection:the-textarea-element-3" {
					a href="#the-textarea-element" {
						- "textarea"
