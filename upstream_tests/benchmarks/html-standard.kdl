		}
		- "\n\n  "
		p {
			- "The "
			a id="mathml:mathml-math" href="https://w3c.github.io/mathml-core/#the-top-level-math-element" data-x-internal="mathml-math" {
				- "MathML "
				code {
					- "math"
				}
			}
			- " element falls into the "
			a href="#embedded-content-category" id="mathml:embedded-content-category" {
				- "embedded content"
			}
			- ",\n  "
			a href="#phrasing-content-2" id="mathml:phrasing-content-2" {
				- "phrasing content"
			}
			- ", "
			a href="#flow-content-2" id="mathml:flow-content-2" {
				- "flow content"
			}
			- ", and "
			a href="#palpable-content-2" id="mathml:palpable-content-2" {
				- "palpable content"
			}
			- "\n  categories for the purposes of the content models in this specification."
		}
		- "\n\n  "
		p {
			- "When the "
			a id="mathml:mathml-annotation-xml" href="https://w3c.github.io/mathml-core/#dfn-annotation-xml" data-x-internal="mathml-annotation-xml" {
				- "MathML "
				code {
					- "annotation-xml"
				}
			}
			- " element contains elements from the\n  "
			a id="mathml:html-namespace-2" href="https://infra.spec.whatwg.org/#html-namespace" data-x-internal="html-namespace-2" {
				- "HTML namespace"
			}
			- ", such elements must all be "
			a href="#flow-content-2" id="mathml:flow-content-2-2" {
				- "flow content"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When the MathML token elements ("
			code id="mathml:mathml-mi" {
				a data-x-internal="mathml-mi" href="https://w3c.github.io/mathml-core/#the-mi-element" {
					- "mi"
				}
			}
			- ", "
			code id="mathml:mathml-mo" {
				a data-x-internal="mathml-mo" href="https://w3c.github.io/mathml-core/#operator-fence-separator-or-accent-mo" {
					- "mo"
				}
			}
			- ", "
			code id="mathml:mathml-mn" {
				a data-x-internal="mathml-mn" href="https://w3c.github.io/mathml-core/#number-mn" {
					- "mn"
				}
