		- "\n\n  "
		p {
			- "When rendering "
			code id="lists:the-li-element" {
				a href="#the-li-element" {
					- "li"
				}
			}
			- " elements, non-CSS user agents are expected to use the\n  "
			a href="#ordinal-value" id="lists:ordinal-value" {
				- "ordinal value"
			}
			- " of the "
			code id="lists:the-li-element-2" {
				a href="#the-li-element" {
					- "li"
				}
			}
			- " element to render the counter in the list item\n  marker."
		}
		- "\n\n  "
		p id="css-list-rendering" {
			- "For CSS user agents, some aspects of rendering "
			a href="https://drafts.csswg.org/css-lists/#list-item" id="lists:css-list-item" data-x-internal="css-list-item" {
				- "list items"
			}
			- " are defined by the "
			cite {
				- "CSS Lists"
			}
			- " specification.\n  Additionally, the following attribute mappings are expected to apply: "
			a href="#refsCSSLISTS" {
				- "[CSSLISTS]"
			}
		}
		- "\n\n  "
		p {
			- "When an "
			code id="lists:the-li-element-3" {
				a href="#the-li-element" {
					- "li"
				}
			}
			- " element has a "
			code id="lists:attr-li-value" {
				a href="#attr-li-value" {
					- "value"
				}
			}
			- " attribute, and parsing that attribute's value using the\n  "
			a href="#rules-for-parsing-integers" id="lists:rules-for-parsing-integers" {
				- "rules for parsing integers"
			}
			- " doesn't generate an error, the user agent is expected to\n  use the parsed value "
			var {
				- "value"
			}
			- " as a "
			a href="#presentational-hints" id="lists:presentational-hints-2" {
				- "presentational\n  hint"
			}
			- " for the "
			a id="lists:'counter-set'" href="https://drafts.csswg.org/css-lists/#propdef-counter-set" data-x-internal="'counter-set'" {
				- "'counter-set'"
			}
			- " property of the form "
			code {
				- "list-item\n  "
				var {
					- "value"
				}
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When an "
			code id="lists:the-ol-element" {
				a href="#the-ol-element" {
					- "ol"
				}
			}
			- " element has a "
			code id="lists:attr-ol-start" {
				a href="#attr-ol-start" {
					- "start"
				}
			}
			- "\n  attribute or a "
			code id="lists:attr-ol-reversed" {
				a href="#attr-ol-reversed" {
					- "reversed"
				}
			}
			- " attribute, or both, the user agent\n  is expected to use the following steps to treat the attributes as a "
			a href="#presentational-hints" id="lists:presentational-hints-3" {
				- "presentational hint"
			}
			- " for the "
			a id="lists:'counter-reset'" href="https://drafts.csswg.org/css-lists/#propdef-counter-reset" data-x-internal="'counter-reset'" {
				- "'counter-reset'"
			}
			- " property:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "value"
					}
					- " be null."
				}
			}
			li {
				p {
					- "If the element has a "
					code id="lists:attr-ol-start-2" {
						a href="#attr-ol-start" {
							- "start"
						}
					}
					- " attribute, then set\n   "
					var {
						- "value"
					}
					- " to the result of parsing the attribute's value using the "
					a href="#rules-for-parsing-integers" id="lists:rules-for-parsing-integers-2" {
						- "rules for\n   parsing integers"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If the element has a "
					code id="lists:attr-ol-reversed-2" {
						a href="#attr-ol-reversed" {
							- "reversed"
						}
					}
					- " attribute, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "value"
							}
							- " is an integer, then increment "
							var {
								- "value"
							}
							- " by 1 and return\n     "
							code {
								- "reversed(list-item) "
								var {
									- "value"
								}
							}
							- "."
						}
					}
					li {
						- "\n      "
						p {
							- "Otherwise, return "
							code {
								- "reversed(list-item)"
							}
							- "."
						}
						- "\n\n      "
						p class="note" {
							- "Either the "
							code id="lists:attr-ol-start-3" {
								a href="#attr-ol-start" {
									- "start"
								}
							}
							- " attribute was absent, or\n      parsing its value resulted in an error."
						}
						- "\n     "
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Otherwise:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "If "
							var {
								- "value"
							}
							- " is an integer, then decrement "
							var {
								- "value"
							}
							- " by 1 and return\n     "
							code {
								- "list-item "
								var {
									- "value"
								}
							}
							- "."
						}
					}
					li {
						p {
							- "Otherwise, there is no "
							a href="#presentational-hints" id="lists:presentational-hints-4" {
								- "presentational\n     hint"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
