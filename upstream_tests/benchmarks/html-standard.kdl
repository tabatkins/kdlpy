		}
		- "\n\n  "
		pre {
			- "data: This is the first message.\n\ndata: This is the second message, it\ndata: has two lines.\n\ndata: This is the third message."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "Authors can separate events by using different event types. Here is a stream that has two event\n  types, \"add\" and \"remove\":"
		}
		- "\n\n  "
		pre {
			- "event: add\ndata: 73857293\n\nevent: remove\ndata: 2153\n\nevent: add\ndata: 113411"
		}
		- "\n\n  "
		p {
			- "The script to handle such a stream would look like this (where "
			code {
				- "addHandler"
			}
			- "\n  and "
			code {
				- "removeHandler"
			}
			- " are functions that take one argument, the event):"
		}
		- "\n\n  "
		pre {
			code class="js" {
				c- a="" {
					- "var"
				}
				- " source "
				c- o="" {
					- "="
				}
