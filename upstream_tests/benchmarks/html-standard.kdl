					a href="#content-type" id="downloading-resources:content-type-2" {
						- "Content-Type metadata"
					}
					- " is consistent\n   with the type given by "
					var {
						- "filename"
					}
					- "'s "
					a href="#concept-extension" id="downloading-resources:concept-extension-4" {
						- "extension"
					}
					- "),\n   then return "
					var {
						- "filename"
					}
					- " as the filename."
