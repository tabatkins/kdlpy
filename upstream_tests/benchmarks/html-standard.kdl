						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "4+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android yes" {
						span {
							- "WebView Android"
						}
						span {
							- "37+"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="input" id="attr-input-step" data-dfn-type="element-attr" {
				code {
					- "step"
				}
			}
			- " attribute\n  indicates the granularity that is expected (and required) of the "
			a href="#concept-fe-value" id="the-step-attribute:concept-fe-value" {
				- "value"
			}
			- " or "
			a href="#concept-fe-values" id="the-step-attribute:concept-fe-values" {
				- "values"
			}
			- ", by\n  limiting the allowed values. The section that defines the "
			code id="the-step-attribute:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- " attribute's current state also defines the "
			dfn id="concept-input-step-default" {
				- "default step"
			}
			- ", the "
			dfn id="concept-input-step-scale" {
				- "step scale factor"
			}
			- ", and in some cases the "
			dfn id="concept-input-step-default-base" {
				- "default step base"
			}
			- ", which are used in processing the\n  attribute as described below."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-step-attribute:attr-input-step-2" {
				a href="#attr-input-step" {
					- "step"
				}
			}
			- " attribute, if specified, must either have a\n  value that is a "
			a href="#valid-floating-point-number" id="the-step-attribute:valid-floating-point-number" {
				- "valid floating-point number"
			}
			- " that "
			a href="#rules-for-parsing-floating-point-number-values" id="the-step-attribute:rules-for-parsing-floating-point-number-values" {
				- "parses"
			}
			- " to a number that is greater than zero, or must have a\n  value that is an "
			a id="the-step-attribute:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII case-insensitive"
			}
			- " match for the string \""
			code {
				- "any"
			}
			- "\"."
		}
		- "\n\n  \n\n  "
		p {
			- "The attribute provides the "
			dfn id="concept-input-step" {
				- "allowed value step"
			}
			- " for the\n  element, as follows:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the attribute does not "
					a href="#concept-input-apply" id="the-step-attribute:concept-input-apply" {
						- "apply"
					}
					- ", then there is\n   no "
					a href="#concept-input-step" id="the-step-attribute:concept-input-step" {
						- "allowed value step"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, if the attribute is absent, then the "
					a href="#concept-input-step" id="the-step-attribute:concept-input-step-2" {
						- "allowed\n   value step"
					}
					- " is the "
					a href="#concept-input-step-default" id="the-step-attribute:concept-input-step-default" {
						- "default step"
					}
					- " multiplied\n   by the "
					a href="#concept-input-step-scale" id="the-step-attribute:concept-input-step-scale" {
						- "step scale factor"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, if the attribute's value is an "
					a id="the-step-attribute:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for the\n   string \""
					code {
						- "any"
					}
					- "\", then there is no "
					a href="#concept-input-step" id="the-step-attribute:concept-input-step-3" {
						- "allowed\n   value step"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, if the "
					a href="#rules-for-parsing-floating-point-number-values" id="the-step-attribute:rules-for-parsing-floating-point-number-values-2" {
						- "rules for parsing floating-point number values"
					}
					- ", when they are\n   applied to the attribute's value, return an error, zero, or a number less than zero, then the\n   "
					a href="#concept-input-step" id="the-step-attribute:concept-input-step-4" {
						- "allowed value step"
					}
					- " is the "
					a href="#concept-input-step-default" id="the-step-attribute:concept-input-step-default-2" {
						- "default step"
					}
					- " multiplied by the "
					a href="#concept-input-step-scale" id="the-step-attribute:concept-input-step-scale-2" {
						- "step scale factor"
					}
					- "."
				}
			}
			li {
				p {
					- "Otherwise, the "
					a href="#concept-input-step" id="the-step-attribute:concept-input-step-5" {
						- "allowed value step"
					}
					- " is the number\n   returned by the "
					a href="#rules-for-parsing-floating-point-number-values" id="the-step-attribute:rules-for-parsing-floating-point-number-values-3" {
						- "rules for parsing floating-point number values"
					}
					- " when they are applied\n   to the attribute's value, multiplied by the "
					a href="#concept-input-step-scale" id="the-step-attribute:concept-input-step-scale-3" {
						- "step scale\n   factor"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="concept-input-min-zero" {
				- "step base"
			}
			- " is the value returned by the following\n  algorithm:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "If the element has a "
					code id="the-step-attribute:attr-input-min" {
						a href="#attr-input-min" {
							- "min"
						}
					}
					- " content attribute, and the\n   result of applying the "
					a href="#concept-input-value-string-number" id="the-step-attribute:concept-input-value-string-number" {
						- "algorithm to convert a\n   string to a number"
					}
					- " to the value of the "
					code id="the-step-attribute:attr-input-min-2" {
						a href="#attr-input-min" {
							- "min"
						}
					}
					- " content\n   attribute is not an error, then return that result."
				}
			}
			li {
				p {
					- "If the element has a "
					code id="the-step-attribute:attr-input-value" {
						a href="#attr-input-value" {
							- "value"
						}
					}
					- " content attribute, and\n   the result of applying the "
					a href="#concept-input-value-string-number" id="the-step-attribute:concept-input-value-string-number-2" {
						- "algorithm to convert\n   a string to a number"
					}
					- " to the value of the "
					code id="the-step-attribute:attr-input-value-2" {
						a href="#attr-input-value" {
							- "value"
						}
					}
					- "\n   content attribute is not an error, then return that result."
				}
			}
			li {
				p {
					- "If a "
					a href="#concept-input-step-default-base" id="the-step-attribute:concept-input-step-default-base" {
						- "default step base"
					}
					- " is defined for\n   this element given its "
					code id="the-step-attribute:attr-input-type-2" {
						a href="#attr-input-type" {
							- "type"
						}
					}
					- " attribute's state, then return\n   it."
				}
				- "\n\n   "
			}
			li {
				p {
					- "Return zero."
				}
			}
		}
		- "\n\n  "
		p {
			strong {
				- "Constraint validation"
			}
			- ": When the element has an "
			a href="#concept-input-step" id="the-step-attribute:concept-input-step-6" {
				- "allowed value step"
			}
			- ", and the result of applying the "
			a href="#concept-input-value-string-number" id="the-step-attribute:concept-input-value-string-number-3" {
				- "algorithm to convert a string to a number"
			}
			- " to\n  the string given by the element's "
			a href="#concept-fe-value" id="the-step-attribute:concept-fe-value-2" {
				- "value"
			}
			- " is a number, and\n  that number subtracted from the "
			a href="#concept-input-min-zero" id="the-step-attribute:concept-input-min-zero" {
				- "step base"
			}
			- " is not an\n  integral multiple of the "
			a href="#concept-input-step" id="the-step-attribute:concept-input-step-7" {
				- "allowed value step"
			}
			- ", the\n  element is "
			a href="#suffering-from-a-step-mismatch" id="the-step-attribute:suffering-from-a-step-mismatch" {
				- "suffering from a step mismatch"
			}
			- "."
		}
		- "\n\n  \n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "The following range control only accepts values in the range 0..1, and allows 256 steps in\n   that range:"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "name"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "opacity"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "range"
					}
					- " "
					c- e="" {
						- "min"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "0"
					}
					- " "
					c- e="" {
						- "max"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "1"
					}
					- " "
					c- e="" {
						- "step"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "0.00392156863"
					}
					c- p="" {
						- ">"
					}
				}
			}
			- "\n\n  "
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "The following control allows any time in the day to be selected, with any accuracy (e.g.\n   thousandth-of-a-second accuracy or more):"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
					}
					c- f="" {
						- "input"
					}
					- " "
					c- e="" {
						- "name"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "favtime"
					}
					- " "
					c- e="" {
						- "type"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "time"
					}
					- " "
					c- e="" {
						- "step"
					}
					c- o="" {
						- "="
					}
					c- s="" {
						- "any"
					}
					c- p="" {
						- ">"
