						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-search" data-dfn-type="attr-value" {
							code {
								- "search"
							}
						}
						- "\n\n     "
					}
					td {
						- "The user agent should present a cue for the operation 'search', typically\n     taking the user to the results of searching for the text they have typed.\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/enterkeyhint" id="attr-enterkeyhint-keyword-send" data-dfn-type="attr-value" {
							code {
								- "send"
							}
						}
						- "\n\n     "
					}
					td {
						- " The user agent should present a cue for the operation 'send', typically\n     delivering the text to its target.\n  "
					}
				}
			}
		}
		- "\n\n  \n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/enterKeyHint" title="The enterKeyHint property is an enumerated property defining what action label (or icon) to present for the enter key on virtual keyboards. It reflects the enterkeyhint HTML global attribute and is an enumerated property, only accepting the following values as a string:" {
						- "HTMLElement/enterKeyHint"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "94+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "13.1+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "77+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="ElementContentEditable" id="dom-enterkeyhint" data-dfn-type="attribute" {
				code {
					- "enterKeyHint"
				}
			}
			- " IDL attribute must "
			a href="#reflect" id="input-modalities:-the-enterkeyhint-attribute:reflect" {
				- "reflect"
			}
			- " the\n  "
			code id="input-modalities:-the-enterkeyhint-attribute:attr-enterkeyhint-3" {
				a href="#attr-enterkeyhint" {
					- "enterkeyhint"
				}
			}
			- " content attribute, "
			a href="#limited-to-only-known-values" id="input-modalities:-the-enterkeyhint-attribute:limited-to-only-known-values" {
				- "limited to only\n  known values"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "When "
			code id="input-modalities:-the-enterkeyhint-attribute:attr-enterkeyhint-4" {
				a href="#attr-enterkeyhint" {
					- "enterkeyhint"
				}
			}
			- " is unspecified (or is in a state not\n  supported by the user agent), the user agent should determine the default action label (or icon)\n  to present. Contextual information such as the "
			code id="input-modalities:-the-enterkeyhint-attribute:attr-inputmode" {
				a href="#attr-inputmode" {
					- "inputmode"
				}
			}
			- ",\n  "
			code id="input-modalities:-the-enterkeyhint-attribute:attr-input-type" {
				a href="#attr-input-type" {
					- "type"
				}
			}
			- ", or "
			code id="input-modalities:-the-enterkeyhint-attribute:attr-input-pattern" {
				a href="#attr-input-pattern" {
					- "pattern"
				}
			}
			- "\n  attributes should be used to determine which action label (or icon) to present on the virtual\n  keyboard."
		}
		- "\n\n  \n\n  "
		h3 id="find-in-page" {
			span class="secno" {
				- "6.9"
			}
			- " Find-in-page"
			a href="#find-in-page" class="self-link"
		}
		- "\n\n  "
		h4 id="introduction-10" {
			span class="secno" {
				- "6.9.1"
			}
			- " Introduction"
			a href="#introduction-10" class="self-link"
		}
		- "\n\n  "
		p {
			- "This section defines "
			dfn id="find-in-page-2" {
				- "find-in-page"
			}
			- " — a common user-agent mechanism which allows users\n  to search through the contents of the page for particular information."
		}
		- "\n\n  "
		p {
			- "Access to the "
			a href="#find-in-page-2" id="introduction-10:find-in-page-2" {
				- "find-in-page"
			}
			- " feature is provided via a "
			dfn id="find-in-page-interface" {
				- "find-in-page\n  interface"
			}
			- ". This is a user-agent provided user interface, which allows the user to specify\n  input and the parameters of the search. This interface can appear as a result of a shortcut or a\n  menu selection."
		}
		- "\n\n  "
		p {
			- "A combination of text input and settings in the "
			a href="#find-in-page-interface" id="introduction-10:find-in-page-interface" {
				- "find-in-page interface"
			}
			- " represents\n  the user "
			dfn id="fip-query" {
				- "query"
			}
			- ". This typically includes the text that the user wants\n  to search for, as well as optional settings (e.g., the ability to restrict the search to whole\n  words only)."
		}
		- "\n\n  "
		p {
			- "The user-agent processes page contents for a given "
			a href="#fip-query" id="introduction-10:fip-query" {
				- "query"
			}
			- ", and\n  identifies zero or more "
			dfn id="fip-matches" {
				- "matches"
			}
			- ", which are content ranges that\n  satisfy the user "
			a href="#fip-query" id="introduction-10:fip-query-2" {
				- "query"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "One of the "
			a href="#fip-matches" id="introduction-10:fip-matches" {
				- "matches"
			}
			- " is identified to the user as the "
			dfn id="fip-active-match" {
				- "active match"
			}
			- ". It is highlighted and scrolled into view. The user\n  can navigate through the "
			a href="#fip-matches" id="introduction-10:fip-matches-2" {
				- "matches"
			}
			- " by advancing the "
			a href="#fip-active-match" id="introduction-10:fip-active-match" {
				- "active match"
			}
			- " using the "
			a href="#find-in-page-interface" id="introduction-10:find-in-page-interface-2" {
				- "find-in-page interface"
			}
			- "."
		}
		- "\n\n  "
		p class="XXX" {
			a href="https://github.com/whatwg/html/issues/3539" {
				- "Issue #3539"
			}
			- " tracks\n  standardizing how "
			a href="#find-in-page-2" id="introduction-10:find-in-page-2-2" {
				- "find-in-page"
			}
			- " underlies the currently-unspecified "
			code {
				- "window.find()"
			}
			- " API."
		}
		- "\n\n  "
		h4 id="interaction-with-details-and-hidden=until-found" {
			span class="secno" {
				- "6.9.2"
			}
			- " Interaction with "
			code id="interaction-with-details-and-hidden=until-found:the-details-element" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- " and "
			code id="interaction-with-details-and-hidden=until-found:attr-hidden-until-found-state" {
				a href="#attr-hidden-until-found-state" {
					- "hidden=until-found"
				}
			}
			a href="#interaction-with-details-and-hidden=until-found" class="self-link"
		}
		- "\n\n  "
		p {
			- "When find-in-page begins searching for matches, all "
			code id="interaction-with-details-and-hidden=until-found:the-details-element-2" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- " elements in the page\n  which do not have their "
			code id="interaction-with-details-and-hidden=until-found:attr-details-open" {
				a href="#attr-details-open" {
					- "open"
				}
			}
			- " attribute set should have the\n  "
			a href="https://drafts.csswg.org/css-contain/#skips-its-contents" id="interaction-with-details-and-hidden=until-found:skips-its-contents" data-x-internal="skips-its-contents" {
				- "skipped contents"
			}
			- " of their second slot become accessible,\n  without modifying the "
			code id="interaction-with-details-and-hidden=until-found:attr-details-open-2" {
				a href="#attr-details-open" {
					- "open"
				}
			}
			- " attribute, in order to make\n  find-in-page able to search through it. Similarly, all HTML elements with the "
			code id="interaction-with-details-and-hidden=until-found:attr-hidden" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in the "
			a href="#attr-hidden-until-found-state" id="interaction-with-details-and-hidden=until-found:attr-hidden-until-found-state-2" {
				- "hidden until found"
			}
			- " state should have their "
			a href="https://drafts.csswg.org/css-contain/#skips-its-contents" id="interaction-with-details-and-hidden=until-found:skips-its-contents-2" data-x-internal="skips-its-contents" {
				- "skipped contents"
			}
			- " become accessible without modifying the "
			code id="interaction-with-details-and-hidden=until-found:attr-hidden-2" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in order to make find-in-page able to search through\n  them. After find-in-page finishes searching for matches, the "
			code id="interaction-with-details-and-hidden=until-found:the-details-element-3" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- " elements and the\n  elements with the "
			code id="interaction-with-details-and-hidden=until-found:attr-hidden-3" {
				a href="#attr-hidden" {
					- "hidden"
				}
			}
			- " attribute in the "
			a href="#attr-hidden-until-found-state" id="interaction-with-details-and-hidden=until-found:attr-hidden-until-found-state-3" {
				- "hidden until found"
			}
			- " state should have their contents\n  become skipped again. This entire process must happen synchronously (and so is not observable to\n  users or to author code). "
			a href="#refsCSSCONTAIN" {
				- "[CSSCONTAIN]"
			}
		}
		- "\n\n  "
		p {
			- "When find-in-page chooses a new "
			a href="#fip-active-match" id="interaction-with-details-and-hidden=until-found:fip-active-match" {
				- "active match"
			}
			- ", perform\n  the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "node"
					}
					- " be the first node in the "
					a href="#fip-active-match" id="interaction-with-details-and-hidden=until-found:fip-active-match-2" {
						- "active\n   match"
					}
					- "."
				}
			}
			li {
				p {
					a href="#queue-a-global-task" id="interaction-with-details-and-hidden=until-found:queue-a-global-task" {
						- "Queue a global task"
					}
					- " on the "
					a href="#user-interaction-task-source" id="interaction-with-details-and-hidden=until-found:user-interaction-task-source" {
						- "user interaction task source"
					}
					- " given\n   "
					var {
						- "node"
					}
					- "'s "
					a href="#concept-relevant-global" id="interaction-with-details-and-hidden=until-found:concept-relevant-global" {
						- "relevant global object"
					}
					- " to run the following steps:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							- "Run the "
							a href="#ancestor-details-revealing-algorithm" id="interaction-with-details-and-hidden=until-found:ancestor-details-revealing-algorithm" {
								- "ancestor details revealing algorithm"
							}
							- " on "
							var {
								- "node"
							}
							- "."
						}
					}
					li {
						p {
							- "Run the "
							a href="#ancestor-hidden-until-found-revealing-algorithm" id="interaction-with-details-and-hidden=until-found:ancestor-hidden-until-found-revealing-algorithm" {
								- "ancestor hidden-until-found revealing algorithm"
							}
							- " on\n     "
							var {
								- "node"
							}
							- "."
						}
					}
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p class="warning" {
			- "\n  "
			a id="interaction-with-details-and-hidden=until-found:tracking-vector" title="There is a tracking vector here." href="https://infra.spec.whatwg.org/#tracking-vector" class="tracking-vector" data-x-internal="tracking-vector" {
				img width="46" alt="(This is a tracking vector.)" crossorigin="" src="https://resources.whatwg.org/tracking-vector.svg" height="64"
			}
			- "\n  When find-in-page auto-expands a "
			code id="interaction-with-details-and-hidden=until-found:the-details-element-4" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- " element like this, it will fire a "
			code id="interaction-with-details-and-hidden=until-found:event-toggle" {
				a href="#event-toggle" {
					- "toggle"
				}
			}
			- " event. As with the separate "
			code id="interaction-with-details-and-hidden=until-found:event-scroll" {
				a data-x-internal="event-scroll" href="https://drafts.csswg.org/cssom-view/#eventdef-document-scroll" {
					- "scroll"
				}
			}
			- " event that find-in-page fires, this event could be used by the\n  page to discover what the user is typing into the find-in-page dialog. If the page creates a tiny\n  scrollable area with the current search term and every possible next character the user could type\n  separated by a gap, and observes which one the browser scrolls to, it can add that character to\n  the search term and update the scrollable area to incrementally build the search term. By wrapping\n  each possible next match in a closed "
			code id="interaction-with-details-and-hidden=until-found:the-details-element-5" {
				a href="#the-details-element" {
					- "details"
				}
			}
			- " element, the page could listen to "
			code id="interaction-with-details-and-hidden=until-found:event-toggle-2" {
				a href="#event-toggle" {
					- "toggle"
				}
			}
			- " events instead of "
			code id="interaction-with-details-and-hidden=until-found:event-scroll-2" {
				a data-x-internal="event-scroll" href="https://drafts.csswg.org/cssom-view/#eventdef-document-scroll" {
					- "scroll"
				}
			}
			- "\n  events. This attack could be addressed for both events by not acting on every character the user\n  types into the find-in-page dialog."
		}
		- "\n\n  "
		h4 id="interaction-with-selection" {
			span class="secno" {
				- "6.9.3"
			}
			- " Interaction with selection"
			a href="#interaction-with-selection" class="self-link"
		}
		- "\n\n  "
		p {
			- "The find-in-page process is invoked in the context of a document, and may have an effect on\n  the "
			a href="https://w3c.github.io/selection-api/#dfn-selection" id="interaction-with-selection:document-selection" data-x-internal="document-selection" {
				- "selection"
			}
			- " of that document. Specifically, the range\n  that defines the "
			a href="#fip-active-match" id="interaction-with-selection:fip-active-match" {
				- "active match"
			}
			- " can dictate the current\n  selection. These selection updates, however, can happen at different times during the\n  find-in-page process (e.g. upon the "
			a href="#find-in-page-interface" id="interaction-with-selection:find-in-page-interface" {
				- "find-in-page interface"
			}
			- " dismissal or upon a change\n  in the "
			a href="#fip-active-match" id="interaction-with-selection:fip-active-match-2" {
				- "active match"
			}
			- " range).\n\n  \n\n\n  "
		}
		h3 id="close-requests-and-close-watchers" {
			span class="secno" {
				- "6.10"
			}
			- " Close requests and close watchers"
			a href="#close-requests-and-close-watchers" class="self-link"
		}
		- "\n\n  "
		h4 id="close-requests" {
			span class="secno" {
				- "6.10.1"
			}
			- " Close requests"
			a href="#close-requests" class="self-link"
		}
		- "\n\n  "
		p {
			- "In an "
			a id="close-requests:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " (and likely device-specific) manner, a user can send\n  a "
			dfn id="close-request" data-export="" {
				- "close request"
			}
			- " to the user agent. This indicates that the user wishes to close\n  something that is currently being shown on the screen, such as a popover, menu, dialog, picker, or\n  display mode."
		}
		- "\n\n  "
		div class="example" {
			- "\n   "
			p {
				- "Some example close requests are:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "The "
						kbd {
							- "Esc"
						}
						- " key on desktop platforms."
					}
				}
				li {
					p {
						- "The back button or gesture on certain mobile platforms such as Android."
					}
				}
				li {
					p {
						- "Any assistive technology's dismiss gesture, such as iOS VoiceOver's two-finger scrub \"z\"\n    gesture."
					}
				}
				li {
					p {
						- "A game controller's canonical \"back\" button, such as the circle button on a DualShock\n    gamepad."
					}
				}
			}
			- "\n  "
		}
		- "\n\n  \n\n  "
		p {
			- "Whenever the user agent receives a potential close request targeted at a "
			code id="close-requests:document" {
				a href="#document" {
					- "Document"
				}
			}
			- "\n  "
			var {
				- "document"
			}
			- ", it must "
			a href="#queue-a-global-task" id="close-requests:queue-a-global-task" {
				- "queue a global task"
			}
			- " on the "
			a href="#user-interaction-task-source" id="close-requests:user-interaction-task-source" {
				- "user interaction task\n  source"
			}
			- " given "
			var {
				- "document"
			}
			- "'s "
			a href="#concept-relevant-global" id="close-requests:concept-relevant-global" {
				- "relevant global object"
			}
			- " to perform the\n  following "
			dfn id="close-request-steps" data-export="" {
				- "close request steps"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "document"
					}
					- "'s "
					a id="close-requests:fullscreen-element" href="https://fullscreen.spec.whatwg.org/#fullscreen-element" data-x-internal="fullscreen-element" {
						- "fullscreen element"
					}
					- " is not null, then:"
				}
				- "\n\n    "
				ol {
					li {
						p {
							a id="close-requests:fully-exit-fullscreen" href="https://fullscreen.spec.whatwg.org/#fully-exit-fullscreen" data-x-internal="fully-exit-fullscreen" {
								- "Fully exit fullscreen"
							}
							- " given "
							var {
								- "document"
							}
							- "'s "
							a href="#node-navigable" id="close-requests:node-navigable" {
								- "node\n     navigable"
							}
							- "'s "
							a href="#nav-top" id="close-requests:nav-top" {
								- "top-level traversable"
							}
							- "'s "
							a href="#nav-document" id="close-requests:nav-document" {
								- "active document"
							}
							- "."
						}
					}
					li {
						p {
							- "Return."
						}
						- "\n    "
					}
				}
				- "\n\n    "
				p class="note" {
					- "This does "
					em {
						- "not"
					}
					- " fire any relevant event, such as "
					code id="close-requests:event-keydown" {
						a data-x-internal="event-keydown" href="https://w3c.github.io/uievents/#event-type-keydown" {
							- "keydown"
						}
					}
					- "; it only causes "
					code id="close-requests:event-fullscreenchange" {
						a data-x-internal="event-fullscreenchange" href="https://fullscreen.spec.whatwg.org/#eventdef-document-fullscreenchange" {
							- "fullscreenchange"
						}
					}
					- " to be eventually fired."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Optionally, skip to the step labeled "
					a href="#close-request-fallback" {
						- "alternative\n    processing"
					}
					- "."
				}
				- "\n\n    "
				p class="note" {
					- "For example, if the user agent detects user frustration at repeated close\n    request interception by the current web page, it might take this path."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "Fire any relevant events, per "
					cite {
						- "UI Events"
					}
					- " or other relevant specifications.\n    "
					a href="#refsUIEVENTS" {
						- "[UIEVENTS]"
					}
				}
				- "\n\n    "
				p class="example" {
					- "An example of a relevant event in the "
					cite {
						- "UI Events"
					}
					- " model would be\n    the "
					code id="close-requests:event-keydown-2" {
						a data-x-internal="event-keydown" href="https://w3c.github.io/uievents/#event-type-keydown" {
							- "keydown"
						}
					}
					- "  event that "
					cite {
						- "UI Events"
					}
					- " "
					a href="https://w3c.github.io/uievents/#events-keyboard-event-order" {
						- "suggests"
					}
					- " firing when the\n    user presses the "
					kbd {
						- "Esc"
					}
					- " key on their keyboard. On most platforms with keyboards, this\n    is treated as a "
					a href="#close-request" id="close-requests:close-request" {
						- "close request"
					}
					- ", and so would trigger these "
					a href="#close-request-steps" id="close-requests:close-request-steps" {
						- "close request\n    steps"
					}
					- "."
				}
				- "\n\n    "
				p class="example" {
					- "An example of relevant events that are outside of the model given in\n    "
					cite {
						- "UI Events"
					}
					- " would be assistive technology synthesizing an "
					kbd {
						- "Esc"
					}
					- " "
					code id="close-requests:event-keydown-3" {
						a data-x-internal="event-keydown" href="https://w3c.github.io/uievents/#event-type-keydown" {
							- "keydown"
						}
					}
					- " event when the user sends a "
					a href="#close-request" id="close-requests:close-request-2" {
						- "close request"
					}
					- " by\n    using a dismiss gesture."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "event"
					}
					- " be null if no such events are fired, or the "
					code id="close-requests:event" {
						a data-x-internal="event" href="https://dom.spec.whatwg.org/#interface-event" {
							- "Event"
						}
					}
					- "\n   object representing one of the fired events otherwise. If multiple events are fired, which one\n   is chosen is "
					a id="close-requests:implementation-defined-2" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
						- "implementation-defined"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "event"
					}
					- " is not null, and its "
					a id="close-requests:canceled-flag" href="https://dom.spec.whatwg.org/#canceled-flag" data-x-internal="canceled-flag" {
						- "canceled flag"
					}
					- " is set, then\n   return."
				}
			}
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "document"
					}
					- " is not "
					a href="#fully-active" id="close-requests:fully-active" {
						- "fully active"
					}
					- ", then return."
				}
				- "\n\n    "
				p class="note" {
					- "This step is necessary because, if "
					var {
						- "event"
					}
					- " is not null, then an event\n    listener might have caused "
					var {
						- "document"
					}
					- " to no longer be "
					a href="#fully-active" id="close-requests:fully-active-2" {
						- "fully active"
					}
					- "."
				}
				- "\n   "
			}
			li {
				p {
					- "Let "
					var {
						- "closedSomething"
					}
					- " be the result of "
					a href="#process-close-watchers" id="close-requests:process-close-watchers" {
						- "processing close watchers"
					}
					- " on "
					var {
						- "document"
					}
					- "'s "
					a href="#concept-relevant-global" id="close-requests:concept-relevant-global-2" {
						- "relevant global\n   object"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "closedSomething"
					}
					- " is true, then return."
				}
			}
			li id="close-request-fallback" {
				p {
					i {
						- "Alternative processing"
					}
					- ": Otherwise, there was nothing\n   watching for a "
					a href="#close-request" id="close-requests:close-request-3" {
						- "close request"
					}
					- ". The user agent may instead interpret this interaction\n   as some other action, instead of interpreting it as a close request."
				}
			}
		}
		- "\n\n  \n\n  "
		p {
			- "On platforms where pressing the "
			kbd {
				- "Esc"
			}
			- " key is interpreted as a "
			a href="#close-request" id="close-requests:close-request-4" {
				- "close\n  request"
			}
			- ", the user agent must interpret the key being pressed "
			em {
				- "down"
			}
			- " as the close\n  request, instead of the key being released. Thus, in the above algorithm, the \"relevant events\"\n  that are fired must be the single "
			code id="close-requests:event-keydown-4" {
				a data-x-internal="event-keydown" href="https://w3c.github.io/uievents/#event-type-keydown" {
					- "keydown"
				}
			}
			- " event."
		}
		- "\n\n  "
		p class="example" {
			- "On platforms where "
			kbd {
				- "Esc"
			}
			- " is the "
			a href="#close-request" id="close-requests:close-request-5" {
				- "close request"
			}
			- ", the user\n  agent will first fire an appropriately-initialized "
			code id="close-requests:event-keydown-5" {
				a data-x-internal="event-keydown" href="https://w3c.github.io/uievents/#event-type-keydown" {
					- "keydown"
				}
			}
			- "\n  event. If the web developer cancels the event by calling "
			code id="close-requests:dom-event-preventdefault" {
				a data-x-internal="dom-event-preventdefault" href="https://dom.spec.whatwg.org/#dom-event-preventdefault" {
					- "preventDefault()"
				}
			}
			- ", then nothing further happens. But if\n  the event fires without being canceled, then the user agent proceeds to "
			a href="#process-close-watchers" id="close-requests:process-close-watchers-2" {
				- "process close\n  watchers"
			}
			- "."
		}
		- "\n\n  "
		p class="example" {
			- "On platforms where a back button is a potential "
			a href="#close-request" id="close-requests:close-request-6" {
				- "close request"
			}
			- ", no\n  event is involved, so when the back button is pressed, the user agent proceeds directly to\n  "
			a href="#process-close-watchers" id="close-requests:process-close-watchers-3" {
				- "process close watchers"
			}
			- ". If there is an "
			a href="#close-watcher-active" id="close-requests:close-watcher-active" {
				- "active"
			}
			- " "
			a href="#close-watcher" id="close-requests:close-watcher" {
				- "close watcher"
			}
			- ", then that will get\n  triggered. If there is not, then the user agent can interpret the back button press in another\n  way, for example as a request to "
			a href="#traverse-the-history-by-a-delta" id="close-requests:traverse-the-history-by-a-delta" {
				- "traverse the history by a delta"
			}
			- " of −1."
		}
		- "\n\n\n  \n\n  "
		h4 id="close-watcher-infrastructure" {
			span class="secno" {
				- "6.10.2"
			}
			- " Close watcher infrastructure"
			a href="#close-watcher-infrastructure" class="self-link"
		}
		- "\n\n  "
		p {
			- "Each "
			code id="close-watcher-infrastructure:window" {
				a href="#window" {
					- "Window"
				}
			}
			- " has a "
			dfn id="close-watcher-manager" {
				- "close watcher manager"
			}
			- ", which is a\n  "
			a id="close-watcher-infrastructure:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="close-watcher-infrastructure:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					dfn id="close-watcher-manager-groups" {
						- "Groups"
					}
					- ", a "
					a id="close-watcher-infrastructure:list" href="https://infra.spec.whatwg.org/#list" data-x-internal="list" {
						- "list"
					}
					- " of "
					a href="https://infra.spec.whatwg.org/#list" id="close-watcher-infrastructure:list-2" data-x-internal="list" {
						- "lists"
					}
					- " of "
					a href="#close-watcher" id="close-watcher-infrastructure:close-watcher" {
						- "close watchers"
					}
					- ", initially\n   empty."
				}
			}
			li {
				p {
					dfn id="close-watcher-manager-allowed-number-of-groups" {
						- "Allowed number of\n   groups"
					}
					- ", a number, initially 1."
				}
			}
			li {
				p {
					dfn id="close-watcher-manager-next" {
						- "Next user interaction allows a new group"
					}
					- ",\n   a boolean, initially true."
				}
			}
		}
		- "\n\n  "
		p {
			- "Most of the complexity of the "
			a href="#close-watcher-manager" id="close-watcher-infrastructure:close-watcher-manager" {
				- "close watcher manager"
			}
			- " comes from anti-abuse\n  protections designed to prevent developers from disabling users' history traversal abilities, for\n  platforms where a "
			a href="#close-request" id="close-watcher-infrastructure:close-request" {
				- "close request"
			}
			- "'s "
			a href="#close-request-fallback" {
				- "fallback\n  action"
			}
			- " is the main mechanism of history traversal. In particular:"
		}
		- "\n\n  "
		p {
			- "The grouping of "
			a href="#close-watcher" id="close-watcher-infrastructure:close-watcher-2" {
				- "close watchers"
			}
			- " is designed so that if\n  multiple close watchers are created without "
			a href="#history-action-activation" id="close-watcher-infrastructure:history-action-activation" {
				- "history-action activation"
			}
			- ", they are\n  grouped together, so that a user-triggered "
			a href="#close-request" id="close-watcher-infrastructure:close-request-2" {
				- "close request"
			}
			- " will close all of the close\n  watchers in a group. This ensures that web developers can't intercept an unlimited number of\n  close requests by creating close watchers; instead they can create a number equal to at most 1 +\n  the number of times the "
			a href="#tracking-user-activation" id="close-watcher-infrastructure:tracking-user-activation" {
				- "user activates the page"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="#close-watcher-manager-next" id="close-watcher-infrastructure:close-watcher-manager-next" {
				- "next user interaction allows a new group"
			}
			- "\n  boolean encourages web developers to create "
			a href="#close-watcher" id="close-watcher-infrastructure:close-watcher-3" {
				- "close watchers"
			}
			- " in\n  a way that is tied to individual "
			a href="#tracking-user-activation" id="close-watcher-infrastructure:tracking-user-activation-2" {
				- "user activations"
			}
			- ". Without\n  it, each user activation would increase the "
			a href="#close-watcher-manager-allowed-number-of-groups" id="close-watcher-infrastructure:close-watcher-manager-allowed-number-of-groups" {
				- "allowed number of groups"
			}
			- ", even if the web developer isn't \"using\" those user\n  activations to create close watchers. In short:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "Allowed: user interaction; create a close watcher in its own group; user interaction;\n   create a close watcher in a second independent group."
				}
			}
			li {
				p {
					- "Disallowed: user interaction; user interaction; create a close watcher in its own group;\n   create a close watcher in a second independent group."
				}
			}
			li {
				p {
					- "Allowed: user interaction; user interaction; create a close watcher in its own group;\n   create a close watcher grouped with the previous one."
				}
			}
		}
		- "\n\n  "
		p {
			- "This protection is "
			em {
				- "not"
			}
			- " important for upholding our desired invariant of creating at\n  most (1 + the number of times the "
			a href="#tracking-user-activation" id="close-watcher-infrastructure:tracking-user-activation-3" {
				- "user activates the page"
			}
			- ")\n  groups. A determined abuser will just create one close watcher per user interaction, \"banking\"\n  them for future abuse. But this system causes more predictable behavior for the normal case, and\n  encourages non-abusive developers to create close watchers directly in response to user\n  interactions."
		}
		- "\n\n  "
		p {
			- "To "
			dfn id="notify-the-close-watcher-manager-about-user-activation" {
				- "notify the close watcher manager about user activation"
			}
			- " given a\n  "
			code id="close-watcher-infrastructure:window-2" {
				a href="#window" {
					- "Window"
				}
			}
			- " "
			var {
				- "window"
			}
			- ":"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "manager"
					}
					- " be "
					var {
						- "window"
					}
					- "'s "
					a href="#close-watcher-manager" id="close-watcher-infrastructure:close-watcher-manager-2" {
						- "close watcher manager"
					}
					- "."
				}
			}
			li {
				p {
					- "If "
					var {
						- "manager"
					}
					- "'s "
					a href="#close-watcher-manager-next" id="close-watcher-infrastructure:close-watcher-manager-next-2" {
						- "next user interaction\n   allows a new group"
					}
					- " is true, then increment "
					var {
						- "manager"
					}
					- "'s "
					a href="#close-watcher-manager-allowed-number-of-groups" id="close-watcher-infrastructure:close-watcher-manager-allowed-number-of-groups-2" {
						- "allowed number of groups"
					}
					- "."
				}
			}
			li {
				p {
					- "Set "
					var {
						- "manager"
					}
					- "'s "
					a href="#close-watcher-manager-next" id="close-watcher-infrastructure:close-watcher-manager-next-3" {
						- "next user interaction\n   allows a new group"
					}
					- " to false."
				}
			}
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "A "
			dfn id="close-watcher" data-export="" {
				- "close watcher"
			}
			- " is a "
			a id="close-watcher-infrastructure:struct-2" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with the following "
			a href="https://infra.spec.whatwg.org/#struct-item" id="close-watcher-infrastructure:struct-item-2" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "A "
					dfn id="close-watcher-window" {
						- "window"
					}
					- ", a "
					code id="close-watcher-infrastructure:window-3" {
						a href="#window" {
							- "Window"
						}
					}
					- "."
				}
			}
			li {
				p {
					- "A "
					dfn id="close-watcher-cancel-action" {
						- "cancel action"
					}
					- ", an algorithm accepting a\n   boolean argument and returning a boolean. The argument indicates whether or not the cancel\n   action algorithm can prevent the close request from proceeding via the algorithm's return value.\n   If the boolean argument is true, then the algorithm can return either true to indicate that the\n   caller will proceed to the "
					a href="#close-watcher-close-action" id="close-watcher-infrastructure:close-watcher-close-action" {
						- "close action"
					}
					- ", or\n   false to indicate that the caller will bail out. If the argument is false, then the return value\n   is always false. This algorithm can never throw an exception."
				}
			}
			li {
				p {
					- "A "
					dfn id="close-watcher-close-action" {
						- "close action"
					}
					- ", an algorithm accepting no\n   arguments and returning nothing. This algorithm can never throw an exception."
				}
			}
			li {
				p {
					- "An "
					dfn id="close-watcher-is-running-cancel" {
						- "is running cancel action"
					}
					- "\n   boolean."
				}
			}
			li {
				p {
					- "A "
					dfn id="close-watcher-get-enabled-state" {
						- "get enabled state"
					}
					- ", an algorithm\n   accepting no arguments and returning a boolean. This algorithm can never throw an\n   exception."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			a href="#close-watcher" id="close-watcher-infrastructure:close-watcher-4" {
				- "close watcher"
			}
			- " "
			var {
				- "closeWatcher"
			}
			- " "
			dfn id="close-watcher-active" {
				- "is\n  active"
			}
			- " if "
			var {
				- "closeWatcher"
			}
			- "'s "
			a href="#close-watcher-window" id="close-watcher-infrastructure:close-watcher-window" {
				- "window"
			}
			- "'s\n  "
			a href="#close-watcher-manager" id="close-watcher-infrastructure:close-watcher-manager-3" {
				- "close watcher manager"
			}
			- " "
			a href="https://infra.spec.whatwg.org/#list-contain" id="close-watcher-infrastructure:list-contains" data-x-internal="list-contains" {
				- "contains"
			}
			- " any list which\n  "
			a href="https://infra.spec.whatwg.org/#list-contain" id="close-watcher-infrastructure:list-contains-2" data-x-internal="list-contains" {
				- "contains"
			}
			- " "
			var {
				- "closeWatcher"
			}
			- "."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "To "
			dfn id="establish-a-close-watcher" {
				- "establish a close watcher"
			}
			- " given a "
			code id="close-watcher-infrastructure:window-4" {
				a href="#window" {
					- "Window"
				}
			}
			- " "
			var {
				- "window"
			}
			- ", a list\n  of steps "
			dfn id="create-close-watcher-cancelaction" {
				var {
					- "cancelAction"
				}
			}
			- ", a\n  list of steps "
			dfn id="create-close-watcher-closeaction" {
				var {
					- "closeAction"
				}
			}
