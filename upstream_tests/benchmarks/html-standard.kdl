				- "-based selection"
			}
			dd {
				- "\n    "
				p {
					- "The "
					code id="introduction-3:the-picture-element" {
						a href="#the-picture-element" {
							- "picture"
						}
					}
					- " element and the "
					code id="introduction-3:the-source-element" {
						a href="#the-source-element" {
							- "source"
						}
					}
					- " element, together with the "
					code id="introduction-3:attr-source-media" {
						a href="#attr-source-media" {
							- "media"
						}
					}
					- " attribute, can be used to provide multiple images that\n    vary the image content (for instance the smaller image might be a cropped version of the bigger\n    image)."
				}
				- "\n\n    "
				div class="example" {
					- "\n\n"
					pre {
						code class="html" {
							c- p="" {
								- "<"
							}
							c- f="" {
								- "picture"
							}
							c- p="" {
								- ">"
							}
							- "\n  "
							c- p="" {
								- "<"
