						- "top-level creation URL"
					}
					- " to null, "
					a href="#concept-environment-top-level-origin" id="script-settings-for-worklets:concept-environment-top-level-origin" {
						- "top-level\n   origin"
					}
					- " to "
					var {
						- "outsideSettings"
					}
					- "'s "
