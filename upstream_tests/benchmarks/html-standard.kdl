		- "\n\n  "
		p {
			- "An "
			code id="embedded-content-rendering-rules:the-object-element" {
				a href="#the-object-element" {
					- "object"
				}
			}
			- " element that "
			a href="#represents" id="embedded-content-rendering-rules:represents-2" {
				- "represents"
			}
			- " an image, plugin, or its\n  "
			a href="#content-navigable" id="embedded-content-rendering-rules:content-navigable" {
