									var {
										- "tagname"
									}
									- " will be\n        lowercase."
								}
								- "\n\n        "
								p {
									- "If "
									var {
										- "current node"
									}
									- "'s "
									a href="https://dom.spec.whatwg.org/#concept-element-is-value" id="serialising-html-fragments:concept-element-is-value" data-x-internal="concept-element-is-value" {
										code {
											- "is"
										}
										- " value"
									}
									- " is not null, and the element does not have an "
									code id="serialising-html-fragments:attr-is" {
										a href="#attr-is" {
											- "is"
										}
									}
