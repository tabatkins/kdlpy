						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/MediaError/message" title="The read-only property MediaError.message returns a human-readable string offering specific diagnostic details related to the error described by the MediaError object, or an empty string (\"\") if no diagnostic information can be determined or provided." {
								- "MediaError/message"
							}
