									- "document.write()"
								}
							}
							- "."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-character-after-doctype-system-identifier" {
							- "unexpected-character-after-doctype-system-identifier"
						}
						- "\n     "
					}
					td {
						p {
							- "This error occurs if the parser encounters any "
							a href="https://infra.spec.whatwg.org/#code-point" id="parse-errors:code-point-22" data-x-internal="code-point" {
								- "code\n     points"
							}
							- " other than "
							a id="parse-errors:space-characters-8" href="https://infra.spec.whatwg.org/#ascii-whitespace" data-x-internal="space-characters" {
								- "ASCII whitespace"
							}
							- " or closing U+003E (>) after the "
							a href="#syntax-doctype" id="parse-errors:syntax-doctype-15" {
								- "DOCTYPE"
							}
							- " system identifier. The parser ignores these code\n     points."
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-character-in-attribute-name" {
							- "unexpected-character-in-attribute-name"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters a U+0022 (\"), U+0027 ('), or U+003C (<)\n      "
							a id="parse-errors:code-point-23" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " in an "
							a href="#syntax-attribute-name" id="parse-errors:syntax-attribute-name" {
								- "attribute name"
							}
							- ". The\n      parser includes such code points in the attribute name."
						}
						- "\n\n      "
						p class="note" {
							- "Code points that trigger this error are usually a part of another syntactic\n      construct and can be a sign of a typo around the attribute name."
						}
						- "\n\n      "
						div class="example" {
							- "\n       "
							p {
								- "For example, consider the following markup:"
							}
							- "\n\n       "
							pre {
								code class="html" {
									c- p="" {
										- "<"
									}
									c- f="" {
										- "div"
									}
									- " "
									c- e="" {
										- "foo"
									}
									- "<"
									c- e="" {
										- "div"
									}
									c- p="" {
										- ">"
									}
								}
							}
							- "\n\n       "
							p {
								- "Due to a forgotten U+003E (>) code point after "
								code {
									- "foo"
								}
								- " the parser\n       treats this markup as a single "
								code id="parse-errors:the-div-element-2" {
									a href="#the-div-element" {
										- "div"
									}
								}
								- " element with a \""
								code {
									- "foo<div"
								}
								- "\" attribute."
							}
							- "\n\n       "
							p {
								- "As another example of this error, consider the following markup:"
							}
							- "\n\n       "
							pre {
								code class="html" {
									c- p="" {
										- "<"
									}
									c- f="" {
										- "div"
									}
									- " "
									c- e="" {
										- "id"
									}
									- "'"
									c- e="" {
										- "bar"
									}
									- "'"
									c- p="" {
										- ">"
									}
								}
							}
							- "\n\n       "
							p {
								- "Due to a forgotten U+003D (=) code point between an attribute name and value the parser\n       treats this markup as a "
								code id="parse-errors:the-div-element-3" {
									a href="#the-div-element" {
										- "div"
									}
								}
								- " element with the attribute \""
								code {
									- "id'bar'"
								}
								- "\" that has an empty value."
							}
							- "\n     "
						}
						- "\n\n    "
					}
				}
				tr {
					td {
						dfn id="parse-error-unexpected-character-in-unquoted-attribute-value" {
							- "unexpected-character-in-unquoted-attribute-value"
						}
						- "\n     "
					}
					td {
						- "\n      "
						p {
							- "This error occurs if the parser encounters a U+0022 (\"), U+0027 ('), U+003C (<), U+003D\n      (=), or U+0060 (`) "
							a id="parse-errors:code-point-24" href="https://infra.spec.whatwg.org/#code-point" data-x-internal="code-point" {
								- "code point"
							}
							- " in an unquoted "
							a href="#syntax-attribute-value" id="parse-errors:syntax-attribute-value" {
								- "attribute value"
							}
							- ". The parser includes such code points\n      in the attribute value."
						}
						- "\n\n      "
						p class="note" {
							- "Code points that trigger this error are usually a part of another syntactic\n      construct and can be a sign of a typo around the attribute value."
						}
						- "\n\n      "
						p class="note" {
							- "U+0060 (`) is in the list of code points that trigger this error because\n      certain legacy user agents treat it as a quote."
