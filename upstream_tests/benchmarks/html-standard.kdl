						- "hosts"
					}
					- ", and "
					a href="#concept-origin-port" id="origin:concept-origin-port-3" {
						- "port"
					}
					- "\n   are identical, then return true."
				}
			}
			li {
				p {
					- "Return false."
				}
			}
		}
		- "\n\n  "
		p {
			- "Two "
			a href="#concept-origin" id="origin:concept-origin-6" {
				- "origins"
			}
			- ", "
			var {
				- "A"
			}
			- " and "
			var {
				- "B"
			}
			- ", are said to be "
			dfn id="same-origin-domain" data-export="" {
