					- "em"
				}
			}
			- " element for marking up stress emphasis,\n  or the "
			code id="the-i-element:the-dfn-element" {
				a href="#the-dfn-element" {
					- "dfn"
				}
			}
			- " element to mark up the defining instance of a term."
		}
