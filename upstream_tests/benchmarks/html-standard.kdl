		- "\n\n  \n\n\n\n  "
		h5 id="the-lang-and-xml:lang-attributes" {
			span class="secno" {
				- "3.2.6.2"
			}
			- " The "
			code id="the-lang-and-xml:lang-attributes:attr-lang" {
				a href="#attr-lang" {
					- "lang"
				}
			}
			- " and "
			code id="the-lang-and-xml:lang-attributes:attr-xml-lang" {
				a data-x-internal="attr-xml-lang" href="https://www.w3.org/TR/xml/#sec-lang-tag" {
					- "xml:lang"
				}
			}
			- "\n  attributes"
			a href="#the-lang-and-xml:lang-attributes" class="self-link"
		}
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/lang" title="The lang global attribute helps define the language of an element: the language that non-editable elements are written in, or the language that the editable elements should be written in by the user. The attribute contains a single \"language tag\" in the format defined in RFC 5646: Tags for Identifying Languages (also known as BCP 47)." {
						- "Global_attributes/lang"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "4+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "Yes"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-lang" data-dfn-type="element-attr" {
				code {
					- "lang"
				}
			}
			- " attribute\n  (in no namespace) specifies the primary language for the element's contents and for any of the\n  element's attributes that contain text. Its value must be a valid BCP 47 language tag, or the\n  empty string. Setting the attribute to the empty string indicates that the primary language is\n  unknown. "
			a href="#refsBCP47" {
				- "[BCP47]"
			}
		}
		- "\n\n  "
		p {
			- "The "
			dfn id="attr-xml-lang" {
				a href="https://www.w3.org/TR/xml/#sec-lang-tag" {
					code {
						- "lang"
					}
				}
			}
			- " attribute in the "
			a id="the-lang-and-xml:lang-attributes:xml-namespace" href="https://infra.spec.whatwg.org/#xml-namespace" data-x-internal="xml-namespace" {
				- "XML namespace"
			}
			- " is defined in XML.\n  "
			a href="#refsXML" {
				- "[XML]"
			}
		}
		- "\n\n  "
		p {
			- "If these attributes are omitted from an element, then the language of this element is the same\n  as the language of its parent element, if any (except for "
			code id="the-lang-and-xml:lang-attributes:the-slot-element" {
				a href="#the-slot-element" {
					- "slot"
				}
			}
			- " elements in a\n  "
			a id="the-lang-and-xml:lang-attributes:shadow-tree" href="https://dom.spec.whatwg.org/#concept-shadow-tree" data-x-internal="shadow-tree" {
				- "shadow tree"
			}
			- ")."
		}
		- "\n\n  "
		p {
			- "The "
			code id="the-lang-and-xml:lang-attributes:attr-lang-2" {
				a href="#attr-lang" {
					- "lang"
				}
			}
			- " attribute in no namespace may be used on any "
			a href="#html-elements" id="the-lang-and-xml:lang-attributes:html-elements" {
				- "HTML element"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The "
			a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="the-lang-and-xml:lang-attributes:attr-xml-lang-2" data-x-internal="attr-xml-lang" {
				code {
					- "lang"
				}
				- " attribute in the "
				span {
					- "XML\n  namespace"
				}
			}
			- " may be used on "
			a href="#html-elements" id="the-lang-and-xml:lang-attributes:html-elements-2" {
				- "HTML elements"
			}
			- " in "
			a id="the-lang-and-xml:lang-attributes:xml-documents" href="https://dom.spec.whatwg.org/#xml-document" data-x-internal="xml-documents" {
				- "XML documents"
			}
			- ",\n  as well as elements in other namespaces if the relevant specifications allow it (in particular,\n  MathML and SVG allow "
			a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="the-lang-and-xml:lang-attributes:attr-xml-lang-3" data-x-internal="attr-xml-lang" {
				code {
					- "lang"
				}
				- " attributes in the\n  "
				span {
					- "XML namespace"
				}
			}
			- " to be specified on their elements). If both the "
			code id="the-lang-and-xml:lang-attributes:attr-lang-3" {
				a href="#attr-lang" {
					- "lang"
				}
			}
			- " attribute in no namespace and the "
			a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="the-lang-and-xml:lang-attributes:attr-xml-lang-4" data-x-internal="attr-xml-lang" {
				code {
					- "lang"
				}
				- " attribute in the "
				span {
					- "XML namespace"
				}
			}
			- " are specified on the same\n  element, they must have exactly the same value when compared in an "
			a id="the-lang-and-xml:lang-attributes:ascii-case-insensitive" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII\n  case-insensitive"
			}
			- " manner."
		}
		- "\n\n  "
		p {
			- "Authors must not use the "
			a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="the-lang-and-xml:lang-attributes:attr-xml-lang-5" data-x-internal="attr-xml-lang" {
				code {
					- "lang"
				}
				- " attribute in\n  the "
				span {
					- "XML namespace"
				}
			}
			- " on "
			a href="#html-elements" id="the-lang-and-xml:lang-attributes:html-elements-3" {
				- "HTML elements"
			}
			- " in "
			a id="the-lang-and-xml:lang-attributes:html-documents" href="https://dom.spec.whatwg.org/#html-document" data-x-internal="html-documents" {
				- "HTML\n  documents"
			}
			- ". To ease migration to and from XML, authors may specify an attribute in no\n  namespace with no prefix and with the literal localname \""
			code {
				- "xml:lang"
			}
			- "\" on\n  "
			a href="#html-elements" id="the-lang-and-xml:lang-attributes:html-elements-4" {
				- "HTML elements"
			}
			- " in "
			a id="the-lang-and-xml:lang-attributes:html-documents-2" href="https://dom.spec.whatwg.org/#html-document" data-x-internal="html-documents" {
				- "HTML documents"
			}
			- ", but such attributes must only be\n  specified if a "
			code id="the-lang-and-xml:lang-attributes:attr-lang-4" {
				a href="#attr-lang" {
					- "lang"
				}
			}
			- " attribute in no namespace is also specified,\n  and both attributes must have the same value when compared in an "
			a id="the-lang-and-xml:lang-attributes:ascii-case-insensitive-2" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
				- "ASCII\n  case-insensitive"
			}
			- " manner."
		}
		- "\n\n  "
		p class="note" {
			- "The attribute in no namespace with no prefix and with the literal localname \""
			code {
				- "xml:lang"
			}
			- "\" has no effect on language processing."
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		p {
			- "To determine the "
			dfn data-dfn-for="Node" id="language" data-export="" {
				- "language"
			}
			- " of a node, user agents must use the\n  first appropriate step in the following list:"
		}
		- "\n\n  "
		dl class="switch" {
			dt {
				- "If the node is an element that has a "
				a href="https://www.w3.org/TR/xml/#sec-lang-tag" id="the-lang-and-xml:lang-attributes:attr-xml-lang-6" data-x-internal="attr-xml-lang" {
					code {
						- "lang"
					}
					- "\n   attribute in the "
					span {
						- "XML namespace"
					}
				}
				- " set"
			}
			dd {
				p {
					- "Use the value of that attribute."
				}
			}
			dt {
				- "If the node is an "
				a href="#html-elements" id="the-lang-and-xml:lang-attributes:html-elements-5" {
					- "HTML element"
				}
				- " or an element in the\n   "
				a id="the-lang-and-xml:lang-attributes:svg-namespace" href="https://infra.spec.whatwg.org/#svg-namespace" data-x-internal="svg-namespace" {
					- "SVG namespace"
				}
				- ", and it has a "
				code id="the-lang-and-xml:lang-attributes:attr-lang-5" {
					a href="#attr-lang" {
						- "lang"
					}
				}
				- " in no namespace\n   attribute set"
			}
			dd {
				p {
					- "Use the value of that attribute."
				}
			}
			dt {
				- "If the node's parent is a "
				a id="the-lang-and-xml:lang-attributes:shadow-root" href="https://dom.spec.whatwg.org/#concept-shadow-root" data-x-internal="shadow-root" {
					- "shadow root"
				}
			}
			dd {
				p {
					- "Use the "
					a href="#language" id="the-lang-and-xml:lang-attributes:language" {
						- "language"
					}
					- " of that "
					a id="the-lang-and-xml:lang-attributes:shadow-root-2" href="https://dom.spec.whatwg.org/#concept-shadow-root" data-x-internal="shadow-root" {
						- "shadow root"
					}
					- "'s "
					a href="https://dom.spec.whatwg.org/#concept-documentfragment-host" id="the-lang-and-xml:lang-attributes:concept-documentfragment-host" data-x-internal="concept-documentfragment-host" {
						- "host"
					}
					- "."
				}
			}
			dt {
				- "If the node's "
				a id="the-lang-and-xml:lang-attributes:parent-element" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
					- "parent element"
				}
				- " is not null"
			}
			dd {
				p {
					- "Use the "
					a href="#language" id="the-lang-and-xml:lang-attributes:language-2" {
						- "language"
					}
					- " of that "
					a id="the-lang-and-xml:lang-attributes:parent-element-2" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
						- "parent element"
					}
					- "."
				}
			}
			dt {
				- "Otherwise"
			}
			dd {
				p {
					- "If there is a "
					a href="#pragma-set-default-language" id="the-lang-and-xml:lang-attributes:pragma-set-default-language" {
						- "pragma-set default language"
					}
					- " set, then that is the language of\n   the node. If there is no "
					a href="#pragma-set-default-language" id="the-lang-and-xml:lang-attributes:pragma-set-default-language-2" {
						- "pragma-set default language"
					}
					- " set, then language information\n   from a higher-level protocol (such as HTTP), if any, must be used as the final fallback language\n   instead. In the absence of any such language information, and in cases where the higher-level\n   protocol reports multiple languages, the language of the node is unknown, and the corresponding\n   language tag is the empty string."
				}
			}
		}
		- "\n\n  "
		p {
			- "If the resulting value is not a recognized language tag, then it must be treated as an unknown\n  language having the given language tag, distinct from all other languages. For the purposes of\n  round-tripping or communicating with other services that expect language tags, user agents should\n  pass unknown language tags through unmodified, and tagged as being BCP 47 language tags, so that\n  subsequent services do not interpret the data as another type of language description.\n  "
			a href="#refsBCP47" {
				- "[BCP47]"
			}
		}
		- "\n\n  "
		p class="example" {
			- "Thus, for instance, an element with "
			code {
				- "lang=\"xyzzy\""
			}
			- " would be\n  matched by the selector "
			code {
				- ":lang(xyzzy)"
			}
			- " (e.g. in CSS), but it would not be\n  matched by "
			code {
				- ":lang(abcde)"
			}
			- ", even though both are equally invalid. Similarly, if\n  a web browser and screen reader working in unison communicated about the language of the element,\n  the browser would tell the screen reader that the language was \"xyzzy\", even if it knew it was\n  invalid, just in case the screen reader actually supported a language with that tag after all.\n  Even if the screen reader supported both BCP 47 and another syntax for encoding language names,\n  and in that other syntax the string \"xyzzy\" was a way to denote the Belarusian language, it would\n  be "
			em {
				- "incorrect"
			}
			- " for the screen reader to then start treating text as Belarusian, because\n  \"xyzzy\" is not how Belarusian is described in BCP 47 codes (BCP 47 uses the code \"be\" for\n  Belarusian)."
		}
		- "\n\n  "
		p {
			- "If the resulting value is the empty string, then it must be interpreted as meaning that the\n  language of the node is explicitly unknown."
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "User agents may use the element's language to determine proper processing or rendering (e.g. in\n  the selection of appropriate fonts or pronunciations, for dictionary selection, or for the user\n  interfaces of form controls such as date pickers). "
		}
		- "\n\n  \n\n  "
		hr
		- "\n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/lang" title="The HTMLElement.lang property gets or sets the base language of an element's attribute values and text content." {
						- "HTMLElement/lang"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "1+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "3+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "1+"
						}
					}
					hr
					span class="opera yes" {
						span {
							- "Opera"
						}
						span {
							- "12.1+"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge yes" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "12+"
						}
					}
					span class="ie yes" {
						span {
							- "Internet Explorer"
						}
						span {
							- "5.5+"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios yes" {
						span {
							- "Safari iOS"
						}
						span {
							- "1+"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="HTMLElement" id="dom-lang" data-dfn-type="attribute" {
				code {
					- "lang"
				}
			}
			- " IDL attribute\n  must "
			a href="#reflect" id="the-lang-and-xml:lang-attributes:reflect" {
				- "reflect"
			}
			- " the "
			code id="the-lang-and-xml:lang-attributes:attr-lang-6" {
				a href="#attr-lang" {
					- "lang"
				}
			}
			- " content attribute in no\n  namespace."
		}
		- "\n\n  \n\n\n\n  "
		h5 id="the-translate-attribute" {
			span class="secno" {
				- "3.2.6.3"
			}
			- " The "
			code id="the-translate-attribute:attr-translate" {
				a href="#attr-translate" {
					- "translate"
				}
			}
			- " attribute"
			a href="#the-translate-attribute" class="self-link"
		}
		- "\n\n  \n\n  "
		div class="mdn-anno wrapped before" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
				span {
					- "MDN"
				}
			}
			div class="feature" {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/translate" title="The translate global attribute is an enumerated attribute that is used to specify whether an element's translatable attribute values and its Text node children should be translated when the page is localized, or whether to leave them unchanged." {
						- "Global_attributes/translate"
					}
				}
				p class="all-engines-text" {
					- "Support in all current engines."
				}
				div class="support" {
					span class="firefox yes" {
						span {
							- "Firefox"
						}
						span {
							- "111+"
						}
					}
					span class="safari yes" {
						span {
							- "Safari"
						}
						span {
							- "6+"
						}
					}
					span class="chrome yes" {
						span {
							- "Chrome"
						}
						span {
							- "19+"
						}
					}
					hr
					span class="opera unknown" {
						span {
							- "Opera"
						}
						span {
							- "?"
						}
					}
					span class="edge_blink yes" {
						span {
							- "Edge"
						}
						span {
							- "79+"
						}
					}
					hr
					span class="edge unknown" {
						span {
							- "Edge (Legacy)"
						}
						span {
							- "?"
						}
					}
					span class="ie no" {
						span {
							- "Internet Explorer"
						}
						span {
							- "No"
						}
					}
					hr
					span class="firefox_android unknown" {
						span {
							- "Firefox Android"
						}
						span {
							- "?"
						}
					}
					span class="safari_ios unknown" {
						span {
							- "Safari iOS"
						}
						span {
							- "?"
						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android unknown" {
						span {
							- "Opera Android"
						}
						span {
							- "?"
						}
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for="html-global" id="attr-translate" data-dfn-type="element-attr" {
				code {
					- "translate"
				}
			}
			- "\n  attribute is used to specify whether an element's attribute values and the values of its\n  "
			code id="the-translate-attribute:text" {
				a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
					- "Text"
				}
			}
			- " node children are to be translated when the page is localized, or whether to\n  leave them unchanged. It is an attribute is an "
			a href="#enumerated-attribute" id="the-translate-attribute:enumerated-attribute" {
				- "enumerated attribute"
			}
			- " with the\n  following keywords and states:"
		}
		- "\n\n  "
		table {
			thead {
				tr {
					th {
						- "Keyword\n     "
					}
					th {
						- "State\n     "
					}
					th {
						- "Brief description\n   "
					}
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/translate" id="attr-translate-yes-keyword" data-dfn-type="attr-value" {
							code {
								- "yes"
							}
						}
						- "\n     "
					}
					td rowspan="2" {
						dfn id="attr-translate-yes-state" {
							- "yes"
						}
						- "\n     "
					}
					td rowspan="2" {
						- "Sets "
						a href="#translation-mode" id="the-translate-attribute:translation-mode" {
							- "translation mode"
						}
						- " to "
						a href="#translate-enabled" id="the-translate-attribute:translate-enabled" {
							- "translate-enabled"
						}
						- ".\n    "
					}
				}
				tr {
					td {
						- "(the empty string)\n    "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/translate" id="attr-translate-no-keyword" data-dfn-type="attr-value" {
							code {
								- "no"
							}
						}
						- "\n     "
					}
					td {
						dfn id="attr-translate-no-state" {
							- "no"
						}
						- "\n     "
					}
					td {
						- "Sets "
						a href="#translation-mode" id="the-translate-attribute:translation-mode-2" {
							- "translation mode"
						}
						- " to "
						a href="#no-translate" id="the-translate-attribute:no-translate" {
							- "no-translate"
						}
						- ".\n  "
					}
				}
			}
		}
		- "\n\n  "
		p {
			- "The attribute's "
			i id="the-translate-attribute:missing-value-default" {
				a href="#missing-value-default" {
					- "missing value default"
				}
			}
			- " and "
			i id="the-translate-attribute:invalid-value-default" {
				a href="#invalid-value-default" {
					- "invalid value default"
				}
			}
			- " are both the "
			dfn id="attr-translate-inherit-state" {
				- "inherit"
			}
			- " state."
		}
		- "\n\n  "
		p {
			- "Each element (even non-HTML elements) has a "
			dfn id="translation-mode" {
				- "translation mode"
			}
			- ", which is in either the\n  "
			a href="#translate-enabled" id="the-translate-attribute:translate-enabled-2" {
				- "translate-enabled"
			}
			- " state or the "
			a href="#no-translate" id="the-translate-attribute:no-translate-2" {
				- "no-translate"
			}
			- " state. If an "
			a href="#html-elements" id="the-translate-attribute:html-elements" {
				- "HTML element"
			}
			- "'s "
			code id="the-translate-attribute:attr-translate-2" {
				a href="#attr-translate" {
					- "translate"
				}
			}
			- "\n  attribute is in the "
			a href="#attr-translate-yes-state" id="the-translate-attribute:attr-translate-yes-state" {
				- "yes"
			}
			- " state, then the element's\n  "
			a href="#translation-mode" id="the-translate-attribute:translation-mode-3" {
				- "translation mode"
			}
			- " is in the "
			a href="#translate-enabled" id="the-translate-attribute:translate-enabled-3" {
				- "translate-enabled"
			}
			- " state; otherwise, if the\n  element's "
			code id="the-translate-attribute:attr-translate-3" {
				a href="#attr-translate" {
					- "translate"
				}
			}
			- " attribute is in the "
			a href="#attr-translate-no-state" id="the-translate-attribute:attr-translate-no-state" {
				- "no"
			}
			- " state, then the element's "
			a href="#translation-mode" id="the-translate-attribute:translation-mode-4" {
				- "translation mode"
			}
			- "\n  is in the "
			a href="#no-translate" id="the-translate-attribute:no-translate-3" {
				- "no-translate"
			}
			- " state. Otherwise, either the element's "
			code id="the-translate-attribute:attr-translate-4" {
				a href="#attr-translate" {
					- "translate"
				}
			}
			- " attribute is in the "
			a href="#attr-translate-inherit-state" id="the-translate-attribute:attr-translate-inherit-state" {
				- "inherit"
			}
			- " state, or the element is not an "
			a href="#html-elements" id="the-translate-attribute:html-elements-2" {
				- "HTML element"
			}
			- " and thus does not have a "
			code id="the-translate-attribute:attr-translate-5" {
				a href="#attr-translate" {
					- "translate"
				}
			}
			- " attribute; in either case, the element's\n  "
			a href="#translation-mode" id="the-translate-attribute:translation-mode-5" {
				- "translation mode"
			}
			- " is in the same state as its "
			a id="the-translate-attribute:parent-element" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
				- "parent element"
			}
			- "'s, if any,\n  or in the "
			a href="#translate-enabled" id="the-translate-attribute:translate-enabled-4" {
				- "translate-enabled"
			}
			- " state, if the element's "
			a id="the-translate-attribute:parent-element-2" href="https://dom.spec.whatwg.org/#parent-element" data-x-internal="parent-element" {
				- "parent element"
			}
			- " is\n  null."
		}
		- "\n\n  "
		p {
			- "When an element is in the "
			dfn id="translate-enabled" {
				- "translate-enabled"
			}
			- " state, the element's "
			a href="#translatable-attributes" id="the-translate-attribute:translatable-attributes" {
				- "translatable\n  attributes"
			}
			- " and the values of its "
			code id="the-translate-attribute:text-2" {
				a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
					- "Text"
				}
			}
			- " node children are to be translated when\n  the page is localized."
		}
		- "\n\n  "
		p {
			- "When an element is in the "
			dfn id="no-translate" {
				- "no-translate"
			}
			- " state, the element's attribute values and the\n  values of its "
			code id="the-translate-attribute:text-3" {
				a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
					- "Text"
				}
			}
			- " node children are to be left as-is when the page is localized,\n  e.g. because the element contains a person's name or a name of a computer program."
		}
		- "\n\n  "
		p {
