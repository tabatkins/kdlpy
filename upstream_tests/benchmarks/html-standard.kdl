			code id="shared-workers:messageport" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " objects. The\n  object returned by the "
			code id="shared-workers:dom-sharedworker-2" {
				a href="#dom-sharedworker" {
					- "SharedWorker()"
				}
			}
			- " constructor holds a\n  reference to the port on its "
			code id="shared-workers:dom-sharedworker-port" {
