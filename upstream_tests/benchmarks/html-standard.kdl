				- "rules\n  for updating the display of WebVTT text tracks"
			}
			- ". "
			a href="#refsWEBVTT" {
				- "[WEBVTT]"
			}
		}
		- "\n\n  "
		p {
			- "When a "
			code id="sourcing-out-of-band-text-tracks:the-track-element-2" {
				a href="#the-track-element" {
					- "track"
				}
			}
			- " element's parent element changes and the new parent is a "
			a href="#media-element" id="sourcing-out-of-band-text-tracks:media-element" {
				- "media\n  element"
			}
			- ", then the user agent must add the "
