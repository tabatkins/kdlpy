html lang="en-US-x-hixie" {
	head {
		meta charset="utf-8"
		meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport"
		title {
			- "HTML Standard"
		}
		meta content="#3c790a" name="theme-color"
		meta content="light dark" name="color-scheme"
		link rel="stylesheet" href="https://resources.whatwg.org/standard-shared-with-dev.css" crossorigin=""
		link rel="stylesheet" href="https://resources.whatwg.org/standard.css" crossorigin=""
		link rel="stylesheet" href="https://resources.whatwg.org/spec.css" crossorigin=""
		link rel="icon" href="https://resources.whatwg.org/logo.svg" crossorigin=""
		link rel="stylesheet" href="/styles.css" crossorigin=""
		script {
			- "\n   function toggleStatus(div) {\n     div.parentNode.classList.toggle('wrapped');\n   }\n   function setLinkFragment(link) {\n     link.hash = location.hash;\n   }\n  "
		}
	}
	body class="dfnEnabled" {
		- "\n  \n  "
		script defer="" src="/html-dfn.js" crossorigin=""
		- "\n  "
		script crossorigin="" defer="" src="https://resources.whatwg.org/commit-snapshot-shortcut-key.js"
		- "\n  "
		header id="head" class="head with-buttons" {
			- "\n   "
			a href="https://whatwg.org/" class="logo" {
				img width="100" alt="WHATWG" crossorigin="" class="darkmode-aware" src="https://resources.whatwg.org/logo.svg" height="100"
			}
			- "\n   "
			hgroup {
				h1 class="allcaps" {
					- "HTML"
				}
				p id="living-standard" {
					- "Living Standard — Last Updated "
					span class="pubdate" {
						- "17 January 2025"
					}
				}
			}
			- "\n   \n   "
			nav {
				- "\n    \n    "
				div {
					- "\n     \n     "
					a href="/" {
						span {
							strong {
								- "One-Page Version"
							}
							- " "
							code {
								- "html.spec.whatwg.org"
							}
						}
					}
					- "\n     "
					a onclick="setLinkFragment(this);" href="/multipage/" id="multipage-link" {
						span {
							strong {
								- "Multipage Version"
							}
							- " "
							code {
								- "/multipage"
							}
						}
					}
					- "\n     "
					a onclick="setLinkFragment(this);" href="/dev/" {
						span {
							strong {
								- "Version for Web Devs"
							}
							- " "
							code {
								- "/dev"
							}
						}
					}
					- "\n     "
					a href="/print.pdf" {
						span {
							strong {
								- "PDF Version"
							}
							- " "
							code {
								- "/print.pdf"
							}
						}
					}
					- "\n     "
					a href="https://github.com/whatwg/html/wiki/Translations" {
						span {
							strong {
								- "Translations"
							}
							- " "
							code {
								- "日本語 • 简体中文"
							}
						}
					}
					- "\n    "
				}
				- "\n    "
				div {
					- "\n     "
					a href="https://github.com/whatwg/html/blob/main/FAQ.md" class="misc" {
						span {
							strong {
								- "FAQ"
							}
							- " "
							code {
								- "on GitHub"
							}
						}
					}
					- "\n     "
					a href="https://whatwg.org/chat" class="comms" {
						span {
							strong {
								- "Chat"
							}
							- " "
							code {
								- "on Matrix"
							}
						}
					}
					- "\n    "
				}
				- "\n    "
				div {
					- "\n     "
					a href="https://github.com/whatwg/html" class="changes" {
						span {
							strong {
								- "Contribute on GitHub"
							}
							- " "
							code {
								- "whatwg/html repository"
							}
						}
					}
					- "\n     "
					a href="https://github.com/whatwg/html/commits" class="changes" {
						span {
							strong {
								- "Commits"
							}
							- " "
							code {
								- "on GitHub"
							}
						}
					}
					- "\n     "
					a id="commit-snapshot-link" href="/commit-snapshots/90720ff35cbb975be4d591d4ecd2b89d2bd8fc68/" class="changes" title="You can also press the 'y' key" {
						span {
							strong {
								- "Snapshot"
							}
							- " "
							code {
								- "as of this commit"
							}
						}
					}
					- "\n     "
					a href="https://twitter.com/htmlstandard" class="changes" {
						span {
							strong {
								- "Twitter Updates"
							}
							- " "
							code {
								- "@htmlstandard"
							}
						}
					}
					- "\n    "
				}
				- "\n    "
				div {
					- "\n     "
					a href="https://github.com/whatwg/html/issues" class="feedback" {
						span {
							strong {
								- "Open Issues"
							}
							- " "
							code {
								- "filed on GitHub"
							}
						}
					}
					- "\n     "
					a href="https://whatwg.org/newbug" class="feedback" {
						span {
							strong {
								- "Open an Issue"
							}
							- " "
							code {
								- "whatwg.org/newbug"
							}
						}
					}
					- "\n     "
					a href="https://github.com/web-platform-tests/wpt/tree/master/html" class="feedback" {
						span {
							strong {
								- "Tests"
							}
							- " "
							code {
								- "web-platform-tests html/"
							}
						}
					}
					- "\n     "
					a href="https://github.com/web-platform-tests/wpt/labels/html" class="feedback" {
						span {
							strong {
								- "Issues for Tests"
							}
							- " "
							code {
								- "ongoing work"
							}
						}
					}
					- "\n    "
				}
				- "\n   "
			}
			- "\n\n   \n  "
		}
		- "\n\n  \n\n  \n\n  "
		hr
		- "\n\n  "
