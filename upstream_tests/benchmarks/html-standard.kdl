									}
								}
								- " attribute."
							}
							li {
								- "If "
								var {
									- "parsed"
								}
								- " is a valid CSS "
								a id="standard-metadata-names:'color-scheme'-3" href="https://drafts.csswg.org/css-color-adjust/#color-scheme-prop" data-x-internal="'color-scheme'" {
									- "'color-scheme'"
								}
								- " property value, then\n        return "
								var {
									- "parsed"
								}
								- "."
