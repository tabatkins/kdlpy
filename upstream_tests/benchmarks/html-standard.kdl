				code {
					- "max"
				}
			}
			- " attribute specifies how much work\n  the task requires in total. The units are arbitrary and not specified."
		}
		- "\n\n  "
		p class="note" {
			- "To make a determinate progress bar, add a "
			code id="the-progress-element:attr-progress-value-2" {
