			}
			- " Tag clouds"
			a href="#tag-clouds" class="self-link"
		}
		- "\n\n  "
		p id="tag-cloud" {
			- "This specification does not define any markup specifically for marking up lists\n  of keywords that apply to a group of pages (also known as "
			i {
				- "tag clouds"
			}
			- "). In general, authors\n  are encouraged to either mark up such lists using "
			code id="tag-clouds:the-ul-element" {
				a href="#the-ul-element" {
					- "ul"
				}
			}
			- " elements with explicit inline\n  counts that are then hidden and turned into a presentational effect using a style sheet, or to use\n  SVG."
		}
