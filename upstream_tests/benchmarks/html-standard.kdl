		- "\n\n  "
		p {
			- "The "
			code id="the-ruby-element:the-ruby-element" {
				a href="#the-ruby-element" {
					- "ruby"
				}
			}
			- " element allows one or more spans of phrasing content to be marked with\n  ruby annotations. Ruby annotations are short runs of text presented alongside base text, primarily\n  used in East Asian typography as a guide for pronunciation or to include other annotations. In\n  Japanese, this form of typography is also known as "
			i {
				- "furigana"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "The content model of "
			code id="the-ruby-element:the-ruby-element-2" {
				a href="#the-ruby-element" {
					- "ruby"
				}
			}
			- " elements consists of one or more of the following\n  sequences:"
		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "One or the other of the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							a href="#phrasing-content-2" id="the-ruby-element:phrasing-content-2-3" {
								- "Phrasing content"
							}
							- ", but with no "
							code id="the-ruby-element:the-ruby-element-3" {
								a href="#the-ruby-element" {
									- "ruby"
								}
							}
							- " elements and with no\n     "
							code id="the-ruby-element:the-ruby-element-4" {
								a href="#the-ruby-element" {
									- "ruby"
								}
							}
							- " element descendants"
						}
					}
					li {
						p {
							- "A single "
							code id="the-ruby-element:the-ruby-element-5" {
								a href="#the-ruby-element" {
									- "ruby"
								}
							}
							- " element that itself has no "
							code id="the-ruby-element:the-ruby-element-6" {
								a href="#the-ruby-element" {
									- "ruby"
								}
							}
							- " element\n     descendants"
						}
					}
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "One or the other of the following:"
				}
				- "\n\n    "
				ul {
					li {
						p {
							- "One or more "
							code id="the-ruby-element:the-rt-element" {
