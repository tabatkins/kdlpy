							li {
								- "\n        "
								p {
									a href="#defineTimeline" id="loading-the-media-resource:defineTimeline" {
										- "Establish the media timeline"
									}
									- " for the purposes of the "
									a href="#current-playback-position" id="loading-the-media-resource:current-playback-position-2" {
										- "current playback\n        position"
									}
									- " and the "
									a href="#earliest-possible-position" id="loading-the-media-resource:earliest-possible-position" {
										- "earliest possible position"
									}
									- ", based on the "
									a href="#media-data" id="loading-the-media-resource:media-data-10" {
