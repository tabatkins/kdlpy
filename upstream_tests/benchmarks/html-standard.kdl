								- "done"
							}
							- "."
						}
					}
					li {
						p {
							- "Let "
							var {
								- "ancestor"
							}
							- " be the node before "
							var {
								- "ancestor"
							}
							- " in the\n     "
							a href="#stack-of-open-elements" id="the-insertion-mode:stack-of-open-elements-3" {
								- "stack of open elements"
