						a href="#the-td-element" {
							- "td"
						}
					}
					- " or "
					code id="the-insertion-mode:the-th-element" {
						a href="#the-th-element" {
							- "th"
						}
					}
					- " element and "
					var {
						- "last"
					}
					- " is\n   false, then switch the "
					a href="#insertion-mode" id="the-insertion-mode:insertion-mode-7" {
						- "insertion mode"
					}
					- " to \""
					a href="#parsing-main-intd" id="the-insertion-mode:parsing-main-intd-2" {
						- "in\n   cell"
					}
					- "\" and return."
				}
			}
			li {
				p {
					- "If "
					var {
						- "node"
					}
					- " is a "
					code id="the-insertion-mode:the-tr-element" {
						a href="#the-tr-element" {
							- "tr"
						}
					}
					- " element, then switch the "
					a href="#insertion-mode" id="the-insertion-mode:insertion-mode-8" {
						- "insertion\n   mode"
