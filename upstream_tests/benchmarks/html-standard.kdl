							- "area"
						}
					}
					- " instead of "
					code id="non-conforming-features:the-a-element-4" {
						a href="#the-a-element" {
							- "a"
						}
					}
					- " for image maps."
				}
			}
			dt {
				dfn data-dfn-for="a" id="attr-a-methods" data-dfn-type="element-attr" {
