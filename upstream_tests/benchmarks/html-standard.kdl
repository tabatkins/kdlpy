				p {
					- "Let "
					var {
						- "dimX"
					}
					- " be the value of "
					var {
						- "exifTagMap"
					}
					- "'s tag "
					code {
						- "0xA002"
					}
					- " ("
					code {
						- "PixelXDimension"
					}
					- ")."
				}
			}
			li {
				p {
