						- "CSS pixels"
					}
					- ";\n   positive numbers indicating that the given baseline is below the "
					a id="drawing-text-to-the-bitmap:alphabetic-baseline-3" href="https://drafts.csswg.org/css-inline/#alphabetic-baseline" data-x-internal="alphabetic-baseline" {
						- "alphabetic\n   baseline"
					}
					- ". (Zero if the given baseline is the "
					a id="drawing-text-to-the-bitmap:alphabetic-baseline-4" href="https://drafts.csswg.org/css-inline/#alphabetic-baseline" data-x-internal="alphabetic-baseline" {
						- "alphabetic baseline"
					}
