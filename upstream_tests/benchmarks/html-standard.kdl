		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "When the steps below require the user agent to "
			dfn id="insert-a-character" {
				- "insert a character"
			}
			- " while processing a\n  token, the user agent must run the following steps:"
		}
		- "\n\n  "
		ol {
			li {
				p {
					- "Let "
					var {
						- "data"
					}
					- " be the characters passed to the algorithm, or, if no\n   characters were explicitly specified, the character of the character token being\n   processed."
				}
			}
			li {
				p {
					- "Let the "
					var {
						- "adjusted insertion location"
					}
					- " be the "
					a href="#appropriate-place-for-inserting-a-node" id="creating-and-inserting-nodes:appropriate-place-for-inserting-a-node-3" {
						- "appropriate\n   place for inserting a node"
					}
					- "."
				}
			}
			li {
				- "\n    "
				p {
					- "If the "
					var {
						- "adjusted insertion location"
					}
					- " is in a "
					code id="creating-and-inserting-nodes:document-2" {
						a href="#document" {
							- "Document"
						}
					}
					- " node,\n    then return.\n\n    "
				}
				p class="note" {
					- "The DOM will not let "
					code id="creating-and-inserting-nodes:document-3" {
						a href="#document" {
							- "Document"
						}
					}
					- " nodes have "
					code id="creating-and-inserting-nodes:text" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node\n    children, so they are dropped on the floor."
				}
				- "\n   "
			}
			li {
				- "\n    "
				p {
					- "If there is a "
					code id="creating-and-inserting-nodes:text-2" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node immediately before the "
					var {
						- "adjusted insertion\n    location"
					}
					- ", then append "
					var {
						- "data"
					}
					- " to that "
					code id="creating-and-inserting-nodes:text-3" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node's "
					a href="https://dom.spec.whatwg.org/#concept-cd-data" id="creating-and-inserting-nodes:concept-cd-data" data-x-internal="concept-cd-data" {
						- "data"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "Otherwise, create a new "
					code id="creating-and-inserting-nodes:text-4" {
						a data-x-internal="text" href="https://dom.spec.whatwg.org/#interface-text" {
							- "Text"
						}
					}
					- " node whose "
					a href="https://dom.spec.whatwg.org/#concept-cd-data" id="creating-and-inserting-nodes:concept-cd-data-2" data-x-internal="concept-cd-data" {
						- "data"
					}
					- " is "
					var {
						- "data"
					}
					- " and\n    whose "
					a id="creating-and-inserting-nodes:node-document-2" href="https://dom.spec.whatwg.org/#concept-node-document" data-x-internal="node-document" {
						- "node document"
					}
					- " is the same as that of the\n    element in which the "
					var {
						- "adjusted insertion location"
					}
					- " finds itself, and insert\n    the newly created node at the "
					var {
						- "adjusted insertion location"
					}
					- "."
				}
				- "\n   "
			}
		}
