				}
				- ", is as follows"
			}
			- ": Return the "
			a href="#best-representation-of-the-number-as-a-floating-point-number" id="range-state-(type=range):best-representation-of-the-number-as-a-floating-point-number-4" {
				- "best representation, as a\n  floating-point number"
			}
			- ", of "
			var {
				- "input"
			}
			- "."
		}
		- "\n\n  \n\n  "
		div class="bookkeeping" {
			- "\n\n   "
			p {
				- "The following common "
				code id="range-state-(type=range):the-input-element-3" {
					a href="#the-input-element" {
						- "input"
					}
				}
				- " element content attributes, IDL attributes, and\n   methods "
				a href="#concept-input-apply" id="range-state-(type=range):concept-input-apply" {
