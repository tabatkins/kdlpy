			dd {
				- "\n    "
				p {
					- "Returns a "
					code id="loading-the-media-resource:timeranges" {
						a href="#timeranges" {
							- "TimeRanges"
						}
					}
					- " object that represents the ranges of the "
					a href="#media-resource" id="loading-the-media-resource:media-resource-21" {
						- "media\n    resource"
					}
					- " that the user agent has buffered."
