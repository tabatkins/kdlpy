					- " "
					c- u="" {
						- "\"/node_modules/moment/src/moment.js\""
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "This enables statements like "
				code class="js" {
					- "import moment from \"moment\";"
				}
				- "\n   to work, fetching and evaluating the JavaScript module at the "
				code {
					- "/node_modules/moment/src/moment.js"
				}
				- " URL."
			}
			- "\n  "
		}
		- "\n\n  "
		div id="example-import-map-trailing-slashes" class="example" {
			- "\n   "
			p {
				- "An import map can remap a class of module specifiers into a class of URLs by using trailing\n   slashes, like so:"
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"imports\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"moment/\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/node_modules/moment/src/\""
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "This enables statements like "
				code class="js" {
					- "import localeData from\n   \"moment/locale/zh-cn.js\";"
				}
				- " to work, fetching and evaluating the JavaScript module at the\n   "
				code {
					- "/node_modules/moment/src/locale/zh-cn.js"
				}
				- " URL. Such trailing-slash\n   mappings are often combined with bare-specifier mappings, e.g."
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"imports\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"moment\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/node_modules/moment/src/moment.js\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"moment/\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/node_modules/moment/src/\""
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "so that both the \"main module\" specified by \""
				code {
					- "moment"
				}
				- "\" and the\n   \"submodules\" specified by paths such as \""
				code {
					- "moment/locale/zh-cn.js"
				}
				- "\" are\n   available."
			}
			- "\n  "
		}
		- "\n\n  "
		div id="example-import-map-url-like-specifier" class="example" {
			- "\n   "
			p {
				- "Bare specifiers are not the only type of module specifiers which import maps can remap.\n   \"URL-like\" specifiers, i.e., those that are either parseable as absolute URLs or start with\n   \""
				code {
					- "/"
				}
				- "\", \""
				code {
					- "./"
				}
				- "\", or \""
				code {
					- "../"
				}
				- "\", can be\n   remapped as well:"
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"imports\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"https://cdn.example.com/vue/dist/vue.runtime.esm.js\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/node_modules/vue/dist/vue.runtime.esm.js\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"/js/app.mjs\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/js/app-8e0d62a03.mjs\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"../helpers/\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"https://cdn.example/helpers/\""
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "Note how the URL to be remapped, as well as the URL being mapped to, can be specified either\n   as absolute URLs, or as relative URLs starting with \""
				code {
					- "/"
				}
				- "\", \""
				code {
					- "./"
				}
				- "\", or \""
				code {
					- "../"
				}
				- "\". (They cannot be specified as relative\n   URLs without those starting sigils, as those help distinguish from bare module specifiers.) Also\n   note how the "
				a href="#example-import-map-trailing-slashes" {
					- "trailing slash mapping"
				}
				- " works in\n   this context as well."
			}
			- "\n\n   "
			p {
				- "Such remappings operate on the post-canonicalization URL, and do not require a match between\n   the literal strings supplied in the import map key and the imported module specifier. So for\n   example, if this import map was included on "
				code {
					- "https://example.com/app.html"
				}
				- ",\n   then not only would "
				code class="js" {
					- "import \"/js/app.mjs\""
				}
				- " be remapped, but so\n   would "
				code class="js" {
					- "import \"./js/app.mjs\""
				}
				- " and "
				code class="js" {
					- "import \"./foo/../js/app.mjs\""
				}
				- "."
			}
			- "\n  "
		}
		- "\n\n  "
		div id="example-import-map-scopes" class="example" {
			- "\n   "
			p {
				- "All previous examples have globally remapped module specifiers, by using the top-level \""
				code {
					- "imports"
				}
				- "\" key in the import map. The top-level \""
				code {
					- "scopes"
				}
				- "\"\n   key can be used to provide localized remappings, which only apply when the referring module\n   matches a specific URL prefix. For example:"
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"scopes\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"/a/\""
					}
					- " "
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      "
					c- u="" {
						- "\"moment\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/node_modules/moment/src/moment.js\""
					}
					- "\n    "
					c- p="" {
						- "},"
					}
					- "\n    "
					c- u="" {
						- "\"/b/\""
					}
					- " "
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      "
					c- u="" {
						- "\"moment\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"https://cdn.example.com/moment/src/moment.js\""
					}
					- "\n    "
					c- p="" {
						- "}"
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "With this import map, the statement "
				code {
					- "import \"moment\""
				}
				- " will have\n   different meanings depending on which referrer script contains the statement:"
			}
			- "\n\n   "
			ul {
				li {
					p {
						- "Inside scripts located under "
						code {
							- "/a/"
						}
						- ", this will import "
						code {
							- "/node_modules/moment/src/moment.js"
						}
						- "."
					}
				}
				li {
					p {
						- "Inside scripts located under "
						code {
							- "/b/"
						}
						- ", this will import "
						code {
							- "https://cdn.example.com/moment/src/moment.js"
						}
						- "."
					}
				}
				li {
					p {
						- "Inside scripts located under "
						code {
							- "/c/"
						}
						- ", this will fail to resolve and\n    thus throw an exception."
					}
				}
			}
			- "\n\n   "
			p {
				- "A typical usage of scopes is to allow multiple versions of the \"same\" module to exist in a\n   web application, with some parts of the module graph importing one version, and other parts\n   importing another version.\n  "
			}
		}
		- "\n\n  "
		div id="example-import-map-scopes-overlapping" class="example" {
			- "\n   "
			p {
				- "Scopes can overlap each other, and overlap the global \""
				code {
					- "imports"
				}
				- "\"\n   specifier map. At resolution time, scopes are consulted in order of most- to least-specific,\n   where specificity is measured by sorting the scopes using the "
				a id="import-maps:code-unit-less-than" href="https://infra.spec.whatwg.org/#code-unit-less-than" data-x-internal="code-unit-less-than" {
					- "code unit less than"
				}
				- "\n   operation. So, for example, \""
				code {
					- "/scope2/scope3/"
				}
				- "\" is treated as more specific\n   than \""
				code {
					- "/scope2/"
				}
				- "\", which is treated as more specific than the top-level\n   (unscoped) mappings."
			}
			- "\n\n   "
			p {
				- "The following import map illustrates this:"
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"imports\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"a\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/a-1.mjs\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"b\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/b-1.mjs\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"c\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/c-1.mjs\""
					}
					- "\n  "
					c- p="" {
						- "},"
					}
					- "\n  "
					c- u="" {
						- "\"scopes\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"/scope2/\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      "
					c- u="" {
						- "\"a\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/a-2.mjs\""
					}
					- "\n    "
					c- p="" {
						- "},"
					}
					- "\n    "
					c- u="" {
						- "\"/scope2/scope3/\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n      "
					c- u="" {
						- "\"b\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/b-3.mjs\""
					}
					- "\n    "
					c- p="" {
						- "}"
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n\n   "
			p {
				- "This results in the following resolutions (using relative URLs for brevity):"
			}
			- "\n\n   "
			table id="table-import-map-scopes-example" {
				thead {
					tr {
						td colspan="2" rowspan="2" {
							- "\n      "
						}
						th colspan="3" {
							- "Specifier\n     "
						}
					}
					tr {
						th {
							- "\""
							code {
								- "a"
							}
							- "\"\n      "
						}
						th {
							- "\""
							code {
								- "b"
							}
							- "\"\n      "
						}
						th {
							- "\""
							code {
								- "c"
							}
							- "\"\n    "
						}
					}
				}
				tbody {
					tr {
						th rowspan="3" {
							- "Referrer\n      "
						}
						th {
							code {
								- "/scope1/r.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/a-1.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/b-1.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/c-1.mjs"
							}
							- "\n     "
						}
					}
					tr {
						th {
							code {
								- "/scope2/r.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/a-2.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/b-1.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/c-1.mjs"
							}
							- "\n     "
						}
					}
					tr {
						th {
							code {
								- "/scope2/scope3/r.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/a-2.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/b-3.mjs"
							}
							- "\n      "
						}
						td {
							code {
								- "/c-1.mjs"
							}
							- "\n   "
						}
					}
				}
			}
			- "\n  "
		}
		- "\n\n  "
		div id="example-import-map-integrity" class="example" {
			- "\n   "
			p {
				- "Import maps can also be used to provide modules with integrity metadata to be used in\n   "
				cite {
					- "Subresource Integrity"
				}
				- " checks. "
				a href="#refsSRI" {
					- "[SRI]"
				}
				- "\n   "
			}
			- "\n\n   "
			p {
				- "The following import map illustrates this:"
			}
			- "\n\n   "
			pre {
				code class="json" {
					c- p="" {
						- "{"
					}
					- "\n  "
					c- u="" {
						- "\"imports\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"a\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/a-1.mjs\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"b\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/b-1.mjs\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"c\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"/c-1.mjs\""
					}
					- "\n  "
					c- p="" {
						- "},"
					}
					- "\n  "
					c- u="" {
						- "\"integrity\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- p="" {
						- "{"
					}
					- "\n    "
					c- u="" {
						- "\"/a-1.mjs\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"sha384-Li9vy3DqF8tnTXuiaAJuML3ky+er10rcgNR/VqsVpcw+ThHmYcwiB1pbOxEbzJr7\""
					}
					c- p="" {
						- ","
					}
					- "\n    "
					c- u="" {
						- "\"/d-1.mjs\""
					}
					c- o="" {
						- ":"
					}
					- " "
					c- u="" {
						- "\"sha384-MBO5IDfYaE6c6Aao94oZrIOiC6CGiSN2n4QUbHNPhzk5Xhm0djZLQqTpL0HzTUxk\""
					}
					- "\n  "
					c- p="" {
						- "}"
					}
					- "\n"
					c- p="" {
						- "}"
					}
				}
			}
			- "\n   "
			p {
				- "The above example provides integrity metadata to be enforced on the modules "
				code {
					- "/a-1.mjs"
				}
				- " and "
				code {
					- "/d-1.mjs"
				}
				- ", even if the latter is not defined\n   as an import in the map."
			}
			- "\n  "
		}
		- "\n\n  "
		hr
		- "\n\n  "
		p {
			- "The "
			a id="import-maps:child-text-content-2" href="https://dom.spec.whatwg.org/#concept-child-text-content" data-x-internal="child-text-content" {
				- "child text content"
			}
			- " of a "
			code id="import-maps:the-script-element-3" {
				a href="#the-script-element" {
					- "script"
				}
			}
			- " element representing an\n  "
			a href="#import-map" id="import-maps:import-map" {
				- "import map"
			}
			- " must match the following "
			dfn id="import-map-authoring-requirements" {
				- "import map authoring\n  requirements"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "It must be valid JSON. "
					a href="#refsJSON" {
						- "[JSON]"
					}
				}
			}
			li {
				p {
					- "The JSON must represent a JSON object, with at most the three keys \""
					code {
						- "imports"
					}
					- "\", \""
					code {
						- "scopes"
					}
					- "\", and \""
					code {
						- "integrity"
					}
					- "\"."
				}
			}
			li {
				p {
					- "The values corresponding to the \""
					code {
						- "imports"
					}
					- "\", \""
					code {
						- "scopes"
					}
					- "\", and \""
					code {
						- "integrity"
					}
					- "\" keys, if present,\n   must themselves be JSON objects."
				}
			}
			li {
				p {
					- "The value corresponding to the \""
					code {
						- "imports"
					}
					- "\" key, if present, must be\n   a "
					a href="#valid-module-specifier-map" id="import-maps:valid-module-specifier-map" {
						- "valid module specifier map"
					}
					- "."
				}
			}
			li {
				p {
					- "The value corresponding to the \""
					code {
						- "scopes"
					}
					- "\" key, if present, must be a\n   JSON object, whose keys are "
					a href="https://url.spec.whatwg.org/#valid-url-string" id="import-maps:valid-url-string" data-x-internal="valid-url-string" {
						- "valid URL strings"
					}
					- " and whose\n   values are "
					a href="#valid-module-specifier-map" id="import-maps:valid-module-specifier-map-2" {
						- "valid module specifier\n   maps"
					}
					- "."
				}
			}
			li {
				p {
					- "The value corresponding to the \""
					code {
						- "integrity"
					}
					- "\" key, if present, must\n   be a JSON object, whose keys are "
					a href="https://url.spec.whatwg.org/#valid-url-string" id="import-maps:valid-url-string-2" data-x-internal="valid-url-string" {
						- "valid URL strings"
					}
					- " and\n   whose values fit "
					a id="import-maps:the-requirements-of-the-integrity-attribute" href="https://w3c.github.io/webappsec-subresource-integrity/#the-integrity-attribute" data-x-internal="the-requirements-of-the-integrity-attribute" {
						- "the requirements of the integrity attribute"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="valid-module-specifier-map" {
				- "valid module specifier map"
			}
			- " is a JSON object that meets the following\n  requirements:"
		}
		- "\n\n  "
		ul {
			li {
				p {
					- "All of its keys must be nonempty."
				}
			}
			li {
				p {
					- "All of its values must be strings."
				}
			}
			li {
				p {
					- "Each value must be either a "
					a href="https://url.spec.whatwg.org/#syntax-url-absolute" id="import-maps:absolute-url" data-x-internal="absolute-url" {
						- "valid absolute URL"
					}
					- " or a\n   "
					a id="import-maps:valid-url-string-3" href="https://url.spec.whatwg.org/#valid-url-string" data-x-internal="valid-url-string" {
						- "valid URL string"
					}
					- " that "
					a id="import-maps:starts-with" href="https://infra.spec.whatwg.org/#string-starts-with" data-x-internal="starts-with" {
						- "starts with"
					}
					- " \""
					code {
						- "/"
					}
					- "\", \""
					code {
						- "./"
					}
					- "\", or \""
					code {
						- "../"
					}
					- "\"."
				}
			}
			li {
				p {
					- "If a given key "
					a id="import-maps:ends-with" href="https://infra.spec.whatwg.org/#string-ends-with" data-x-internal="ends-with" {
						- "ends with"
					}
					- " \""
					code {
						- "/"
					}
					- "\", then the corresponding\n   value must also."
				}
			}
		}
		- "\n\n\n  \n\n  "
		h5 id="import-map-processing-model" {
			span class="secno" {
				- "8.1.5.3"
			}
			- " Import map processing model"
			a href="#import-map-processing-model" class="self-link"
		}
		- "\n\n  "
		p {
			- "Formally, an "
			dfn id="import-map" {
				- "import map"
			}
			- " is a "
			a id="import-map-processing-model:struct" href="https://infra.spec.whatwg.org/#struct" data-x-internal="struct" {
				- "struct"
			}
			- " with three "
			a href="https://infra.spec.whatwg.org/#struct-item" id="import-map-processing-model:struct-item" data-x-internal="struct-item" {
				- "items"
			}
			- ":"
		}
		- "\n\n  "
		ul {
			li {
				p {
					dfn id="concept-import-map-imports" {
						- "imports"
					}
					- ", a "
					a href="#module-specifier-map" id="import-map-processing-model:module-specifier-map" {
						- "module specifier\n   map"
					}
					- ";"
				}
			}
			li {
				p {
					dfn id="concept-import-map-scopes" {
						- "scopes"
					}
					- ", an "
					a id="import-map-processing-model:ordered-map" href="https://infra.spec.whatwg.org/#ordered-map" data-x-internal="ordered-map" {
						- "ordered map"
					}
					- " of\n   "
					a href="https://url.spec.whatwg.org/#concept-url" id="import-map-processing-model:url" data-x-internal="url" {
						- "URLs"
					}
					- " to "
					a href="#module-specifier-map" id="import-map-processing-model:module-specifier-map-2" {
						- "module specifier\n   maps"
					}
					- "; and"
				}
			}
			li {
				p {
					dfn id="concept-import-map-integrity" {
						- "integrity"
					}
					- ", a "
					a href="#module-integrity-map" id="import-map-processing-model:module-integrity-map" {
						- "module integrity\n   map"
					}
					- "."
				}
			}
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="module-specifier-map" {
				- "module specifier map"
			}
			- " is an "
			a id="import-map-processing-model:ordered-map-2" href="https://infra.spec.whatwg.org/#ordered-map" data-x-internal="ordered-map" {
				- "ordered map"
			}
			- " whose "
			a href="https://infra.spec.whatwg.org/#map-key" id="import-map-processing-model:map-key" data-x-internal="map-key" {
				- "keys"
			}
			- " are "
			a href="https://infra.spec.whatwg.org/#string" id="import-map-processing-model:string" data-x-internal="string" {
				- "strings"
			}
			- " and whose "
			a href="https://infra.spec.whatwg.org/#map-value" id="import-map-processing-model:map-value" data-x-internal="map-value" {
				- "values"
			}
			- " are either "
			a href="https://url.spec.whatwg.org/#concept-url" id="import-map-processing-model:url-2" data-x-internal="url" {
				- "URLs"
			}
			- " or nulls."
		}
		- "\n\n  "
		p {
			- "A "
			dfn id="module-integrity-map" {
				- "module integrity map"
			}
			- " is an "
			a id="import-map-processing-model:ordered-map-3" href="https://infra.spec.whatwg.org/#ordered-map" data-x-internal="ordered-map" {
				- "ordered map"
			}
			- " whose "
			a href="https://infra.spec.whatwg.org/#map-key" id="import-map-processing-model:map-key-2" data-x-internal="map-key" {
				- "keys"
			}
			- " are "
			a href="https://url.spec.whatwg.org/#concept-url" id="import-map-processing-model:url-3" data-x-internal="url" {
				- "URLs"
			}
			- " and whose "
			a href="https://infra.spec.whatwg.org/#map-value" id="import-map-processing-model:map-value-2" data-x-internal="map-value" {
				- "values"
			}
			- " are "
			a href="https://infra.spec.whatwg.org/#string" id="import-map-processing-model:string-2" data-x-internal="string" {
				- "strings"
			}
			- " that will be used as "
			a href="https://fetch.spec.whatwg.org/#concept-request-integrity-metadata" id="import-map-processing-model:concept-request-integrity-metadata" data-x-internal="concept-request-integrity-metadata" {
				- "integrity metadata"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "An "
			dfn id="empty-import-map" {
				- "empty import map"
			}
			- " is an "
			a href="#import-map" id="import-map-processing-model:import-map" {
				- "import map"
			}
