		- "\n\n\n  "
		h5 id="communicating-with-a-dedicated-worker" {
			span class="secno" {
				- "10.1.3.2"
			}
			- " Communicating with a dedicated worker"
			a href="#communicating-with-a-dedicated-worker" class="self-link"
		}
		- "\n\n  "
		p {
			i {
				- "This section is non-normative."
			}
		}
		- "\n\n  "
		p {
			- "Dedicated workers use "
			code id="communicating-with-a-dedicated-worker:messageport" {
				a href="#messageport" {
					- "MessagePort"
				}
			}
			- " objects behind the scenes, and thus support all\n  the same features, such as sending structured data, transferring binary data, and transferring\n  other ports."
		}
		- "\n\n  "
		p {
			- "To receive messages from a dedicated worker, use the "
			code id="communicating-with-a-dedicated-worker:handler-messageeventtarget-onmessage" {
				a href="#handler-messageeventtarget-onmessage" {
					- "onmessage"
				}
			}
			- " "
			a href="#event-handler-idl-attributes" id="communicating-with-a-dedicated-worker:event-handler-idl-attributes" {
				- "event handler IDL attribute"
			}
			- " on the "
			code id="communicating-with-a-dedicated-worker:worker" {
				a href="#worker" {
					- "Worker"
				}
			}
			- " object:"
		}
		- "\n\n  "
		pre {
			code class="js" {
				- "worker"
				c- p="" {
					- "."
				}
				- "onmessage "
