						}
					}
					span class="chrome_android unknown" {
						span {
							- "Chrome Android"
						}
						span {
							- "?"
						}
					}
					span class="webview_android unknown" {
						span {
							- "WebView Android"
						}
						span {
							- "?"
						}
					}
					span class="samsunginternet_android unknown" {
						span {
							- "Samsung Internet"
						}
						span {
							- "?"
						}
					}
					span class="opera_android yes" {
						span {
							- "Opera Android"
						}
						span {
							- "12.1+"
						}
					}
				}
			}
		}
		pre {
			code class="idl" {
				- "["
				c- g="" {
					- "Exposed"
				}
				- "="
				c- n="" {
					- "Window"
				}
				- "]\n"
				c- b="" {
					- "interface"
				}
				- " "
				dfn id="htmlmodelement" data-dfn-type="interface" {
					c- g="" {
						- "HTMLModElement"
					}
				}
				- " : "
				a href="#htmlelement" id="attributes-common-to-ins-and-del-elements:htmlelement" {
					c- n="" {
						- "HTMLElement"
					}
				}
				- " {\n  ["
				a href="#htmlconstructor" id="attributes-common-to-ins-and-del-elements:htmlconstructor" {
					c- g="" {
