						- "Drop any items in the list beyond the third."
					}
					dt {
						a href="#attr-area-shape-default" id="image-map-processing-model:attr-area-shape-default-2" {
							- "Default state"
						}
					}
					dd {
						- "Drop all items in the list."
					}
					dt {
						a href="#attr-area-shape-poly" id="image-map-processing-model:attr-area-shape-poly-2" {
							- "Polygon state"
						}
					}
					dd {
						- "Drop the last item if there's an odd number of items."
					}
					dt {
						a href="#attr-area-shape-rect" id="image-map-processing-model:attr-area-shape-rect-2" {
							- "Rectangle state"
						}
					}
					dd {
						- "Drop any items in the list beyond the fourth."
					}
				}
				- "\n   "
			}
			li {
				p {
					- "If the "
					code id="image-map-processing-model:attr-area-shape-3" {
						a href="#attr-area-shape" {
							- "shape"
						}
					}
					- " attribute represents the "
					a href="#attr-area-shape-rect" id="image-map-processing-model:attr-area-shape-rect-3" {
						- "rectangle state"
					}
					- ", and the first number in the list is\n   numerically greater than the third number in the list, then swap those two numbers around."
				}
			}
			li {
				p {
					- "If the "
					code id="image-map-processing-model:attr-area-shape-4" {
						a href="#attr-area-shape" {
							- "shape"
						}
					}
					- " attribute represents the "
					a href="#attr-area-shape-rect" id="image-map-processing-model:attr-area-shape-rect-4" {
						- "rectangle state"
					}
					- ", and the second number in the list is\n   numerically greater than the fourth number in the list, then swap those two numbers around."
				}
			}
			li {
				p {
					- "If the "
					code id="image-map-processing-model:attr-area-shape-5" {
						a href="#attr-area-shape" {
							- "shape"
						}
					}
					- " attribute represents the "
					a href="#attr-area-shape-circle" id="image-map-processing-model:attr-area-shape-circle-3" {
						- "circle state"
					}
					- ", and the third number in the list is less than\n   or equal to zero, then the shape is empty; return."
				}
			}
			li {
				p {
					- "Now, the shape represented by the element is the one described for the entry in the list\n   below corresponding to the state of the "
					code id="image-map-processing-model:attr-area-shape-6" {
						a href="#attr-area-shape" {
							- "shape"
						}
					}
					- " attribute:"
				}
				- "\n\n    "
				dl class="switch" {
					dt {
						a href="#attr-area-shape-circle" id="image-map-processing-model:attr-area-shape-circle-4" {
							- "Circle state"
						}
					}
					dd {
						- "\n      "
						p {
							- "Let "
							var {
								- "x"
							}
							- " be the first number in "
							var {
								- "coords"
							}
							- ", "
							var {
								- "y"
							}
							- " be the second number, and "
							var {
								- "r"
							}
							- " be the third number."
						}
						- "\n\n      "
						p {
							- "The shape is a circle whose center is "
							var {
								- "x"
							}
							- " "
							a href="https://drafts.csswg.org/css-values/#px" id="image-map-processing-model:'px'" data-x-internal="'px'" {
								- "CSS pixels"
							}
							- "\n      from the left edge of the image and "
							var {
								- "y"
							}
							- " "
							a href="https://drafts.csswg.org/css-values/#px" id="image-map-processing-model:'px'-2" data-x-internal="'px'" {
								- "CSS pixels"
							}
							- " from\n      the top edge of the image, and whose radius is "
							var {
								- "r"
							}
							- " "
							a href="https://drafts.csswg.org/css-values/#px" id="image-map-processing-model:'px'-3" data-x-internal="'px'" {
								- "CSS\n      pixels"
							}
							- "."
						}
						- "\n     "
					}
					dt {
						a href="#attr-area-shape-default" id="image-map-processing-model:attr-area-shape-default-3" {
							- "Default state"
						}
					}
					dd {
						- "\n      "
						p {
							- "The shape is a rectangle that exactly covers the entire image."
						}
						- "\n     "
					}
					dt {
						a href="#attr-area-shape-poly" id="image-map-processing-model:attr-area-shape-poly-3" {
							- "Polygon state"
						}
					}
					dd {
						- "\n      "
						p {
							- "Let "
							var {
								- "x"
								sub {
									var {
										- "i"
									}
								}
							}
							- " be the "
							span {
								- "(2"
								var {
									- "i"
								}
								- ")"
							}
							- "th entry in "
							var {
								- "coords"
							}
							- ", and "
							var {
								- "y"
								sub {
									var {
										- "i"
									}
								}
							}
							- " be the "
							span {
								- "(2"
								var {
									- "i"
								}
								- "+1)"
							}
							- "th entry in "
							var {
								- "coords"
							}
							- " (the first entry in "
							var {
								- "coords"
							}
							- " being the one with index 0)."
						}
						- "\n\n      "
						p {
							- "Let "
							var {
								- "the coordinates"
							}
							- " be ("
							var {
								- "x"
								sub {
									var {
										- "i"
									}
								}
							}
							- ", "
							var {
								- "y"
								sub {
									var {
										- "i"
									}
								}
							}
							- "),\n      interpreted in "
							a href="https://drafts.csswg.org/css-values/#px" id="image-map-processing-model:'px'-4" data-x-internal="'px'" {
								- "CSS pixels"
							}
							- " measured from the top left of the image,\n      for all integer values of "
							var {
								- "i"
							}
							- " from 0 to "
							span {
								- "("
								var {
									- "N"
								}
								- "/2)-1"
							}
							- ",\n      where "
							var {
								- "N"
							}
							- " is the number of items in "
							var {
								- "coords"
							}
							- "."
						}
						- "\n\n      "
						p {
							- "The shape is a polygon whose vertices are given by "
							var {
								- "the coordinates"
							}
							- ", and whose\n      interior is established using the even-odd rule. "
							a href="#refsGRAPHICS" {
								- "[GRAPHICS]"
							}
						}
						- "\n\n      \n     "
					}
					dt {
						a href="#attr-area-shape-rect" id="image-map-processing-model:attr-area-shape-rect-5" {
							- "Rectangle state"
						}
					}
					dd {
						- "\n      "
						p {
							- "Let "
							var {
								- "x"
								sub {
									- "1"
								}
							}
							- " be the first number in "
							var {
								- "coords"
							}
							- ", "
							var {
								- "y"
								sub {
									- "1"
								}
							}
							- " be the second number, "
							var {
								- "x"
								sub {
									- "2"
								}
							}
							- " be the third number, and "
							var {
								- "y"
								sub {
									- "2"
								}
							}
							- " be the fourth number."
						}
						- "\n\n      "
						p {
							- "The shape is a rectangle whose top-left corner is given by the coordinate ("
							var {
								- "x"
								sub {
									- "1"
								}
							}
							- ", "
							var {
								- "y"
								sub {
									- "1"
								}
							}
							- ") and whose\n      bottom right corner is given by the coordinate ("
							var {
								- "x"
								sub {
									- "2"
								}
							}
							- ",\n      "
							var {
								- "y"
								sub {
									- "2"
								}
							}
							- "), those coordinates being interpreted as "
							a href="https://drafts.csswg.org/css-values/#px" id="image-map-processing-model:'px'-5" data-x-internal="'px'" {
								- "CSS\n      pixels"
							}
							- " from the top left corner of the image."
						}
						- "\n     "
					}
				}
				- "\n\n    "
				p {
					- "For historical reasons, the coordinates must be interpreted relative to the\n    "
					em {
						- "displayed"
					}
					- " image after any stretching caused by the CSS "
					a id="image-map-processing-model:'width'" href="https://drafts.csswg.org/css2/#the-width-property" data-x-internal="'width'" {
						- "'width'"
					}
					- " and\n    "
					a id="image-map-processing-model:'height'" href="https://drafts.csswg.org/css2/#the-height-property" data-x-internal="'height'" {
						- "'height'"
					}
					- " properties (or, for non-CSS browsers, the image element's "
					code {
						- "width"
					}
					- " and "
					code {
						- "height"
					}
					- " attributes — CSS browsers map\n    those attributes to the aforementioned CSS properties)."
				}
				- "\n\n    "
				p class="note" {
					- "Browser zoom features and transforms applied using CSS or SVG do not affect the\n    coordinates."
				}
				- "\n   "
			}
		}
		- "\n\n  "
		p {
			- "Pointing device interaction with an image associated with a set of layered shapes per the above\n  algorithm must result in the relevant user interaction events being first fired to the top-most\n  shape covering the point that the pointing device indicated, if any, or to the image element\n  itself, if there is no shape covering that point. User agents may also allow individual\n  "
			code id="image-map-processing-model:the-area-element-12" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements representing "
			a href="#hyperlink" id="image-map-processing-model:hyperlink-2" {
				- "hyperlinks"
			}
			- " to be selected\n  and activated (e.g. using a keyboard)."
		}
		- "\n\n  "
		p class="note" {
			- "Because a "
			code id="image-map-processing-model:the-map-element-2" {
				a href="#the-map-element" {
					- "map"
				}
			}
			- " element (and its "
			code id="image-map-processing-model:the-area-element-13" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- " elements) can be\n  associated with multiple "
			code id="image-map-processing-model:the-img-element-5" {
				a href="#the-img-element" {
					- "img"
				}
			}
			- " elements, it is possible for an "
			code id="image-map-processing-model:the-area-element-14" {
				a href="#the-area-element" {
					- "area"
				}
			}
			- "\n  element to correspond to multiple "
			i id="image-map-processing-model:focusable-area" {
				a href="#focusable-area" {
					- "focusable areas"
				}
			}
			- " of the\n  document."
		}
		- "\n\n  "
		p {
			- "Image maps are "
			a href="#live" id="image-map-processing-model:live" {
				- "live"
			}
			- "; if the DOM is mutated, then the user agent must act as if it\n  had rerun the algorithms for image maps."
		}
		- "\n\n  \n\n\n\n  "
		h4 id="mathml" {
			span class="secno" {
				- "4.8.15"
			}
			- " MathML"
			a href="#mathml" class="self-link"
		}
		div class="mdn-anno wrapped" {
			button onclick="toggleStatus(this)" class="mdn-anno-btn" {
				b title="Support in all current engines." class="all-engines-flag" {
					- "✔"
				}
