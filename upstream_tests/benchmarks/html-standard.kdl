			p {
				- "In modern user agents that support "
				a href="#javascript-module-script" id="the-script-element:javascript-module-script-7" {
					- "JavaScript module\n  scripts"
				}
				- ", the "
				code id="the-script-element:the-script-element-19" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element with the "
				code id="the-script-element:attr-script-nomodule-7" {
					a href="#attr-script-nomodule" {
						- "nomodule"
					}
				}
				- " attribute will be ignored, and the\n  "
				code id="the-script-element:the-script-element-20" {
					a href="#the-script-element" {
						- "script"
					}
				}
				- " element with a "
				code id="the-script-element:attr-script-type-9" {
					a href="#attr-script-type" {
						- "type"
					}
				}
				- " of \""
				code {
