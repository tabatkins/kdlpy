									a href="#toggle-audio-track" {
										- "will cause a "
										code {
											- "change"
										}
										- " event to be fired"
									}
									- "."
								}
							}
							li {
								p {
									- "If there is no "
									a href="#dom-videotrack-selected" id="loading-the-media-resource:dom-videotrack-selected-2" {
										- "selected"
									}
									- " video track,\n       then select a video track. This "
									a href="#toggle-video-track" {
										- "will cause a "
										code {
											- "change"
										}
										- " event to be fired"
									}
									- "."
								}
							}
						}
						- "\n\n      "
						p {
							- "Once the "
							code id="loading-the-media-resource:dom-media-readystate-4" {
								a href="#dom-media-readystate" {
									- "readyState"
								}
							}
							- " attribute reaches "
							code id="loading-the-media-resource:dom-media-have_current_data" {
								a href="#dom-media-have_current_data" {
									- "HAVE_CURRENT_DATA"
								}
							}
							- ", "
							a href="#fire-loadeddata" {
								- "after\n      the "
								code {
									- "loadeddata"
								}
								- " event has been fired"
							}
							- ", set the\n      element's "
