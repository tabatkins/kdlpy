						- "\n\n       "
						ol {
							li {
								- "Let "
								var {
									- "parsed"
								}
								- " be the result of "
								a href="https://drafts.csswg.org/css-syntax/#parse-a-list-of-component-values" id="standard-metadata-names:parse-a-list-of-component-values" data-x-internal="parse-a-list-of-component-values" {
