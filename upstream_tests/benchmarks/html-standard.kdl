						}
						- " evaluates to false, but\n     "
						code {
							- "(max-width: 50em)"
						}
						- " evaluates to true\n     and "
						code {
							- "50vw"
						}
						- " is used, so the image size, for the purpose of resource\n     selection, is "
						code {
							- "16em"
