						- "Email"
					}
					- ", "
					a href="#url-state-(type=url)" id="definitions:url-state-(type=url)" {
						- "URL"
					}
					- ").\n    "
				}
				- "\n\n    "
				p {
					- "When the "
					code id="definitions:dom-elementinternals-setvalidity-3" {
						a href="#dom-elementinternals-setvalidity" {
							- "setValidity()"
						}
					}
					- " method sets\n    "
					code {
						- "typeMismatch"
					}
					- " flag to true for a\n    "
					a href="#form-associated-custom-element" id="definitions:form-associated-custom-element-4" {
						- "form-associated custom element"
					}
					- "."
				}
				- "\n   "
			}
			dt {
				- " "
				dfn id="suffering-from-a-pattern-mismatch" {
					- "Suffering from a pattern mismatch"
				}
				- " "
