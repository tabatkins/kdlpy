			dd {
				- "\n    "
				p {
					- "A user agent-generated random UUID string representing this navigation history entry's place\n    in the navigation history list. This value will be reused by other\n    "
					code id="the-navigationhistoryentry-interface:navigationhistoryentry-2" {
						a href="#navigationhistoryentry" {
							- "NavigationHistoryEntry"
						}
					}
					- " instances that replace this one due to \""
