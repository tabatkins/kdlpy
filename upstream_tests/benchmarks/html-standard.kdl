					a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-string-type" id="structuredserializeinternal:js-string" data-x-internal="js-string" {
						- "a String"
					}
					- ", then return { [[Type]]: \"primitive\", [[Value]]:\n   "
					var {
						- "value"
					}
					- " }."
				}
			}
			li {
				p {
					- "If "
					var {
						- "value"
					}
					- " "
					a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-symbol-type" id="structuredserializeinternal:js-symbol" data-x-internal="js-symbol" {
						- "is a Symbol"
					}
