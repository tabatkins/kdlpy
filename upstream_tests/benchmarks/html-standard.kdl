				}
				- " "
				c- e="" {
					- "pattern"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"[0-9]{8,19}\""
				}
				- " "
				c- e="" {
					- "autocomplete"
				}
				c- o="" {
					- "="
				}
				c- s="" {
					- "\"cc-number\""
				}
				c- p="" {
					- ">"
				}
				- "\n"
				c- p="" {
					- "</"
				}
				c- f="" {
					- "label"
				}
				c- p="" {
