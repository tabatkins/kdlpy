				- "An end tag whose tag name is one of: \"address\", \"article\", \"aside\", \"blockquote\", \"button\",\n   \"center\", \"details\", \"dialog\", \"dir\", \"div\", \"dl\", \"fieldset\", \"figcaption\", \"figure\", \"footer\",\n   \"header\", \"hgroup\", \"listing\", \"main\", \"menu\", \"nav\", \"ol\", \"pre\", \"search\", \"section\",\n   \"summary\", \"ul\""
			}
			dd {
				- "\n    "
