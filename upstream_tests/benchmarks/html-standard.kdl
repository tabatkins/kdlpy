		}
		- "\n\n  "
		ol {
			li {
				- "\n    "
				p {
					- "If "
					var {
						- "entry"
					}
					- "'s "
					a href="#she-scroll-restoration-mode" id="persisted-user-state-restoration:she-scroll-restoration-mode" {
