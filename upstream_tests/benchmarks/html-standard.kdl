						}
						- "\n     "
					}
					li {
						p {
							- "Otherwise, if "
							var {
								- "node"
							}
							- " is in the "
							a href="#special" id="parsing-main-inbody:special-3" {
								- "special"
							}
							- " category, then\n     this is a "
							a href="#parse-errors" id="parsing-main-inbody:parse-errors-40" {
								- "parse error"
							}
