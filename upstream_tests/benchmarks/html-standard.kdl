								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "3+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "12.1+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "9+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios yes" {
								span {
									- "Safari iOS"
								}
								span title="Partial implementation." {
									- "🔰 3+"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android yes" {
								span {
									- "WebView Android"
								}
								span {
									- "37+"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "12.1+"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns the current playback volume, as a number in the range 0.0 to 1.0, where 0.0 is the\n    quietest and 1.0 the loudest."
				}
				- "\n\n    "
				p {
					- "Can be set, to change the volume."
				}
				- "\n\n    "
				p {
					- "Throws an "
					a id="user-interface:indexsizeerror" href="https://webidl.spec.whatwg.org/#indexsizeerror" data-x-internal="indexsizeerror" {
						- "\""
						code {
							- "IndexSizeError"
						}
						- "\""
					}
					- " "
					code id="user-interface:domexception" {
						a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
							- "DOMException"
						}
					}
					- " if the new\n    value is not in the range 0.0 .. 1.0."
				}
				- "\n   "
			}
			dt {
				code {
					var {
						- "media"
					}
					- "."
					a href="#dom-media-muted" id="dom-media-muted-dev" {
						- "muted"
					}
					- " [ = "
					var {
						- "value"
					}
					- " ]"
				}
				div class="mdn-anno wrapped before" {
					button onclick="toggleStatus(this)" class="mdn-anno-btn" {
						b title="Support in all current engines." class="all-engines-flag" {
							- "✔"
						}
						span {
							- "MDN"
						}
					}
					div class="feature" {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLMediaElement/muted" title="The HTMLMediaElement.muted property indicates whether the media element is muted." {
								- "HTMLMediaElement/muted"
							}
						}
						p class="all-engines-text" {
							- "Support in all current engines."
						}
						div class="support" {
							span class="firefox yes" {
								span {
									- "Firefox"
								}
								span {
									- "3.5+"
								}
							}
							span class="safari yes" {
								span {
									- "Safari"
								}
								span {
									- "3.1+"
								}
							}
							span class="chrome yes" {
								span {
									- "Chrome"
								}
								span {
									- "3+"
								}
							}
							hr
							span class="opera yes" {
								span {
									- "Opera"
								}
								span {
									- "12.1+"
								}
							}
							span class="edge_blink yes" {
								span {
									- "Edge"
								}
								span {
									- "79+"
								}
							}
							hr
							span class="edge yes" {
								span {
									- "Edge (Legacy)"
								}
								span {
									- "12+"
								}
							}
							span class="ie yes" {
								span {
									- "Internet Explorer"
								}
								span {
									- "9+"
								}
							}
							hr
							span class="firefox_android unknown" {
								span {
									- "Firefox Android"
								}
								span {
									- "?"
								}
							}
							span class="safari_ios yes" {
								span {
									- "Safari iOS"
								}
								span {
									- "3+"
								}
							}
							span class="chrome_android unknown" {
								span {
									- "Chrome Android"
								}
								span {
									- "?"
								}
							}
							span class="webview_android yes" {
								span {
									- "WebView Android"
								}
								span {
									- "37+"
								}
							}
							span class="samsunginternet_android unknown" {
								span {
									- "Samsung Internet"
								}
								span {
									- "?"
								}
							}
							span class="opera_android yes" {
								span {
									- "Opera Android"
								}
								span {
									- "12.1+"
								}
							}
						}
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "Returns true if audio is muted, overriding the "
					code id="user-interface:dom-media-volume" {
						a href="#dom-media-volume" {
							- "volume"
						}
					}
					- "\n    attribute, and false if the "
					code id="user-interface:dom-media-volume-2" {
						a href="#dom-media-volume" {
							- "volume"
						}
					}
					- " attribute is being\n    honored."
				}
				- "\n\n    "
				p {
					- "Can be set, to change whether the audio is muted or not."
				}
				- "\n   "
			}
		}
		- "\n\n  \n\n  "
		p {
			- "A "
			a href="#media-element" id="user-interface:media-element-5" {
				- "media element"
			}
			- " has a "
			dfn id="concept-media-volume" {
				- "playback volume"
			}
			- ", which is a fraction in the range 0.0 (silent) to 1.0 (loudest).\n  Initially, the volume should be 1.0, but user agents may remember the last set value across\n  sessions, on a per-site basis or otherwise, so the volume may start at other values."
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-volume" data-dfn-type="attribute" {
				code {
					- "volume"
				}
			}
			- "\n  IDL attribute must return the "
			a href="#concept-media-volume" id="user-interface:concept-media-volume" {
				- "playback volume"
			}
			- " of any\n  audio portions of the "
			a href="#media-element" id="user-interface:media-element-6" {
				- "media element"
			}
			- ". On setting, if the new value is in the range 0.0\n  to 1.0 inclusive, the "
			a href="#media-element" id="user-interface:media-element-7" {
				- "media element"
			}
			- "'s "
			a href="#concept-media-volume" id="user-interface:concept-media-volume-2" {
				- "playback\n  volume"
			}
			- " must be set to the new value. If the new value is outside the range 0.0 to 1.0\n  inclusive, then, on setting, an "
			a id="user-interface:indexsizeerror-2" href="https://webidl.spec.whatwg.org/#indexsizeerror" data-x-internal="indexsizeerror" {
				- "\""
				code {
					- "IndexSizeError"
				}
				- "\""
			}
			- "\n  "
			code id="user-interface:domexception-2" {
				a data-x-internal="domexception" href="https://webidl.spec.whatwg.org/#dfn-DOMException" {
					- "DOMException"
				}
			}
			- " must be thrown instead."
		}
		- "\n\n  "
		p {
			- "A "
			a href="#media-element" id="user-interface:media-element-8" {
				- "media element"
			}
			- " can also be "
			dfn data-dfn-for="media element" id="concept-media-muted" data-export="" {
				- "muted"
			}
			- ". If anything is muting the element, then it is muted. (For example, when the\n  "
			a href="#direction-of-playback" id="user-interface:direction-of-playback" {
				- "direction of playback"
			}
			- " is backwards, the element is muted.)"
		}
		- "\n\n  "
		p {
			- "The "
			dfn data-dfn-for="HTMLMediaElement" id="dom-media-muted" data-dfn-type="attribute" {
				code {
					- "muted"
				}
			}
			- " IDL\n  attribute must return the value to which it was last set. When a "
			a href="#media-element" id="user-interface:media-element-9" {
				- "media element"
			}
			- " is\n  created, if the element has a "
			code id="user-interface:attr-media-muted" {
				a href="#attr-media-muted" {
					- "muted"
				}
			}
			- " content attribute\n  specified, then the "
			code id="user-interface:dom-media-muted" {
				a href="#dom-media-muted" {
					- "muted"
				}
			}
			- " IDL attribute should be set to\n  true; otherwise, the user agents may set the value to the user's preferred value (e.g. remembering\n  the last set value across sessions, on a per-site basis or otherwise). While the "
			code id="user-interface:dom-media-muted-2" {
				a href="#dom-media-muted" {
					- "muted"
				}
			}
			- " IDL attribute is set to true, the "
			a href="#media-element" id="user-interface:media-element-10" {
				- "media element"
			}
			- "\n  must be "
			a href="#concept-media-muted" id="user-interface:concept-media-muted" {
				- "muted"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "Whenever either of the values that would be returned by the "
			code id="user-interface:dom-media-volume-3" {
				a href="#dom-media-volume" {
					- "volume"
				}
			}
			- " and "
			code id="user-interface:dom-media-muted-3" {
				a href="#dom-media-muted" {
					- "muted"
				}
			}
			- " IDL\n  attributes change, the user agent must "
			a href="#queue-a-media-element-task" id="user-interface:queue-a-media-element-task" {
				- "queue a media element task"
			}
			- " given the\n  "
			a href="#media-element" id="user-interface:media-element-11" {
				- "media element"
			}
			- " to "
			a href="https://dom.spec.whatwg.org/#concept-event-fire" id="user-interface:concept-event-fire" data-x-internal="concept-event-fire" {
				- "fire an event"
			}
			- " named "
			code id="user-interface:event-media-volumechange" {
				a href="#event-media-volumechange" {
					- "volumechange"
				}
			}
			- " at the "
			a href="#media-element" id="user-interface:media-element-12" {
				- "media element"
			}
			- ". Then, if\n  the "
			a href="#media-element" id="user-interface:media-element-13" {
				- "media element"
			}
			- " is not "
			a href="#allowed-to-play" id="user-interface:allowed-to-play" {
				- "allowed to play"
			}
			- ", the user agent must run the\n  "
			a href="#internal-pause-steps" id="user-interface:internal-pause-steps" {
				- "internal pause steps"
			}
			- " for the "
			a href="#media-element" id="user-interface:media-element-14" {
				- "media element"
			}
			- "."
		}
		- "\n\n  "
		p {
			- "A user agent has an associated "
			dfn id="volume-locked" {
				- "volume locked"
			}
			- " (a boolean). Its value is\n  "
			a id="user-interface:implementation-defined" href="https://infra.spec.whatwg.org/#implementation-defined" data-x-internal="implementation-defined" {
				- "implementation-defined"
			}
			- " and determines whether the "
			a href="#concept-media-volume" id="user-interface:concept-media-volume-3" {
				- "playback volume"
			}
			- " takes effect."
		}
		- "\n\n  "
		p {
			- "An element's "
			dfn data-dfn-for="HTMLMediaElement" id="effective-media-volume" data-export="" {
				- "effective media volume"
			}
