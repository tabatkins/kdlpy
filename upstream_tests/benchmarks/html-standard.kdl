					}
				}
			}
			- "\n\n   "
			p {
				- "This thus results in an item with two properties, both \"flavor\", having the values \"Lemon\n   sorbet\" and \"Apricot sorbet\"."
			}
			- "\n\n  "
		}
		- "\n\n  "
		p {
			- "An element introducing a property can also introduce multiple properties at once, to avoid\n  duplication when some of the properties have the same value."
		}
		- "\n\n  "
		div class="example" {
			- "\n\n   "
			p {
				- "Here we see an item with two properties, \"favorite-color\" and \"favorite-fruit\", both set to\n   the value \"orange\":"
			}
			- "\n\n   "
			pre {
				code class="html" {
					c- p="" {
						- "<"
