			}
			- " should be editable by the user. User agents must not allow\n  users to insert U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR) characters into the element's\n  "
			a href="#concept-fe-value" id="text-(type=text)-state-and-search-state-(type=search):concept-fe-value-3" {
				- "value"
			}
			- "."
		}
		- "\n\n  \n  \n  "
		p {
