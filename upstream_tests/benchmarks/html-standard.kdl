										- "in a document tree"
									}
									- ";"
								}
							}
							li {
								p {
									- "the element has a "
									code id="standard-metadata-names:attr-meta-name-11" {
										a href="#attr-meta-name" {
											- "name"
										}
									}
									- " attribute, whose value\n        is an "
									a id="standard-metadata-names:ascii-case-insensitive-9" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
										- "ASCII case-insensitive"
									}
									- " match for "
									code id="standard-metadata-names:meta-theme-color-2" {
										a href="#meta-theme-color" {
											- "theme-color"
										}
									}
									- "; and"
								}
							}
							li {
								p {
									- "the element has a "
									code id="standard-metadata-names:attr-meta-content-6" {
										a href="#attr-meta-content" {
											- "content"
										}
									}
									- " attribute."
								}
							}
						}
						- "\n      "
					}
					li {
						- "\n       "
						p {
							- "For each "
							var {
								- "element"
							}
							- " in "
							var {
								- "candidate elements"
							}
							- ":"
						}
						- "\n\n       "
						ol {
							li {
								p {
									- "If "
									var {
										- "element"
									}
									- " has a "
									code id="standard-metadata-names:attr-link-media" {
										a href="#attr-link-media" {
											- "media"
										}
									}
									- " attribute\n        and the value of "
									var {
										- "element"
									}
									- "'s "
									code id="standard-metadata-names:attr-meta-media-3" {
										a href="#attr-meta-media" {
											- "media"
										}
									}
									- "\n        attribute does not "
									a href="#matches-the-environment" id="standard-metadata-names:matches-the-environment" {
										- "match the environment"
									}
									- ", then\n        "
									a id="standard-metadata-names:continue" href="https://infra.spec.whatwg.org/#iteration-continue" data-x-internal="continue" {
										- "continue"
									}
									- "."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "value"
									}
									- " be the result of "
									a href="https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace" id="standard-metadata-names:strip-leading-and-trailing-ascii-whitespace" data-x-internal="strip-leading-and-trailing-ascii-whitespace" {
										- "stripping leading and trailing ASCII whitespace"
									}
									- " from the value of\n        "
									var {
										- "element"
									}
									- "'s "
									code id="standard-metadata-names:attr-meta-content-7" {
										a href="#attr-meta-content" {
											- "content"
										}
									}
									- " attribute."
								}
							}
							li {
								p {
									- "Let "
									var {
										- "color"
									}
									- " be the result of "
									a href="https://drafts.csswg.org/css-color/#parse-a-css-color-value" id="standard-metadata-names:parsed-as-a-css-color-value" data-x-internal="parsed-as-a-css-color-value" {
										- "parsing"
									}
									- " "
									var {
										- "value"
									}
									- "."
								}
							}
							li {
								p {
									- "If "
									var {
										- "color"
									}
									- " is not failure, then return "
									var {
										- "color"
									}
									- "."
								}
							}
						}
						- "\n      "
					}
					li {
						p {
							- "Return nothing (the page has no theme color)."
						}
					}
				}
				- "\n\n     "
				p {
					- "If any "
					code id="standard-metadata-names:the-meta-element-13" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " elements are "
					a href="#insert-an-element-into-a-document" id="standard-metadata-names:insert-an-element-into-a-document-2" {
						- "inserted into the document"
					}
					- " or "
					a href="#remove-an-element-from-a-document" id="standard-metadata-names:remove-an-element-from-a-document" {
						- "removed from the document"
					}
					- ", or existing "
					code id="standard-metadata-names:the-meta-element-14" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " elements have their\n     "
					code id="standard-metadata-names:attr-meta-name-12" {
						a href="#attr-meta-name" {
							- "name"
						}
					}
					- ", "
					code id="standard-metadata-names:attr-meta-content-8" {
						a href="#attr-meta-content" {
							- "content"
						}
					}
					- ", or\n     "
					code id="standard-metadata-names:attr-link-media-2" {
						a href="#attr-link-media" {
							- "media"
						}
					}
					- " attributes changed, or if the environment changes\n     such that any "
					code id="standard-metadata-names:the-meta-element-15" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element's "
					code id="standard-metadata-names:attr-link-media-3" {
						a href="#attr-link-media" {
							- "media"
						}
					}
					- "\n     attribute's value may now or may no longer "
					a href="#matches-the-environment" id="standard-metadata-names:matches-the-environment-2" {
						- "match the\n     environment"
					}
					- ", user agents must re-run the above algorithm and apply the result to any\n     affected UI."
				}
				- "\n\n    \n\n    "
				p {
					- "When using the theme color in UI, user agents may adjust it in implementation-specific ways\n    to make it more suitable for the UI in question. For example, if a user agent intends to use\n    the theme color as a background and display white text over it, it might use a darker variant of\n    the theme color in that part of the UI, to ensure adequate contrast."
				}
				- "\n   "
			}
			dt {
				dfn data-dfn-for="meta/name" id="meta-color-scheme" data-dfn-type="attr-value" {
					code {
						- "color-scheme"
					}
				}
			}
			dd {
				- "\n    "
				p {
					- "To aid user agents in rendering the page background with the desired color scheme immediately\n    (rather than waiting for all CSS in the page to load), a "
					a id="standard-metadata-names:'color-scheme'" href="https://drafts.csswg.org/css-color-adjust/#color-scheme-prop" data-x-internal="'color-scheme'" {
						- "'color-scheme'"
					}
					- " value can\n    be provided in a "
					code id="standard-metadata-names:the-meta-element-16" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element."
				}
				- "\n\n    "
				p {
					- "The value must be a string that matches the syntax for the CSS "
					a id="standard-metadata-names:'color-scheme'-2" href="https://drafts.csswg.org/css-color-adjust/#color-scheme-prop" data-x-internal="'color-scheme'" {
						- "'color-scheme'"
					}
					- "\n    property value. It determines the "
					a id="standard-metadata-names:page's-supported-color-schemes" href="https://drafts.csswg.org/css-color-adjust/#pages-supported-color-schemes" data-x-internal="page's-supported-color-schemes" {
						- "page's supported color-schemes"
					}
					- "."
				}
				- "\n\n    "
				p {
					- "There must not be more than one "
					code id="standard-metadata-names:the-meta-element-17" {
						a href="#the-meta-element" {
							- "meta"
						}
					}
					- " element with its "
					code id="standard-metadata-names:attr-meta-name-13" {
						a href="#attr-meta-name" {
							- "name"
						}
					}
					- " attribute value set to an\n    "
					a id="standard-metadata-names:ascii-case-insensitive-10" href="https://infra.spec.whatwg.org/#ascii-case-insensitive" data-x-internal="ascii-case-insensitive" {
						- "ASCII case-insensitive"
					}
					- " match for "
					code id="standard-metadata-names:meta-color-scheme" {
						a href="#meta-color-scheme" {
							- "color-scheme"
						}
					}
					- " per document."
				}
				- "\n\n    "
				div class="example" {
					- "\n     "
					p {
