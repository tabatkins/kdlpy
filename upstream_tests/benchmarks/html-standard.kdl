							- "Blob"
						}
					}
					- " object, let\n    "
					var {
						- "val"
					}
					- " be the value of the "
					dfn data-dfn-for="ImageBitmapOptions" id="dom-imagebitmapoptions-colorspaceconversion" data-dfn-type="dict-member" {
						code {
